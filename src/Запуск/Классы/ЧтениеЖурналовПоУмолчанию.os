#native
#Использовать "../../Коллектор"

// Действие без команды: постоянное чтение журналов, как команда run без --once.
// Заменяет действие autumn-cli по умолчанию - вывод справки.

&Табакерка
&Пластилин("КоллекторЖурналов")
Перем ТабакеркаКоллектора; // Коллектор создается при выполнении, а не при разборе аргументов (--help)

// Обработчик выполнения команды. Параметр требуется интерфейсом действия autumn-cli по умолчанию.
//
// Параметры:
//   КомандаПриложения - КомандаПриложения - выполняемая команда
//
Процедура ВыполнитьКоманду(Знач КомандаПриложения) Экспорт // BSLLS:UnusedParameters-off
	ТабакеркаКоллектора.Достать().Запустить(Ложь);
КонецПроцедуры

&Желудь
&Прозвище("КомандаПриложенияПоУмолчанию")
&Верховный
Процедура ПриСозданииОбъекта()
КонецПроцедуры
