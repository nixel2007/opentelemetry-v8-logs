#native
#Использовать "../../Коллектор"

// Команда run: читает журналы 1С из настроек autumn-properties.json и передает их в OpenTelemetry.

&Табакерка
&Пластилин("КоллекторЖурналов")
Перем ТабакеркаКоллектора; // Коллектор создается при выполнении команды, а не при разборе аргументов (--help)

&Опция(Имя = "once", Описание = "Выполнить один проход по журналам и завершить работу")
&ВОкружении("OTEL_V8_LOGS_ONCE")
&ТБулево
&ПоУмолчанию(Ложь)
Перем Однократно; // Булево - значение опции --once

&КомандаПриложения(Имя = "run", Описание = "Читать журналы 1С и передавать их в OpenTelemetry")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнениеКоманды() Экспорт
	ТабакеркаКоллектора.Достать().Запустить(Однократно);
КонецПроцедуры
