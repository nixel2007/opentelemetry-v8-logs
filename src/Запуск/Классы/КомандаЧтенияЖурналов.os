#Использовать "../../Приложение"

// Команда run: читает журналы 1С из настроек autumn-properties.json и передает их в OpenTelemetry.

// Приложение создается только при выполнении команды, а не при разборе аргументов (--help)
&Табакерка
&Пластилин("ПриложениеЖурналов")
Перем ТабакеркаПриложения;

&Опция(Имя = "once", Описание = "Выполнить один проход по журналам и завершить работу")
&ВОкружении("OTEL_V8_LOGS_ONCE")
&ТБулево
&ПоУмолчанию(Ложь)
Перем Однократно;

&КомандаПриложения(Имя = "run", Описание = "Читать журналы 1С и передавать их в OpenTelemetry")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнениеКоманды() Экспорт
	ТабакеркаПриложения.Достать().Запустить(Однократно);
КонецПроцедуры
