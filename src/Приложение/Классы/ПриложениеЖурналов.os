#Использовать autumn
#Использовать autumn-opentelemetry
#Использовать logos
#Использовать "../../.."

// Приложение: периодически дочитывает технологические журналы и журналы регистрации
// из настроек onec-logs и передает их в OpenTelemetry через SDK из настроек otel.
//
// Настройки (autumn-properties.json):
//   onec-logs.techlog - Массив - каталоги технологического журнала:
//     path - каталог (location в logcfg.xml); timezone, start-from-end - как в общих настройках
//   onec-logs.eventlog - Массив - каталоги журнала регистрации (1Cv8Log):
//     path - каталог; infobase - имя информационной базы; timezone, start-from-end
//   onec-logs.timezone - часовой пояс серверов 1С (по умолчанию часовой пояс машины)
//   onec-logs.start-from-end - при первом запуске пропустить накопленные данные (по умолчанию false)
//   onec-logs.interval - пауза между проходами без новых данных, секунд (по умолчанию 5)
//   onec-logs.batch-size - записей между сбросами буферов телеметрии (по умолчанию 1000)

Перем Лог;
Перем Сдк;
Перем Конвейер;
Перем ИнтервалСекунд;

#Область ПрограммныйИнтерфейс

// Выполняет один проход по всем журналам.
//
// Возвращаемое значение:
//   Число - количество переданных записей
//
Функция ВыполнитьПроход() Экспорт
	Возврат Конвейер.ВыполнитьПроход();
КонецФункции

// Запускает чтение журналов.
//
// Параметры:
//   Однократно - Булево - выполнить один проход и завершить работу
//
Процедура Запустить(Однократно = Ложь) Экспорт

	Лог.Информация("Запуск чтения журналов 1С");

	Пока Истина Цикл
		Количество = ВыполнитьПроход();
		Если Количество > 0 Тогда
			Лог.Отладка("Передано записей: %1", Количество);
		КонецЕсли;
		Если Однократно Тогда
			Прервать;
		КонецЕсли;
		// Пока журналы отстают, следующий проход начинается сразу
		Если Количество = 0 Тогда
			Приостановить(ИнтервалСекунд * 1000);
		КонецЕсли;
	КонецЦикла;

	Завершить();

КонецПроцедуры

// Сбрасывает буферы и закрывает SDK OpenTelemetry.
//
Процедура Завершить() Экспорт
	Сдк.Закрыть();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьТехЖурналы(Источники, Хранилище, ОбщиеПараметры)

	Если Источники = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Логгер = Сдк.ПолучитьЛоггер("opentelemetry-onec-logs.techlog");
	Метр = Сдк.ПолучитьМетр("opentelemetry-onec-logs.techlog");
	Трассировщик = Сдк.ПолучитьТрассировщик("opentelemetry-onec-logs.techlog");

	Для Каждого Источник Из МассивИсточников(Источники) Цикл
		Параметры = ПараметрыИсточника(Источник, ОбщиеПараметры);
		Лог.Информация("Технологический журнал: %1", Параметры.Каталог);
		Читатель = Новый ЧитательТехЖурнала(Параметры.Каталог, Хранилище, Параметры);
		Экспортер = Новый ЭкспортерТехЖурнала(Логгер, Метр, Трассировщик, Параметры);
		Конвейер.Добавить(Читатель, Экспортер);
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьЖурналыРегистрации(Источники, Хранилище, ОбщиеПараметры)

	Если Источники = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Логгер = Сдк.ПолучитьЛоггер("opentelemetry-onec-logs.eventlog");
	Метр = Сдк.ПолучитьМетр("opentelemetry-onec-logs.eventlog");

	Для Каждого Источник Из МассивИсточников(Источники) Цикл
		Параметры = ПараметрыИсточника(Источник, ОбщиеПараметры);
		ИнформационнаяБаза = Источник["infobase"];
		Если ЗначениеЗаполнено(ИнформационнаяБаза) Тогда
			Параметры.Вставить("ИнформационнаяБаза", ИнформационнаяБаза);
		КонецЕсли;
		Лог.Информация("Журнал регистрации: %1", Параметры.Каталог);
		Читатель = Новый ЧитательЖурналаРегистрации(Параметры.Каталог, Хранилище, Параметры);
		Экспортер = Новый ЭкспортерЖурналаРегистрации(Логгер, Метр, Параметры);
		Конвейер.Добавить(Читатель, Экспортер);
	КонецЦикла;

КонецПроцедуры

Функция МассивИсточников(Источники)
	Если ТипЗнч(Источники) = Тип("Массив") ИЛИ ТипЗнч(Источники) = Тип("ФиксированныйМассив") Тогда
		Возврат Источники;
	КонецЕсли;
	Результат = Новый Массив;
	Результат.Добавить(Источники);
	Возврат Результат;
КонецФункции

Функция ПараметрыИсточника(Источник, ОбщиеПараметры)

	Каталог = Источник["path"];
	Если НЕ ЗначениеЗаполнено(Каталог) Тогда
		ВызватьИсключение "В настройках источника журнала не указан каталог (path)";
	КонецЕсли;

	Параметры = Новый Структура;
	Параметры.Вставить("Каталог", Каталог);
	Параметры.Вставить("ЧасовойПояс", ЗначениеИлиОбщее(Источник["timezone"], ОбщиеПараметры.ЧасовойПояс));
	Параметры.Вставить("НачинатьСКонца",
		ЭтоИстина(ЗначениеИлиОбщее(Источник["start-from-end"], ОбщиеПараметры.НачинатьСКонца)));

	Возврат Параметры;

КонецФункции

Функция ЗначениеИлиОбщее(Значение, ОбщееЗначение)
	Если Значение = Неопределено ИЛИ Значение = "" Тогда
		Возврат ОбщееЗначение;
	КонецЕсли;
	Возврат Значение;
КонецФункции

Функция ЭтоИстина(Значение)
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат НРег(Строка(Значение)) = "true";
КонецФункции

#КонецОбласти

// Параметры:
//   ОтелSdk - ОтелSdk - SDK OpenTelemetry из настроек otel (autumn-opentelemetry)
//   ХранилищеПозицийЧтения - ХранилищеПозицийЧтения - хранилище позиций чтения
//   ТехЖурналы - Массив, Соответствие, Неопределено - настройки onec-logs.techlog
//   ЖурналыРегистрации - Массив, Соответствие, Неопределено - настройки onec-logs.eventlog
//   ЧасовойПоясСерверов - Строка - настройка onec-logs.timezone
//   НачинатьСКонца - Булево, Строка - настройка onec-logs.start-from-end
//   Интервал - Число, Строка - настройка onec-logs.interval
//   РазмерПакета - Число, Строка - настройка onec-logs.batch-size
//
&Желудь
Процедура ПриСозданииОбъекта(
		&Пластилин ОтелSdk,
		&Пластилин ХранилищеПозицийЧтения,
		&Деталька(Значение = "onec-logs.techlog", ЗначениеПоУмолчанию = Неопределено) ТехЖурналы,
		&Деталька(Значение = "onec-logs.eventlog", ЗначениеПоУмолчанию = Неопределено) ЖурналыРегистрации,
		&Деталька(Значение = "onec-logs.timezone", ЗначениеПоУмолчанию = "") ЧасовойПоясСерверов,
		&Деталька(Значение = "onec-logs.start-from-end", ЗначениеПоУмолчанию = Ложь) НачинатьСКонца,
		&Деталька(Значение = "onec-logs.interval", ЗначениеПоУмолчанию = 5) Интервал,
		&Деталька(Значение = "onec-logs.batch-size", ЗначениеПоУмолчанию = 1000) РазмерПакета)

	Лог = Логирование.ПолучитьЛог("oscript.app.opentelemetry-onec-logs");
	Сдк = ОтелSdk;
	ИнтервалСекунд = Число(Интервал);
	Конвейер = Новый КонвейерЖурналов(Сдк, Число(РазмерПакета));

	ОбщиеПараметры = Новый Структура;
	ОбщиеПараметры.Вставить("ЧасовойПояс", ?(ЗначениеЗаполнено(ЧасовойПоясСерверов), ЧасовойПоясСерверов, ЧасовойПояс()));
	ОбщиеПараметры.Вставить("НачинатьСКонца", ЭтоИстина(НачинатьСКонца));

	ДобавитьТехЖурналы(ТехЖурналы, ХранилищеПозицийЧтения, ОбщиеПараметры);
	ДобавитьЖурналыРегистрации(ЖурналыРегистрации, ХранилищеПозицийЧтения, ОбщиеПараметры);

КонецПроцедуры
