<?xml version="1.0" encoding="utf-8"?>
<package-def xmlns="http://oscript.io/schemas/lib-config/1.0">

    <!-- Приложение: желуди autumn и сущности autumn-data. Подключаются только точкой входа,
         чтобы библиотека не добавляла их в Поделку использующего ее приложения. -->
    <class name="ПозицияЧтения" file="Классы/ПозицияЧтения.os"/>
    <class name="ХранилищеПозицийЧтения" file="Классы/ХранилищеПозицийЧтения.os"/>
    <class name="ПриложениеЖурналов" file="Классы/ПриложениеЖурналов.os"/>

</package-def>
