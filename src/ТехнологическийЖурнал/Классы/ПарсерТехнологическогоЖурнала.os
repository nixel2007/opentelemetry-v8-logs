#native

// Разбор текстового формата технологического журнала 1С:Предприятия.
//
// Строка события: мм:сс.дробь-длительность,ИМЯ,уровень,ключ=значение,...
// Значения в одинарных или двойных кавычках могут содержать запятые и переводы строк,
// кавычка внутри значения удваивается. Новое событие начинается со строки вида «мм:сс.дробь-длительность,»,
// если в предыдущем событии не осталось незакрытой кавычки. В 8.3 дробная часть секунды и длительность
// указываются в микросекундах, в 8.2 - в десятитысячных долях секунды.

&Пластилин
Перем СобытияТехнологическогоЖурнала; // СобытияТехнологическогоЖурнала - структура события

Перем РегулярноеНачалоСобытия; // РегулярноеВыражение - строка вида начала события
Перем РегулярныйЗаголовок; // РегулярноеВыражение - заголовок: время, длительность, имя, уровень
Перем РегулярноеСвойство; // РегулярноеВыражение - очередное свойство ,ключ=значение
Перем РегулярнаяОткрытаяКавычка; // РегулярноеВыражение - начало значения без закрывающей кавычки
Перем ЗнаковМикросекунд; // Число - знаков дроби секунды в микросекундах (8.3)
Перем ОснованиеДесятичное; // Число
Перем СекундВМинуте; // Число
Перем ДлинаКавычки; // Число - длина кавычки вокруг значения свойства

#Область ПрограммныйИнтерфейс

// Разбирает фрагмент файла технологического журнала на события.
//
// Последнее событие фрагмента считается незавершенным, если в нем не закрыта кавычка:
// его исходный текст возвращается в остатке, чтобы дочитать событие при следующем вызове.
// Событие с заголовком неожиданного вида (например, без уровня) пропускается, чтобы
// не останавливать чтение файла на нем.
//
// Параметры:
//   Текст - Строка - фрагмент файла из целых строк
//   ДатаЧасаФайла - Дата - дата и час из имени файла (ГГММДДЧЧ.log)
//   ТекстЗавершен - Булево - Истина, если дописывания текста больше не будет:
//     незавершенное последнее событие возвращается как есть
//
// Возвращаемое значение:
//   Структура - результат разбора:
//     * События - Массив из Структура - разобранные события, см. СобытияТехнологическогоЖурнала.НовоеСобытие
//     * Остаток - Строка - исходный текст незавершенного последнего события
//     * Пропущено - Число - сколько событий пропущено из-за заголовка неожиданного вида
//
Функция Разобрать(Знач Текст, Знач ДатаЧасаФайла, Знач ТекстЗавершен = Ложь) Экспорт

	Результат = Новый Структура("События, Остаток, Пропущено", Новый Массив, "", 0);

	ЗаканчиваетсяПереводомСтроки = СтрЗаканчиваетсяНа(Текст, Символы.ПС);
	Строки = СтрРазделить(Текст, Символы.ПС, Истина);
	Если ЗаканчиваетсяПереводомСтроки Тогда
		Строки.Удалить(Строки.ВГраница());
	КонецЕсли;

	СтрокиСобытия = Неопределено;
	Для Каждого Строка Из Строки Цикл
		СтрокиСобытия = ДобавитьСтроку(Результат, СтрокиСобытия, Строка, ДатаЧасаФайла);
	КонецЦикла;

	Если СтрокиСобытия = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Разбор = РазобратьСобытие(СтрокиСобытия, ДатаЧасаФайла);
	Если Разбор.Завершено ИЛИ ТекстЗавершен Тогда
		ДобавитьСобытие(Результат, Разбор);
	Иначе
		Результат.Остаток = СтрСоединить(СтрокиСобытия, Символы.ПС)
			+ ?(ЗаканчиваетсяПереводомСтроки, Символы.ПС, "");
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Добавляет строку к текущему событию или начинает с нее новое, разобрав предыдущее.
//
// Параметры:
//   Результат - Структура - результат разбора, см. Разобрать
//   СтрокиСобытия - Массив из Строка, Неопределено - строки текущего события; Неопределено - до первого события
//   Строка - Строка - очередная строка фрагмента
//   ДатаЧасаФайла - Дата - дата и час из имени файла
//
// Возвращаемое значение:
//   Массив из Строка, Неопределено - строки текущего события после добавления строки
//
Функция ДобавитьСтроку(Результат, СтрокиСобытия, Строка, ДатаЧасаФайла)

	Если НЕ РегулярноеНачалоСобытия.Совпадает(Строка) Тогда
		// Строки до первого события фрагмента пропускаются
		Если СтрокиСобытия <> Неопределено Тогда
			СтрокиСобытия.Добавить(Строка);
		КонецЕсли;
		Возврат СтрокиСобытия;
	КонецЕсли;

	Если СтрокиСобытия <> Неопределено Тогда
		// Строка вида начала события внутри незакрытой кавычки - часть значения
		// (например, текст ошибки или запроса), а не новое событие
		Разбор = РазобратьСобытие(СтрокиСобытия, ДатаЧасаФайла);
		Если Разбор.КавычкаОткрыта Тогда
			СтрокиСобытия.Добавить(Строка);
			Возврат СтрокиСобытия;
		КонецЕсли;
		ДобавитьСобытие(Результат, Разбор);
	КонецЕсли;

	НовоеСобытие = Новый Массив;
	НовоеСобытие.Добавить(Строка);
	Возврат НовоеСобытие;

КонецФункции

Процедура ДобавитьСобытие(Результат, Разбор)
	Если Разбор.Событие = Неопределено Тогда
		Результат.Пропущено = Результат.Пропущено + 1;
	Иначе
		Результат.События.Добавить(Разбор.Событие);
	КонецЕсли;
КонецПроцедуры

// Параметры:
//   СтрокиСобытия - Массив из Строка - строки события
//   ДатаЧасаФайла - Дата - дата и час из имени файла
//
// Возвращаемое значение:
//   Структура - Событие (Неопределено, если заголовок неожиданного вида), Завершено, КавычкаОткрыта
//
Функция РазобратьСобытие(СтрокиСобытия, ДатаЧасаФайла)

	ТекстСобытия = СтрЗаменить(СтрСоединить(СтрокиСобытия, Символы.ПС), Символы.ВК, "");

	Заголовки = РегулярныйЗаголовок.НайтиСовпадения(ТекстСобытия);
	Если Заголовки.Количество() = 0 Тогда
		Возврат Новый Структура("Событие, Завершено, КавычкаОткрыта", Неопределено, Истина, Ложь);
	КонецЕсли;
	Заголовок = Заголовки[0];
	Группы = Заголовок.Группы;

	// Число знаков дроби задает единицу измерения и длительности: 6 - микросекунды, 4 - 1/10000 с
	Дробь = Группы[3].Значение;
	МножительВМикросекунды = Pow(ОснованиеДесятичное, ЗнаковМикросекунд - СтрДлина(Дробь));

	Событие = СобытияТехнологическогоЖурнала.НовоеСобытие();
	Событие.Время = ДатаЧасаФайла + Число(Группы[1].Значение) * СекундВМинуте + Число(Группы[2].Значение);
	Событие.Микросекунды = Число(Дробь) * МножительВМикросекунды;
	Событие.Длительность = Число(Группы[4].Значение) * МножительВМикросекунды;
	Событие.Имя = Группы[5].Значение;
	Событие.Уровень = Число(Группы[6].Значение);
	Событие.Текст = ТекстСобытия;

	СтрокаСвойств = Сред(ТекстСобытия, Заголовок.Длина + 1);
	РазобранаДлина = 0;
	Для Каждого Совпадение Из РегулярноеСвойство.НайтиСовпадения(СтрокаСвойств) Цикл
		СобытияТехнологическогоЖурнала.ДобавитьСвойство(Событие.Свойства, Совпадение.Группы[1].Значение,
			ЗначениеБезКавычек(Совпадение.Группы[2].Значение));
		РазобранаДлина = РазобранаДлина + Совпадение.Длина;
	КонецЦикла;

	// Значение в кавычках без закрывающей кавычки не совпадает с шаблоном свойства: шаблон берет
	// пустое значение, и разбор останавливается на открывающей кавычке
	КавычкаОткрыта = РегулярнаяОткрытаяКавычка.Совпадает(Сред(СтрокаСвойств, РазобранаДлина + 1));

	Возврат Новый Структура("Событие, Завершено, КавычкаОткрыта", Событие,
		РазобранаДлина = СтрДлина(СтрокаСвойств), КавычкаОткрыта);

КонецФункции

Функция ЗначениеБезКавычек(Значение)

	Кавычка = Лев(Значение, 1);
	Если Кавычка <> "'" И Кавычка <> """" Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат СтрЗаменить(Сред(Значение, ДлинаКавычки + 1, СтрДлина(Значение) - ДлинаКавычки - ДлинаКавычки),
		Кавычка + Кавычка, Кавычка);

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта()
	РегулярноеНачалоСобытия = Новый РегулярноеВыражение("^\d\d:\d\d\.\d+-\d+,");
	РегулярныйЗаголовок = Новый РегулярноеВыражение("^(\d\d):(\d\d)\.(\d+)-(\d+),([^,]*),(\d+)");
	РегулярноеСвойство = Новый РегулярноеВыражение(
		"\G,([^,=]+)=('(?:[^']|'')*'|""(?:[^""]|"""")*""|[^,'""][^,]*|)");
	РегулярнаяОткрытаяКавычка = Новый РегулярноеВыражение("^['""]");
	ЗнаковМикросекунд = 6;
	ОснованиеДесятичное = 10;
	СекундВМинуте = 60;
	ДлинаКавычки = СтрДлина("'");
КонецПроцедуры
