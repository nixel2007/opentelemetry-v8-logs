#native
#Использовать autumn-logos
#Использовать collectionos
#Использовать "../../Чтение"

// Читатель каталога технологического журнала.
//
// Находит файлы журнала (<процесс>_<PID>/ГГММДДЧЧ.log или <процесс>_<PID>_ГГММДДЧЧ.log),
// дочитывает каждый с сохраненной позиции и передает разобранные события обработчику.
//
// При ротации по размеру (rotation="size" в logcfg.xml) платформа пишет в <процесс>_<PID>.log,
// заполненный файл переименовывает в <процесс>_<PID>.log.N (N растет с каждой ротацией) и начинает
// новый <процесс>_<PID>.log. Позиция такого файла хранится по его первой строке, а не по пути:
// после переименования чтение продолжается с того же места.
// Позиции сохраняются в хранилище только методом ЗафиксироватьПозиции, который вызывается
// после того, как обработчик надежно передал события дальше: так при сбое события
// будут прочитаны повторно, а не потеряны.

&Пластилин
Перем ЧтениеФайловЖурнала; // ЧтениеФайловЖурнала - дочитывание файлов порциями

&Пластилин
Перем ЧтениеХвостаФайла; // ЧтениеХвостаФайла - чтение начала файла ротации по размеру

&Пластилин
Перем ПарсерТехнологическогоЖурнала; // ПарсерТехнологическогоЖурнала - разбор текстового формата

&Пластилин
Перем ПарсерТехнологическогоЖурналаJSON; // ПарсерТехнологическогоЖурналаJSON - разбор формата JSON

&Лог(Значение = "oscript.app.opentelemetry-v8-logs")
Перем Лог; // Лог - лог приложения

Перем КаталогЖурнала; // Строка - полный путь к каталогу журнала
Перем Позиции; // ПозицииЧтения - позиции файлов каталога
Перем МаксимумБайт; // Число - объем данных, читаемый из файла за одну порцию
Перем ТекущийОбработчик; // Произвольный - обработчик событий текущего прохода

Перем РегулярноеИмяФайла; // РегулярноеВыражение - имя файла: [процесс_PID_]ГГММДДЧЧ.log
Перем РегулярноеИмяФайлаРотацииПоРазмеру; // РегулярноеВыражение - имя файла: процесс_PID.log[.N]
Перем РегулярноеИмяКаталога; // РегулярноеВыражение - имя каталога процесса: процесс_PID
Перем РегулярноеВремяСобытия; // РегулярноеВыражение - дата и время события в первой строке файла
Перем ДлинаНачалаФайла; // Число - сколько символов первой строки задают позицию файла ротации по размеру

#Область ПрограммныйИнтерфейс

// Выполняет один проход по файлам журнала и передает новые события обработчику.
//
// Параметры:
//   Обработчик - Произвольный - объект с методом ОбработатьСобытияТехнологическогоЖурнала(События, ОписаниеФайла),
//     которому передаются массив событий (см. СобытияТехнологическогоЖурнала.НовоеСобытие)
//     и структура описания файла: Путь, Каталог, Процесс, ИдПроцесса, ДатаЧаса
//
// Возвращаемое значение:
//   Число - количество переданных событий
//
Функция Прочитать(Обработчик) Экспорт

	ТекущийОбработчик = Обработчик;
	Позиции.НачатьПроход();

	Количество = 0;
	Для Каждого Файл Из ФайлыПоПорядкуЧасов() Цикл
		Количество = Количество + ЧтениеФайловЖурнала.ПрочитатьФайл(Файл.Описание.Путь, Позиции, МаксимумБайт,
			Файл.Завершен, ЭтотОбъект, Файл.Описание, Ложь, Файл.КлючПозиции, Файл.НачалоФайла);
	КонецЦикла;

	Позиции.ЗавершитьПроход();

	Возврат Количество;

КонецФункции

// Сохраняет в хранилище позиции, прочитанные после предыдущей фиксации,
// и удаляет позиции файлов, которых больше нет.
//
Процедура ЗафиксироватьПозиции() Экспорт
	Позиции.Зафиксировать();
КонецПроцедуры

// Отбрасывает позиции, прочитанные после предыдущей фиксации: события, не переданные
// дальше из-за сбоя, будут прочитаны повторно.
//
Процедура ОткатитьПозиции() Экспорт
	Позиции.Откатить();
КонецПроцедуры

// Служебный: разбирает порцию файла и передает события обработчику, см. ЧтениеФайловЖурнала.ПрочитатьФайл.
//
// Параметры:
//   Текст - Строка - порция файла
//   ТекстЗавершен - Булево - дописывания файла больше не будет
//   ОписаниеФайла - Структура - описание файла
//
// Возвращаемое значение:
//   Структура - Количество, Остаток
//
Функция ОбработатьПорцию(Текст, ТекстЗавершен, ОписаниеФайла) Экспорт

	Если ПарсерТехнологическогоЖурналаJSON.ЭтоФорматJSON(Текст) Тогда
		Разбор = ПарсерТехнологическогоЖурналаJSON.Разобрать(Текст, ТекстЗавершен);
	Иначе
		Разбор = ПарсерТехнологическогоЖурнала.Разобрать(Текст, ОписаниеФайла.ДатаЧаса, ТекстЗавершен);
	КонецЕсли;

	Если Разбор.Пропущено > 0 Тогда
		Лог.Предупреждение("Файл журнала %1: пропущено событий неожиданной структуры: %2",
			ОписаниеФайла.Путь, Разбор.Пропущено);
	КонецЕсли;

	Количество = Разбор.События.Количество();
	Если Количество > 0 Тогда
		ТекущийОбработчик.ОбработатьСобытияТехнологическогоЖурнала(Разбор.События, ОписаниеФайла);
	КонецЕсли;

	Возврат Новый Структура("Количество, Остаток", Количество, Разбор.Остаток);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Файлы всех потоков записи по возрастанию часа, а внутри часа - по пути. Пока журналы отстают
// (первый запуск, догон после простоя), события разных процессов уходят примерно в порядке
// времени: бэкенд логов может отклонять записи, намного более старые, чем уже принятые
// в тот же поток логов (Loki - больше чем на час), а процессы одного сервиса пишутся в один поток.
//
// Возвращаемое значение:
//   Массив из Структура - файлы, см. ФайлЖурнала; Завершен заполнен
//
Функция ФайлыПоПорядкуЧасов()

	Список = Новый СписокЗначений;
	Для Каждого Поток Из ПотокиФайлов() Цикл
		Файлы = Поток.Значение;
		Для Индекс = 0 По Файлы.ВГраница() Цикл
			Файл = Файлы[Индекс];
			// Предполагается, что платформа пишет только в файл последнего часа потока: предыдущие
			// файлы считаются завершенными, и их недописанный хвост разбирается как есть
			Если Файл.Завершен = Неопределено Тогда
				Файл.Завершен = Индекс < Файлы.ВГраница();
			КонецЕсли;
			Список.Добавить(Файл, Файл.Порядок);
		КонецЦикла;
	КонецЦикла;
	Список.СортироватьПоПредставлению();

	Возврат Список.ВыгрузитьЗначения();

КонецФункции

// Группирует файлы по потокам записи (каталог и процесс), внутри потока - по порядку записи.
//
// Возвращаемое значение:
//   Соответствие из КлючИЗначение - ключ потока -> Массив из Структура, см. ФайлЖурнала
//
Функция ПотокиФайлов()

	Потоки = Новый Соответствие;

	Для Каждого НайденныйФайл Из НайтиФайлы(КаталогЖурнала, "*.log*", Истина) Цикл

		Файл = ФайлЖурнала(НайденныйФайл);
		Если Файл = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		КлючПотока = НайденныйФайл.Путь + "|" + Файл.Описание.Процесс + "|" + Файл.Описание.ИдПроцесса;
		Файлы = Потоки[КлючПотока];
		Если Файлы = Неопределено Тогда
			Файлы = Новый СписокЗначений;
			Потоки.Вставить(КлючПотока, Файлы);
		КонецЕсли;
		Файлы.Добавить(Файл, Файл.Порядок);

	КонецЦикла;

	Результат = Новый Соответствие;
	Для Каждого Поток Из Потоки Цикл
		Поток.Значение.СортироватьПоПредставлению();
		Результат.Вставить(Поток.Ключ, Поток.Значение.ВыгрузитьЗначения());
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Файл журнала для чтения.
//
// Параметры:
//   НайденныйФайл - Файл - файл в каталоге журнала
//
// Возвращаемое значение:
//   Структура, Неопределено - Неопределено, если это не файл журнала или у файла ротации по размеру
//     еще нет первой строки:
//     * Описание - Структура - описание файла для обработчика: Путь, Каталог, Процесс, ИдПроцесса, Час,
//         ДатаЧаса (Неопределено у файла ротации по размеру: дата - в каждом событии)
//     * Порядок - Строка - порядок чтения: час, время первого события файла ротации по размеру, путь
//     * КлючПозиции - Строка - ключ позиции чтения: путь или, у файла ротации по размеру,
//         путь <процесс>_<PID>.log и начало первой строки
//     * НачалоФайла - Строка - начало первой строки файла ротации по размеру, иначе пустая строка
//     * Завершен - Булево, Неопределено - файл ротации больше не дописывается; Неопределено -
//         определяется по часу, см. ФайлыПоПорядкуЧасов
//
Функция ФайлЖурнала(НайденныйФайл)

	Совпадения = РегулярноеИмяФайла.НайтиСовпадения(НайденныйФайл.Имя);
	Если Совпадения.Количество() > 0 Тогда
		Группы = Совпадения[0].Группы;
		Час = Группы[3].Значение;
		ДатаЧаса = Дата("20" + Час + "0000");
		Описание = ОписаниеФайла(НайденныйФайл, Группы[1].Значение, Группы[2].Значение, Час, ДатаЧаса);
		// Файл часа начинается с начала часа: так он встает перед файлами ротации по размеру того же часа
		// (после смены схемы ротации) независимо от вида пути
		Порядок = Час + "|" + Формат(ДатаЧаса, "ДФ=yyyy-MM-ddTHH:mm:ss") + "|" + НайденныйФайл.ПолноеИмя;
		Возврат Новый Структура("Описание, Порядок, КлючПозиции, НачалоФайла, Завершен", Описание,
			Порядок, НайденныйФайл.ПолноеИмя, "", Неопределено);
	КонецЕсли;

	Совпадения = РегулярноеИмяФайлаРотацииПоРазмеру.НайтиСовпадения(НайденныйФайл.Имя);
	Если Совпадения.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ФайлРотацииПоРазмеру(НайденныйФайл, Совпадения[0].Группы);

КонецФункции

Функция ФайлРотацииПоРазмеру(НайденныйФайл, ГруппыИмени)

	НачалоФайла = НачалоПервойСтроки(НайденныйФайл.ПолноеИмя);
	Если НачалоФайла = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Номера ротаций сравниваются как строки (.10 раньше .2), поэтому порядок - по времени первого события
	Час = "";
	ВремяПервогоСобытия = "";
	Совпадения = РегулярноеВремяСобытия.НайтиСовпадения(НачалоФайла);
	Если Совпадения.Количество() > 0 Тогда
		ГруппыВремени = Совпадения[0].Группы;
		Час = ГруппыВремени[1].Значение + ГруппыВремени[2].Значение + ГруппыВремени[3].Значение
			+ ГруппыВремени[4].Значение;
		ВремяПервогоСобытия = Совпадения[0].Значение;
	КонецЕсли;

	Номер = ГруппыИмени[3].Значение;
	ПолноеИмя = НайденныйФайл.ПолноеИмя;
	ПутьАктивногоФайла = ?(Номер = "", ПолноеИмя, Лев(ПолноеИмя, СтрДлина(ПолноеИмя) - СтрДлина(Номер) - 1));

	Описание = ОписаниеФайла(НайденныйФайл, ГруппыИмени[1].Значение, ГруппыИмени[2].Значение, Час, Неопределено);
	Возврат Новый Структура("Описание, Порядок, КлючПозиции, НачалоФайла, Завершен", Описание,
		Час + "|" + ВремяПервогоСобытия + "|" + ПолноеИмя, ПутьАктивногоФайла + "#" + НачалоФайла, НачалоФайла,
		Номер <> "");

КонецФункции

// Начало первой строки файла: по нему файл узнается после переименования при ротации.
//
// Параметры:
//   Путь - Строка - полный путь к файлу
//
// Возвращаемое значение:
//   Строка, Неопределено - не больше ДлинаНачалаФайла символов первой строки без BOM;
//     Неопределено - первая строка короче и еще не дописана (в том числе файл пуст)
//
Функция НачалоПервойСтроки(Путь)

	// Символ UTF-8 - не больше 4 байт
	Прочитанное = ЧтениеХвостаФайла.Прочитать(Путь, 0, ДлинаНачалаФайла * 4, Ложь, Истина);
	Текст = Прочитанное.Текст;

	КонецСтроки = СтрНайти(Текст, Символы.ПС);
	Если КонецСтроки > 0 Тогда
		Текст = Лев(Текст, КонецСтроки - 1);
		Если СтрЗаканчиваетсяНа(Текст, Символы.ВК) Тогда
			Текст = Лев(Текст, СтрДлина(Текст) - 1);
		КонецЕсли;
	ИначеЕсли СтрДлина(Текст) < ДлинаНачалаФайла Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Текст = "" Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Лев(Текст, ДлинаНачалаФайла);

КонецФункции

Функция ОписаниеФайла(НайденныйФайл, Знач Процесс, Знач ИдПроцесса, Час, ДатаЧаса)

	Если Процесс = "" Тогда
		СовпаденияКаталога = РегулярноеИмяКаталога.НайтиСовпадения(Новый Файл(НайденныйФайл.Путь).Имя);
		Если СовпаденияКаталога.Количество() > 0 Тогда
			Процесс = СовпаденияКаталога[0].Группы[1].Значение;
			ИдПроцесса = СовпаденияКаталога[0].Группы[2].Значение;
		КонецЕсли;
	КонецЕсли;

	Описание = Новый Структура;
	Описание.Вставить("Путь", НайденныйФайл.ПолноеИмя);
	Описание.Вставить("Каталог", КаталогЖурнала);
	Описание.Вставить("Процесс", Процесс);
	Описание.Вставить("ИдПроцесса", ИдПроцесса);
	Описание.Вставить("Час", Час);
	Описание.Вставить("ДатаЧаса", ДатаЧаса);

	Возврат Описание;

КонецФункции

#КонецОбласти

// Параметры:
//   Каталог - Строка - каталог технологического журнала (location в logcfg.xml)
//   ХранилищеПозиций - Произвольный - хранилище позиций чтения, см. ХранилищеПозицийВПамяти
//   НачинатьСКонца - Булево - при первом запуске пропустить уже записанные данные
//   НовыйМаксимумБайт - Число - объем данных, читаемый из файла за одну порцию
//   ТабакеркаПозиций - Табакерка - ПозицииЧтения каталога
//
&Желудь
&Характер("Компанейский")
Процедура ПриСозданииОбъекта(&Блестяшка Каталог, &Блестяшка ХранилищеПозиций, &Блестяшка НачинатьСКонца,
	&Блестяшка НовыйМаксимумБайт, &Табакерка &Пластилин("ПозицииЧтения") ТабакеркаПозиций)

	КаталогЖурнала = Новый Файл(Каталог).ПолноеИмя;
	МаксимумБайт = НовыйМаксимумБайт;
	Позиции = ТабакеркаПозиций.Достать(Массивы.ИзЭлементов(КаталогЖурнала, ХранилищеПозиций, НачинатьСКонца));

	РегулярноеИмяФайла = Новый РегулярноеВыражение("^(?:(.+)_(\d+)_)?(\d{8})\.log$");
	РегулярноеИмяФайлаРотацииПоРазмеру = Новый РегулярноеВыражение("^(.+)_(\d+)\.log(?:\.(\d+))?$");
	РегулярноеИмяКаталога = Новый РегулярноеВыражение("^(.+)_(\d+)$");
	РегулярноеВремяСобытия = Новый РегулярноеВыражение("\d\d(\d\d)-(\d\d)-(\d\d)T(\d\d):\d\d:\d\d(?:\.\d+)?");
	ДлинаНачалаФайла = 64;

КонецПроцедуры
