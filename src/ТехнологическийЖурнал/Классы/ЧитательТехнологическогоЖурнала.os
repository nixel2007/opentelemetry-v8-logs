#native
#Использовать collectionos
#Использовать "../../Чтение"

// Читатель каталога технологического журнала.
//
// Находит файлы журнала (<процесс>_<PID>/ГГММДДЧЧ.log или <процесс>_<PID>_ГГММДДЧЧ.log),
// дочитывает каждый с сохраненной позиции и передает разобранные события обработчику.
// Позиции сохраняются в хранилище только методом ЗафиксироватьПозиции, который вызывается
// после того, как обработчик надежно передал события дальше: так при сбое события
// будут прочитаны повторно, а не потеряны.

&Пластилин
Перем ЧтениеФайловЖурнала;

&Пластилин
Перем ПарсерТехнологическогоЖурнала;

&Пластилин
Перем ПарсерТехнологическогоЖурналаJSON;

Перем КаталогЖурнала;
Перем Позиции;
Перем МаксимумБайт;
Перем ТекущийОбработчик;

Перем РегулярноеИмяФайла;
Перем РегулярноеИмяКаталога;

#Область ПрограммныйИнтерфейс

// Выполняет один проход по файлам журнала и передает новые события обработчику.
//
// Параметры:
//   Обработчик - Произвольный - объект с методом ОбработатьСобытияТехнологическогоЖурнала(События, ОписаниеФайла):
//     События - Массив из Структура - см. СобытияТехнологическогоЖурнала.НовоеСобытие
//     ОписаниеФайла - Структура - Путь, Каталог, Процесс, ИдПроцесса, ДатаЧаса
//
// Возвращаемое значение:
//   Число - количество переданных событий
//
Функция Прочитать(Обработчик) Экспорт

	ТекущийОбработчик = Обработчик;
	Позиции.НачатьПроход();

	Количество = 0;
	Для Каждого Файл Из ФайлыПоПорядкуЧасов() Цикл
		Количество = Количество + ЧтениеФайловЖурнала.ПрочитатьФайл(
			Файл.Описание.Путь, Позиции, МаксимумБайт, Файл.Завершен, ЭтотОбъект, Файл.Описание);
	КонецЦикла;

	Позиции.ЗавершитьПроход();

	Возврат Количество;

КонецФункции

// Сохраняет в хранилище позиции, прочитанные после предыдущей фиксации,
// и удаляет позиции файлов, которых больше нет.
//
Процедура ЗафиксироватьПозиции() Экспорт
	Позиции.Зафиксировать();
КонецПроцедуры

// Отбрасывает позиции, прочитанные после предыдущей фиксации: события, не переданные
// дальше из-за сбоя, будут прочитаны повторно.
//
Процедура ОткатитьПозиции() Экспорт
	Позиции.Откатить();
КонецПроцедуры

// Служебный: разбирает порцию файла и передает события обработчику, см. ЧтениеФайловЖурнала.ПрочитатьФайл.
//
// Параметры:
//   Текст - Строка - порция файла
//   ТекстЗавершен - Булево - дописывания файла больше не будет
//   ОписаниеФайла - Структура - описание файла
//
// Возвращаемое значение:
//   Структура - Количество, Остаток
//
Функция ОбработатьПорцию(Текст, ТекстЗавершен, ОписаниеФайла) Экспорт

	Если ПарсерТехнологическогоЖурналаJSON.ЭтоФорматJSON(Текст) Тогда
		Разбор = ПарсерТехнологическогоЖурналаJSON.Разобрать(Текст, ТекстЗавершен);
	Иначе
		Разбор = ПарсерТехнологическогоЖурнала.Разобрать(Текст, ОписаниеФайла.ДатаЧаса, ТекстЗавершен);
	КонецЕсли;

	Количество = Разбор.События.Количество();
	Если Количество > 0 Тогда
		ТекущийОбработчик.ОбработатьСобытияТехнологическогоЖурнала(Разбор.События, ОписаниеФайла);
	КонецЕсли;

	Возврат Новый Структура("Количество, Остаток", Количество, Разбор.Остаток);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Файлы всех потоков записи по возрастанию часа, а внутри часа - по пути. Пока журналы отстают
// (первый запуск, догон после простоя), события разных процессов уходят примерно в порядке
// времени: бэкенд логов может отклонять записи, намного более старые, чем уже принятые
// в тот же поток логов (Loki - больше чем на час), а процессы одного сервиса пишутся в один поток.
//
// Возвращаемое значение:
//   Массив из Структура - Описание (см. ОписаниеФайла), Завершен
//
Функция ФайлыПоПорядкуЧасов()

	Список = Новый СписокЗначений;
	Для Каждого Поток Из ПотокиФайлов() Цикл
		Файлы = Поток.Значение;
		Для Индекс = 0 По Файлы.ВГраница() Цикл
			// Предполагается, что платформа пишет только в файл последнего часа потока: предыдущие
			// файлы считаются завершенными, и их недописанный хвост разбирается как есть
			Файл = Новый Структура("Описание, Завершен", Файлы[Индекс], Индекс < Файлы.ВГраница());
			Список.Добавить(Файл, Файлы[Индекс].Час + "|" + Файлы[Индекс].Путь);
		КонецЦикла;
	КонецЦикла;
	Список.СортироватьПоПредставлению();

	Возврат Список.ВыгрузитьЗначения();

КонецФункции

// Группирует файлы по потокам записи (каталог и процесс), внутри потока - по возрастанию часа.
//
Функция ПотокиФайлов()

	Потоки = Новый Соответствие;

	Для Каждого Файл Из НайтиФайлы(КаталогЖурнала, "*.log", Истина) Цикл

		ОписаниеФайла = ОписаниеФайла(Файл);
		Если ОписаниеФайла = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		КлючПотока = Файл.Путь + "|" + ОписаниеФайла.Процесс + "|" + ОписаниеФайла.ИдПроцесса;
		Файлы = Потоки[КлючПотока];
		Если Файлы = Неопределено Тогда
			Файлы = Новый СписокЗначений;
			Потоки.Вставить(КлючПотока, Файлы);
		КонецЕсли;
		Файлы.Добавить(ОписаниеФайла, ОписаниеФайла.Час);

	КонецЦикла;

	Результат = Новый Соответствие;
	Для Каждого Поток Из Потоки Цикл
		Поток.Значение.СортироватьПоПредставлению();
		Результат.Вставить(Поток.Ключ, Поток.Значение.ВыгрузитьЗначения());
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ОписаниеФайла(Файл)

	Совпадения = РегулярноеИмяФайла.НайтиСовпадения(Файл.Имя);
	Если Совпадения.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Группы = Совпадения[0].Группы;

	Процесс = Группы[1].Значение;
	ИдПроцесса = Группы[2].Значение;
	Если Процесс = "" Тогда
		СовпаденияКаталога = РегулярноеИмяКаталога.НайтиСовпадения(Новый Файл(Файл.Путь).Имя);
		Если СовпаденияКаталога.Количество() > 0 Тогда
			Процесс = СовпаденияКаталога[0].Группы[1].Значение;
			ИдПроцесса = СовпаденияКаталога[0].Группы[2].Значение;
		КонецЕсли;
	КонецЕсли;

	Час = Группы[3].Значение;

	Описание = Новый Структура;
	Описание.Вставить("Путь", Файл.ПолноеИмя);
	Описание.Вставить("Каталог", КаталогЖурнала);
	Описание.Вставить("Процесс", Процесс);
	Описание.Вставить("ИдПроцесса", ИдПроцесса);
	Описание.Вставить("Час", Час);
	Описание.Вставить("ДатаЧаса", Дата("20" + Час + "0000"));

	Возврат Описание;

КонецФункции

#КонецОбласти

// Параметры:
//   Каталог - Строка - каталог технологического журнала (location в logcfg.xml)
//   ХранилищеПозиций - Произвольный - хранилище позиций чтения, см. ХранилищеПозицийВПамяти
//   НачинатьСКонца - Булево - при первом запуске пропустить уже записанные данные
//   НовыйМаксимумБайт - Число - объем данных, читаемый из файла за одну порцию
//   ТабакеркаПозиций - Табакерка - ПозицииЧтения каталога
//
&Желудь
&Характер("Компанейский")
Процедура ПриСозданииОбъекта(&Блестяшка Каталог, &Блестяшка ХранилищеПозиций, &Блестяшка НачинатьСКонца,
	&Блестяшка НовыйМаксимумБайт, &Табакерка &Пластилин("ПозицииЧтения") ТабакеркаПозиций)

	КаталогЖурнала = Новый Файл(Каталог).ПолноеИмя;
	МаксимумБайт = НовыйМаксимумБайт;
	Позиции = ТабакеркаПозиций.Достать(Массивы.ИзЭлементов(КаталогЖурнала, ХранилищеПозиций, НачинатьСКонца));

	РегулярноеИмяФайла = Новый РегулярноеВыражение("^(?:(.+)_(\d+)_)?(\d{8})\.log$");
	РегулярноеИмяКаталога = Новый РегулярноеВыражение("^(.+)_(\d+)$");

КонецПроцедуры
