#native

// Общее представление события технологического журнала для разных форматов файлов.

Перем ПоляСобытия; // Строка - имена полей структуры события, см. НовоеСобытие
Перем ПустаяДата; // Дата

#Область ПрограммныйИнтерфейс

// Создает пустое событие технологического журнала.
//
// Возвращаемое значение:
//   Структура - событие:
//     * Время - Дата - местное время окончания события с точностью до секунды
//     * Микросекунды - Число - доля секунды времени окончания в микросекундах
//     * Длительность - Число - длительность события в микросекундах
//     * Имя - Строка - имя события (CALL, DBMSSQL, EXCP...)
//     * Уровень - Число - уровень вложенности события
//     * Свойства - Соответствие из КлючИЗначение - свойства события;
//       значения повторяющихся свойств собираются в Массив
//     * Текст - Строка - исходный текст события
//
Функция НовоеСобытие() Экспорт
	Событие = Новый Структура(ПоляСобытия);
	Событие.Время = ПустаяДата;
	Событие.Микросекунды = 0;
	Событие.Длительность = 0;
	Событие.Имя = "";
	Событие.Уровень = 0;
	Событие.Свойства = Новый Соответствие;
	Событие.Текст = "";
	Возврат Событие;
КонецФункции

// Добавляет свойство события. Значения повторяющихся свойств собираются в массив.
//
// Параметры:
//   Свойства - Соответствие - свойства события
//   Имя - Строка - имя свойства
//   Значение - Строка - значение свойства
//
Процедура ДобавитьСвойство(Свойства, Имя, Значение) Экспорт

	ТекущееЗначение = Свойства[Имя];
	Если ТекущееЗначение = Неопределено Тогда
		Свойства.Вставить(Имя, Значение);
	ИначеЕсли ТипЗнч(ТекущееЗначение) = Тип("Массив") Тогда
		ТекущееЗначение.Добавить(Значение);
	Иначе
		Значения = Новый Массив;
		Значения.Добавить(ТекущееЗначение);
		Значения.Добавить(Значение);
		Свойства.Вставить(Имя, Значения);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта()
	ПоляСобытия = "Время, Микросекунды, Длительность, Имя, Уровень, Свойства, Текст";
	ПустаяДата = Дата("00010101");
КонецПроцедуры
