#native

// Разбор формата JSON технологического журнала 1С:Предприятия (8.3.25+, format="json" в logcfg.xml).
//
// Каждая строка файла - плоский объект JSON со строковыми значениями: ts, duration, name, depth
// и далее свойства события. Ключи внутри объекта могут повторяться, поэтому объект разбирается
// построчно регулярным выражением, а не стандартным ЧтениеJSON, которое оставило бы одно значение.

Перем РегулярнаяПара;
Перем РегулярноеЗакрытие;
Перем РегулярноеВремя;

#Область ПрограммныйИнтерфейс

// Разбирает фрагмент файла технологического журнала в формате JSON на события.
//
// Параметры:
//   Текст - Строка - фрагмент файла из целых строк
//   ТекстЗавершен - Булево - Истина, если дописывания текста больше не будет:
//     последняя строка без перевода строки разбирается, а не возвращается в остатке
//
// Возвращаемое значение:
//   Структура - результат разбора:
//     * События - Массив из Структура - разобранные события, см. СобытияТехнологическогоЖурнала.НовоеСобытие
//     * Остаток - Строка - исходный текст незавершенной последней строки
//
Функция Разобрать(Знач Текст, Знач ТекстЗавершен = Ложь) Экспорт

	Результат = Новый Структура("События, Остаток", Новый Массив, "");

	Строки = СтрРазделить(Текст, Символы.ПС, Истина);
	НезавершеннаяСтрока = Строки[Строки.ВГраница()];
	Строки.Удалить(Строки.ВГраница());
	Если ТекстЗавершен Тогда
		Строки.Добавить(НезавершеннаяСтрока);
	Иначе
		Результат.Остаток = НезавершеннаяСтрока;
	КонецЕсли;

	Для Каждого Строка Из Строки Цикл
		Событие = РазобратьСтроку(СокрЛП(Строка));
		Если Событие <> Неопределено Тогда
			Результат.События.Добавить(Событие);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Проверяет, что текст файла технологического журнала записан в формате JSON.
//
// Параметры:
//   Текст - Строка - начало файла
//
// Возвращаемое значение:
//   Булево - Истина, если первый значащий символ - открывающая фигурная скобка
//
Функция ЭтоФорматJSON(Знач Текст) Экспорт
	Текст = СокрЛ(СтрЗаменить(Лев(Текст, 16), Символ(65279), ""));
	Возврат СтрНачинаетсяС(Текст, "{");
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РазобратьСтроку(Строка)

	Если НЕ СтрНачинаетсяС(Строка, "{") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Событие = СобытияТехнологическогоЖурнала.НовоеСобытие();
	Событие.Текст = Строка;

	РазобранаДлина = 0;
	Для Каждого Совпадение Из РегулярнаяПара.НайтиСовпадения(Строка) Цикл
		РазобранаДлина = РазобранаДлина + Совпадение.Длина;
		Ключ = СтрокаИзJSON(Совпадение.Группы[1].Значение);
		Значение = Совпадение.Группы[2].Значение;
		Если СтрНачинаетсяС(Значение, """") Тогда
			Значение = СтрокаИзJSON(Сред(Значение, 2, СтрДлина(Значение) - 2));
		КонецЕсли;
		ЗаполнитьПоле(Событие, Ключ, Значение);
	КонецЦикла;

	Если НЕ РегулярноеЗакрытие.Совпадает(Сред(Строка, РазобранаДлина + 1)) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Событие;

КонецФункции

Процедура ЗаполнитьПоле(Событие, Ключ, Значение)

	Если Ключ = "ts" Тогда
		ЗаполнитьВремя(Событие, Значение);
	ИначеЕсли Ключ = "duration" Тогда
		Событие.Длительность = Число(Значение);
	ИначеЕсли Ключ = "name" Тогда
		Событие.Имя = Значение;
	ИначеЕсли Ключ = "depth" Тогда
		Событие.Уровень = Число(Значение);
	Иначе
		СобытияТехнологическогоЖурнала.ДобавитьСвойство(Событие.Свойства, Ключ, Значение);
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьВремя(Событие, Значение)

	Совпадения = РегулярноеВремя.НайтиСовпадения(Значение);
	Если Совпадения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Группы = Совпадения[0].Группы;
	Событие.Время = Дата(Группы[1].Значение + Группы[2].Значение + Группы[3].Значение
		+ Группы[4].Значение + Группы[5].Значение + Группы[6].Значение);

	Дробь = Группы[7].Значение;
	Если ЗначениеЗаполнено(Дробь) Тогда
		Событие.Микросекунды = Число(Дробь) * Pow(10, 6 - СтрДлина(Дробь));
	КонецЕсли;

КонецПроцедуры

Функция СтрокаИзJSON(Значение)

	Если СтрНайти(Значение, "\") = 0 Тогда
		Возврат Значение;
	КонецЕсли;

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку("""" + Значение + """");
	Чтение.Прочитать();
	Результат = Чтение.ТекущееЗначение;
	Чтение.Закрыть();

	Возврат Результат;

КонецФункции

#КонецОбласти

РегулярнаяПара = Новый РегулярноеВыражение(
	"\G\s*[{,]\s*""((?:[^""\\]|\\.)*)""\s*:\s*(""(?:[^""\\]|\\.)*""|[^,}\s""]+)");
РегулярноеЗакрытие = Новый РегулярноеВыражение("^\s*\}\s*$");
РегулярноеВремя = Новый РегулярноеВыражение("^(\d{4})-(\d\d)-(\d\d)T(\d\d):(\d\d):(\d\d)(?:\.(\d+))?");
