// Перевод времени журналов 1С (местное время сервера) в метки времени OpenTelemetry.

#Область ПрограммныйИнтерфейс

// Переводит местное время журнала в наносекунды Unix epoch (UTC).
//
// Параметры:
//   МестноеВремя - Дата - местное время с точностью до секунды
//   Микросекунды - Число - доля секунды в микросекундах
//   ЧасовойПояс - Строка - часовой пояс, в котором записан журнал (IANA, Windows или GMT+ЧЧ:ММ)
//
// Возвращаемое значение:
//   Строка - наносекунды Unix epoch
//
Функция ВНаносекунды(Знач МестноеВремя, Знач Микросекунды, Знач ЧасовойПояс) Экспорт
	Возврат МикросекундыВНаносекунды(ВМикросекунды(МестноеВремя, Микросекунды, ЧасовойПояс));
КонецФункции

// Переводит местное время журнала в микросекунды Unix epoch (UTC).
//
// Параметры:
//   МестноеВремя - Дата - местное время с точностью до секунды
//   Микросекунды - Число - доля секунды в микросекундах
//   ЧасовойПояс - Строка - часовой пояс, в котором записан журнал (IANA, Windows или GMT+ЧЧ:ММ)
//
// Возвращаемое значение:
//   Число - микросекунды Unix epoch
//
Функция ВМикросекунды(Знач МестноеВремя, Знач Микросекунды, Знач ЧасовойПояс) Экспорт
	Секунды = УниверсальноеВремя(МестноеВремя, ЧасовойПояс) - Дата("19700101");
	Возврат Секунды * 1000000 + Микросекунды;
КонецФункции

// Переводит микросекунды Unix epoch в метку времени OpenTelemetry.
//
// Параметры:
//   Микросекунды - Число - микросекунды Unix epoch
//
// Возвращаемое значение:
//   Строка - наносекунды Unix epoch
//
Функция МикросекундыВНаносекунды(Знач Микросекунды) Экспорт
	Возврат Формат(Микросекунды * 1000, "ЧГ=0");
КонецФункции

#КонецОбласти
