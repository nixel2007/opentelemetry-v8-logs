#native

// Разбор свойства Context события технологического журнала - стека вызовов встроенного языка.
// Первая строка - внешний кадр, каждая следующая - вызванный из предыдущей, последняя - место,
// где выполнялся код в момент события. Кадр - строка «Модуль : НомерСтроки : Выражение»,
// у динамического кода (Выполнить, Вычислить) модуль пустой. Вызов сервера - строка
// «ОбщийМодуль.Вызов : <модуль>.<метод>» или «Форма.Вызов : <форма>.Модуль.<метод>».

Перем ШаблонКадра; // РегулярноеВыражение - модуль : строка : выражение
Перем ШаблонКадраИсключения; // РегулярноеВыражение - {Модуль(строка)}: выражение
Перем ШаблонВызоваСервера; // РегулярноеВыражение - <вид>.Вызов : <модуль>.<метод>
Перем ШаблонВызова; // РегулярноеВыражение - [Новый] [Квалификатор.]Имя(
Перем ШаблонСтроки; // РегулярноеВыражение - строковый литерал встроенного языка
Перем ШаблонСлова; // РегулярноеВыражение - идентификатор или ключевое слово
Перем КлючевыеСлова; // Соответствие: ключевое слово в верхнем регистре -> Истина
Перем СловаПродолжения; // Соответствие: операция, продолжающая оператор (И, ИЛИ, НЕ) -> Истина
Перем ЗавершенияЗаголовков; // Соответствие: первое слово условия или цикла -> последнее (ЕСЛИ -> ТОГДА)
Перем МетодыПлатформы; // Соответствие: метод платформы, вызывающий обработчики модуля -> Истина
Перем ТипыМенеджеров; // Соответствие: коллекция менеджеров (Документы) -> вид объекта (Документ)

#Область ПрограммныйИнтерфейс

// Место в коде события: модуль и номер строки последнего кадра Context, функция, в которой лежит
// эта строка, если ее можно определить надежно. См. «Место в коде» в документации телеметрии.
//
// Параметры:
//   Контекст - Строка - значение свойства Context; пустая строка - свойства нет
//
// Возвращаемое значение:
//   Структура, Неопределено - Модуль, Строка (пустая - номера строки нет), ИмяФункции (пустая - функция
//     не определена); Неопределено - в Context нет кадра с модулем и вызова сервера
//
Функция МестоВКоде(Контекст) Экспорт

	Строки = Новый Массив;
	Для Каждого СтрокаКонтекста Из СтрРазделить(Контекст, Символы.ПС, Ложь) Цикл
		Если ЗначениеЗаполнено(СокрЛП(СтрокаКонтекста)) Тогда
			Строки.Добавить(СокрЛП(СтрокаКонтекста));
		КонецЕсли;
	КонецЦикла;

	Если Строки.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Номер строки динамического кода относится к тексту, переданному в Выполнить или Вычислить:
	// место в коде - кадр, который его выполнил
	Индекс = Строки.ВГраница();
	Кадр = КадрКонтекста(Строки[Индекс]);
	Пока Кадр <> Неопределено И ПустаяСтрока(Кадр.Модуль) И Индекс > 0 Цикл
		Индекс = Индекс - 1;
		Кадр = КадрКонтекста(Строки[Индекс]);
	КонецЦикла;

	Если Кадр = Неопределено Тогда
		Вызов = ВызовСервера(Строки[Индекс]);
		Если Вызов = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат НовоеМестоВКоде(Вызов.Модуль, "", Вызов.ИмяФункции);
	КонецЕсли;

	Если ПустаяСтрока(Кадр.Модуль) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ИмяФункции = "";
	Если Индекс > 0 Тогда
		ИмяФункции = ВызваннаяФункция(Строки[Индекс - 1], Кадр.Модуль);
	КонецЕсли;

	Возврат НовоеМестоВКоде(Кадр.Модуль, Кадр.Строка, ИмяФункции);

КонецФункции

// Кадр стека Context: «Модуль : НомерСтроки : Выражение».
//
// Параметры:
//   СтрокаКонтекста - Строка - строка свойства Context
//
// Возвращаемое значение:
//   Структура, Неопределено - Модуль (пустой у динамического кода), Строка, Выражение;
//     Неопределено - строка не кадр
//
Функция КадрКонтекста(СтрокаКонтекста) Экспорт
	Совпадения = ШаблонКадра.НайтиСовпадения(СокрЛП(СтрокаКонтекста));
	Если Совпадения.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Группы = Совпадения[0].Группы;
	Возврат Новый Структура("Модуль, Строка, Выражение",
		СокрЛП(Группы[1].Значение), Группы[2].Значение, Группы[3].Значение);
КонецФункции

// Первый кадр «{Модуль(НомерСтроки)}: Выражение» описания ошибки (свойство Descr события EXCP).
//
// Параметры:
//   Описание - Строка - значение свойства Descr
//
// Возвращаемое значение:
//   Структура, Неопределено - Модуль, Строка, Выражение; Неопределено - кадра нет
//
Функция КадрИсключения(Описание) Экспорт
	Совпадения = ШаблонКадраИсключения.НайтиСовпадения(Описание);
	Если Совпадения.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Группы = Совпадения[0].Группы;
	Возврат Новый Структура("Модуль, Строка, Выражение",
		СокрЛП(Группы[1].Значение), Группы[2].Значение, Группы[3].Значение);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовоеМестоВКоде(Модуль, Строка, ИмяФункции)
	Возврат Новый Структура("Модуль, Строка, ИмяФункции", Модуль, Строка, ИмяФункции);
КонецФункции

// Вызов сервера в Context. Модуль формы в вызове называется <форма>.Модуль, а в кадрах - <форма>.Форма:
// модуль возвращается в виде кадра.
//
// Параметры:
//   СтрокаКонтекста - Строка - строка свойства Context
//
// Возвращаемое значение:
//   Структура, Неопределено - Модуль, ИмяФункции; Неопределено - строка не вызов сервера
//
Функция ВызовСервера(СтрокаКонтекста)

	Совпадения = ШаблонВызоваСервера.НайтиСовпадения(СтрокаКонтекста);
	Если Совпадения.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Группы = Совпадения[0].Группы;
	Модуль = Группы[2].Значение;
	Если Группы[1].Значение = "Форма" Тогда
		СуффиксМодуля = ".Модуль";
		Если НЕ СтрЗаканчиваетсяНа(Модуль, СуффиксМодуля) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Модуль = Лев(Модуль, СтрДлина(Модуль) - СтрДлина(СуффиксМодуля)) + ".Форма";
	КонецЕсли;

	Возврат Новый Структура("Модуль, ИмяФункции", Модуль, Группы[3].Значение);

КонецФункции

// Функция, в которой лежит кадр модуля Модуль, по предыдущей строке Context - месту ее вызова.
// Определяется, только если вызов прямой: вызов сервера этой функции или выражение кадра с единственным
// вызовом функции этого модуля. Вызов метода платформы, который передает управление обработчику
// события, функцию не определяет.
//
// Параметры:
//   ПредыдущаяСтрока - Строка - строка Context перед кадром
//   Модуль - Строка - модуль кадра
//
// Возвращаемое значение:
//   Строка - имя функции; пустая строка - функция не определена
//
Функция ВызваннаяФункция(ПредыдущаяСтрока, Модуль)

	МодульБезРасширения = МодульБезРасширения(Модуль);

	Вызов = ВызовСервера(ПредыдущаяСтрока);
	Если Вызов <> Неопределено Тогда
		Возврат ?(Вызов.Модуль = МодульБезРасширения, Вызов.ИмяФункции, "");
	КонецЕсли;

	Кадр = КадрКонтекста(ПредыдущаяСтрока);
	Если Кадр = Неопределено ИЛИ ПустаяСтрока(Кадр.Модуль) Тогда
		Возврат "";
	КонецЕсли;

	// В кадре одна строка модуля: у многострочного оператора вызов может быть на другой строке
	Текст = ТекстБезСтрокИКомментария(Кадр.Выражение);
	Если НЕ ЗаконченныйОператор(Текст) Тогда
		Возврат "";
	КонецЕсли;

	Вызовы = ВызовыФункций(Текст);
	Если Вызовы.Количество() <> 1 ИЛИ МетодыПлатформы[ВРег(Вызовы[0].Имя)] <> Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Квалификатор = Вызовы[0].Квалификатор;
	Если ПустаяСтрока(Квалификатор) Тогда
		ПрямойВызов = (Кадр.Модуль = Модуль);
	Иначе
		ПрямойВызов = (МодульКвалификатора(Квалификатор) = МодульБезРасширения);
	КонецЕсли;

	Возврат ?(ПрямойВызов, Вызовы[0].Имя, "");

КонецФункции

// Выражение кадра без содержимого строковых литералов и комментария.
//
// Параметры:
//   Выражение - Строка - выражение кадра
//
// Возвращаемое значение:
//   Строка - выражение, литералы в нем пустые
//
Функция ТекстБезСтрокИКомментария(Выражение)
	Текст = ШаблонСтроки.Заменить(Выражение, """""");
	НачалоКомментария = СтрНайти(Текст, "//");
	Если НачалоКомментария > 0 Тогда
		Текст = Лев(Текст, НачалоКомментария - 1);
	КонецЕсли;
	Возврат СокрЛП(Текст);
КонецФункции

// Строка модуля - оператор целиком: скобки закрыты, оператор завершен точкой с запятой, а условие и
// заголовок цикла - словами Тогда и Цикл, и строка не продолжает оператор предыдущей строки.
//
// Параметры:
//   Текст - Строка - выражение кадра без строк и комментария
//
// Возвращаемое значение:
//   Булево - Истина, если оператор законченный
//
Функция ЗаконченныйОператор(Текст)

	Слова = ШаблонСлова.НайтиСовпадения(Текст);
	Если Слова.Количество() = 0 ИЛИ НЕ СтрНачинаетсяС(Текст, Слова[0].Значение) Тогда
		Возврат Ложь;
	КонецЕсли;

	ПервоеСлово = ВРег(Слова[0].Значение);
	СкобкиЗакрыты = (СтрЧислоВхождений(Текст, "(") = СтрЧислоВхождений(Текст, ")"));
	Если НЕ СкобкиЗакрыты ИЛИ СловаПродолжения[ПервоеСлово] <> Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Завершение = ЗавершенияЗаголовков[ПервоеСлово];
	Если Завершение = Неопределено Тогда
		Возврат СтрЗаканчиваетсяНа(Текст, ";");
	КонецЕсли;

	ПоследнееСлово = Слова[Слова.Количество() - 1].Значение;
	Возврат СтрЗаканчиваетсяНа(Текст, ПоследнееСлово) И ВРег(ПоследнееСлово) = Завершение;

КонецФункции

// Вызовы функций и методов в выражении кадра, без конструкторов.
//
// Параметры:
//   Текст - Строка - выражение кадра без строк и комментария
//
// Возвращаемое значение:
//   Массив из Структура - Квалификатор (пустой у вызова без него), Имя
//
Функция ВызовыФункций(Текст)

	Вызовы = Новый Массив;
	Для Каждого Совпадение Из ШаблонВызова.НайтиСовпадения(Текст) Цикл
		Группы = Совпадение.Группы;
		Имя = Группы[3].Значение;
		Если ЗначениеЗаполнено(Группы[1].Значение) ИЛИ КлючевыеСлова[ВРег(Имя)] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Квалификатор = Группы[2].Значение;
		Если ЗначениеЗаполнено(Квалификатор) Тогда
			Квалификатор = Лев(Квалификатор, СтрДлина(Квалификатор) - 1);
		КонецЕсли;
		Вызовы.Добавить(Новый Структура("Квалификатор, Имя", Квалификатор, Имя));
	КонецЦикла;

	Возврат Вызовы;

КонецФункции

// Модуль, функцию которого вызывают через квалификатор: общий модуль (ОбменДанными ->
// ОбщийМодуль.ОбменДанными.Модуль) или модуль менеджера (Документы.Заказ -> Документ.Заказ.МодульМенеджера).
//
// Параметры:
//   Квалификатор - Строка - часть вызова перед именем функции, без точки
//
// Возвращаемое значение:
//   Строка - модуль; пустая строка - квалификатор не общий модуль и не менеджер
//
Функция МодульКвалификатора(Квалификатор)

	Части = СтрРазделить(Квалификатор, ".");
	Если Части.Количество() = 1 Тогда
		Возврат "ОбщийМодуль." + Квалификатор + ".Модуль";
	КонецЕсли;

	// Менеджер - коллекция и имя объекта: Документы.Заказ
	ЧастейМенеджера = 2;
	ВидОбъекта = ТипыМенеджеров[Части[0]];
	Если Части.Количество() <> ЧастейМенеджера ИЛИ ВидОбъекта = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат ВидОбъекта + "." + Части[1] + ".МодульМенеджера";

КонецФункции

// Модуль кадра без имени расширения: у модулей расширений оно стоит перед модулем через пробел.
//
// Параметры:
//   Модуль - Строка - модуль кадра
//
// Возвращаемое значение:
//   Строка - модуль без имени расширения
//
Функция МодульБезРасширения(Модуль)
	Возврат Сред(Модуль, СтрНайти(Модуль, " ", НаправлениеПоиска.СКонца) + 1);
КонецФункции

Процедура ДобавитьСлова(Соответствие, Слова)
	Для Каждого Слово Из СтрРазделить(Слова, ",") Цикл
		Соответствие.Вставить(ВРег(Слово), Истина);
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта()

	ШаблонКадра = Новый РегулярноеВыражение("\A(.*?)\s*:\s*([0-9]+)\s*:\s*(.*)\z");
	ШаблонКадраИсключения = Новый РегулярноеВыражение("\{([^{}\r\n]+)\(([0-9]+)\)\}:[ \t]*([^\r\n]*)");
	ШаблонВызоваСервера = Новый РегулярноеВыражение("\A(ОбщийМодуль|Форма)\.Вызов : (\S+)\.([^.\s]+)\z");
	ШаблонВызова = Новый РегулярноеВыражение("(?<!\w)((?i:новый|new)\s+)?((?:[^\W\d]\w*\.)*)([^\W\d]\w*)\s*\(");
	ШаблонСтроки = Новый РегулярноеВыражение("""[^""\r\n]*""?");
	ШаблонСлова = Новый РегулярноеВыражение("[^\W\d]\w*");

	СловаПродолжения = Новый Соответствие;
	ДобавитьСлова(СловаПродолжения, "И,ИЛИ,НЕ,And,Or,Not");

	ЗавершенияЗаголовков = Новый Соответствие;
	Заголовки = "Если:Тогда,ИначеЕсли:Тогда,Пока:Цикл,Для:Цикл,If:Then,ElsIf:Then,While:Do,For:Do";
	Для Каждого Пара Из СтрРазделить(Заголовки, ",") Цикл
		Слова = СтрРазделить(Пара, ":");
		ЗавершенияЗаголовков.Вставить(ВРег(Слова[0]), ВРег(Слова[1]));
	КонецЦикла;

	КлючевыеСлова = Новый Соответствие;
	ДобавитьСлова(КлючевыеСлова, "Если,ИначеЕсли,Тогда,Пока,Для,Каждого,Из,По,Цикл,Возврат,И,ИЛИ,НЕ,ВызватьИсключение,"
		+ "If,ElsIf,Then,While,For,Each,In,To,Do,Return,And,Or,Not,Raise");

	// Записать, проверка заполнения, получение формы и данных выбора, загрузка и сохранение настроек
	// вызывают обработчики событий модуля объекта, формы, менеджера или хранилища настроек
	МетодыПлатформы = Новый Соответствие;
	ДобавитьСлова(МетодыПлатформы, "Записать,Прочитать,Удалить,УстановитьПометкуУдаления,ПроверитьЗаполнение,"
		+ "Заполнить,Скопировать,ПолучитьФорму,ПолучитьДанныеВыбора,Загрузить,Сохранить,ПолучитьОписание,"
		+ "УстановитьОписание,Write,Read,Delete,SetDeletionMark,CheckFilling,Fill,Copy,GetForm,GetChoiceData,"
		+ "Load,Save,GetDescription,SetDescription");

	ТипыМенеджеров = Новый Соответствие;
	ТипыМенеджеров.Вставить("Справочники", "Справочник");
	ТипыМенеджеров.Вставить("Документы", "Документ");
	ТипыМенеджеров.Вставить("ЖурналыДокументов", "ЖурналДокументов");
	ТипыМенеджеров.Вставить("Перечисления", "Перечисление");
	ТипыМенеджеров.Вставить("Отчеты", "Отчет");
	ТипыМенеджеров.Вставить("Обработки", "Обработка");
	ТипыМенеджеров.Вставить("ПланыВидовХарактеристик", "ПланВидовХарактеристик");
