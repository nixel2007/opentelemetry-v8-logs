#native

// Ограничение размеров тела записи лога и значений атрибутов. Размеры считаются в байтах UTF-8,
// значение режется по границе символа, метка обрезки - в конце значения и входит в лимит.
// Лимит 0 или меньше - без ограничения. См. «Ограничение размеров» в документации телеметрии.

Перем РазмерТелаБайт; // Число - лимит тела записи лога
Перем РазмерЗначенияБайт; // Число - лимит строкового значения атрибута
Перем РазмерАтрибутовБайт; // Число - лимит суммы ключей и строковых значений атрибутов
Перем МеткаОбрезки; // Строка - метка в конце обрезанного значения
Перем РазмерМетки; // Число - размер метки в байтах UTF-8

#Область ПрограммныйИнтерфейс

// Ограничивает тело записи лога. Если в теле указаны значения, обрезаются они - сначала самое
// длинное, а текст между ними остается целиком. Если тело без значений в лимит не помещается
// или значения не указаны, обрезается конец тела.
//
// Параметры:
//   Тело - Строка - тело записи лога
//   ЗначенияТела - Массив из Структура, Неопределено - значения в теле по порядку, не пересекаются:
//     * Ключ - Строка - имя значения для списка обрезанных
//     * Начало - Число - позиция первого символа значения в теле, с 1
//     * Длина - Число - длина значения в символах
//     * НедопустимоеОкончание - РегулярноеВыражение, Неопределено - конец обрезанного значения,
//       который отбрасывается перед меткой (например, разорванное экранирование)
//
// Возвращаемое значение:
//   Структура - Значение (Строка - тело в пределах лимита), Обрезано (Булево), ИсходныйРазмер и
//     Размер (Число - размеры тела до и после обрезки в байтах; при Обрезано = Ложь - 0),
//     Ключи (Массив из Строка - ключи обрезанных значений по порядку тела, без повторов;
//     при обрезке конца тела - пустой)
//
Функция ОграничитьТело(Тело, ЗначенияТела = Неопределено) Экспорт

	Результат = Новый Структура("Значение, Обрезано", Тело, Ложь);
	Результат.Вставить("ИсходныйРазмер", 0);
	Результат.Вставить("Размер", 0);
	Результат.Вставить("Ключи", Новый Массив);
	Если НЕ ПревышаетЛимит(Тело, РазмерТелаБайт) Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.ИсходныйРазмер = РазмерВБайтах(Тело);
	Результат.Обрезано = Истина;
	Если ЗначенияТела <> Неопределено Тогда
		ОграничитьЗначенияТела(Результат, ЗначенияТела);
	КонецЕсли;
	Если Результат.Ключи.Количество() = 0 Тогда
		Результат.Значение = Обрезанное(Тело, РазмерТелаБайт);
	КонецЕсли;
	Результат.Размер = РазмерВБайтах(Результат.Значение);
	Возврат Результат;

КонецФункции

// Проверяет, нужно ли обрезать тело записи лога: значения тела стоит искать только для такого тела.
//
// Параметры:
//   Тело - Строка - тело записи лога
//
// Возвращаемое значение:
//   Булево - Истина, если тело больше лимита
//
Функция ТелоПревышаетЛимит(Тело) Экспорт
	Возврат ПревышаетЛимит(Тело, РазмерТелаБайт);
КонецФункции

// Ограничивает атрибуты: каждое строковое значение и каждую строку массива - лимитом значения,
// затем сумму ключей и строковых значений - лимитом атрибутов, обрезая сначала самое длинное
// строковое значение. Нестроковые значения не меняются, но их ключи входят в сумму.
//
// Параметры:
//   Атрибуты - Соответствие - ключ атрибута -> значение; обрезанные значения заменяются
//     (массив - новым массивом)
//
// Возвращаемое значение:
//   Массив из Структура - обрезанные атрибуты: Ключ (Строка), ИсходныйРазмер и Размер (Число - размеры
//     строк значения до и после обрезки в байтах); каждый ключ - один раз
//
Функция ОграничитьАтрибуты(Атрибуты) Экспорт

	Обрезки = Новый Соответствие;
	Для Каждого Атрибут Из Атрибуты Цикл
		Если ЗначениеПревышаетЛимит(Атрибут.Значение) Тогда
			Обрезки.Вставить(Атрибут.Ключ, РазмерЗначения(Атрибут.Значение));
		КонецЕсли;
	КонецЦикла;
	Для Каждого Обрезка Из Обрезки Цикл
		Атрибуты.Вставить(Обрезка.Ключ, ОбрезанноеЗначение(Атрибуты[Обрезка.Ключ]));
	КонецЦикла;

	ОграничитьСумму(Атрибуты, Обрезки);

	Результат = Новый Массив;
	Для Каждого Обрезка Из Обрезки Цикл
		Размер = РазмерЗначения(Атрибуты[Обрезка.Ключ]);
		Результат.Добавить(Новый Структура("Ключ, ИсходныйРазмер, Размер", Обрезка.Ключ, Обрезка.Значение, Размер));
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Обрезает значения тела, начиная с самого длинного, пока тело не поместится в лимит. Каждое значение
// обрезается от исходного и не короче одного символа с меткой. Если тело так и не поместилось,
// результат не меняется.
//
// Параметры:
//   Результат - Структура - результат ОграничитьТело: Значение - исходное тело, ИсходныйРазмер;
//     если тело поместилось, заполняются Значение и Ключи
//   ЗначенияТела - Массив из Структура - значения в теле, см. ОграничитьТело
//
Процедура ОграничитьЗначенияТела(Результат, ЗначенияТела)

	Тело = Результат.Значение;
	Размеры = Новый Соответствие; // номер значения в ЗначенияТела -> размер в байтах
	Для Номер = 0 По ЗначенияТела.ВГраница() Цикл
		ЗначениеТела = ЗначенияТела[Номер];
		Размеры.Вставить(Номер, РазмерВБайтах(Сред(Тело, ЗначениеТела.Начало, ЗначениеТела.Длина)));
	КонецЦикла;

	Обрезанные = Новый Соответствие; // номер значения -> обрезанное значение
	Сумма = Результат.ИсходныйРазмер;
	НаименьшийЛимит = РазмерМетки + 1;
	Пока Сумма > РазмерТелаБайт Цикл
		НомерЗначения = КлючСамогоДлинногоЗначения(Размеры);
		Если НомерЗначения = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Было = Размеры[НомерЗначения];
		Лимит = Макс(НаименьшийЛимит, Было - (Сумма - РазмерТелаБайт));
		Если Лимит >= Было Тогда
			Возврат;
		КонецЕсли;
		ЗначениеТела = ЗначенияТела[НомерЗначения];
		НовоеЗначение = ОбрезанноеЗначениеТела(Сред(Тело, ЗначениеТела.Начало, ЗначениеТела.Длина), Лимит,
			ЗначениеТела.НедопустимоеОкончание);
		Обрезанные.Вставить(НомерЗначения, НовоеЗначение);
		Стало = РазмерВБайтах(НовоеЗначение);
		Размеры.Вставить(НомерЗначения, Стало);
		Сумма = Сумма - Было + Стало;
	КонецЦикла;

	Части = Новый Массив;
	Позиция = 1;
	Для Номер = 0 По ЗначенияТела.ВГраница() Цикл
		НовоеЗначение = Обрезанные[Номер];
		Если НовоеЗначение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ЗначениеТела = ЗначенияТела[Номер];
		Части.Добавить(Сред(Тело, Позиция, ЗначениеТела.Начало - Позиция));
		Части.Добавить(НовоеЗначение);
		Позиция = ЗначениеТела.Начало + ЗначениеТела.Длина;
		Если Результат.Ключи.Найти(ЗначениеТела.Ключ) = Неопределено Тогда
			Результат.Ключи.Добавить(ЗначениеТела.Ключ);
		КонецЕсли;
	КонецЦикла;
	Части.Добавить(Сред(Тело, Позиция));
	Результат.Значение = СтрСоединить(Части);

КонецПроцедуры

// Начало значения с меткой обрезки в пределах лимита; недопустимое окончание начала отбрасывается.
//
// Параметры:
//   Значение - Строка - обрезаемое значение
//   Лимит - Число - лимит в байтах UTF-8 вместе с меткой, больше размера метки
//   НедопустимоеОкончание - РегулярноеВыражение, Неопределено - см. ОграничитьТело
//
// Возвращаемое значение:
//   Строка - начало значения и метка обрезки
//
Функция ОбрезанноеЗначениеТела(Значение, Лимит, НедопустимоеОкончание)
	НачалоЗначения = НачалоПоРазмеру(Значение, Лимит - РазмерМетки);
	Если НедопустимоеОкончание <> Неопределено Тогда
		НачалоЗначения = НедопустимоеОкончание.Заменить(НачалоЗначения, "");
	КонецЕсли;
	Возврат НачалоЗначения + МеткаОбрезки;
КонецФункции

Процедура ОграничитьСумму(Атрибуты, Обрезки)

	Если РазмерАтрибутовБайт = 0 Тогда
		Возврат;
	КонецЕсли;

	// Символ занимает не больше 3 байт UTF-8: по длине строк сумму можно оценить без подсчета байт
	МаксБайтНаСимвол = 3;
	ДлинаСимволов = 0;
	Для Каждого Атрибут Из Атрибуты Цикл
		ДлинаСимволов = ДлинаСимволов + СтрДлина(Атрибут.Ключ) + ДлинаСтроковогоЗначения(Атрибут.Значение);
	КонецЦикла;
	Если ДлинаСимволов * МаксБайтНаСимвол <= РазмерАтрибутовБайт Тогда
		Возврат;
	КонецЕсли;

	Размеры = Новый Соответствие; // строковые значения верхнего уровня - кандидаты на обрезку
	Сумма = 0;
	Для Каждого Атрибут Из Атрибуты Цикл
		Размер = РазмерВСумме(Атрибут.Значение);
		Если ТипЗнч(Атрибут.Значение) = Тип("Строка") Тогда
			Размеры.Вставить(Атрибут.Ключ, Размер);
		КонецЕсли;
		Сумма = Сумма + РазмерВБайтах(Атрибут.Ключ) + Размер;
	КонецЦикла;

	Пока Сумма > РазмерАтрибутовБайт Цикл
		Ключ = КлючСамогоДлинногоЗначения(Размеры);
		Если Ключ = Неопределено Тогда
			Прервать;
		КонецЕсли;
		Было = Размеры[Ключ];
		Лимит = Макс(РазмерМетки, Было - (Сумма - РазмерАтрибутовБайт));
		Если Лимит >= Было Тогда
			Прервать;
		КонецЕсли;
		Значение = Атрибуты[Ключ];
		Если Обрезки[Ключ] = Неопределено Тогда
			Обрезки.Вставить(Ключ, Было);
		КонецЕсли;
		Атрибуты.Вставить(Ключ, Обрезанное(Значение, Лимит));
		Стало = РазмерВБайтах(Атрибуты[Ключ]);
		Размеры.Вставить(Ключ, Стало);
		Сумма = Сумма - Было + Стало;
	КонецЦикла;

КонецПроцедуры

// Строка длиннее лимита значения - сама или на любой глубине массива или соответствия.
//
// Параметры:
//   Значение - Произвольный - значение атрибута
//
// Возвращаемое значение:
//   Булево - Истина, если значение нужно обрезать
//
Функция ЗначениеПревышаетЛимит(Значение)
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка") Тогда
		Возврат ПревышаетЛимит(Значение, РазмерЗначенияБайт);
	КонецЕсли;
	Если ТипЗначения = Тип("Массив") Тогда
		Для Каждого Элемент Из Значение Цикл
			Если ЗначениеПревышаетЛимит(Элемент) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если ТипЗначения = Тип("Соответствие") Тогда
		Для Каждого Пара Из Значение Цикл
			Если ЗначениеПревышаетЛимит(Пара.Значение) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

// Значение со строками, обрезанными лимитом значения; массив и соответствие - новые.
//
// Параметры:
//   Значение - Произвольный - значение атрибута
//
// Возвращаемое значение:
//   Произвольный - обрезанное значение
//
Функция ОбрезанноеЗначение(Значение)
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка") Тогда
		Если ПревышаетЛимит(Значение, РазмерЗначенияБайт) Тогда
			Возврат Обрезанное(Значение, РазмерЗначенияБайт);
		КонецЕсли;
		Возврат Значение;
	КонецЕсли;
	Если ТипЗначения = Тип("Массив") Тогда
		Элементы = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			НовыйЭлемент = ОбрезанноеЗначение(Элемент);
			Элементы.Добавить(НовыйЭлемент);
		КонецЦикла;
		Возврат Элементы;
	КонецЕсли;
	Если ТипЗначения = Тип("Соответствие") Тогда
		Пары = Новый Соответствие;
		Для Каждого Пара Из Значение Цикл
			НовоеЗначение = ОбрезанноеЗначение(Пара.Значение);
			Пары.Вставить(Пара.Ключ, НовоеЗначение);
		КонецЦикла;
		Возврат Пары;
	КонецЕсли;
	Возврат Значение;
КонецФункции

// Размер строк значения в байтах: строки, строки массива и соответствия на любой глубине.
//
// Параметры:
//   Значение - Произвольный - значение атрибута
//
// Возвращаемое значение:
//   Число - размер в байтах UTF-8; без строк - 0
//
Функция РазмерЗначения(Значение)
	Возврат РазмерСтрок(Значение, Ложь);
КонецФункции

// Размер значения в сумме атрибутов: строки и ключи соответствий на любой глубине.
//
// Параметры:
//   Значение - Произвольный - значение атрибута
//
// Возвращаемое значение:
//   Число - размер в байтах UTF-8
//
Функция РазмерВСумме(Значение)
	Возврат РазмерСтрок(Значение, Истина);
КонецФункции

Функция РазмерСтрок(Значение, СКлючами)
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка") Тогда
		Возврат РазмерВБайтах(Значение);
	КонецЕсли;
	Размер = 0;
	Если ТипЗначения = Тип("Массив") Тогда
		Для Каждого Элемент Из Значение Цикл
			Размер = Размер + РазмерСтрок(Элемент, СКлючами);
		КонецЦикла;
	КонецЕсли;
	Если ТипЗначения = Тип("Соответствие") Тогда
		Для Каждого Пара Из Значение Цикл
			Размер = Размер + РазмерСтрок(Пара.Значение, СКлючами);
			Если СКлючами Тогда
				Размер = Размер + РазмерВБайтах(Строка(Пара.Ключ));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Размер;
КонецФункции

Функция КлючСамогоДлинногоЗначения(Размеры)
	Ключ = Неопределено;
	Максимум = РазмерМетки;
	Для Каждого Размер Из Размеры Цикл
		Если Размер.Значение > Максимум Тогда
			Максимум = Размер.Значение;
			Ключ = Размер.Ключ;
		КонецЕсли;
	КонецЦикла;
	Возврат Ключ;
КонецФункции

Функция ДлинаСтроковогоЗначения(Значение)
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка") Тогда
		Возврат СтрДлина(Значение);
	КонецЕсли;
	Длина = 0;
	Если ТипЗначения = Тип("Массив") Тогда
		Для Каждого Элемент Из Значение Цикл
			Длина = Длина + ДлинаСтроковогоЗначения(Элемент);
		КонецЦикла;
	КонецЕсли;
	Если ТипЗначения = Тип("Соответствие") Тогда
		Для Каждого Пара Из Значение Цикл
			Длина = Длина + СтрДлина(Строка(Пара.Ключ)) + ДлинаСтроковогоЗначения(Пара.Значение);
		КонецЦикла;
	КонецЕсли;
	Возврат Длина;
КонецФункции

Функция ПревышаетЛимит(Значение, Лимит)
	Если Лимит = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	// Символ занимает не больше 3 байт UTF-8: короткую строку можно не перекодировать
	МаксБайтНаСимвол = 3;
	Если СтрДлина(Значение) * МаксБайтНаСимвол <= Лимит Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат РазмерВБайтах(Значение) > Лимит;
КонецФункции

// Начало значения не длиннее лимита вместе с меткой обрезки, по границе символа. Если метка
// в лимит не помещается, - начало значения без метки.
//
// Параметры:
//   Значение - Строка - обрезаемое значение
//   Лимит - Число - лимит в байтах UTF-8 вместе с меткой
//
// Возвращаемое значение:
//   Строка - начало значения и метка обрезки
//
Функция Обрезанное(Значение, Лимит)
	Если Лимит > РазмерМетки Тогда
		Возврат НачалоПоРазмеру(Значение, Лимит - РазмерМетки) + МеткаОбрезки;
	КонецЕсли;
	Возврат НачалоПоРазмеру(Значение, Лимит);
КонецФункции

// Начало значения не длиннее размера, по границе символа.
//
// Параметры:
//   Значение - Строка - обрезаемое значение
//   Остаток - Число - размер в байтах UTF-8
//
// Возвращаемое значение:
//   Строка - начало значения
//
Функция НачалоПоРазмеру(Значение, Остаток)

	Количество = Мин(СтрДлина(Значение), Остаток);
	Размер = РазмерВБайтах(Лев(Значение, Количество));
	// Символ занимает не больше 3 байт: на каждые 3 лишних байта убирается не меньше символа
	МаксБайтНаСимвол = 3;
	Пока Размер > Остаток Цикл
		Количество = Количество - Макс(1, Цел((Размер - Остаток) / МаксБайтНаСимвол));
		Размер = РазмерВБайтах(Лев(Значение, Количество));
	КонецЦикла;
	// Старшая половина суррогатной пары без младшей - не символ
	НачалоСуррогатов = 55296;
	КонецСтаршихСуррогатов = 56319;
	Если Количество > 0 Тогда
		Код = КодСимвола(Значение, Количество);
		Если Код >= НачалоСуррогатов И Код <= КонецСтаршихСуррогатов Тогда
			Количество = Количество - 1;
		КонецЕсли;
	КонецЕсли;

	Возврат Лев(Значение, Количество);

КонецФункции

Функция РазмерВБайтах(Значение)
	Возврат ПолучитьДвоичныеДанныеИзСтроки(Значение, "UTF-8").Размер();
КонецФункции

#КонецОбласти

// Параметры:
//   РазмерТела - Число, Строка - настройка otel.v8-logs.limits.body-size
//   РазмерЗначения - Число, Строка - настройка otel.v8-logs.limits.attribute-value-size
//   РазмерАтрибутов - Число, Строка - настройка otel.v8-logs.limits.attributes-size
//
&Желудь
Процедура ПриСозданииОбъекта(
		&Деталька(Значение = "otel.v8-logs.limits.body-size", ЗначениеПоУмолчанию = 131072) РазмерТела,
		&Деталька(Значение = "otel.v8-logs.limits.attribute-value-size", ЗначениеПоУмолчанию = 2048) РазмерЗначения,
		&Деталька(Значение = "otel.v8-logs.limits.attributes-size", ЗначениеПоУмолчанию = 32768) РазмерАтрибутов)

	// Отрицательный лимит, как и 0, - без ограничения
	РазмерТелаБайт = Макс(0, Число(РазмерТела));
	РазмерЗначенияБайт = Макс(0, Число(РазмерЗначения));
	РазмерАтрибутовБайт = Макс(0, Число(РазмерАтрибутов));
	МеткаОбрезки = "...[truncated]";
	РазмерМетки = РазмерВБайтах(МеткаОбрезки);

КонецПроцедуры
