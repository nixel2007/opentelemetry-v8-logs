#Использовать opentelemetry

// Сборка трасс из событий технологического журнала.
//
// Корень трассы - событие вызова (по умолчанию CALL и SCALL). Платформа пишет событие по его
// окончании, поэтому вложенные события вызова появляются в журнале раньше него. Они копятся
// в буфере потока (процесс + OSThread), а при появлении корня в трассу попадают события потока,
// интервал которых [окончание - длительность, окончание] лежит внутри интервала корня.
// Родитель события - ближайшее охватывающее событие с меньшим уровнем вложенности.
// Исключения (EXCP) становятся событиями exception родительского спана.

Перем Трассировщик;
Перем ЧасовойПоясЖурнала;
Перем КорневыеСобытия; // Соответствие: имя события -> Истина
Перем СистемыБаз; // Соответствие: имя события СУБД -> db.system.name
Перем Буферы; // Соответствие: ключ потока -> Массив элементов
Перем МаксимумБуфера;

#Область ПрограммныйИнтерфейс

// Добавляет событие журнала. Для корневого события строит и завершает трассу.
//
// Параметры:
//   Событие - Структура - событие, см. СобытияТехЖурнала.НовоеСобытие
//   ОписаниеФайла - Структура - описание файла журнала: Каталог, Процесс, ИдПроцесса
//
// Возвращаемое значение:
//   Соответствие, Неопределено - контекст с корневым спаном трассы для связи записи лога
//     корневого события с трассой; Неопределено для некорневых событий
//
Функция Добавить(Событие, ОписаниеФайла) Экспорт

	Элемент = НовыйЭлемент(Событие);
	Буфер = БуферПотока(Событие, ОписаниеФайла);

	Если КорневыеСобытия[Событие.Имя] = Неопределено Тогда
		Буфер.Добавить(Элемент);
		Если Буфер.Количество() > МаксимумБуфера Тогда
			Буфер.Удалить(0);
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли;

	Вложенные = ИзвлечьВложенные(Буфер, Элемент);
	Возврат ПостроитьТрассу(Элемент, Вложенные, ОписаниеФайла);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыйЭлемент(Событие)
	Конец = ВремяЖурналов.ВМикросекунды(Событие.Время, Событие.Микросекунды, ЧасовойПоясЖурнала);
	Возврат Новый Структура("Событие, Начало, Конец, Родитель, Спан",
		Событие, Конец - Событие.Длительность, Конец, Неопределено, Неопределено);
КонецФункции

Функция БуферПотока(Событие, ОписаниеФайла)

	Поток = Событие.Свойства["OSThread"];
	Если Поток = Неопределено Тогда
		Поток = Событие.Свойства["t:connectID"];
	КонецЕсли;
	Ключ = СтрШаблон("%1|%2|%3|%4", ОписаниеФайла.Каталог, ОписаниеФайла.Процесс, ОписаниеФайла.ИдПроцесса, Поток);

	Буфер = Буферы[Ключ];
	Если Буфер = Неопределено Тогда
		Буфер = Новый Массив;
		Буферы.Вставить(Ключ, Буфер);
	КонецЕсли;

	Возврат Буфер;

КонецФункции

// Забирает из буфера вложенные в корень события. События потока, закончившиеся раньше
// окончания корня, но не вложенные в него, к трассам уже не относятся и отбрасываются.
//
Функция ИзвлечьВложенные(Буфер, Корень)

	Вложенные = Новый Массив;
	Оставшиеся = Новый Массив;
	Для Каждого Элемент Из Буфер Цикл
		Если Элемент.Конец > Корень.Конец Тогда
			Оставшиеся.Добавить(Элемент);
		ИначеЕсли Элемент.Начало >= Корень.Начало Тогда
			Вложенные.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;

	Буфер.Очистить();
	Для Каждого Элемент Из Оставшиеся Цикл
		Буфер.Добавить(Элемент);
	КонецЦикла;

	Возврат Вложенные;

КонецФункции

Функция ПостроитьТрассу(Корень, Вложенные, ОписаниеФайла)

	Для Каждого Элемент Из Вложенные Цикл
		Элемент.Родитель = Родитель(Элемент, Корень, Вложенные);
	КонецЦикла;

	Корень.Спан = НачатьСпан(Корень, Неопределено, ОписаниеФайла);

	// Родитель вложен меньше потомка: спаны создаются по возрастанию уровня, после родителей
	Для Каждого Элемент Из ПоУровню(Вложенные) Цикл
		Если ЭтоИсключение(Элемент) Тогда
			ДобавитьИсключение(Элемент);
		Иначе
			Элемент.Спан = НачатьСпан(Элемент, Элемент.Родитель.Спан, ОписаниеФайла);
		КонецЕсли;
	КонецЦикла;

	Для Каждого Элемент Из Вложенные Цикл
		Если Элемент.Спан <> Неопределено Тогда
			Элемент.Спан.Завершить(ВремяЖурналов.МикросекундыВНаносекунды(Элемент.Конец));
		КонецЕсли;
	КонецЦикла;
	Корень.Спан.Завершить(ВремяЖурналов.МикросекундыВНаносекунды(Корень.Конец));

	Возврат ОтелКонтекст.КонтекстСоСпаном(Новый Соответствие, Корень.Спан);

КонецФункции

Функция Родитель(Элемент, Корень, Вложенные)

	Родитель = Корень;
	Для Каждого Кандидат Из Вложенные Цикл
		Если Кандидат = Элемент ИЛИ ЭтоИсключение(Кандидат) Тогда
			Продолжить;
		КонецЕсли;
		Охватывает = Кандидат.Начало <= Элемент.Начало И Кандидат.Конец >= Элемент.Конец
			И Кандидат.Событие.Уровень < Элемент.Событие.Уровень;
		Если Охватывает И Кандидат.Событие.Уровень > Родитель.Событие.Уровень Тогда
			Родитель = Кандидат;
		КонецЕсли;
	КонецЦикла;

	Возврат Родитель;

КонецФункции

Функция ПоУровню(Элементы)
	Список = Новый СписокЗначений;
	Для Каждого Элемент Из Элементы Цикл
		Список.Добавить(Элемент, Формат(Элемент.Событие.Уровень, "ЧЦ=10; ЧВН=; ЧГ=0"));
	КонецЦикла;
	Список.СортироватьПоПредставлению();
	Возврат Список.ВыгрузитьЗначения();
КонецФункции

Функция НачатьСпан(Элемент, РодительскийСпан, ОписаниеФайла)

	Событие = Элемент.Событие;
	Построитель = Трассировщик.ПостроительСпана(Событие.Имя)
		.УстановитьВидСпана(ВидСпана(Событие.Имя))
		.УстановитьВремяНачала(ВремяЖурналов.МикросекундыВНаносекунды(Элемент.Начало));

	Если РодительскийСпан = Неопределено Тогда
		Построитель.БезРодителя();
	Иначе
		Построитель.УстановитьРодителя(ОтелКонтекст.КонтекстСоСпаном(Новый Соответствие, РодительскийСпан));
	КонецЕсли;

	Построитель.УстановитьАтрибут("onec.techlog.duration", Событие.Длительность);
	Построитель.УстановитьАтрибут("onec.techlog.depth", Событие.Уровень);
	Если ЗначениеЗаполнено(ОписаниеФайла.Процесс) Тогда
		Построитель.УстановитьАтрибут("process.executable.name", ОписаниеФайла.Процесс);
	КонецЕсли;
	Если ЗначениеЗаполнено(ОписаниеФайла.ИдПроцесса) Тогда
		Построитель.УстановитьАтрибут("process.pid", Число(ОписаниеФайла.ИдПроцесса));
	КонецЕсли;
	СистемаБазы = СистемыБаз[Событие.Имя];
	Если СистемаБазы <> Неопределено Тогда
		Построитель.УстановитьАтрибут("db.system.name", СистемаБазы);
	КонецЕсли;
	Для Каждого Свойство Из Событие.Свойства Цикл
		Построитель.УстановитьАтрибут("onec.techlog." + Свойство.Ключ, Свойство.Значение);
	КонецЦикла;

	Возврат Построитель.НачатьСпан();

КонецФункции

Процедура ДобавитьИсключение(Элемент)

	Свойства = Элемент.Событие.Свойства;
	Атрибуты = Новый ОтелАтрибуты;
	Атрибуты.Установить("exception.message", СтроковоеСвойство(Свойства, "Descr"));
	Атрибуты.Установить("exception.type", СтроковоеСвойство(Свойства, "Exception"));

	Элемент.Родитель.Спан.ДобавитьСобытие("exception", Атрибуты,
		ВремяЖурналов.МикросекундыВНаносекунды(Элемент.Конец));

КонецПроцедуры

Функция СтроковоеСвойство(Свойства, Имя)
	Значение = Свойства[Имя];
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Возврат СтрСоединить(Значение, Символы.ПС);
	КонецЕсли;
	Возврат ?(Значение = Неопределено, "", Значение);
КонецФункции

Функция ЭтоИсключение(Элемент)
	Возврат Элемент.Событие.Имя = "EXCP";
КонецФункции

Функция ВидСпана(ИмяСобытия)
	Если ИмяСобытия = "CALL" Тогда
		Возврат ОтелВидСпана.Сервер();
	ИначеЕсли СистемыБаз[ИмяСобытия] <> Неопределено Тогда
		Возврат ОтелВидСпана.Клиент();
	КонецЕсли;
	Возврат ОтелВидСпана.Внутренний();
КонецФункции

Функция МножествоИмен(Значение)
	Результат = Новый Соответствие;
	Имена = Значение;
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Имена = СтрРазделить(Значение, ",", Ложь);
	КонецЕсли;
	Для Каждого Имя Из Имена Цикл
		Результат.Вставить(СокрЛП(Имя), Истина);
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти

// Параметры:
//   НовыйТрассировщик - ОтелТрассировщик - трассировщик для спанов
//   ЧасовойПояс - Строка - часовой пояс сервера, записавшего журнал
//   Корневые - Строка, Массив из Строка - имена корневых событий трасс (по умолчанию CALL, SCALL)
//   НовыйМаксимумБуфера - Число - сколько событий потока ждут корень, старые отбрасываются
//
Процедура ПриСозданииОбъекта(НовыйТрассировщик, ЧасовойПояс, Корневые = "CALL,SCALL", НовыйМаксимумБуфера = 10000)

	Трассировщик = НовыйТрассировщик;
	ЧасовойПоясЖурнала = ЧасовойПояс;
	КорневыеСобытия = МножествоИмен(Корневые);
	МаксимумБуфера = НовыйМаксимумБуфера;
	Буферы = Новый Соответствие;

	СистемыБаз = Новый Соответствие;
	СистемыБаз.Вставить("DBMSSQL", "microsoft.sql_server");
	СистемыБаз.Вставить("DBPOSTGRS", "postgresql");
	СистемыБаз.Вставить("DBORACLE", "oracle.db");
	СистемыБаз.Вставить("DB2", "ibm.db2");

КонецПроцедуры
