#Использовать opentelemetry

// Экспорт событий технологического журнала в OpenTelemetry.
//
// Каждое событие становится записью лога: время окончания события, исходный текст в теле,
// свойства события - атрибутами с префиксом onec.techlog. Длительность события записывается
// в гистограмму onec.techlog.event.duration в разрезе имени события, процесса и базы.

Перем Логгер;
Перем ГистограммаДлительности;
Перем ЧасовойПоясЖурнала;
Перем СерьезностиСобытий;

#Область ПрограммныйИнтерфейс

// Передает события технологического журнала в OpenTelemetry. Обработчик для ЧитательТехЖурнала.
//
// Параметры:
//   События - Массив из Структура - события, см. СобытияТехЖурнала.НовоеСобытие
//   ОписаниеФайла - Структура - описание файла журнала: Путь, Процесс, ИдПроцесса
//
Процедура ОбработатьСобытияТехЖурнала(События, ОписаниеФайла) Экспорт
	Для Каждого Событие Из События Цикл
		ЗаписатьЛог(Событие, ОписаниеФайла);
		ЗаписатьМетрики(Событие, ОписаниеФайла);
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаписатьЛог(Событие, ОписаниеФайла)

	Запись = Логгер.СоздатьЗаписьЛога();
	Запись.УстановитьВремя(ВремяЖурналов.ВНаносекунды(Событие.Время, Событие.Микросекунды, ЧасовойПоясЖурнала));
	Запись.УстановитьСерьезность(Серьезность(Событие.Имя));
	Запись.УстановитьТело(Событие.Текст);

	Запись.УстановитьАтрибут("onec.techlog.event.name", Событие.Имя);
	Запись.УстановитьАтрибут("onec.techlog.duration", Событие.Длительность);
	Запись.УстановитьАтрибут("onec.techlog.depth", Событие.Уровень);
	УстановитьАтрибутыПроцесса(Запись, ОписаниеФайла);
	Запись.УстановитьАтрибут("log.file.path", ОписаниеФайла.Путь);

	ИмяБазы = ИмяИнформационнойБазы(Событие);
	Если ЗначениеЗаполнено(ИмяБазы) Тогда
		Запись.УстановитьАтрибут("onec.infobase.name", ИмяБазы);
	КонецЕсли;

	Для Каждого Свойство Из Событие.Свойства Цикл
		Запись.УстановитьАтрибут("onec.techlog." + Свойство.Ключ, Свойство.Значение);
	КонецЦикла;

	Логгер.Записать(Запись);

КонецПроцедуры

Процедура ЗаписатьМетрики(Событие, ОписаниеФайла)

	Атрибуты = Новый ОтелАтрибуты;
	Атрибуты.Установить("onec.techlog.event.name", Событие.Имя);
	Атрибуты.Установить("process.executable.name", ОписаниеФайла.Процесс);
	ИмяБазы = ИмяИнформационнойБазы(Событие);
	Если ЗначениеЗаполнено(ИмяБазы) Тогда
		Атрибуты.Установить("onec.infobase.name", ИмяБазы);
	КонецЕсли;

	ГистограммаДлительности.Записать(Событие.Длительность / 1000000, Атрибуты);

КонецПроцедуры

Процедура УстановитьАтрибутыПроцесса(Запись, ОписаниеФайла)
	Если ЗначениеЗаполнено(ОписаниеФайла.Процесс) Тогда
		Запись.УстановитьАтрибут("process.executable.name", ОписаниеФайла.Процесс);
	КонецЕсли;
	Если ЗначениеЗаполнено(ОписаниеФайла.ИдПроцесса) Тогда
		Запись.УстановитьАтрибут("process.pid", Число(ОписаниеФайла.ИдПроцесса));
	КонецЕсли;
КонецПроцедуры

// Имя информационной базы: свойство p:processName (для базы с разделением данных - <база>_<GUID>).
//
Функция ИмяИнформационнойБазы(Событие)
	Значение = Событие.Свойства["p:processName"];
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат "";
КонецФункции

Функция Серьезность(ИмяСобытия)
	Значение = СерьезностиСобытий[ИмяСобытия];
	Если Значение = Неопределено Тогда
		Возврат ОтелСтепеньСерьезности.Info();
	КонецЕсли;
	Возврат Значение;
КонецФункции

Функция ГраницыДлительности()
	Границы = Новый Массив;
	Для Каждого Граница Из СтрРазделить("0.0001,0.0005,0.001,0.005,0.01,0.025,0.05,0.1,0.25,0.5,1,2.5,5,10,30,60,300", ",") Цикл
		Границы.Добавить(Число(Граница));
	КонецЦикла;
	Возврат Границы;
КонецФункции

Функция ЗначениеПараметра(Параметры, Имя, ЗначениеПоУмолчанию)
	Если Параметры = Неопределено ИЛИ НЕ Параметры.Свойство(Имя) Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	Возврат Параметры[Имя];
КонецФункции

#КонецОбласти

// Параметры:
//   НовыйЛоггер - ОтелЛоггер - логгер для записей событий
//   Метр - ОтелМетр - метр для метрик событий
//   Трассировщик - ОтелТрассировщик, Неопределено - трассировщик для спанов событий
//   Параметры - Структура, Неопределено - параметры экспорта:
//     * ЧасовойПояс - Строка - часовой пояс сервера, записавшего журнал (по умолчанию - текущий)
//
Процедура ПриСозданииОбъекта(НовыйЛоггер, Метр, Трассировщик = Неопределено, Параметры = Неопределено)

	Логгер = НовыйЛоггер;
	ЧасовойПоясЖурнала = ЗначениеПараметра(Параметры, "ЧасовойПояс", ЧасовойПояс());

	ГистограммаДлительности = Метр.СоздатьГистограмму("onec.techlog.event.duration",
		"Длительность событий технологического журнала", "s",
		Новый Структура("ГраницыГистограммы", ГраницыДлительности()));

	СерьезностиСобытий = Новый Соответствие;
	СерьезностиСобытий.Вставить("EXCP", ОтелСтепеньСерьезности.Error());
	СерьезностиСобытий.Вставить("TDEADLOCK", ОтелСтепеньСерьезности.Warn());
	СерьезностиСобытий.Вставить("TTIMEOUT", ОтелСтепеньСерьезности.Warn());
	СерьезностиСобытий.Вставить("ATTN", ОтелСтепеньСерьезности.Warn());

КонецПроцедуры
