#native
#Использовать opentelemetry

// Метрики кластера 1С наблюдаемыми датчиками: сбор метрик отдает показатели последнего снимка кластера.

Перем Состояние; // Структура - Серии: Соответствие имя метрики -> Массив из Структура("Значение, Атрибуты")
Перем ОписанияМетрик; // Соответствие: имя метрики -> Структура("Единица, Описание")
Перем МетрикаДоступности; // Строка - имя метрики доступности кластера

#Область ПрограммныйИнтерфейс

// Запоминает снимок кластера: следующий сбор метрик отдаст его показатели и v8.cluster.up = 1.
// Недоступный снимок - как Сбросить.
//
// Параметры:
//   Снимок - Структура - снимок кластера:
//     * Доступен - Булево - опрос удался целиком
//     * Показатели - Массив из Структура - показатели:
//       ** Имя - Строка - имя метрики
//       ** Значение - Число - значение точки
//       ** Атрибуты - Соответствие: Строка -> Строка, Число, Булево - атрибуты точки
//
Процедура Обновить(Снимок) Экспорт

	Если НЕ Снимок.Доступен Тогда
		Сбросить();
		Возврат;
	КонецЕсли;

	Серии = НовыеСерии(1);
	Для Каждого Показатель Из Снимок.Показатели Цикл
		СерииМетрики = Серии[Показатель.Имя];
		Если СерииМетрики <> Неопределено Тогда
			СерииМетрики.Добавить(Серия(Показатель.Значение, Показатель.Атрибуты));
		КонецЕсли;
	КонецЦикла;
	Состояние.Серии = Серии;

КонецПроцедуры

// Объявляет кластер недоступным: следующий сбор метрик отдаст только v8.cluster.up = 0.
//
Процедура Сбросить() Экспорт
	Состояние.Серии = НовыеСерии(0);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыеСерии(Доступность)
	Серии = Новый Соответствие;
	Для Каждого Описание Из ОписанияМетрик Цикл
		Серии.Вставить(Описание.Ключ, Новый Массив);
	КонецЦикла;
	Серии[МетрикаДоступности].Добавить(Серия(Доступность, Новый Соответствие));
	Возврат Серии;
КонецФункции

Функция Серия(Значение, Атрибуты)
	АтрибутыСерии = Новый ОтелАтрибуты;
	Для Каждого Атрибут Из Атрибуты Цикл
		АтрибутыСерии.Установить(Атрибут.Ключ, Атрибут.Значение);
	КонецЦикла;
	Возврат Новый Структура("Значение, Атрибуты", Значение, АтрибутыСерии);
КонецФункции

Процедура ДобавитьОписание(Имя, Единица, Описание)
	ОписанияМетрик.Вставить(Имя, Новый Структура("Единица, Описание", Единица, Описание));
КонецПроцедуры

// Счётные единицы - в аннотированной форме, безразмерные - пустые: единица "1" в Prometheus даёт суффикс _ratio
Процедура ЗаполнитьОписанияМетрик()
	ОписанияМетрик = Новый Соответствие;
	ДобавитьОписание(МетрикаДоступности, "", "Доступность кластера 1С: 1 - последний опрос удался, 0 - нет");
	ДобавитьОписание("v8.cluster.sessions", "{session}", "Число сеансов");
	ДобавитьОписание("v8.cluster.sessions.blocked", "{session}", "Число сеансов, ожидающих блокировку СУБД или управляемую");
	ДобавитьОписание("v8.cluster.sessions.memory.usage", "By", "Текущая память сеансов");
	ДобавитьОписание("v8.cluster.sessions.cpu_time", "s", "Процессорное время сеансов с их начала");
	ДобавитьОписание("v8.cluster.sessions.calls", "{call}", "Число вызовов сеансов с их начала");
	ДобавитьОписание("v8.cluster.sessions.call.duration", "s",
		"Длительность вызовов сеансов с их начала: всего вызовов (call) и вызовов СУБД (db)");
	ДобавитьОписание("v8.cluster.sessions.io", "By", "Объем чтения и записи сеансов с их начала");
	ДобавитьОписание("v8.cluster.sessions.long_calls", "{session}",
		"Число сеансов, текущий вызов которых длится не меньше порога");
	ДобавитьОписание("v8.cluster.infobase.scheduled_jobs_denied", "",
		"Блокировка регламентных заданий информационной базы: 1 - установлена, 0 - нет");
	ДобавитьОписание("v8.cluster.infobase.sessions_denied", "",
		"Блокировка начала сеансов информационной базы: 1 - установлена, 0 - нет");
	ДобавитьОписание("v8.cluster.connections", "{connection}", "Число соединений");
	ДобавитьОписание("v8.cluster.processes", "{process}", "Число рабочих процессов");
	ДобавитьОписание("v8.cluster.process.memory.usage", "By", "Память рабочего процесса");
	ДобавитьОписание("v8.cluster.process.connections", "{connection}", "Число соединений рабочего процесса");
	ДобавитьОписание("v8.cluster.process.available_performance", "", "Доступная производительность рабочего процесса");
	ДобавитьОписание("v8.cluster.process.call.duration.avg", "s", "Средняя длительность вызовов рабочего процесса");
	ДобавитьОписание("v8.cluster.licenses.used", "{session}", "Число сеансов, использующих лицензию серии");
	ДобавитьОписание("v8.cluster.licenses.total", "{user}", "Число пользователей, допустимое лицензией серии");
КонецПроцедуры

#КонецОбласти

// Параметры:
//   НоваяТелеметрия - ТелеметрияЖурналов - провайдеры телеметрии данных
//   ИмяСервиса - Строка - service.name метрик кластера; пустая строка - имя по умолчанию
//
&Желудь
&Характер("Компанейский")
Процедура ПриСозданииОбъекта(&Блестяшка НоваяТелеметрия, &Блестяшка ИмяСервиса)

	МетрикаДоступности = "v8.cluster.up";
	ЗаполнитьОписанияМетрик();
	Состояние = Новый Структура("Серии", НовыеСерии(0));

	Метр = НоваяТелеметрия.ДляСервиса(ИмяСервиса, "").ПровайдерМетрик.ПолучитьМетр("opentelemetry-v8-logs.cluster");
	Для Каждого Описание Из ОписанияМетрик Цикл
		Наблюдатель = Новый НаблюдательМетрикиКластера(Состояние, Описание.Ключ);
		Метр.СоздатьНаблюдаемыйДатчик(Описание.Ключ, Новый Действие(Наблюдатель, "Наблюдать"),
			Описание.Значение.Описание, Описание.Значение.Единица);
	КонецЦикла;

КонецПроцедуры
