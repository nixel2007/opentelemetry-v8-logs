#Использовать opentelemetry

// Провайдеры телеметрии для данных журналов 1С.
//
// Данные журналов описывают систему 1С, а не процесс коллектора, поэтому отправляются
// с собственным ресурсом: service.name данных и атрибуты из настроек, без атрибутов хоста
// и процесса коллектора. Телеметрия самого коллектора остается в SDK с его otel.service.name.
//
// Ресурс задается провайдеру, поэтому для каждого имени сервиса данных создаются свои
// провайдеры. Логи и спаны идут через пакетные процессоры SDK коллектора (экспортеры
// группируют записи по ресурсу), метрики - через свой периодический читатель: читатель
// регистрируется только у одного провайдера.

Перем ПровайдерЛоговКоллектора;
Перем ПровайдерТрассировкиКоллектора;
Перем ЭкспортерМетрикДанных;
Перем ИнтервалЭкспортаМетрикМс;
Перем ИмяСервисаДанных;
Перем ДополнительныеАтрибутыРесурса;
Перем Сервисы; // Соответствие: имя сервиса -> провайдеры

#Область ПрограммныйИнтерфейс

// Возвращает провайдеры телеметрии для данных сервиса.
//
// Параметры:
//   ИмяСервиса - Строка - service.name данных; пустая строка - имя сервиса данных по умолчанию
//
// Возвращаемое значение:
//   Структура - провайдеры:
//     * ПровайдерЛогирования - ОтелПровайдерЛогирования
//     * ПровайдерМетрик - ОтелПровайдерМетрик
//     * ПровайдерТрассировки - ОтелПровайдерТрассировки
//
Функция ДляСервиса(Знач ИмяСервиса) Экспорт

	Если НЕ ЗначениеЗаполнено(ИмяСервиса) Тогда
		ИмяСервиса = ИмяСервисаДанных;
	КонецЕсли;

	Провайдеры = Сервисы[ИмяСервиса];
	Если Провайдеры = Неопределено Тогда
		Провайдеры = НовыеПровайдеры(ИмяСервиса);
		Сервисы.Вставить(ИмяСервиса, Провайдеры);
	КонецЕсли;

	Возврат Провайдеры;

КонецФункции

// Сбрасывает буферы телеметрии данных.
//
// Параметры:
//   ТаймаутМс - Число - таймаут, мс (0 - без ограничения)
//
// Возвращаемое значение:
//   ОтелРезультатЭкспорта - общий результат сброса
//
Функция СброситьБуфер(ТаймаутМс = 0) Экспорт

	Результаты = Новый Массив;
	Результаты.Добавить(ПровайдерЛоговКоллектора.СброситьБуфер(ТаймаутМс));
	Результаты.Добавить(ПровайдерТрассировкиКоллектора.СброситьБуфер(ТаймаутМс));
	Для Каждого Сервис Из Сервисы Цикл
		Результаты.Добавить(Сервис.Значение.ПровайдерМетрик.СброситьБуфер(ТаймаутМс));
	КонецЦикла;

	Возврат ОтелРезультатыЭкспорта.ОжидатьВсе(Результаты, ТаймаутМс);

КонецФункции

// Сбрасывает буферы и закрывает читатели метрик данных. Процессоры логов и спанов
// принадлежат SDK коллектора и закрываются вместе с ним.
//
Процедура Закрыть() Экспорт
	СброситьБуфер();
	Для Каждого Сервис Из Сервисы Цикл
		Сервис.Значение.ПровайдерМетрик.Закрыть();
	КонецЦикла;
	Сервисы.Очистить();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыеПровайдеры(ИмяСервиса)

	Ресурс = РесурсДанных(ИмяСервиса);

	Провайдеры = Новый Структура;
	Провайдеры.Вставить("ПровайдерЛогирования", Новый ОтелПровайдерЛогирования(Ресурс,
		ПровайдерЛоговКоллектора.Процессор(), ПровайдерЛоговКоллектора.ЛимитыЗаписейЛога()));
	Провайдеры.Вставить("ПровайдерТрассировки", Новый ОтелПровайдерТрассировки(Ресурс,
		ПровайдерТрассировкиКоллектора.Процессор(), ПровайдерТрассировкиКоллектора.Сэмплер(),
		ПровайдерТрассировкиКоллектора.ЛимитыСпана()));

	Читатели = Новый Массив;
	Если ЭкспортерМетрикДанных <> Неопределено Тогда
		Читатель = Новый ОтелПериодическийЧитательМетрик(ЭкспортерМетрикДанных, ИнтервалЭкспортаМетрикМс);
		Читатель.Запустить();
		Читатели.Добавить(Читатель);
	КонецЕсли;
	Провайдеры.Вставить("ПровайдерМетрик", Новый ОтелПровайдерМетрик(Ресурс, Читатели));

	Возврат Провайдеры;

КонецФункции

Функция РесурсДанных(ИмяСервиса)

	// Без атрибутов по умолчанию и окружения: они описывают процесс коллектора
	Ресурс = Новый ОтелРесурс(Истина, , Истина);
	Для Каждого Атрибут Из ДополнительныеАтрибутыРесурса Цикл
		Ресурс.Атрибуты().Установить(Атрибут.Ключ, Атрибут.Значение);
	КонецЦикла;
	Ресурс.Атрибуты().Установить("service.name", ИмяСервиса);

	Возврат Ресурс;

КонецФункции

#КонецОбласти

// Параметры:
//   ПровайдерЛогов - ОтелПровайдерЛогирования - провайдер логов SDK коллектора: его процессор
//     отправляет и логи данных
//   ПровайдерТрассировки - ОтелПровайдерТрассировки - провайдер трассировки SDK коллектора
//   ЭкспортерМетрик - ОтелЭкспортерМетрик, Неопределено - экспортер метрик данных;
//     Неопределено - метрики данных не отправляются
//   ИнтервалЭкспортаМс - Число - интервал периодического экспорта метрик данных
//   ИмяСервисаПоУмолчанию - Строка - service.name данных по умолчанию
//   АтрибутыРесурса - Строка - дополнительные атрибуты ресурса данных в формате
//     OTEL_RESOURCE_ATTRIBUTES (ключ=значение через запятую)
//
Процедура ПриСозданииОбъекта(ПровайдерЛогов, ПровайдерТрассировки, ЭкспортерМетрик, ИнтервалЭкспортаМс,
	ИмяСервисаПоУмолчанию, АтрибутыРесурса = "")

	ПровайдерЛоговКоллектора = ПровайдерЛогов;
	ПровайдерТрассировкиКоллектора = ПровайдерТрассировки;
	ЭкспортерМетрикДанных = ЭкспортерМетрик;
	ИнтервалЭкспортаМетрикМс = ИнтервалЭкспортаМс;
	ИмяСервисаДанных = ИмяСервисаПоУмолчанию;
	Сервисы = Новый Соответствие;

	ДополнительныеАтрибутыРесурса = Новый Соответствие;
	Если ЗначениеЗаполнено(АтрибутыРесурса) Тогда
		ДополнительныеАтрибутыРесурса = ОтелКонфигурационнаяФабрика.РазобратьАтрибутыРесурса(АтрибутыРесурса);
	КонецЕсли;

КонецПроцедуры
