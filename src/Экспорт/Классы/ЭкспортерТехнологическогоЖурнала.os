#native
#Использовать opentelemetry
#Использовать collectionos
#Использовать "../../ТехнологическийЖурнал"

// Экспорт событий технологического журнала в OpenTelemetry.
//
// Каждое событие становится записью лога: время окончания события, исходный текст в теле,
// свойства события - атрибутами с префиксом v8.techlog.; тело и значения атрибутов ограничены
// по размеру, длинное тело обрезается внутри значений свойств, см. ОграничениеРазмеровТелеметрии.
// Длительность события записывается в гистограмму v8.techlog.event.duration в разрезе имени события,
// процесса и базы, у событий СУБД - еще и в гистограмму db.client.operation.duration, когда проход
// подтвержден (ПодтвердитьПроход).
// С включенными трассами события вызовов отправляются спанами трасс, см. СборщикТрассТехнологическогоЖурнала,
// а запись лога события связывается со спаном события.
// Исключение (EXCP) записывается событием exception по семантическим соглашениям exceptions-logs:
// запись лога с именем события exception и атрибутами exception.type и exception.message.
//
// Информационная база события (свойство p:processName, иначе база из настроек источника) попадает
// в ресурс телеметрии (v8.infobase.name), см. ТелеметрияЖурналов.

&Пластилин
Перем ВремяЖурналов; // ВремяЖурналов - перевод времени журнала в метки OpenTelemetry

&Пластилин
Перем АтрибутыСобытийТехнологическогоЖурнала; // АтрибутыСобытийТехнологическогоЖурнала - атрибуты записи лога и спана

&Пластилин
Перем ОграничениеРазмеровТелеметрии; // ОграничениеРазмеровТелеметрии - лимит тела записи лога

&Пластилин
Перем ПарсерТехнологическогоЖурнала; // ПарсерТехнологическогоЖурнала - значения в тексте события

&Пластилин
Перем ПарсерТехнологическогоЖурналаJSON; // ПарсерТехнологическогоЖурналаJSON - значения в тексте события JSON

Перем Телеметрия; // ТелеметрияЖурналов - провайдеры телеметрии данных журналов
Перем ИмяСервисаДанных; // Строка - service.name данных источника
Перем ИнформационнаяБазаИсточника; // Строка - база событий без p:processName из настроек источника
Перем СборщикТрасс; // СборщикТрассТехнологическогоЖурнала, Неопределено - Неопределено, если трассы выключены
Перем ИнструментыБаз; // Соответствие: база -> Структура("Логгер, ГистограммаДлительности, ГистограммаОперацийБД,
	// ГистограммаВходящихВызовов, ГистограммаИсходящихВызовов, СчетчикОбрезок, СчетчикОбрезанныхБайт")
Перем ЧасовойПоясЖурнала; // Строка - часовой пояс сервера, записавшего журнал
Перем СерьезностиСобытий; // Соответствие: имя события -> степень серьезности, если у события нет level
Перем СерьезностиУровней; // Соответствие: значение свойства level -> степень серьезности
Перем ЗначенияМетрикПрохода; // Массив из Структура("Гистограмма, Длительность, Атрибуты") - до подтверждения прохода
Перем ЗначенияСчетчиковПрохода; // Массив из Структура("Счетчик, Значение, Атрибуты") - до подтверждения прохода
Перем ВозвращенныеСтрокиВключены; // Булево - записывать db.response.returned_rows (Opt-In в semconv)
Перем ИдСеансаВключен; // Булево - записывать session.id (Opt-In в semconv)
Перем ПропускатьДублиСемантическихСоглашений; // Булево - не записывать v8.techlog.* - дубли атрибутов semconv

#Область ПрограммныйИнтерфейс

// Передает события технологического журнала в OpenTelemetry. Обработчик для ЧитательТехнологическогоЖурнала.
//
// Параметры:
//   События - Массив из Структура - события, см. СобытияТехнологическогоЖурнала.НовоеСобытие
//   ОписаниеФайла - Структура - описание файла журнала: Путь, Процесс, ИдПроцесса
//
Процедура ОбработатьСобытияТехнологическогоЖурнала(События, ОписаниеФайла) Экспорт
	Для Каждого Событие Из События Цикл
		ИмяБазы = ИмяИнформационнойБазы(Событие);
		Инструменты = ИнструментыБазы(ИмяБазы);
		Обрезки = Новый Массив;
		Атрибуты = АтрибутыСобытийТехнологическогоЖурнала.АтрибутыСобытия(Событие, ОписаниеФайла,
			ВозвращенныеСтрокиВключены, ИдСеансаВключен, ПропускатьДублиСемантическихСоглашений, Обрезки);
		Тело = ОграниченноеТело(Событие);
		КонтекстТрассы = Неопределено;
		Если СборщикТрасс <> Неопределено Тогда
			КонтекстТрассы = СборщикТрасс.Добавить(Событие, ОписаниеФайла, ИмяБазы, Атрибуты);
		КонецЕсли;
		Попытка
			ЗаписатьЛог(Инструменты.Логгер, Событие, Тело, Атрибуты, КонтекстТрассы, Обрезки);
		Исключение
			ЗавершитьСпанСобытия(КонтекстТрассы, Событие);
			ВызватьИсключение;
		КонецПопытки;
		ЗавершитьСпанСобытия(КонтекстТрассы, Событие);
		ЗаписатьМетрики(Инструменты, Событие, ОписаниеФайла, ИмяБазы, Атрибуты);
		ЗаписатьМетрикиОбрезки(Инструменты, Событие, ИмяБазы, Тело, Обрезки);
	КонецЦикла;
КонецПроцедуры

// Вызывается после прохода, прочитавшего журналы до конца: закрывает трассы, в которых давно
// не было событий, даже если новых событий в журнале нет.
//
// Параметры:
//   ТекущееВремя - Число, Неопределено - текущее время, мкс Unix epoch; Неопределено - по часам
//
Процедура ЗавершитьПроход(Знач ТекущееВремя = Неопределено) Экспорт
	Если СборщикТрасс = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ТекущееВремя = Неопределено Тогда
		ТекущееВремя = ВремяЖурналов.ТекущееВремяВМикросекундах();
	КонецЕсли;
	СборщикТрасс.ЗакрытьПростаивающие(ТекущееВремя);
КонецПроцедуры

// Отправляет накопленные и незакрытые трассы: вызывается при завершении работы.
//
Процедура Закрыть() Экспорт
	Если СборщикТрасс <> Неопределено Тогда
		СборщикТрасс.ЗакрытьВсе();
	КонецЕсли;
КонецПроцедуры

// Вызывается после того, как события прохода переданы и позиции зафиксированы:
// длительности событий прохода записываются в гистограмму v8.techlog.event.duration.
//
Процедура ПодтвердитьПроход() Экспорт
	Для Каждого Значение Из ЗначенияМетрикПрохода Цикл
		Значение.Гистограмма.Записать(Значение.Длительность, Значение.Атрибуты);
	КонецЦикла;
	ЗначенияМетрикПрохода.Очистить();
	Для Каждого Значение Из ЗначенияСчетчиковПрохода Цикл
		Значение.Счетчик.Добавить(Значение.Значение, Значение.Атрибуты);
	КонецЦикла;
	ЗначенияСчетчиковПрохода.Очистить();
КонецПроцедуры

// Вызывается при откате прохода: события будут прочитаны повторно и учтутся в повторном проходе.
//
Процедура ОтменитьПроход() Экспорт
	ЗначенияМетрикПрохода.Очистить();
	ЗначенияСчетчиковПрохода.Очистить();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Тело записи лога в пределах лимита: длинное тело обрезается внутри значений свойств.
//
// Параметры:
//   Событие - Структура - событие, см. СобытияТехнологическогоЖурнала.НовоеСобытие
//
// Возвращаемое значение:
//   Структура - см. ОграничениеРазмеровТелеметрии.ОграничитьТело
//
Функция ОграниченноеТело(Событие)
	Если НЕ ОграничениеРазмеровТелеметрии.ТелоПревышаетЛимит(Событие.Текст) Тогда
		Возврат ОграничениеРазмеровТелеметрии.ОграничитьТело(Событие.Текст);
	КонецЕсли;
	Если ПарсерТехнологическогоЖурналаJSON.ЭтоФорматJSON(Событие.Текст) Тогда
		ЗначенияТела = ПарсерТехнологическогоЖурналаJSON.ЗначенияВТексте(Событие.Текст);
	Иначе
		ЗначенияТела = ПарсерТехнологическогоЖурнала.ЗначенияВТексте(Событие.Текст);
	КонецЕсли;
	Возврат ОграничениеРазмеровТелеметрии.ОграничитьТело(Событие.Текст, ЗначенияТела);
КонецФункции

Процедура ЗаписатьЛог(Логгер, Событие, Тело, Атрибуты, КонтекстТрассы, Обрезки)

	Запись = Логгер.СоздатьЗаписьЛога();
	Запись.УстановитьВремя(ВремяЖурналов.ВНаносекунды(Событие.Время, Событие.Микросекунды, ЧасовойПоясЖурнала));
	Запись.УстановитьСерьезность(Серьезность(Событие));
	Запись.УстановитьТело(Тело.Значение);
	Если Тело.Обрезано Тогда
		Запись.УстановитьАтрибут("v8.techlog.truncation.body.original_size", Тело.ИсходныйРазмер);
	КонецЕсли;
	Если Тело.Ключи.Количество() > 0 Тогда
		Запись.УстановитьАтрибут("v8.techlog.truncation.body.attributes", Тело.Ключи);
	КонецЕсли;

	Для Каждого Атрибут Из Атрибуты Цикл
		Запись.УстановитьАтрибут(Атрибут.Ключ, Атрибут.Значение);
	КонецЦикла;

	Если Событие.Имя = "EXCP" Тогда
		УстановитьАтрибутыИсключения(Запись, Событие, Атрибуты, Обрезки);
	КонецЕсли;

	// Без явного контекста логгер взял бы текущий контекст потока приложения
	Если КонтекстТрассы = Неопределено Тогда
		КонтекстТрассы = Новый Соответствие;
	КонецЕсли;
	Логгер.Записать(Запись, КонтекстТрассы);

КонецПроцедуры

Процедура ЗаписатьМетрики(Инструменты, Событие, ОписаниеФайла, ИмяБазы, АтрибутыСобытия)

	Длительность = ВремяЖурналов.МикросекундыВСекунды(Событие.Длительность);

	// База остается и атрибутом точки: атрибуты ресурса бэкенды метрик в метки не переносят
	Атрибуты = Новый ОтелАтрибуты;
	Атрибуты.Установить("v8.techlog.event.name", Событие.Имя);
	Атрибуты.Установить("process.executable.name", ОписаниеФайла.Процесс);
	Если ЗначениеЗаполнено(ИмяБазы) Тогда
		Атрибуты.Установить("v8.infobase.name", ИмяБазы);
	КонецЕсли;
	ДобавитьЗначениеМетрики(Инструменты.ГистограммаДлительности, Длительность, Атрибуты);

	Если АтрибутыСобытийТехнологическогоЖурнала.ЭтоСобытиеСУБД(Событие.Имя) Тогда
		ДобавитьЗначениеМетрики(Инструменты.ГистограммаОперацийБД, Длительность,
			АтрибутыТочки(АтрибутыСобытия, "db.system.name,db.namespace,server.address"));
	КонецЕсли;

	Если АтрибутыСобытия["rpc.method"] <> Неопределено Тогда
		Гистограмма = ?(Событие.Имя = "CALL", Инструменты.ГистограммаВходящихВызовов,
			Инструменты.ГистограммаИсходящихВызовов);
		ДобавитьЗначениеМетрики(Гистограмма, Длительность,
			АтрибутыТочки(АтрибутыСобытия, "rpc.system.name,rpc.method,error.type"));
	КонецЕсли;

КонецПроцедуры

Процедура ЗаписатьМетрикиОбрезки(Инструменты, Событие, ИмяБазы, Тело, Обрезки)
	Если Тело.Обрезано Тогда
		ДобавитьОбрезку(Инструменты, Событие, ИмяБазы, "body", "", Тело.ИсходныйРазмер - Тело.Размер);
	КонецЕсли;
	Для Каждого Обрезка Из Обрезки Цикл
		ДобавитьОбрезку(Инструменты, Событие, ИмяБазы, "attribute", Обрезка.Ключ,
			Обрезка.ИсходныйРазмер - Обрезка.Размер);
	КонецЦикла;
КонецПроцедуры

Процедура ДобавитьОбрезку(Инструменты, Событие, ИмяБазы, Цель, КлючАтрибута, ОтрезаноБайт)
	Атрибуты = Новый ОтелАтрибуты;
	Атрибуты.Установить("v8.techlog.event.name", Событие.Имя);
	Если ЗначениеЗаполнено(ИмяБазы) Тогда
		Атрибуты.Установить("v8.infobase.name", ИмяБазы);
	КонецЕсли;
	Атрибуты.Установить("v8.techlog.truncation.target", Цель);
	Если ЗначениеЗаполнено(КлючАтрибута) Тогда
		Атрибуты.Установить("v8.techlog.truncation.attribute", КлючАтрибута);
	КонецЕсли;
	Обрезка = Новый Структура("Счетчик, Значение, Атрибуты", Инструменты.СчетчикОбрезок, 1, Атрибуты);
	ЗначенияСчетчиковПрохода.Добавить(Обрезка);
	Отрезано = Новый Структура("Счетчик, Значение, Атрибуты",
		Инструменты.СчетчикОбрезанныхБайт, ОтрезаноБайт, Атрибуты);
	ЗначенияСчетчиковПрохода.Добавить(Отрезано);
КонецПроцедуры

Процедура ДобавитьЗначениеМетрики(Гистограмма, Длительность, Атрибуты)
	Значение = Новый Структура("Гистограмма, Длительность, Атрибуты", Гистограмма, Длительность, Атрибуты);
	ЗначенияМетрикПрохода.Добавить(Значение);
КонецПроцедуры

// Атрибуты точки метрики семантических соглашений - заданные атрибуты из атрибутов события.
//
// Параметры:
//   АтрибутыСобытия - Соответствие - атрибуты события, см. АтрибутыСобытийТехнологическогоЖурнала.АтрибутыСобытия
//   Ключи - Строка - ключи атрибутов точки через запятую
//
// Возвращаемое значение:
//   ОтелАтрибуты - атрибуты точки метрики
//
Функция АтрибутыТочки(АтрибутыСобытия, Ключи)
	Атрибуты = Новый ОтелАтрибуты;
	Для Каждого Ключ Из СтрРазделить(Ключи, ",") Цикл
		Значение = АтрибутыСобытия[Ключ];
		Если Значение <> Неопределено Тогда
			Атрибуты.Установить(Ключ, Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Атрибуты;
КонецФункции

Функция ИнструментыБазы(ИмяБазы)

	Инструменты = ИнструментыБаз[ИмяБазы];
	Если Инструменты <> Неопределено Тогда
		Возврат Инструменты;
	КонецЕсли;

	ОбластьИнструментирования = "opentelemetry-v8-logs.techlog";
	Провайдеры = Телеметрия.ДляСервиса(ИмяСервисаДанных, ИмяБазы);
	Метр = Провайдеры.ПровайдерМетрик.ПолучитьМетр(ОбластьИнструментирования);
	Логгер = Провайдеры.ПровайдерЛогирования.ПолучитьЛоггер(ОбластьИнструментирования);
	Гистограмма = Метр.СоздатьГистограмму("v8.techlog.event.duration",
		"Длительность событий технологического журнала", "s", ПараметрыГистограммы(ГраницыДлительности()));
	ГистограммаОперацийБД = Метр.СоздатьГистограмму(ОтелСемантическиеСоглашения.МетрикаДлительностиОперацииБД(),
		"Длительность обращений к СУБД", "s",
		ПараметрыГистограммы(ОтелСемантическиеСоглашения.ГраницыДлительностиОперацииБД()));
	ПараметрыГистограммыВызовов = ПараметрыГистограммы(
		ГраницыИзСтроки("0.0001,0.0005,0.001,0.005,0.01,0.05,0.1,0.5,1,5,10,50,100"));
	ГистограммаВходящихВызовов = Метр.СоздатьГистограмму("rpc.server.call.duration",
		"Длительность входящих вызовов", "s", ПараметрыГистограммыВызовов);
	ГистограммаИсходящихВызовов = Метр.СоздатьГистограмму("rpc.client.call.duration",
		"Длительность исходящих вызовов", "s", ПараметрыГистограммыВызовов);

	Инструменты = Новый Структура;
	Инструменты.Вставить("Логгер", Логгер);
	Инструменты.Вставить("ГистограммаДлительности", Гистограмма);
	Инструменты.Вставить("ГистограммаОперацийБД", ГистограммаОперацийБД);
	Инструменты.Вставить("ГистограммаВходящихВызовов", ГистограммаВходящихВызовов);
	Инструменты.Вставить("ГистограммаИсходящихВызовов", ГистограммаИсходящихВызовов);
	СчетчикОбрезок = Метр.СоздатьСчетчик("v8.techlog.truncated",
		"Обрезанные по лимиту размера тела записей лога и значения атрибутов", "{value}");
	СчетчикОбрезанныхБайт = Метр.СоздатьСчетчик("v8.techlog.truncated.size",
		"Байты, отрезанные от тел записей лога и значений атрибутов", "By");
	Инструменты.Вставить("СчетчикОбрезок", СчетчикОбрезок);
	Инструменты.Вставить("СчетчикОбрезанныхБайт", СчетчикОбрезанныхБайт);
	ИнструментыБаз.Вставить(ИмяБазы, Инструменты);

	Возврат Инструменты;

КонецФункции

Процедура ЗавершитьСпанСобытия(КонтекстТрассы, Событие)
	Если СборщикТрасс <> Неопределено Тогда
		СборщикТрасс.ЗавершитьСпан(КонтекстТрассы, Событие);
	КонецЕсли;
КонецПроцедуры

Процедура УстановитьАтрибутыИсключения(Запись, Событие, АтрибутыСобытия, Обрезки)

	Запись.УстановитьИмяСобытия("exception");

	КлючОбрезанных = "v8.techlog.truncation.attributes";
	АтрибутыИсключения = АтрибутыСобытийТехнологическогоЖурнала.АтрибутыИсключения(Событие, Обрезки);
	ОбрезанныеИсключения = АтрибутыИсключения[КлючОбрезанных];
	ОбрезанныеСобытия = АтрибутыСобытия[КлючОбрезанных];
	Если ОбрезанныеИсключения <> Неопределено И ОбрезанныеСобытия <> Неопределено Тогда
		Ключи = Новый Массив;
		Для Каждого Ключ Из ОбрезанныеСобытия Цикл
			Ключи.Добавить(Ключ);
		КонецЦикла;
		Для Каждого Ключ Из ОбрезанныеИсключения Цикл
			Ключи.Добавить(Ключ);
		КонецЦикла;
		АтрибутыИсключения.Вставить(КлючОбрезанных, Ключи);
	КонецЕсли;

	Для Каждого Атрибут Из АтрибутыИсключения Цикл
		Запись.УстановитьАтрибут(Атрибут.Ключ, Атрибут.Значение);
	КонецЦикла;

КонецПроцедуры

// Имя информационной базы события: свойство p:processName, если оно заполнено, иначе база
// из настроек источника (например, для файловой базы, где p:processName у событий пустой).
//
// Параметры:
//   Событие - Структура - событие, см. СобытияТехнологическогоЖурнала.НовоеСобытие
//
// Возвращаемое значение:
//   Строка - имя информационной базы; пустая строка - база не известна
//
Функция ИмяИнформационнойБазы(Событие)
	Значение = Событие.Свойства["p:processName"];
	Если ТипЗнч(Значение) = Тип("Строка") И ЗначениеЗаполнено(Значение) Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат ИнформационнаяБазаИсточника;
КонецФункции

// Серьезность из свойства level, которым платформа оценивает событие сама,
// а без него или при неизвестном значении - по имени события.
//
// Параметры:
//   Событие - Структура - событие, см. СобытияТехнологическогоЖурнала.НовоеСобытие
//
// Возвращаемое значение:
//   Число - степень серьезности, см. ОтелСтепеньСерьезности
//
Функция Серьезность(Событие)
	Уровень = Событие.Свойства["level"];
	Если ТипЗнч(Уровень) = Тип("Строка") Тогда
		Значение = СерьезностиУровней[ВРег(Уровень)];
		Если Значение <> Неопределено Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЕсли;
	Значение = СерьезностиСобытий[Событие.Имя];
	Если Значение = Неопределено Тогда
		Возврат ОтелСтепеньСерьезности.Info();
	КонецЕсли;
	Возврат Значение;
КонецФункции

Функция ГраницыДлительности()
	Возврат ГраницыИзСтроки("0.0001,0.0005,0.001,0.005,0.01,0.025,0.05,0.1,0.25,0.5,1,2.5,5,10,30,60,300");
КонецФункции

Функция ПараметрыГистограммы(Границы)
	Возврат Новый Структура("ГраницыГистограммы", Границы);
КонецФункции

Функция ГраницыИзСтроки(ГраницыСекунд)
	Границы = Новый Массив;
	Для Каждого Граница Из СтрРазделить(ГраницыСекунд, ",") Цикл
		Границы.Добавить(Число(Граница));
	КонецЦикла;
	Возврат Границы;
КонецФункции

#КонецОбласти

// Параметры:
//   НоваяТелеметрия - ТелеметрияЖурналов - провайдеры телеметрии данных журналов
//   ИмяСервиса - Строка - service.name данных источника; пустая строка - имя по умолчанию
//   ЧасовойПоясСервера - Строка - часовой пояс сервера, записавшего журнал; пустая строка - текущий
//   ИнформационнаяБаза - Строка - база событий без p:processName; пустая строка - не задана
//   ТрассыВключены - Булево - собирать трассы вызовов
//   КорневыеСобытия - Строка, Массив из Строка - события-корни трасс
//   РежимТрасс - Строка - auto, streaming или buffered, см. СборщикТрассТехнологическогоЖурнала
//   ВозвращенныеСтроки - Булево - записывать db.response.returned_rows у событий СУБД
//   ИдСеанса - Булево - записывать session.id
//   ПропускатьДубли - Булево - не записывать v8.techlog.<свойство>, которое целиком записано атрибутом
//     семантических соглашений
//   ТабакеркаСборщиков - Табакерка - СборщикТрассТехнологическогоЖурнала
//
// Настройки источника передаются блестяшками компанейского желудя, по параметру на настройку.
// BSLLS:NumberOfParams-off
&Желудь
&Характер("Компанейский")
Процедура ПриСозданииОбъекта(&Блестяшка НоваяТелеметрия, &Блестяшка ИмяСервиса, &Блестяшка ЧасовойПоясСервера,
	&Блестяшка ИнформационнаяБаза, &Блестяшка ТрассыВключены, &Блестяшка КорневыеСобытия, &Блестяшка РежимТрасс,
	&Блестяшка ВозвращенныеСтроки, &Блестяшка ИдСеанса, &Блестяшка ПропускатьДубли,
	&Табакерка &Пластилин("СборщикТрассТехнологическогоЖурнала") ТабакеркаСборщиков)
	// BSLLS:NumberOfParams-on

	ВозвращенныеСтрокиВключены = ВозвращенныеСтроки;
	ИдСеансаВключен = ИдСеанса;
	ПропускатьДублиСемантическихСоглашений = ПропускатьДубли;
	Телеметрия = НоваяТелеметрия;
	ИмяСервисаДанных = ИмяСервиса;
	ИнформационнаяБазаИсточника = ИнформационнаяБаза;
	ЧасовойПоясЖурнала = ?(ЗначениеЗаполнено(ЧасовойПоясСервера), ЧасовойПоясСервера, ЧасовойПояс());
	ИнструментыБаз = Новый Соответствие;
	ЗначенияМетрикПрохода = Новый Массив;
	ЗначенияСчетчиковПрохода = Новый Массив;

	Если ТрассыВключены Тогда
		ПараметрыСборщика = Массивы.ИзЭлементов(Телеметрия, ИмяСервисаДанных, ЧасовойПоясЖурнала, КорневыеСобытия,
			РежимТрасс);
		СборщикТрасс = ТабакеркаСборщиков.Достать(ПараметрыСборщика);
	КонецЕсли;

	СерьезностиСобытий = Новый Соответствие;
	СерьезностиСобытий.Вставить("EXCP", ОтелСтепеньСерьезности.Error());
	СерьезностиСобытий.Вставить("TDEADLOCK", ОтелСтепеньСерьезности.Warn());
	СерьезностиСобытий.Вставить("TTIMEOUT", ОтелСтепеньСерьезности.Warn());
	СерьезностиСобытий.Вставить("ATTN", ОтелСтепеньСерьезности.Warn());

	СерьезностиУровней = Новый Соответствие;
	СерьезностиУровней.Вставить("TRACE", ОтелСтепеньСерьезности.Trace());
	СерьезностиУровней.Вставить("DEBUG", ОтелСтепеньСерьезности.Debug());
	СерьезностиУровней.Вставить("INFO", ОтелСтепеньСерьезности.Info());
	СерьезностиУровней.Вставить("WARNING", ОтелСтепеньСерьезности.Warn());
	СерьезностиУровней.Вставить("ERROR", ОтелСтепеньСерьезности.Error());

КонецПроцедуры
