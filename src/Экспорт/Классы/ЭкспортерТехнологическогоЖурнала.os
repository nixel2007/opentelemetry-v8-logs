#Использовать opentelemetry
#Использовать collectionos

// Экспорт событий технологического журнала в OpenTelemetry.
//
// Каждое событие становится записью лога: время окончания события, исходный текст в теле,
// свойства события - атрибутами с префиксом v8.techlog. Длительность события записывается
// в гистограмму v8.techlog.event.duration в разрезе имени события, процесса и базы, когда проход
// подтвержден (ПодтвердитьПроход).
// С включенными трассами события вызовов отправляются спанами трасс, см. СборщикТрассТехнологическогоЖурнала,
// а запись лога события связывается со спаном события.
//
// Информационная база события (свойство p:processName, иначе база из настроек источника) попадает
// в ресурс телеметрии (v8.infobase.name), см. ТелеметрияЖурналов.

&Пластилин
Перем ВремяЖурналов;

Перем Телеметрия;
Перем ИмяСервисаДанных;
Перем ИнформационнаяБазаИсточника;
Перем СборщикТрасс;
Перем ИнструментыБаз; // Соответствие: база -> Структура("Логгер, ГистограммаДлительности")
Перем ЧасовойПоясЖурнала;
Перем СерьезностиСобытий;
Перем СерьезностиУровней;
Перем ЗначенияМетрикПрохода; // Массив из Структура("Гистограмма, Длительность, Атрибуты") - до подтверждения прохода

#Область ПрограммныйИнтерфейс

// Передает события технологического журнала в OpenTelemetry. Обработчик для ЧитательТехнологическогоЖурнала.
//
// Параметры:
//   События - Массив из Структура - события, см. СобытияТехнологическогоЖурнала.НовоеСобытие
//   ОписаниеФайла - Структура - описание файла журнала: Путь, Процесс, ИдПроцесса
//
Процедура ОбработатьСобытияТехнологическогоЖурнала(События, ОписаниеФайла) Экспорт
	Для Каждого Событие Из События Цикл
		ИмяБазы = ИмяИнформационнойБазы(Событие);
		Инструменты = ИнструментыБазы(ИмяБазы);
		КонтекстТрассы = Неопределено;
		Если СборщикТрасс <> Неопределено Тогда
			КонтекстТрассы = СборщикТрасс.Добавить(Событие, ОписаниеФайла, ИмяБазы);
		КонецЕсли;
		ЗаписатьЛог(Инструменты.Логгер, Событие, ОписаниеФайла, КонтекстТрассы);
		ЗаписатьМетрики(Инструменты.ГистограммаДлительности, Событие, ОписаниеФайла, ИмяБазы);
	КонецЦикла;
КонецПроцедуры

// Вызывается после прохода, прочитавшего журналы до конца: закрывает трассы, в которых давно
// не было событий, даже если новых событий в журнале нет.
//
// Параметры:
//   ТекущееВремя - Число, Неопределено - текущее время, мкс Unix epoch; Неопределено - по часам
//
Процедура ЗавершитьПроход(Знач ТекущееВремя = Неопределено) Экспорт
	Если СборщикТрасс = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ТекущееВремя = Неопределено Тогда
		ТекущееВремя = (ТекущаяУниверсальнаяДата() - Дата("19700101")) * 1000000;
	КонецЕсли;
	СборщикТрасс.ЗакрытьПростаивающие(ТекущееВремя);
КонецПроцедуры

// Отправляет накопленные и незакрытые трассы: вызывается при завершении работы.
//
Процедура Закрыть() Экспорт
	Если СборщикТрасс <> Неопределено Тогда
		СборщикТрасс.ЗакрытьВсе();
	КонецЕсли;
КонецПроцедуры

// Вызывается после того, как события прохода переданы и позиции зафиксированы:
// длительности событий прохода записываются в гистограмму v8.techlog.event.duration.
//
Процедура ПодтвердитьПроход() Экспорт
	Для Каждого Значение Из ЗначенияМетрикПрохода Цикл
		Значение.Гистограмма.Записать(Значение.Длительность, Значение.Атрибуты);
	КонецЦикла;
	ЗначенияМетрикПрохода.Очистить();
КонецПроцедуры

// Вызывается при откате прохода: события будут прочитаны повторно и учтутся в повторном проходе.
//
Процедура ОтменитьПроход() Экспорт
	ЗначенияМетрикПрохода.Очистить();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаписатьЛог(Логгер, Событие, ОписаниеФайла, КонтекстТрассы)

	Запись = Логгер.СоздатьЗаписьЛога();
	Запись.УстановитьВремя(ВремяЖурналов.ВНаносекунды(Событие.Время, Событие.Микросекунды, ЧасовойПоясЖурнала));
	Запись.УстановитьСерьезность(Серьезность(Событие));
	Запись.УстановитьТело(Событие.Текст);

	Запись.УстановитьАтрибут("v8.techlog.event.name", Событие.Имя);
	Запись.УстановитьАтрибут("v8.techlog.duration", Событие.Длительность);
	Запись.УстановитьАтрибут("v8.techlog.depth", Событие.Уровень);
	УстановитьАтрибутыПроцесса(Запись, ОписаниеФайла);
	Запись.УстановитьАтрибут("log.file.path", ОписаниеФайла.Путь);

	Для Каждого Свойство Из Событие.Свойства Цикл
		Запись.УстановитьАтрибут("v8.techlog." + Свойство.Ключ, Свойство.Значение);
	КонецЦикла;

	// Без явного контекста логгер взял бы текущий контекст потока приложения
	Если КонтекстТрассы = Неопределено Тогда
		КонтекстТрассы = Новый Соответствие;
	КонецЕсли;
	Логгер.Записать(Запись, КонтекстТрассы);

КонецПроцедуры

Процедура ЗаписатьМетрики(ГистограммаДлительности, Событие, ОписаниеФайла, ИмяБазы)

	// База остается и атрибутом точки: атрибуты ресурса бэкенды метрик в метки не переносят
	Атрибуты = Новый ОтелАтрибуты;
	Атрибуты.Установить("v8.techlog.event.name", Событие.Имя);
	Атрибуты.Установить("process.executable.name", ОписаниеФайла.Процесс);
	Если ЗначениеЗаполнено(ИмяБазы) Тогда
		Атрибуты.Установить("v8.infobase.name", ИмяБазы);
	КонецЕсли;

	ЗначенияМетрикПрохода.Добавить(Новый Структура("Гистограмма, Длительность, Атрибуты",
		ГистограммаДлительности, Событие.Длительность / 1000000, Атрибуты));

КонецПроцедуры

Функция ИнструментыБазы(ИмяБазы)

	Инструменты = ИнструментыБаз[ИмяБазы];
	Если Инструменты <> Неопределено Тогда
		Возврат Инструменты;
	КонецЕсли;

	Провайдеры = Телеметрия.ДляСервиса(ИмяСервисаДанных, ИмяБазы);
	Метр = Провайдеры.ПровайдерМетрик.ПолучитьМетр("opentelemetry-v8-logs.techlog");
	Инструменты = Новый Структура;
	Инструменты.Вставить("Логгер", Провайдеры.ПровайдерЛогирования.ПолучитьЛоггер("opentelemetry-v8-logs.techlog"));
	Инструменты.Вставить("ГистограммаДлительности", Метр.СоздатьГистограмму("v8.techlog.event.duration",
		"Длительность событий технологического журнала", "s",
		Новый Структура("ГраницыГистограммы", ГраницыДлительности())));
	ИнструментыБаз.Вставить(ИмяБазы, Инструменты);

	Возврат Инструменты;

КонецФункции

Процедура УстановитьАтрибутыПроцесса(Запись, ОписаниеФайла)
	Если ЗначениеЗаполнено(ОписаниеФайла.Процесс) Тогда
		Запись.УстановитьАтрибут("process.executable.name", ОписаниеФайла.Процесс);
	КонецЕсли;
	Если ЗначениеЗаполнено(ОписаниеФайла.ИдПроцесса) Тогда
		Запись.УстановитьАтрибут("process.pid", Число(ОписаниеФайла.ИдПроцесса));
	КонецЕсли;
КонецПроцедуры

// Имя информационной базы события: свойство p:processName, если оно заполнено, иначе база
// из настроек источника (например, для файловой базы, где p:processName у событий пустой).
//
Функция ИмяИнформационнойБазы(Событие)
	Значение = Событие.Свойства["p:processName"];
	Если ТипЗнч(Значение) = Тип("Строка") И ЗначениеЗаполнено(Значение) Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат ИнформационнаяБазаИсточника;
КонецФункции

// Серьезность из свойства level, которым платформа оценивает событие сама,
// а без него или при неизвестном значении - по имени события.
//
Функция Серьезность(Событие)
	Уровень = Событие.Свойства["level"];
	Если ТипЗнч(Уровень) = Тип("Строка") Тогда
		Значение = СерьезностиУровней[ВРег(Уровень)];
		Если Значение <> Неопределено Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЕсли;
	Значение = СерьезностиСобытий[Событие.Имя];
	Если Значение = Неопределено Тогда
		Возврат ОтелСтепеньСерьезности.Info();
	КонецЕсли;
	Возврат Значение;
КонецФункции

Функция ГраницыДлительности()
	Границы = Новый Массив;
	Для Каждого Граница Из СтрРазделить("0.0001,0.0005,0.001,0.005,0.01,0.025,0.05,0.1,0.25,0.5,1,2.5,5,10,30,60,300", ",") Цикл
		Границы.Добавить(Число(Граница));
	КонецЦикла;
	Возврат Границы;
КонецФункции

#КонецОбласти

// Параметры:
//   НоваяТелеметрия - ТелеметрияЖурналов - провайдеры телеметрии данных журналов
//   ИмяСервиса - Строка - service.name данных источника; пустая строка - имя по умолчанию
//   ЧасовойПоясСервера - Строка - часовой пояс сервера, записавшего журнал; пустая строка - текущий
//   ИнформационнаяБаза - Строка - база событий без p:processName; пустая строка - не задана
//   ТрассыВключены - Булево - собирать трассы вызовов
//   КорневыеСобытия - Строка, Массив из Строка - события-корни трасс
//   РежимТрасс - Строка - auto, streaming или buffered, см. СборщикТрассТехнологическогоЖурнала
//   ТабакеркаСборщиков - Табакерка - СборщикТрассТехнологическогоЖурнала
//
&Желудь
&Характер("Компанейский")
Процедура ПриСозданииОбъекта(&Блестяшка НоваяТелеметрия, &Блестяшка ИмяСервиса, &Блестяшка ЧасовойПоясСервера,
	&Блестяшка ИнформационнаяБаза, &Блестяшка ТрассыВключены, &Блестяшка КорневыеСобытия, &Блестяшка РежимТрасс,
	&Табакерка &Пластилин("СборщикТрассТехнологическогоЖурнала") ТабакеркаСборщиков)

	Телеметрия = НоваяТелеметрия;
	ИмяСервисаДанных = ИмяСервиса;
	ИнформационнаяБазаИсточника = ИнформационнаяБаза;
	ЧасовойПоясЖурнала = ?(ЗначениеЗаполнено(ЧасовойПоясСервера), ЧасовойПоясСервера, ЧасовойПояс());
	ИнструментыБаз = Новый Соответствие;
	ЗначенияМетрикПрохода = Новый Массив;

	Если ТрассыВключены Тогда
		СборщикТрасс = ТабакеркаСборщиков.Достать(Массивы.ИзЭлементов(Телеметрия, ИмяСервисаДанных, ЧасовойПоясЖурнала,
			КорневыеСобытия, РежимТрасс));
	КонецЕсли;

	СерьезностиСобытий = Новый Соответствие;
	СерьезностиСобытий.Вставить("EXCP", ОтелСтепеньСерьезности.Error());
	СерьезностиСобытий.Вставить("TDEADLOCK", ОтелСтепеньСерьезности.Warn());
	СерьезностиСобытий.Вставить("TTIMEOUT", ОтелСтепеньСерьезности.Warn());
	СерьезностиСобытий.Вставить("ATTN", ОтелСтепеньСерьезности.Warn());

	СерьезностиУровней = Новый Соответствие;
	СерьезностиУровней.Вставить("DEBUG", ОтелСтепеньСерьезности.Debug());
	СерьезностиУровней.Вставить("INFO", ОтелСтепеньСерьезности.Info());
	СерьезностиУровней.Вставить("WARNING", ОтелСтепеньСерьезности.Warn());
	СерьезностиУровней.Вставить("ERROR", ОтелСтепеньСерьезности.Error());

КонецПроцедуры
