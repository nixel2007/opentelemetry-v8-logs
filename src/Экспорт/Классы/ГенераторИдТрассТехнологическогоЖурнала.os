// Генератор идентификаторов трасс и спанов для провайдера трассировки журналов.
//
// Спаны событий технологического журнала отправляются сразу, а событие-родитель появляется
// в журнале позже потомков: идентификатор родителя выдается заранее и передается SDK этим
// генератором при создании спана родителя. Без заданного значения генератор выдает
// случайные идентификаторы.

Перем СледующийИдТрассировки;
Перем СледующийИдСпана;

#Область ПрограммныйИнтерфейс

// Задает идентификатор, который получит следующий созданный спан.
//
// Параметры:
//   ИдСпана - Строка - идентификатор спана, 16 шестнадцатеричных символов
//   ИдТрассировки - Строка - идентификатор трассы для корневого спана; для дочернего спана
//     трасса берется из родителя
//
Процедура Задать(ИдСпана, ИдТрассировки = "") Экспорт
	СледующийИдСпана = ИдСпана;
	СледующийИдТрассировки = ИдТрассировки;
КонецПроцедуры

// Отменяет заданные идентификаторы.
//
Процедура Сбросить() Экспорт
	СледующийИдСпана = "";
	СледующийИдТрассировки = "";
КонецПроцедуры

// Новый случайный идентификатор трассы.
//
// Возвращаемое значение:
//   Строка - 32 шестнадцатеричных символа
//
Функция НовыйИдТрассировки() Экспорт
	Возврат СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
КонецФункции

// Новый случайный идентификатор спана.
//
// Возвращаемое значение:
//   Строка - 16 шестнадцатеричных символов
//
Функция НовыйИдСпана() Экспорт
	Возврат Прав(НовыйИдТрассировки(), 16);
КонецФункции

// Служебный: вызывается SDK при создании корневого спана.
//
// Возвращаемое значение:
//   Строка - идентификатор трассы
//
Функция СгенерироватьИдТрассировки() Экспорт
	Если ЗначениеЗаполнено(СледующийИдТрассировки) Тогда
		Результат = СледующийИдТрассировки;
		СледующийИдТрассировки = "";
		Возврат Результат;
	КонецЕсли;
	Возврат НовыйИдТрассировки();
КонецФункции

// Служебный: вызывается SDK при создании спана.
//
// Возвращаемое значение:
//   Строка - идентификатор спана
//
Функция СгенерироватьИдСпана() Экспорт
	Если ЗначениеЗаполнено(СледующийИдСпана) Тогда
		Результат = СледующийИдСпана;
		СледующийИдСпана = "";
		Возврат Результат;
	КонецЕсли;
	Возврат НовыйИдСпана();
КонецФункции

#КонецОбласти

Сбросить();
