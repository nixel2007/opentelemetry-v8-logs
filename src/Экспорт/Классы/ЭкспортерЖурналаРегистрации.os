#Использовать opentelemetry

// Экспорт записей журнала регистрации в OpenTelemetry.
//
// Каждая запись становится записью лога: комментарий в теле, поля записи - атрибутами
// onec.eventlog.* (пустые поля пропускаются), пользователь - атрибутами user.*.
// Количество записей считается счетчиком onec.eventlog.records в разрезе события,
// важности, базы и приложения.

Перем Логгер;
Перем СчетчикЗаписей;
Перем ЧасовойПоясЖурнала;
Перем Серьезности;
Перем СтатусыТранзакций;

#Область ПрограммныйИнтерфейс

// Передает записи журнала регистрации в OpenTelemetry. Обработчик для ЧитательЖурналаРегистрации.
//
// Параметры:
//   Записи - Массив из Структура - записи, см. ПарсерЖурналаРегистрации.ЗаписьЖурнала
//   ОписаниеЖурнала - Структура - описание файла журнала: Путь, ИнформационнаяБаза
//
Процедура ОбработатьЗаписиЖурналаРегистрации(Записи, ОписаниеЖурнала) Экспорт
	Для Каждого Запись Из Записи Цикл
		ЗаписатьЛог(Запись, ОписаниеЖурнала);
		ЗаписатьМетрики(Запись, ОписаниеЖурнала);
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаписатьЛог(Запись, ОписаниеЖурнала)

	ЗаписьЛога = Логгер.СоздатьЗаписьЛога();
	ЗаписьЛога.УстановитьВремя(ВремяЖурналов.ВНаносекунды(Запись.Время, 0, ЧасовойПоясЖурнала));
	ЗаписьЛога.УстановитьСерьезность(Серьезность(Запись.Важность));
	ЗаписьЛога.УстановитьТело(?(ЗначениеЗаполнено(Запись.Комментарий), Запись.Комментарий, Запись.Событие));

	УстановитьАтрибут(ЗаписьЛога, "onec.eventlog.event", Запись.Событие);
	УстановитьАтрибут(ЗаписьЛога, "onec.infobase.name", ОписаниеЖурнала.ИнформационнаяБаза);
	УстановитьАтрибут(ЗаписьЛога, "user.name", Запись.Пользователь);
	УстановитьАтрибут(ЗаписьЛога, "user.id", Запись.ИдПользователя);
	УстановитьАтрибут(ЗаписьЛога, "onec.eventlog.computer", Запись.Компьютер);
	УстановитьАтрибут(ЗаписьЛога, "onec.eventlog.application", Запись.Приложение);
	УстановитьАтрибут(ЗаписьЛога, "onec.eventlog.connection", Запись.Соединение);
	УстановитьАтрибут(ЗаписьЛога, "onec.eventlog.session", Запись.Сеанс);
	УстановитьАтрибут(ЗаписьЛога, "onec.eventlog.transaction.status", СтатусыТранзакций[Запись.СтатусТранзакции]);
	Если Запись.СтатусТранзакции <> "N" Тогда
		УстановитьАтрибут(ЗаписьЛога, "onec.eventlog.transaction.status_code", Запись.СтатусТранзакции);
	КонецЕсли;
	УстановитьАтрибут(ЗаписьЛога, "onec.eventlog.transaction.id", Запись.НомерТранзакции);
	УстановитьАтрибут(ЗаписьЛога, "onec.eventlog.metadata", Запись.Метаданные);
	УстановитьАтрибут(ЗаписьЛога, "onec.eventlog.metadata.uuid", Запись.ИдМетаданных);
	УстановитьАтрибут(ЗаписьЛога, "onec.eventlog.data", Запись.Данные);
	УстановитьАтрибут(ЗаписьЛога, "onec.eventlog.data.presentation", Запись.ПредставлениеДанных);
	УстановитьАтрибут(ЗаписьЛога, "onec.eventlog.server", Запись.Сервер);
	УстановитьАтрибут(ЗаписьЛога, "onec.eventlog.port", Запись.ОсновнойПорт);
	УстановитьАтрибут(ЗаписьЛога, "onec.eventlog.sync_port", Запись.ВспомогательныйПорт);
	Для Каждого Разделитель Из Запись.РазделениеДанныхСеанса Цикл
		УстановитьАтрибут(ЗаписьЛога, "onec.eventlog.data_separation." + Разделитель.Ключ, Разделитель.Значение);
	КонецЦикла;
	УстановитьАтрибут(ЗаписьЛога, "log.file.path", ОписаниеЖурнала.Путь);

	Логгер.Записать(ЗаписьЛога);

КонецПроцедуры

Процедура ЗаписатьМетрики(Запись, ОписаниеЖурнала)

	Атрибуты = Новый ОтелАтрибуты;
	Атрибуты.Установить("onec.eventlog.event", Запись.Событие);
	Атрибуты.Установить("onec.eventlog.severity",
		ОтелСтепеньСерьезности.ТекстСерьезности(Серьезность(Запись.Важность)));
	Атрибуты.Установить("onec.infobase.name", ОписаниеЖурнала.ИнформационнаяБаза);
	Атрибуты.Установить("onec.eventlog.application", Запись.Приложение);

	СчетчикЗаписей.Добавить(1, Атрибуты);

КонецПроцедуры

// Пустые строки и нулевые коды не передаются: у большинства записей заполнена малая часть полей.
//
Процедура УстановитьАтрибут(ЗаписьЛога, Ключ, Значение)
	Если ЗначениеЗаполнено(Значение) Тогда
		ЗаписьЛога.УстановитьАтрибут(Ключ, Значение);
	КонецЕсли;
КонецПроцедуры

Функция Серьезность(Важность)
	Значение = Серьезности[Важность];
	Если Значение = Неопределено Тогда
		Возврат ОтелСтепеньСерьезности.Info();
	КонецЕсли;
	Возврат Значение;
КонецФункции

Функция ЗначениеПараметра(Параметры, Имя, ЗначениеПоУмолчанию)
	Если Параметры = Неопределено ИЛИ НЕ Параметры.Свойство(Имя) Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	Возврат Параметры[Имя];
КонецФункции

#КонецОбласти

// Параметры:
//   НовыйЛоггер - ОтелЛоггер - логгер для записей журнала
//   Метр - ОтелМетр - метр для метрик журнала
//   Параметры - Структура, Неопределено - параметры экспорта:
//     * ЧасовойПояс - Строка - часовой пояс сервера, записавшего журнал (по умолчанию - текущий)
//
Процедура ПриСозданииОбъекта(НовыйЛоггер, Метр, Параметры = Неопределено)

	Логгер = НовыйЛоггер;
	ЧасовойПоясЖурнала = ЗначениеПараметра(Параметры, "ЧасовойПояс", ЧасовойПояс());

	СчетчикЗаписей = Метр.СоздатьСчетчик("onec.eventlog.records",
		"Количество записей журнала регистрации", "{record}");

	Серьезности = Новый Соответствие;
	Серьезности.Вставить("E", ОтелСтепеньСерьезности.Error());
	Серьезности.Вставить("W", ОтелСтепеньСерьезности.Warn());
	Серьезности.Вставить("I", ОтелСтепеньСерьезности.Info());
	Серьезности.Вставить("N", ОтелСтепеньСерьезности.Debug());

	// По журналам: событие _$Transaction$_.Commit записано со статусом C, Rollback - с R.
	// Значение U (у изменений данных внутри транзакции) не расшифровывается и передается
	// только кодом статуса; N - транзакции нет, атрибуты не передаются.
	СтатусыТранзакций = Новый Соответствие;
	СтатусыТранзакций.Вставить("C", "committed");
	СтатусыТранзакций.Вставить("R", "rolled_back");

КонецПроцедуры
