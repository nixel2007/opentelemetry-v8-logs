#native
#Использовать opentelemetry
#Использовать "../../ЖурналРегистрации"

// Экспорт записей журнала регистрации в OpenTelemetry.
//
// Каждая запись становится записью лога: в теле строка как в просмотре журнала (см. Тело),
// поля записи - атрибутами v8.eventlog.* (пустые поля пропускаются), пользователь - атрибутами user.*;
// тело и значения атрибутов ограничены по размеру, см. ОграничениеРазмеровТелеметрии.
// Количество записей считается счетчиком v8.eventlog.records в разрезе события, важности, базы
// и приложения, когда проход подтвержден (ПодтвердитьПроход). Информационная база попадает
// в ресурс телеметрии (v8.infobase.name), см. ТелеметрияЖурналов.

&Пластилин
Перем ВремяЖурналов; // ВремяЖурналов - перевод времени журнала в метки OpenTelemetry

&Пластилин
Перем ПредставленияСобытийЖурналаРегистрации; // ПредставленияСобытийЖурналаРегистрации - представления событий

&Пластилин
Перем ОграничениеРазмеровТелеметрии; // ОграничениеРазмеровТелеметрии - лимиты тела и значений атрибутов

Перем Телеметрия; // ТелеметрияЖурналов - провайдеры телеметрии данных журналов
Перем ИмяСервисаДанных; // Строка - service.name данных источника
Перем ИнструментыБаз; // Соответствие: база -> Структура("Логгер, СчетчикЗаписей, СчетчикОбрезок,
	// СчетчикОбрезанныхБайт")
Перем ЧасовойПоясЖурнала; // Строка - часовой пояс сервера, записавшего журнал
Перем Серьезности; // Соответствие: важность записи -> степень серьезности OpenTelemetry
Перем СтатусыТранзакций; // Соответствие: код статуса транзакции -> значение атрибута
Перем ЗначенияМетрикПрохода; // Массив из Структура("Счетчик, Значение, Атрибуты") - до подтверждения прохода
Перем ИдСеансаВключен; // Булево - записывать session.id (Opt-In в semconv)
Перем ПропускатьДублиСемантическихСоглашений; // Булево - не записывать v8.eventlog.* - дубли атрибутов semconv
Перем РазделительЧастейТела; // Строка - разделитель частей тела записи лога

#Область ПрограммныйИнтерфейс

// Передает записи журнала регистрации в OpenTelemetry. Обработчик для ЧитательЖурналаРегистрации.
//
// Параметры:
//   Записи - Массив из Структура - записи, см. ПарсерЖурналаРегистрации.ЗаписьЖурнала
//   ОписаниеЖурнала - Структура - описание файла журнала: Путь, ИнформационнаяБаза
//
Процедура ОбработатьЗаписи(Записи, ОписаниеЖурнала) Экспорт
	Инструменты = ИнструментыБазы(ОписаниеЖурнала.ИнформационнаяБаза);
	Для Каждого Запись Из Записи Цикл
		Обрезки = Новый Массив;
		Тело = ЗаписатьЛог(Инструменты.Логгер, Запись, ОписаниеЖурнала, Обрезки);
		ЗаписатьМетрики(Инструменты.СчетчикЗаписей, Запись, ОписаниеЖурнала);
		ЗаписатьМетрикиОбрезки(Инструменты, Запись, ОписаниеЖурнала, Тело, Обрезки);
	КонецЦикла;
КонецПроцедуры

// Вызывается после прохода: записи журнала регистрации отправляются сразу, ждать нечего.
//
Процедура ЗавершитьПроход() Экспорт
	Возврат;
КонецПроцедуры

// Вызывается при завершении работы: отложенных данных у журнала регистрации нет.
//
Процедура Закрыть() Экспорт
	Возврат;
КонецПроцедуры

// Вызывается после того, как записи прохода переданы и позиции зафиксированы:
// записи прохода учитываются в счетчике v8.eventlog.records, обрезки - в v8.eventlog.truncated
// и v8.eventlog.truncated.size.
//
Процедура ПодтвердитьПроход() Экспорт
	Для Каждого Значение Из ЗначенияМетрикПрохода Цикл
		Значение.Счетчик.Добавить(Значение.Значение, Значение.Атрибуты);
	КонецЦикла;
	ЗначенияМетрикПрохода.Очистить();
КонецПроцедуры

// Вызывается при откате прохода: записи будут прочитаны повторно и учтутся в повторном проходе.
//
Процедура ОтменитьПроход() Экспорт
	ЗначенияМетрикПрохода.Очистить();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИнструментыБазы(ИмяБазы)

	Инструменты = ИнструментыБаз[ИмяБазы];
	Если Инструменты <> Неопределено Тогда
		Возврат Инструменты;
	КонецЕсли;

	ОбластьИнструментирования = "opentelemetry-v8-logs.eventlog";
	Провайдеры = Телеметрия.ДляСервиса(ИмяСервисаДанных, ИмяБазы);
	Метр = Провайдеры.ПровайдерМетрик.ПолучитьМетр(ОбластьИнструментирования);
	Логгер = Провайдеры.ПровайдерЛогирования.ПолучитьЛоггер(ОбластьИнструментирования);
	СчетчикЗаписей = Метр.СоздатьСчетчик("v8.eventlog.records", "Количество записей журнала регистрации", "{record}");
	СчетчикОбрезок = Метр.СоздатьСчетчик("v8.eventlog.truncated",
		"Обрезанные по лимиту размера тела записей лога и значения атрибутов", "{value}");
	СчетчикОбрезанныхБайт = Метр.СоздатьСчетчик("v8.eventlog.truncated.size",
		"Байты, отрезанные от тел записей лога и значений атрибутов", "By");

	Инструменты = Новый Структура;
	Инструменты.Вставить("Логгер", Логгер);
	Инструменты.Вставить("СчетчикЗаписей", СчетчикЗаписей);
	Инструменты.Вставить("СчетчикОбрезок", СчетчикОбрезок);
	Инструменты.Вставить("СчетчикОбрезанныхБайт", СчетчикОбрезанныхБайт);
	ИнструментыБаз.Вставить(ИмяБазы, Инструменты);

	Возврат Инструменты;

КонецФункции

// Записывает запись журнала регистрации записью лога с ограниченными телом и атрибутами.
//
// Параметры:
//   Логгер - ОтелЛоггер - логгер базы
//   Запись - Структура - запись журнала регистрации, см. ПарсерЖурналаРегистрации.ЗаписьЖурнала
//   ОписаниеЖурнала - Структура - описание файла журнала: Путь, ИнформационнаяБаза
//   Обрезки - Массив - выходной: дополняется обрезанными атрибутами,
//     см. ОграничениеРазмеровТелеметрии.ОграничитьАтрибуты
//
// Возвращаемое значение:
//   Структура - ограничение тела, см. ОграничениеРазмеровТелеметрии.ОграничитьТело
//
Функция ЗаписатьЛог(Логгер, Запись, ОписаниеЖурнала, Обрезки)

	ЗаписьЛога = Логгер.СоздатьЗаписьЛога();
	ЗаписьЛога.УстановитьВремя(ВремяЖурналов.ВНаносекунды(Запись.Время, 0, ЧасовойПоясЖурнала));
	ЗаписьЛога.УстановитьСерьезность(Серьезность(Запись.Важность));
	ПредставлениеСобытия = ПредставленияСобытийЖурналаРегистрации.Представление(Запись.Событие);
	ОграниченноеТело = ОграничитьТело(Запись, ПредставлениеСобытия);
	ЗаписьЛога.УстановитьТело(ОграниченноеТело.Значение);

	Атрибуты = Новый Соответствие;
	Если ОграниченноеТело.Обрезано Тогда
		Атрибуты.Вставить("v8.eventlog.truncation.body.original_size", ОграниченноеТело.ИсходныйРазмер);
	КонецЕсли;
	Если ОграниченноеТело.Ключи.Количество() > 0 Тогда
		Атрибуты.Вставить("v8.eventlog.truncation.body.attributes", ОграниченноеТело.Ключи);
	КонецЕсли;

	УстановитьАтрибут(Атрибуты, "v8.eventlog.event", Запись.Событие);
	УстановитьАтрибут(Атрибуты, "v8.eventlog.event.presentation", ПредставлениеСобытия);
	УстановитьАтрибут(Атрибуты, "user.name", Запись.Пользователь);
	УстановитьАтрибут(Атрибуты, "user.id", Запись.ИдПользователя);
	УстановитьАтрибут(Атрибуты, "client.address", Запись.Компьютер);
	Если НЕ ПропускатьДублиСемантическихСоглашений Тогда
		УстановитьАтрибут(Атрибуты, "v8.eventlog.computer", Запись.Компьютер);
	КонецЕсли;
	УстановитьАтрибут(Атрибуты, "v8.eventlog.application", Запись.Приложение);
	УстановитьАтрибут(Атрибуты, "v8.eventlog.connection", Запись.Соединение);
	ИдСеансаЗаписан = ИдСеансаВключен И ЗначениеЗаполнено(Запись.Сеанс);
	Если ИдСеансаЗаписан Тогда
		УстановитьАтрибут(Атрибуты, "session.id", Формат(Запись.Сеанс, "ЧГ=0"));
	КонецЕсли;
	Если НЕ (ПропускатьДублиСемантическихСоглашений И ИдСеансаЗаписан) Тогда
		УстановитьАтрибут(Атрибуты, "v8.eventlog.session", Запись.Сеанс);
	КонецЕсли;
	УстановитьАтрибут(Атрибуты, "v8.eventlog.transaction.status", СтатусыТранзакций[Запись.СтатусТранзакции]);
	Если Запись.СтатусТранзакции <> "N" Тогда
		УстановитьАтрибут(Атрибуты, "v8.eventlog.transaction.status_code", Запись.СтатусТранзакции);
	КонецЕсли;
	УстановитьАтрибут(Атрибуты, "v8.eventlog.transaction.id", Запись.НомерТранзакции);
	УстановитьАтрибут(Атрибуты, "v8.eventlog.metadata", Запись.Метаданные);
	УстановитьАтрибут(Атрибуты, "v8.eventlog.metadata.uuid", Запись.ИдМетаданных);

	УстановитьАтрибут(Атрибуты, "v8.eventlog.data", ДанныеДляАтрибута(Запись));
	УстановитьАтрибут(Атрибуты, "v8.eventlog.data.presentation", Запись.ПредставлениеДанных);

	УстановитьАтрибут(Атрибуты, "v8.eventlog.server", Запись.Сервер);
	УстановитьАтрибут(Атрибуты, "v8.eventlog.port", Запись.ОсновнойПорт);
	УстановитьАтрибут(Атрибуты, "v8.eventlog.sync_port", Запись.ВспомогательныйПорт);
	УстановитьАтрибут(Атрибуты, "v8.eventlog.data_separation", РазделениеДанных(Запись.РазделениеДанныхСеанса));
	Для Каждого Разделитель Из Запись.РазделениеДанныхСеанса Цикл
		Ключ = "v8.eventlog.data_separation." + ОтелУтилиты.Транслитерировать(Разделитель.Ключ);
		УстановитьАтрибут(Атрибуты, Ключ, Разделитель.Значение);
	КонецЦикла;
	УстановитьАтрибут(Атрибуты, "log.file.path", ОписаниеЖурнала.Путь);
	УстановитьАтрибут(Атрибуты, "log.file.name", Новый Файл(ОписаниеЖурнала.Путь).Имя);

	ОграничитьАтрибуты(Атрибуты, Обрезки);
	Для Каждого Атрибут Из Атрибуты Цикл
		ЗаписьЛога.УстановитьАтрибут(Атрибут.Ключ, Атрибут.Значение);
	КонецЦикла;

	Логгер.Записать(ЗаписьЛога, Новый Соответствие);

	Возврат ОграниченноеТело;

КонецФункции

// Обрезает атрибуты по лимитам и перечисляет обрезанные ключи в v8.eventlog.truncation.attributes.
//
// Параметры:
//   Атрибуты - Соответствие - ключ атрибута -> значение, обрезается и дополняется
//   Обрезки - Массив - дополняется обрезанными атрибутами
//
Процедура ОграничитьАтрибуты(Атрибуты, Обрезки)
	Обрезанные = ОграничениеРазмеровТелеметрии.ОграничитьАтрибуты(Атрибуты);
	Если Обрезанные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Ключи = Новый Массив;
	Для Каждого Обрезка Из Обрезанные Цикл
		Ключи.Добавить(Обрезка.Ключ);
		Обрезки.Добавить(Обрезка);
	КонецЦикла;
	Атрибуты.Вставить("v8.eventlog.truncation.attributes", Ключи);
КонецПроцедуры

Функция РазделениеДанных(Разделители)
	Части = Новый Массив;
	Для Каждого Разделитель Из Разделители Цикл
		Части.Добавить(Разделитель.Ключ + "=" + Разделитель.Значение);
	КонецЦикла;
	Возврат СтрСоединить(Части, ", ");
КонецФункции

Функция ДанныеДляАтрибута(Запись)

	// Известные поля SDK передаст как OTLP map. При штатном приеме OTLP Loki
	// развернет их в structured metadata без добавления индексируемых меток.
	Если Запись.Свойство("ПоляДанных") И Запись.ПоляДанных <> Неопределено Тогда
		Возврат Запись.ПоляДанных;
	КонецЕсли;

	// Неизвестные формы и записи сторонних обработчиков сохраняют прежний JSON.
	// Текстовое представление Запись.Данные остается для формирования тела лога.
	Если Запись.Свойство("ДанныеJSON") И Запись.ДанныеJSON <> "" Тогда
		Возврат Запись.ДанныеJSON;
	КонецЕсли;

	// Поддерживаем скаляры и записи обработчиков, не заполняющих ДанныеJSON.
	Возврат Запись.Данные;

КонецФункции

Процедура ЗаписатьМетрики(СчетчикЗаписей, Запись, ОписаниеЖурнала)

	// База остается и атрибутом точки: атрибуты ресурса бэкенды метрик в метки не переносят
	Атрибуты = Новый ОтелАтрибуты;
	Атрибуты.Установить("v8.eventlog.event", Запись.Событие);
	Атрибуты.Установить("v8.eventlog.severity",
		ОтелСтепеньСерьезности.ТекстСерьезности(Серьезность(Запись.Важность)));
	Атрибуты.Установить("v8.infobase.name", ОписаниеЖурнала.ИнформационнаяБаза);
	Атрибуты.Установить("v8.eventlog.application", Запись.Приложение);

	ЗначенияМетрикПрохода.Добавить(Новый Структура("Счетчик, Значение, Атрибуты", СчетчикЗаписей, 1, Атрибуты));

КонецПроцедуры

Процедура ЗаписатьМетрикиОбрезки(Инструменты, Запись, ОписаниеЖурнала, Тело, Обрезки)
	Если Тело.Обрезано Тогда
		ДобавитьОбрезку(Инструменты, Запись, ОписаниеЖурнала, "body", "", Тело.ИсходныйРазмер - Тело.Размер);
	КонецЕсли;
	Для Каждого Обрезка Из Обрезки Цикл
		ДобавитьОбрезку(Инструменты, Запись, ОписаниеЖурнала, "attribute", Обрезка.Ключ,
			Обрезка.ИсходныйРазмер - Обрезка.Размер);
	КонецЦикла;
КонецПроцедуры

Процедура ДобавитьОбрезку(Инструменты, Запись, ОписаниеЖурнала, Цель, КлючАтрибута, ОтрезаноБайт)
	Атрибуты = Новый ОтелАтрибуты;
	Атрибуты.Установить("v8.eventlog.event", Запись.Событие);
	Атрибуты.Установить("v8.infobase.name", ОписаниеЖурнала.ИнформационнаяБаза);
	Атрибуты.Установить("v8.eventlog.truncation.target", Цель);
	Если ЗначениеЗаполнено(КлючАтрибута) Тогда
		Атрибуты.Установить("v8.eventlog.truncation.attribute", КлючАтрибута);
	КонецЕсли;
	Обрезка = Новый Структура("Счетчик, Значение, Атрибуты", Инструменты.СчетчикОбрезок, 1, Атрибуты);
	ЗначенияМетрикПрохода.Добавить(Обрезка);
	Отрезано = Новый Структура("Счетчик, Значение, Атрибуты",
		Инструменты.СчетчикОбрезанныхБайт, ОтрезаноБайт, Атрибуты);
	ЗначенияМетрикПрохода.Добавить(Отрезано);
КонецПроцедуры

// Тело записи лога в пределах лимита: длинное тело обрезается внутри полей записи.
//
// Параметры:
//   Запись - Структура - запись журнала регистрации, см. ПарсерЖурналаРегистрации.ЗаписьЖурнала
//   ПредставлениеСобытия - Строка - представление события; без представления - идентификатор
//
// Возвращаемое значение:
//   Структура - см. ОграничениеРазмеровТелеметрии.ОграничитьТело
//
Функция ОграничитьТело(Запись, ПредставлениеСобытия)

	Части = ЧастиТела(Запись, ПредставлениеСобытия);
	Тело = СтрСоединить(Части.Значения, РазделительЧастейТела);
	Если ЗначениеЗаполнено(Запись.Комментарий) Тогда
		Тело = Тело + Символы.ПС + Запись.Комментарий;
	КонецЕсли;

	Если НЕ ОграничениеРазмеровТелеметрии.ТелоПревышаетЛимит(Тело) Тогда
		Возврат ОграничениеРазмеровТелеметрии.ОграничитьТело(Тело);
	КонецЕсли;
	Возврат ОграничениеРазмеровТелеметрии.ОграничитьТело(Тело, ЗначенияТела(Части, Запись.Комментарий));

КонецФункции

// Части тела записи лога - как строки просмотра журнала: представление события и то, к чему оно
// относится, значения как в журнале. У событий с объектом или данными - объект, данные
// и пользователь, у остальных - приложение, пользователь и сеанс. Части соединяются через « | »,
// комментарий - с новой строки.
//
// Параметры:
//   Запись - Структура - запись журнала регистрации, см. ПарсерЖурналаРегистрации.ЗаписьЖурнала
//   ПредставлениеСобытия - Строка - представление события; без представления - идентификатор
//
// Возвращаемое значение:
//   Структура - Значения (Массив из Строка - непустые части по порядку), Ключи (Массив из Строка -
//     имена полей частей для v8.eventlog.truncation.body.attributes; у сеанса - пустая строка)
//
Функция ЧастиТела(Запись, ПредставлениеСобытия)

	Части = Новый Структура("Значения, Ключи", Новый Массив, Новый Массив);
	Части.Значения.Добавить(ПредставлениеСобытия);
	Части.Ключи.Добавить("event.presentation");
	ЕстьПредставлениеДанных = ЗначениеЗаполнено(Запись.ПредставлениеДанных);
	Данные = ?(ЕстьПредставлениеДанных, Запись.ПредставлениеДанных, Запись.Данные);
	Если ЗначениеЗаполнено(Запись.Метаданные) ИЛИ ЗначениеЗаполнено(Данные) Тогда
		ДобавитьЧасть(Части, "metadata", Запись.Метаданные);
		ДобавитьЧасть(Части, ?(ЕстьПредставлениеДанных, "data.presentation", "data"), Данные);
		ДобавитьЧасть(Части, "user", Запись.Пользователь);
	Иначе
		ДобавитьЧасть(Части, "application", Запись.Приложение);
		ДобавитьЧасть(Части, "user", Запись.Пользователь);
		Если ЗначениеЗаполнено(Запись.Сеанс) Тогда
			ДобавитьЧасть(Части, "", "session=" + Формат(Запись.Сеанс, "ЧГ=0"));
		КонецЕсли;
	КонецЕсли;

	Возврат Части;

КонецФункции

Процедура ДобавитьЧасть(Части, Ключ, Значение)
	Если ЗначениеЗаполнено(Значение) Тогда
		Части.Значения.Добавить(Значение);
		Части.Ключи.Добавить(Ключ);
	КонецЕсли;
КонецПроцедуры

// Параметры:
//   Части - Структура - части тела, см. ЧастиТела
//   Комментарий - Строка - комментарий записи, в теле после частей с новой строки
//
// Возвращаемое значение:
//   Массив из Структура - значения тела, см. ОграничениеРазмеровТелеметрии.ОграничитьТело
//
Функция ЗначенияТела(Части, Комментарий)

	Значения = Новый Массив;
	ДлинаРазделителя = СтрДлина(РазделительЧастейТела);
	Начало = 1;
	Для Номер = 0 По Части.Значения.ВГраница() Цикл
		Длина = СтрДлина(Части.Значения[Номер]);
		ДобавитьЗначениеТела(Значения, Части.Ключи[Номер], Начало, Длина);
		Начало = Начало + Длина + ДлинаРазделителя;
	КонецЦикла;
	// После последней части разделителя нет, комментарий идет за переводом строки
	ДобавитьЗначениеТела(Значения, "comment", Начало - ДлинаРазделителя + СтрДлина(Символы.ПС), СтрДлина(Комментарий));

	Возврат Значения;

КонецФункции

Процедура ДобавитьЗначениеТела(Значения, Ключ, Начало, Длина)
	Если Ключ <> "" И Длина > 0 Тогда
		Значение = Новый Структура("Ключ, Начало, Длина", Ключ, Начало, Длина);
		Значение.Вставить("НедопустимоеОкончание", Неопределено);
		Значения.Добавить(Значение);
	КонецЕсли;
КонецПроцедуры

// Пустые строки и нулевые коды не передаются: у большинства записей заполнена малая часть полей.
//
// Параметры:
//   Атрибуты - Соответствие - атрибуты записи лога, дополняется
//   Ключ - Строка - имя атрибута
//   Значение - Произвольный - значение атрибута
//
Процедура УстановитьАтрибут(Атрибуты, Ключ, Значение)
	Если ЗначениеЗаполнено(Значение) Тогда
		Атрибуты.Вставить(Ключ, Значение);
	КонецЕсли;
КонецПроцедуры

Функция Серьезность(Важность)
	Значение = Серьезности[Важность];
	Если Значение = Неопределено Тогда
		Возврат ОтелСтепеньСерьезности.Info();
	КонецЕсли;
	Возврат Значение;
КонецФункции

#КонецОбласти

// Параметры:
//   НоваяТелеметрия - ТелеметрияЖурналов - провайдеры телеметрии данных журналов
//   ИмяСервиса - Строка - service.name данных источника; пустая строка - имя по умолчанию
//   ЧасовойПоясСервера - Строка - часовой пояс сервера, записавшего журнал; пустая строка - текущий
//   ИдСеанса - Булево - записывать session.id
//   ПропускатьДубли - Булево - не записывать v8.eventlog.computer и v8.eventlog.session, когда то же
//     значение записано атрибутами семантических соглашений client.address и session.id
//
&Желудь
&Характер("Компанейский")
&Реализует("ИнтерфейсОбработчикЗаписей")
Процедура ПриСозданииОбъекта(&Блестяшка НоваяТелеметрия, &Блестяшка ИмяСервиса, &Блестяшка ЧасовойПоясСервера,
	&Блестяшка ИдСеанса, &Блестяшка ПропускатьДубли)

	ИдСеансаВключен = ИдСеанса;
	ПропускатьДублиСемантическихСоглашений = ПропускатьДубли;
	Телеметрия = НоваяТелеметрия;
	ИмяСервисаДанных = ИмяСервиса;
	ИнструментыБаз = Новый Соответствие;
	ЗначенияМетрикПрохода = Новый Массив;
	ЧасовойПоясЖурнала = ?(ЗначениеЗаполнено(ЧасовойПоясСервера), ЧасовойПоясСервера, ЧасовойПояс());
	РазделительЧастейТела = " | ";

	Серьезности = Новый Соответствие;
	Серьезности.Вставить("E", ОтелСтепеньСерьезности.Error());
	Серьезности.Вставить("W", ОтелСтепеньСерьезности.Warn());
	Серьезности.Вставить("I", ОтелСтепеньСерьезности.Info());
	Серьезности.Вставить("N", ОтелСтепеньСерьезности.Debug());

	// По журналам: событие _$Transaction$_.Commit записано со статусом C, Rollback - с R.
	// Значение U (у изменений данных внутри транзакции) не расшифровывается и передается
	// только кодом статуса; N - транзакции нет, атрибуты не передаются.
	СтатусыТранзакций = Новый Соответствие;
	СтатусыТранзакций.Вставить("C", "committed");
	СтатусыТранзакций.Вставить("R", "rolled_back");

КонецПроцедуры
