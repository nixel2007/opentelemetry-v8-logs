#native

// Перевод времени журналов 1С (местное время сервера) в метки времени OpenTelemetry.

Перем НачалоЭпохи; // Дата - начало отсчета Unix epoch
Перем МикросекундВСекунде; // Число
Перем НаносекундВМикросекунде; // Число
Перем СекундВЧасе; // Число
// ФиксированнаяСтруктура, Неопределено - смещение пояса для последнего часа местного времени:
// НачалоЧаса, ЧасовойПояс, Смещение (Неопределено, если внутри часа переход времени).
// Одна ссылка, а не отдельные переменные: журналы читаются из нескольких потоков
Перем КэшСмещения;

#Область ПрограммныйИнтерфейс

// Переводит местное время журнала в наносекунды Unix epoch (UTC).
//
// Параметры:
//   МестноеВремя - Дата - местное время с точностью до секунды
//   Микросекунды - Число - доля секунды в микросекундах
//   ЧасовойПояс - Строка - часовой пояс, в котором записан журнал (IANA, Windows или GMT+ЧЧ:ММ)
//
// Возвращаемое значение:
//   Строка - наносекунды Unix epoch
//
Функция ВНаносекунды(Знач МестноеВремя, Знач Микросекунды, Знач ЧасовойПояс) Экспорт
	Возврат МикросекундыВНаносекунды(ВМикросекунды(МестноеВремя, Микросекунды, ЧасовойПояс));
КонецФункции

// Переводит местное время журнала в микросекунды Unix epoch (UTC).
//
// Параметры:
//   МестноеВремя - Дата - местное время с точностью до секунды
//   Микросекунды - Число - доля секунды в микросекундах
//   ЧасовойПояс - Строка - часовой пояс, в котором записан журнал (IANA, Windows или GMT+ЧЧ:ММ)
//
// Возвращаемое значение:
//   Число - микросекунды Unix epoch
//
Функция ВМикросекунды(Знач МестноеВремя, Знач Микросекунды, Знач ЧасовойПояс) Экспорт
	Секунды = ВУниверсальноеВремя(МестноеВремя, ЧасовойПояс) - НачалоЭпохи;
	Возврат Секунды * МикросекундВСекунде + Микросекунды;
КонецФункции

// Текущее время по часам в микросекундах Unix epoch (UTC).
//
// Возвращаемое значение:
//   Число - микросекунды Unix epoch
//
Функция ТекущееВремяВМикросекундах() Экспорт
	Возврат (ТекущаяУниверсальнаяДата() - НачалоЭпохи) * МикросекундВСекунде;
КонецФункции

// Переводит секунды в микросекунды.
//
// Параметры:
//   Секунды - Число - длительность в секундах
//
// Возвращаемое значение:
//   Число - длительность в микросекундах
//
Функция СекундыВМикросекунды(Знач Секунды) Экспорт
	Возврат Секунды * МикросекундВСекунде;
КонецФункции

// Переводит микросекунды в секунды.
//
// Параметры:
//   Микросекунды - Число - длительность в микросекундах
//
// Возвращаемое значение:
//   Число - длительность в секундах
//
Функция МикросекундыВСекунды(Знач Микросекунды) Экспорт
	Возврат Микросекунды / МикросекундВСекунде;
КонецФункции

// Переводит микросекунды Unix epoch в метку времени OpenTelemetry.
//
// Параметры:
//   Микросекунды - Число - микросекунды Unix epoch
//
// Возвращаемое значение:
//   Строка - наносекунды Unix epoch
//
Функция МикросекундыВНаносекунды(Знач Микросекунды) Экспорт
	Возврат Формат(Микросекунды * НаносекундВМикросекунде, "ЧГ=0");
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// УниверсальноеВремя с кэшем смещения на час местного времени. События журнала идут по времени,
// а УниверсальноеВремя дорогое: для пояса вида GMT+ЧЧ:ММ около 20 мкс на вызов.
//
// Параметры:
//   МестноеВремя - Дата - местное время
//   ЧасовойПояс - Строка - часовой пояс
//
// Возвращаемое значение:
//   Дата - универсальное время
//
Функция ВУниверсальноеВремя(МестноеВремя, ЧасовойПояс)
	Смещение = СмещениеЧаса(НачалоЧаса(МестноеВремя), ЧасовойПояс);
	Если Смещение = Неопределено Тогда
		Возврат УниверсальноеВремя(МестноеВремя, ЧасовойПояс);
	КонецЕсли;
	Возврат МестноеВремя + Смещение;
КонецФункции

// Смещение универсального времени от местного, одинаковое на весь час.
//
// Параметры:
//   НачалоЧаса - Дата - начало часа местного времени
//   ЧасовойПояс - Строка - часовой пояс
//
// Возвращаемое значение:
//   Число, Неопределено - смещение в секундах; Неопределено - внутри часа переход времени
//     или час пропущен (тогда время переводится без кэша, как и раньше)
//
Функция СмещениеЧаса(НачалоЧаса, ЧасовойПояс)
	Кэш = КэшСмещения;
	Если Кэш <> Неопределено И Кэш.НачалоЧаса = НачалоЧаса И Кэш.ЧасовойПояс = ЧасовойПояс Тогда
		Возврат Кэш.Смещение;
	КонецЕсли;
	КонецЧаса = НачалоЧаса + СекундВЧасе - 1;
	Попытка
		СмещениеНачала = УниверсальноеВремя(НачалоЧаса, ЧасовойПояс) - НачалоЧаса;
		СмещениеКонца = УниверсальноеВремя(КонецЧаса, ЧасовойПояс) - КонецЧаса;
		Смещение = ?(СмещениеНачала = СмещениеКонца, СмещениеНачала, Неопределено);
	Исключение
		Смещение = Неопределено;
	КонецПопытки;
	КэшСмещения = Новый ФиксированнаяСтруктура("НачалоЧаса, ЧасовойПояс, Смещение",
		НачалоЧаса, ЧасовойПояс, Смещение);
	Возврат Смещение;
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта()
	НачалоЭпохи = '19700101';
	МикросекундВСекунде = 1000000;
	НаносекундВМикросекунде = 1000;
	СекундВЧасе = 3600;
КонецПроцедуры
