#native
#Использовать opentelemetry

// Снимки сеансов кластера 1С записями лога: по записи на сеанс за опрос, база сеанса - в ресурсе.

&Пластилин
Перем ВремяЖурналов; // ВремяЖурналов - перевод времени в метки OpenTelemetry

Перем Телеметрия; // ТелеметрияЖурналов - провайдеры телеметрии данных
Перем ИмяСервисаДанных; // Строка - service.name записей сеансов
Перем ЛоггерыБаз; // Соответствие: имя базы -> ОтелЛоггер

#Область ПрограммныйИнтерфейс

// Записывает сеансы снимка кластера записями лога: время записи - момент снимка, атрибуты - атрибуты сеанса,
// кроме базы (v8.infobase.name - атрибут ресурса записи).
// Недоступный снимок ничего не пишет.
//
// Параметры:
//   Снимок - Структура - снимок кластера:
//     * Время - Дата - момент снятия, универсальное время
//     * Доступен - Булево - опрос удался целиком
//     * Сеансы - Массив из Структура - сеансы:
//       ** Атрибуты - Соответствие: Строка -> Строка, Число, Булево - атрибуты сеанса
//
Процедура Записать(Снимок) Экспорт

	Если НЕ Снимок.Доступен Тогда
		Возврат;
	КонецЕсли;

	Время = ВремяЖурналов.ВНаносекунды(Снимок.Время, 0, "Etc/UTC");
	Для Каждого Сеанс Из Снимок.Сеансы Цикл
		ЗаписатьСеанс(Сеанс.Атрибуты, Время);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаписатьСеанс(Атрибуты, Время)

	Логгер = Логгер(Атрибуты["v8.infobase.name"]);
	ЗаписьЛога = Логгер.СоздатьЗаписьЛога();
	ЗаписьЛога.УстановитьВремя(Время);
	ЗаписьЛога.УстановитьСерьезность(ОтелСтепеньСерьезности.Info());
	ЗаписьЛога.УстановитьТело(Тело(Атрибуты));
	// База - только в ресурсе: в Loki ключ метаданных совпал бы с меткой потока v8_infobase_name
	Для Каждого Атрибут Из Атрибуты Цикл
		Если Атрибут.Ключ <> "v8.infobase.name" Тогда
			ЗаписьЛога.УстановитьАтрибут(Атрибут.Ключ, Атрибут.Значение);
		КонецЕсли;
	КонецЦикла;

	Логгер.Записать(ЗаписьЛога, Новый Соответствие);

КонецПроцедуры

Функция Логгер(ИмяБазы)

	Ключ = ?(ИмяБазы = Неопределено, "", ИмяБазы);
	Логгер = ЛоггерыБаз[Ключ];
	Если Логгер = Неопределено Тогда
		Провайдеры = Телеметрия.ДляСервиса(ИмяСервисаДанных, Ключ);
		Логгер = Провайдеры.ПровайдерЛогирования.ПолучитьЛоггер("opentelemetry-v8-logs.cluster");
		ЛоггерыБаз.Вставить(Ключ, Логгер);
	КонецЕсли;

	Возврат Логгер;

КонецФункции

// Тело: "Сеанс <номер> <приложение> <пользователь>", пустые части пропускаются
Функция Тело(Атрибуты)

	Части = Новый Массив;
	Части.Добавить("Сеанс");
	Номер = Атрибуты["v8.session.id"];
	Если Номер <> Неопределено Тогда
		Части.Добавить(Формат(Номер, "ЧН=0; ЧГ=0"));
	КонецЕсли;
	ДобавитьЧасть(Части, Атрибуты["v8.session.app_id"]);
	ДобавитьЧасть(Части, Атрибуты["user.name"]);

	Возврат СтрСоединить(Части, " ");

КонецФункции

Процедура ДобавитьЧасть(Части, Значение)
	Если ЗначениеЗаполнено(Значение) Тогда
		Части.Добавить(Значение);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

// Параметры:
//   НоваяТелеметрия - ТелеметрияЖурналов - провайдеры телеметрии данных
//   ИмяСервиса - Строка - service.name записей сеансов; пустая строка - имя по умолчанию
//
&Желудь
&Характер("Компанейский")
Процедура ПриСозданииОбъекта(&Блестяшка НоваяТелеметрия, &Блестяшка ИмяСервиса)
	Телеметрия = НоваяТелеметрия;
	ИмяСервисаДанных = ИмяСервиса;
	ЛоггерыБаз = Новый Соответствие;
КонецПроцедуры
