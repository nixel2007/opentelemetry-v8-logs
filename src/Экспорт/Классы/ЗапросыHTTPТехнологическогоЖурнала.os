#native
#Использовать opentelemetry
#Использовать autumn-opentelemetry

// HTTP-запрос из пары событий VRSREQUEST и VRSRESPONSE технологического журнала: атрибуты HTTP-сервера
// по семантическим соглашениям и маршрут низкой кардинальности v8.http.route.
//
// Шаблона маршрута в журнале нет, поэтому маршрут строится из публикации (путь заголовка 1C-BaseLocation)
// и вида сервиса (первый сегмент URI):
// - HTTP-сервис (hs) - шаблон из настройки otel.v8-logs.http.routes, без совпадения - /hs/{корень}/*;
// - веб-сервис (ws) - путь описания из 1C-OriginalLocation и операция из заголовка SOAPAction;
// - OData - имя сущности без ключа;
// - клиентский протокол (e1cib) - не больше двух сегментов после e1cib;
// - статика клиента (e1csys) - группа ресурсов без имени файла: /e1csys/basic/*;
// - прочие адреса - /*.

Перем ШаблоныМаршрутов; // Массив из Структура("Шаблон, Сегменты") - шаблоны HTTP-сервисов из настройки
Перем ИзвестныеМетоды; // Соответствие - метод HTTP из семантических соглашений -> Истина
Перем Пропагаторы; // ОтелКомпозитныйПропагатор, ОтелНоопПропагатор - пропагаторы SDK из otel.propagators

#Область ПрограммныйИнтерфейс

// Атрибуты HTTP-сервера по семантическим соглашениям и маршрут v8.http.route.
//
// Параметры:
//   СвойстваЗапроса - Соответствие - свойства события VRSREQUEST
//   СвойстваОтвета - Соответствие, Неопределено - свойства события VRSRESPONSE; Неопределено - ответа нет
//
// Возвращаемое значение:
//   Соответствие - ключ атрибута -> значение
//
Функция АтрибутыЗапроса(СвойстваЗапроса, СвойстваОтвета) Экспорт

	Атрибуты = Новый Соответствие;
	Заголовки = Заголовки(СвойстваЗапроса);

	ДобавитьМетод(Атрибуты, СтроковоеСвойство(СвойстваЗапроса, "Method"));

	URI = СтроковоеСвойство(СвойстваЗапроса, "URI");
	Атрибуты.Вставить("url.path", ПутьURI(URI));
	Позиция = СтрНайти(URI, "?");
	Если Позиция > 0 И Позиция < СтрДлина(URI) Тогда
		Атрибуты.Вставить("url.query", Сред(URI, Позиция + 1));
	КонецЕсли;

	Схема = НРег(СхемаАдреса(Заголовки["1c-originallocation"]));
	Если Схема = "http" ИЛИ Схема = "https" Тогда
		Атрибуты.Вставить("url.scheme", Схема);
	КонецЕсли;

	ДобавитьАдресСервера(Атрибуты, Заголовки["host"]);

	Клиент = Заголовки["x-forwarded-for"];
	Если ЗначениеЗаполнено(Клиент) Тогда
		Атрибуты.Вставить("client.address", СокрЛП(СтрРазделить(Клиент, ",")[0]));
	КонецЕсли;

	Агент = Заголовки["user-agent"];
	Если ЗначениеЗаполнено(Агент) Тогда
		Атрибуты.Вставить("user_agent.original", Агент);
	КонецЕсли;

	ДобавитьСтатус(Атрибуты, СвойстваОтвета);

	Атрибуты.Вставить("v8.http.route", МаршрутПоЗаголовкам(URI, Заголовки));

	Возврат Атрибуты;

КонецФункции

// Маршрут низкой кардинальности: публикация и маршрут внутри нее.
//
// Параметры:
//   СвойстваЗапроса - Соответствие - свойства события VRSREQUEST
//
// Возвращаемое значение:
//   Строка - маршрут, например /vrsmin/hs/mini/*
//
Функция Маршрут(СвойстваЗапроса) Экспорт
	Возврат МаршрутПоЗаголовкам(СтроковоеСвойство(СвойстваЗапроса, "URI"), Заголовки(СвойстваЗапроса));
КонецФункции

// Контекст спана вызывающей стороны из заголовков запроса: веб-сервер передает заголовки клиента
// в VRSREQUEST без изменений. Заголовки разбирают пропагаторы SDK (otel.propagators, по умолчанию
// tracecontext - заголовок traceparent W3C Trace Context).
//
// Параметры:
//   СвойстваЗапроса - Соответствие - свойства события VRSREQUEST
//
// Возвращаемое значение:
//   ОтелКонтекстСпана, Неопределено - удаленный контекст спана; Неопределено - заголовков нет или они неверны
//
Функция КонтекстВызывающего(СвойстваЗапроса) Экспорт
	// Базовый контекст пустой: запрос обработан другим процессом, текущий контекст коллектора
	// к нему не относится. Неверный заголовок пропагатор пропускает: в контексте не будет спана
	Спан = ОтелКонтекст.СпанИзКонтекста(Пропагаторы.Извлечь(Новый Соответствие, Заголовки(СвойстваЗапроса)));
	Если Спан = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	КонтекстСпана = Спан.КонтекстСпана();
	Возврат ?(КонтекстСпана.Валиден(), КонтекстСпана, Неопределено);
КонецФункции

// Добавляет шаблоны маршрутов HTTP-сервисов.
//
// Параметры:
//   Шаблоны - Строка, Массив из Строка - шаблоны /hs/{корень}{шаблон метода} через запятую,
//     например /hs/dt/download/{ID}: {параметр} - любой один сегмент, * - остаток пути;
//     настройка otel.v8-logs.http.routes
//
Процедура ДобавитьШаблоныМаршрутов(Шаблоны) Экспорт
	Если ТипЗнч(Шаблоны) = Тип("Строка") Тогда
		Значения = СтрРазделить(Шаблоны, ",", Ложь);
	ИначеЕсли Шаблоны = Неопределено Тогда
		Значения = Новый Массив;
	Иначе
		Значения = Шаблоны;
	КонецЕсли;
	Для Каждого Значение Из Значения Цикл
		Шаблон = СокрЛП(Значение);
		Если ЗначениеЗаполнено(Шаблон) Тогда
			ШаблоныМаршрутов.Добавить(Новый Структура("Шаблон, Сегменты", Шаблон, СтрРазделить(Шаблон, "/", Ложь)));
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция МаршрутПоЗаголовкам(URI, Заголовки)
	Публикация = ПутьАдреса(Заголовки["1c-baselocation"]);
	Если Публикация = "/" Тогда
		Публикация = "";
	ИначеЕсли СтрЗаканчиваетсяНа(Публикация, "/") Тогда
		Публикация = Лев(Публикация, СтрДлина(Публикация) - 1);
	КонецЕсли;
	Возврат Публикация + МаршрутВПубликации(ПутьURI(URI), Заголовки, Публикация);
КонецФункции

Функция МаршрутВПубликации(Путь, Заголовки, Публикация)

	Сегменты = СтрРазделить(Путь, "/", Ложь);
	Если Сегменты.Количество() = 0 Тогда
		Возврат "/*";
	КонецЕсли;

	Вид = НРег(Сегменты[0]);
	Если Вид = "hs" Тогда
		Возврат МаршрутHTTPСервиса(Сегменты);
	ИначеЕсли Вид = "ws" Тогда
		Возврат МаршрутВебСервиса(Сегменты, Заголовки, Публикация);
	ИначеЕсли Вид = "odata" Тогда
		Возврат МаршрутOData(Сегменты);
	ИначеЕсли Вид = "e1cib" Тогда
		Возврат "/" + СтрСоединить(ПервыеСегменты(Сегменты, 3), "/");
	ИначеЕсли Вид = "e1csys" Тогда
		// Группы ресурсов задает платформа (basic, backend...), файлов в группе - сотни
		Если Сегменты.Количество() > 2 Тогда
			Возврат "/e1csys/" + Сегменты[1] + "/*";
		КонецЕсли;
		Возврат "/e1csys/*";
	КонецЕсли;

	Возврат "/*";

КонецФункции

Функция МаршрутHTTPСервиса(Сегменты)
	Для Каждого Шаблон Из ШаблоныМаршрутов Цикл
		Если ПодходитПодШаблон(Сегменты, Шаблон.Сегменты) Тогда
			Возврат Шаблон.Шаблон;
		КонецЕсли;
	КонецЦикла;
	Если Сегменты.Количество() < 2 Тогда
		Возврат "/hs/*";
	КонецЕсли;
	Возврат "/hs/" + Сегменты[1] + "/*";
КонецФункции

Функция ПодходитПодШаблон(Сегменты, СегментыШаблона)
	Количество = Сегменты.Количество();
	Для Индекс = 0 По СегментыШаблона.ВГраница() Цикл
		СегментШаблона = СегментыШаблона[Индекс];
		Если СегментШаблона = "*" Тогда
			Возврат Истина;
		КонецЕсли;
		Если Индекс >= Количество Тогда
			Возврат Ложь;
		КонецЕсли;
		Параметр = СтрНачинаетсяС(СегментШаблона, "{") И СтрЗаканчиваетсяНа(СегментШаблона, "}");
		Если НЕ Параметр И НРег(СегментШаблона) <> НРег(Сегменты[Индекс]) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Количество = СегментыШаблона.Количество();
КонецФункции

// Маршрут веб-сервиса. IIS передает в URI адрес, который прислал клиент, а путь описания сервиса (.1cws) -
// в заголовке 1C-OriginalLocation, поэтому путь берется из заголовка, если он есть.
//
Функция МаршрутВебСервиса(Сегменты, Заголовки, Публикация)

	СегментыСервиса = Сегменты;
	ИсходныйПуть = ПутьАдреса(Заголовки["1c-originallocation"]);
	Если ЗначениеЗаполнено(ИсходныйПуть) И СтрНачинаетсяС(НРег(ИсходныйПуть), НРег(Публикация) + "/") Тогда
		СегментыИсходного = СтрРазделить(Сред(ИсходныйПуть, СтрДлина(Публикация) + 1), "/", Ложь);
		Если СегментыИсходного.Количество() >= 2 И НРег(СегментыИсходного[0]) = "ws" Тогда
			СегментыСервиса = СегментыИсходного;
		КонецЕсли;
	КонецЕсли;

	Маршрут = "/" + СтрСоединить(ПервыеСегменты(СегментыСервиса, 2), "/");
	Если СегментыСервиса.Количество() < 2 Тогда
		Маршрут = Маршрут + "/*";
	КонецЕсли;

	Операция = ОперацияSOAP(Заголовки["soapaction"]);
	Если ЗначениеЗаполнено(Операция) Тогда
		Маршрут = Маршрут + "/" + Операция;
	КонецЕсли;

	Возврат Маршрут;

КонецФункции

// Операция из заголовка SOAPAction вида "{пространство имен}#{сервис}:{операция}".
//
Функция ОперацияSOAP(Действие)
	Если НЕ ЗначениеЗаполнено(Действие) Тогда
		Возврат "";
	КонецЕсли;
	Значение = СокрЛП(СтрЗаменить(Действие, """", ""));
	Позиция = СтрНайти(Значение, ":", НаправлениеПоиска.СКонца);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Операция = Сред(Значение, Позиция + 1);
	// Двоеточие схемы адреса пространства имен без операции: http://...
	Если СтрНачинаетсяС(Операция, "/") Тогда
		Возврат "";
	КонецЕсли;
	Возврат Операция;
КонецФункции

Функция МаршрутOData(Сегменты)
	Части = ПервыеСегменты(Сегменты, 3);
	Если Части.Количество() = 3 Тогда
		Сущность = Части[2];
		Позиция = СтрНайти(Сущность, "(");
		Если Позиция > 0 Тогда
			Части[2] = Лев(Сущность, Позиция - 1);
		КонецЕсли;
	КонецЕсли;
	Возврат "/" + СтрСоединить(Части, "/");
КонецФункции

Функция ПервыеСегменты(Сегменты, Количество)
	Результат = Новый Массив;
	Для Индекс = 0 По Мин(Количество, Сегменты.Количество()) - 1 Цикл
		Результат.Добавить(Сегменты[Индекс]);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура ДобавитьМетод(Атрибуты, Метод)
	Если НЕ ЗначениеЗаполнено(Метод) Тогда
		Возврат;
	КонецЕсли;
	Если ИзвестныеМетоды[Метод] = Истина Тогда
		Атрибуты.Вставить("http.request.method", Метод);
	Иначе
		Атрибуты.Вставить("http.request.method", "_OTHER");
		Атрибуты.Вставить("http.request.method_original", Метод);
	КонецЕсли;
КонецПроцедуры

Процедура ДобавитьАдресСервера(Атрибуты, Хост)

	Если НЕ ЗначениеЗаполнено(Хост) Тогда
		Возврат;
	КонецЕсли;

	Адрес = Хост;
	Порт = "";
	Если СтрНачинаетсяС(Хост, "[") Тогда
		// IPv6: [::1]:8080
		Конец = СтрНайти(Хост, "]");
		Если Конец > 0 Тогда
			Адрес = Сред(Хост, 2, Конец - 2);
			Если Сред(Хост, Конец + 1, 1) = ":" Тогда
				Порт = Сред(Хост, Конец + 2);
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли СтрЧислоВхождений(Хост, ":") = 1 Тогда
		Позиция = СтрНайти(Хост, ":");
		Адрес = Лев(Хост, Позиция - 1);
		Порт = Сред(Хост, Позиция + 1);
	КонецЕсли;

	Атрибуты.Вставить("server.address", Адрес);
	Если ЭтоЧисло(Порт) Тогда
		Атрибуты.Вставить("server.port", Число(Порт));
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьСтатус(Атрибуты, СвойстваОтвета)
	Если СвойстваОтвета = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Статус = СтроковоеСвойство(СвойстваОтвета, "Status");
	Если НЕ ЭтоЧисло(Статус) Тогда
		Возврат;
	КонецЕсли;
	Код = Число(Статус);
	Атрибуты.Вставить("http.response.status_code", Код);
	// По семантическим соглашениям HTTP-сервера ошибка - только 5xx
	Если Код >= 500 Тогда
		Атрибуты.Вставить("error.type", Статус);
	КонецЕсли;
КонецПроцедуры

// Заголовки из свойства Headers: имя в нижнем регистре -> значение первого заголовка с этим именем.
//
Функция Заголовки(Свойства)
	Результат = Новый Соответствие;
	Для Каждого Строка Из СтрРазделить(СтроковоеСвойство(Свойства, "Headers"), Символы.ПС, Ложь) Цикл
		Позиция = СтрНайти(Строка, ":");
		Если Позиция < 2 Тогда
			Продолжить;
		КонецЕсли;
		Имя = НРег(СокрЛП(Лев(Строка, Позиция - 1)));
		Если Результат[Имя] = Неопределено Тогда
			Результат.Вставить(Имя, СокрЛП(Сред(Строка, Позиция + 1)));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ПутьURI(URI)
	Позиция = СтрНайти(URI, "?");
	Возврат ?(Позиция = 0, URI, Лев(URI, Позиция - 1));
КонецФункции

Функция СхемаАдреса(Адрес)
	Если НЕ ЗначениеЗаполнено(Адрес) Тогда
		Возврат "";
	КонецЕсли;
	Позиция = СтрНайти(Адрес, "://");
	Возврат ?(Позиция = 0, "", Лев(Адрес, Позиция - 1));
КонецФункции

// Путь адреса без схемы, хоста и параметров. У адреса тонкого клиента e1c://server/{хост}/{база}
// хостом считается и сегмент server.
//
Функция ПутьАдреса(Адрес)

	Если НЕ ЗначениеЗаполнено(Адрес) Тогда
		Возврат "";
	КонецЕсли;

	Схема = СхемаАдреса(Адрес);
	Остаток = ?(ЗначениеЗаполнено(Схема), Сред(Адрес, СтрДлина(Схема) + 4), Адрес);
	Сегменты = СтрРазделить(ПутьURI(Остаток), "/");

	ПервыйСегментПути = 1;
	Если НРег(Схема) = "e1c" И Сегменты.Количество() > 1 И НРег(Сегменты[0]) = "server" Тогда
		ПервыйСегментПути = 2;
	ИначеЕсли НЕ ЗначениеЗаполнено(Схема) Тогда
		ПервыйСегментПути = 0;
	КонецЕсли;

	Части = Новый Массив;
	Для Индекс = ПервыйСегментПути По Сегменты.ВГраница() Цикл
		Части.Добавить(Сегменты[Индекс]);
	КонецЦикла;
	Путь = СтрСоединить(Части, "/");
	Возврат ?(СтрНачинаетсяС(Путь, "/"), Путь, "/" + Путь);

КонецФункции

Функция ЭтоЧисло(Значение)
	Если НЕ ЗначениеЗаполнено(Значение) ИЛИ СтрДлина(Значение) > 9 Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Если СтрНайти("0123456789", Сред(Значение, Индекс, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция СтроковоеСвойство(Свойства, Имя)
	Значение = Свойства[Имя];
	Возврат ?(ТипЗнч(Значение) = Тип("Строка"), Значение, "");
КонецФункции

#КонецОбласти

// Параметры:
//   ШаблоныНастройки - Строка, Массив из Строка - настройка otel.v8-logs.http.routes,
//     см. ДобавитьШаблоныМаршрутов
//   ОтелSdk - ОтелSdk - SDK OpenTelemetry из настроек otel: его пропагаторы разбирают заголовки вызывающего
//
&Желудь
Процедура ПриСозданииОбъекта(
	&Деталька(Значение = "otel.v8-logs.http.routes", ЗначениеПоУмолчанию = "") ШаблоныНастройки,
	&Пластилин ОтелSdk)

	ИзвестныеМетоды = Новый Соответствие;
	Для Каждого Метод Из СтрРазделить("CONNECT,DELETE,GET,HEAD,OPTIONS,PATCH,POST,PUT,QUERY,TRACE", ",") Цикл
		ИзвестныеМетоды.Вставить(Метод, Истина);
	КонецЦикла;

	ШаблоныМаршрутов = Новый Массив;
	ДобавитьШаблоныМаршрутов(ШаблоныНастройки);
	Пропагаторы = ОтелSdk.Пропагаторы();

КонецПроцедуры
