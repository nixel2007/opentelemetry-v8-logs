#native

// Атрибуты события технологического журнала. Раскладываются в одном месте и один раз на событие:
// запись лога и спан события несут один и тот же набор атрибутов.

&Пластилин
Перем РазборКонтекстаТехнологическогоЖурнала; // РазборКонтекстаТехнологическогоЖурнала - место в коде из Context

&Пластилин
Перем ОграничениеРазмеровТелеметрии; // ОграничениеРазмеровТелеметрии - лимиты значений атрибутов

Перем СистемыБаз; // Соответствие: имя события СУБД -> db.system.name
Перем АтрибутыСвойств; // Соответствие: свойство события -> атрибут семантических соглашений с тем же значением
Перем СвойстваИсключения; // Соответствие: свойство EXCP, значение которого записывает атрибут исключения -> Истина
Перем ШаблонЧисла; // РегулярноеВыражение - целое неотрицательное число, не больше 18 цифр (в пределах int64)
Перем ШаблонУровняОшибки; // РегулярноеВыражение - начало уровня цепочки ошибок Descr «<GUID>: »
Перем ШаблонГраницыТекстаОшибки; // РегулярноеВыражение - конец текста уровня цепочки ошибок Descr
Перем ИменаСекретныхСвойств; // Массив из Строка - свойства, в которых бывают секреты: Headers, URI, url.query
Перем СекретныеЗаголовки; // Соответствие - имя заголовка в нижнем регистре -> Истина
Перем СекретныеПараметры; // Соответствие - имя параметра запроса в нижнем регистре -> Истина
Перем ЧастиСекретногоЗаголовка; // Массив из Строка - фрагменты имени заголовка в нижнем регистре

#Область ПрограммныйИнтерфейс

// Атрибуты события: имя, длительность и уровень события, процесс и файл журнала, пользователь, компьютер и сеанс,
// место в коде code.*, свойства события с префиксом v8.techlog., у событий СУБД - атрибуты семантических
// соглашений db.* и server.*. Значения ограничены по размеру, обрезанные ключи перечислены
// в v8.techlog.truncation.attributes, см. ОграничениеРазмеровТелеметрии.
//
// Параметры:
//   Событие - Структура - событие, см. СобытияТехнологическогоЖурнала.НовоеСобытие
//   ОписаниеФайла - Структура - описание файла журнала: Путь, Процесс, ИдПроцесса
//   ВозвращенныеСтрокиВключены - Булево - записывать db.response.returned_rows у событий СУБД
//     (в семантических соглашениях атрибут Opt-In)
//   ИдСеансаВключен - Булево - записывать session.id (в семантических соглашениях атрибут Opt-In)
//   ПропускатьДубли - Булево - не записывать v8.techlog.<свойство>, значение которого целиком
//     записано атрибутом семантических соглашений (Usr - user.name, Context - code.stacktrace и т.д.)
//   Обрезки - Массив, Неопределено - выходной: дополняется обрезанными атрибутами,
//     см. ОграничениеРазмеровТелеметрии.ОграничитьАтрибуты
//
// Возвращаемое значение:
//   Соответствие - ключ атрибута -> значение
//
// BSLLS:NumberOfOptionalParams-off
Функция АтрибутыСобытия(Событие, ОписаниеФайла, ВозвращенныеСтрокиВключены = Истина, ИдСеансаВключен = Истина,
	ПропускатьДубли = Истина, Обрезки = Неопределено) Экспорт
	// BSLLS:NumberOfOptionalParams-on

	Атрибуты = Новый Соответствие;
	Атрибуты.Вставить("v8.techlog.event.name", Событие.Имя);
	Атрибуты.Вставить("v8.techlog.duration", Событие.Длительность);
	Атрибуты.Вставить("v8.techlog.depth", Событие.Уровень);
	ДобавитьАтрибутыФайла(Атрибуты, ОписаниеФайла);

	Пользователь = СтроковоеСвойство(Событие.Свойства, "Usr");
	Если ЗначениеЗаполнено(Пользователь) Тогда
		Атрибуты.Вставить("user.name", Пользователь);
	КонецЕсли;
	КомпьютерКлиента = СтроковоеСвойство(Событие.Свойства, "t:computerName");
	Если ЗначениеЗаполнено(КомпьютерКлиента) Тогда
		Атрибуты.Вставить("client.address", КомпьютерКлиента);
	КонецЕсли;
	ИдСеанса = СтроковоеСвойство(Событие.Свойства, "SessionID");
	Если ИдСеансаВключен И ЗначениеЗаполнено(ИдСеанса) Тогда
		Атрибуты.Вставить("session.id", ИдСеанса);
	КонецЕсли;

	СистемаБазы = СистемыБаз[Событие.Имя];
	Если СистемаБазы <> Неопределено Тогда
		Атрибуты.Вставить("db.system.name", СистемаБазы);
		ДобавитьАтрибутыАдресаБазы(Атрибуты, СтроковоеСвойство(Событие.Свойства, "DataBase"), Событие.Имя);
		Если ВозвращенныеСтрокиВключены Тогда
			ДобавитьЧислоВозвращенныхСтрок(Атрибуты, СтроковоеСвойство(Событие.Свойства, "Rows"));
		КонецЕсли;
	КонецЕсли;

	ДобавитьАтрибутыВызова(Атрибуты, Событие);
	ДобавитьТипОшибкиВызова(Атрибуты, Событие);
	ДобавитьАтрибутыКода(Атрибуты, Событие);

	Для Каждого Свойство Из Событие.Свойства Цикл
		Если ПропускатьДубли И ДублируетАтрибут(Свойство.Ключ, Атрибуты, Событие) Тогда
			Продолжить;
		КонецЕсли;
		Атрибуты.Вставить("v8.techlog." + Свойство.Ключ, Свойство.Значение);
	КонецЦикла;

	ОграничитьРазмеры(Атрибуты, Обрезки);

	Возврат Атрибуты;

КонецФункции

// Истина, если среди свойств есть Headers, URI или url.query: их значения могут содержать секрет.
//
// Параметры:
//   Свойства - Соответствие - свойства события
//
// Возвращаемое значение:
//   Булево - Истина, если секрет нужно скрыть
//
Функция ЕстьСекреты(Свойства) Экспорт
	Для Каждого Имя Из ИменаСекретныхСвойств Цикл
		Если Свойства[Имя] <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Заменяет секреты в свойствах Headers, URI и url.query и в тех же значениях текста события.
// Имя заголовка и имя параметра остаются, значение становится ***.
//
// Параметры:
//   Событие - Структура - событие, см. СобытияТехнологическогоЖурнала.НовоеСобытие; свойства и текст меняются
//   ЗначенияВТексте - Массив из Структура - значения свойств в тексте: Ключ, Начало, Длина,
//     см. ПарсерТехнологическогоЖурнала.ЗначенияВТексте
//   ФорматJSON - Булево - текст события в формате JSON
//
Процедура СкрытьСекреты(Событие, ЗначенияВТексте, ФорматJSON) Экспорт
	СкрытьСекретыСвойств(Событие.Свойства);
	СкрытьСекретыТекста(Событие, ЗначенияВТексте, ФорматJSON);
КонецПроцедуры

// Атрибуты исключения EXCP по семантическим соглашениям exceptions: exception.type из свойства
// Exception, exception.message - текст первого уровня цепочки ошибок свойства Descr,
// exception.stacktrace - Descr целиком. См. «Исключения» в документации телеметрии. Без свойства
// атрибута нет. Значения ограничены по размеру, как у АтрибутыСобытия.
//
// Параметры:
//   Событие - Структура - событие EXCP, см. СобытияТехнологическогоЖурнала.НовоеСобытие
//   Обрезки - Массив, Неопределено - выходной: дополняется обрезанными атрибутами,
//     см. ОграничениеРазмеровТелеметрии.ОграничитьАтрибуты
//
// Возвращаемое значение:
//   Соответствие - ключ атрибута -> значение
//
Функция АтрибутыИсключения(Событие, Обрезки = Неопределено) Экспорт

	Атрибуты = Новый Соответствие;
	ТипИсключения = СтроковоеСвойство(Событие.Свойства, "Exception");
	Если НЕ ПустаяСтрока(ТипИсключения) Тогда
		Атрибуты.Вставить("exception.type", ТипИсключения);
	КонецЕсли;
	Описание = СтроковоеСвойство(Событие.Свойства, "Descr");
	Если НЕ ПустаяСтрока(Описание) Тогда
		Атрибуты.Вставить("exception.message", ТекстИсключения(Описание));
		Атрибуты.Вставить("exception.stacktrace", Описание);
	КонецЕсли;
	ОграничитьРазмеры(Атрибуты, Обрезки);
	Возврат Атрибуты;

КонецФункции

// Атрибуты процесса и файла журнала: у синтетических спанов, которым не соответствует событие, -
// единственные атрибуты события.
//
// Параметры:
//   Атрибуты - Соответствие - ключ атрибута -> значение, дополняется
//   ОписаниеФайла - Структура - описание файла журнала: Путь, Процесс, ИдПроцесса
//
Процедура ДобавитьАтрибутыФайла(Атрибуты, ОписаниеФайла) Экспорт
	Если ЗначениеЗаполнено(ОписаниеФайла.Процесс) Тогда
		Атрибуты.Вставить("process.executable.name", ОписаниеФайла.Процесс);
	КонецЕсли;
	Если ЗначениеЗаполнено(ОписаниеФайла.ИдПроцесса) Тогда
		Атрибуты.Вставить("process.pid", Число(ОписаниеФайла.ИдПроцесса));
	КонецЕсли;
	// По пути файла и времени окончания спан находится в логах, даже если запись лога с ним не связана
	Если ОписаниеФайла.Свойство("Путь") Тогда
		Атрибуты.Вставить("log.file.path", ОписаниеФайла.Путь);
		Атрибуты.Вставить("log.file.name", Новый Файл(ОписаниеФайла.Путь).Имя);
	КонецЕсли;
КонецПроцедуры

// Исключение, с которым завершился вызов и которое ушло клиенту: свойство RetExcp. У исключения (EXCP)
// ошибку описывают его собственные свойства, поэтому RetExcp не учитывается.
//
// Параметры:
//   Событие - Структура - событие, см. СобытияТехнологическогоЖурнала.НовоеСобытие
//
// Возвращаемое значение:
//   Строка - текст исключения; пустая строка - вызов завершился без исключения или событие - EXCP
//
Функция ИсключениеВызова(Событие) Экспорт
	Если Событие.Имя = "EXCP" Тогда
		Возврат "";
	КонецЕсли;
	Возврат СтроковоеСвойство(Событие.Свойства, "RetExcp");
КонецФункции

// Проверяет, что событие - обращение к СУБД.
//
// Параметры:
//   ИмяСобытия - Строка - имя события
//
// Возвращаемое значение:
//   Булево - Истина для DBMSSQL, DBPOSTGRS, DBORACLE, DB2 и DBV8DBEng
//
Функция ЭтоСобытиеСУБД(ИмяСобытия) Экспорт
	Возврат СистемыБаз[ИмяСобытия] <> Неопределено;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Свойство DataBase события СУБД - <сервер>\<база>, у файловой базы - только база.
// Разделитель - последний \. У SQL Server сервер бывает именованным экземпляром <сервер>\<экземпляр>:
// экземпляр входит в db.namespace как {экземпляр}|{база}. Порт из сервера не выделяется.
// У Oracle база 1С - схема данных, а db.namespace по семантическим соглашениям - уникальный
// идентификатор базы Oracle (DB_UNIQUE_NAME), которого в журнале нет: db.namespace не заполняется.
//
// Параметры:
//   Атрибуты - Соответствие - ключ атрибута -> значение, дополняется
//   АдресБазы - Строка - значение свойства DataBase; пустая строка - свойства нет
//   ИмяСобытия - Строка - имя события СУБД
//
Процедура ДобавитьАтрибутыАдресаБазы(Атрибуты, АдресБазы, ИмяСобытия)

	Сервер = "";
	База = АдресБазы;
	Разделитель = СтрНайти(АдресБазы, "\", НаправлениеПоиска.СКонца);
	Если Разделитель > 0 Тогда
		Сервер = Лев(АдресБазы, Разделитель - 1);
		База = Сред(АдресБазы, Разделитель + 1);
	КонецЕсли;

	РазделительЭкземпляра = СтрНайти(Сервер, "\");
	Если ИмяСобытия = "DBMSSQL" И РазделительЭкземпляра > 0 Тогда
		База = Сред(Сервер, РазделительЭкземпляра + 1) + "|" + База;
		Сервер = Лев(Сервер, РазделительЭкземпляра - 1);
	КонецЕсли;

	Если НЕ ПустаяСтрока(Сервер) Тогда
		Атрибуты.Вставить("server.address", Сервер);
	КонецЕсли;
	Если НЕ ПустаяСтрока(База) И ИмяСобытия <> "DBORACLE" Тогда
		Атрибуты.Вставить("db.namespace", База);
	КонецЕсли;

КонецПроцедуры

// Свойство Rows события СУБД - число строк результата запроса; у изменяющих запросов его нет,
// изменённые строки - в RowsAffected.
//
// Параметры:
//   Атрибуты - Соответствие - ключ атрибута -> значение, дополняется
//   Строки - Строка - значение свойства Rows; пустая строка - свойства нет
//
Процедура ДобавитьЧислоВозвращенныхСтрок(Атрибуты, Строки)
	Если ШаблонЧисла.Совпадает(Строки) Тогда
		Атрибуты.Вставить("db.response.returned_rows", Число(Строки));
	КонецЕсли;
КонецПроцедуры

// Вызов по семантическим соглашениям RPC: у входящего (CALL) и исходящего (SCALL) вызова метода интерфейса
// платформы - rpc.system.name и rpc.method <интерфейс>/<метод> из IName и MName.
//
// Параметры:
//   Атрибуты - Соответствие - ключ атрибута -> значение, дополняется
//   Событие - Структура - событие, см. СобытияТехнологическогоЖурнала.НовоеСобытие
//
Процедура ДобавитьАтрибутыВызова(Атрибуты, Событие)

	Если Событие.Имя <> "CALL" И Событие.Имя <> "SCALL" Тогда
		Возврат;
	КонецЕсли;

	Интерфейс = СтроковоеСвойство(Событие.Свойства, "IName");
	Метод = СтроковоеСвойство(Событие.Свойства, "MName");
	Если ПустаяСтрока(Интерфейс) ИЛИ ПустаяСтрока(Метод) Тогда
		Возврат;
	КонецЕсли;

	Атрибуты.Вставить("rpc.system.name", "1c.v8");
	Атрибуты.Вставить("rpc.method", Интерфейс + "/" + Метод);

КонецПроцедуры

// Неудачный вызов: исключение, с которым вызов завершился и которое ушло клиенту (свойство RetExcp).
// Типа исключения в событии нет, error.type - значение семантических соглашений по умолчанию _OTHER.
//
// Параметры:
//   Атрибуты - Соответствие - ключ атрибута -> значение, дополняется
//   Событие - Структура - событие, см. СобытияТехнологическогоЖурнала.НовоеСобытие
//
Процедура ДобавитьТипОшибкиВызова(Атрибуты, Событие)
	Если ЗначениеЗаполнено(ИсключениеВызова(Событие)) Тогда
		Атрибуты.Вставить("error.type", "_OTHER");
	КонецЕсли;
КонецПроцедуры

// Место в коде по семантическим соглашениям code.*: code.stacktrace - свойство Context как есть,
// code.file.path, code.line.number и code.function.name - см. РазборКонтекстаТехнологическогоЖурнала.МестоВКоде.
// У EXCP без Context место в коде - первый кадр {Модуль(строка)} свойства Descr.
//
// Параметры:
//   Атрибуты - Соответствие - ключ атрибута -> значение, дополняется
//   Событие - Структура - событие, см. СобытияТехнологическогоЖурнала.НовоеСобытие
//
Процедура ДобавитьАтрибутыКода(Атрибуты, Событие)

	Контекст = СтроковоеСвойство(Событие.Свойства, "Context");
	Если ЗначениеЗаполнено(СокрЛП(Контекст)) Тогда
		Атрибуты.Вставить("code.stacktrace", Контекст);
		Место = РазборКонтекстаТехнологическогоЖурнала.МестоВКоде(Контекст);
	ИначеЕсли Событие.Имя = "EXCP" Тогда
		Место = РазборКонтекстаТехнологическогоЖурнала.КадрИсключения(СтроковоеСвойство(Событие.Свойства, "Descr"));
	Иначе
		Возврат;
	КонецЕсли;

	Если Место = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Атрибуты.Вставить("code.file.path", Место.Модуль);
	// Номер строки длиннее 9 цифр - не номер строки модуля, его преобразование в число переполнилось бы
	МаксимумЦифрНомераСтроки = 9;
	Если ЗначениеЗаполнено(Место.Строка) И СтрДлина(Место.Строка) <= МаксимумЦифрНомераСтроки Тогда
		Атрибуты.Вставить("code.line.number", Число(Место.Строка));
	КонецЕсли;
	Если Место.Свойство("ИмяФункции") И ЗначениеЗаполнено(Место.ИмяФункции) Тогда
		Атрибуты.Вставить("code.function.name", Место.Модуль + "." + Место.ИмяФункции);
	КонецЕсли;

КонецПроцедуры

// Текст первого уровня цепочки ошибок Descr: от первой строки «<GUID>: текст» (без нее - от начала)
// до строки следующего уровня, кадра встроенного языка, строки «ID=» или «File=» или места в коде
// платформы. Пустой текст - описание целиком.
//
// Параметры:
//   Описание - Строка - значение свойства Descr, непустое
//
// Возвращаемое значение:
//   Строка - текст исключения без пробельных символов в конце
//
Функция ТекстИсключения(Описание)

	Текст = Описание;
	Уровни = ШаблонУровняОшибки.НайтиСовпадения(Текст);
	Если Уровни.Количество() > 0 Тогда
		Текст = Сред(Текст, Уровни[0].Индекс + Уровни[0].Длина + 1);
	КонецЕсли;
	Границы = ШаблонГраницыТекстаОшибки.НайтиСовпадения(Текст);
	Если Границы.Количество() > 0 Тогда
		Текст = Лев(Текст, Границы[0].Индекс);
	КонецЕсли;
	Текст = СокрП(Текст);

	Возврат ?(ПустаяСтрока(Текст), СокрП(Описание), Текст);

КонецФункции

// Значение свойства целиком записано атрибутом семантических соглашений: атрибутом события
// или, у EXCP, атрибутом исключения (Exception - exception.type, Descr - exception.stacktrace).
//
// Параметры:
//   ИмяСвойства - Строка - имя свойства события
//   Атрибуты - Соответствие - атрибуты события семантических соглашений
//   Событие - Структура - событие, см. СобытияТехнологическогоЖурнала.НовоеСобытие
//
// Возвращаемое значение:
//   Булево - Истина, если атрибут v8.techlog.<свойство> повторил бы атрибут семантических соглашений
//
Функция ДублируетАтрибут(ИмяСвойства, Атрибуты, Событие)
	КлючАтрибута = АтрибутыСвойств[ИмяСвойства];
	Если КлючАтрибута <> Неопределено Тогда
		Возврат Атрибуты[КлючАтрибута] <> Неопределено;
	КонецЕсли;
	Если Событие.Имя = "EXCP" И СвойстваИсключения[ИмяСвойства] <> Неопределено Тогда
		Возврат НЕ ПустаяСтрока(СтроковоеСвойство(Событие.Свойства, ИмяСвойства));
	КонецЕсли;
	Возврат Ложь;
КонецФункции

// Обрезает атрибуты по лимитам и перечисляет обрезанные ключи в v8.techlog.truncation.attributes.
//
// Параметры:
//   Атрибуты - Соответствие - ключ атрибута -> значение, обрезается и дополняется
//   Обрезки - Массив, Неопределено - дополняется обрезанными атрибутами
//
Процедура ОграничитьРазмеры(Атрибуты, Обрезки)
	Обрезанные = ОграничениеРазмеровТелеметрии.ОграничитьАтрибуты(Атрибуты);
	Если Обрезанные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Ключи = Новый Массив;
	Для Каждого Обрезка Из Обрезанные Цикл
		Ключи.Добавить(Обрезка.Ключ);
		Если Обрезки <> Неопределено Тогда
			Обрезки.Добавить(Обрезка);
		КонецЕсли;
	КонецЦикла;
	Атрибуты.Вставить("v8.techlog.truncation.attributes", Ключи);
КонецПроцедуры

Процедура СкрытьСекретыСвойств(Свойства)
	Для Каждого Имя Из ИменаСекретныхСвойств Цикл
		Значение = Свойства[Имя];
		Если Значение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Свойства[Имя] = СкрытоеЗначение(Имя, Значение);
	КонецЦикла;
КонецПроцедуры

Процедура СкрытьСекретыТекста(Событие, ЗначенияВТексте, ФорматJSON)
	Фрагменты = Новый Массив;
	Для Каждого Значение Из ЗначенияВТексте Цикл
		Если НЕ СекретноеСвойство(Значение.Ключ) Тогда
			Продолжить;
		КонецЕсли;
		Фрагменты.Добавить(Значение);
	КонецЦикла;
	Для Индекс = 0 По Фрагменты.ВГраница() Цикл
		Для Следующий = Индекс + 1 По Фрагменты.ВГраница() Цикл
			Если Фрагменты[Следующий].Начало > Фрагменты[Индекс].Начало Тогда
				Фрагмент = Фрагменты[Индекс];
				Фрагменты[Индекс] = Фрагменты[Следующий];
				Фрагменты[Следующий] = Фрагмент;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Текст = Событие.Текст;
	Для Каждого Фрагмент Из Фрагменты Цикл
		Сырое = Сред(Текст, Фрагмент.Начало, Фрагмент.Длина);
		Кавычка = ?(Фрагмент.Начало > 1, Сред(Текст, Фрагмент.Начало - 1, 1), "");
		Чистое = РаскодироватьЗначение(Сырое, Кавычка, ФорматJSON);
		Скрытое = СкрытоеЗначение(Фрагмент.Ключ, Чистое);
		Если Скрытое = Чистое Тогда
			Продолжить;
		КонецЕсли;
		Текст = Лев(Текст, Фрагмент.Начало - 1) + ЗакодироватьЗначение(Скрытое, Кавычка, ФорматJSON)
			+ Сред(Текст, Фрагмент.Начало + Фрагмент.Длина);
	КонецЦикла;
	Событие.Текст = Текст;
КонецПроцедуры

Функция СкрытоеЗначение(Имя, Значение)
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(СкрытоеЗначение(Имя, Элемент));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Строка") ИЛИ ПустаяСтрока(Значение) Тогда
		Возврат Значение;
	КонецЕсли;
	Ключ = НРег(Имя);
	Если Ключ = "headers" Тогда
		Возврат СкрытыеЗаголовки(Значение);
	КонецЕсли;
	Если Ключ = "uri" Тогда
		Возврат СкрытыйURI(Значение);
	КонецЕсли;
	Если Ключ = "url.query" Тогда
		Возврат СкрытыйЗапрос(Значение);
	КонецЕсли;
	Возврат Значение;
КонецФункции

Функция СекретноеСвойство(Имя)
	Возврат НРег(Имя) = "headers" ИЛИ НРег(Имя) = "uri" ИЛИ НРег(Имя) = "url.query";
КонецФункции

Функция СкрытыеЗаголовки(Текст)
	// СтрРазделить режет по каждому символу разделителя: пара ВК+ПС дает пустую строку
	// и сбрасывает признак продолжения. Делим только по ПС, ВК возвращаем при замене.
	Строки = СтрРазделить(Текст, Символы.ПС, Истина);
	СекретноеПродолжение = Ложь;
	Для Индекс = 0 По Строки.ВГраница() Цикл
		Строка = Строки[Индекс];
		Окончание = "";
		Если СтрЗаканчиваетсяНа(Строка, Символы.ВК) Тогда
			Окончание = Символы.ВК;
			Строка = Лев(Строка, СтрДлина(Строка) - 1);
		КонецЕсли;
		Если ПустаяСтрока(Строка) Тогда
			СекретноеПродолжение = Ложь;
			Продолжить;
		КонецЕсли;
		Если СтрНачинаетсяС(Строка, " ") ИЛИ СтрНачинаетсяС(Строка, Символы.Таб) Тогда
			Если СекретноеПродолжение И НЕ ПустаяСтрока(СокрЛП(Строка)) Тогда
				Строки[Индекс] = Отступ(Строка) + "***" + Окончание;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Позиция = СтрНайти(Строка, ":");
		Если Позиция = 0 ИЛИ НЕ СекретныйЗаголовок(Лев(Строка, Позиция - 1)) Тогда
			СекретноеПродолжение = Ложь;
			Продолжить;
		КонецЕсли;
		СекретноеПродолжение = Истина;
		Строки[Индекс] = Лев(Строка, Позиция - 1) + ": ***" + Окончание;
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции

Функция Отступ(Строка)
	ОтступСтроки = "";
	Для Номер = 1 По СтрДлина(Строка) Цикл
		Символ = Сред(Строка, Номер, 1);
		Если Символ <> " " И Символ <> Символы.Таб Тогда
			Прервать;
		КонецЕсли;
		ОтступСтроки = ОтступСтроки + Символ;
	КонецЦикла;
	Возврат ОтступСтроки;
КонецФункции

Функция СекретныйЗаголовок(Имя)
	Ключ = НРег(СокрЛП(Имя));
	Если СекретныеЗаголовки[Ключ] = Истина Тогда
		Возврат Истина;
	КонецЕсли;
	Для Каждого Часть Из ЧастиСекретногоЗаголовка Цикл
		Если СтрНайти(Ключ, Часть) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция СкрытыйURI(Текст)
	Позиция = СтрНайти(Текст, "?");
	Если Позиция = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Возврат Лев(Текст, Позиция) + СкрытыйЗапрос(Сред(Текст, Позиция + 1));
КонецФункции

Функция СкрытыйЗапрос(Текст)
	Части = СтрРазделить(Текст, "&", Истина);
	Для Индекс = 0 По Части.ВГраница() Цикл
		Часть = Части[Индекс];
		Позиция = СтрНайти(Часть, "=");
		Если Позиция = 0 ИЛИ НЕ СекретныйПараметр(Лев(Часть, Позиция - 1)) Тогда
			Продолжить;
		КонецЕсли;
		Части[Индекс] = Лев(Часть, Позиция) + "***";
	КонецЦикла;
	Возврат СтрСоединить(Части, "&");
КонецФункции

// Имя сравнивается после РаскодироватьСтроку: access%5Ftoken и access_token - одно имя.
// В журнал пишется исходное написание имени.
Функция СекретныйПараметр(Имя)
	ИмяДляСравнения = РаскодироватьСтроку(Имя, СпособКодированияСтроки.КодировкаURL);
	Возврат СекретныеПараметры[НРег(ИмяДляСравнения)] = Истина;
КонецФункции

Функция РаскодироватьЗначение(Сырое, Кавычка, ФорматJSON)
	Если ФорматJSON И Кавычка = """" Тогда
		Если СтрНайти(Сырое, "\") = 0 Тогда
			Возврат Сырое;
		КонецЕсли;
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку("""" + Сырое + """");
		Чтение.Прочитать();
		Результат = Чтение.ТекущееЗначение;
		Чтение.Закрыть();
		Возврат Результат;
	КонецЕсли;
	Если Кавычка = "'" ИЛИ Кавычка = """" Тогда
		Возврат СтрЗаменить(Сырое, Кавычка + Кавычка, Кавычка);
	КонецЕсли;
	Возврат Сырое;
КонецФункции

Функция ЗакодироватьЗначение(Значение, Кавычка, ФорматJSON)
	Если ФорматJSON И Кавычка = """" Тогда
		Запись = Новый ЗаписьJSON;
		Запись.УстановитьСтроку();
		Запись.ЗаписатьЗначение(Значение);
		Строка = Запись.Закрыть();
		Возврат Сред(Строка, 2, СтрДлина(Строка) - 2);
	КонецЕсли;
	Если Кавычка = "'" ИЛИ Кавычка = """" Тогда
		Возврат СтрЗаменить(Значение, Кавычка, Кавычка + Кавычка);
	КонецЕсли;
	Возврат Значение;
КонецФункции

Функция СтроковоеСвойство(Свойства, Имя)
	Значение = Свойства[Имя];
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Возврат СтрСоединить(Значение, Символы.ПС);
	КонецЕсли;
	Возврат ?(Значение = Неопределено, "", Значение);
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта()

	АтрибутыСвойств = Новый Соответствие;
	АтрибутыСвойств.Вставить("Usr", "user.name");
	АтрибутыСвойств.Вставить("t:computerName", "client.address");
	АтрибутыСвойств.Вставить("SessionID", "session.id");
	АтрибутыСвойств.Вставить("Context", "code.stacktrace");
	АтрибутыСвойств.Вставить("Rows", "db.response.returned_rows");

	СвойстваИсключения = Новый Соответствие;
	СвойстваИсключения.Вставить("Exception", Истина);
	СвойстваИсключения.Вставить("Descr", Истина);

	СистемыБаз = Новый Соответствие;
	СистемыБаз.Вставить("DBMSSQL", "microsoft.sql_server");
	СистемыБаз.Вставить("DBPOSTGRS", "postgresql");
	СистемыБаз.Вставить("DBORACLE", "oracle.db");
	СистемыБаз.Вставить("DB2", "ibm.db2");
	// У файловой базы в semconv нет своего значения db.system.name
	СистемыБаз.Вставить("DBV8DBEng", "1c.v8dbeng");

	ШаблонЧисла = Новый РегулярноеВыражение("^[0-9]{1,18}$");

	ГУИД = "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}";
	ШаблонУровняОшибки = Новый РегулярноеВыражение("(?m)^" + ГУИД + ": ");
	ШаблонГраницыТекстаОшибки = Новый РегулярноеВыражение("(?m)^" + ГУИД + "(: |\r?$)"
		+ "|^\{[^}\n]*\(\d+\)\}:"
		+ "|^(ID|File)="
		+ "|\s*:\s*src[\\/][^\s()]*\.(cpp|h)\(\d+\)");

	ИменаСекретныхСвойств = Новый Массив;
	ИменаСекретныхСвойств.Добавить("Headers");
	ИменаСекретныхСвойств.Добавить("URI");
	ИменаСекретныхСвойств.Добавить("url.query");

	СекретныеЗаголовки = Новый Соответствие;
	СекретныеЗаголовки.Вставить("authorization", Истина);
	СекретныеЗаголовки.Вставить("cookie", Истина);
	СекретныеЗаголовки.Вставить("set-cookie", Истина);
	СекретныеЗаголовки.Вставить("proxy-authorization", Истина);

	ЧастиСекретногоЗаголовка = Новый Массив;
	ЧастиСекретногоЗаголовка.Добавить("token");
	ЧастиСекретногоЗаголовка.Добавить("api-key");
	ЧастиСекретногоЗаголовка.Добавить("secret");

	// code не маскируется: в OData и HTTP-сервисах так передают код справочника
	СекретныеПараметры = Новый Соответствие;
	СекретныеПараметры.Вставить("access_token", Истина);
	СекретныеПараметры.Вставить("token", Истина);
	СекретныеПараметры.Вставить("password", Истина);
	СекретныеПараметры.Вставить("sig", Истина);

КонецПроцедуры
