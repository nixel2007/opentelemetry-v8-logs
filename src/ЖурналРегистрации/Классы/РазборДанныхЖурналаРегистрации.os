#native

// Подтвержденные формы Data из 1С 8.3.27.2325. Порядок полей LGP отличается от СП.
// Правила сверены с C#-декодерами, разработанными в APonkratov/OneSTools.EventLog:
// https://github.com/APonkratov/OneSTools.EventLog/tree/015d838
// Неподтвержденная маска, число или тип полей сохраняются полным деревом.

Перем РегулярноеКоличество; // РегулярноеВыражение - целый неотрицательный счетчик
Перем РегулярнаяДата; // РегулярноеВыражение - четырнадцать цифр даты
Перем РегулярныйUUID; // РегулярноеВыражение - UUID в форме D

&Пластилин
Перем ПоляДанныхСобытийЖурналаРегистрации; // ПоляДанныхСобытийЖурналаРегистрации - общий словарь раскладок

#Область ПрограммныйИнтерфейс

// Разбирает сложное значение Data. Скаляр уже представлен прежним полем Данные.
//
// Параметры:
//   Событие - Строка - исходный код события
//   Узел - Массив, Строка - дерево ПарсерСкобочногоФормата
//
// Возвращаемое значение:
//   Соответствие, Неопределено - именованные поля/конверт; Неопределено для скаляра
//
Функция Разобрать(Событие, Узел) Экспорт

	Если ЭтоСкаляр(Узел) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Результат = ИзвестныеДанные(Событие, Узел);
	Если Результат = Неопределено Тогда
		Результат = Новый Соответствие;
		Результат.Вставить("$format", "1c-brackets-v1");
		Результат.Вставить("nodes", ДеревоТокенов(Узел));
	КонецЕсли;
	Возврат Результат;

КонецФункции

// JSON сложного Data без изменения существующего текстового представления.
//
// Параметры:
//   Событие - Строка - исходный код события
//   Узел - Массив, Строка - дерево скобочного парсера
//
// Возвращаемое значение:
//   Строка - JSON; пустая строка для скаляра
//
Функция СтрокаJSON(Событие, Узел) Экспорт
	Данные = Разобрать(Событие, Узел);
	Если Данные = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЭтоСкаляр(Узел)
	Если Список(Узел, 1) И Литерал(Узел[0], "U") Тогда
		Возврат Истина;
	КонецЕсли;
	Если НЕ Список(Узел, 2) ИЛИ НЕ ЭтоСтрока(Узел[0]) ИЛИ НЕ ЭтоСтрока(Узел[1]) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Узел[0] = "B" Тогда
		Возврат Узел[1] = "0" ИЛИ Узел[1] = "1";
	КонецЕсли;
	Возврат Узел[0] = "S" ИЛИ Узел[0] = "N" ИЛИ Узел[0] = "D" ИЛИ Узел[0] = "R";
КонецФункции

Функция ИзвестныеДанные(Событие, Узел)
	Если НЕ Список(Узел, 2) ИЛИ НЕ Литерал(Узел[0], "P") ИЛИ ТипЗнч(Узел[1]) <> Тип("Массив") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Тело = Узел[1];
	Описания = ПоляДанныхСобытийЖурналаРегистрации.Раскладки(Событие);
	Если Описания <> Неопределено Тогда
		Для Каждого Описание Из Описания Цикл
			Если Описание.Маска <> "" Тогда
				Если Тело.Количество() = 0 ИЛИ НЕ Литерал(Тело[0], Описание.Маска) Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			Если Описание.Обработка = "Пользователь" ИЛИ Описание.Обработка = "Позиционная" Тогда
				Результат = ПозиционнаяФорма(Узел, Описание.Имена, Описание.Типы, Описание.Обработка = "Пользователь");
			ИначеЕсли Описание.Обработка = "НастройкаАутентификации" Тогда
				Результат = НастройкиАутентификации(Тело, Описание);
			ИначеЕсли Описание.Обработка = "ПроверкаПароля" ИЛИ Описание.Обработка = "НарушениеПароля" Тогда
				Результат = ПараметрыБазы(Узел, Описание);
			Иначе
				Результат = Поля(Тело, Описание.Имена, Описание.Типы, Описание.Смещение);
			КонецЕсли;
			Если Результат <> Неопределено Тогда
				Возврат Результат;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Если Событие = "_$User$_.AuthenticationLock" ИЛИ Событие = "_$User$_.AuthenticationUnlock"
		ИЛИ Событие = "_$User$_.AuthenticationUnlockError" ИЛИ Событие = "_$Session$_.PasswordRequirementsViolationOnAuthentication"
		ИЛИ Событие = "_$InfoBase$_.SecondAuthenticationFactorTemplateNew"
		ИЛИ Событие = "_$InfoBase$_.SecondAuthenticationFactorTemplateUpdate"
		ИЛИ Событие = "_$InfoBase$_.SecondAuthenticationFactorTemplateDelete" Тогда
		Если Список(Тело, 2) И Литерал(Тело[0], "1") И Список(Тело[1], 2)
			И Литерал(Тело[1][0], "Имя") И Типизированный(Тело[1][1], "S") Тогда
			Возврат ОдноПоле("Name", Тело[1][1][1]);
		КонецЕсли;
	ИначеЕсли Событие = "_$Access$_.Access" Тогда
		Если Список(Тело, 2) И Литерал(Тело[0], "1") Тогда
			Таблица = ТаблицаДоступа(Тело[1]);
			Если Таблица <> Неопределено Тогда
				Возврат ОдноПоле("Data", Таблица);
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли Событие = "_$InfoBase$_.EventLogSettingsUpdate" ИЛИ Событие = "_$InfoBase$_.EventLogSettingsUpdateError" Тогда
		Если Список(Тело, 2) И Литерал(Тело[0], "1") И Типизированный(Тело[1], "N") Тогда
			Если Тело[1][1] = "0" Тогда
				Возврат ОдноПоле("Levels", "Примечание, Информация, Предупреждение, Ошибка");
			ИначеЕсли Тело[1][1] = "1" Тогда
				Возврат ОдноПоле("Levels", "Информация, Предупреждение, Ошибка");
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли Событие = "_$Data$_.DataHistorySettingsUpdate" ИЛИ Событие = "_$InfoBase$_.PredefinedDataUpdate"
		ИЛИ Событие = "_$Data$_.PredefinedDataInitialization" ИЛИ Событие = "_$Data$_.UpdatePredefinedData" Тогда
		Если Список(Тело, 2) И Литерал(Тело[0], "1") И Список(Тело[1], 2)
			И (Литерал(Тело[1][0], "Данные") ИЛИ Литерал(Тело[1][0], "Ссылка")) Тогда
			Таблица = ТаблицаДоступа(Тело[1][1]);
			Если Таблица <> Неопределено Тогда
				Возврат ОдноПоле("Data", Таблица);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат ИменованныеДанные(Узел);
КонецФункции

Функция ИменованныеДанные(Узел)
	Тело = Узел[1];
	Если Тело.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Количество = КоличествоИзУзла(Тело[0]);
	Если Количество = Неопределено ИЛИ Количество = 0 ИЛИ Количество + 1 <> Тело.Количество() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Значения = Новый Соответствие;
	Для Индекс = 1 По Количество Цикл
		Пара = Тело[Индекс];
		Если НЕ Список(Пара, 2) ИЛИ НЕ ЭтоСтрока(Пара[0]) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Имя = Пара[0];
		Если Значения[Имя] <> Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Значение = ИменованноеЗначение(Пара[1]);
		Если Значение = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Значения.Вставить(Имя, Значение);
	КонецЦикла;
	Результат = Новый Соответствие;
	Результат.Вставить("$format", "1c-named-data-v1");
	Результат.Вставить("values", Значения);
	Результат.Вставить("nodes", ДеревоТокенов(Узел));
	Возврат Результат;
КонецФункции

Функция ИменованноеЗначение(Узел)
	Если Список(Узел, 1) И Литерал(Узел[0], "U") Тогда
		Возврат ОдноПоле("$type", "U");
	КонецЕсли;
	Если НЕ Список(Узел, 2) ИЛИ НЕ ЭтоСтрока(Узел[0]) ИЛИ НЕ ЭтоСтрока(Узел[1]) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Узел[0] = "@" ИЛИ Узел[0] = "R" Тогда
		Результат = ОдноПоле("$type", Узел[0]);
		Результат.Вставить("value", Узел[1]);
		Возврат Результат;
	КонецЕсли;
	Если Узел[0] = "S" ИЛИ Узел[0] = "N" ИЛИ Узел[0] = "B" ИЛИ Узел[0] = "D" Тогда
		Возврат ЗначениеУзла(Узел, Узел[0]);
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция Поля(Тело, Имена, Типы, Смещение = 0)
	Если НЕ Список(Тело, Имена.Количество() + Смещение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Результат = Новый Соответствие;
	Для Индекс = 0 По Имена.ВГраница() Цикл
		Узел = Тело[Индекс + Смещение];
		Вид = Сред(Типы, Индекс + 1, 1);
		Если Вид = "U" Тогда
			Если НЕ Список(Узел, 1) ИЛИ НЕ Литерал(Узел[0], "U") Тогда
				Возврат Неопределено;
			КонецЕсли;
			Значение = Неопределено;
		ИначеЕсли Вид = "A" Тогда
			Элементы = ЗначениеУзла(Узел, "T");
			Если Элементы = Неопределено Тогда
				Возврат Неопределено;
			КонецЕсли;
			Если Элементы.Количество() = 0 Тогда
				Значение = Неопределено;
			Иначе
				Значение = ОдноПоле("Item", ?(Элементы.Количество() = 1, Элементы[0], Элементы));
			КонецЕсли;
		Иначе
			Значение = ЗначениеУзла(Узел, Вид);
			Если Значение = Неопределено Тогда
				Возврат Неопределено;
			КонецЕсли;
		КонецЕсли;
		Результат.Вставить(Имена[Индекс], Значение);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ЗначениеУзла(Узел, Вид)
	Если НЕ Список(Узел, 2) ИЛИ НЕ Литерал(Узел[0], ?(Вид = "T", "A", Вид)) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Данные = Узел[1];
	Если Вид = "O" Тогда
		Если НЕ Список(Данные, 3) ИЛИ НЕ Литерал(Данные[0], "#")
			ИЛИ НЕ ЭтоUUID(Данные[1]) ИЛИ НЕ ЭтоUUID(Данные[2]) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Результат = ОдноПоле("$type", "O");
		Результат.Вставить("typeId", Данные[1]);
		Результат.Вставить("value", Данные[2]);
		Возврат Результат;
	ИначеЕсли Вид = "A" ИЛИ Вид = "T" Тогда
		Если ТипЗнч(Данные) <> Тип("Массив") ИЛИ Данные.Количество() = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Количество = КоличествоИзУзла(Данные[0]);
		Если Количество = Неопределено ИЛИ Количество + 1 <> Данные.Количество() Тогда
			Возврат Неопределено;
		КонецЕсли;
		Результат = Новый Массив;
		Для Индекс = 1 По Количество Цикл
			Значение = ЗначениеУзла(Данные[Индекс], ?(Вид = "T", "S", "O"));
			Если Значение = Неопределено Тогда
				Возврат Неопределено;
			КонецЕсли;
			Результат.Добавить(Значение);
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;
	Если НЕ ЭтоСтрока(Данные) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Вид = "S" ИЛИ Вид = "N" Тогда
		Возврат Данные;
	ИначеЕсли Вид = "B" Тогда
		Если Данные = "1" Тогда
			Возврат "true";
		ИначеЕсли Данные = "0" Тогда
			Возврат "false";
		КонецЕсли;
	ИначеЕсли Вид = "D" И СтрДлина(Данные) = 14 И РегулярнаяДата.Совпадает(Данные) Тогда
		Попытка
			Возврат Формат(Дата(Данные), "ДФ=yyyy-MM-ddTHH:mm:ss;ДП=0001-01-01T00:00:00");
		Исключение
			// Невалидная календарная дата сохраняется в дереве, без догадок.
			Возврат Неопределено;
		КонецПопытки;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция ПозиционнаяФорма(Узел, Имена, Типы, ПростойJSON = Ложь)
	Тело = Узел[1];
	Если Тело.Количество() <> Имена.Количество() + 1 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Значения = Новый Соответствие;
	Для Индекс = 0 По Имена.ВГраница() Цикл
		Если Имена[Индекс] = "Roles" Тогда
			КоличествоРолей = КоличествоРолей(Тело[Индекс + 1]);
			Если КоличествоРолей = Неопределено Тогда
				Возврат Неопределено;
			КонецЕсли;
			Значения.Вставить("RolesCount", Формат(КоличествоРолей, "ЧГ=0;ЧН=0"));
			Продолжить;
		КонецЕсли;
		Значение = ЗначениеУзла(Тело[Индекс + 1], Сред(Типы, Индекс + 1, 1));
		Если Значение = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Значения.Вставить(Имена[Индекс], Значение);
	КонецЦикла;
	Если ПростойJSON Тогда
		Возврат Значения;
	КонецЕсли;
	Возврат ПозиционныйКонверт(Узел, Значения);
КонецФункции

// Состав ролей пользователя намеренно не экспортируется: UUID не дают имен прав,
// а их копии в values и nodes формируют основной объем подробного Data.
Функция КоличествоРолей(Узел)
	Если НЕ Список(Узел, 2) ИЛИ НЕ Литерал(Узел[0], "A") ИЛИ ТипЗнч(Узел[1]) <> Тип("Массив")
		ИЛИ Узел[1].Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Данные = Узел[1];
	Количество = КоличествоИзУзла(Данные[0]);
	Если Количество = Неопределено ИЛИ Количество + 1 <> Данные.Количество() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Индекс = 1 По Количество Цикл
		Роль = Данные[Индекс];
		Если НЕ Список(Роль, 2) ИЛИ НЕ Литерал(Роль[0], "O") ИЛИ НЕ Список(Роль[1], 3)
			ИЛИ НЕ Литерал(Роль[1][0], "#") ИЛИ НЕ ЭтоUUID(Роль[1][1]) ИЛИ НЕ ЭтоUUID(Роль[1][2]) Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;
	Возврат Количество;
КонецФункции

Функция ПозиционныйКонверт(Узел, Значения)
	Результат = Новый Соответствие;
	Результат.Вставить("$format", "1c-positional-data-v1");
	Результат.Вставить("layout", "P/" + Узел[1][0]);
	Результат.Вставить("values", Значения);
	Результат.Вставить("unnamedFields", Новый Массив);
	Результат.Вставить("nodes", ДеревоТокенов(Узел));
	Возврат Результат;
КонецФункции

Функция ПараметрыБазы(Узел, Описание)
	ПроверенныеПоля = Поля(Узел[1], Описание.Имена, Описание.Типы, Описание.Смещение);
	Если ПроверенныеПоля = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Имя = Описание.Имена[0];
	Токен = ПроверенныеПоля[Имя];
	Если Описание.Обработка = "ПроверкаПароля" Тогда
		Если Токен <> "0" И Токен <> "3" Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат ПозиционныйКонверт(Узел, ОдноПоле(Имя, ?(Токен = "3", "true", "false")));
	Иначе
		Значение = ЗначениеПеречисления(Токен, "Потребовать смену пароля|Предложить смену пароля|Нет");
		Если Значение = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	Возврат ПозиционныйКонверт(Узел, ОдноПоле(Имя, Значение));
КонецФункции

Функция НастройкиАутентификации(Тело, Описание)
	Результат = Поля(Тело, Описание.Имена, Описание.Типы, 1);
	Если Результат = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Имя = Описание.Имена[0];
	Токен = Результат[Имя];
	Если Имя = "PasswordRecoveryMethod" Тогда
		Значение = ЗначениеПеречисления(Токен, "Переход по навигационной ссылке|Отправка кода подтверждения через стандартный сервис|Отправка кода подтверждения по заданным параметрам учетной записи|Нет");
	ИначеЕсли Имя = "EmailAuthenticationMethod" Тогда
		Значение = ЗначениеПеречисления(Токен, "|Отправка кода подтверждения через стандартный сервис|Отправка кода подтверждения по заданным параметрам учетной записи|Нет");
	ИначеЕсли Имя = "PasswordRecoveryTokenAuthenticationWhenSendingVerificationCode" ИЛИ Имя = "EmailAuthenticationTokenAuthenticationWhenSendingVerificationCode" Тогда
		Значение = ЗначениеПеречисления(Токен, "Не использовать|Использовать|Авто");
	Иначе
		Возврат Результат;
	КонецЕсли;
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Результат.Вставить(Имя, Значение);
	Возврат Результат;
КонецФункции

Функция ЗначениеПеречисления(Токен, СтрокаЗначений)
	Значения = СтрРазделить(СтрокаЗначений, "|", Истина);
	Для Индекс = 0 По Значения.ВГраница() Цикл
		Если Токен = Строка(Индекс) И Значения[Индекс] <> "" Тогда
			Возврат Значения[Индекс];
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция ТаблицаДоступа(Узел)
	Если НЕ Список(Узел, 2) ИЛИ НЕ Литерал(Узел[0], "Z") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Таблица = Узел[1];
	Если ТипЗнч(Таблица) <> Тип("Массив") ИЛИ Таблица.Количество() < 2 Тогда
		Возврат Неопределено;
	КонецЕсли;
	ЧислоКолонок = КоличествоИзУзла(Таблица[0]);
	ЧислоСтрок = КоличествоИзУзла(Таблица[1]);
	Если ЧислоКолонок = Неопределено ИЛИ ЧислоСтрок = Неопределено ИЛИ ЧислоКолонок = 0
		ИЛИ ЧислоКолонок + ЧислоСтрок + 2 <> Таблица.Количество() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Колонки = Новый Массив;
	Имена = Новый Массив;
	УникальныеИмена = Новый Соответствие;
	Для Индекс = 0 По ЧислоКолонок - 1 Цикл
		Колонка = Таблица[Индекс + 2];
		Если НЕ Список(Колонка, 2) ИЛИ НЕ ЭтоСтрока(Колонка[0]) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Образец = Колонка[1];
		ЭтоОбразец = Список(Образец, 1) И Литерал(Образец[0], "Pattern");
		ЭтоТипизированныйОбразец = Список(Образец, 2) И Литерал(Образец[0], "Pattern")
			И Список(Образец[1], 1) И Литерал(Образец[1][0], "S");
		Если НЕ ЭтоОбразец И НЕ ЭтоТипизированныйОбразец Тогда
			Возврат Неопределено;
		КонецЕсли;
		Имя = Колонка[0];
		Если УникальныеИмена[Имя] <> Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		УникальныеИмена.Вставить(Имя, Истина);
		Имена.Добавить(Имя);
		Колонки.Добавить(ОдноПоле("name", Имя));
	КонецЦикла;
	Строки = Новый Массив;
	Для НомерСтроки = 0 По ЧислоСтрок - 1 Цикл
		Источник = Таблица[2 + ЧислоКолонок + НомерСтроки];
		Если НЕ Список(Источник, ЧислоКолонок) Тогда
			Возврат Неопределено;
		КонецЕсли;
		СтрокаТаблицы = Новый Соответствие;
		Для НомерКолонки = 0 По ЧислоКолонок - 1 Цикл
			Если НЕ Типизированный(Источник[НомерКолонки], "S") Тогда
				Возврат Неопределено;
			КонецЕсли;
			СтрокаТаблицы.Вставить(Имена[НомерКолонки], Источник[НомерКолонки][1]);
		КонецЦикла;
		Строки.Добавить(СтрокаТаблицы);
	КонецЦикла;
	Результат = ОдноПоле("Column", ?(ЧислоКолонок = 1, Колонки[0], Колонки));
	Если ЧислоСтрок > 0 Тогда
		Результат.Вставить("Row", ?(ЧислоСтрок = 1, Строки[0], Строки));
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ДеревоТокенов(Узел)
	Если ЭтоСтрока(Узел) Тогда
		// Скобочный парсер снял удвоенные кавычки; nodes хранит исходный текст листьев.
		Возврат СтрЗаменить(Узел, """", """""");
	КонецЕсли;
	Результат = Новый Массив;
	Для Каждого Вложенный Из Узел Цикл
		Результат.Добавить(ДеревоТокенов(Вложенный));
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция КоличествоИзУзла(Узел)
	Если НЕ ЭтоСтрока(Узел) ИЛИ НЕ РегулярноеКоличество.Совпадает(Узел) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Количество = Число(Узел);
		Если Количество <= 2147483647 Тогда
			Возврат Количество;
		КонецЕсли;
	Исключение
		// Слишком большое число - неизвестная форма, без усечения.
		Возврат Неопределено;
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

Функция ЭтоСтрока(Узел)
	Возврат ТипЗнч(Узел) = Тип("Строка");
КонецФункции

Функция Список(Узел, Количество)
	Возврат ТипЗнч(Узел) = Тип("Массив") И Узел.Количество() = Количество;
КонецФункции

Функция Литерал(Узел, Текст)
	Возврат ЭтоСтрока(Узел) И Узел = Текст;
КонецФункции

Функция Типизированный(Узел, Вид)
	Возврат Список(Узел, 2) И Литерал(Узел[0], Вид) И ЭтоСтрока(Узел[1]);
КонецФункции

Функция ЭтоUUID(Узел)
	Возврат ЭтоСтрока(Узел) И СтрДлина(Узел) = 36 И РегулярныйUUID.Совпадает(Узел);
КонецФункции

Функция ОдноПоле(Имя, Значение)
	Результат = Новый Соответствие;
	Результат.Вставить(Имя, Значение);
	Возврат Результат;
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта()
	РегулярноеКоличество = Новый РегулярноеВыражение("\A[0-9]+\z");
	РегулярнаяДата = Новый РегулярноеВыражение("^[0-9]{14}$");
	РегулярныйUUID = Новый РегулярноеВыражение("^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$");
КонецПроцедуры
