#native

// Подтвержденные формы Data из 1С 8.3.27.2325. Порядок полей LGP отличается от СП.
// Правила сверены с C#-декодерами, разработанными в APonkratov/OneSTools.EventLog:
// https://github.com/APonkratov/OneSTools.EventLog/tree/015d838
// Неподтвержденная маска, число или тип полей сохраняются полным деревом.

Перем РегулярноеКоличество; // РегулярноеВыражение - целый неотрицательный счетчик
Перем РегулярнаяДата; // РегулярноеВыражение - четырнадцать цифр даты
Перем РегулярныйUUID; // РегулярноеВыражение - UUID в форме D

&Пластилин
Перем ПоляДанныхСобытийЖурналаРегистрации; // ПоляДанныхСобытийЖурналаРегистрации - общий словарь раскладок

#Область ПрограммныйИнтерфейс

// Разбирает сложное значение Data. Скаляр уже представлен прежним полем Данные.
//
// Параметры:
//   Событие - Строка - исходный код события
//   Узел - Массив, Строка - дерево ПарсерСкобочногоФормата
//
// Возвращаемое значение:
//   Соответствие, Неопределено - именованные поля/конверт; Неопределено для скаляра
//
Функция Разобрать(Событие, Узел) Экспорт

	Если ЭтоСкаляр(Узел) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = ИзвестныеДанные(Событие, Узел);
	Если Результат = Неопределено Тогда
		Результат = Новый Соответствие;
		Результат.Вставить("$format", "1c-brackets-v1");
		Результат.Вставить("nodes", ДеревоТокенов(Узел));
	КонецЕсли;

	Возврат Результат;

КонецФункции

// JSON сложного Data без изменения существующего текстового представления.
//
// Параметры:
//   Событие - Строка - исходный код события
//   Узел - Массив, Строка - дерево скобочного парсера
//
// Возвращаемое значение:
//   Строка - JSON; пустая строка для скаляра
//
Функция СтрокаJSON(Событие, Узел) Экспорт

	Данные = Разобрать(Событие, Узел);
	Если Данные = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЭтоСкаляр(Узел)

	Если Список(Узел, 1) И Литерал(Узел[0], "U") Тогда
		Возврат Истина;
	КонецЕсли;

	Если НЕ Список(Узел, 2) ИЛИ НЕ ЭтоСтрока(Узел[0]) ИЛИ НЕ ЭтоСтрока(Узел[1]) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Узел[0] = "B" Тогда
		Возврат Узел[1] = "0" ИЛИ Узел[1] = "1";
	КонецЕсли;

	Возврат Узел[0] = "S" ИЛИ Узел[0] = "N" ИЛИ Узел[0] = "D" ИЛИ Узел[0] = "R";

КонецФункции

Функция ИзвестныеДанные(Событие, Узел)

	Если НЕ Список(Узел, 2) ИЛИ НЕ ЭтоСтрока(Узел[0]) ИЛИ ТипЗнч(Узел[1]) <> Тип("Массив") Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Сначала пробуем точные формы реестра. Имя поля разрешается только после
	// проверки структуры и всех значений, включая пропускаемые поля.
	Описания = ПоляДанныхСобытийЖурналаРегистрации.Раскладки(Событие);
	Если Описания <> Неопределено Тогда
		Для Каждого Описание Из Описания Цикл
			Если НЕ СоответствуетФорме(Узел, Описание) Тогда
				Продолжить;
			КонецЕсли;

			Значения = Поля(Узел[1], Описание);
			Если Значения = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			Если Описание.Представление = "ПозиционныйКонверт" Тогда
				Возврат ПозиционныйКонверт(Узел, Значения);
			КонецЕсли;

			Возврат Значения;
		КонецЦикла;
	КонецЕсли;

	// У неизвестной формы имена можно взять только из явно именованных пар.
	// Если и это невозможно, вызывающий метод сохранит полное дерево.
	Если Литерал(Узел[0], "P") Тогда
		Возврат ИменованныеДанные(Узел);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция СоответствуетФорме(Узел, Описание)

	Тело = Узел[1];
	Если НЕ Литерал(Узел[0], Описание.Корень) ИЛИ НЕ Список(Тело, Описание.Арность) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Описание.Маска <> "" И (Тело.Количество() = 0 ИЛИ НЕ Литерал(Тело[0], Описание.Маска)) Тогда
		Возврат Ложь;
	КонецЕсли;

	// Пути и ограничения вложенных списков уже подготовлены при регистрации формы.
	Для Каждого Условие Из Описание.Условия Цикл
		Значение = УзелПоПути(Тело, Условие.Путь);
		Если Условие.Арность <> Неопределено И НЕ Список(Значение, Условие.Арность) Тогда
			Возврат Ложь;
		КонецЕсли;

		Если Условие.Литералы.Количество() > 0 Тогда
			Если НЕ ЭтоСтрока(Значение) ИЛИ Условие.Литералы.Найти(Значение) = Неопределено Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция УзелПоПути(Узел, Путь)

	Значение = Узел;
	Для Каждого Индекс Из Путь Цикл
		Если ТипЗнч(Значение) <> Тип("Массив") ИЛИ Индекс >= Значение.Количество() Тогда
			Возврат Неопределено;
		КонецЕсли;

		Значение = Значение[Индекс];
	КонецЦикла;

	Возврат Значение;

КонецФункции

Функция ИменованныеДанные(Узел)

	Тело = Узел[1];
	Если Тело.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Количество = КоличествоИзУзла(Тело[0]);
	Если Количество = Неопределено ИЛИ Количество = 0 ИЛИ Количество + 1 <> Тело.Количество() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Значения = Новый Соответствие;
	Для Индекс = 1 По Количество Цикл
		Пара = Тело[Индекс];
		Если НЕ Список(Пара, 2) ИЛИ НЕ ЭтоСтрока(Пара[0]) Тогда
			Возврат Неопределено;
		КонецЕсли;

		Имя = Пара[0];
		Если Значения[Имя] <> Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;

		Значение = ИменованноеЗначение(Пара[1]);
		Если Значение = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;

		Значения.Вставить(Имя, Значение);
	КонецЦикла;

	Результат = Новый Соответствие;
	Результат.Вставить("$format", "1c-named-data-v1");
	Результат.Вставить("values", Значения);
	Результат.Вставить("nodes", ДеревоТокенов(Узел));
	Возврат Результат;

КонецФункции

Функция ИменованноеЗначение(Узел)

	Если Список(Узел, 1) И Литерал(Узел[0], "U") Тогда
		Возврат ОдноПоле("$type", "U");
	КонецЕсли;

	Если НЕ Список(Узел, 2) ИЛИ НЕ ЭтоСтрока(Узел[0]) ИЛИ НЕ ЭтоСтрока(Узел[1]) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Узел[0] = "@" ИЛИ Узел[0] = "R" Тогда
		Результат = ОдноПоле("$type", Узел[0]);
		Результат.Вставить("value", Узел[1]);
		Возврат Результат;
	КонецЕсли;

	Если Узел[0] = "S" ИЛИ Узел[0] = "N" ИЛИ Узел[0] = "B" ИЛИ Узел[0] = "D" Тогда
		Возврат ЗначениеУзла(Узел, Узел[0]);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция Поля(Тело, Описание)

	Результат = Новый Соответствие;
	Значение = Неопределено;
	Для Каждого Поле Из Описание.Поля Цикл
		Узел = УзелПоПути(Тело, Поле.Путь);
		Если Поле.Тип = "U" Тогда
			// Неопределено здесь допустимое значение JSON null, а не ошибка чтения.
			Если НЕ Список(Узел, 1) ИЛИ НЕ Литерал(Узел[0], "U") Тогда
				Возврат Неопределено;
			КонецЕсли;

			Значение = Неопределено;
		ИначеЕсли Поле.Преобразование = "ЭлементыВыгрузки" Тогда
			Элементы = ЗначениеУзла(Узел, "T");
			Если Элементы = Неопределено Тогда
				Возврат Неопределено;
			КонецЕсли;

			// Выгрузка платформы различает null, один Item и массив Item.
			Значение = Неопределено;
			Если Элементы.Количество() > 0 Тогда
				Содержимое = ?(Элементы.Количество() = 1, Элементы[0], Элементы);
				Значение = ОдноПоле("Item", Содержимое);
			КонецЕсли;
		ИначеЕсли (Поле.Тип = "A" ИЛИ Поле.Тип = "T") И (Поле.Агрегат <> "" ИЛИ Поле.Пропуск) Тогда
			// Для подсчета или пропуска не создаем массив объектов JSON,
			// но проверяем каждый элемент и заявленное число элементов.
			Количество = КоличествоЭлементовМассива(Узел, Поле.Тип, Поле.Агрегат = "КоличествоУникальных");
			Если Количество = Неопределено Тогда
				Возврат Неопределено;
			КонецЕсли;

			Значение = Формат(Количество, "ЧГ=0;ЧН=0");
		Иначе
			Значение = ЗначениеУзла(Узел, Поле.Тип);
			Если Значение = Неопределено Тогда
				Возврат Неопределено;
			КонецЕсли;
		КонецЕсли;

		// Неизвестный код перечисления отвергает всю форму, сохраняя исходное дерево.
		Если Поле.Значения.Количество() > 0 Тогда
			Значение = Поле.Значения[Значение];
			Если Значение = Неопределено Тогда
				Возврат Неопределено;
			КонецЕсли;
		КонецЕсли;

		// Пропуск влияет только на вывод: исходное значение уже проверено выше.
		Если НЕ Поле.Пропуск Тогда
			Результат.Вставить(Поле.ИмяJSON, Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЗначениеУзла(Узел, Вид)

	Если Вид = "Z" Тогда
		Возврат ТабличныеДанные(Узел);
	КонецЕсли;

	Если НЕ Список(Узел, 2) ИЛИ НЕ Литерал(Узел[0], ?(Вид = "T", "A", Вид)) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Данные = Узел[1];
	Если Вид = "O" Тогда
		Если НЕ Список(Данные, 3) ИЛИ НЕ Литерал(Данные[0], "#")
			ИЛИ НЕ ЭтоUUID(Данные[1]) ИЛИ НЕ ЭтоUUID(Данные[2]) Тогда
			Возврат Неопределено;
		КонецЕсли;

		Результат = ОдноПоле("$type", "O");
		Результат.Вставить("typeId", Данные[1]);
		Результат.Вставить("value", Данные[2]);
		Возврат Результат;
	ИначеЕсли Вид = "A" ИЛИ Вид = "T" Тогда
		Если ТипЗнч(Данные) <> Тип("Массив") ИЛИ Данные.Количество() = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;

		Количество = КоличествоИзУзла(Данные[0]);
		Если Количество = Неопределено ИЛИ Количество + 1 <> Данные.Количество() Тогда
			Возврат Неопределено;
		КонецЕсли;

		Результат = Новый Массив;
		Для Индекс = 1 По Количество Цикл
			Значение = ЗначениеУзла(Данные[Индекс], ?(Вид = "T", "S", "O"));
			Если Значение = Неопределено Тогда
				Возврат Неопределено;
			КонецЕсли;

			Результат.Добавить(Значение);
		КонецЦикла;

		Возврат Результат;
	КонецЕсли;

	Если НЕ ЭтоСтрока(Данные) Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Числа остаются строками: перевод в число потерял бы точность длинных значений.
	Если Вид = "S" ИЛИ Вид = "N" Тогда
		Возврат Данные;
	ИначеЕсли Вид = "B" Тогда
		Если Данные = "1" Тогда
			Возврат "true";
		ИначеЕсли Данные = "0" Тогда
			Возврат "false";
		КонецЕсли;
	ИначеЕсли Вид = "D" И СтрДлина(Данные) = 14 И РегулярнаяДата.Совпадает(Данные) Тогда
		Попытка
			Возврат Формат(Дата(Данные), "ДФ=yyyy-MM-ddTHH:mm:ss;ДП=0001-01-01T00:00:00");
		Исключение
			// Невалидная календарная дата сохраняется в дереве, без догадок.
			Возврат Неопределено;
		КонецПопытки;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Проверяет весь массив до подсчета; объекты JSON не создаются.
Функция КоличествоЭлементовМассива(Узел, ТипМассива, ТолькоУникальные)

	Если НЕ Список(Узел, 2) ИЛИ НЕ Литерал(Узел[0], "A") ИЛИ ТипЗнч(Узел[1]) <> Тип("Массив")
		ИЛИ Узел[1].Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Данные = Узел[1];
	Количество = КоличествоИзУзла(Данные[0]);
	Если Количество = Неопределено ИЛИ Количество + 1 <> Данные.Количество() Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Обычный подсчет не требует множества и не хранит элементы массива.
	Уникальные = ?(ТолькоУникальные, Новый Соответствие, Неопределено);
	Для Индекс = 1 По Количество Цикл
		Элемент = Данные[Индекс];
		Если ТипМассива = "T" Тогда
			Если НЕ Типизированный(Элемент, "S") Тогда
				Возврат Неопределено;
			КонецЕсли;

			// Строки сравниваются точно, включая регистр, пробелы и пустое значение.
			Если ТолькоУникальные Тогда
				Уникальные.Вставить(Элемент[1], Истина);
			КонецЕсли;
		Иначе
			Если НЕ Список(Элемент, 2) ИЛИ НЕ Литерал(Элемент[0], "O") ИЛИ НЕ Список(Элемент[1], 3)
				ИЛИ НЕ Литерал(Элемент[1][0], "#") ИЛИ НЕ ЭтоUUID(Элемент[1][1]) ИЛИ НЕ ЭтоUUID(Элемент[1][2]) Тогда
				Возврат Неопределено;
			КонецЕсли;

			// Ссылку определяют оба UUID. Регистр записи UUID не меняет идентичность.
			Если ТолькоУникальные Тогда
				Ключ = НРег(Элемент[1][1] + "/" + Элемент[1][2]);
				Уникальные.Вставить(Ключ, Истина);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Если ТолькоУникальные Тогда
		Возврат Уникальные.Количество();
	КонецЕсли;

	Возврат Количество;

КонецФункции

Функция ПозиционныйКонверт(Узел, Значения)

	Результат = Новый Соответствие;
	Результат.Вставить("$format", "1c-positional-data-v1");
	Результат.Вставить("layout", Узел[0] + "/" + Узел[1][0]);
	Результат.Вставить("values", Значения);
	Результат.Вставить("unnamedFields", Новый Массив);
	Результат.Вставить("nodes", ДеревоТокенов(Узел));
	Возврат Результат;

КонецФункции

Функция ТабличныеДанные(Узел)

	Если НЕ Список(Узел, 2) ИЛИ НЕ Литерал(Узел[0], "Z") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Таблица = Узел[1];
	Если ТипЗнч(Таблица) <> Тип("Массив") ИЛИ Таблица.Количество() < 2 Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Z содержит счетчики колонок и строк, затем описания колонок, затем строки.
	ЧислоКолонок = КоличествоИзУзла(Таблица[0]);
	ЧислоСтрок = КоличествоИзУзла(Таблица[1]);
	Если ЧислоКолонок = Неопределено ИЛИ ЧислоСтрок = Неопределено ИЛИ ЧислоКолонок = 0
		ИЛИ ЧислоКолонок + ЧислоСтрок + 2 <> Таблица.Количество() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Колонки = Новый Массив;
	Имена = Новый Массив;
	УникальныеИмена = Новый Соответствие;
	Для Индекс = 0 По ЧислоКолонок - 1 Цикл
		Колонка = Таблица[Индекс + 2];
		Если НЕ Список(Колонка, 2) ИЛИ НЕ ЭтоСтрока(Колонка[0]) Тогда
			Возврат Неопределено;
		КонецЕсли;

		Образец = Колонка[1];
		// Обе встречавшиеся формы Pattern описывают строковые ячейки.
		ЭтоОбразец = Список(Образец, 1) И Литерал(Образец[0], "Pattern");
		ЭтоТипизированныйОбразец = Список(Образец, 2) И Литерал(Образец[0], "Pattern")
			И Список(Образец[1], 1) И Литерал(Образец[1][0], "S");
		Если НЕ ЭтоОбразец И НЕ ЭтоТипизированныйОбразец Тогда
			Возврат Неопределено;
		КонецЕсли;

		Имя = Колонка[0];
		Если УникальныеИмена[Имя] <> Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;

		УникальныеИмена.Вставить(Имя, Истина);
		Имена.Добавить(Имя);
		Колонки.Добавить(ОдноПоле("name", Имя));
	КонецЦикла;

	Строки = Новый Массив;
	Для НомерСтроки = 0 По ЧислоСтрок - 1 Цикл
		Источник = Таблица[2 + ЧислоКолонок + НомерСтроки];
		Если НЕ Список(Источник, ЧислоКолонок) Тогда
			Возврат Неопределено;
		КонецЕсли;

		СтрокаТаблицы = Новый Соответствие;
		Для НомерКолонки = 0 По ЧислоКолонок - 1 Цикл
			Если НЕ Типизированный(Источник[НомерКолонки], "S") Тогда
				Возврат Неопределено;
			КонецЕсли;

			СтрокаТаблицы.Вставить(Имена[НомерКолонки], Источник[НомерКолонки][1]);
		КонецЦикла;

		Строки.Добавить(СтрокаТаблицы);
	КонецЦикла;

	// Сохраняем соглашение выгрузки: одиночная колонка/строка — объект, несколько — массив.
	Результат = ОдноПоле("Column", ?(ЧислоКолонок = 1, Колонки[0], Колонки));
	Если ЧислоСтрок > 0 Тогда
		Результат.Вставить("Row", ?(ЧислоСтрок = 1, Строки[0], Строки));
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ДеревоТокенов(Узел)

	Если ЭтоСтрока(Узел) Тогда
		// Скобочный парсер снял удвоенные кавычки; nodes хранит исходный текст листьев.
		Возврат СтрЗаменить(Узел, """", """""");
	КонецЕсли;

	Результат = Новый Массив;
	Для Каждого Вложенный Из Узел Цикл
		Результат.Добавить(ДеревоТокенов(Вложенный));
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция КоличествоИзУзла(Узел)

	Если НЕ ЭтоСтрока(Узел) ИЛИ НЕ РегулярноеКоличество.Совпадает(Узел) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Количество = Число(Узел);
		Если Количество <= 2147483647 Тогда
			Возврат Количество;
		КонецЕсли;
	Исключение
		// Слишком большое число - неизвестная форма, без усечения.
		Возврат Неопределено;
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

Функция ЭтоСтрока(Узел)

	Возврат ТипЗнч(Узел) = Тип("Строка");

КонецФункции

Функция Список(Узел, Количество)

	Возврат ТипЗнч(Узел) = Тип("Массив") И Узел.Количество() = Количество;

КонецФункции

Функция Литерал(Узел, Текст)

	Возврат ЭтоСтрока(Узел) И Узел = Текст;

КонецФункции

Функция Типизированный(Узел, Вид)

	Возврат Список(Узел, 2) И Литерал(Узел[0], Вид) И ЭтоСтрока(Узел[1]);

КонецФункции

Функция ЭтоUUID(Узел)

	Возврат ЭтоСтрока(Узел) И СтрДлина(Узел) = 36 И РегулярныйUUID.Совпадает(Узел);

КонецФункции

Функция ОдноПоле(Имя, Значение)

	Результат = Новый Соответствие;
	Результат.Вставить(Имя, Значение);
	Возврат Результат;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта()

	РегулярноеКоличество = Новый РегулярноеВыражение("\A[0-9]+\z");
	РегулярнаяДата = Новый РегулярноеВыражение("^[0-9]{14}$");
	РегулярныйUUID = Новый РегулярноеВыражение("^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$");

КонецПроцедуры
