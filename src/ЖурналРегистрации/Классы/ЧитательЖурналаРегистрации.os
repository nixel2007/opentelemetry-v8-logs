#native
#Использовать autumn-logos
#Использовать collectionos
#Использовать "../../Чтение"

// Читатель каталога журнала регистрации информационной базы (1Cv8Log) в формате lgf/lgp.
//
// Словарь 1Cv8.lgf читается целиком при первом проходе и дочитывается в каждом следующем
// до чтения записей: предполагается, что платформа дописывает в словарь новые значения раньше
// записей, которые на них ссылаются. Если запись прочитана раньше своего значения словаря,
// поле записи останется пустым. Файлы записей *.lgp дочитываются с сохраненных позиций по порядку имен.
// Позиции сохраняются в хранилище только методом ЗафиксироватьПозиции, см. ЧитательТехнологическогоЖурнала.

&Пластилин
Перем ЧтениеФайловЖурнала; // ЧтениеФайловЖурнала - дочитывание файлов порциями

&Пластилин
Перем ПарсерСкобочногоФормата; // ПарсерСкобочногоФормата - разбор файлов словаря и записей

&Пластилин
Перем ПарсерЖурналаРегистрации; // ПарсерЖурналаРегистрации - расшифровка записей по словарю

&Табакерка
&Пластилин("ХранилищеПозицийВПамяти")
Перем ТабакеркаХранилищ; // Табакерка - хранилище позиций словаря, см. ПозицииСловаря

&Лог(Значение = "oscript.app.opentelemetry-v8-logs", УчитыватьИмяКласса = Ложь)
Перем Лог; // Лог - лог приложения

Перем КаталогЖурнала; // Строка - полный путь к каталогу журнала
Перем ПутьКСловарю; // Строка - полный путь к файлу словаря 1Cv8.lgf
Перем ИнформационнаяБаза; // Строка - имя информационной базы журнала
Перем МаксимумБайт; // Число - объем данных, читаемый из файла за одну порцию
Перем Позиции; // ПозицииЧтения - позиции файлов записей
Перем ПозицииСловаря; // ПозицииЧтения, Неопределено - позиции словаря в памяти, создаются при первом проходе
Перем Словарь; // СловарьЖурналаРегистрации - словарь журнала
Перем ТекущийОбработчик; // Произвольный - обработчик записей текущего прохода
Перем ТабакеркаПозицийЧтения; // Табакерка - ПозицииЧтения для позиций словаря

#Область ПрограммныйИнтерфейс

// Выполняет один проход по файлам журнала и передает новые записи обработчику.
//
// Параметры:
//   Обработчик - Произвольный - объект с методом ОбработатьЗаписиЖурналаРегистрации(Записи, ОписаниеЖурнала),
//     которому передаются массив записей (см. ПарсерЖурналаРегистрации.ЗаписьЖурнала)
//     и структура описания файла: Путь, Каталог, ИнформационнаяБаза
//
// Возвращаемое значение:
//   Число - количество переданных записей
//
Функция Прочитать(Обработчик) Экспорт

	Если НЕ Новый Файл(ПутьКСловарю).Существует() Тогда
		Возврат 0;
	КонецЕсли;

	ТекущийОбработчик = Обработчик;

	// Словарь не сохраняется между запусками и при старте читается целиком
	Если ПозицииСловаря = Неопределено Тогда
		ПозицииСловаря = ТабакеркаПозицийЧтения.Достать(
			Массивы.ИзЭлементов(КаталогЖурнала, ТабакеркаХранилищ.Достать(), Ложь));
	КонецЕсли;
	ПозицииСловаря.НачатьПроход();
	ЧтениеФайловЖурнала.ПрочитатьФайл(ПутьКСловарю, ПозицииСловаря, МаксимумБайт, Ложь, ЭтотОбъект, Неопределено,
		ПоГраницеСимвола());
	ПозицииСловаря.ЗавершитьПроход();

	Позиции.НачатьПроход();
	Количество = 0;
	Файлы = ФайлыЗаписей();
	Для Индекс = 0 По Файлы.ВГраница() Цикл
		Описание = Новый Структура("Путь, Каталог, ИнформационнаяБаза",
			Файлы[Индекс], КаталогЖурнала, ИнформационнаяБаза);
		// Предполагается, что платформа дописывает только последний по имени файл
		Завершен = Индекс < Файлы.ВГраница();
		Количество = Количество + ЧтениеФайловЖурнала.ПрочитатьФайл(
			Описание.Путь, Позиции, МаксимумБайт, Завершен, ЭтотОбъект, Описание, ПоГраницеСимвола());
	КонецЦикла;
	Позиции.ЗавершитьПроход();

	Возврат Количество;

КонецФункции

// Сохраняет в хранилище позиции, прочитанные после предыдущей фиксации,
// и удаляет позиции файлов, которых больше нет.
//
Процедура ЗафиксироватьПозиции() Экспорт
	Позиции.Зафиксировать();
КонецПроцедуры

// Отбрасывает позиции, прочитанные после предыдущей фиксации: записи, не переданные
// дальше из-за сбоя, будут прочитаны повторно. Словарь остается в памяти.
//
Процедура ОткатитьПозиции() Экспорт
	Позиции.Откатить();
КонецПроцедуры

// Служебный: разбирает порцию файла словаря или записей, см. ЧтениеФайловЖурнала.ПрочитатьФайл.
//
// Параметры:
//   Текст - Строка - порция файла
//   ТекстЗавершен - Булево - дописывания файла больше не будет; не используется: конец записи
//     находит скобочный парсер, незакрытая запись остается в остатке в любом случае
//   ОписаниеЖурнала - Структура, Неопределено - описание файла записей; Неопределено для словаря
//
// Возвращаемое значение:
//   Структура - Количество, Остаток
//
Функция ОбработатьПорцию(Текст, ТекстЗавершен, ОписаниеЖурнала) Экспорт // BSLLS:UnusedParameters-off

	Разбор = ПарсерСкобочногоФормата.Разобрать(Текст);

	Если ОписаниеЖурнала = Неопределено Тогда
		Пропущено = Словарь.Добавить(Разбор.Записи);
		ПредупредитьОПропущенных(ПутьКСловарю, Пропущено);
		Возврат Новый Структура("Количество, Остаток", Разбор.Записи.Количество(), Разбор.Остаток);
	КонецЕсли;

	Записи = Новый Массив;
	Пропущено = 0;
	Для Каждого Элемент Из Разбор.Записи Цикл
		Попытка
			Записи.Добавить(ПарсерЖурналаРегистрации.ЗаписьЖурнала(Элемент, Словарь));
		Исключение
			// Запись с неожиданной структурой пропускается, чтобы не останавливать чтение журнала
			Пропущено = Пропущено + 1;
		КонецПопытки;
	КонецЦикла;
	ПредупредитьОПропущенных(ОписаниеЖурнала.Путь, Пропущено);

	Если Записи.Количество() > 0 Тогда
		ТекущийОбработчик.ОбработатьЗаписиЖурналаРегистрации(Записи, ОписаниеЖурнала);
	КонецЕсли;

	Возврат Новый Структура("Количество, Остаток", Записи.Количество(), Разбор.Остаток);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПредупредитьОПропущенных(Путь, Пропущено)
	Если Пропущено > 0 Тогда
		Лог.Предупреждение("Файл журнала %1: пропущено записей неожиданной структуры: %2", Путь, Пропущено);
	КонецЕсли;
КонецПроцедуры

// Платформа пишет разделитель записей ",<перевод строки>" перед следующей записью, поэтому
// последняя запись файла не заканчивается переводом строки. Конец записи находит скобочный
// парсер, и данные читаются до конца файла.
//
// Возвращаемое значение:
//   Булево - передавать разборщику данные до границы символа, а не до перевода строки
//
Функция ПоГраницеСимвола()
	Возврат Истина;
КонецФункции

Функция ФайлыЗаписей()

	Имена = Новый СписокЗначений;
	Для Каждого Файл Из НайтиФайлы(КаталогЖурнала, "*.lgp") Цикл
		Имена.Добавить(Файл.ПолноеИмя, Файл.Имя);
	КонецЦикла;
	Имена.СортироватьПоПредставлению();

	Возврат Имена.ВыгрузитьЗначения();

КонецФункции

#КонецОбласти

// Параметры:
//   Каталог - Строка - каталог журнала регистрации (1Cv8Log)
//   ХранилищеПозиций - Произвольный - хранилище позиций чтения, см. ХранилищеПозицийВПамяти
//   ИмяБазы - Строка - имя информационной базы; пустая строка - имя родительского каталога
//   НачинатьСКонца - Булево - при первом запуске пропустить уже записанные данные
//   НовыйМаксимумБайт - Число - объем данных, читаемый из файла за одну порцию
//   ТабакеркаПозиций - Табакерка - ПозицииЧтения каталога и словаря
//   ТабакеркаСловарей - Табакерка - СловарьЖурналаРегистрации
//
&Желудь
&Характер("Компанейский")
Процедура ПриСозданииОбъекта(&Блестяшка Каталог, &Блестяшка ХранилищеПозиций, &Блестяшка ИмяБазы,
	&Блестяшка НачинатьСКонца, &Блестяшка НовыйМаксимумБайт,
	&Табакерка &Пластилин("ПозицииЧтения") ТабакеркаПозиций,
	&Табакерка &Пластилин("СловарьЖурналаРегистрации") ТабакеркаСловарей)

	ФайлКаталога = Новый Файл(Каталог);
	КаталогЖурнала = ФайлКаталога.ПолноеИмя;
	ПутьКСловарю = ОбъединитьПути(КаталогЖурнала, "1Cv8.lgf");
	ИнформационнаяБаза = ?(ЗначениеЗаполнено(ИмяБазы), ИмяБазы, Новый Файл(ФайлКаталога.Путь).Имя);
	МаксимумБайт = НовыйМаксимумБайт;

	ТабакеркаПозицийЧтения = ТабакеркаПозиций;
	Позиции = ТабакеркаПозиций.Достать(Массивы.ИзЭлементов(КаталогЖурнала, ХранилищеПозиций, НачинатьСКонца));
	Словарь = ТабакеркаСловарей.Достать();

КонецПроцедуры
