#native

// Словарь журнала регистрации (1Cv8.lgf): значения, на которые ссылаются записи *.lgp по коду.
//
// Записи словаря имеют вид {тип, ..., код}. Типы:
//   1 - пользователи {1,ид,"имя",код}
//   2 - компьютеры {2,"имя",код}
//   3 - приложения {3,"имя",код}
//   4 - события {4,"имя",код}
//   5 - метаданные {5,ид,"имя",код}
//   6 - рабочие серверы {6,"имя",код}
//   7 - основные порты {7,порт,код}
//   8 - вспомогательные порты {8,порт,код}
//   9 - разделители (параметры сеанса) {9,ид,"имя",код}
//   10 - значения разделителей {10,{тип,значение},код разделителя,код}
// Остальные типы не используются. Повторная запись с тем же кодом заменяет значение.

Перем Значения; // Соответствие: тип записи -> Соответствие код -> значение

#Область ПрограммныйИнтерфейс

// Добавляет в словарь записи, прочитанные из файла 1Cv8.lgf.
//
// Параметры:
//   Записи - Массив из Массив - записи, см. ПарсерСкобочногоФормата.Разобрать
//
// Возвращаемое значение:
//   Число - сколько записей пропущено из-за неожиданной структуры
//
Функция Добавить(Записи) Экспорт

	Пропущено = 0;
	Для Каждого Запись Из Записи Цикл

		Если Запись.Количество() < 3 Тогда
			Продолжить;
		КонецЕсли;

		// Запись неожиданного вида (например, с нечисловым кодом) пропускается,
		// чтобы не останавливать чтение словаря
		Попытка
			ДобавитьЗапись(Запись);
		Исключение
			Пропущено = Пропущено + 1;
		КонецПопытки;

	КонецЦикла;

	Возврат Пропущено;

КонецФункции

// Пользователь по коду.
//
// Параметры:
//   Код - Число - код пользователя
//
// Возвращаемое значение:
//   Структура - пользователь:
//     * Ид - Строка - уникальный идентификатор пользователя
//     * Имя - Строка - имя пользователя
//
Функция Пользователь(Код) Экспорт
	Возврат ЗначениеСИдентификатором("1", Код);
КонецФункции

// Имя компьютера по коду.
//
// Параметры:
//   Код - Число - код компьютера
//
// Возвращаемое значение:
//   Строка - имя компьютера
//
Функция Компьютер(Код) Экспорт
	Возврат Имя("2", Код);
КонецФункции

// Имя приложения по коду.
//
// Параметры:
//   Код - Число - код приложения
//
// Возвращаемое значение:
//   Строка - имя приложения (1CV8C, BackgroundJob...)
//
Функция Приложение(Код) Экспорт
	Возврат Имя("3", Код);
КонецФункции

// Идентификатор события по коду.
//
// Параметры:
//   Код - Число - код события
//
// Возвращаемое значение:
//   Строка - идентификатор события (_$Session$_.Start...)
//
Функция Событие(Код) Экспорт
	Возврат Имя("4", Код);
КонецФункции

// Объект метаданных по коду.
//
// Параметры:
//   Код - Число - код объекта метаданных
//
// Возвращаемое значение:
//   Структура - объект метаданных:
//     * Ид - Строка - уникальный идентификатор объекта метаданных
//     * Имя - Строка - полное имя объекта метаданных
//
Функция Метаданные(Код) Экспорт
	Возврат ЗначениеСИдентификатором("5", Код);
КонецФункции

// Имя рабочего сервера по коду.
//
// Параметры:
//   Код - Число - код рабочего сервера
//
// Возвращаемое значение:
//   Строка - имя рабочего сервера
//
Функция Сервер(Код) Экспорт
	Возврат Имя("6", Код);
КонецФункции

// Основной IP-порт по коду.
//
// Параметры:
//   Код - Число - код порта
//
// Возвращаемое значение:
//   Число - номер порта, 0 если код не найден
//
Функция ОсновнойПорт(Код) Экспорт
	Возврат Порт("7", Код);
КонецФункции

// Вспомогательный IP-порт по коду.
//
// Параметры:
//   Код - Число - код порта
//
// Возвращаемое значение:
//   Число - номер порта, 0 если код не найден
//
Функция ВспомогательныйПорт(Код) Экспорт
	Возврат Порт("8", Код);
КонецФункции

// Имя разделителя (параметра сеанса) по коду.
//
// Параметры:
//   Код - Число - код разделителя
//
// Возвращаемое значение:
//   Строка - имя разделителя
//
Функция Разделитель(Код) Экспорт
	Возврат ЗначениеСИдентификатором("9", Код).Имя;
КонецФункции

// Значение разделителя по коду разделителя и коду значения.
//
// Параметры:
//   КодРазделителя - Число - код разделителя
//   Код - Число - код значения разделителя
//
// Возвращаемое значение:
//   Строка - значение разделителя
//
Функция ЗначениеРазделителяПоКоду(КодРазделителя, Код) Экспорт
	Значение = ЗначенияВида("10")[КлючЗначенияРазделителя(КодРазделителя, Код)];
	Возврат ?(Значение = Неопределено, "", Значение);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьЗапись(Запись)

	ВидЗаписи = Запись[0];
	Код = Число(Запись[Запись.ВГраница()]);

	// В #native тип переменной фиксируется первым присваиванием, поэтому значения разных
	// типов вставляются в словарь сразу, без общей переменной
	Если ВидЗаписи = "1" ИЛИ ВидЗаписи = "5" ИЛИ ВидЗаписи = "9" Тогда
		ЗначенияВида(ВидЗаписи).Вставить(Код, Новый Структура("Ид, Имя", Запись[1], Запись[2]));
	ИначеЕсли ВидЗаписи = "7" ИЛИ ВидЗаписи = "8" Тогда
		ЗначенияВида(ВидЗаписи).Вставить(Код, Число(Запись[1]));
	ИначеЕсли ВидЗаписи = "10" Тогда
		ЗначенияВида(ВидЗаписи).Вставить(КлючЗначенияРазделителя(Запись[2], Код),
			ЗначениеРазделителя(Запись[1]));
	ИначеЕсли ВидЗаписи = "2" ИЛИ ВидЗаписи = "3" ИЛИ ВидЗаписи = "4" ИЛИ ВидЗаписи = "6" Тогда
		ЗначенияВида(ВидЗаписи).Вставить(Код, Запись[1]);
	КонецЕсли;

КонецПроцедуры

Функция ЗначенияВида(ВидЗаписи)
	Результат = Значения[ВидЗаписи];
	Если Результат = Неопределено Тогда
		Результат = Новый Соответствие;
		Значения.Вставить(ВидЗаписи, Результат);
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция Имя(ВидЗаписи, Код)
	Значение = ЗначенияВида(ВидЗаписи)[Код];
	Возврат ?(Значение = Неопределено, "", Значение);
КонецФункции

Функция Порт(ВидЗаписи, Код)
	Значение = ЗначенияВида(ВидЗаписи)[Код];
	Возврат ?(Значение = Неопределено, 0, Значение);
КонецФункции

Функция ЗначениеСИдентификатором(ВидЗаписи, Код)
	Значение = ЗначенияВида(ВидЗаписи)[Код];
	Если Значение = Неопределено Тогда
		Значение = Новый Структура("Ид, Имя", "", "");
	КонецЕсли;
	Возврат Значение;
КонецФункции

Функция ЗначениеРазделителя(Значение)
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Возврат ?(Значение.Количество() > 1, Значение[1], "");
	КонецЕсли;
	Возврат Значение;
КонецФункции

Функция КлючЗначенияРазделителя(КодРазделителя, Код)
	Возврат СтрШаблон("%1:%2", Формат(КодРазделителя, "ЧГ=0"), Формат(Код, "ЧГ=0"));
КонецФункции

#КонецОбласти

&Желудь
&Характер("Компанейский")
Процедура ПриСозданииОбъекта()
	Значения = Новый Соответствие;
КонецПроцедуры
