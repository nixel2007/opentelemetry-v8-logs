#native

// Конструкторы форм и агрегатов декларативного реестра ЖР.
// Построители используются при регистрации; чтение работает с готовыми описаниями.

#Область ПрограммныйИнтерфейс

// Позиционная форма с необязательным точным маркером перед значениями.
//
// Параметры:
//   Корень - Строка - тип внешнего узла
//   Маркер - Строка - первый литерал; пустая строка для формы без маркера
//
// Возвращаемое значение:
//   ФормаДанныхЖурналаРегистрации - построитель формы
//
Функция Позиционная(Корень, Маркер = "") Экспорт

	Возврат Новый ФормаДанныхЖурналаРегистрации("Позиционная", Корень, Маркер);

КонецФункции

// Битовая форма: разрешена только указанная маска.
//
// Параметры:
//   Корень - Строка - тип внешнего узла
//   Маска - Строка - точная маска присутствия
//
// Возвращаемое значение:
//   ФормаДанныхЖурналаРегистрации - построитель формы
//
Функция ПоМаске(Корень, Маска) Экспорт

	Возврат Новый ФормаДанныхЖурналаРегистрации("Маска", Корень, Маска);

КонецФункции

// Форма с путями и условиями вложенных узлов.
//
// Параметры:
//   Корень - Строка - тип внешнего узла
//
// Возвращаемое значение:
//   ФормаДанныхЖурналаРегистрации - построитель формы
//
Функция Структура(Корень) Экспорт

	Возврат Новый ФормаДанныхЖурналаРегистрации("Структура", Корень, "");

КонецФункции

// Подсчет элементов проверенного массива.
//
// Возвращаемое значение:
//   Строка - универсальный агрегат
//
Функция Количество() Экспорт

	Возврат "Количество";

КонецФункции

// Подсчет различных элементов проверенного массива строк или ссылок.
//
// Возвращаемое значение:
//   Строка - универсальный агрегат
//
Функция КоличествоУникальных() Экспорт

	Возврат "КоличествоУникальных";

КонецФункции

#КонецОбласти
