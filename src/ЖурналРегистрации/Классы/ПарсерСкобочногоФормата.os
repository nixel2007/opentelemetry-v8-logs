#native

// Разбор "скобочного" формата 1С ({...}), в котором хранится журнал регистрации (*.lgf, *.lgp).
//
// Файл - последовательность записей верхнего уровня {...}, разделенных запятыми и переводами строк.
// Значения - строки в двойных кавычках (кавычка внутри удваивается, допускаются переводы строк),
// значения без кавычек и вложенные списки {...}.

Перем РегулярнаяЛексема; // РегулярноеВыражение - очередная лексема (скобка, строка или значение) с разделителями перед ней
Перем ДлинаКавычки; // Число - длина кавычки вокруг строкового значения
Перем РазмерОкна; // Число - текст лексится окнами такой длины: совпадения окна живут одновременно, остальные - нет

// Состояние текущего вызова Разобрать
Перем Записи; // Массив из Массив - разобранные записи верхнего уровня
Перем Текущий; // Массив, Неопределено - список, в который добавляются значения; Неопределено - вне записи
Перем Стек; // Массив из Массив - объемлющие списки текущего
Перем НачалоЗаписи; // Число, Неопределено - индекс начала записи верхнего уровня, открытой в текущем окне
Перем ЧастиЗаписи; // Массив из Строка - исходный текст незавершенной записи по конец обработанного текста
Перем ЧастиХвоста; // Массив из Строка - неразобранный текст, который лексится вместе со следующим окном

#Область ПрограммныйИнтерфейс

// Разбирает фрагмент скобочного файла на записи верхнего уровня.
//
// Текст до первой открывающей скобки (заголовок файла) пропускается. Последняя запись,
// в которой не закрыты скобки или кавычки, возвращается в остатке исходным текстом.
//
// Параметры:
//   Текст - Строка - фрагмент файла
//
// Возвращаемое значение:
//   Структура - результат разбора:
//     * Записи - Массив из Массив - записи; элементы записи - Строка или вложенный Массив
//     * Остаток - Строка - исходный текст незавершенной последней записи
//
Функция Разобрать(Знач Текст) Экспорт

	Записи = Новый Массив;
	Результат = Новый Структура("Записи, Остаток", Записи, "");

	НачалоДанных = СтрНайти(Текст, "{");
	Если НачалоДанных = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Стек = Новый Массив;
	Текущий = Неопределено;
	ЧастиЗаписи = Новый Массив;
	ЧастиХвоста = Новый Массив;
	ХвостЖдетКавычку = Ложь;

	Длина = СтрДлина(Текст);
	Позиция = НачалоДанных;
	Пока Позиция <= Длина Цикл
		Порция = Сред(Текст, Позиция, РазмерОкна);
		Позиция = Позиция + РазмерОкна;
		Если ХвостЖдетКавычку И Позиция <= Длина И СтрНайти(Порция, """") = 0 Тогда
			ОтложитьПорцию(Порция);
		Иначе
			Хвост = РазобратьОкно(СтрСоединить(ЧастиХвоста, "") + Порция, Порция, Позиция > Длина);
			ЧастиХвоста.Очистить();
			ЧастиХвоста.Добавить(Хвост);
			ХвостЖдетКавычку = СтрЧислоВхождений(Хвост, """") % 2 = 1;
		КонецЕсли;
	КонецЦикла;

	Если Текущий <> Неопределено Тогда
		Результат.Остаток = СтрСоединить(ЧастиЗаписи, "");
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Задает размер окна лексического разбора.
//
// Параметры:
//   Размер - Число - длина окна в символах, не меньше 1
//
Процедура УстановитьРазмерОкна(Знач Размер) Экспорт
	Если Размер < 1 Тогда
		ВызватьИсключение "Размер окна разбора должен быть не меньше 1, передано " + Размер;
	КонецЕсли;
	РазмерОкна = Размер;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Хвост - незакрытая строка в кавычках: без кавычки в порции лексить нечего, порция копится к хвосту.
Процедура ОтложитьПорцию(Знач Порция)
	ЧастиХвоста.Добавить(Порция);
	Если Текущий <> Неопределено Тогда
		ЧастиЗаписи.Добавить(Порция);
	КонецЕсли;
КонецПроцедуры

// Лексит окно, продолжая состояние предыдущего; возвращает неразобранный хвост окна для следующего.
Функция РазобратьОкно(Знач Данные, Знач Порция, Знач Последнее)

	НачалоЗаписи = Неопределено;
	Отложенная = Неопределено;
	ПоследнееСовпадение = Неопределено;

	Для Каждого Совпадение Из РегулярнаяЛексема.НайтиСовпадения(Данные) Цикл
		Если Отложенная <> Неопределено Тогда
			ОбработатьЛексему(Отложенная);
		КонецЕсли;
		Отложенная = Совпадение.Группы[1];
		ПоследнееСовпадение = Совпадение;
	КонецЦикла;

	Если Отложенная = Неопределено Тогда
		Хвост = Данные;
	Иначе
		Конец = ПоследнееСовпадение.Индекс + СтрДлина(ПоследнееСовпадение.Значение);
		Если Последнее ИЛИ ЛексемаЗавершена(Отложенная, Данные, Конец) Тогда
			ОбработатьЛексему(Отложенная);
			Хвост = Сред(Данные, Конец + 1);
		Иначе
			Хвост = Сред(Данные, Отложенная.Индекс + 1);
		КонецЕсли;
	КонецЕсли;

	Если Текущий = Неопределено Тогда
		ЧастиЗаписи.Очистить();
	ИначеЕсли НачалоЗаписи <> Неопределено Тогда
		ЧастиЗаписи.Очистить();
		ЧастиЗаписи.Добавить(Сред(Данные, НачалоЗаписи + 1));
	Иначе
		ЧастиЗаписи.Добавить(Порция);
	КонецЕсли;

	Возврат Хвост;

КонецФункции

// Истина, если лексема не продолжится в следующем окне: не упирается в его край, а за строкой не стоит кавычка.
Функция ЛексемаЗавершена(Знач Лексема, Знач Данные, Знач Конец)
	Первый = Лев(Лексема.Значение, 1);
	Если Первый = "{" ИЛИ Первый = "}" Тогда
		Возврат Истина;
	КонецЕсли;
	Если Конец >= СтрДлина(Данные) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат НЕ (Первый = """" И Сред(Данные, Конец + 1, 1) = """");
КонецФункции

Процедура ОбработатьЛексему(Лексема)

	Значение = Лексема.Значение;
	Первый = Лев(Значение, 1);

	Если Первый = "{" Тогда
		ОткрытьСписок(Лексема.Индекс);
	ИначеЕсли Первый = "}" Тогда
		ЗакрытьСписок();
	ИначеЕсли Первый = """" Тогда
		ВКавычках = Сред(Значение, ДлинаКавычки + 1, СтрДлина(Значение) - ДлинаКавычки - ДлинаКавычки);
		СтроковоеЗначение = СтрЗаменить(ВКавычках, """""", """");
		ДобавитьЗначение(СтроковоеЗначение);
	Иначе
		ДобавитьЗначение(Значение);
	КонецЕсли;

КонецПроцедуры

Процедура ОткрытьСписок(Индекс)
	Список = Новый Массив;
	Если Текущий = Неопределено Тогда
		НачалоЗаписи = Индекс;
	Иначе
		Текущий.Добавить(Список);
		Стек.Добавить(Текущий);
	КонецЕсли;
	Текущий = Список;
КонецПроцедуры

Процедура ЗакрытьСписок()
	Если Текущий = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Стек.Количество() = 0 Тогда
		Записи.Добавить(Текущий);
		Текущий = Неопределено;
	Иначе
		Текущий = Стек[Стек.ВГраница()];
		Стек.Удалить(Стек.ВГраница());
	КонецЕсли;
КонецПроцедуры

// Добавляет значение в текущий список. Значения вне записи (между записями верхнего уровня) пропускаются.
//
// Параметры:
//   Значение - Строка - значение без кавычек
//
Процедура ДобавитьЗначение(Значение)
	Если Текущий <> Неопределено Тогда
		Текущий.Добавить(Значение);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта()
	// Лексемы идут подряд (\G): незакрытая кавычка останавливает разбор, и запись остается незавершенной.
	// Запятые и пробелы поглощаются вместе со следующей лексемой: половина лексем файла - разделители,
	// и отдельное совпадение на каждый из них заметно замедляет разбор. Строка - символы без кавычек, затем
	// повторы «удвоенная кавычка и символы без кавычек»: с альтернативой на каждый символ строка в десятки
	// мегабайт разбирается секунды, а не миллисекунды
	РегулярнаяЛексема = Новый РегулярноеВыражение("\G[\s,]*(\{|\}|""[^""]*(?:""""[^""]*)*""|[^,{}\s""]+)");
	ДлинаКавычки = СтрДлина("""");
	УстановитьРазмерОкна(65536);
КонецПроцедуры
