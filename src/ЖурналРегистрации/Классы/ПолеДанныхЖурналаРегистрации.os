#native

// Построитель поля. Переходы к следующему полю и форме делегируются событию.

Перем Событие; // СобытиеДанныхЖурналаРегистрации - родитель
Перем Данные; // Структура - текущее поле
Перем ВыводНастроен; // Булево - Как и Пропустить взаимоисключающие

#Область ПрограммныйИнтерфейс

// Задает тип исходного поля; представление JSON остается совместимым.
//
// Параметры:
//   Имя - Строка - Строка, Число, Булево, Дата, Ссылка, МассивСсылок,
//     МассивСтрок, Незаданное или Таблица
//
// Возвращаемое значение:
//   ПолеДанныхЖурналаРегистрации - этот построитель
//
Функция ТипПоля(Имя) Экспорт

	Событие.ПроверитьИзменение();
	Если Данные.Тип <> "" Тогда
		ВызватьИсключение "Тип поля уже задан: " + Данные.Имя;
	КонецЕсли;

	Коды = КодыТипов();
	Код = Коды[Имя];
	Если Код = Неопределено Тогда
		ВызватьИсключение "Неизвестный тип поля: " + Имя;
	КонецЕсли;

	Данные.Тип = Код;
	Возврат ЭтотОбъект;

КонецФункции

// Добавляет допустимый код перечисления; остальные коды не соответствуют форме.
//
// Параметры:
//   Код - Строка - исходное значение
//   Результат - Строка - значение JSON
//
// Возвращаемое значение:
//   ПолеДанныхЖурналаРегистрации - этот построитель
//
Функция Значение(Код, Результат) Экспорт

	Событие.ПроверитьИзменение();
	Если СтрНайти("SNBD", Данные.Тип) = 0 ИЛИ Данные.Тип = "" Тогда
		ВызватьИсключение "Карта значений применяется только к скалярному полю";
	КонецЕсли;

	Если Данные.Значения[Код] <> Неопределено Тогда
		ВызватьИсключение "Повторный код перечисления: " + Код;
	КонецЕсли;

	Данные.Значения.Вставить(Код, Результат);
	Возврат ЭтотОбъект;

КонецФункции

// Представляет массив строк как Item в формате выгрузки платформы.
//
// Возвращаемое значение:
//   ПолеДанныхЖурналаРегистрации - этот построитель
//
Функция ЭлементыВыгрузки() Экспорт

	Событие.ПроверитьИзменение();
	Если Данные.Тип <> "T" ИЛИ Данные.Агрегат <> "" Тогда
		ВызватьИсключение "Представление Item применяется к массиву строк без агрегата";
	КонецЕсли;

	Данные.Преобразование = "ЭлементыВыгрузки";
	Возврат ЭтотОбъект;

КонецФункции

// Исключает поле из JSON, сохраняя проверку исходного значения.
//
// Возвращаемое значение:
//   ПолеДанныхЖурналаРегистрации - этот построитель
//
Функция Пропустить() Экспорт

	ПроверитьНастройкуВывода();
	Данные.Пропуск = Истина;
	Возврат ЭтотОбъект;

КонецФункции

// Задает имя JSON и необязательный агрегат.
//
// Параметры:
//   ИмяJSON - Строка - ключ результата
//   Агрегат - Строка - операция агрегирования; пустая строка без агрегации
//
// Возвращаемое значение:
//   ПолеДанныхЖурналаРегистрации - этот построитель
//
Функция Как(ИмяJSON, Агрегат = "") Экспорт

	Если ИмяJSON = "" Тогда
		ВызватьИсключение "Имя поля JSON не может быть пустым";
	КонецЕсли;

	Если Агрегат <> "" И Агрегат <> "Количество" И Агрегат <> "КоличествоУникальных" Тогда
		ВызватьИсключение "Неизвестный агрегат: " + Агрегат;
	КонецЕсли;

	// Без агрегата Как меняет только имя, сохраняя исходный тип значения.
	Если Агрегат <> "" И Данные.Тип <> "A" И Данные.Тип <> "T" Тогда
		ВызватьИсключение "Агрегат применяется только к массивам";
	КонецЕсли;

	Если Агрегат <> "" И (Данные.Преобразование <> "" ИЛИ Данные.Значения.Количество() > 0) Тогда
		ВызватьИсключение "Агрегат нельзя совмещать с преобразованием значения";
	КонецЕсли;

	ПроверитьНастройкуВывода();
	Данные.ИмяJSON = ИмяJSON;
	Данные.Агрегат = Агрегат;
	Возврат ЭтотОбъект;

КонецФункции

// Номер бита присутствия, начиная с нуля.
//
// Параметры:
//   Номер - Число - целый номер бита
//
// Возвращаемое значение:
//   ПолеДанныхЖурналаРегистрации - этот построитель
//
Функция Бит(Номер) Экспорт

	Событие.ПроверитьИзменение();
	// Маски должны помещаться в точное десятичное число OneScript (до 38 цифр).
	Если Номер < 0 ИЛИ Номер <> Цел(Номер) ИЛИ Номер > 125 Тогда
		ВызватьИсключение "Недопустимый номер бита";
	КонецЕсли;

	Данные.Бит = Номер;
	Возврат ЭтотОбъект;

КонецФункции

// Следующее поле события.
//
// Параметры:
//   Имя - Строка - имя поля записи
//
// Возвращаемое значение:
//   ПолеДанныхЖурналаРегистрации - построитель следующего поля
//
Функция Поле(Имя) Экспорт

	Возврат Событие.Поле(Имя);

КонецФункции

// Добавляет форму события.
//
// Параметры:
//   ОписаниеФормы - ФормаДанныхЖурналаРегистрации - построитель формы
//
// Возвращаемое значение:
//   СобытиеДанныхЖурналаРегистрации - родитель
//
Функция Форма(ОписаниеФормы) Экспорт

	Возврат Событие.Форма(ОписаниеФормы);

КонецФункции

// Задает аналоги события.
//
// Параметры:
//   Коды - Строка - коды через запятую
//
// Возвращаемое значение:
//   СобытиеДанныхЖурналаРегистрации - родитель
//
Функция Аналоги(Коды) Экспорт

	Возврат Событие.Аналоги(Коды);

КонецФункции

// Задает представление результата события.
//
// Параметры:
//   Представление - Строка - Объект или ПозиционныйКонверт
//
// Возвращаемое значение:
//   СобытиеДанныхЖурналаРегистрации - родитель
//
Функция ФорматJSON(Представление) Экспорт

	Возврат Событие.ФорматJSON(Представление);

КонецФункции

// Завершает регистрацию события.
//
// Возвращаемое значение:
//   Структура - зарегистрированное описание
//
Функция Зарегистрировать() Экспорт

	Возврат Событие.Зарегистрировать();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КодыТипов()

	// Коды скобочного формата внутренние. Например, оба массива имеют тег A,
	// но проверяют разные элементы; T различает массив строк внутри декодера.
	Коды = Новый Соответствие;
	Коды.Вставить("Строка", "S");
	Коды.Вставить("Число", "N");
	Коды.Вставить("Булево", "B");
	Коды.Вставить("Дата", "D");
	Коды.Вставить("Ссылка", "O");
	Коды.Вставить("МассивСсылок", "A");
	Коды.Вставить("МассивСтрок", "T");
	Коды.Вставить("Незаданное", "U");
	Коды.Вставить("Таблица", "Z");

	Возврат Коды;

КонецФункции

Процедура ПроверитьНастройкуВывода()

	Событие.ПроверитьИзменение();
	Если ВыводНастроен Тогда
		ВызватьИсключение "Для поля уже задан способ вывода: " + Данные.Имя;
	КонецЕсли;

	ВыводНастроен = Истина;

КонецПроцедуры

#КонецОбласти

// Параметры:
//   Родитель - СобытиеДанныхЖурналаРегистрации - событие
//   ОписаниеПоля - Структура - текущее поле
//
Процедура ПриСозданииОбъекта(Родитель, ОписаниеПоля)

	Событие = Родитель;
	Данные = ОписаниеПоля;
	ВыводНастроен = Ложь;

КонецПроцедуры
