#native

// Разбор записей журнала регистрации (*.lgp).
//
// Запись - список из 19 значений:
//   0 - дата ГГГГММДДччммсс (местное время), 1 - статус транзакции (N, U, R, C),
//   2 - транзакция {дата, номер} в шестнадцатеричном виде, 3 - код пользователя,
//   4 - код компьютера, 5 - код приложения, 6 - соединение, 7 - код события,
//   8 - важность (I, W, E, N), 9 - комментарий, 10 - код метаданных, 11 - данные,
//   12 - представление данных, 13 - код сервера, 14 - код основного порта,
//   15 - код вспомогательного порта, 16 - сеанс, 17 - не используется,
//   18 - разделение данных сеанса {количество, код разделителя, код значения, ...}.

Перем ДолейСекундыВремениТранзакции; // Число - время транзакции записано в десятитысячных долях секунды
Перем ШестнадцатеричныеЦифры; // Строка - цифры шестнадцатеричной записи по возрастанию
Перем ОснованиеШестнадцатеричное; // Число - основание шестнадцатеричной системы
Перем ДлинаЗначенияСТипом; // Число - элементов в значении поля "Данные": тип и значение
Перем ИндексРазделенияДанных; // Число - индекс поля разделения данных сеанса в записи
Перем ДлинаПарыРазделителя; // Число - код разделителя и код значения в поле разделения данных

#Область ПрограммныйИнтерфейс

// Преобразует запись файла *.lgp в структуру с расшифрованными по словарю значениями.
//
// Параметры:
//   Элемент - Массив - запись, см. ПарсерСкобочногоФормата.Разобрать
//   Словарь - СловарьЖурналаРегистрации - словарь журнала регистрации
//
// Возвращаемое значение:
//   Структура - запись журнала регистрации:
//     * Время - Дата - местное время записи
//     * СтатусТранзакции - Строка - код статуса: N - нет транзакции; в журналах событие
//       _$Transaction$_.Commit записано с C, Rollback - с R, изменения данных в транзакции - с U
//     * ВремяТранзакции - Дата, Неопределено - местное время начала транзакции
//     * НомерТранзакции - Число - номер транзакции
//     * Пользователь - Строка - имя пользователя
//     * ИдПользователя - Строка - идентификатор пользователя
//     * Компьютер - Строка - имя компьютера
//     * Приложение - Строка - имя приложения
//     * Соединение - Число - номер соединения
//     * Событие - Строка - идентификатор события
//     * Важность - Строка - I (информация), W (предупреждение), E (ошибка), N (примечание)
//     * Комментарий - Строка - комментарий
//     * Метаданные - Строка - полное имя объекта метаданных
//     * ИдМетаданных - Строка - идентификатор объекта метаданных
//     * Данные - Строка - строковое представление данных
//     * ПредставлениеДанных - Строка - представление данных
//     * Сервер - Строка - имя рабочего сервера
//     * ОсновнойПорт - Число - основной IP-порт
//     * ВспомогательныйПорт - Число - вспомогательный IP-порт
//     * Сеанс - Число - номер сеанса
//     * РазделениеДанныхСеанса - Соответствие из КлючИЗначение - имя разделителя -> значение
//
Функция ЗаписьЖурнала(Элемент, Словарь) Экспорт

	Запись = Новый Структура;
	Запись.Вставить("Время", ДатаИзСтроки(Элемент[0]));
	Запись.Вставить("СтатусТранзакции", Элемент[1]);

	Транзакция = Элемент[2];
	ВремяТранзакции = ЧислоИзШестнадцатеричного(Транзакция[0]);
	Запись.Вставить("ВремяТранзакции",
		?(ВремяТранзакции = 0, Неопределено, Дата("00010101") + Цел(ВремяТранзакции / ДолейСекундыВремениТранзакции)));
	Запись.Вставить("НомерТранзакции", ЧислоИзШестнадцатеричного(Транзакция[1]));

	Пользователь = Словарь.Пользователь(Число(Элемент[3]));
	Запись.Вставить("Пользователь", Пользователь.Имя);
	Запись.Вставить("ИдПользователя", Пользователь.Ид);
	Запись.Вставить("Компьютер", Словарь.Компьютер(Число(Элемент[4])));
	Запись.Вставить("Приложение", Словарь.Приложение(Число(Элемент[5])));
	Запись.Вставить("Соединение", Число(Элемент[6]));
	Запись.Вставить("Событие", Словарь.Событие(Число(Элемент[7])));
	Запись.Вставить("Важность", Элемент[8]);
	Запись.Вставить("Комментарий", Элемент[9]);

	Метаданные = Словарь.Метаданные(Число(Элемент[10]));
	Запись.Вставить("Метаданные", Метаданные.Имя);
	Запись.Вставить("ИдМетаданных", Метаданные.Ид);

	Запись.Вставить("Данные", ПредставлениеЗначения(Элемент[11]));
	Запись.Вставить("ПредставлениеДанных", Элемент[12]);
	Запись.Вставить("Сервер", Словарь.Сервер(Число(Элемент[13])));
	Запись.Вставить("ОсновнойПорт", Словарь.ОсновнойПорт(Число(Элемент[14])));
	Запись.Вставить("ВспомогательныйПорт", Словарь.ВспомогательныйПорт(Число(Элемент[15])));
	Запись.Вставить("Сеанс", Число(Элемент[16]));
	Запись.Вставить("РазделениеДанныхСеанса", РазделениеДанныхСеанса(Элемент, Словарь));

	Возврат Запись;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДатаИзСтроки(Строка)
	Возврат Дата(Строка);
КонецФункции

Функция ЧислоИзШестнадцатеричного(Знач Строка)

	Строка = НРег(Строка);
	Результат = 0;
	Для Индекс = 1 По СтрДлина(Строка) Цикл
		Цифра = СтрНайти(ШестнадцатеричныеЦифры, Сред(Строка, Индекс, 1)) - 1;
		Если Цифра < 0 Тогда
			Возврат 0;
		КонецЕсли;
		Результат = Результат * ОснованиеШестнадцатеричное + Цифра;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Строковое представление значения поля "Данные": {тип, значение}.
//
// Типы: U - не задано, S - строка, B - булево, N - число, D - дата, R - ссылка,
// P - составное значение {код, значения...}.
//
// Параметры:
//   Значение - Массив, Строка - значение из записи журнала
//
// Возвращаемое значение:
//   Строка - представление значения; пустая строка для незаданного и неизвестного типа
//
Функция ПредставлениеЗначения(Значение)

	Если ТипЗнч(Значение) <> Тип("Массив") Тогда
		Возврат Значение;
	КонецЕсли;

	Если Значение.Количество() < ДлинаЗначенияСТипом Тогда
		Возврат "";
	КонецЕсли;

	ВидЗначения = Значение[0];
	Данные = Значение[1];

	Если ВидЗначения = "S" ИЛИ ВидЗначения = "N" ИЛИ ВидЗначения = "R" Тогда
		Возврат Данные;
	ИначеЕсли ВидЗначения = "B" Тогда
		Возврат ?(Данные = "1", "true", "false");
	ИначеЕсли ВидЗначения = "D" Тогда
		Возврат Формат(ДатаИзСтроки(Данные), "ДФ=yyyy-MM-ddTHH:mm:ss");
	ИначеЕсли ВидЗначения = "P" И ТипЗнч(Данные) = Тип("Массив") Тогда
		Возврат ПредставлениеСоставногоЗначения(Данные);
	Иначе
		// U (не задано) и неизвестные типы
		Возврат "";
	КонецЕсли;

КонецФункции

// Представление составного значения {код, значения...}.
//
// Параметры:
//   Данные - Массив - код и значения
//
// Возвращаемое значение:
//   Строка - заполненные представления значений через "; "
//
Функция ПредставлениеСоставногоЗначения(Данные)
	Части = Новый Массив;
	Для Индекс = 1 По Данные.ВГраница() Цикл
		Часть = ПредставлениеЗначения(Данные[Индекс]);
		Если ЗначениеЗаполнено(Часть) Тогда
			Части.Добавить(Часть);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Части, "; ");
КонецФункции

Функция РазделениеДанныхСеанса(Элемент, Словарь)

	Результат = Новый Соответствие;
	Если Элемент.Количество() <= ИндексРазделенияДанных Тогда
		Возврат Результат;
	КонецЕсли;

	Разделение = Элемент[ИндексРазделенияДанных];
	Если ТипЗнч(Разделение) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;

	Индекс = 1;
	Пока Индекс + 1 <= Разделение.ВГраница() Цикл
		КодРазделителя = Число(Разделение[Индекс]);
		Код = Число(Разделение[Индекс + 1]);
		Результат.Вставить(Словарь.Разделитель(КодРазделителя),
			Словарь.ЗначениеРазделителяПоКоду(КодРазделителя, Код));
		Индекс = Индекс + ДлинаПарыРазделителя;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта()
	ДолейСекундыВремениТранзакции = 10000;
	ШестнадцатеричныеЦифры = "0123456789abcdef";
	ОснованиеШестнадцатеричное = СтрДлина(ШестнадцатеричныеЦифры);
	ДлинаЗначенияСТипом = 2;
	ИндексРазделенияДанных = 18;
	ДлинаПарыРазделителя = 2;
КонецПроцедуры
