// Построитель структуры записи. Пути считаются от тела узла, индексы начинаются с нуля.

Перем Вид; // Строка - Позиционная, Маска, Структура
Перем Корень; // Строка - тип внешнего узла
Перем Маркер; // Строка - точный литерал или маска
Перем Выбор; // Строка - Все, Кроме, Явно
Перем Выбранные; // Массив из Строка - выбранные или исключенные имена
Перем Пути; // Соответствие - имя поля -> путь
Перем Условия; // Массив из Структура - проверки вложенных узлов
Перем Арность; // Число, Неопределено - явный размер тела

#Область ПрограммныйИнтерфейс

// Выбирает все поля в порядке объявления.
//
// Возвращаемое значение:
//   ФормаДанныхЖурналаРегистрации - этот построитель
//
Функция ВсеПоля() Экспорт

	ПроверитьВыбор();
	Выбор = "Все";
	Возврат ЭтотОбъект;

КонецФункции

// Исключает физически отсутствующие поля, сохраняя порядок остальных.
//
// Параметры:
//   Имена - Строка, Массив из Строка - имена исключаемых полей
//
// Возвращаемое значение:
//   ФормаДанныхЖурналаРегистрации - этот построитель
//
Функция ВсеПоляКроме(Имена) Экспорт

	ПроверитьВыбор();
	Выбор = "Кроме";
	Выбранные = СписокИмен(Имена);
	Возврат ЭтотОбъект;

КонецФункции

// Задает поля в явном порядке чтения.
//
// Параметры:
//   Имена - Строка, Массив из Строка - упорядоченные имена
//
// Возвращаемое значение:
//   ФормаДанныхЖурналаРегистрации - этот построитель
//
Функция Поля(Имена) Экспорт

	ПроверитьВыбор();
	Выбор = "Явно";
	Выбранные = СписокИмен(Имена);
	Возврат ЭтотОбъект;

КонецФункции

// Добавляет поле в явный список формы.
//
// Параметры:
//   Имя - Строка - идентификатор поля события
//
// Возвращаемое значение:
//   ФормаДанныхЖурналаРегистрации - этот построитель
//
Функция Поле(Имя) Экспорт

	Если Выбор = "" Тогда
		ПроверитьВыбор();
		Выбор = "Явно";
	ИначеЕсли Выбор <> "Явно" Тогда
		ВызватьИсключение "Нельзя смешивать способы выбора полей формы";
	КонецЕсли;
	Выбранные.Добавить(Имя);
	Возврат ЭтотОбъект;

КонецФункции

// Добавляет поле по вложенному пути.
//
// Параметры:
//   Имя - Строка - идентификатор поля
//   Путь - Строка - индексы через точку от тела узла
//
// Возвращаемое значение:
//   ФормаДанныхЖурналаРегистрации - этот построитель
//
Функция ПолеПоПути(Имя, Путь) Экспорт

	Поле(Имя);
	Пути.Вставить(Имя, РазобратьПуть(Путь));
	Возврат ЭтотОбъект;

КонецФункции

// Задает точное число элементов тела.
//
// Параметры:
//   Количество - Число - размер тела
//
// Возвращаемое значение:
//   ФормаДанныхЖурналаРегистрации - этот построитель
//
Функция Размер(Количество) Экспорт

	Если Вид <> "Структура" Тогда
		ВызватьИсключение "Размер позиционной формы определяется выбранными полями";
	КонецЕсли;
	Если Количество < 0 ИЛИ Количество <> Цел(Количество) Тогда
		ВызватьИсключение "Размер узла должен быть целым неотрицательным числом";
	КонецЕсли;
	Арность = Количество;
	Возврат ЭтотОбъект;

КонецФункции

// Задает точный размер вложенного списка.
//
// Параметры:
//   Путь - Строка - индексы через точку
//   Количество - Число - размер списка
//
// Возвращаемое значение:
//   ФормаДанныхЖурналаРегистрации - этот построитель
//
Функция РазмерУзла(Путь, Количество) Экспорт

	Если Количество < 0 ИЛИ Количество <> Цел(Количество) Тогда
		ВызватьИсключение "Размер узла должен быть целым неотрицательным числом";
	КонецЕсли;
	Условия.Добавить(Новый Структура("Путь, Арность, Литералы", РазобратьПуть(Путь), Количество, Новый Массив));
	Возврат ЭтотОбъект;

КонецФункции

// Проверяет литерал вложенного узла.
//
// Параметры:
//   Путь - Строка - индексы через точку
//   Значения - Строка - допустимые литералы через |
//
// Возвращаемое значение:
//   ФормаДанныхЖурналаРегистрации - этот построитель
//
Функция Литерал(Путь, Значения) Экспорт

	Условия.Добавить(Новый Структура("Путь, Арность, Литералы", РазобратьПуть(Путь), Неопределено, СтрРазделить(Значения, "|")));
	Возврат ЭтотОбъект;

КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Собирает самостоятельное описание и проверяет ссылки на поля.
//
// Параметры:
//   Событие - Структура - поля и представление события
//
// Возвращаемое значение:
//   Структура - описание формы для декодера
//
Функция Собрать(Событие) Экспорт

	Если Вид = "Структура" И Арность = Неопределено Тогда
		ВызватьИсключение "Не задан размер структурной формы";
	КонецЕсли;
	ПоИменам = Новый Соответствие;
	ПоБитам = Новый Соответствие;
	Для Каждого Описание Из Событие.Поля Цикл
		ПоИменам.Вставить(Описание.Имя, Описание);
		Если Описание.Бит <> Неопределено Тогда
			Если ПоБитам[Описание.Бит] <> Неопределено Тогда
				ВызватьИсключение "Повторный бит присутствия поля";
			КонецЕсли;
			ПоБитам.Вставить(Описание.Бит, Описание.Имя);
		КонецЕсли;
	КонецЦикла;

	Имена = ИменаФормы(Событие.Поля, ПоИменам, ПоБитам);
	Смещение = ?(Маркер = "", 0, 1);
	ОжидаемыйРазмер = ?(Арность = Неопределено, Имена.Количество() + Смещение, Арность);
	ПоляФормы = Новый Массив;
	Использованные = Новый Соответствие;
	Выходные = Новый Соответствие;
	Типы = "";
	Для Индекс = 0 По Имена.ВГраница() Цикл
		Имя = Имена[Индекс];
		Источник = ПоИменам[Имя];
		Если Источник = Неопределено Тогда
			ВызватьИсключение "Неизвестное поле формы: " + Имя;
		КонецЕсли;
		Если Использованные[Имя] <> Неопределено Тогда
			ВызватьИсключение "Повторное поле формы: " + Имя;
		КонецЕсли;
		Использованные.Вставить(Имя, Истина);
		Если НЕ Источник.Пропуск Тогда
			Если Выходные[Источник.ИмяJSON] <> Неопределено Тогда
				ВызватьИсключение "Повторный ключ JSON: " + Источник.ИмяJSON;
			КонецЕсли;
			Выходные.Вставить(Источник.ИмяJSON, Истина);
		КонецЕсли;
		Путь = Пути[Имя];
		Если Путь = Неопределено Тогда
			Путь = Новый Массив;
			Путь.Добавить(Индекс + Смещение);
		КонецЕсли;
		Если Путь.Количество() = 0 ИЛИ Путь[0] >= ОжидаемыйРазмер Тогда
			ВызватьИсключение "Путь поля выходит за границы формы: " + Имя;
		КонецЕсли;
		ПоляФормы.Добавить(Новый Структура("Имя, ИмяJSON, Тип, Значения, Преобразование, Агрегат, Пропуск, Путь",
			Имя, Источник.ИмяJSON, Источник.Тип, Источник.Значения, Источник.Преобразование,
			Источник.Агрегат, Источник.Пропуск, КопияМассива(Путь)));
		Типы = Типы + Источник.Тип;
	КонецЦикла;
	Проверки = Новый Массив;
	Для Каждого Условие Из Условия Цикл
		Проверки.Добавить(Новый Структура("Путь, Арность, Литералы",
			КопияМассива(Условие.Путь), Условие.Арность, КопияМассива(Условие.Литералы)));
	КонецЦикла;
	Возврат Новый Структура("Корень, Вид, Маска, Смещение, Арность, Имена, Типы, Поля, Условия, Представление",
		Корень, Вид, Маркер, Смещение, ОжидаемыйРазмер, Имена, Типы, ПоляФормы, Проверки, Событие.Представление);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьВыбор()

	Если Вид = "Маска" Тогда
		ВызватьИсключение "В битовой форме поля определяются маской";
	КонецЕсли;
	Если Выбор <> "" Тогда
		ВызватьИсключение "Способ выбора полей формы уже задан";
	КонецЕсли;

КонецПроцедуры

Функция ИменаФормы(ПоляСобытия, ПоИменам, ПоБитам)

	Результат = Новый Массив;
	Если Вид = "Маска" Тогда
		Остаток = Число(Маркер);
		Если Остаток < 0 ИЛИ Остаток <> Цел(Остаток) ИЛИ Формат(Остаток, "ЧГ=0;ЧН=0") <> Маркер Тогда
			ВызватьИсключение "Недопустимая битовая маска: " + Маркер;
		КонецЕсли;
		Бит = 0;
		Пока Остаток > 0 Цикл
			Если Остаток % 2 = 1 Тогда
				Имя = ПоБитам[Бит];
				Если Имя = Неопределено Тогда
					ВызватьИсключение "Неизвестный бит маски: " + Бит;
				КонецЕсли;
				Результат.Добавить(Имя);
			КонецЕсли;
			Бит = Бит + 1;
			Остаток = Цел(Остаток / 2);
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;
	Для Каждого Имя Из Выбранные Цикл
		Если ПоИменам[Имя] = Неопределено Тогда
			ВызватьИсключение "Неизвестное поле формы: " + Имя;
		КонецЕсли;
	КонецЦикла;
	Если Выбор = "Явно" Тогда
		Возврат КопияМассива(Выбранные);
	КонецЕсли;
	Для Каждого Описание Из ПоляСобытия Цикл
		Если Выбор <> "Кроме" ИЛИ Выбранные.Найти(Описание.Имя) = Неопределено Тогда
			Результат.Добавить(Описание.Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция СписокИмен(Имена)

	Результат = Новый Массив;
	Источник = ?(ТипЗнч(Имена) = Тип("Строка"), СтрРазделить(Имена, ",", Ложь), Имена);
	Для Каждого Имя Из Источник Цикл
		Имя = СокрЛП(Имя);
		Если Имя = "" ИЛИ Результат.Найти(Имя) <> Неопределено Тогда
			ВызватьИсключение "Повторное или пустое имя поля формы";
		КонецЕсли;
		Результат.Добавить(Имя);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция РазобратьПуть(Путь)

	Результат = Новый Массив;
	Для Каждого Часть Из СтрРазделить(Путь, ".", Ложь) Цикл
		Индекс = Число(Часть);
		Если Индекс < 0 ИЛИ Индекс <> Цел(Индекс) Тогда
			ВызватьИсключение "Недопустимый индекс в пути";
		КонецЕсли;
		Результат.Добавить(Индекс);
	КонецЦикла;
	Если Результат.Количество() = 0 Тогда
		ВызватьИсключение "Путь не может быть пустым";
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция КопияМассива(Источник)

	Результат = Новый Массив;
	Для Каждого Элемент Из Источник Цикл
		Результат.Добавить(Элемент);
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

// Параметры:
//   Способ - Строка - способ выбора полей
//   ТипКорня - Строка - тип внешнего узла
//   ПервыйЛитерал - Строка - точный маркер или маска
//
Процедура ПриСозданииОбъекта(Способ, ТипКорня, ПервыйЛитерал)

	Если Способ <> "Позиционная" И Способ <> "Маска" И Способ <> "Структура" Тогда
		ВызватьИсключение "Неизвестный способ описания формы: " + Способ;
	КонецЕсли;
	Если ТипКорня = "" Тогда
		ВызватьИсключение "Не задан тип корневого узла";
	КонецЕсли;
	Вид = Способ;
	Корень = ТипКорня;
	Маркер = ПервыйЛитерал;
	Выбор = "";
	Выбранные = Новый Массив;
	Пути = Новый Соответствие;
	Условия = Новый Массив;
	Арность = Неопределено;

КонецПроцедуры
