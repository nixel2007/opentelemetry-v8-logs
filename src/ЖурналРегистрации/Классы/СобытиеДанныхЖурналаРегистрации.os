// Построитель поддерживаемых форм одного события и его аналогов.

Перем Реестр; // ПоляДанныхСобытийЖурналаРегистрации - получатель описания
Перем Данные; // Структура - коды, поля, формы, представление
Перем Завершено; // Булево - описание уже зарегистрировано

#Область ПрограммныйИнтерфейс

// Задает другие коды с теми же полями и формами.
//
// Параметры:
//   Коды - Строка - коды через запятую
//
// Возвращаемое значение:
//   СобытиеДанныхЖурналаРегистрации - этот построитель
//
Функция Аналоги(Коды) Экспорт

	ПроверитьИзменение();
	Для Каждого Код Из СтрРазделить(Коды, ",", Ложь) Цикл
		Данные.Коды.Добавить(СокрЛП(Код));
	КонецЦикла;
	Возврат ЭтотОбъект;

КонецФункции

// Объявляет поле в порядке полной позиционной записи.
//
// Параметры:
//   Имя - Строка - идентификатор поля
//
// Возвращаемое значение:
//   ПолеДанныхЖурналаРегистрации - построитель текущего поля
//
Функция Поле(Имя) Экспорт

	ПроверитьИзменение();
	Если Имя = "" Тогда
		ВызватьИсключение "Имя поля не может быть пустым";
	КонецЕсли;
	Для Каждого ПолеСобытия Из Данные.Поля Цикл
		Если ПолеСобытия.Имя = Имя Тогда
			ВызватьИсключение "Повторное поле: " + Имя;
		КонецЕсли;
	КонецЦикла;
	Описание = Новый Структура("Тип, Значения, Преобразование", "", Новый Соответствие, "");
	Описание.Вставить("Имя", Имя);
	Описание.Вставить("ИмяJSON", Имя);
	Описание.Вставить("Агрегат", "");
	Описание.Вставить("Пропуск", Ложь);
	Описание.Вставить("Бит", Неопределено);
	Данные.Поля.Добавить(Описание);
	Возврат Новый ПолеДанныхЖурналаРегистрации(ЭтотОбъект, Описание);

КонецФункции

// Добавляет допустимую форму записи.
//
// Параметры:
//   ОписаниеФормы - ФормаДанныхЖурналаРегистрации - построитель формы
//
// Возвращаемое значение:
//   СобытиеДанныхЖурналаРегистрации - этот построитель
//
Функция Форма(ОписаниеФормы) Экспорт

	ПроверитьИзменение();
	Данные.Формы.Добавить(ОписаниеФормы);
	Возврат ЭтотОбъект;

КонецФункции

// Представление JSON; по умолчанию обычный объект.
//
// Параметры:
//   Представление - Строка - Объект или ПозиционныйКонверт
//
// Возвращаемое значение:
//   СобытиеДанныхЖурналаРегистрации - этот построитель
//
Функция ФорматJSON(Представление) Экспорт

	ПроверитьИзменение();
	Если Представление <> "Объект" И Представление <> "ПозиционныйКонверт" Тогда
		ВызватьИсключение "Неизвестный формат JSON: " + Представление;
	КонецЕсли;
	Данные.Представление = Представление;
	Возврат ЭтотОбъект;

КонецФункции

// Проверяет описание и регистрирует готовые формы.
//
// Возвращаемое значение:
//   Структура - зарегистрированное описание
//
Функция Зарегистрировать() Экспорт

	ПроверитьИзменение();
	Если Данные.Формы.Количество() = 0 Тогда
		ВызватьИсключение "У события нет форм записи";
	КонецЕсли;
	Для Каждого Поле Из Данные.Поля Цикл
		Если Поле.Тип = "" Тогда
			ВызватьИсключение "Не задан тип поля: " + Поле.Имя;
		КонецЕсли;
	КонецЦикла;
	Формы = Новый Массив;
	Для Каждого Построитель Из Данные.Формы Цикл
		Формы.Добавить(Построитель.Собрать(Данные));
	КонецЦикла;
	Описание = Новый Структура("Коды, Поля, Формы", Данные.Коды, Данные.Поля, Формы);
	Реестр.ДобавитьОписание(Описание);
	Завершено = Истина;
	Возврат Описание;

КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Запрещает изменение зарегистрированного построителя.
Процедура ПроверитьИзменение() Экспорт

	Если Завершено Тогда
		ВызватьИсключение "Описание события уже зарегистрировано";
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

// Параметры:
//   Получатель - ПоляДанныхСобытийЖурналаРегистрации - реестр
//   Код - Строка - код события
//
Процедура ПриСозданииОбъекта(Получатель, Код)

	Если Код = "" Тогда
		ВызватьИсключение "Код события не может быть пустым";
	КонецЕсли;
	Реестр = Получатель;
	Коды = Новый Массив;
	Коды.Добавить(Код);
	Данные = Новый Структура("Коды, Поля, Формы, Представление", Коды, Новый Массив, Новый Массив, "Объект");
	Завершено = Ложь;

КонецПроцедуры
