#native
#Использовать autumn
#Использовать autumn-logos
#Использовать autumn-opentelemetry
#Использовать collectionos
#Использовать "../../Чтение"
#Использовать "../../ТехнологическийЖурнал"
#Использовать "../../ЖурналРегистрации"
#Использовать "../../Экспорт"
#Использовать "../../Конвейер"
#Использовать "../../Кластер"

// Коллектор: периодически дочитывает технологические журналы и журналы регистрации
// и передает их в OpenTelemetry через SDK из настроек otel, см. ЗаданияКоллектора.
//
// Телеметрия самого коллектора идет с otel.service.name, данные журналов - со своим ресурсом
// и service.name из otel.v8-logs.service.name, см. ТелеметрияЖурналов.
//
// Настройки (autumn-properties.json), по образцу otel.entity.* в autumn-opentelemetry:
//   otel.v8-logs.service.name - service.name данных журналов (по умолчанию 1c)
//   otel.v8-logs.resource.attributes - атрибуты ресурса данных журналов (ключ=значение через запятую)
//   otel.v8-logs.techlog - Массив - каталоги технологического журнала:
//     path - каталог (location в logcfg.xml); service-name - service.name данных источника;
//     infobase - база событий без p:processName (например, файловой базы); timezone, start-from-end
//   otel.v8-logs.eventlog - Массив - каталоги журнала регистрации (1Cv8Log):
//     path - каталог; infobase - имя информационной базы; service-name, timezone, start-from-end
//   otel.v8-logs.timezone - часовой пояс серверов 1С (по умолчанию часовой пояс машины)
//   otel.v8-logs.start-from-end - при первом запуске пропустить накопленные данные (по умолчанию false)
//   otel.v8-logs.interval - пауза между проходами без новых данных, секунд (по умолчанию 5)
//   otel.v8-logs.batch-size - записей между сбросами буферов телеметрии (по умолчанию 1000)
//   otel.v8-logs.traces.enabled - собирать трассы вызовов из технологического журнала (по умолчанию true)
//   otel.v8-logs.traces.root-events - события-корни трасс (по умолчанию CALL)
//   otel.v8-logs.returned-rows.enabled - записывать db.response.returned_rows у событий СУБД
//     (по умолчанию true)
//   otel.v8-logs.session-id.enabled - записывать session.id (по умолчанию true)
//   otel.v8-logs.semconv-duplicates.skip.enabled - не записывать v8.techlog.* и v8.eventlog.*, значение
//     которых целиком записано атрибутом семантических соглашений (по умолчанию true)
//   otel.v8-logs.cluster - Массив - серверы RAS для метрик кластеров 1С:
//     ras - адрес RAS хост:порт (порт по умолчанию 1545; пусто - кластер не опрашивается);
//     user, password - администратор кластера; agent-user, agent-password - администратор агента кластера;
//     interval - период опроса, секунд (по умолчанию 30); timeout - предел ожидания ответа RAS, мс (10000);
//     service-name - service.name метрик кластера (по умолчанию otel.v8-logs.service.name; у кластеров разные);
//     long-call-thresholds - пороги долгих вызовов, секунд, через запятую (по умолчанию 60,3600);
//     infobases - Массив - администраторы информационных баз: name, user, password;
//     session-log - писать снимки сеансов записями лога (по умолчанию true);
//     timezone - часовой пояс серверов кластера (по умолчанию otel.v8-logs.timezone)

Перем Лог; // Лог - лог коллектора
Перем Сдк; // ОтелSdk - SDK OpenTelemetry из настроек otel
Перем Телеметрия; // ТелеметрияЖурналов - провайдеры телеметрии данных журналов
Перем КонвейерТЖ; // КонвейерЖурналов - технологические журналы и их экспортеры
Перем КонвейерЖР; // КонвейерЖурналов - журналы регистрации и их экспортеры
Перем ЕстьТЖ; // Булево - в настройках есть технологические журналы
Перем ЕстьЖР; // Булево - в настройках есть журналы регистрации
Перем Задания; // ЗаданияКоллектора - фоновые задания чтения журналов и опроса кластеров
Перем ИнтервалПаузыМс; // Число - пауза между проходами без новых данных
Перем МаксимумБайтПорции; // Число - объем данных, читаемый из файла журнала за одну порцию
Перем ТабакеркаЧитателейТЖ; // Табакерка - ЧитательТехнологическогоЖурнала
Перем ТабакеркаЭкспортеровТЖ; // Табакерка - ЭкспортерТехнологическогоЖурнала
Перем ТабакеркаЧитателейЖР; // Табакерка - ЧитательЖурналаРегистрации
Перем ТабакеркаЭкспортеровЖР; // Табакерка - ЭкспортерЖурналаРегистрации
Перем Кластеры; // Массив из Структура - опрашиваемые кластеры 1С, см. НовыйКластер; пуст - опрос выключен

#Область ПрограммныйИнтерфейс

// Выполняет один проход по всем журналам.
//
// Возвращаемое значение:
//   Число - количество переданных записей
//
Функция ВыполнитьПроход() Экспорт
	Возврат КонвейерТЖ.ВыполнитьПроход() + КонвейерЖР.ВыполнитьПроход();
КонецФункции

// Запускает чтение журналов и опрос кластеров. Без однократного запуска работает до Остановить()
// или до сбоя одного из фоновых заданий.
//
// Параметры:
//   Однократно - Булево - выполнить один проход и опрос в текущем потоке и завершить работу
//
// Исключения:
//   Текст ошибки сбойного фонового задания - после остановки остальных заданий и Завершить()
//
Процедура Запустить(Однократно = Ложь) Экспорт

	Лог.Информация("Запуск чтения журналов 1С");

	Если Однократно Тогда
		Количество = ВыполнитьПроход();
		Если Количество > 0 Тогда
			Лог.Отладка("Передано записей: %1", Количество);
		КонецЕсли;
		ОпроситьКластер();
		Завершить();
		Возврат;
	КонецЕсли;

	Если ЕстьТЖ Тогда
		ДобавитьЗаданиеЧтения(КонвейерТЖ, "технологический журнал");
	КонецЕсли;
	Если ЕстьЖР Тогда
		ДобавитьЗаданиеЧтения(КонвейерЖР, "журнал регистрации");
	КонецЕсли;
	Если Кластеры.Количество() > 0 Тогда
		Задания.Добавить("кластер", ЭтотОбъект, "ЦиклОпросаКластеров", Новый Массив);
	КонецЕсли;
	Если НЕ ЕстьТЖ И НЕ ЕстьЖР И Кластеры.Количество() = 0 Тогда
		Лог.Предупреждение("Нет источников журналов и кластеров — нечего запускать");
	КонецЕсли;

	ТекстСбоя = Задания.ЗапуститьИДождаться();
	Завершить();
	Если ТекстСбоя <> "" Тогда
		ВызватьИсключение ТекстСбоя;
	КонецЕсли;

КонецПроцедуры

// Останавливает фоновые задания, запущенные Запустить(): они завершаются после текущего прохода или опроса.
//
Процедура Остановить() Экспорт
	Задания.Остановить();
КонецПроцедуры

// Служебный: тело фонового задания чтения журналов.
//
// Параметры:
//   Конвейер - КонвейерЖурналов - журналы задания
//   Название - Строка - название задания
//
Процедура ЦиклЧтенияЖурналов(Конвейер, Название) Экспорт
	// Исключение .NET из задания вылетело бы из ожидания заданий без названия задания
	Попытка
		Пока НЕ Задания.ЗапрошенаОстановка() Цикл
			Количество = Конвейер.ВыполнитьПроход();
			// Пока журналы отстают, следующий проход начинается сразу
			Если Количество > 0 Тогда
				Лог.Отладка("%1: передано записей: %2", Название, Количество);
			Иначе
				Задания.Пауза(ИнтервалПаузыМс);
			КонецЕсли;
		КонецЦикла;
	Исключение
		ВызватьИсключение ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
КонецПроцедуры

// Служебный: тело фонового задания опроса кластеров; период опроса у каждого кластера свой.
//
Процедура ЦиклОпросаКластеров() Экспорт
	ИнтервалПроверкиМс = 1000;
	Попытка
		Пока НЕ Задания.ЗапрошенаОстановка() Цикл
			ОпроситьКластер();
			Задания.Пауза(ИнтервалПроверкиМс);
		КонецЦикла;
	Исключение
		ВызватьИсключение ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
КонецПроцедуры

// Снимает показатели каждого кластера из настроек и передает их его экспортеру метрик, а сеансы - экспортеру
// сеансов, если с прошлого опроса кластера прошел его период опроса.
//
Процедура ОпроситьКластер() Экспорт
	Для Каждого Кластер Из Кластеры Цикл
		ОпроситьОдинКластер(Кластер);
	КонецЦикла;
КонецПроцедуры

// Сбрасывает буферы, закрывает телеметрию данных и SDK OpenTelemetry.
//
Процедура Завершить() Экспорт
	Лог.Информация("Завершение чтения журналов 1С");
	КонвейерТЖ.Закрыть();
	КонвейерЖР.Закрыть();
	Телеметрия.Закрыть();
	Сдк.Закрыть();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Параметры фонового задания - Массив: фиксированный массив ФоновыеЗадания не принимают.
Процедура ДобавитьЗаданиеЧтения(Конвейер, Название)
	Параметры = Новый Массив;
	Параметры.Добавить(Конвейер);
	Параметры.Добавить(Название);
	Задания.Добавить(Название, ЭтотОбъект, "ЦиклЧтенияЖурналов", Параметры);
КонецПроцедуры

Процедура ДобавитьТехнологическиеЖурналы(Источники, Хранилище, ОбщиеПараметры)

	Если Источники = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Источник Из МассивИсточников(Источники) Цикл
		Каталог = КаталогИсточника(Источник);
		Лог.Информация("Технологический журнал: %1", Каталог);

		НачинатьСКонца = НачинатьСКонцаИсточника(Источник, ОбщиеПараметры);
		ПараметрыЧитателя = Массивы.ИзЭлементов(Каталог, Хранилище, НачинатьСКонца, МаксимумБайтПорции);

		ИмяСервиса = ИмяСервисаИсточника(Источник);
		ЧасовойПоясСервера = ЧасовойПоясИсточника(Источник, ОбщиеПараметры);
		ИнформационнаяБаза = СтрокаНастройки(Источник["infobase"]);
		РежимТрасс = ЗначениеИлиОбщее(Источник["traces-mode"], ОбщиеПараметры.РежимТрасс);
		ПараметрыЭкспортера = Массивы.ИзЭлементов(Телеметрия, ИмяСервиса, ЧасовойПоясСервера, ИнформационнаяБаза,
			ОбщиеПараметры.ТрассыВключены, ОбщиеПараметры.КорневыеСобытия, РежимТрасс,
			ОбщиеПараметры.ВозвращенныеСтрокиВключены, ОбщиеПараметры.ИдСеансаВключен, ОбщиеПараметры.ПропускатьДубли);

		КонвейерТЖ.Добавить(ТабакеркаЧитателейТЖ.Достать(ПараметрыЧитателя),
			ТабакеркаЭкспортеровТЖ.Достать(ПараметрыЭкспортера));
		ЕстьТЖ = Истина;
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьЖурналыРегистрации(Источники, Хранилище, ОбщиеПараметры)

	Если Источники = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Источник Из МассивИсточников(Источники) Цикл
		Каталог = КаталогИсточника(Источник);
		Лог.Информация("Журнал регистрации: %1", Каталог);

		ИмяБазы = СтрокаНастройки(Источник["infobase"]);
		НачинатьСКонца = НачинатьСКонцаИсточника(Источник, ОбщиеПараметры);
		ПараметрыЧитателя = Массивы.ИзЭлементов(Каталог, Хранилище, ИмяБазы, НачинатьСКонца, МаксимумБайтПорции);

		ИмяСервиса = ИмяСервисаИсточника(Источник);
		ЧасовойПоясСервера = ЧасовойПоясИсточника(Источник, ОбщиеПараметры);
		ПараметрыЭкспортера = Массивы.ИзЭлементов(Телеметрия, ИмяСервиса, ЧасовойПоясСервера,
			ОбщиеПараметры.ИдСеансаВключен, ОбщиеПараметры.ПропускатьДубли);

		КонвейерЖР.Добавить(ТабакеркаЧитателейЖР.Достать(ПараметрыЧитателя),
			ТабакеркаЭкспортеровЖР.Достать(ПараметрыЭкспортера));
		ЕстьЖР = Истина;
	КонецЦикла;

КонецПроцедуры

Процедура ОпроситьОдинКластер(Кластер)

	Сейчас = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Если Кластер.МоментОпросаМс <> Неопределено И Сейчас - Кластер.МоментОпросаМс < Кластер.ИнтервалОпросаМс Тогда
		Возврат;
	КонецЕсли;
	Кластер.МоментОпросаМс = Сейчас;

	Попытка
		Снимок = Кластер.Опросчик.Снять();
		Кластер.Экспортер.Обновить(Снимок);
	Исключение
		Лог.Ошибка("Ошибка опроса кластера %1: %2", Кластер.Адрес, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Кластер.Экспортер.Сбросить();
		Возврат;
	КонецПопытки;

	ЗалогироватьДоступностьКластера(Кластер, Снимок);
	ЗалогироватьПредупрежденияКластера(Кластер, Снимок.Предупреждения);
	ЗаписатьСеансыКластера(Кластер, Снимок);

КонецПроцедуры

Процедура ПодключитьКластеры(Настройки, ИмяСервисаДанных, ЧасовойПояс, Табакерки)

	Кластеры = Новый Массив;
	Если Настройки = Неопределено ИЛИ Настройки = "" Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Настройка Из МассивИсточников(Настройки) Цикл
		Кластер = НовыйКластер(Настройка, ИмяСервисаДанных, ЧасовойПояс, Табакерки);
		Если Кластер = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Другой Из Кластеры Цикл
			Если Другой.ИмяСервиса = Кластер.ИмяСервиса Тогда
				ВызватьИсключение СтрШаблон("В настройке otel.v8-logs.cluster.service-name у кластеров %1 и %2 одно значение "
					+ "«%3»: метрики кластеров под одним service.name неразличимы", Другой.Адрес, Кластер.Адрес, Кластер.ИмяСервиса);
			КонецЕсли;
		КонецЦикла;
		Кластеры.Добавить(Кластер);
	КонецЦикла;

КонецПроцедуры

// Кластер из объекта настройки otel.v8-logs.cluster.
//
// Параметры:
//   Настройка - Соответствие - элемент настройки otel.v8-logs.cluster
//   ИмяСервисаДанных - Строка - service.name по умолчанию
//   ЧасовойПояс - Строка - часовой пояс серверов по умолчанию, настройка otel.v8-logs.timezone
//   Табакерки - Структура - Опросчиков, Экспортеров, ЭкспортеровСеансов
//
// Возвращаемое значение:
//   Структура, Неопределено - опрашиваемый кластер; Неопределено, если адрес RAS пуст
//
Функция НовыйКластер(Настройка, ИмяСервисаДанных, ЧасовойПояс, Табакерки)

	Адрес = СокрЛП(СтрокаНастройки(ПолеНастройки(Настройка, "ras")));
	Если Адрес = "" Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПозицияПорта = СтрНайти(Адрес, ":", НаправлениеПоиска.СКонца);
	Если ПозицияПорта = 0 Тогда
		Хост = Адрес;
		ТекстПорта = "1545";
	Иначе
		Хост = Лев(Адрес, ПозицияПорта - 1);
		ТекстПорта = Сред(Адрес, ПозицияПорта + 1);
	КонецЕсли;
	Если Хост = "" ИЛИ Не ЦелоеБольшеНуля(ТекстПорта) Тогда
		ВызватьИсключение СтрШаблон("В настройке otel.v8-logs.cluster.ras неверный адрес «%1»: нужно хост или хост:порт, "
			+ "порт - целое число больше нуля", Адрес);
	КонецЕсли;
	Порт = Число(ТекстПорта);

	// Интервал блокировки начала сеансов RAS отдает в местном времени серверов кластера
	ПоясКластера = ЗначениеИлиОбщее(ПолеНастройки(Настройка, "timezone"), ЧасовойПояс);
	Если НЕ ЧасовойПоясИзвестен(ПоясКластера) Тогда
		ВызватьИсключение СтрШаблон("В настройке otel.v8-logs.cluster.timezone неизвестный часовой пояс «%1»: "
			+ "нужен идентификатор IANA, Windows или GMT+ЧЧ:ММ", ПоясКластера);
	КонецЕсли;

	Кластер = Новый Структура;
	Кластер.Вставить("Адрес", СтрШаблон("%1:%2", Хост, ТекстПорта));
	Кластер.Вставить("ИмяСервиса", ЗначениеНастройки(Настройка, "service-name", ИмяСервисаДанных));
	Кластер.Вставить("ИнтервалОпросаМс", Число(ЗначениеНастройки(Настройка, "interval", 30)) * 1000);
	Кластер.Вставить("МоментОпросаМс", Неопределено);
	Кластер.Вставить("БылДоступен", Неопределено);
	Кластер.Вставить("Предупреждения", "");
	Лог.Информация("Кластер 1С: %1, service.name: %2", Кластер.Адрес, Кластер.ИмяСервиса);

	Кластер.Вставить("Опросчик", Табакерки.Опросчиков.Достать(Массивы.ИзЭлементов(Хост, Порт,
		СтрокаНастройки(ПолеНастройки(Настройка, "user")), СтрокаНастройки(ПолеНастройки(Настройка, "password")),
		СтрокаНастройки(ПолеНастройки(Настройка, "agent-user")), СтрокаНастройки(ПолеНастройки(Настройка, "agent-password")),
		Число(ЗначениеНастройки(Настройка, "timeout", 10000)),
		ПорогиДлительности(ЗначениеНастройки(Настройка, "long-call-thresholds", "60,3600")),
		УчетныеДанныеБаз(ПолеНастройки(Настройка, "infobases")), ПоясКластера)));
	ПараметрыЭкспортера = Массивы.ИзЭлементов(Телеметрия, Кластер.ИмяСервиса);
	Кластер.Вставить("Экспортер", Табакерки.Экспортеров.Достать(ПараметрыЭкспортера));
	ЭкспортерСеансов = Неопределено;
	Если ЭтоИстина(ЗначениеНастройки(Настройка, "session-log", Истина)) Тогда
		ЭкспортерСеансов = Табакерки.ЭкспортеровСеансов.Достать(ПараметрыЭкспортера);
	КонецЕсли;
	Кластер.Вставить("ЭкспортерСеансов", ЭкспортерСеансов);
	Возврат Кластер;

КонецФункции

Функция ЗначениеНастройки(Объект, Имя, ПоУмолчанию)
	Возврат ЗначениеИлиОбщее(ПолеНастройки(Объект, Имя), ПоУмолчанию);
КонецФункции

Функция ПорогиДлительности(Значение)

	Если ТипЗнч(Значение) = Тип("Массив") ИЛИ ТипЗнч(Значение) = Тип("ФиксированныйМассив") Тогда
		Части = Значение;
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		Части = Массивы.ИзЭлементов(Значение);
	Иначе
		Части = СтрРазделить(СтрокаНастройки(Значение), ",", Ложь);
	КонецЕсли;

	Пороги = Новый Массив;
	Для Каждого Часть Из Части Цикл
		Текст = СокрЛП(Строка(Часть));
		Если Текст = "" Тогда
			Продолжить;
		КонецЕсли;
		Если Не ЦелоеБольшеНуля(Текст) Тогда
			ВызватьИсключение СтрШаблон("В настройке otel.v8-logs.cluster.long-call-thresholds неверный порог «%1»: "
				+ "нужно целое число секунд больше нуля", Текст);
		КонецЕсли;
		Порог = Число(Текст);
		Если Пороги.Найти(Порог) = Неопределено Тогда
			Пороги.Добавить(Порог);
		КонецЕсли;
	КонецЦикла;
	Возврат Пороги;

КонецФункции

Функция ЦелоеБольшеНуля(Текст)
	Если Текст = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Если СтрНайти("0123456789", Сред(Текст, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Число(Текст) > 0;
КонецФункции

Функция УчетныеДанныеБаз(Базы)

	УчётныеДанные = Новый Соответствие;
	Если Базы = Неопределено ИЛИ Базы = "" Тогда
		Возврат УчётныеДанные;
	КонецЕсли;

	Для Каждого База Из МассивИсточников(Базы) Цикл
		ИмяБазы = СтрокаНастройки(ПолеНастройки(База, "name"));
		Если ИмяБазы = "" Тогда
			ВызватьИсключение "В настройках otel.v8-logs.cluster.infobases не указано имя базы (name)";
		КонецЕсли;
		УчётныеДанные.Вставить(ИмяБазы, Новый Структура("Пользователь, Пароль",
			СтрокаНастройки(ПолеНастройки(База, "user")), СтрокаНастройки(ПолеНастройки(База, "password"))));
	КонецЦикла;
	Возврат УчётныеДанные;

КонецФункции

// Объект настроек из JSON - Соответствие; Структура без поля не индексируется.
Функция ПолеНастройки(Объект, Имя)
	Если ТипЗнч(Объект) = Тип("Структура") ИЛИ ТипЗнч(Объект) = Тип("ФиксированнаяСтруктура") Тогда
		Значение = Неопределено;
		Объект.Свойство(Имя, Значение);
		Возврат Значение;
	КонецЕсли;
	Возврат Объект[Имя];
КонецФункции

Процедура ЗалогироватьПредупрежденияКластера(Кластер, Предупреждения)

	Текст = СтрСоединить(Предупреждения, Символы.ПС);
	Если Текст = Кластер.Предупреждения Тогда
		Возврат;
	КонецЕсли;
	Кластер.Предупреждения = Текст;

	Для Каждого Предупреждение Из Предупреждения Цикл
		Лог.Предупреждение("Опрос кластера %1: %2", Кластер.Адрес, Предупреждение);
	КонецЦикла;

КонецПроцедуры

Процедура ЗаписатьСеансыКластера(Кластер, Снимок)

	Если Кластер.ЭкспортерСеансов = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Кластер.ЭкспортерСеансов.Записать(Снимок);
	Исключение
		Лог.Ошибка("Ошибка записи сеансов кластера %1: %2", Кластер.Адрес,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

Процедура ЗалогироватьДоступностьКластера(Кластер, Снимок)

	Если Снимок.Доступен Тогда
		Если Кластер.БылДоступен <> Истина Тогда
			Лог.Информация("Кластер %1 доступен", Кластер.Адрес);
		КонецЕсли;
	ИначеЕсли Кластер.БылДоступен = Ложь Тогда
		Лог.Отладка("Кластер %1 по-прежнему недоступен: %2", Кластер.Адрес, Снимок.Ошибка);
	Иначе
		Лог.Предупреждение("Кластер %1 недоступен: %2", Кластер.Адрес, Снимок.Ошибка);
	КонецЕсли;
	Кластер.БылДоступен = Снимок.Доступен;

КонецПроцедуры

Функция ИмяСервисаИсточника(Источник)
	Возврат СтрокаНастройки(Источник["service-name"]);
КонецФункции

Функция СтрокаНастройки(Значение)
	Возврат ?(ЗначениеЗаполнено(Значение), Значение, "");
КонецФункции

Функция МассивИсточников(Источники)
	Если ТипЗнч(Источники) = Тип("Массив") ИЛИ ТипЗнч(Источники) = Тип("ФиксированныйМассив") Тогда
		Возврат Источники;
	КонецЕсли;
	Результат = Новый Массив;
	Результат.Добавить(Источники);
	Возврат Результат;
КонецФункции

Функция КаталогИсточника(Источник)
	Каталог = Источник["path"];
	Если НЕ ЗначениеЗаполнено(Каталог) Тогда
		ВызватьИсключение "В настройках источника журнала не указан каталог (path)";
	КонецЕсли;
	Возврат Каталог;
КонецФункции

// Часовой пояс проверяется при запуске: с неизвестным поясом экспортер не переведет время ни одной записи.
//
// Параметры:
//   Источник - Соответствие - настройки источника журнала
//   ОбщиеПараметры - Структура - общие настройки источников
//
// Возвращаемое значение:
//   Строка - часовой пояс источника
//
Функция ЧасовойПоясИсточника(Источник, ОбщиеПараметры)
	Пояс = ЗначениеИлиОбщее(Источник["timezone"], ОбщиеПараметры.ЧасовойПояс);
	Если НЕ ЧасовойПоясИзвестен(Пояс) Тогда
		ВызватьИсключение СтрШаблон("Журнал %1: неизвестный часовой пояс «%2» в настройке timezone: "
			+ "нужен идентификатор IANA, Windows или GMT+ЧЧ:ММ", Источник["path"], Пояс);
	КонецЕсли;
	Возврат Пояс;
КонецФункции

// Параметры:
//   Пояс - Строка - часовой пояс
//
// Возвращаемое значение:
//   Булево - время переводится в этот пояс
//
Функция ЧасовойПоясИзвестен(Пояс)
	// Перевод из UTC: у местного времени может не быть часа, пропущенного при переводе часов
	ЛюбоеУниверсальноеВремя = '20200101';
	Попытка
		МестноеВремя(ЛюбоеУниверсальноеВремя, Пояс);
	Исключение
		Возврат Ложь;
	КонецПопытки;
	Возврат Истина;
КонецФункции

Функция НачинатьСКонцаИсточника(Источник, ОбщиеПараметры)
	Возврат ЭтоИстина(ЗначениеИлиОбщее(Источник["start-from-end"], ОбщиеПараметры.НачинатьСКонца));
КонецФункции

Функция ЗначениеИлиОбщее(Значение, ОбщееЗначение)
	Если Значение = Неопределено ИЛИ Значение = "" Тогда
		Возврат ОбщееЗначение;
	КонецЕсли;
	Возврат Значение;
КонецФункции

Функция ЭтоИстина(Значение)
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат НРег(Строка(Значение)) = "true";
КонецФункции

// Экспортер метрик данных с теми же настройками транспорта OTLP, что у SDK коллектора.
// Настройки временной агрегации и агрегации гистограмм SDK здесь не применяются.
//
// Параметры:
//   МенеджерПараметров - МенеджерПараметров - параметры приложения: настройки транспорта OTLP
//
// Возвращаемое значение:
//   ОтелЭкспортерМетрик, Неопределено - экспортер; Неопределено, если экспорт метрик выключен
//
Функция ЭкспортерМетрикДанных(МенеджерПараметров)

	ИмяЭкспортера = НРег(СокрЛП(Строка(МенеджерПараметров.Параметр("otel.metrics.exporter", "otlp"))));
	Если ИмяЭкспортера <> "otlp" Тогда
		Возврат Неопределено;
	КонецЕсли;

	ДанныеТранспорта = ОтелАвтоконфигурация.СоздатьТранспортДляСигнала(МенеджерПараметров, "metrics");
	Если ДанныеТранспорта.Транспорт = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый ОтелЭкспортерМетрик(ДанныеТранспорта.Транспорт, ОтелСелекторВременнойАгрегации.ВсегдаКумулятивная(),
		ДанныеТранспорта.ПутьСигнала, ДанныеТранспорта.ТаймаутМс);

КонецФункции

#КонецОбласти

// Параметры:
//   ЛогПриложения - Лог - лог коллектора от autumn-logos: аппендеры из настроек logos, в том числе
//     ОтелАппендерLogos, который отправляет логи коллектора с его otel.service.name
//   ОтелSdk - ОтелSdk - SDK OpenTelemetry из настроек otel (autumn-opentelemetry)
//   МенеджерПараметров - МенеджерПараметров - параметры приложения: настройки транспорта OTLP
//   ХранилищеПозицийЧтения - ХранилищеПозицийЧтения - хранилище позиций чтения
//   ЗаданияКоллектора - ЗаданияКоллектора - фоновые задания чтения журналов и опроса кластеров
//   ИмяСервисаДанных - Строка - настройка otel.v8-logs.service.name
//   АтрибутыРесурсаДанных - Строка - настройка otel.v8-logs.resource.attributes
//   ИнтервалЭкспортаМетрик - Число, Строка - настройка otel.metric.export.interval
//   ТехнологическиеЖурналы - Массив, Соответствие, Неопределено - настройки otel.v8-logs.techlog
//   ЖурналыРегистрации - Массив, Соответствие, Неопределено - настройки otel.v8-logs.eventlog
//   ЧасовойПоясСерверов - Строка - настройка otel.v8-logs.timezone
//   НачинатьСКонца - Булево, Строка - настройка otel.v8-logs.start-from-end
//   Интервал - Число, Строка - настройка otel.v8-logs.interval
//   РазмерПакета - Число, Строка - настройка otel.v8-logs.batch-size
//   ТрассыВключены - Булево, Строка - настройка otel.v8-logs.traces.enabled
//   КорневыеСобытия - Строка, Массив из Строка - настройка otel.v8-logs.traces.root-events
//   РежимТрасс - Строка - настройка otel.v8-logs.traces.mode: auto, streaming или buffered
//   ВозвращенныеСтрокиВключены - Булево, Строка - настройка otel.v8-logs.returned-rows.enabled
//   ИдСеансаВключен - Булево, Строка - настройка otel.v8-logs.session-id.enabled
//   ПропускатьДубли - Булево, Строка - настройка otel.v8-logs.semconv-duplicates.skip.enabled
//   НастройкиКластеров - Массив, Соответствие, Неопределено - настройки otel.v8-logs.cluster
//   ТабакеркаТелеметрии - Табакерка - ТелеметрияЖурналов
//   ТабакеркаКонвейеров - Табакерка - КонвейерЖурналов
//   ТабакеркаЧитателейТехнологическогоЖурнала - Табакерка - ЧитательТехнологическогоЖурнала
//   ТабакеркаЭкспортеровТехнологическогоЖурнала - Табакерка - ЭкспортерТехнологическогоЖурнала
//   ТабакеркаЧитателейЖурналаРегистрации - Табакерка - ЧитательЖурналаРегистрации
//   ТабакеркаЭкспортеровЖурналаРегистрации - Табакерка - ЭкспортерЖурналаРегистрации
//   ТабакеркаОпросчиковКластера - Табакерка - ОпросчикКластера
//   ТабакеркаЭкспортеровМетрикКластера - Табакерка - ЭкспортерМетрикКластера
//   ТабакеркаЭкспортеровСеансовКластера - Табакерка - ЭкспортерСеансовКластера
//
// Зависимости и настройки внедряются в конструктор, по параметру на каждую.
// BSLLS:NumberOfParams-off
&Желудь
Процедура ПриСозданииОбъекта(
		&Лог(Значение = "oscript.app.opentelemetry-v8-logs") ЛогПриложения,
		&Пластилин ОтелSdk,
		&Пластилин МенеджерПараметров,
		&Пластилин ХранилищеПозицийЧтения,
		&Пластилин ЗаданияКоллектора,
		&Деталька(Значение = "otel.v8-logs.service.name", ЗначениеПоУмолчанию = "1c") ИмяСервисаДанных,
		&Деталька(Значение = "otel.v8-logs.resource.attributes", ЗначениеПоУмолчанию = "") АтрибутыРесурсаДанных,
		&Деталька(Значение = "otel.metric.export.interval", ЗначениеПоУмолчанию = 60000) ИнтервалЭкспортаМетрик,
		&Деталька(Значение = "otel.v8-logs.techlog", ЗначениеПоУмолчанию = Неопределено) ТехнологическиеЖурналы,
		&Деталька(Значение = "otel.v8-logs.eventlog", ЗначениеПоУмолчанию = Неопределено) ЖурналыРегистрации,
		&Деталька(Значение = "otel.v8-logs.timezone", ЗначениеПоУмолчанию = "") ЧасовойПоясСерверов,
		&Деталька(Значение = "otel.v8-logs.start-from-end", ЗначениеПоУмолчанию = Ложь) НачинатьСКонца,
		&Деталька(Значение = "otel.v8-logs.interval", ЗначениеПоУмолчанию = 5) Интервал,
		&Деталька(Значение = "otel.v8-logs.batch-size", ЗначениеПоУмолчанию = 1000) РазмерПакета,
		&Деталька(Значение = "otel.v8-logs.traces.enabled", ЗначениеПоУмолчанию = Истина) ТрассыВключены,
		&Деталька(Значение = "otel.v8-logs.traces.root-events", ЗначениеПоУмолчанию = "CALL") КорневыеСобытия,
		&Деталька(Значение = "otel.v8-logs.traces.mode", ЗначениеПоУмолчанию = "auto") РежимТрасс,
		&Деталька(Значение = "otel.v8-logs.returned-rows.enabled", ЗначениеПоУмолчанию = Истина)
			ВозвращенныеСтрокиВключены,
		&Деталька(Значение = "otel.v8-logs.session-id.enabled", ЗначениеПоУмолчанию = Истина) ИдСеансаВключен,
		&Деталька(Значение = "otel.v8-logs.semconv-duplicates.skip.enabled", ЗначениеПоУмолчанию = Истина)
			ПропускатьДубли,
		&Деталька(Значение = "otel.v8-logs.cluster", ЗначениеПоУмолчанию = Неопределено) НастройкиКластеров,
		&Табакерка &Пластилин("ТелеметрияЖурналов") ТабакеркаТелеметрии,
		&Табакерка &Пластилин("КонвейерЖурналов") ТабакеркаКонвейеров,
		&Табакерка &Пластилин("ЧитательТехнологическогоЖурнала") ТабакеркаЧитателейТехнологическогоЖурнала,
		&Табакерка &Пластилин("ЭкспортерТехнологическогоЖурнала") ТабакеркаЭкспортеровТехнологическогоЖурнала,
		&Табакерка &Пластилин("ЧитательЖурналаРегистрации") ТабакеркаЧитателейЖурналаРегистрации,
		&Табакерка &Пластилин("ЭкспортерЖурналаРегистрации") ТабакеркаЭкспортеровЖурналаРегистрации,
		&Табакерка &Пластилин("ОпросчикКластера") ТабакеркаОпросчиковКластера,
		&Табакерка &Пластилин("ЭкспортерМетрикКластера") ТабакеркаЭкспортеровМетрикКластера,
		&Табакерка &Пластилин("ЭкспортерСеансовКластера") ТабакеркаЭкспортеровСеансовКластера)
	// BSLLS:NumberOfParams-on

	Лог = ЛогПриложения;
	Сдк = ОтелSdk;
	МиллисекундВСекунде = 1000;
	ИнтервалПаузыМс = Число(Интервал) * МиллисекундВСекунде;
	МаксимумБайтПорции = 4194304; // 4 МБ
	ТабакеркаЧитателейТЖ = ТабакеркаЧитателейТехнологическогоЖурнала;
	ТабакеркаЭкспортеровТЖ = ТабакеркаЭкспортеровТехнологическогоЖурнала;
	ТабакеркаЧитателейЖР = ТабакеркаЧитателейЖурналаРегистрации;
	ТабакеркаЭкспортеровЖР = ТабакеркаЭкспортеровЖурналаРегистрации;

	ЭкспортерМетрик = ЭкспортерМетрикДанных(МенеджерПараметров);
	ПараметрыТелеметрии = Массивы.ИзЭлементов(Сдк.ПровайдерЛогирования(), Сдк.ПровайдерТрассировки(), ЭкспортерМетрик,
		Число(ИнтервалЭкспортаМетрик), ИмяСервисаДанных, АтрибутыРесурсаДанных);
	Телеметрия = ТабакеркаТелеметрии.Достать(ПараметрыТелеметрии);
	ПараметрыКонвейера = Массивы.ИзЭлементов(Телеметрия, Число(РазмерПакета));
	КонвейерТЖ = ТабакеркаКонвейеров.Достать(ПараметрыКонвейера);
	КонвейерЖР = ТабакеркаКонвейеров.Достать(ПараметрыКонвейера);
	ЕстьТЖ = Ложь;
	ЕстьЖР = Ложь;
	Задания = ЗаданияКоллектора;

	ОбщиеПараметры = Новый Структура;
	ЧасовойПоясПоУмолчанию = ?(ЗначениеЗаполнено(ЧасовойПоясСерверов), ЧасовойПоясСерверов, ЧасовойПояс());
	ОбщиеПараметры.Вставить("ЧасовойПояс", ЧасовойПоясПоУмолчанию);
	ОбщиеПараметры.Вставить("НачинатьСКонца", ЭтоИстина(НачинатьСКонца));
	ОбщиеПараметры.Вставить("ТрассыВключены", ЭтоИстина(ТрассыВключены));
	ОбщиеПараметры.Вставить("КорневыеСобытия", КорневыеСобытия);
	ОбщиеПараметры.Вставить("РежимТрасс", РежимТрасс);
	ОбщиеПараметры.Вставить("ВозвращенныеСтрокиВключены", ЭтоИстина(ВозвращенныеСтрокиВключены));
	ОбщиеПараметры.Вставить("ИдСеансаВключен", ЭтоИстина(ИдСеансаВключен));
	ОбщиеПараметры.Вставить("ПропускатьДубли", ЭтоИстина(ПропускатьДубли));

	ДобавитьТехнологическиеЖурналы(ТехнологическиеЖурналы, ХранилищеПозицийЧтения, ОбщиеПараметры);
	ДобавитьЖурналыРегистрации(ЖурналыРегистрации, ХранилищеПозицийЧтения, ОбщиеПараметры);

	ТабакеркиКластера = Новый Структура("Опросчиков, Экспортеров, ЭкспортеровСеансов",
		ТабакеркаОпросчиковКластера, ТабакеркаЭкспортеровМетрикКластера, ТабакеркаЭкспортеровСеансовКластера);
	ПодключитьКластеры(НастройкиКластеров, ИмяСервисаДанных, ОбщиеПараметры.ЧасовойПояс, ТабакеркиКластера);

КонецПроцедуры
