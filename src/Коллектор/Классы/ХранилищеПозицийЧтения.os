#native
#Использовать autumn
#Использовать autumn-data

// Хранилище позиций чтения в базе данных autumn-data (источник данных из секции data настроек).
//
// Интерфейс совпадает с ХранилищеПозицийВПамяти.
//
// Хранилище одно на задания чтения технологического журнала и журнала регистрации: каждое читает позиции
// своих файлов на старте и фиксирует их в конце прохода. Пул autumn-data дает каждому потоку свое соединение
// с одним файлом SQLite, и две записи из разных соединений разом упираются в блокировку файла, поэтому
// обращения к базе идут по одному. Цена - единицы вызовов на проход.

Перем ХранилищеСущностей; // ХранилищеСущностей - хранилище сущностей ПозицияЧтения
Перем Блокировка; // БлокировкаРесурса - обращения к базе из разных потоков

#Область ПрограммныйИнтерфейс

// Возвращает сохраненную позицию чтения.
//
// Параметры:
//   Ключ - Строка - ключ позиции (путь к файлу)
//
// Возвращаемое значение:
//   Число, Неопределено - позиция или Неопределено, если не сохранялась
//
Функция Позиция(Ключ) Экспорт
	Блокировка.Заблокировать();
	Попытка
		Сущность = ХранилищеСущностей.ПолучитьОдно(Ключ);
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Блокировка.Разблокировать();
	Если Сущность = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Сущность.Позиция;
КонецФункции

// Сохраняет позицию чтения.
//
// Параметры:
//   Ключ - Строка - ключ позиции (путь к файлу)
//   Значение - Число - позиция
//
Процедура УстановитьПозицию(Ключ, Значение) Экспорт
	Блокировка.Заблокировать();
	Попытка
		Сущность = ХранилищеСущностей.ПолучитьОдно(Ключ);
		Если Сущность = Неопределено Тогда
			Сущность = ХранилищеСущностей.СоздатьЭлемент();
			Сущность.Ключ = Ключ;
		КонецЕсли;
		Сущность.Позиция = Значение;
		ХранилищеСущностей.Сохранить(Сущность);
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Блокировка.Разблокировать();
КонецПроцедуры

// Удаляет сохраненную позицию чтения.
//
// Параметры:
//   Ключ - Строка - ключ позиции (путь к файлу)
//
Процедура УдалитьПозицию(Ключ) Экспорт
	Блокировка.Заблокировать();
	Попытка
		Сущность = ХранилищеСущностей.ПолучитьОдно(Ключ);
		Если Сущность <> Неопределено Тогда
			ХранилищеСущностей.Удалить(Сущность);
		КонецЕсли;
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Блокировка.Разблокировать();
КонецПроцедуры

// Возвращает ключи сохраненных позиций, начинающиеся с префикса.
//
// Параметры:
//   Префикс - Строка - начало ключа
//
// Возвращаемое значение:
//   Массив из Строка - ключи
//
Функция Ключи(Префикс) Экспорт
	Блокировка.Заблокировать();
	Попытка
		Сущности = ХранилищеСущностей.Получить();
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Блокировка.Разблокировать();
	Результат = Новый Массив;
	Для Каждого Сущность Из Сущности Цикл
		Если СтрНачинаетсяС(Сущность.Ключ, Префикс) Тогда
			Результат.Добавить(Сущность.Ключ);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти

// Параметры:
//   ХранилищеСущностейПозицияЧтения - ХранилищеСущностей - хранилище сущностей ПозицияЧтения
//
&Желудь
Процедура ПриСозданииОбъекта(&Пластилин ХранилищеСущностейПозицияЧтения)
	ХранилищеСущностей = ХранилищеСущностейПозицияЧтения;
	Блокировка = Новый БлокировкаРесурса(ЭтотОбъект);
КонецПроцедуры
