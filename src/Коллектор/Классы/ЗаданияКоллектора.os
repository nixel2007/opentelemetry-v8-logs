#native
#Использовать autumn-logos

// Фоновые задания коллектора: запуск, ожидание и остановка по флагу (задание OneScript отменить нельзя).

&Лог(Значение = "oscript.app.opentelemetry-v8-logs", УчитыватьИмяКласса = Ложь)
Перем Лог; // Лог - лог приложения
Перем Описания; // Массив из Структура("Название, Объект, Метод, Параметры, Задание") - добавленные задания
Перем Остановлены; // Булево - выставлен флаг остановки
Перем ИнтервалОжиданияМс; // Число - как часто проверять задания, пока ни одно не завершилось
Перем ПределОстановкиМс; // Число - сколько ждать остальные задания после сбоя одного
Перем ЛомтикПаузыМс; // Число - пауза дробится, чтобы остановка не ждала ее целиком

#Область ПрограммныйИнтерфейс

// Добавляет задание, которое запустит ЗапуститьИДождаться.
//
// Параметры:
//   Название - Строка - название задания в логе
//   Объект - Произвольный - объект с экспортным методом - телом задания
//   ИмяМетода - Строка - тело задания: работает, пока не выставлен флаг остановки
//   Параметры - Массив - параметры метода
//
Процедура Добавить(Название, Объект, ИмяМетода, Параметры) Экспорт
	Описание = Новый Структура("Название, Объект, Метод, Параметры, Задание", Название, Объект, ИмяМетода, Параметры);
	Описания.Добавить(Описание);
КонецПроцедуры

// Запускает добавленные задания и ждет их завершения. Задание, завершившееся без остановки, - сбой:
// остальные задания останавливаются, их завершение ждется ограниченное время.
//
// Возвращаемое значение:
//   Строка - текст ошибки первого сбойного задания с его названием; пустая строка - сбоев не было
//
Функция ЗапуститьИДождаться() Экспорт

	Активные = Новый Массив;
	Попытка
		Для Каждого Описание Из Описания Цикл
			Описание.Задание = ФоновыеЗадания.Выполнить(Описание.Объект, Описание.Метод, Описание.Параметры);
			Лог.Информация("Задание ""%1"" запущено", Описание.Название);
			Активные.Добавить(Описание);
		КонецЦикла;
	Исключение
		Остановить();
		ВызватьИсключение;
	КонецПопытки;
	Описания = Новый Массив;

	ТекстСбоя = "";
	ГраницаОжидания = Неопределено;
	Пока Активные.Количество() > 0 Цикл

		Если ГраницаОжидания <> Неопределено И ТекущаяУниверсальнаяДатаВМиллисекундах() > ГраницаОжидания Тогда
			Для Каждого Описание Из Активные Цикл
				Лог.Предупреждение("Задание ""%1"" не остановилось за %2 мс", Описание.Название, ПределОстановкиМс);
			КонецЦикла;
			Прервать;
		КонецЕсли;

		Индекс = ФоновыеЗадания.ОжидатьЛюбое(ЗаданияОписаний(Активные), ИнтервалОжиданияМс);
		Если Индекс < 0 Тогда
			Продолжить;
		КонецЕсли;
		Описание = Активные[Индекс];
		Активные.Удалить(Индекс);

		Ошибка = ОшибкаЗадания(Описание.Задание);
		Если Ошибка = "" Тогда
			Лог.Информация("Задание ""%1"" остановлено", Описание.Название);
			Продолжить;
		КонецЕсли;

		Лог.Ошибка("Задание ""%1"" завершилось с ошибкой: %2", Описание.Название, Ошибка);
		Если ТекстСбоя = "" Тогда
			ТекстСбоя = СтрШаблон("Задание ""%1"" завершилось с ошибкой: %2", Описание.Название, Ошибка);
			Остановить();
			ГраницаОжидания = ТекущаяУниверсальнаяДатаВМиллисекундах() + ПределОстановкиМс;
		КонецЕсли;

	КонецЦикла;

	Возврат ТекстСбоя;

КонецФункции

// Выставляет флаг остановки: задания проверяют его между проходами и в паузах.
//
Процедура Остановить() Экспорт
	Остановлены = Истина;
КонецПроцедуры

// Проверяет флаг остановки.
//
// Возвращаемое значение:
//   Булево - Истина, если заданиям пора завершаться
//
Функция ЗапрошенаОстановка() Экспорт
	Возврат Остановлены;
КонецФункции

// Приостанавливает задание, прерываясь при остановке.
//
// Параметры:
//   ДлительностьМс - Число - длительность паузы
//
Процедура Пауза(ДлительностьМс) Экспорт
	Граница = ТекущаяУниверсальнаяДатаВМиллисекундах() + ДлительностьМс;
	Пока НЕ Остановлены Цикл
		Осталось = Граница - ТекущаяУниверсальнаяДатаВМиллисекундах();
		Если Осталось <= 0 Тогда
			Прервать;
		КонецЕсли;
		Приостановить(Мин(Осталось, ЛомтикПаузыМс));
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗаданияОписаний(Активные)
	Результат = Новый Массив;
	Для Каждого Описание Из Активные Цикл
		Результат.Добавить(Описание.Задание);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Пустая строка - задание завершилось после остановки без ошибки.
Функция ОшибкаЗадания(Задание)
	Если Задание.Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно Тогда
		Возврат ПодробноеПредставлениеОшибки(Задание.ИнформацияОбОшибке);
	КонецЕсли;
	Если НЕ Остановлены Тогда
		Возврат "задание завершилось без остановки";
	КонецЕсли;
	Возврат "";
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта()
	Описания = Новый Массив;
	Остановлены = Ложь;
	ИнтервалОжиданияМс = 1000;
	ПределОстановкиМс = 30000;
	ЛомтикПаузыМс = 200;
КонецПроцедуры
