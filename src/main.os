// Точка входа приложения: читает журналы 1С и передает их в OpenTelemetry.
//
// Настройки берутся из autumn-properties.json в текущем каталоге, см. ПриложениеЖурналов.
// Аргумент --once выполняет один проход и завершает работу.

#Использовать autumn
#Использовать ".."
#Использовать "Приложение"

Поделка = Новый Поделка();
Поделка.ЗапуститьПриложение();

Приложение = Поделка.НайтиЖелудь("ПриложениеЖурналов");
Приложение.Запустить(АргументыКоманднойСтроки.Найти("--once") <> Неопределено);
