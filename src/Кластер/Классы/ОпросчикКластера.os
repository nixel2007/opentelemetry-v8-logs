#Использовать v8ras
#Использовать autumn

// Опрос кластеров 1С через RAS: сеансы, соединения, рабочие процессы, лицензии и базы в снимок показателей и сеансов.
// Модуль не #native: ловит исключения клиента RAS сам, native-Попытка над ними обрывает вызывающего.

Перем ХостRAS; // Строка
Перем ПортRAS; // Число
Перем ПользовательКластера; // Строка - администратор кластера
Перем ПарольКластера; // Строка
Перем ПользовательАгентаКластера; // Строка - администратор агента; пусто - агент не аутентифицируется
Перем ПарольАгентаКластера; // Строка
Перем ТаймаутОпросаМс; // Число
Перем ПорогиДолгихВызововСек; // Массив из Число
Перем УчетныеДанныеИнформационныхБаз; // Соответствие: имя базы -> Структура("Пользователь, Пароль")
Перем ФабрикаКлиентов; // Объект с методом Создать(Хост, Порт, ТаймаутМс)
Перем МиллисекундВСекунде; // Число - RAS отдаёт длительности и процессорное время в миллисекундах

#Область ПрограммныйИнтерфейс

// Снимает показатели и сеансы всех кластеров агента: каждый вызов - новое подключение к RAS, отключение - в любом
// исходе.
//
// Возвращаемое значение:
//   Структура - снимок:
//     * Время - Дата - момент снятия, универсальное время
//     * Доступен - Булево - опрос удался целиком
//     * Ошибка - Строка - причина, если Доступен = Ложь; иначе пустая строка
//     * Показатели - Массив из Структура - пустой, если Доступен = Ложь:
//       ** Имя - Строка - имя метрики
//       ** Значение - Число - значение
//       ** Атрибуты - Соответствие из КлючИЗначение: Строка -> Строка, Число, Булево - атрибуты точки
//     * Сеансы - Массив из Структура - по элементу на сеанс; пустой, если Доступен = Ложь:
//       ** Атрибуты - Соответствие из КлючИЗначение: Строка -> Строка, Число, Булево - атрибуты сеанса
//     * Предупреждения - Массив из Строка - сбои частей опроса, не уронившие снимок; пустой, если Доступен = Ложь
Функция Снять() Экспорт

	Снимок = НовыйСнимок(Истина, "");
	Клиент = Неопределено;
	Попытка
		Клиент = ФабрикаКлиентов.Создать(ХостRAS, ПортRAS, ТаймаутОпросаМс);
		СнятьКлиентом(Клиент, Снимок);
	Исключение
		Снимок = НовыйСнимок(Ложь, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Отключить(Клиент);

	Возврат Снимок;

КонецФункции

// Подменяет фабрику клиентов RAS.
//
// Параметры:
//   Фабрика - Объект - объект с методом Создать(Хост, Порт, ТаймаутМс), возвращающим клиент с методами
//     КлиентКластераRAS
Процедура УстановитьФабрикуКлиентов(Фабрика) Экспорт
	ФабрикаКлиентов = Фабрика;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыйСнимок(Доступен, Ошибка)
	Возврат Новый Структура("Время, Доступен, Ошибка, Показатели, Сеансы, Предупреждения",
		ТекущаяУниверсальнаяДата(), Доступен, Ошибка, Новый Массив, Новый Массив, Новый Массив);
КонецФункции

Процедура СнятьКлиентом(Клиент, Снимок)

	Клиент.Подключить();
	Если ЗначениеЗаполнено(ПользовательАгентаКластера) Тогда
		Клиент.АутентифицироватьАгент(ПользовательАгентаКластера, ПарольАгентаКластера);
	КонецЕсли;

	Сборка = Новый Структура("Снимок, Точки, НайденныеБазы", Снимок, Новый Соответствие, Новый Соответствие);
	Для Каждого Кластер Из Клиент.Кластеры() Цикл
		Клиент.АутентифицироватьКластер(Кластер.Ид, ПользовательКластера, ПарольКластера);
		СнятьКластер(Клиент, Кластер, Сборка);
	КонецЦикла;

	Для Каждого УчетныеДанные Из УчетныеДанныеИнформационныхБаз Цикл
		Если Сборка.НайденныеБазы[УчетныеДанные.Ключ] = Неопределено Тогда
			Снимок.Предупреждения.Добавить(СтрШаблон("База %1 из настроек не найдена ни в одном кластере",
				УчетныеДанные.Ключ));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура СнятьКластер(Клиент, Кластер, Сборка)

	Базы = Клиент.Инфобазы(Кластер.Ид);
	ИменаБаз = Новый Соответствие;
	Для Каждого База Из Базы Цикл
		ИменаБаз.Вставить(База.Ид, База.Имя);
	КонецЦикла;

	Процессы = Новый Соответствие;
	Лицензии = Новый Соответствие;
	Для Каждого Процесс Из Клиент.РабочиеПроцессы(Кластер.Ид) Цикл
		Процессы.Вставить(Процесс.Ид, Процесс);
		СнятьПроцесс(Процесс, Кластер.Имя, Сборка);
		ЗапомнитьЛицензии(Процесс.Лицензии, Лицензии);
	КонецЦикла;

	Для Каждого Сеанс Из Клиент.Сеансы(Кластер.Ид) Цикл
		ИмяБазы = ИменаБаз[Сеанс.ИдБазы];
		Процесс = Процессы[Сеанс.ИдПроцесса];
		СнятьСеанс(Сеанс, Кластер.Имя, ИмяБазы, Процесс, Сборка);
		Сборка.Снимок.Сеансы.Добавить(Новый Структура("Атрибуты",
			АтрибутыЗаписиСеанса(Сеанс, Кластер.Имя, ИмяБазы, Процесс)));
		ЗапомнитьЛицензии(Сеанс.Лицензии, Лицензии);
	КонецЦикла;

	Для Каждого Соединение Из Клиент.Соединения(Кластер.Ид) Цикл
		Набор = НовыйНабор(Кластер.Имя);
		АтрибутЕслиЗаполнен(Набор, "v8.infobase.name", ИменаБаз[Соединение.ИдБазы]);
		ДополнитьПроцессом(Набор, Процессы[Соединение.ИдПроцесса]);
		АтрибутЕслиЗаполнен(Набор, "v8.connection.app_id", Соединение.Приложение);
		Добавить(Сборка, "v8.cluster.connections", 1, Набор);
	КонецЦикла;

	Для Каждого Лицензия Из Лицензии Цикл
		Добавить(Сборка, "v8.cluster.licenses.total", Лицензия.Значение.МаксПользователейВсего,
			НаборЛицензии(Кластер.Имя, Лицензия.Значение));
	КонецЦикла;

	// Последними: сбой команды RAS по одной базе не должен отнять у снимка остальные показатели кластера
	Для Каждого База Из Базы Цикл
		СнятьБазу(Клиент, Кластер, База, Сборка);
	КонецЦикла;

КонецПроцедуры

Процедура СнятьПроцесс(Процесс, ИмяКластера, Сборка)

	Набор = НовыйНабор(ИмяКластера);
	АтрибутЕслиЗаполнен(Набор, "host.name", Процесс.Хост);
	Атрибут(Набор, "v8.process.running", Процесс.Запущен = Истина);
	Атрибут(Набор, "v8.process.enabled", Процесс.Включен = Истина);
	Добавить(Сборка, "v8.cluster.processes", 1, Набор);

	Набор = НовыйНабор(ИмяКластера);
	ДополнитьПроцессом(Набор, Процесс);
	Добавить(Сборка, "v8.cluster.process.memory.usage", Процесс.ПамятьКБ * 1024, Набор);
	Добавить(Сборка, "v8.cluster.process.connections", Процесс.Соединений, Набор);
	Добавить(Сборка, "v8.cluster.process.available_performance", Процесс.ДоступнаяПроизводительность, Набор);

	Длительности = Новый Структура("call, db, lock, server, back", Процесс.СредняяДлительностьВызова,
		Процесс.СредняяДлительностьВызоваСУБД, Процесс.СредняяДлительностьБлокировок,
		Процесс.СредняяДлительностьСерверногоВызова, Процесс.СредняяДлительностьОбратногоВызова);
	Для Каждого Длительность Из Длительности Цикл
		Добавить(Сборка, "v8.cluster.process.call.duration.avg", Длительность.Значение,
			САтрибутом(Набор, "v8.call.kind", Длительность.Ключ));
	КонецЦикла;

КонецПроцедуры

Процедура СнятьСеанс(Сеанс, ИмяКластера, ИмяБазы, Процесс, Сборка)

	НаборБазы = НовыйНабор(ИмяКластера);
	АтрибутЕслиЗаполнен(НаборБазы, "v8.infobase.name", ИмяБазы);

	Набор = Копия(НаборБазы);
	АтрибутЕслиЗаполнен(Набор, "v8.session.app_id", Сеанс.Приложение);
	Если Процесс <> Неопределено Тогда
		АтрибутЕслиЗаполнен(Набор, "host.name", Процесс.Хост);
	КонецЕсли;
	Добавить(Сборка, "v8.cluster.sessions", 1, Набор);

	Блокировки = Новый Структура("db, lock", Сеанс.БлокированоСУБД, Сеанс.БлокированоБлокировками);
	Для Каждого Блокировка Из Блокировки Цикл
		Добавить(Сборка, "v8.cluster.sessions.blocked", ?(Блокировка.Значение > 0, 1, 0),
			САтрибутом(НаборБазы, "v8.block.kind", Блокировка.Ключ));
	КонецЦикла;

	Набор = Копия(НаборБазы);
	АтрибутЕслиЗаполнен(Набор, "v8.session.app_id", Сеанс.Приложение);
	АтрибутЕслиЗаполнен(Набор, "user.name", Сеанс.ИмяПользователя);
	СнятьНагрузкуСеанса(Сеанс, Набор, Сборка);

	УчтенныеЛицензии = Новый Соответствие;
	Для Каждого Лицензия Из Сеанс.Лицензии Цикл
		Набор = НаборЛицензии(ИмяКластера, Лицензия);
		Если УчтенныеЛицензии[Набор.Ключ] = Неопределено Тогда
			УчтенныеЛицензии.Вставить(Набор.Ключ, Истина);
			Добавить(Сборка, "v8.cluster.licenses.used", 1, Набор);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура СнятьНагрузкуСеанса(Сеанс, Набор, Сборка)

	Добавить(Сборка, "v8.cluster.sessions.memory.usage", Сеанс.ПамятьТекущая, Набор);
	Добавить(Сборка, "v8.cluster.sessions.cpu_time", Сеанс.ПроцессорноеВремяВсего / МиллисекундВСекунде, Набор);
	Добавить(Сборка, "v8.cluster.sessions.calls", Сеанс.ВызововВсего, Набор);
	Добавить(Сборка, "v8.cluster.sessions.call.duration", Сеанс.ДлительностьВсего / МиллисекундВСекунде,
		САтрибутом(Набор, "v8.call.kind", "call"));
	Добавить(Сборка, "v8.cluster.sessions.call.duration", Сеанс.ДлительностьСУБДВсего / МиллисекундВСекунде,
		САтрибутом(Набор, "v8.call.kind", "db"));
	Добавить(Сборка, "v8.cluster.sessions.io", Сеанс.ЧтениеВсего, САтрибутом(Набор, "v8.io.direction", "read"));
	Добавить(Сборка, "v8.cluster.sessions.io", Сеанс.ЗаписьВсего, САтрибутом(Набор, "v8.io.direction", "write"));

	Для Каждого ПорогСек Из ПорогиДолгихВызововСек Цикл
		Долгий = Сеанс.ДлительностьТекущая >= ПорогСек * МиллисекундВСекунде;
		Добавить(Сборка, "v8.cluster.sessions.long_calls", ?(Долгий, 1, 0),
			САтрибутом(Набор, "v8.duration.threshold", ПорогСек));
	КонецЦикла;

КонецПроцедуры

Функция АтрибутыЗаписиСеанса(Сеанс, ИмяКластера, ИмяБазы, Процесс)

	Атрибуты = Новый Соответствие;
	ВставитьЗаполненный(Атрибуты, "v8.cluster.name", ИмяКластера);
	ВставитьЗаполненный(Атрибуты, "v8.infobase.name", ИмяБазы);
	Атрибуты.Вставить("v8.session.id", Сеанс.Номер);
	ВставитьЗаполненный(Атрибуты, "v8.session.app_id", Сеанс.Приложение);
	ВставитьЗаполненный(Атрибуты, "user.name", Сеанс.ИмяПользователя);
	Если Процесс <> Неопределено Тогда
		ВставитьЗаполненный(Атрибуты, "host.name", Процесс.Хост);
		ВставитьЗаполненный(Атрибуты, "process.pid", ЧисловойPid(Процесс.Pid));
	КонецЕсли;
	ВставитьЗаполненный(Атрибуты, "v8.session.client.host", Сеанс.Хост);
	ВставитьЗаполненный(Атрибуты, "client.address", Сеанс.АдресКлиента);
	ВставитьДату(Атрибуты, "v8.session.started_at", Сеанс.Начало);
	ВставитьДату(Атрибуты, "v8.session.last_active_at", Сеанс.ПоследняяАктивность);
	Атрибуты.Вставить("v8.session.hibernated", Сеанс.Спящий = Истина);

	Атрибуты.Вставить("v8.session.blocked.db", Сеанс.БлокированоСУБД);
	Атрибуты.Вставить("v8.session.blocked.lock", Сеанс.БлокированоБлокировками);
	Атрибуты.Вставить("v8.session.memory.current", Сеанс.ПамятьТекущая);
	Атрибуты.Вставить("v8.session.memory.last5min", Сеанс.ПамятьЗа5Минут);
	Атрибуты.Вставить("v8.session.memory.total", Сеанс.ПамятьВсего);
	Атрибуты.Вставить("v8.session.read.current", Сеанс.ЧтениеТекущее);
	Атрибуты.Вставить("v8.session.read.last5min", Сеанс.ЧтениеЗа5Минут);
	Атрибуты.Вставить("v8.session.read.total", Сеанс.ЧтениеВсего);
	Атрибуты.Вставить("v8.session.write.current", Сеанс.ЗаписьТекущая);
	Атрибуты.Вставить("v8.session.write.last5min", Сеанс.ЗаписьЗа5Минут);
	Атрибуты.Вставить("v8.session.write.total", Сеанс.ЗаписьВсего);
	Атрибуты.Вставить("v8.session.duration.current", Сеанс.ДлительностьТекущая);
	Атрибуты.Вставить("v8.session.duration.last5min", Сеанс.ДлительностьЗа5Минут);
	Атрибуты.Вставить("v8.session.duration.total", Сеанс.ДлительностьВсего);
	Атрибуты.Вставить("v8.session.duration.dbms.current", Сеанс.ДлительностьСУБДТекущая);
	Атрибуты.Вставить("v8.session.duration.dbms.last5min", Сеанс.ДлительностьСУБДЗа5Минут);
	Атрибуты.Вставить("v8.session.duration.dbms.total", Сеанс.ДлительностьСУБДВсего);
	Атрибуты.Вставить("v8.session.cpu_time.current", Сеанс.ПроцессорноеВремяТекущее);
	Атрибуты.Вставить("v8.session.cpu_time.last5min", Сеанс.ПроцессорноеВремяЗа5Минут);
	Атрибуты.Вставить("v8.session.cpu_time.total", Сеанс.ПроцессорноеВремяВсего);
	Атрибуты.Вставить("v8.session.calls.total", Сеанс.ВызововВсего);
	Атрибуты.Вставить("v8.session.calls.last5min", Сеанс.ВызововЗа5Минут);
	Атрибуты.Вставить("v8.session.bytes.total", Сеанс.БайтВсего);
	Атрибуты.Вставить("v8.session.bytes.last5min", Сеанс.БайтЗа5Минут);
	Атрибуты.Вставить("v8.session.dbms_bytes.total", Сеанс.БайтСУБДВсего);
	Атрибуты.Вставить("v8.session.dbms_bytes.last5min", Сеанс.БайтСУБДЗа5Минут);

	ВставитьЗаполненный(Атрибуты, "v8.session.current_service", Сеанс.ТекущийСервис);
	ВставитьЗаполненный(Атрибуты, "v8.session.data_separation", Сеанс.РазделениеДанных);
	ВставитьЗаполненный(Атрибуты, "v8.session.license.series", СерииЛицензий(Сеанс.Лицензии));

	Возврат Атрибуты;

КонецФункции

Процедура СнятьБазу(Клиент, Кластер, База, Сборка)

	УчетныеДанные = УчетныеДанныеИнформационныхБаз[База.Имя];
	Если УчетныеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Сборка.НайденныеБазы.Вставить(База.Имя, Истина);

	Попытка
		Клиент.АутентифицироватьБазу(Кластер.Ид, УчетныеДанные.Пользователь, УчетныеДанные.Пароль);
		Описание = Клиент.ИнформацияОБазе(Кластер.Ид, База.Ид);
	Исключение
		Сборка.Снимок.Предупреждения.Добавить(СтрШаблон("Кластер %1, база %2: %3", Кластер.Имя, База.Имя,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		Возврат;
	КонецПопытки;

	Набор = НовыйНабор(Кластер.Имя);
	АтрибутЕслиЗаполнен(Набор, "v8.infobase.name", База.Имя);
	Добавить(Сборка, "v8.cluster.infobase.scheduled_jobs_denied", ?(Описание.БлокировкаРегламентных = Истина, 1, 0),
		Набор);
	Добавить(Сборка, "v8.cluster.infobase.sessions_denied", ?(Описание.БлокировкаСеансов = Истина, 1, 0), Набор);

КонецПроцедуры

Функция СерииЛицензий(Лицензии)
	Серии = Новый Массив;
	Для Каждого Лицензия Из Лицензии Цикл
		Если ЗначениеЗаполнено(Лицензия.Серия) И Серии.Найти(Лицензия.Серия) = Неопределено Тогда
			Серии.Добавить(Лицензия.Серия);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Серии, ", ");
КонецФункции

Процедура ЗапомнитьЛицензии(ЛицензииСущности, Лицензии)
	Для Каждого Лицензия Из ЛицензииСущности Цикл
		Лицензии.Вставить(Лицензия.ИмяФайла, Лицензия);
	КонецЦикла;
КонецПроцедуры

Процедура ДополнитьПроцессом(Набор, Процесс)
	Если Процесс <> Неопределено Тогда
		АтрибутЕслиЗаполнен(Набор, "host.name", Процесс.Хост);
		АтрибутЕслиЗаполнен(Набор, "process.pid", ЧисловойPid(Процесс.Pid));
	КонецЕсли;
КонецПроцедуры

// Неопределено, если pid не число: такой pid не должен ронять снимок
Функция ЧисловойPid(Pid)
	Попытка
		Возврат Число(Pid);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

Функция НаборЛицензии(ИмяКластера, Лицензия)
	Набор = НовыйНабор(ИмяКластера);
	АтрибутЕслиЗаполнен(Набор, "v8.license.series", Лицензия.Серия);
	Если Лицензия.ВыданаСервером = Истина Тогда
		АтрибутЕслиЗаполнен(Набор, "v8.license.server", Лицензия.АдресМенеджера);
	КонецЕсли;
	Атрибут(Набор, "v8.license.type", Формат(Лицензия.Тип, "ЧН=0; ЧГ="));
	Возврат Набор;
КонецФункции

Процедура ВставитьЗаполненный(Атрибуты, Ключ, Значение)
	Если ЗначениеЗаполнено(Значение) Тогда
		Атрибуты.Вставить(Ключ, Значение);
	КонецЕсли;
КонецПроцедуры

Процедура ВставитьДату(Атрибуты, Ключ, Значение)
	Если ЗначениеЗаполнено(Значение) Тогда
		Атрибуты.Вставить(Ключ, Формат(Значение, "ДФ=yyyy-MM-dd") + "T" + Формат(Значение, "ДФ=HH:mm:ss"));
	КонецЕсли;
КонецПроцедуры

// Набор атрибутов точки: Атрибуты и Ключ - те же атрибуты одной строкой, по нему точки с одинаковыми атрибутами
// складываются. Набор, отданный в Добавить, дальше не меняют: точка хранит его Атрибуты.
Функция НовыйНабор(ИмяКластера)
	Набор = Новый Структура("Атрибуты, Ключ", Новый Соответствие, "");
	АтрибутЕслиЗаполнен(Набор, "v8.cluster.name", ИмяКластера);
	Возврат Набор;
КонецФункции

Процедура Атрибут(Набор, Имя, Значение)
	Набор.Атрибуты.Вставить(Имя, Значение);
	Набор.Ключ = Набор.Ключ + Имя + "=" + Значение + Символы.ПС;
КонецПроцедуры

Процедура АтрибутЕслиЗаполнен(Набор, Имя, Значение)
	Если ЗначениеЗаполнено(Значение) Тогда
		Атрибут(Набор, Имя, Значение);
	КонецЕсли;
КонецПроцедуры

Функция Копия(Набор)
	Атрибуты = Новый Соответствие;
	Для Каждого КлючИЗначение Из Набор.Атрибуты Цикл
		Атрибуты.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	Возврат Новый Структура("Атрибуты, Ключ", Атрибуты, Набор.Ключ);
КонецФункции

Функция САтрибутом(Набор, Имя, Значение)
	Результат = Копия(Набор);
	Атрибут(Результат, Имя, Значение);
	Возврат Результат;
КонецФункции

Процедура Добавить(Сборка, Имя, Значение, Набор)
	Ключ = Имя + Символы.ПС + Набор.Ключ;
	Точка = Сборка.Точки[Ключ];
	Если Точка = Неопределено Тогда
		Точка = Новый Структура("Имя, Значение, Атрибуты", Имя, Значение, Набор.Атрибуты);
		Сборка.Точки.Вставить(Ключ, Точка);
		Сборка.Снимок.Показатели.Добавить(Точка);
	Иначе
		Точка.Значение = Точка.Значение + Значение;
	КонецЕсли;
КонецПроцедуры

Процедура Отключить(Клиент)
	Если Клиент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Клиент.Отключить();
	Исключение
		// снимок уже собран: сбой закрытия соединения его не меняет
	КонецПопытки;
КонецПроцедуры

#КонецОбласти

// BSLLS:NumberOfParams-off
&Желудь
&Характер("Компанейский")
Процедура ПриСозданииОбъекта(&Блестяшка Хост, &Блестяшка Порт, &Блестяшка Пользователь, &Блестяшка Пароль,
	&Блестяшка ПользовательАгента, &Блестяшка ПарольАгента, &Блестяшка ТаймаутМс,
	&Блестяшка ПорогиДлительностиСек, &Блестяшка УчётныеДанныеБаз)
	// BSLLS:NumberOfParams-on

	ХостRAS = Хост;
	ПортRAS = Порт;
	ПользовательКластера = Пользователь;
	ПарольКластера = Пароль;
	ПользовательАгентаКластера = ПользовательАгента;
	ПарольАгентаКластера = ПарольАгента;
	ТаймаутОпросаМс = ТаймаутМс;
	ПорогиДолгихВызововСек = ПорогиДлительностиСек;
	УчетныеДанныеИнформационныхБаз = УчётныеДанныеБаз;
	ФабрикаКлиентов = Новый ФабрикаКлиентовКластера;
	МиллисекундВСекунде = 1000;

КонецПроцедуры
