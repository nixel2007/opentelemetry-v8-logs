#Использовать autumn-logos

// Конвейер: читатели журналов -> экспортеры -> сброс буферов телеметрии -> фиксация позиций.
//
// Записи передаются экспортеру пакетами, после каждого пакета буферы телеметрии сбрасываются:
// очередь пакетного процессора OpenTelemetry ограничена, и без сброса большая порция журнала
// переполнила бы ее. Позиции читателя фиксируются, только если все сбросы прохода успешны,
// иначе откатываются к зафиксированным, и записи будут прочитаны повторно.

&Лог(Значение = "oscript.app.opentelemetry-v8-logs", УчитыватьИмяКласса = Ложь)
Перем Лог;
Перем Сброс;
Перем РазмерПакета;
Перем Источники; // Массив из Структура("Читатель, Экспортер")

Перем ТекущийЭкспортер;
Перем СбросУспешен;

#Область ПрограммныйИнтерфейс

// Добавляет источник журнала.
//
// Параметры:
//   Читатель - ЧитательТехнологическогоЖурнала, ЧитательЖурналаРегистрации - читатель журнала
//   Экспортер - ЭкспортерТехнологическогоЖурнала, ЭкспортерЖурналаРегистрации - экспортер записей читателя
//
Процедура Добавить(Читатель, Экспортер) Экспорт
	Источники.Добавить(Новый Структура("Читатель, Экспортер", Читатель, Экспортер));
КонецПроцедуры

// Выполняет один проход по всем источникам.
//
// Возвращаемое значение:
//   Число - количество переданных записей
//
Функция ВыполнитьПроход() Экспорт

	Количество = 0;
	Для Каждого Источник Из Источники Цикл
		Количество = Количество + ОбработатьИсточник(Источник);
	КонецЦикла;

	Возврат Количество;

КонецФункции

// Закрывает экспортеры, чтобы они отправили отложенные данные (накопленные трассы), и сбрасывает буферы.
//
Процедура Закрыть() Экспорт
	Для Каждого Источник Из Источники Цикл
		Источник.Экспортер.Закрыть();
	КонецЦикла;
	СброситьБуфер();
КонецПроцедуры

// Служебный: принимает события технологического журнала от читателя.
//
// Параметры:
//   События - Массив из Структура - события
//   ОписаниеФайла - Структура - описание файла
//
Процедура ОбработатьСобытияТехнологическогоЖурнала(События, ОписаниеФайла) Экспорт
	Для Каждого Пакет Из Пакеты(События) Цикл
		ТекущийЭкспортер.ОбработатьСобытияТехнологическогоЖурнала(Пакет, ОписаниеФайла);
		СброситьБуфер();
	КонецЦикла;
КонецПроцедуры

// Служебный: принимает записи журнала регистрации от читателя.
//
// Параметры:
//   Записи - Массив из Структура - записи
//   ОписаниеЖурнала - Структура - описание журнала
//
Процедура ОбработатьЗаписиЖурналаРегистрации(Записи, ОписаниеЖурнала) Экспорт
	Для Каждого Пакет Из Пакеты(Записи) Цикл
		ТекущийЭкспортер.ОбработатьЗаписиЖурналаРегистрации(Пакет, ОписаниеЖурнала);
		СброситьБуфер();
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОбработатьИсточник(Источник)

	ТекущийЭкспортер = Источник.Экспортер;
	СбросУспешен = Истина;
	Количество = 0;

	// Буферы сбрасываются после каждого пакета и после завершения прохода экспортером
	// (он может отправить данные, ожидавшие конца прохода), поэтому несброшенных записей не остается
	Попытка
		Количество = Источник.Читатель.Прочитать(ЭтотОбъект);
		Источник.Экспортер.ЗавершитьПроход();
		СброситьБуфер();
	Исключение
		Лог.Ошибка("Ошибка чтения журнала: %1", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		СбросУспешен = Ложь;
	КонецПопытки;

	Если СбросУспешен Тогда
		Источник.Читатель.ЗафиксироватьПозиции();
	Иначе
		Лог.Предупреждение("Позиции чтения откатываются, записи будут прочитаны повторно");
		Источник.Читатель.ОткатитьПозиции();
	КонецЕсли;

	Возврат Количество;

КонецФункции

Процедура СброситьБуфер()
	Результат = Сброс.СброситьБуфер();
	Если НЕ Результат.Успешно() Тогда
		СбросУспешен = Ложь;
	КонецЕсли;
КонецПроцедуры

Функция Пакеты(Элементы)

	Результат = Новый Массив;
	Если Элементы.Количество() <= РазмерПакета Тогда
		Результат.Добавить(Элементы);
		Возврат Результат;
	КонецЕсли;

	Пакет = Новый Массив;
	Для Каждого Элемент Из Элементы Цикл
		Пакет.Добавить(Элемент);
		Если Пакет.Количество() = РазмерПакета Тогда
			Результат.Добавить(Пакет);
			Пакет = Новый Массив;
		КонецЕсли;
	КонецЦикла;
	Если Пакет.Количество() > 0 Тогда
		Результат.Добавить(Пакет);
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти

// Параметры:
//   ОбъектСброса - ОтелSdk, Произвольный - объект с методом СброситьБуфер(), возвращающим ОтелРезультатЭкспорта
//   НовыйРазмерПакета - Число - сколько записей передавать экспортеру между сбросами буферов
//
&Желудь
&Характер("Компанейский")
Процедура ПриСозданииОбъекта(&Блестяшка ОбъектСброса, &Блестяшка НовыйРазмерПакета)
	Сброс = ОбъектСброса;
	РазмерПакета = НовыйРазмерПакета;
	Источники = Новый Массив;
КонецПроцедуры
