// Хранилище позиций чтения файлов в памяти процесса: для тестов и запуска без сохранения состояния.
//
// Интерфейс хранилища позиций: Позиция, УстановитьПозицию, УдалитьПозицию, Ключи.

Перем Позиции;

// Возвращает сохраненную позицию чтения.
//
// Параметры:
//   Ключ - Строка - ключ позиции (путь к файлу)
//
// Возвращаемое значение:
//   Число, Неопределено - позиция или Неопределено, если не сохранялась
//
Функция Позиция(Ключ) Экспорт
	Возврат Позиции[Ключ];
КонецФункции

// Сохраняет позицию чтения.
//
// Параметры:
//   Ключ - Строка - ключ позиции (путь к файлу)
//   Значение - Число - позиция
//
Процедура УстановитьПозицию(Ключ, Значение) Экспорт
	Позиции.Вставить(Ключ, Значение);
КонецПроцедуры

// Удаляет сохраненную позицию чтения.
//
// Параметры:
//   Ключ - Строка - ключ позиции (путь к файлу)
//
Процедура УдалитьПозицию(Ключ) Экспорт
	Позиции.Удалить(Ключ);
КонецПроцедуры

// Возвращает ключи сохраненных позиций, начинающиеся с префикса.
//
// Параметры:
//   Префикс - Строка - начало ключа
//
// Возвращаемое значение:
//   Массив из Строка - ключи
//
Функция Ключи(Префикс) Экспорт
	Результат = Новый Массив;
	Для Каждого КлючИЗначение Из Позиции Цикл
		Если СтрНачинаетсяС(КлючИЗначение.Ключ, Префикс) Тогда
			Результат.Добавить(КлючИЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

&Желудь
&Характер("Компанейский")
Процедура ПриСозданииОбъекта()
	Позиции = Новый Соответствие;
КонецПроцедуры
