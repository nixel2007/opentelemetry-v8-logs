#native

// Чтение данных, дописанных в конец файла журнала, начиная с сохраненной позиции.
//
// Файлы журналов 1С - UTF-8 с BOM. По умолчанию читаются только целые строки: данные обрезаются
// по последнему переводу строки, поэтому многобайтный символ никогда не разрезается, а строку,
// которую платформа еще дописывает, прочитает следующий вызов. Для форматов, где границу записи
// определяет разборщик (журнал регистрации), данные обрезаются по границе символа UTF-8.

Перем КодПереводаСтроки; // Число - код символа перевода строки
Перем BOM; // БуферДвоичныхДанных - метка порядка байтов UTF-8 в начале файла
Перем HexBOM; // Строка - BOM в шестнадцатеричном виде, для сравнения с началом файла

// Границы байтов UTF-8: однобайтные символы - до 128, байты продолжения многобайтного
// символа - от 128 до 192, начальные байты двух-, трех- и четырехбайтных символов - от 192, 224, 240
Перем НачалоБайтовПродолжения; // Число
Перем НачалоСимволовИзДвухБайтов; // Число
Перем НачалоСимволовИзТрехБайтов; // Число
Перем НачалоСимволовИзЧетырехБайтов; // Число
Перем МаксимумБайтСимвола; // Число - наибольшая длина символа UTF-8 в байтах
Перем МаксимумСмещенияПерехода; // Число - наибольшее смещение одного перехода по потоку

#Область ПрограммныйИнтерфейс

// Читает целые строки файла, начиная с позиции.
//
// Параметры:
//   Путь - Строка - путь к файлу
//   Позиция - Число - байтовое смещение, с которого читать; в начале файла пропускается BOM
//   МаксимумБайт - Число - наибольший объем данных, читаемый за вызов
//   ВключаяНеполнуюСтроку - Булево - читать и последнюю строку без перевода строки
//     (для файла, дописывание которого завершено)
//   ПоГраницеСимвола - Булево - обрезать данные не по переводу строки, а по границе символа UTF-8
//   ОжидаемоеНачало - Строка - текст, с которого должен начинаться файл после BOM; если файл начинается
//     иначе, данные не читаются: по пути уже другой файл (например, после ротации по размеру).
//     Начало проверяется в том же открытии файла, что и чтение. Пустая строка - не проверять
//
// Возвращаемое значение:
//   Структура - прочитанные данные:
//     * Текст - Строка - прочитанные строки
//     * Начало - Число - байтовое смещение начала текста
//     * Конец - Число - байтовое смещение, следующее за текстом
//     * РазмерФайла - Число - текущий размер файла
//     * БуферЗаполнен - Булево - прочитано МаксимумБайт, в файле могут оставаться данные
//     * ФайлУсечен - Булево - файл меньше позиции: его пересоздали или усекли
//     * ФайлЗаменен - Булево - файл начинается не с ОжидаемоеНачало, данные не прочитаны
//
Функция Прочитать(Знач Путь, Знач Позиция, Знач МаксимумБайт, Знач ВключаяНеполнуюСтроку = Ложь,
	Знач ПоГраницеСимвола = Ложь, Знач ОжидаемоеНачало = "") Экспорт

	Результат = Новый Структура("Текст, Начало, Конец, РазмерФайла, БуферЗаполнен, ФайлУсечен, ФайлЗаменен");
	Результат.Текст = "";
	Результат.Начало = Позиция;
	Результат.Конец = Позиция;
	Результат.РазмерФайла = 0;
	Результат.БуферЗаполнен = Ложь;
	Результат.ФайлУсечен = Ложь;
	Результат.ФайлЗаменен = Ложь;

	Поток = Новый ФайловыйПоток(Путь, РежимОткрытияФайла.Открыть, ДоступКФайлу.Чтение);
	Попытка
		Если ОжидаемоеНачало <> "" И НЕ НачалоСовпадает(Поток, ОжидаемоеНачало) Тогда
			Результат.ФайлЗаменен = Истина;
		Иначе
			ПрочитатьИзПотока(Поток, Результат, МаксимумБайт, ВключаяНеполнуюСтроку, ПоГраницеСимвола);
		КонецЕсли;
	Исключение
		Поток.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
	Поток.Закрыть();

	Возврат Результат;

КонецФункции

// Возвращает размер строки в кодировке UTF-8 без BOM.
//
// Параметры:
//   Текст - Строка - строка
//
// Возвращаемое значение:
//   Число - размер в байтах
//
Функция РазмерВБайтах(Знач Текст) Экспорт
	Если Текст = "" Тогда
		Возврат 0;
	КонецЕсли;
	Возврат ПолучитьБуферДвоичныхДанныхИзСтроки(Текст, "UTF-8", Ложь).Размер;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПрочитатьИзПотока(Поток, Результат, МаксимумБайт, ВключаяНеполнуюСтроку, ПоГраницеСимвола)

	РазмерФайла = Поток.Размер();
	Результат.РазмерФайла = РазмерФайла;

	Позиция = Результат.Начало;
	Если Позиция > РазмерФайла Тогда
		Результат.ФайлУсечен = Истина;
		Возврат;
	КонецЕсли;

	Если Позиция = 0 Тогда
		Позиция = ДлинаBOM(Поток, РазмерФайла);
		Результат.Начало = Позиция;
		Результат.Конец = Позиция;
	КонецЕсли;

	Доступно = РазмерФайла - Позиция;
	Если Доступно <= 0 Тогда
		Возврат;
	КонецЕсли;

	Буфер = Новый БуферДвоичныхДанных(Мин(Доступно, МаксимумБайт));
	ПерейтиКПозиции(Поток, Позиция);
	Прочитано = Поток.Прочитать(Буфер, 0, Буфер.Размер);
	Результат.БуферЗаполнен = (Прочитано = МаксимумБайт);

	Если ПоГраницеСимвола Тогда
		Длина = ДлинаДоГраницыСимвола(Буфер, Прочитано);
	ИначеЕсли НЕ (ВключаяНеполнуюСтроку И Прочитано = Доступно) Тогда
		Длина = ДлинаДоПоследнегоПереводаСтроки(Буфер, Прочитано);
	Иначе
		// Файл больше не дописывается и прочитан до конца: последняя строка без перевода строки - целая
		Длина = Прочитано;
	КонецЕсли;

	Если Длина = 0 Тогда
		Возврат;
	КонецЕсли;

	Результат.Текст = ПолучитьСтрокуИзБуфераДвоичныхДанных(Буфер.Прочитать(0, Длина), "UTF-8");
	Результат.Конец = Позиция + Длина;

КонецПроцедуры

// Смещение перехода ограничено 2 ГБ, файл журнала бывает больше: переходим шагами от текущей позиции
Процедура ПерейтиКПозиции(Поток, Позиция)
	Поток.Перейти(0, ПозицияВПотоке.Начало);
	Осталось = Позиция;
	Пока Осталось > 0 Цикл
		Шаг = Мин(Осталось, МаксимумСмещенияПерехода);
		Поток.Перейти(Шаг, ПозицияВПотоке.Текущая);
		Осталось = Осталось - Шаг;
	КонецЦикла;
КонецПроцедуры

Функция ДлинаBOM(Поток, РазмерФайла)

	Если РазмерФайла < BOM.Размер Тогда
		Возврат 0;
	КонецЕсли;

	Буфер = Новый БуферДвоичныхДанных(BOM.Размер);
	Поток.Перейти(0, ПозицияВПотоке.Начало);
	Поток.Прочитать(Буфер, 0, BOM.Размер);
	Если ПолучитьHexСтрокуИзБуфераДвоичныхДанных(Буфер) = HexBOM Тогда
		Возврат BOM.Размер;
	КонецЕсли;

	Возврат 0;

КонецФункции

Функция НачалоСовпадает(Поток, ОжидаемоеНачало)

	Ожидаемое = ПолучитьБуферДвоичныхДанныхИзСтроки(ОжидаемоеНачало, "UTF-8", Ложь);
	РазмерФайла = Поток.Размер();
	Смещение = ДлинаBOM(Поток, РазмерФайла);
	Если РазмерФайла - Смещение < Ожидаемое.Размер Тогда
		Возврат Ложь;
	КонецЕсли;

	Буфер = Новый БуферДвоичныхДанных(Ожидаемое.Размер);
	Поток.Перейти(Смещение, ПозицияВПотоке.Начало);
	Поток.Прочитать(Буфер, 0, Буфер.Размер);

	Возврат ПолучитьHexСтрокуИзБуфераДвоичныхДанных(Буфер) = ПолучитьHexСтрокуИзБуфераДвоичныхДанных(Ожидаемое);

КонецФункции

Функция ДлинаДоПоследнегоПереводаСтроки(Буфер, Прочитано)
	Индекс = Прочитано - 1;
	Пока Индекс >= 0 Цикл
		Если Буфер[Индекс] = КодПереводаСтроки Тогда
			Возврат Индекс + 1;
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
	Возврат 0;
КонецФункции

// Отбрасывает в конце буфера байты недописанного многобайтного символа UTF-8.
//
// Параметры:
//   Буфер - БуферДвоичныхДанных - прочитанные данные
//   Прочитано - Число - сколько байтов буфера заполнено
//
// Возвращаемое значение:
//   Число - длина данных без недописанного символа в конце
//
Функция ДлинаДоГраницыСимвола(Буфер, Прочитано)

	// Ищем начальный байт последнего символа: байты продолжения имеют вид 10xxxxxx
	Индекс = Прочитано - 1;
	Пока Индекс >= 0 И Индекс >= Прочитано - МаксимумБайтСимвола Цикл
		Байт = Буфер[Индекс];
		Если Байт < НачалоБайтовПродолжения ИЛИ Байт >= НачалоСимволовИзДвухБайтов Тогда
			Прервать;
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;

	Если Индекс < 0 ИЛИ Индекс < Прочитано - МаксимумБайтСимвола Тогда
		Возврат Прочитано;
	КонецЕсли;

	Если Индекс + ДлинаСимвола(Буфер[Индекс]) <= Прочитано Тогда
		Возврат Прочитано;
	КонецЕсли;

	Возврат Индекс;

КонецФункции

Функция ДлинаСимвола(НачальныйБайт)
	Если НачальныйБайт < НачалоБайтовПродолжения Тогда
		Возврат 1;
	ИначеЕсли НачальныйБайт < НачалоСимволовИзТрехБайтов Тогда
		Возврат 2;
	ИначеЕсли НачальныйБайт < НачалоСимволовИзЧетырехБайтов Тогда
		Возврат 3;
	Иначе
		Возврат МаксимумБайтСимвола;
	КонецЕсли;
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта()
	КодПереводаСтроки = КодСимвола(Символы.ПС);
	HexBOM = "EFBBBF";
	BOM = ПолучитьБуферДвоичныхДанныхИзHexСтроки(HexBOM);
	НачалоБайтовПродолжения = 128;
	НачалоСимволовИзДвухБайтов = 192;
	НачалоСимволовИзТрехБайтов = 224;
	НачалоСимволовИзЧетырехБайтов = 240;
	МаксимумБайтСимвола = 4;
	МаксимумСмещенияПерехода = 2147483647;
КонецПроцедуры
