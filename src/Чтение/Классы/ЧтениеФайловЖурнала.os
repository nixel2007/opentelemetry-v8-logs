#native
#Использовать autumn-logos

// Дочитывание файла журнала порциями с позиции чтения.
//
// В лог приложения попадают переходы, а не каждый проход: начало чтения файла (первые новые
// данные с запуска приложения), полное прочтение завершенного файла и усечение файла.

&Пластилин
Перем ЧтениеХвостаФайла; // ЧтениеХвостаФайла - чтение данных с позиции

&Лог(Значение = "oscript.app.opentelemetry-v8-logs", УчитыватьИмяКласса = Ложь)
Перем Лог; // Лог - лог приложения

Перем МаксимумПорции; // Число - предел увеличения порции, если в нее не помещается ни одна запись, байт
Перем МножительПорции; // Число - во сколько раз увеличивается такая порция

#Область ПрограммныйИнтерфейс

// Дочитывает файл журнала до конца порциями и передает каждую порцию разборщику.
//
// Позиция сдвигается на разобранную часть порции: незавершенный хвост, который разборщик
// вернул в остатке, будет прочитан снова. Если в порцию не поместилась ни одна запись,
// порция увеличивается.
//
// Параметры:
//   Путь - Строка - полный путь к файлу
//   Позиции - ПозицииЧтения - позиции чтения каталога
//   МаксимумБайт - Число - размер порции
//   Завершен - Булево - файл больше не дописывается
//   Разборщик - Произвольный - объект с методом ОбработатьПорцию(Текст, ТекстЗавершен, Контекст),
//     который разбирает текст, передает записи дальше и возвращает
//     Структура("Количество, Остаток") - число переданных записей и неразобранный хвост текста
//   Контекст - Произвольный - контекст файла, передаваемый разборщику
//   ПоГраницеСимвола - Булево - передавать данные до конца файла, а не до последнего перевода строки:
//     для форматов, где разборщик сам находит конец записи
//
// Возвращаемое значение:
//   Число - количество переданных записей
//
Функция ПрочитатьФайл(Путь, Позиции, МаксимумБайт, Завершен, Разборщик, Контекст,
	ПоГраницеСимвола = Ложь) Экспорт

	Количество = 0;
	Позиция = Позиции.Позиция(Путь);
	Состояние = Позиции.СостояниеЧтения(Путь);
	Максимум = МаксимумБайт;

	Пока Истина Цикл

		Прочитанное = ЧтениеХвостаФайла.Прочитать(Путь, Позиция, Максимум, Завершен, ПоГраницеСимвола);

		Если Прочитанное.ФайлУсечен Тогда
			Лог.Предупреждение("Файл журнала %1 усечен, чтение с начала", Путь);
			Позиция = 0;
			Позиции.Установить(Путь, Позиция);
			Продолжить;
		КонецЕсли;

		ОтметитьНачалоЧтения(Путь, Позиция, Прочитанное, Состояние);

		ТекстЗавершен = Завершен И НЕ Прочитанное.БуферЗаполнен;
		Результат = Разборщик.ОбработатьПорцию(Прочитанное.Текст, ТекстЗавершен, Контекст);
		Количество = Количество + Результат.Количество;
		Состояние.Записей = Состояние.Записей + Результат.Количество;
		НоваяПозиция = Прочитанное.Конец - ЧтениеХвостаФайла.РазмерВБайтах(Результат.Остаток);

		Если НоваяПозиция > Позиция Тогда
			Позиции.Установить(Путь, НоваяПозиция);
		КонецЕсли;

		Если НоваяПозиция <= Прочитанное.Начало Тогда
			// Запись не поместилась в порцию: читаем порцию побольше
			Если Прочитанное.БуферЗаполнен И Максимум < МаксимумПорции Тогда
				Максимум = Максимум * МножительПорции;
				Продолжить;
			КонецЕсли;
			Прервать;
		КонецЕсли;

		Позиция = НоваяПозиция;
		Максимум = МаксимумБайт;

		Если НЕ Прочитанное.БуферЗаполнен Тогда
			Прервать;
		КонецЕсли;

	КонецЦикла;

	ОтметитьПолноеПрочтение(Путь, Позиция, Прочитанное, Завершен, Состояние);

	Возврат Количество;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОтметитьНачалоЧтения(Путь, Позиция, Прочитанное, Состояние)
	Если НЕ Состояние.Начато И Прочитанное.Конец > Прочитанное.Начало Тогда
		Лог.Информация("Начато чтение файла журнала %1 с позиции %2", Путь, Формат(Позиция, "ЧН=0; ЧГ=0"));
		Состояние.Начато = Истина;
	КонецЕсли;
КонецПроцедуры

// Логирует полное прочтение завершенного файла. Файлы, прочитанные до конца в прошлые запуски,
// не логируются: Начато только у файлов, из которых в этом запуске читались данные.
//
// Параметры:
//   Путь - Строка - полный путь к файлу
//   Позиция - Число - позиция после чтения
//   Прочитанное - Структура - последняя прочитанная порция, см. ЧтениеХвостаФайла.Прочитать
//   Завершен - Булево - файл больше не дописывается
//   Состояние - Структура - состояние чтения файла, см. ПозицииЧтения.СостояниеЧтения
//
Процедура ОтметитьПолноеПрочтение(Путь, Позиция, Прочитанное, Завершен, Состояние)

	ДочитанВЭтомЗапуске = Состояние.Начато И НЕ Состояние.Прочитан;
	Если НЕ (Завершен И ДочитанВЭтомЗапуске И Позиция >= Прочитанное.РазмерФайла) Тогда
		Возврат;
	КонецЕсли;

	Лог.Информация("Файл журнала прочитан полностью: %1, записей %2", Путь,
		Формат(Состояние.Записей, "ЧН=0; ЧГ=0"));
	Состояние.Прочитан = Истина;

КонецПроцедуры

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта()
	МаксимумПорции = 268435456; // 256 МБ
	МножительПорции = 2;
КонецПроцедуры
