#native

// Позиции чтения файлов одного каталога журнала.
//
// Прочитанные позиции хранятся в памяти и попадают в хранилище только при фиксации, которая
// выполняется после надежной передачи прочитанных данных: при сбое данные будут прочитаны
// повторно, а не потеряны. При фиксации удаляются позиции файлов каталога, которых больше нет
// на диске. Признак первого запуска хранится в хранилище по отдельному ключу каталога; он и конечные
// позиции файлов в режиме НачинатьСКонца сохраняются сразу, без фиксации, см. ЗавершитьПроход.

Перем КаталогЖурнала; // Строка - полный путь к каталогу журнала
Перем Хранилище; // Произвольный - хранилище позиций, см. ХранилищеПозицийВПамяти
Перем НачинатьСКонца; // Булево - при первом запуске начинать чтение файлов с конца

Перем Позиции; // Соответствие: путь к файлу -> позиция, прочитанная в памяти
Перем ИзмененныеПозиции; // Соответствие: путь к файлу -> Истина
Перем НайденныеФайлы; // Соответствие: путь к файлу -> Истина, файлы последнего прохода
Перем СостоянияЧтения; // Соответствие: путь к файлу -> Структура, см. СостояниеЧтения
Перем ПроходЗавершен; // Булево - последний проход дошел до конца, см. ЗавершитьПроход
Перем Инициализирован; // Булево - первый проход каталога уже выполнен
Перем ИнициализацияИзменена; // Булево - идет первый проход, признак инициализации еще не сохранен

#Область ПрограммныйИнтерфейс

// Начинает проход по файлам каталога.
//
Процедура НачатьПроход() Экспорт

	Если НЕ Инициализирован И НЕ ИнициализацияИзменена Тогда
		Инициализирован = (Хранилище.Позиция(КлючИнициализации()) <> Неопределено);
		ИнициализацияИзменена = НЕ Инициализирован;
	КонецЕсли;

	НайденныеФайлы = Новый Соответствие;
	ПроходЗавершен = Ложь;

КонецПроцедуры

// Завершает проход по файлам каталога: файлы, появившиеся после первого прохода,
// читаются с начала независимо от режима НачинатьСКонца.
//
// Признак первого запуска сохраняется сразу, а не при фиксации, как и конечные позиции файлов
// в режиме НачинатьСКонца: пропущенные данные никуда не передаются, и после отката или
// перезапуска до фиксации следующий проход продолжит с них, а не с нового конца файлов.
//
Процедура ЗавершитьПроход() Экспорт
	Если ИнициализацияИзменена Тогда
		Хранилище.УстановитьПозицию(КлючИнициализации(), 1);
		ИнициализацияИзменена = Ложь;
	КонецЕсли;
	Инициализирован = Истина;
	ПроходЗавершен = Истина;
КонецПроцедуры

// Возвращает позицию, с которой нужно читать файл, и отмечает файл найденным в проходе.
//
// Параметры:
//   Путь - Строка - полный путь к файлу
//
// Возвращаемое значение:
//   Число - позиция чтения
//
Функция Позиция(Путь) Экспорт

	НайденныеФайлы.Вставить(Путь, Истина);

	Позиция = Позиции[Путь];
	Если Позиция <> Неопределено Тогда
		Возврат Позиция;
	КонецЕсли;

	Позиция = Хранилище.Позиция(Путь);
	Если Позиция = Неопределено Тогда
		Позиция = 0;
		// При первом запуске уже накопленные данные можно пропустить, см. ЗавершитьПроход
		Если НЕ Инициализирован И НачинатьСКонца Тогда
			Позиция = Новый Файл(Путь).Размер();
			Хранилище.УстановитьПозицию(Путь, Позиция);
		КонецЕсли;
	КонецЕсли;

	Позиции.Вставить(Путь, Позиция);
	Возврат Позиция;

КонецФункции

// Запоминает прочитанную позицию файла до фиксации.
//
// Параметры:
//   Путь - Строка - полный путь к файлу
//   Позиция - Число - позиция, до которой данные переданы обработчику
//
Процедура Установить(Путь, Позиция) Экспорт
	Позиции.Вставить(Путь, Позиция);
	ИзмененныеПозиции.Вставить(Путь, Истина);
КонецПроцедуры

// Состояние чтения файла с запуска приложения: по нему начало и полное прочтение файла
// попадают в лог один раз, а не при каждом проходе по дописываемому файлу.
//
// Параметры:
//   Путь - Строка - полный путь к файлу
//
// Возвращаемое значение:
//   Структура - изменяемое состояние:
//     * Начато - Булево - из файла читались новые данные
//     * Записей - Число - сколько записей файла передано
//     * Прочитан - Булево - завершенный файл прочитан до конца
//
Функция СостояниеЧтения(Путь) Экспорт
	Состояние = СостоянияЧтения[Путь];
	Если Состояние = Неопределено Тогда
		Состояние = Новый Структура("Начато, Записей, Прочитан", Ложь, 0, Ложь);
		СостоянияЧтения.Вставить(Путь, Состояние);
	КонецЕсли;
	Возврат Состояние;
КонецФункции

// Сохраняет в хранилище позиции, прочитанные после предыдущей фиксации,
// и удаляет позиции файлов каталога, которых больше нет на диске.
//
Процедура Зафиксировать() Экспорт

	Для Каждого КлючИЗначение Из ИзмененныеПозиции Цикл
		Путь = КлючИЗначение.Ключ;
		Хранилище.УстановитьПозицию(Путь, Позиции[Путь]);
	КонецЦикла;
	ИзмененныеПозиции.Очистить();

	Если НЕ ПроходЗавершен Тогда
		Возврат;
	КонецЕсли;

	// Хранилище общее для всех источников, а их каталоги могут быть вложены друг в друга:
	// позиция удаляется, только если файла больше нет, а не потому что его не нашел этот проход
	ПрефиксКаталога = КаталогЖурнала;
	Если НЕ СтрЗаканчиваетсяНа(ПрефиксКаталога, ПолучитьРазделительПути()) Тогда
		ПрефиксКаталога = ПрефиксКаталога + ПолучитьРазделительПути();
	КонецЕсли;
	Для Каждого Путь Из Хранилище.Ключи(ПрефиксКаталога) Цикл
		Если НайденныеФайлы[Путь] = Неопределено И НЕ Новый Файл(Путь).Существует() Тогда
			Хранилище.УдалитьПозицию(Путь);
			Позиции.Удалить(Путь);
		КонецЕсли;
	КонецЦикла;

	УдаленныеФайлы = Новый Массив;
	Для Каждого Состояние Из СостоянияЧтения Цикл
		Если НайденныеФайлы[Состояние.Ключ] = Неопределено Тогда
			УдаленныеФайлы.Добавить(Состояние.Ключ);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Путь Из УдаленныеФайлы Цикл
		СостоянияЧтения.Удалить(Путь);
	КонецЦикла;

КонецПроцедуры

// Отбрасывает прочитанные, но не зафиксированные позиции: следующий проход продолжит чтение
// с позиций из хранилища.
//
Процедура Откатить() Экспорт
	Позиции.Очистить();
	ИзмененныеПозиции.Очистить();
	// Первый проход прервался до конца: при следующем проходе снова действует режим НачинатьСКонца
	Если ИнициализацияИзменена Тогда
		Инициализирован = Ложь;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КлючИнициализации()
	Возврат "init:" + КаталогЖурнала;
КонецФункции

#КонецОбласти

// Параметры:
//   Каталог - Строка - полный путь к каталогу журнала
//   ХранилищеПозиций - Произвольный - хранилище позиций, см. ХранилищеПозицийВПамяти
//   ПропускатьНакопленное - Булево - при первом запуске начинать чтение файлов с конца
//
&Желудь
&Характер("Компанейский")
Процедура ПриСозданииОбъекта(&Блестяшка Каталог, &Блестяшка ХранилищеПозиций, &Блестяшка ПропускатьНакопленное)

	КаталогЖурнала = Каталог;
	Хранилище = ХранилищеПозиций;
	НачинатьСКонца = ПропускатьНакопленное;

	Позиции = Новый Соответствие;
	ИзмененныеПозиции = Новый Соответствие;
	НайденныеФайлы = Новый Соответствие;
	СостоянияЧтения = Новый Соответствие;
	ПроходЗавершен = Ложь;
	Инициализирован = Ложь;
	ИнициализацияИзменена = Ложь;

КонецПроцедуры
