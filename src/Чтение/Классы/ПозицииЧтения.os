#native

// Позиции чтения файлов одного каталога журнала.
//
// Прочитанные позиции хранятся в памяти и попадают в хранилище только при фиксации, которая
// выполняется после надежной передачи прочитанных данных: при сбое данные будут прочитаны
// повторно, а не потеряны. При фиксации удаляются позиции файлов, не найденных при последнем
// проходе. Признак первого запуска хранится в хранилище по отдельному ключу каталога.

Перем КаталогЖурнала;
Перем Хранилище;
Перем НачинатьСКонца;

Перем Позиции; // Соответствие: путь к файлу -> позиция, прочитанная в памяти
Перем ИзмененныеПозиции; // Соответствие: путь к файлу -> Истина
Перем НайденныеФайлы; // Соответствие: путь к файлу -> Истина, файлы последнего прохода
Перем ПроходЗавершен;
Перем Инициализирован;
Перем ИнициализацияИзменена;

#Область ПрограммныйИнтерфейс

// Начинает проход по файлам каталога.
//
Процедура НачатьПроход() Экспорт

	Если НЕ Инициализирован И НЕ ИнициализацияИзменена Тогда
		Инициализирован = (Хранилище.Позиция(КлючИнициализации()) <> Неопределено);
		ИнициализацияИзменена = НЕ Инициализирован;
	КонецЕсли;

	НайденныеФайлы = Новый Соответствие;
	ПроходЗавершен = Ложь;

КонецПроцедуры

// Завершает проход по файлам каталога: файлы, появившиеся после первого прохода,
// читаются с начала независимо от режима НачинатьСКонца.
//
Процедура ЗавершитьПроход() Экспорт
	Инициализирован = Истина;
	ПроходЗавершен = Истина;
КонецПроцедуры

// Возвращает позицию, с которой нужно читать файл, и отмечает файл найденным в проходе.
//
// Параметры:
//   Путь - Строка - полный путь к файлу
//
// Возвращаемое значение:
//   Число - позиция чтения
//
Функция Позиция(Путь) Экспорт

	НайденныеФайлы.Вставить(Путь, Истина);

	Позиция = Позиции[Путь];
	Если Позиция <> Неопределено Тогда
		Возврат Позиция;
	КонецЕсли;

	Позиция = Хранилище.Позиция(Путь);
	Если Позиция = Неопределено Тогда
		Позиция = 0;
		// При первом запуске уже накопленные данные можно пропустить
		Если НЕ Инициализирован И НачинатьСКонца Тогда
			Позиция = Новый Файл(Путь).Размер();
			Установить(Путь, Позиция);
		КонецЕсли;
	КонецЕсли;

	Позиции.Вставить(Путь, Позиция);
	Возврат Позиция;

КонецФункции

// Запоминает прочитанную позицию файла до фиксации.
//
// Параметры:
//   Путь - Строка - полный путь к файлу
//   Позиция - Число - позиция, до которой данные переданы обработчику
//
Процедура Установить(Путь, Позиция) Экспорт
	Позиции.Вставить(Путь, Позиция);
	ИзмененныеПозиции.Вставить(Путь, Истина);
КонецПроцедуры

// Сохраняет в хранилище позиции, прочитанные после предыдущей фиксации,
// и удаляет позиции файлов, не найденных при последнем проходе.
//
Процедура Зафиксировать() Экспорт

	Для Каждого КлючИЗначение Из ИзмененныеПозиции Цикл
		Путь = КлючИЗначение.Ключ;
		Хранилище.УстановитьПозицию(Путь, Позиции[Путь]);
	КонецЦикла;
	ИзмененныеПозиции.Очистить();

	Если ИнициализацияИзменена И Инициализирован Тогда
		Хранилище.УстановитьПозицию(КлючИнициализации(), 1);
		ИнициализацияИзменена = Ложь;
	КонецЕсли;

	Если НЕ ПроходЗавершен Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Путь Из Хранилище.Ключи(ОбъединитьПути(КаталогЖурнала, "")) Цикл
		Если НайденныеФайлы[Путь] = Неопределено Тогда
			Хранилище.УдалитьПозицию(Путь);
			Позиции.Удалить(Путь);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Отбрасывает прочитанные, но не зафиксированные позиции: следующий проход продолжит чтение
// с позиций из хранилища.
//
Процедура Откатить() Экспорт
	Позиции.Очистить();
	ИзмененныеПозиции.Очистить();
	// Первый запуск не зафиксирован: при следующем проходе снова действует режим НачинатьСКонца
	Если ИнициализацияИзменена Тогда
		Инициализирован = Ложь;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КлючИнициализации()
	Возврат "init:" + КаталогЖурнала;
КонецФункции

#КонецОбласти

// Параметры:
//   Каталог - Строка - полный путь к каталогу журнала
//   ХранилищеПозиций - Произвольный - хранилище позиций, см. ХранилищеПозицийВПамяти
//   ПропускатьНакопленное - Булево - при первом запуске начинать чтение файлов с конца
//
Процедура ПриСозданииОбъекта(Каталог, ХранилищеПозиций, ПропускатьНакопленное)

	КаталогЖурнала = Каталог;
	Хранилище = ХранилищеПозиций;
	НачинатьСКонца = ПропускатьНакопленное;

	Позиции = Новый Соответствие;
	ИзмененныеПозиции = Новый Соответствие;
	НайденныеФайлы = Новый Соответствие;
	ПроходЗавершен = Ложь;
	Инициализирован = Ложь;
	ИнициализацияИзменена = Ложь;

КонецПроцедуры
