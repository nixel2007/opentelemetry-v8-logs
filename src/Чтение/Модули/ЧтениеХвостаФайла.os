#native

// Чтение данных, дописанных в конец файла журнала, начиная с сохраненной позиции.
//
// Файлы журналов 1С - UTF-8 с BOM. Читаются только целые строки: данные обрезаются по последнему
// переводу строки, поэтому многобайтный символ никогда не разрезается, а строку, которую платформа
// еще дописывает, прочитает следующий вызов.

Перем КодПереводаСтроки;

#Область ПрограммныйИнтерфейс

// Читает целые строки файла, начиная с позиции.
//
// Параметры:
//   Путь - Строка - путь к файлу
//   Позиция - Число - байтовое смещение, с которого читать; в начале файла пропускается BOM
//   МаксимумБайт - Число - наибольший объем данных, читаемый за вызов
//   ВключаяНеполнуюСтроку - Булево - читать и последнюю строку без перевода строки
//     (для файла, дописывание которого завершено)
//
// Возвращаемое значение:
//   Структура - прочитанные данные:
//     * Текст - Строка - прочитанные строки
//     * Начало - Число - байтовое смещение начала текста
//     * Конец - Число - байтовое смещение, следующее за текстом
//     * РазмерФайла - Число - текущий размер файла
//     * БуферЗаполнен - Булево - прочитано МаксимумБайт, в файле могут оставаться данные
//     * ФайлУсечен - Булево - файл меньше позиции: его пересоздали или усекли
//
Функция Прочитать(Знач Путь, Знач Позиция, Знач МаксимумБайт, Знач ВключаяНеполнуюСтроку = Ложь) Экспорт

	Результат = Новый Структура("Текст, Начало, Конец, РазмерФайла, БуферЗаполнен, ФайлУсечен",
		"", Позиция, Позиция, 0, Ложь, Ложь);

	Поток = Новый ФайловыйПоток(Путь, РежимОткрытияФайла.Открыть, ДоступКФайлу.Чтение);
	Попытка
		ПрочитатьИзПотока(Поток, Результат, МаксимумБайт, ВключаяНеполнуюСтроку);
	Исключение
		Поток.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
	Поток.Закрыть();

	Возврат Результат;

КонецФункции

// Возвращает размер строки в кодировке UTF-8 без BOM.
//
// Параметры:
//   Текст - Строка - строка
//
// Возвращаемое значение:
//   Число - размер в байтах
//
Функция РазмерВБайтах(Знач Текст) Экспорт
	Если Текст = "" Тогда
		Возврат 0;
	КонецЕсли;
	Возврат ПолучитьБуферДвоичныхДанныхИзСтроки(Текст, "UTF-8", Ложь).Размер;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПрочитатьИзПотока(Поток, Результат, МаксимумБайт, ВключаяНеполнуюСтроку)

	РазмерФайла = Поток.Размер();
	Результат.РазмерФайла = РазмерФайла;

	Позиция = Результат.Начало;
	Если Позиция > РазмерФайла Тогда
		Результат.ФайлУсечен = Истина;
		Возврат;
	КонецЕсли;

	Если Позиция = 0 Тогда
		Позиция = ДлинаBOM(Поток, РазмерФайла);
		Результат.Начало = Позиция;
		Результат.Конец = Позиция;
	КонецЕсли;

	Доступно = РазмерФайла - Позиция;
	Если Доступно <= 0 Тогда
		Возврат;
	КонецЕсли;

	Буфер = Новый БуферДвоичныхДанных(Мин(Доступно, МаксимумБайт));
	Поток.Перейти(Позиция, ПозицияВПотоке.Начало);
	Прочитано = Поток.Прочитать(Буфер, 0, Буфер.Размер);
	Результат.БуферЗаполнен = (Прочитано = МаксимумБайт);

	Длина = Прочитано;
	ЧитатьНеполнуюСтроку = ВключаяНеполнуюСтроку И Прочитано = Доступно;
	Если НЕ ЧитатьНеполнуюСтроку Тогда
		Длина = ДлинаДоПоследнегоПереводаСтроки(Буфер, Прочитано);
	КонецЕсли;

	Если Длина = 0 Тогда
		Возврат;
	КонецЕсли;

	Результат.Текст = ПолучитьСтрокуИзБуфераДвоичныхДанных(Буфер.Прочитать(0, Длина), "UTF-8");
	Результат.Конец = Позиция + Длина;

КонецПроцедуры

Функция ДлинаBOM(Поток, РазмерФайла)

	Если РазмерФайла < 3 Тогда
		Возврат 0;
	КонецЕсли;

	Буфер = Новый БуферДвоичныхДанных(3);
	Поток.Перейти(0, ПозицияВПотоке.Начало);
	Поток.Прочитать(Буфер, 0, 3);
	Если Буфер[0] = 239 И Буфер[1] = 187 И Буфер[2] = 191 Тогда
		Возврат 3;
	КонецЕсли;

	Возврат 0;

КонецФункции

Функция ДлинаДоПоследнегоПереводаСтроки(Буфер, Прочитано)
	Индекс = Прочитано - 1;
	Пока Индекс >= 0 Цикл
		Если Буфер[Индекс] = КодПереводаСтроки Тогда
			Возврат Индекс + 1;
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
	Возврат 0;
КонецФункции

#КонецОбласти

КодПереводаСтроки = 10;
