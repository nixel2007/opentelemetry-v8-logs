#native

// Читатель каталога технологического журнала.
//
// Находит файлы журнала (<процесс>_<PID>/ГГММДДЧЧ.log или <процесс>_<PID>_ГГММДДЧЧ.log),
// дочитывает каждый с сохраненной позиции и передает разобранные события обработчику.
// Позиции сохраняются в хранилище только методом ЗафиксироватьПозиции, который вызывается
// после того, как обработчик надежно передал события дальше: так при сбое события
// будут прочитаны повторно, а не потеряны.

Перем КаталогЖурнала;
Перем Хранилище;
Перем МаксимумБайт;
Перем НачинатьСКонца;

Перем Позиции; // Соответствие: путь к файлу -> позиция, прочитанная в памяти
Перем ИзмененныеПозиции; // Соответствие: путь к файлу -> Истина
Перем НайденныеФайлы; // Соответствие: путь к файлу -> Истина, файлы последнего прохода
Перем Инициализирован;
Перем ИнициализацияИзменена;

Перем РегулярноеИмяФайла;
Перем РегулярноеИмяКаталога;

#Область ПрограммныйИнтерфейс

// Выполняет один проход по файлам журнала и передает новые события обработчику.
//
// Параметры:
//   Обработчик - Произвольный - объект с методом ОбработатьСобытияТехЖурнала(События, ОписаниеФайла):
//     События - Массив из Структура - см. СобытияТехЖурнала.НовоеСобытие
//     ОписаниеФайла - Структура - Путь, Каталог, Процесс, ИдПроцесса
//
// Возвращаемое значение:
//   Число - количество переданных событий
//
Функция Прочитать(Обработчик) Экспорт

	ПроверитьИнициализацию();

	Количество = 0;
	НайденныеФайлы = Новый Соответствие;

	Для Каждого Поток Из ПотокиФайлов() Цикл
		Файлы = Поток.Значение;
		Для Индекс = 0 По Файлы.ВГраница() Цикл
			ОписаниеФайла = Файлы[Индекс];
			НайденныеФайлы.Вставить(ОписаниеФайла.Путь, Истина);
			// Платформа пишет только в файл текущего часа: предыдущие файлы потока завершены
			Завершен = Индекс < Файлы.ВГраница();
			Количество = Количество + ПрочитатьФайл(ОписаниеФайла, Завершен, Обработчик);
		КонецЦикла;
	КонецЦикла;

	Инициализирован = Истина;

	Возврат Количество;

КонецФункции

// Сохраняет в хранилище позиции, прочитанные после предыдущей фиксации,
// и удаляет позиции файлов, которых больше нет.
//
Процедура ЗафиксироватьПозиции() Экспорт

	Для Каждого КлючИЗначение Из ИзмененныеПозиции Цикл
		Путь = КлючИЗначение.Ключ;
		Хранилище.УстановитьПозицию(Путь, Позиции[Путь]);
	КонецЦикла;
	ИзмененныеПозиции.Очистить();

	Если ИнициализацияИзменена Тогда
		Хранилище.УстановитьПозицию(КлючИнициализации(), 1);
		ИнициализацияИзменена = Ложь;
	КонецЕсли;

	Если НайденныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Путь Из Хранилище.Ключи(ПрефиксКлючей()) Цикл
		Если НайденныеФайлы[Путь] = Неопределено Тогда
			Хранилище.УдалитьПозицию(Путь);
			Позиции.Удалить(Путь);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьИнициализацию()
	Если Инициализирован Тогда
		Возврат;
	КонецЕсли;
	Инициализирован = (Хранилище.Позиция(КлючИнициализации()) <> Неопределено);
	ИнициализацияИзменена = НЕ Инициализирован;
КонецПроцедуры

// Группирует файлы по потокам записи (каталог и процесс), внутри потока - по возрастанию часа.
//
Функция ПотокиФайлов()

	Потоки = Новый Соответствие;

	Для Каждого Файл Из НайтиФайлы(КаталогЖурнала, "*.log", Истина) Цикл

		ОписаниеФайла = ОписаниеФайла(Файл);
		Если ОписаниеФайла = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		КлючПотока = Файл.Путь + "|" + ОписаниеФайла.Процесс + "|" + ОписаниеФайла.ИдПроцесса;
		Файлы = Потоки[КлючПотока];
		Если Файлы = Неопределено Тогда
			Файлы = Новый СписокЗначений;
			Потоки.Вставить(КлючПотока, Файлы);
		КонецЕсли;
		Файлы.Добавить(ОписаниеФайла, ОписаниеФайла.Час);

	КонецЦикла;

	Результат = Новый Соответствие;
	Для Каждого Поток Из Потоки Цикл
		Поток.Значение.СортироватьПоПредставлению();
		Результат.Вставить(Поток.Ключ, Поток.Значение.ВыгрузитьЗначения());
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ОписаниеФайла(Файл)

	Совпадения = РегулярноеИмяФайла.НайтиСовпадения(Файл.Имя);
	Если Совпадения.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Группы = Совпадения[0].Группы;

	Процесс = Группы[1].Значение;
	ИдПроцесса = Группы[2].Значение;
	Если Процесс = "" Тогда
		СовпаденияКаталога = РегулярноеИмяКаталога.НайтиСовпадения(Новый Файл(Файл.Путь).Имя);
		Если СовпаденияКаталога.Количество() > 0 Тогда
			Процесс = СовпаденияКаталога[0].Группы[1].Значение;
			ИдПроцесса = СовпаденияКаталога[0].Группы[2].Значение;
		КонецЕсли;
	КонецЕсли;

	Час = Группы[3].Значение;

	Описание = Новый Структура;
	Описание.Вставить("Путь", Файл.ПолноеИмя);
	Описание.Вставить("Каталог", КаталогЖурнала);
	Описание.Вставить("Процесс", Процесс);
	Описание.Вставить("ИдПроцесса", ИдПроцесса);
	Описание.Вставить("Час", Час);
	Описание.Вставить("ДатаЧаса", Дата("20" + Час + "0000"));

	Возврат Описание;

КонецФункции

Функция ПрочитатьФайл(ОписаниеФайла, Завершен, Обработчик)

	Путь = ОписаниеФайла.Путь;
	Количество = 0;
	Позиция = НачальнаяПозиция(Путь);
	Максимум = МаксимумБайт;

	Пока Истина Цикл

		Прочитанное = ЧтениеХвостаФайла.Прочитать(Путь, Позиция, Максимум, Завершен);

		Если Прочитанное.ФайлУсечен Тогда
			Позиция = 0;
			УстановитьПозицию(Путь, Позиция);
			Продолжить;
		КонецЕсли;

		ТекстЗавершен = Завершен И НЕ Прочитанное.БуферЗаполнен;
		Разбор = РазобратьТекст(Прочитанное.Текст, ОписаниеФайла.ДатаЧаса, ТекстЗавершен);
		НоваяПозиция = Прочитанное.Конец - ЧтениеХвостаФайла.РазмерВБайтах(Разбор.Остаток);

		Если Разбор.События.Количество() > 0 Тогда
			Обработчик.ОбработатьСобытияТехЖурнала(Разбор.События, ОписаниеФайла);
			Количество = Количество + Разбор.События.Количество();
		КонецЕсли;

		Если НоваяПозиция > Позиция Тогда
			УстановитьПозицию(Путь, НоваяПозиция);
		КонецЕсли;

		Если НоваяПозиция <= Прочитанное.Начало Тогда
			// Событие не поместилось в порцию: читаем порцию побольше
			Если Прочитанное.БуферЗаполнен И Максимум < МаксимумПорции() Тогда
				Максимум = Максимум * 2;
				Продолжить;
			КонецЕсли;
			Прервать;
		КонецЕсли;

		Позиция = НоваяПозиция;
		Максимум = МаксимумБайт;

		Если НЕ Прочитанное.БуферЗаполнен Тогда
			Прервать;
		КонецЕсли;

	КонецЦикла;

	Возврат Количество;

КонецФункции

Функция РазобратьТекст(Текст, ДатаЧаса, ТекстЗавершен)
	Если ПарсерТехЖурналаJSON.ЭтоФорматJSON(Текст) Тогда
		Возврат ПарсерТехЖурналаJSON.Разобрать(Текст, ТекстЗавершен);
	КонецЕсли;
	Возврат ПарсерТехЖурнала.Разобрать(Текст, ДатаЧаса, ТекстЗавершен);
КонецФункции

Функция НачальнаяПозиция(Путь)

	Позиция = Позиции[Путь];
	Если Позиция <> Неопределено Тогда
		Возврат Позиция;
	КонецЕсли;

	Позиция = Хранилище.Позиция(Путь);
	Если Позиция = Неопределено Тогда
		Позиция = 0;
		// При первом запуске уже накопленные данные можно пропустить
		Если НЕ Инициализирован И НачинатьСКонца Тогда
			Позиция = Новый Файл(Путь).Размер();
			УстановитьПозицию(Путь, Позиция);
		КонецЕсли;
	КонецЕсли;

	Позиции.Вставить(Путь, Позиция);
	Возврат Позиция;

КонецФункции

Процедура УстановитьПозицию(Путь, Позиция)
	Позиции.Вставить(Путь, Позиция);
	ИзмененныеПозиции.Вставить(Путь, Истина);
КонецПроцедуры

Функция КлючИнициализации()
	Возврат "init:" + КаталогЖурнала;
КонецФункции

Функция ПрефиксКлючей()
	Возврат ОбъединитьПути(КаталогЖурнала, "");
КонецФункции

Функция МаксимумПорции()
	Возврат 256 * 1024 * 1024;
КонецФункции

Функция ЗначениеПараметра(Параметры, Имя, ЗначениеПоУмолчанию)
	Если Параметры = Неопределено ИЛИ НЕ Параметры.Свойство(Имя) Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	Возврат Параметры[Имя];
КонецФункции

#КонецОбласти

// Параметры:
//   Каталог - Строка - каталог технологического журнала (location в logcfg.xml)
//   ХранилищеПозиций - Произвольный - хранилище позиций чтения, см. ХранилищеПозицийВПамяти
//   Параметры - Структура, Неопределено - параметры чтения:
//     * МаксимумБайт - Число - объем данных, читаемый из файла за одну порцию (по умолчанию 4 МБ)
//     * НачинатьСКонца - Булево - при первом запуске пропустить уже записанные данные
//
Процедура ПриСозданииОбъекта(Каталог, ХранилищеПозиций, Параметры = Неопределено)

	КаталогЖурнала = Новый Файл(Каталог).ПолноеИмя;
	Хранилище = ХранилищеПозиций;
	МаксимумБайт = ЗначениеПараметра(Параметры, "МаксимумБайт", 4 * 1024 * 1024);
	НачинатьСКонца = ЗначениеПараметра(Параметры, "НачинатьСКонца", Ложь);

	Позиции = Новый Соответствие;
	ИзмененныеПозиции = Новый Соответствие;
	Инициализирован = Ложь;
	ИнициализацияИзменена = Ложь;

	РегулярноеИмяФайла = Новый РегулярноеВыражение("^(?:(.+)_(\d+)_)?(\d{8})\.log$");
	РегулярноеИмяКаталога = Новый РегулярноеВыражение("^(.+)_(\d+)$");

КонецПроцедуры
