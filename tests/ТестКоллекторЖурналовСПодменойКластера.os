// BSLLS:MagicNumber-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
// BSLLS:DuplicateStringLiteral-off
// BSLLS:NestedFunctionInParameters-off
// BSLLS:Typo-off
// Тесты КоллекторЖурналов с подменным опросчиком и экспортерами кластера. Подмену дают верховные желуди
// из tests-isolated/ПодменаКластера: в общем процессе они перехватили бы желуди соседних наборов, поэтому
// весь набор выполняется в одном отдельном процессе. Каталог вне tests/, иначе рекурсивный прогон oneunit
// подключит их как наборы во все тесты.
#Использовать autumn
#Использовать asserts
#Использовать logos
#Использовать opentelemetry
#Использовать "../src/Коллектор"
#Использовать "./ПоддержкаКоллектора"

Перем Стенд; // СтендКоллектора

&ТестовыйНабор
&Изолированный(Уровень = "Процесс", Импорты = "../tests-isolated/ПодменаКластера")
Процедура ПриСозданииОбъекта() Экспорт
	Стенд = Новый СтендКоллектора;
КонецПроцедуры

&ПередКаждым
Процедура Подготовить() Экспорт
	Стенд.Подготовить();
КонецПроцедуры

&ПослеКаждого
Процедура УдалитьВременныеФайлы() Экспорт
	Стенд.Удалить();
КонецПроцедуры

&Тест
Процедура ОпросПроходитПоВсемКластерамМассива() Экспорт

	// Дано
	Фейки = НовыеФейкиКластера();
	Кластеры = Массивы.ИзЭлементов(Стенд.СекцияКластера("ras.local:1", "a"), Стенд.СекцияКластера("ras.local:2", "b"));
	Коллектор = Стенд.НоваяПоделка(Кластеры).НайтиЖелудь("КоллекторЖурналов");

	// Когда
	Коллектор.ОпроситьКластер();

	// Тогда
	Ожидаем.Что(Фейки.Экспортер.Вызовы("Обновить")).ИмеетДлину(2);
	Ожидаем.Что(Стенд.СообщенияЛогаС("Кластер ras.local:1 доступен")).ИмеетДлину(1);
	Ожидаем.Что(Стенд.СообщенияЛогаС("Кластер ras.local:2 доступен")).ИмеетДлину(1);
	Коллектор.Завершить();

КонецПроцедуры

&Тест
Процедура ОдноИмяСервисаУДвухКластеровНеДаетЗапуститься() Экспорт
	Кластеры = Массивы.ИзЭлементов(Стенд.СекцияКластера("ras.local:1", "1c-cluster"),
		Стенд.СекцияКластера("ras.local:2", "1c-cluster"));
	НастройкаКластераНеДаетЗапуститься(Кластеры, "service-name", "1c-cluster");
КонецПроцедуры

&Тест
Процедура УдачныйОпросКластераПередаетСнимокЭкспортеру() Экспорт

	// Дано
	Фейки = НовыеФейкиКластера();
	Снимок = Фейки.Опросчик.ОтдаватьСнимок(Истина);
	Коллектор = Стенд.НоваяПоделка(Стенд.СекцияКластера("ras.local:1")).НайтиЖелудь("КоллекторЖурналов");

	// Когда
	Коллектор.ОпроситьКластер();

	// Тогда
	Обновления = Фейки.Экспортер.Вызовы("Обновить");
	Ожидаем.Что(Обновления).ИмеетДлину(1);
	Ожидаем.Что(Обновления[0] = Снимок, "экспортер получил снимок опросчика").ЭтоИстина();
	Ожидаем.Что(Фейки.Экспортер.Вызовы("Сбросить")).ИмеетДлину(0);
	Коллектор.Завершить();

КонецПроцедуры

&Тест
Процедура ИсключениеОпросаКластераСбрасываетЭкспортер() Экспорт

	// Дано
	Фейки = НовыеФейкиКластера();
	Фейки.Опросчик.БросатьИсключение("RAS не отвечает");
	Коллектор = Стенд.НоваяПоделка(Стенд.СекцияКластера("ras.local:1")).НайтиЖелудь("КоллекторЖурналов");

	// Когда
	// Без своей Попытки вызывающий метод молча завершается после Возврат из Исключение в ОпроситьКластер,
	// и проверки ниже не выполняются
	Попытка
		Коллектор.ОпроситьКластер();
	Исключение
		ВызватьИсключение;
	КонецПопытки;

	// Тогда
	Ошибки = Стенд.СообщенияЛогаС("Ошибка опроса кластера ras.local:1: ");
	Ожидаем.Что(Ошибки).ИмеетДлину(1);
	Ожидаем.Что(Ошибки[0].Уровень).Равно(УровниЛога.Ошибка);
	Ожидаем.Что(Ошибки[0].Текст).Содержит("RAS не отвечает");
	Ожидаем.Что(Фейки.Экспортер.Вызовы("Сбросить")).ИмеетДлину(1);
	Ожидаем.Что(Фейки.Экспортер.Вызовы("Обновить")).ИмеетДлину(0);
	Коллектор.Завершить();

КонецПроцедуры

&Тест
Процедура ВосстановлениеКластераПишетсяВЛог() Экспорт

	// Дано
	Фейки = НовыеФейкиКластера();
	Секция = Стенд.СекцияКластера("ras.local:1");
	Секция.Вставить("interval", 0);
	Коллектор = Стенд.НоваяПоделка(Секция).НайтиЖелудь("КоллекторЖурналов");
	Фейки.Опросчик.ОтдаватьСнимок(Ложь, "нет связи");
	Коллектор.ОпроситьКластер();

	// Когда
	Фейки.Опросчик.ОтдаватьСнимок(Истина);
	Коллектор.ОпроситьКластер();

	// Тогда
	Ожидаем.Что(Стенд.СообщенияЛогаС("Кластер ras.local:1 недоступен: нет связи")).ИмеетДлину(1);
	Восстановления = Стенд.СообщенияЛогаС("Кластер ras.local:1 доступен");
	Ожидаем.Что(Восстановления).ИмеетДлину(1);
	Ожидаем.Что(Восстановления[0].Уровень).Равно(УровниЛога.Информация);
	Ожидаем.Что(Фейки.Экспортер.Вызовы("Обновить")).ИмеетДлину(2);
	Коллектор.Завершить();

КонецПроцедуры

&Тест
Процедура ПорогиДолгихВызововПоУмолчанию60И3600Секунд() Экспорт

	// Дано
	Фейки = НовыеФейкиКластера();

	// Когда
	Коллектор = Стенд.НоваяПоделка(Стенд.СекцияКластера("ras.local:1")).НайтиЖелудь("КоллекторЖурналов");

	// Тогда
	Пороги = Фейки.Опросчик.Пороги();
	Ожидаем.Что(Пороги).ИмеетТип("Массив").ИмеетДлину(2);
	Ожидаем.Что(Пороги[0]).ИмеетТип("Число").Равно(60);
	Ожидаем.Что(Пороги[1]).ИмеетТип("Число").Равно(3600);
	Коллектор.Завершить();

КонецПроцедуры

&Тест
Процедура ОпросчикКластераПолучаетЧасовойПоясСерверов() Экспорт

	// Дано
	Фейки = НовыеФейкиКластера();

	// Когда
	Коллектор = Стенд.НоваяПоделка(Стенд.СекцияКластера("ras.local"), , Истина, "Europe/Moscow")
		.НайтиЖелудь("КоллекторЖурналов");

	// Тогда
	Ожидаем.Что(Фейки.Опросчик.ЧасовойПояс()).Равно("Europe/Moscow");
	Коллектор.Завершить();

КонецПроцедуры

&Тест
Процедура ЧасовойПоясКластераЗадаетсяВНастройкахКластера() Экспорт

	// Дано
	Фейки = НовыеФейкиКластера();
	Секция = Стенд.СекцияКластера("ras.local");
	Секция.Вставить("timezone", "Asia/Yekaterinburg");

	// Когда
	Коллектор = Стенд.НоваяПоделка(Секция, , Истина, "Europe/Moscow").НайтиЖелудь("КоллекторЖурналов");

	// Тогда
	Ожидаем.Что(Фейки.Опросчик.ЧасовойПояс()).Равно("Asia/Yekaterinburg");
	Коллектор.Завершить();

КонецПроцедуры

&Тест
Процедура НеизвестныйЧасовойПоясКластераНеДаетЗапуститься() Экспорт
	Секция = Стенд.СекцияКластера("ras.local");
	Секция.Вставить("timezone", "Nowhere/Bad");
	НастройкаКластераНеДаетЗапуститься(Секция, "timezone", "Nowhere/Bad");
КонецПроцедуры

&Тест
Процедура ПорогиДолгихВызововЧитаютсяСПробеламиПослеЗапятой() Экспорт

	// Дано
	Фейки = НовыеФейкиКластера();
	Секция = Стенд.СекцияКластера("ras.local:1");
	Секция.Вставить("long-call-thresholds", "30, 300");

	// Когда
	Коллектор = Стенд.НоваяПоделка(Секция).НайтиЖелудь("КоллекторЖурналов");

	// Тогда
