КонецПроцедуры

&Тест
Процедура НечисловойПорогДолгихВызововНеДаетЗапуститься() Экспорт
	ПорогДолгихВызововНеДаетЗапуститься("60,1h", "1h");
КонецПроцедуры

&Тест
Процедура НулевойПорогДолгихВызововНеДаетЗапуститься() Экспорт
	ПорогДолгихВызововНеДаетЗапуститься("0,60", "0");
КонецПроцедуры

Процедура ПорогДолгихВызововНеДаетЗапуститься(Пороги, НеверныйПорог)
	Секция = Стенд.СекцияКластера("ras.local:1");
	Секция.Вставить("long-call-thresholds", Пороги);
	НастройкаКластераНеДаетЗапуститься(Секция, "long-call-thresholds", НеверныйПорог);
КонецПроцедуры

&Тест
Процедура НечисловойПортКластераНеДаетЗапуститься() Экспорт
	НастройкаКластераНеДаетЗапуститься(Стенд.СекцияКластера("ras.local:ras"), "ras", "ras.local:ras");
КонецПроцедуры

&Тест
Процедура ПустойПортКластераНеДаетЗапуститься() Экспорт
	НастройкаКластераНеДаетЗапуститься(Стенд.СекцияКластера("ras.local:"), "ras", "ras.local:");
КонецПроцедуры

&Тест
Процедура ПустойХостКластераНеДаетЗапуститься() Экспорт
	НастройкаКластераНеДаетЗапуститься(Стенд.СекцияКластера(":1545"), "ras", ":1545");
КонецПроцедуры

Процедура НастройкаКластераНеДаетЗапуститься(Секция, ИмяНастройки, НеверноеЗначение)

	// Дано
	НовыеФейкиКластера();

	// Когда
	Стенд.ПерехватыватьЛогОсени(Истина);
	Коллектор = Стенд.НоваяПоделка(Секция).НайтиЖелудь("КоллекторЖурналов");
	Стенд.ПерехватыватьЛогОсени(Ложь);

	// Тогда
	Ожидаем.Что(Коллектор).Равно(Неопределено);
	Ошибки = Стенд.СообщенияЛогаС("otel.v8-logs.cluster." + ИмяНастройки);
	Ожидаем.Что(Ошибки).ИмеетДлину(1);
	Ожидаем.Что(Ошибки[0].Текст).Содержит("«" + НеверноеЗначение + "»");

КонецПроцедуры

&Тест
Процедура УчетныеДанныеБазИзНастроекПередаютсяОпросчику() Экспорт

	// Дано
	Фейки = НовыеФейкиКластера();
	Секция = Стенд.СекцияКластера("ras.local:1");
	Базы = Новый Массив;
	Базы.Добавить(НастройкаБазы("producer", "Админ", "секрет"));
	Базы.Добавить(НастройкаБазы("erp", "Администратор", ""));
	Секция.Вставить("infobases", Базы);

	// Когда
	Коллектор = Стенд.НоваяПоделка(Секция).НайтиЖелудь("КоллекторЖурналов");

	// Тогда
	УчетныеДанные = Фейки.Опросчик.УчетныеДанныеБаз();
	Ожидаем.Что(УчетныеДанные).ИмеетТип("Соответствие");
	Ожидаем.Что(УчетныеДанные.Количество()).Равно(2);
	Ожидаем.Что(УчетныеДанные["producer"]).ИмеетТип("Структура");
	Ожидаем.Что(УчетныеДанные["producer"].Пользователь).Равно("Админ");
	Ожидаем.Что(УчетныеДанные["producer"].Пароль).Равно("секрет");
	Ожидаем.Что(УчетныеДанные["erp"].Пользователь).Равно("Администратор");
	Ожидаем.Что(УчетныеДанные["erp"].Пароль).Равно("");
	Коллектор.Завершить();

КонецПроцедуры

&Тест
Процедура БезБазВНастройкахУчетныеДанныеБазПусты() Экспорт

	// Дано
	Фейки = НовыеФейкиКластера();

	// Когда
	Коллектор = Стенд.НоваяПоделка(Стенд.СекцияКластера("ras.local:1")).НайтиЖелудь("КоллекторЖурналов");

	// Тогда
	УчетныеДанные = Фейки.Опросчик.УчетныеДанныеБаз();
	Ожидаем.Что(УчетныеДанные).ИмеетТип("Соответствие");
	Ожидаем.Что(УчетныеДанные.Количество()).Равно(0);
	Коллектор.Завершить();

КонецПроцедуры

&Тест
Процедура СнимокОпросаЗаписываетсяЖурналомСеансов() Экспорт

	// Дано
	Фейки = НовыеФейкиКластера();
	Снимок = Фейки.Опросчик.ОтдаватьСнимок(Истина);
	Коллектор = Стенд.НоваяПоделка(Стенд.СекцияКластера("ras.local:1")).НайтиЖелудь("КоллекторЖурналов");

	// Когда
	Коллектор.ОпроситьКластер();

	// Тогда
	Записанные = Фейки.ЭкспортерСеансов.ЗаписанныеСнимки();
	Ожидаем.Что(Записанные).ИмеетДлину(1);
	Ожидаем.Что(Записанные[0] = Снимок, "экспортер сеансов получил снимок опросчика").ЭтоИстина();
	Ожидаем.Что(Фейки.Экспортер.Вызовы("Обновить")).ИмеетДлину(1);
	Коллектор.Завершить();

КонецПроцедуры

&Тест
Процедура БезЖурналаСеансовСнимокНеЗаписывается() Экспорт

	// Дано
	Фейки = НовыеФейкиКластера();
	Секция = Стенд.СекцияКластера("ras.local:1");
	Секция.Вставить("session-log", Ложь);
	Коллектор = Стенд.НоваяПоделка(Секция).НайтиЖелудь("КоллекторЖурналов");

	// Когда
	Коллектор.ОпроситьКластер();

	// Тогда
	Ожидаем.Что(Фейки.ЭкспортерСеансов.ЗаписанныеСнимки()).ИмеетДлину(0);
	Ожидаем.Что(Фейки.Экспортер.Вызовы("Обновить")).ИмеетДлину(1);
	Коллектор.Завершить();

КонецПроцедуры

&Тест
Процедура ПредупрежденияОпросаПишутсяВЛогПриИзменении() Экспорт

	// Дано
	Фейки = НовыеФейкиКластера();
	Секция = Стенд.СекцияКластера("ras.local:1");
	Секция.Вставить("interval", 0);
	Коллектор = Стенд.НоваяПоделка(Секция).НайтиЖелудь("КоллекторЖурналов");
	Фейки.Опросчик.ОтдаватьПредупреждения(Массивы.ИзЭлементов("база producer: нет прав", "база erp: нет прав"));
	Коллектор.ОпроситьКластер();

	// Когда
	Фейки.Опросчик.ОтдаватьПредупреждения(Массивы.ИзЭлементов("база producer: нет прав", "база erp: нет прав"));
	Коллектор.ОпроситьКластер();
	Фейки.Опросчик.ОтдаватьПредупреждения(Массивы.ИзЭлементов("база producer: нет прав"));
	Коллектор.ОпроситьКластер();

	// Тогда
	Первые = Стенд.СообщенияЛогаС("база producer: нет прав");
	Ожидаем.Что(Первые).ИмеетДлину(2);
	Ожидаем.Что(Первые[0].Уровень).Равно(УровниЛога.Предупреждение);
	Ожидаем.Что(Первые[0].Текст).Содержит("ras.local:1");
	Ожидаем.Что(Стенд.СообщенияЛогаС("база erp: нет прав")).ИмеетДлину(1);
	Коллектор.Завершить();

КонецПроцедуры

&Тест
Процедура ФоновыйЗапускЧитаетОбаЖурналаИОпрашиваетКластер() Экспорт

	// Дано
	Фейки = НовыеФейкиКластера();
	Стенд.ДописатьЖурналы();
	ОтелГлобальный.Сбросить();
	Поделка = Стенд.НоваяПоделка(Стенд.СекцияКластера("ras.local:1"));
	Коллектор = Поделка.НайтиЖелудь("КоллекторЖурналов");
	Хранилище = Поделка.НайтиЖелудь("ХранилищеПозицийЧтения");
	ПутьТехнологическогоЖурнала = Стенд.ПолныйПуть(Стенд.КаталогТехнологическогоЖурнала(), "rphost_1", "26102009.log");
	ПутьЖурналаРегистрации = Стенд.ПолныйПуть(Стенд.КаталогЖурналаРегистрации(), "20251020000000.lgp");

	// Когда
	Задание = Стенд.ЗапуститьВФоне(Коллектор);
	Граница = ТекущаяУниверсальнаяДатаВМиллисекундах() + 10000;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Граница Цикл
		Если Хранилище.Позиция(ПутьТехнологическогоЖурнала) <> Неопределено
			И Хранилище.Позиция(ПутьЖурналаРегистрации) <> Неопределено
			И Фейки.Экспортер.Вызовы("Обновить").Количество() > 0 Тогда
			Прервать;
		КонецЕсли;
		Приостановить(50);
	КонецЦикла;
	Коллектор.Остановить();

	// Тогда
	Стенд.ОжидатьЗавершенияБезОшибок(Задание);
	Ожидаем.Что(Хранилище.Позиция(ПутьТехнологическогоЖурнала)).Больше(0);
	Ожидаем.Что(Хранилище.Позиция(ПутьЖурналаРегистрации)).Больше(0);
	Ожидаем.Что(Фейки.Экспортер.Вызовы("Обновить").Количество()).Больше(0);
	Для Каждого Название Из Массивы.ИзЭлементов("технологический журнал", "журнал регистрации", "кластер") Цикл
		Ожидаем.Что(Стенд.СообщенияЛогаС(Стенд.СообщениеЗадания(Название, "запущено"))).ИмеетДлину(1);
		Ожидаем.Что(Стенд.СообщенияЛогаС(Стенд.СообщениеЗадания(Название, "остановлено"))).ИмеетДлину(1);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура БезЖурналовЗапускаетсяТолькоЗаданиеКластера() Экспорт

	// Дано
	Фейки = НовыеФейкиКластера();
	Секция = Стенд.СекцияКластера("ras.local:1");
	Секция.Вставить("interval", 1);
	Коллектор = Стенд.НоваяПоделка(Секция, "", Ложь).НайтиЖелудь("КоллекторЖурналов");

	// Когда
	Задание = Стенд.ЗапуститьВФоне(Коллектор);
	Граница = ТекущаяУниверсальнаяДатаВМиллисекундах() + 10000;
	Пока Фейки.Экспортер.Вызовы("Обновить").Количество() < 2
		И ТекущаяУниверсальнаяДатаВМиллисекундах() < Граница Цикл
		Приостановить(50);
	КонецЦикла;
	Коллектор.Остановить();

	// Тогда - опрос идет по своему периоду, независимо от проходов чтения
	Стенд.ОжидатьЗавершенияБезОшибок(Задание);
	Ожидаем.Что(Фейки.Экспортер.Вызовы("Обновить").Количество()).БольшеИлиРавно(2);
	Ожидаем.Что(Стенд.СообщенияЛогаС(Стенд.СообщениеЗадания("кластер", "запущено"))).ИмеетДлину(1);
	Ожидаем.Что(Стенд.СообщенияЛогаС(Стенд.СообщениеЗадания("", "запущено"))).ИмеетДлину(1);

КонецПроцедуры

Функция НастройкаБазы(Имя, Пользователь, Пароль)
	База = Новый Соответствие;
	База.Вставить("name", Имя);
	База.Вставить("user", Пользователь);
	База.Вставить("password", Пароль);
	Возврат База;
КонецФункции

// Фейкам передают вызовы верховные желуди из tests-isolated/ПодменаКластера
Функция НовыеФейкиКластера()
	Фейки = Новый Структура("Опросчик, Экспортер, ЭкспортерСеансов", Новый ФейковыйОпросчикКластера,
		Новый ФейковыйЭкспортерМетрикКластера, Новый ФейковыйЭкспортерСеансовКластера);
	ФейкиКластера.Подставить(Фейки.Опросчик, Фейки.Экспортер, Фейки.ЭкспортерСеансов);
	Возврат Фейки;
КонецФункции
