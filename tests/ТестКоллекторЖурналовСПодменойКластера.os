	Ожидаем.Что(Пороги).ИмеетДлину(2);
	Ожидаем.Что(Пороги[0]).ИмеетТип("Число").Равно(30);
	Ожидаем.Что(Пороги[1]).ИмеетТип("Число").Равно(300);
	Коллектор.Завершить();

КонецПроцедуры

&Тест
Процедура ПовторныйПорогДолгихВызововСчитаетсяОдинРаз() Экспорт

