// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
// BSLLS:DuplicateStringLiteral-off
// BSLLS:MagicNumber-off
#Использовать "../src/ЖурналРегистрации"
#Использовать asserts

&Пластилин
Перем РазборДанныхЖурналаРегистрации;
&Пластилин
Перем ПарсерСкобочногоФормата;
&Пластилин
Перем ПарсерЖурналаРегистрации;
&Пластилин
Перем ПоляДанныхСобытийЖурналаРегистрации;

&Тест
Процедура ОбщиеПримерыСовпадаютСПодтвержденнымРазбором() Экспорт

	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures", "eventlog-data.json"));
	Примеры = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Для Каждого Пример Из Примеры["cases"] Цикл
		Узел = ПарсерСкобочногоФормата.Разобрать(Пример["data"]).Записи[0];
		Результат = РазборДанныхЖурналаРегистрации.Разобрать(Пример["eventCode"], Узел);
		Ожидаем.Что(Результат <> Неопределено).ЭтоИстина();
		СравнитьJSON(Пример["expected"], Результат, Пример["id"]);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура СкалярныеЗначенияНеДублируютсяВJSON() Экспорт
	Для Каждого Данные Из СтрРазделить("{U}|{S,текст}|{N,123.45}|{B,0}|{B,1}|{D,20260102030405}|{R,47:123}", "|") Цикл
		Узел = ПарсерСкобочногоФормата.Разобрать(Данные).Записи[0];
		Ожидаем.Что(РазборДанныхЖурналаРегистрации.Разобрать("Test", Узел)).Равно(Неопределено);
	КонецЦикла;
КонецПроцедуры

&Тест
Процедура ПарсерСохраняетСтароеПредставлениеИДобавляетJSON() Экспорт
	Словарь = Новый СловарьЖурналаРегистрации;
	Словарь.Добавить(ПарсерСкобочногоФормата.Разобрать("{4,""_$Session$_.Authentication"",1}").Записи);
	Текст = "{20250517150813,N,{0,0},0,0,0,0,1,I,"""",0,"
		+ "{""P"",{518,{""S"",""""},{""S"",""DESKTOP\ДНС""},{""N"",1}}},"""",0,0,0,0,0,{0}}";
	Запись = ПарсерЖурналаРегистрации.ЗаписьЖурнала(ПарсерСкобочногоФормата.Разобрать(Текст).Записи[0], Словарь);
	Ожидаем.Что(Запись.Данные).Равно("DESKTOP\ДНС; 1");
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Запись.ДанныеJSON);
	Данные = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Ожидаем.Что(Данные["Name"]).Равно("");
	Ожидаем.Что(Данные["CurrentOSUser"]).Равно("DESKTOP\ДНС");
	Ожидаем.Что(Данные["AuthenticationMethod"]).Равно("1");
КонецПроцедуры

&Тест
Процедура ИменованныеНеизвестныеТипыСохраняютсяВИсходномДереве() Экспорт
	Для Каждого Данные Из СтрРазделить("{P,{1,{Name,{O,{#,11111111-2222-3333-4444-555555555555,00000000-0000-0000-0000-000000000000}}}}}|{P,{1,{Name,{A,{0}}}}}|{P,{1,{Name,{B,2}}}}|{P,{1,{Name,{D,20260230000000}}}}|{P,{2,{Name,{S,a}},{Name,{S,b}}}}|{P,{999999999999999999999999999999999999999,{Name,{S,a}}}}", "|") Цикл
		Узел = ПарсерСкобочногоФормата.Разобрать(Данные).Записи[0];
		Результат = РазборДанныхЖурналаРегистрации.Разобрать("Future.Event", Узел);
		Ожидаем.Что(Результат["$format"]).Равно("1c-brackets-v1");
		СравнитьJSON(Узел, Результат["nodes"], Данные);
	КонецЦикла;
КонецПроцедуры

&Тест
Процедура ПоврежденноеПолеПозиционнойФормыНеПолучаетИмя() Экспорт
	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures", "eventlog-data.json"));
	Примеры = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Для Каждого Пример Из Примеры["cases"] Цикл
		Если Пример["id"] <> "positional-data-8.3.27/0" Тогда
			Продолжить;
		КонецЕсли;
		Для Индекс = 1 По 28 Цикл
			Узел = ПарсерСкобочногоФормата.Разобрать(Пример["data"]).Записи[0];
			Узел[1][Индекс] = СтрРазделить("X,future", ",");
			Результат = РазборДанныхЖурналаРегистрации.Разобрать(Пример["eventCode"], Узел);
			Ожидаем.Что(Результат["$format"], "Поле " + Индекс).Равно("1c-brackets-v1");
			СравнитьJSON(Узел, Результат["nodes"], "Поле " + Индекс);
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

&Тест
Процедура СписокРолейНеПопадаетВJSONДажеПриБольшомКоличествеРолей() Экспорт
	Пример = ПозиционныйПример();
	Узел = ПарсерСкобочногоФормата.Разобрать(Пример["data"]).Записи[0];
	Роли = Новый Массив;
	Роли.Добавить("1000");
	Для Индекс = 1 По 1000 Цикл
		Роли.Добавить(ПарсерСкобочногоФормата.Разобрать(
			"{O,{#,fc01b5df-97fe-449b-83d4-218a090e681e,abcdefab-1234-5678-9abc-def012345678}}").Записи[0]);
	КонецЦикла;
	МассивРолей = Новый Массив;
	МассивРолей.Добавить("A");
	МассивРолей.Добавить(Роли);
	Узел[1][12] = МассивРолей;
	Результат = РазборДанныхЖурналаРегистрации.Разобрать(Пример["eventCode"], Узел);
	Ожидаем.Что(Результат["Roles"]).Равно(Неопределено);
	Ожидаем.Что(Результат["RolesCount"]).Равно("1000");
	Ожидаем.Что(Результат["$format"]).Равно(Неопределено);
	Ожидаем.Что(Результат["values"]).Равно(Неопределено);
	Ожидаем.Что(Результат["nodes"]).Равно(Неопределено);
	Текст = РазборДанныхЖурналаРегистрации.СтрокаJSON(Пример["eventCode"], Узел);
	Ожидаем.Что(СтрНайти(Текст, "abcdefab-1234-5678-9abc-def012345678")).Равно(0);
	Ожидаем.Что(СтрДлина(Текст) < 5000).ЭтоИстина();
КонецПроцедуры

&Тест
Процедура ОшибкиПараметровБазыИспользуютТеЖеПодтвержденныеФормы() Экспорт
	Узел = ПарсерСкобочногоФормата.Разобрать("{P,{448,{N,3},{N,300},{S,abc}}}").Записи[0];
	Ожидаемое = РазборДанныхЖурналаРегистрации.Разобрать("_$InfoBase$_.ParametersUpdate", Узел);
	Фактическое = РазборДанныхЖурналаРегистрации.Разобрать("_$InfoBase$_.ParametersUpdateError", Узел);
	СравнитьJSON(Ожидаемое, Фактическое, "ParametersUpdateError");
КонецПроцедуры

&Тест
Процедура ЧислаНулиПустыеСтрокиИНезаданныеЗначенияНеТеряются() Экспорт
	Узел = ПарсерСкобочногоФормата.Разобрать("{P,{4,{Number,{N,12345678901234567890123456789012345678}},{Zero,{N,0}},{Empty,{S,""""}},{Undefined,{U}}}}").Записи[0];
	Результат = РазборДанныхЖурналаРегистрации.Разобрать("Future.Event", Узел);
	Ожидаем.Что(Результат["$format"]).Равно("1c-named-data-v1");
	Ожидаем.Что(Результат["values"]["Number"]).Равно("12345678901234567890123456789012345678");
	Ожидаем.Что(Результат["values"]["Zero"]).Равно("0");
	Ожидаем.Что(Результат["values"]["Empty"]).Равно("");
	Ожидаем.Что(Результат["values"]["Undefined"]["$type"]).Равно("U");
КонецПроцедуры

&Тест
Процедура РаскладкиПользователяИспользуютОбщийПорядокБезИзмененияСпискаАпстрима() Экспорт
	Формы = ПоляДанныхСобытийЖурналаРегистрации.Раскладки("_$User$_.Update");
	БезИнтерфейса = Формы[0];
	СИнтерфейсом = Формы[1];
	ПоляАпстрима = ПоляДанныхСобытийЖурналаРегистрации.ИменаПолей("_$User$_.Update");
	Ожидаем.Что(БезИнтерфейса.Маска).Равно("65534");
	Ожидаем.Что(БезИнтерфейса.Имена).Равно(ПоляАпстрима);
	Ожидаем.Что(СИнтерфейсом.Маска).Равно("65535");
	Ожидаем.Что(СИнтерфейсом.Имена.Количество()).Равно(28);
	Ожидаем.Что(СИнтерфейсом.Имена[12]).Равно("DefaultInterface");
	Для Индекс = 0 По ПоляАпстрима.ВГраница() Цикл
		Ожидаем.Что(СИнтерфейсом.Имена[Индекс + ?(Индекс < 12, 0, 1)]).Равно(ПоляАпстрима[Индекс]);
	КонецЦикла;
	Ожидаем.Что(ПоляАпстрима.Количество()).Равно(27);
КонецПроцедуры

&Тест
Процедура КартаБитовИСправочныеИменаНеМеняютКлючиJSON() Экспорт
	Ожидаем.Что(ПоляДанныхСобытийЖурналаРегистрации.ИмяПоБиту("_$Session$_.Authentication", 9))
		.Равно("AuthenticationMode");
	Узел = ПарсерСкобочногоФормата.Разобрать("{P,{514,{S,FixtureUser},{N,1}}}").Записи[0];
	Данные = РазборДанныхЖурналаРегистрации.Разобрать("_$Session$_.Authentication", Узел);
	Ожидаем.Что(Данные["AuthenticationMethod"]).Равно("1");
	Ожидаем.Что(Данные["AuthenticationMode"]).Равно(Неопределено);
	Узел = ПарсерСкобочногоФормата.Разобрать("{P,{{S,FixtureVendor},{S,1.0}}}").Записи[0];
	Данные = РазборДанныхЖурналаРегистрации.Разобрать("_$InfoBase$_.ConfigUpdate", Узел);
	Ожидаем.Что(Данные["Vendor"]).Равно("FixtureVendor");
	Ожидаем.Что(Данные["HashSum"]).Равно(Неопределено);
КонецПроцедуры

&Тест
Процедура ЧерновикиИНовыеКомбинацииИзвестныхБитовНеРазбираютсяПоПозициям() Экспорт
	Ожидаем.Что(ПоляДанныхСобытийЖурналаРегистрации.ИменаПолей("_$InfoBase$_.RoleUpdate") <> Неопределено).ЭтоИстина();
	Ожидаем.Что(ПоляДанныхСобытийЖурналаРегистрации.Раскладки("_$InfoBase$_.RoleUpdate")).Равно(Неопределено);
	ПроверитьИсходноеДерево("_$InfoBase$_.RoleUpdate", "{P,{{S,FixtureRole}}}");
	// Все биты 519 известны, но сочетание трех строк с методом не подтверждено.
	ПроверитьИсходноеДерево("_$Session$_.Authentication", "{P,{519,{S,OSUser},{S,Name},{S,CurrentOSUser},{N,1}}}");
	ПроверитьИсходноеДерево("_$InfoBase$_.ParametersUpdate", "{P,{449,{N,1},{N,3},{N,300},{S,abc}}}");
КонецПроцедуры

&Тест
Процедура ОбщиеРаскладкиСохраняютПроверкиМаскиАрностиИТипов() Экспорт
	ПроверитьИсходноеДерево("_$User$_.Update", "{P,{65534,{S,FixtureUser}}}");
	ПроверитьИсходноеДерево("_$Session$_.Authentication", "{P,{514,{S,FixtureUser},{N,1},{S,extra}}}");
	ПроверитьИсходноеДерево("_$Session$_.Authentication", "{P,{514,{N,1},{N,1}}}");
	ПроверитьИсходноеДерево("_$InfoBase$_.AdditionalAuthenticationSettingsUpdate", "{P,{2147483648,{S,25}}}");
	ПроверитьИсходноеДерево("_$InfoBase$_.ParametersUpdate", "{P,{4,{N,2}}}");
	ПроверитьИсходноеДерево("_$InfoBase$_.ParametersUpdate", "{P,{32768,{N,3}}}");
КонецПроцедуры

Процедура ПроверитьИсходноеДерево(Событие, Текст)
	Узел = ПарсерСкобочногоФормата.Разобрать(Текст).Записи[0];
	Данные = РазборДанныхЖурналаРегистрации.Разобрать(Событие, Узел);
	Ожидаем.Что(Данные["$format"], Текст).Равно("1c-brackets-v1");
	СравнитьJSON(Узел, Данные["nodes"], Текст);
КонецПроцедуры

Функция ПозиционныйПример()
	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures", "eventlog-data.json"));
	Примеры = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Для Каждого Пример Из Примеры["cases"] Цикл
		Если Пример["id"] = "positional-data-8.3.27/0" Тогда
			Возврат Пример;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "Нет исходного позиционного примера";
КонецФункции

// Сравнение деревьев: порядок ключей JSON не является частью контракта.
Процедура СравнитьJSON(Ожидаемое, Фактическое, Путь)
	Ожидаем.Что(ТипЗнч(Фактическое), Путь).Равно(ТипЗнч(Ожидаемое));
	Если ТипЗнч(Ожидаемое) = Тип("Соответствие") Тогда
		Ожидаем.Что(Фактическое.Количество(), Путь).Равно(Ожидаемое.Количество());
		Для Каждого Поле Из Ожидаемое Цикл
			СравнитьJSON(Поле.Значение, Фактическое[Поле.Ключ], Путь + "." + Поле.Ключ);
		КонецЦикла;
	ИначеЕсли ТипЗнч(Ожидаемое) = Тип("Массив") Тогда
		Ожидаем.Что(Фактическое.Количество(), Путь).Равно(Ожидаемое.Количество());
		Для Индекс = 0 По Ожидаемое.ВГраница() Цикл
			СравнитьJSON(Ожидаемое[Индекс], Фактическое[Индекс], Путь + "[" + Индекс + "]");
		КонецЦикла;
	Иначе
		Ожидаем.Что(Фактическое, Путь).Равно(Ожидаемое);
	КонецЕсли;
КонецПроцедуры
