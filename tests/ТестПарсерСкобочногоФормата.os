&Пластилин
Перем ПарсерСкобочногоФормата;

Перем ПС;

&Тест
Процедура РазборПростойЗаписи() Экспорт

	// Дано
	Текст = "{2,""COMP"",3}," + ПС;

	// Когда
	Результат = ПарсерСкобочногоФормата.Разобрать(Текст);

	// Тогда
	Ожидаем.Что(Результат.Записи).ИмеетДлину(1);
	Запись = Результат.Записи[0];
	Ожидаем.Что(Запись).ИмеетДлину(3);
	Ожидаем.Что(Запись[0]).Равно("2");
	Ожидаем.Что(Запись[1]).Равно("COMP");
	Ожидаем.Что(Запись[2]).Равно("3");
	Ожидаем.Что(Результат.Остаток).Равно("");

КонецПроцедуры

&Тест
Процедура РазборВложенныхЗаписей() Экспорт

	// Дано
	Текст = "{20241203174411,U," + ПС
		+ "{244e23df9f3b0,4832},1,{""R"",47:976d00d8612c645111efb1744b0ce2e8},{0}" + ПС
		+ "}," + ПС;

	// Когда
	Результат = ПарсерСкобочногоФормата.Разобрать(Текст);

	// Тогда
	Запись = Результат.Записи[0];
	Ожидаем.Что(Запись).ИмеетДлину(6);
	Ожидаем.Что(Запись[2]).ИмеетТип("Массив");
	Ожидаем.Что(Запись[2][0]).Равно("244e23df9f3b0");
	Ожидаем.Что(Запись[2][1]).Равно("4832");
	Ожидаем.Что(Запись[4][0]).Равно("R");
	Ожидаем.Что(Запись[4][1]).Равно("47:976d00d8612c645111efb1744b0ce2e8");
	Ожидаем.Что(Запись[5][0]).Равно("0");

КонецПроцедуры

&Тест
Процедура РазборСтрокиСКавычкамиСкобкамиИПереводами() Экспорт

	// Дано
	Текст = "{1,""Текст с """"кавычками"""", {скобками}," + Символы.ВК + ПС
		+ "и переводом строки"",2}," + ПС;

	// Когда
	Результат = ПарсерСкобочногоФормата.Разобрать(Текст);

	// Тогда
	Запись = Результат.Записи[0];
	Ожидаем.Что(Запись).ИмеетДлину(3);
	Ожидаем.Что(Запись[1]).Равно("Текст с ""кавычками"", {скобками}," + Символы.ВК + ПС + "и переводом строки");
	Ожидаем.Что(Запись[2]).Равно("2");

КонецПроцедуры

&Тест
Процедура ПустаяСтрокаВКавычках() Экспорт

	// Дано
	Текст = "{1,"""",2}" + ПС;

	// Когда
	Результат = ПарсерСкобочногоФормата.Разобрать(Текст);

	// Тогда
	Ожидаем.Что(Результат.Записи[0][1]).Равно("");

КонецПроцедуры

&Тест
Процедура ЗаголовокФайлаПропускается() Экспорт

	// Дано
	Текст = Символ(65279) + "1CV8LOG(ver 2.0)" + ПС
		+ "5c1e2f22-d4ba-4be8-b55f-a3d6a2b9e1d8" + ПС
		+ ПС
		+ "{1,a,""Admin"",1}," + ПС
		+ "{2,""COMP"",1}," + ПС;

	// Когда
	Результат = ПарсерСкобочногоФормата.Разобрать(Текст);

	// Тогда
	Ожидаем.Что(Результат.Записи).ИмеетДлину(2);
	Ожидаем.Что(Результат.Записи[0][2]).Равно("Admin");

КонецПроцедуры

&Тест
Процедура НезавершеннаяЗаписьОстаетсяВОстатке() Экспорт

	// Дано
	Незавершенная = "{20241203174412,N," + ПС + "{0,0},1,2,""коммент";
	Текст = "{1,2}," + ПС + Незавершенная;

	// Когда
	Результат = ПарсерСкобочногоФормата.Разобрать(Текст);

	// Тогда
	Ожидаем.Что(Результат.Записи).ИмеетДлину(1);
	Ожидаем.Что(Результат.Остаток).Равно(Незавершенная);

КонецПроцедуры

&Тест
Процедура НезавершеннаяЗаписьБезКавычекОстаетсяВОстатке() Экспорт

	// Дано
	Незавершенная = "{20241203174412,N," + Символы.ВК + ПС + "{0,0},1,2";
	Текст = "{1,2}," + Символы.ВК + ПС + Незавершенная;

	// Когда
	Результат = ПарсерСкобочногоФормата.Разобрать(Текст);

	// Тогда
	Ожидаем.Что(Результат.Записи).ИмеетДлину(1);
	Ожидаем.Что(Результат.Остаток).Равно(Незавершенная);

КонецПроцедуры

&Тест
Процедура РазделителиМеждуЗначениямиПропускаются() Экспорт

	// Дано - подряд несколько запятых, пробелы и переводы строк, разделители в конце текста
	Текст = "{1,, 2 ," + Символы.Таб + ПС + "{ ""а"" , {}},3} ," + Символы.ВК + ПС + ",{4} ,,";

	// Когда
	Результат = ПарсерСкобочногоФормата.Разобрать(Текст);

	// Тогда
	Ожидаем.Что(Результат.Записи).ИмеетДлину(2);
	Запись = Результат.Записи[0];
	Ожидаем.Что(Запись).ИмеетДлину(4);
	Ожидаем.Что(Запись[0]).Равно("1");
	Ожидаем.Что(Запись[1]).Равно("2");
	Ожидаем.Что(Запись[2]).ИмеетДлину(2);
	Ожидаем.Что(Запись[2][0]).Равно("а");
	Ожидаем.Что(Запись[2][1]).ИмеетДлину(0);
	Ожидаем.Что(Запись[3]).Равно("3");
	Ожидаем.Что(Результат.Записи[1][0]).Равно("4");
	Ожидаем.Что(Результат.Остаток).Равно("");

КонецПроцедуры

&Тест
Процедура РазборПустогоТекста() Экспорт

	// Когда
	Результат = ПарсерСкобочногоФормата.Разобрать("");

	// Тогда
	Ожидаем.Что(Результат.Записи).ИмеетДлину(0);
	Ожидаем.Что(Результат.Остаток).Равно("");

КонецПроцедуры

&Тест
Процедура РазборОкнамиНеЗависитОтГраницОкна() Экспорт

	// Дано
	Незавершенная = "{20241203174413,N," + ПС + "{0,0},1,2,""хвост";
	Текст = Символ(65279) + "1CV8LOG(ver 2.0)" + ПС
		+ "5c1e2f22-d4ba-4be8-b55f-a3d6a2b9e1d8" + ПС + ПС
		+ "{20241203174411,U," + ПС
		+ "{244e23df9f3b0,4832},1,{""R"",47:976d00d8612c645111efb1744b0ce2e8},{0}" + ПС
		+ "}," + ПС
		+ "{1,""Текст с """"кавычками"""", {скобками}, запятой," + Символы.ВК + ПС
		+ "и переводом строки"",2}," + ПС
		+ "{2,"""",{3,{4,{5}}},""}"",""{"",""""""""}," + ПС
		+ "{a b,c}," + ПС
		+ Незавершенная;

	// Когда, Тогда
	Эталон = ПроверитьВсеОкна(Текст);
	Ожидаем.Что(Эталон.Записи).ИмеетДлину(4);
	Ожидаем.Что(Эталон.Остаток).Равно(Незавершенная);

КонецПроцедуры

&Тест
Процедура НезакрытаяКавычкаВнеЗаписиОстанавливаетРазборПриЛюбомОкне() Экспорт

	// Дано
	Текст = "{1,2}," + ПС + """обрыв {3,4},{5,6}" + ПС + "{7,8},";

	// Когда, Тогда
	Эталон = ПроверитьВсеОкна(Текст);
	Ожидаем.Что(Эталон.Записи).ИмеетДлину(1);
	Ожидаем.Что(Эталон.Остаток).Равно("");

КонецПроцедуры

&Тест
Процедура СтрокаДлиннееМногихОконРазбираетсяПриЛюбомОкне() Экспорт

	// Дано - строка в кавычках без кавычек внутри тянется через много окон, затем записи
	Длинная = "";
	Для Сч = 1 По 30 Цикл
		Длинная = Длинная + "строка {" + Сч + "}, ";
	КонецЦикла;
	Текст = "{1,""" + Длинная + """,{2,""" + Длинная + """""" + Длинная + """}}," + ПС + "{3,4}," + ПС + "{5,""" + Длинная;

	// Когда, Тогда
	Эталон = ПроверитьВсеОкна(Текст);
	Ожидаем.Что(Эталон.Записи).ИмеетДлину(2);
	Ожидаем.Что(Эталон.Записи[0][1]).Равно(Длинная);
	Ожидаем.Что(Эталон.Записи[0][2][1]).Равно(Длинная + """" + Длинная);
	Ожидаем.Что(Эталон.Остаток).Равно("{5,""" + Длинная);

КонецПроцедуры

&Тест
Процедура ЗаписьДлиннееОкнаРазбирается() Экспорт

	// Дано
	Длинная = "";
	Для Сч = 1 По 100 Цикл
		Длинная = Длинная + "значение" + Сч + ",";
	КонецЦикла;
	Текст = "{" + Длинная + "конец}," + ПС + "{1,2}," + ПС;
	Парсер = Новый ПарсерСкобочногоФормата();
	Парсер.УстановитьРазмерОкна(16);

	// Когда
	Результат = Парсер.Разобрать(Текст);

	// Тогда
	Ожидаем.Что(Результат.Записи).ИмеетДлину(2);
	Ожидаем.Что(Результат.Записи[0]).ИмеетДлину(101);
	Ожидаем.Что(Результат.Записи[0][99]).Равно("значение100");
	Ожидаем.Что(Результат.Записи[0][100]).Равно("конец");
	Ожидаем.Что(Результат.Записи[1][1]).Равно("2");
	Ожидаем.Что(Результат.Остаток).Равно("");

КонецПроцедуры

&Тест
Процедура РазмерОкнаМеньшеЕдиницыОтклоняется() Экспорт

	Параметры = Новый Массив;
	Параметры.Добавить(0);
	Ожидаем.Что(Новый ПарсерСкобочногоФормата()).Метод("УстановитьРазмерОкна", Параметры).ВыбрасываетИсключение("не меньше 1");

КонецПроцедуры

&Тест
Процедура СтрокиИзКавычекИСУдвоеннымиКавычкамиПоКраям() Экспорт

	// Дано
	Кв = """";
	Текст = "{" + Кв + Кв + "," + Кв + Кв + Кв + Кв + "," + Кв + "a" + Кв + Кв + "b" + Кв + ","
		+ Кв + Кв + Кв + Кв + Кв + Кв + ",x}," + ПС;

	// Когда
	Результат = ПроверитьВсеОкна(Текст);

	// Тогда
	Запись = Результат.Записи[0];
	Ожидаем.Что(Запись).ИмеетДлину(5);
	Ожидаем.Что(Запись[0]).Равно("");
	Ожидаем.Что(Запись[1]).Равно(Кв);
	Ожидаем.Что(Запись[2]).Равно("a" + Кв + "b");
	Ожидаем.Что(Запись[3]).Равно(Кв + Кв);
	Ожидаем.Что(Запись[4]).Равно("x");
	Ожидаем.Что(Результат.Остаток).Равно("");

КонецПроцедуры

// Разбирает текст целиком и каждым размером окна от 1 до длины текста; результаты должны совпасть.
Функция ПроверитьВсеОкна(Знач Текст)

	Эталон = ПарсерСкобочногоФормата.Разобрать(Текст);
	Парсер = Новый ПарсерСкобочногоФормата();
	Для РазмерОкна = 1 По СтрДлина(Текст) + 1 Цикл
		Парсер.УстановитьРазмерОкна(РазмерОкна);
		Результат = Парсер.Разобрать(Текст);
		Ожидаем.Что(Плоско(Результат.Записи), "записи при окне " + РазмерОкна).Равно(Плоско(Эталон.Записи));
		Ожидаем.Что(Результат.Остаток, "остаток при окне " + РазмерОкна).Равно(Эталон.Остаток);
	КонецЦикла;
	Возврат Эталон;

КонецФункции

Функция Плоско(Знач Список)
	Части = Новый Массив;
	Для Каждого Элемент Из Список Цикл
		Если ТипЗнч(Элемент) = Тип("Массив") Тогда
			Части.Добавить("[" + Плоско(Элемент) + "]");
		Иначе
			Части.Добавить("<" + Элемент + ">");
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Части, ";");
КонецФункции

ПС = Символы.ПС;
