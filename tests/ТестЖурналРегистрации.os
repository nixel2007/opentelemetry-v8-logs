#Использовать ".."
#Использовать asserts

Перем ПС;

&Тест
Процедура СловарьЗаполняетсяИзЗаписейLgf() Экспорт

	// Дано
	Словарь = НовыйСловарь();

	// Тогда
	Пользователь = Словарь.Пользователь(2);
	Ожидаем.Что(Пользователь.Имя).Равно("Администратор");
	Ожидаем.Что(Пользователь.Ид).Равно("8368e8b0-9829-4ae2-92bd-8d4ddd658d9a");
	Ожидаем.Что(Словарь.Компьютер(1)).Равно("DESKTOP-8D53RGD");
	Ожидаем.Что(Словарь.Приложение(2)).Равно("1CV8C");
	Ожидаем.Что(Словарь.Событие(2)).Равно("_$Session$_.Start");
	Ожидаем.Что(Словарь.Метаданные(1).Имя).Равно("РегламентноеЗадание.ПроверкаКэша");
	Ожидаем.Что(Словарь.Метаданные(1).Ид).Равно("2f25c58f-e234-48f8-9595-35f257c52b01");
	Ожидаем.Что(Словарь.Сервер(1)).Равно("srv1c");
	Ожидаем.Что(Словарь.ОсновнойПорт(1)).Равно(1541);
	Ожидаем.Что(Словарь.ВспомогательныйПорт(1)).Равно(1560);

КонецПроцедуры

&Тест
Процедура СловарьВозвращаетПустыеЗначенияДляНеизвестныхКодов() Экспорт

	// Дано
	Словарь = НовыйСловарь();

	// Тогда
	Ожидаем.Что(Словарь.Пользователь(0).Имя).Равно("");
	Ожидаем.Что(Словарь.Пользователь(100).Ид).Равно("");
	Ожидаем.Что(Словарь.Компьютер(100)).Равно("");
	Ожидаем.Что(Словарь.ОсновнойПорт(0)).Равно(0);

КонецПроцедуры

&Тест
Процедура ПовторнаяЗаписьСловаряЗаменяетЗначение() Экспорт

	// Дано
	Словарь = НовыйСловарь();
	Разбор = ПарсерСкобочногоФормата.Разобрать("{5,2f25c58f-e234-48f8-9595-35f257c52b01,""Справочник.Банки"",1}," + ПС);

	// Когда
	Словарь.Добавить(Разбор.Записи);

	// Тогда
	Ожидаем.Что(Словарь.Метаданные(1).Имя).Равно("Справочник.Банки");

КонецПроцедуры

&Тест
Процедура РазборЗаписиЖурнала() Экспорт

	// Дано
	Словарь = НовыйСловарь();
	Текст = "{20250517151944,U," + ПС
		+ "{244e23df9f3b0,12c0},2,1,2,57,2,E,""Ошибка """"настройки""""" + ПС
		+ "задания"",1," + ПС
		+ "{""S"",""значение""},""Представление"",1,1,1,8,0," + ПС
		+ "{2,1,1,2,1}" + ПС
		+ "}," + ПС;
	Элемент = ПарсерСкобочногоФормата.Разобрать(Текст).Записи[0];

	// Когда
	Запись = ПарсерЖурналаРегистрации.ЗаписьЖурнала(Элемент, Словарь);

	// Тогда
	Ожидаем.Что(Запись.Время).Равно(Дата(2025, 5, 17, 15, 19, 44));
	Ожидаем.Что(Запись.СтатусТранзакции).Равно("U");
	Ожидаем.Что(Запись.ВремяТранзакции).Равно(Дата(2024, 12, 3, 17, 44, 11));
	Ожидаем.Что(Запись.НомерТранзакции).Равно(4800);
	Ожидаем.Что(Запись.Пользователь).Равно("Администратор");
	Ожидаем.Что(Запись.ИдПользователя).Равно("8368e8b0-9829-4ae2-92bd-8d4ddd658d9a");
	Ожидаем.Что(Запись.Компьютер).Равно("DESKTOP-8D53RGD");
	Ожидаем.Что(Запись.Приложение).Равно("1CV8C");
	Ожидаем.Что(Запись.Соединение).Равно(57);
	Ожидаем.Что(Запись.Событие).Равно("_$Session$_.Start");
	Ожидаем.Что(Запись.Важность).Равно("E");
	Ожидаем.Что(Запись.Комментарий).Равно("Ошибка ""настройки""" + ПС + "задания");
	Ожидаем.Что(Запись.Метаданные).Равно("РегламентноеЗадание.ПроверкаКэша");
	Ожидаем.Что(Запись.ИдМетаданных).Равно("2f25c58f-e234-48f8-9595-35f257c52b01");
	Ожидаем.Что(Запись.Данные).Равно("значение");
	Ожидаем.Что(Запись.ПредставлениеДанных).Равно("Представление");
	Ожидаем.Что(Запись.Сервер).Равно("srv1c");
	Ожидаем.Что(Запись.ОсновнойПорт).Равно(1541);
	Ожидаем.Что(Запись.ВспомогательныйПорт).Равно(1560);
	Ожидаем.Что(Запись.Сеанс).Равно(8);
	Ожидаем.Что(Запись.РазделениеДанныхСеанса["ОбластьДанныхВспомогательныеДанные"]).Равно("0");
	Ожидаем.Что(Запись.РазделениеДанныхСеанса["ОбластьДанныхОсновныеДанные"]).Равно("7");

КонецПроцедуры

&Тест
Процедура ЗаписьБезТранзакцииИРазделения() Экспорт

	// Дано
	Словарь = НовыйСловарь();
	Текст = "{20250517150813,N,{0,0},1,1,1,1,1,I,"""",0,{""U""},"""",0,0,0,1,0,{0}},";
	Элемент = ПарсерСкобочногоФормата.Разобрать(Текст).Записи[0];

	// Когда
	Запись = ПарсерЖурналаРегистрации.ЗаписьЖурнала(Элемент, Словарь);

	// Тогда
	Ожидаем.Что(Запись.СтатусТранзакции).Равно("N");
	Ожидаем.Что(Запись.ВремяТранзакции).Равно(Неопределено);
	Ожидаем.Что(Запись.НомерТранзакции).Равно(0);
	Ожидаем.Что(Запись.Метаданные).Равно("");
	Ожидаем.Что(Запись.Данные).Равно("");
	Ожидаем.Что(Запись.Сервер).Равно("");
	Ожидаем.Что(Запись.ОсновнойПорт).Равно(0);
	Ожидаем.Что(Запись.РазделениеДанныхСеанса).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ПредставлениеДанныхРазныхТипов() Экспорт

	Ожидаем.Что(ДанныеЗаписи("{""U""}")).Равно("");
	Ожидаем.Что(ДанныеЗаписи("{""S"",""текст""}")).Равно("текст");
	Ожидаем.Что(ДанныеЗаписи("{""B"",1}")).Равно("true");
	Ожидаем.Что(ДанныеЗаписи("{""B"",0}")).Равно("false");
	Ожидаем.Что(ДанныеЗаписи("{""N"",42.5}")).Равно("42.5");
	Ожидаем.Что(ДанныеЗаписи("{""D"",20250517151944}")).Равно("2025-05-17T15:19:44");
	Ожидаем.Что(ДанныеЗаписи("{""R"",47:976d00d8612c645111efb1744b0ce2e8}"))
		.Равно("47:976d00d8612c645111efb1744b0ce2e8");
	Ожидаем.Что(ДанныеЗаписи("{""P"",{518,{""S"",""""},{""S"",""DESKTOP\ДНС""},{""N"",1}}}"))
		.Равно("DESKTOP\ДНС; 1");

КонецПроцедуры

Функция ДанныеЗаписи(Данные)
	Текст = "{20250517150813,N,{0,0},0,0,0,0,0,I,"""",0," + Данные + ","""",0,0,0,0,0,{0}},";
	Элемент = ПарсерСкобочногоФормата.Разобрать(Текст).Записи[0];
	Возврат ПарсерЖурналаРегистрации.ЗаписьЖурнала(Элемент, НовыйСловарь()).Данные;
КонецФункции

Функция НовыйСловарь()

	Текст = Символ(65279) + "1CV8LOG(ver 2.0)" + ПС
		+ "1ed9cff4-8a21-4bf4-8f5b-08731ea05d24" + ПС
		+ ПС
		+ "{1,071523a4-516f-4fce-ba4b-0d11ab7a1893,"""",1}," + ПС
		+ "{2,""DESKTOP-8D53RGD"",1}," + ПС
		+ "{3,""Designer"",1}," + ПС
		+ "{4,""_$Session$_.Authentication"",1}," + ПС
		+ "{13,1,1}," + ПС
		+ "{4,""_$Session$_.Start"",2}," + ПС
		+ "{1,8368e8b0-9829-4ae2-92bd-8d4ddd658d9a,""Администратор"",2}," + ПС
		+ "{3,""1CV8C"",2}," + ПС
		+ "{9,530a3164-4ef1-4b3b-8269-13764ef4bf15,""ОбластьДанныхВспомогательныеДанные"",1}," + ПС
		+ "{10," + ПС + "{""N"",0},1,1}," + ПС
		+ "{9,6df2bb92-558c-4453-9de4-e4176e8f93dc,""ОбластьДанныхОсновныеДанные"",2}," + ПС
		+ "{10," + ПС + "{""N"",7},2,1}," + ПС
		+ "{11," + ПС + "{2,1,1,2,1},2}," + ПС
		+ "{5,2f25c58f-e234-48f8-9595-35f257c52b01,""РегламентноеЗадание.ПроверкаКэша"",1}," + ПС
		+ "{6,""srv1c"",1}," + ПС
		+ "{7,1541,1}," + ПС
		+ "{8,1560,1}," + ПС;

	Словарь = Новый СловарьЖурналаРегистрации();
	Словарь.Добавить(ПарсерСкобочногоФормата.Разобрать(Текст).Записи);

	Возврат Словарь;

КонецФункции

ПС = Символы.ПС;
