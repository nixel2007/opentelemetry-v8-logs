// BSLLS:MagicNumber-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
// BSLLS:DuplicateStringLiteral-off
// BSLLS:MagicDate-off
// BSLLS:NestedFunctionInParameters-off
// BSLLS:Typo-off
#Использовать "../src/ТехнологическийЖурнал"
#Использовать asserts

&Пластилин
Перем ПарсерТехнологическогоЖурнала;

Перем ПС;

&Тест
Процедура РазборПростогоСобытия() Экспорт

	// Дано
	Текст = "05:12.345678-15,CALL,1,process=rphost,Usr=Admin,Context=Форма.Вызов" + ПС;

	// Когда
	Результат = ПарсерТехнологическогоЖурнала.Разобрать(Текст, Дата(2026, 10, 20, 9, 0, 0));

	// Тогда
	Ожидаем.Что(Результат.События).ИмеетДлину(1);
	Событие = Результат.События[0];
	Ожидаем.Что(Событие.Время).Равно(Дата(2026, 10, 20, 9, 5, 12));
	Ожидаем.Что(Событие.Микросекунды).Равно(345678);
	Ожидаем.Что(Событие.Длительность).Равно(15);
	Ожидаем.Что(Событие.Имя).Равно("CALL");
	Ожидаем.Что(Событие.Уровень).Равно(1);
	Ожидаем.Что(Событие.Свойства["process"]).Равно("rphost");
	Ожидаем.Что(Событие.Свойства["Usr"]).Равно("Admin");
	Ожидаем.Что(Событие.Свойства["Context"]).Равно("Форма.Вызов");
	Ожидаем.Что(Событие.Текст).Равно("05:12.345678-15,CALL,1,process=rphost,Usr=Admin,Context=Форма.Вызов");
	Ожидаем.Что(Результат.Остаток).Равно("");

КонецПроцедуры

&Тест
Процедура РазборСобытияСПолнойДатойВЗаголовке() Экспорт

	// Дано - ротация по размеру (rotation="size"): в имени файла нет даты, она в каждой строке
	Текст = "2026-11-06T15:31:57.813001-1,CALL,1,level=INFO,process=rphost,OSThread=181" + ПС
		+ "2026-11-06T15:31:58.076000-2000,SCALL,0,level=INFO,process=rphost,MName=getServer" + ПС;

	// Когда
	Результат = ПарсерТехнологическогоЖурнала.Разобрать(Текст, Неопределено);

	// Тогда
	Ожидаем.Что(Результат.События).ИмеетДлину(2);
	Событие = Результат.События[0];
	Ожидаем.Что(Событие.Время).Равно(Дата(2026, 11, 6, 15, 31, 57));
	Ожидаем.Что(Событие.Микросекунды).Равно(813001);
	Ожидаем.Что(Событие.Длительность).Равно(1);
	Ожидаем.Что(Событие.Имя).Равно("CALL");
	Ожидаем.Что(Событие.Уровень).Равно(1);
	Ожидаем.Что(Событие.Свойства["OSThread"]).Равно("181");
	Ожидаем.Что(Событие.Текст).Равно("2026-11-06T15:31:57.813001-1,CALL,1,level=INFO,process=rphost,OSThread=181");
	Ожидаем.Что(Результат.События[1].Время).Равно(Дата(2026, 11, 6, 15, 31, 58));
	Ожидаем.Что(Результат.События[1].Длительность).Равно(2000);

КонецПроцедуры

&Тест
Процедура СобытиеБезДатыВФайлеРотацииПоРазмеруПропускается() Экспорт

	// Дано - в файле ротации по размеру даты в имени нет, а заголовок события - без даты
	Текст = "05:12.000001-1,CALL,1,Usr=Admin" + ПС
		+ "2026-11-06T15:31:58.000001-1,SCALL,0,Usr=Admin" + ПС;

	// Когда
	Результат = ПарсерТехнологическогоЖурнала.Разобрать(Текст, Неопределено);

	// Тогда - событие пропущено, а не остановило чтение файла
	Ожидаем.Что(Результат.Пропущено).Равно(1);
	Ожидаем.Что(Результат.События).ИмеетДлину(1);
	Ожидаем.Что(Результат.События[0].Имя).Равно("SCALL");

КонецПроцедуры

&Тест
Процедура РазборМногострочногоСобытияСПолнойДатойВЗаголовке() Экспорт

	// Дано - строка значения, похожая на начало события, внутри незакрытой кавычки
	Текст = "2026-11-06T15:45:40.589000-986,DBPOSTGRS,5,Sql=""INSERT INTO t" + ПС
		+ "2026-11-06T15:45:40.589000-1,CALL,1"",RowsAffected=1" + ПС
		+ "2026-11-06T15:45:40.589002-1,DBPOSTGRS,5,Func=commit" + ПС;

	// Когда
	Результат = ПарсерТехнологическогоЖурнала.Разобрать(Текст, Неопределено);

	// Тогда
	Ожидаем.Что(Результат.События).ИмеетДлину(2);
	Ожидаем.Что(Результат.События[0].Свойства["Sql"]).Равно("INSERT INTO t" + ПС + "2026-11-06T15:45:40.589000-1,CALL,1");
	Ожидаем.Что(Результат.События[0].Свойства["RowsAffected"]).Равно("1");
	Ожидаем.Что(Результат.События[1].Свойства["Func"]).Равно("commit");

КонецПроцедуры

