&Тест
Процедура ЗначенияСвойствВТексте() Экспорт

	// Дано
	Текст = "00:01.000001-7,DBMSSQL,4,process=rphost,Empty=,Sql='SELECT ''x''," + ПС + "1',"
		+ "Descr=""a """"b"""""",Quoted='',Rows=1" + ПС;

	// Когда
	Событие = ПарсерТехнологическогоЖурнала.Разобрать(Текст, Дата(2026, 10, 20, 9, 0, 0)).События[0];
	Значения = ПарсерТехнологическогоЖурнала.ЗначенияВТексте(Событие.Текст);

	// Тогда - пустые значения не перечисляются, у значений в кавычках - без кавычек
	Ожидаем.Что(Значения).ИмеетДлину(4);
	Ожидаем.Что(Значения[0].Ключ).Равно("process");
	Ожидаем.Что(ЗначениеВТексте(Событие.Текст, Значения[0])).Равно("rphost");
	Ожидаем.Что(Значения[0].НедопустимоеОкончание).Равно(Неопределено);
	Ожидаем.Что(Значения[1].Ключ).Равно("Sql");
	Ожидаем.Что(ЗначениеВТексте(Событие.Текст, Значения[1])).Равно("SELECT ''x''," + ПС + "1");
	Ожидаем.Что(Значения[2].Ключ).Равно("Descr");
	Ожидаем.Что(ЗначениеВТексте(Событие.Текст, Значения[2])).Равно("a """"b""""");
	Ожидаем.Что(Значения[3].Ключ).Равно("Rows");
	Ожидаем.Что(ЗначениеВТексте(Событие.Текст, Значения[3])).Равно("1");
	Ожидаем.Что(Значения[3].НедопустимоеОкончание).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ЗначенияСвойствВТекстеСПолнойДатойВЗаголовке() Экспорт

	// Дано
	Текст = "2026-11-06T15:31:57.813001-1,CALL,1,process=rphost,Usr=Admin";

	// Когда
	Значения = ПарсерТехнологическогоЖурнала.ЗначенияВТексте(Текст);

	// Тогда
	Ожидаем.Что(Значения).ИмеетДлину(2);
	Ожидаем.Что(Значения[0].Ключ).Равно("process");
	Ожидаем.Что(ЗначениеВТексте(Текст, Значения[0])).Равно("rphost");
	Ожидаем.Что(ЗначениеВТексте(Текст, Значения[1])).Равно("Admin");

КонецПроцедуры

&Тест
Процедура ЗначенийНетВТекстеНеожиданногоВида() Экспорт
	Ожидаем.Что(ПарсерТехнологическогоЖурнала.ЗначенияВТексте("не событие,a=1")).ИмеетДлину(0);
КонецПроцедуры

&Тест
Процедура НедопустимоеОкончаниеЗначенияВКавычках() Экспорт

	// Дано
	Текст = "00:01.000001-7,DBMSSQL,4,Sql='x',Descr=""y""";

	// Когда
	Значения = ПарсерТехнологическогоЖурнала.ЗначенияВТексте(Текст);

	// Тогда - нечетное число своих кавычек в конце разрывает удвоенную кавычку
	Одинарные = Значения[0].НедопустимоеОкончание;
	Ожидаем.Что(Одинарные.Заменить("ab'", "")).Равно("ab");
	Ожидаем.Что(Одинарные.Заменить("ab'''", "")).Равно("ab");
	Ожидаем.Что(Одинарные.Заменить("ab''", "")).Равно("ab''");
	Ожидаем.Что(Одинарные.Заменить("a'b""", "")).Равно("a'b""");
	Двойные = Значения[1].НедопустимоеОкончание;
	Ожидаем.Что(Двойные.Заменить("ab""", "")).Равно("ab");
	Ожидаем.Что(Двойные.Заменить("ab""""", "")).Равно("ab""""");
	Ожидаем.Что(Двойные.Заменить("ab'", "")).Равно("ab'");

КонецПроцедуры

Функция ЗначениеВТексте(Текст, Значение)
	Возврат Сред(Текст, Значение.Начало, Значение.Длина);
КонецФункции

&Тест
Процедура ЗначенияИзКавычекИСУдвоеннымиКавычкамиПоКраям() Экспорт

	// Дано
	Текст = "00:01.000001-7,EXCP,1,a='',b='''',c='''x''',d='''''',e="""""""",f=""""""x"",g='x',h=1" + ПС;

	// Когда
	Результат = ПарсерТехнологическогоЖурнала.Разобрать(Текст, Дата(2026, 10, 20, 9, 0, 0));

	// Тогда
	Свойства = Результат.События[0].Свойства;
	Ожидаем.Что(Свойства["a"]).Равно("");
	Ожидаем.Что(Свойства["b"]).Равно("'");
	Ожидаем.Что(Свойства["c"]).Равно("'x'");
	Ожидаем.Что(Свойства["d"]).Равно("''");
	Ожидаем.Что(Свойства["e"]).Равно("""");
	Ожидаем.Что(Свойства["f"]).Равно("""x");
	Ожидаем.Что(Свойства["g"]).Равно("x");
	Ожидаем.Что(Свойства["h"]).Равно("1");
	Ожидаем.Что(Результат.Остаток).Равно("");

КонецПроцедуры

ПС = Символы.ПС;
