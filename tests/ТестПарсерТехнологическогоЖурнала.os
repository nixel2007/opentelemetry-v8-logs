// BSLLS:MagicNumber-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
#Использовать ".."
#Использовать asserts

Перем ПС;

&Тест
Процедура РазборПростогоСобытия() Экспорт

	// Дано
	Текст = "05:12.345678-15,CALL,1,process=rphost,Usr=Admin,Context=Форма.Вызов" + ПС;

	// Когда
	Результат = ПарсерТехнологическогоЖурнала.Разобрать(Текст, Дата(2026, 10, 20, 9, 0, 0));

	// Тогда
	Ожидаем.Что(Результат.События).ИмеетДлину(1);
	Событие = Результат.События[0];
	Ожидаем.Что(Событие.Время).Равно(Дата(2026, 10, 20, 9, 5, 12));
	Ожидаем.Что(Событие.Микросекунды).Равно(345678);
	Ожидаем.Что(Событие.Длительность).Равно(15);
	Ожидаем.Что(Событие.Имя).Равно("CALL");
	Ожидаем.Что(Событие.Уровень).Равно(1);
	Ожидаем.Что(Событие.Свойства["process"]).Равно("rphost");
	Ожидаем.Что(Событие.Свойства["Usr"]).Равно("Admin");
	Ожидаем.Что(Событие.Свойства["Context"]).Равно("Форма.Вызов");
	Ожидаем.Что(Событие.Текст).Равно("05:12.345678-15,CALL,1,process=rphost,Usr=Admin,Context=Форма.Вызов");
	Ожидаем.Что(Результат.Остаток).Равно("");

КонецПроцедуры

&Тест
Процедура РазборЗначенияВОдинарныхКавычках() Экспорт

	// Дано
	Текст = "00:01.000001-0,EXCP,2,Descr='Ошибка, ''важная'' очень',OSThread=12" + ПС;

	// Когда
	Результат = ПарсерТехнологическогоЖурнала.Разобрать(Текст, Дата(2026, 10, 20, 9, 0, 0));

	// Тогда
	Событие = Результат.События[0];
	Ожидаем.Что(Событие.Свойства["Descr"]).Равно("Ошибка, 'важная' очень");
	Ожидаем.Что(Событие.Свойства["OSThread"]).Равно("12");

КонецПроцедуры

&Тест
Процедура РазборЗначенияВДвойныхКавычках() Экспорт

	// Дано
	Текст = "00:01.000001-7,DBMSSQL,4,Sql=""SELECT """"x"""", 'y' FROM t"",Rows=1" + ПС;

	// Когда
	Результат = ПарсерТехнологическогоЖурнала.Разобрать(Текст, Дата(2026, 10, 20, 9, 0, 0));

	// Тогда
	Событие = Результат.События[0];
	Ожидаем.Что(Событие.Свойства["Sql"]).Равно("SELECT ""x"", 'y' FROM t");
	Ожидаем.Что(Событие.Свойства["Rows"]).Равно("1");

КонецПроцедуры

&Тест
Процедура РазборМногострочногоЗначения() Экспорт

	// Дано
	Текст = "00:01.000001-7,EXCP,1,Context='Строка1" + ПС
		+ "Строка2" + ПС
		+ "Строка3',Usr=Admin" + ПС
		+ "00:02.000001-1,CONN,0,Txt=ok" + ПС;

	// Когда
	Результат = ПарсерТехнологическогоЖурнала.Разобрать(Текст, Дата(2026, 10, 20, 9, 0, 0));

	// Тогда
	Ожидаем.Что(Результат.События).ИмеетДлину(2);
	Ожидаем.Что(Результат.События[0].Свойства["Context"]).Равно("Строка1" + ПС + "Строка2" + ПС + "Строка3");
	Ожидаем.Что(Результат.События[0].Свойства["Usr"]).Равно("Admin");
	Ожидаем.Что(Результат.События[1].Имя).Равно("CONN");
	Ожидаем.Что(Результат.Остаток).Равно("");

КонецПроцедуры

&Тест
Процедура НезавершенноеПоследнееСобытиеОстаетсяВОстатке() Экспорт

	// Дано
	Незавершенное = "00:02.000001-1,EXCP,0,Context='Начало контекста" + ПС
		+ "продолжение" + ПС;
	Текст = "00:01.000001-7,CALL,1,Usr=Admin" + ПС + Незавершенное;

	// Когда
	Результат = ПарсерТехнологическогоЖурнала.Разобрать(Текст, Дата(2026, 10, 20, 9, 0, 0));

	// Тогда
	Ожидаем.Что(Результат.События).ИмеетДлину(1);
	Ожидаем.Что(Результат.События[0].Имя).Равно("CALL");
	Ожидаем.Что(Результат.Остаток).Равно(Незавершенное);

КонецПроцедуры

&Тест
Процедура НезавершенноеСобытиеВЗавершенномТекстеВозвращаетсяКакЕсть() Экспорт

	// Дано
	Текст = "00:02.000001-1,EXCP,0,Usr=Admin,Context='Начало контекста" + ПС;

	// Когда
	Результат = ПарсерТехнологическогоЖурнала.Разобрать(Текст, Дата(2026, 10, 20, 9, 0, 0), Истина);

	// Тогда
	Ожидаем.Что(Результат.События).ИмеетДлину(1);
	Ожидаем.Что(Результат.События[0].Имя).Равно("EXCP");
	Ожидаем.Что(Результат.События[0].Свойства["Usr"]).Равно("Admin");
	Ожидаем.Что(Результат.Остаток).Равно("");

КонецПроцедуры

&Тест
Процедура РазборСтрокСПереводомКаретки() Экспорт

	// Дано
	ВК = Символы.ВК;
	Текст = "00:01.000001-7,EXCP,1,Context='Строка1" + ВК + ПС
		+ "Строка2',Usr=Admin" + ВК + ПС
		+ "00:02.000001-1,CONN,0,Txt=ok" + ВК + ПС;

	// Когда
	Результат = ПарсерТехнологическогоЖурнала.Разобрать(Текст, Дата(2026, 10, 20, 9, 0, 0));

	// Тогда
	Ожидаем.Что(Результат.События).ИмеетДлину(2);
	Ожидаем.Что(Результат.События[0].Свойства["Context"]).Равно("Строка1" + ПС + "Строка2");
	Ожидаем.Что(Результат.События[0].Свойства["Usr"]).Равно("Admin");
	Ожидаем.Что(Результат.События[1].Свойства["Txt"]).Равно("ok");

КонецПроцедуры

&Тест
Процедура ОстатокСохраняетИсходныеПереводыКаретки() Экспорт

	// Дано
	ВК = Символы.ВК;
	Незавершенное = "00:02.000001-1,EXCP,0,Context='Начало" + ВК + ПС;
	Текст = "00:01.000001-7,CALL,1,Usr=Admin" + ВК + ПС + Незавершенное;

	// Когда
	Результат = ПарсерТехнологическогоЖурнала.Разобрать(Текст, Дата(2026, 10, 20, 9, 0, 0));

	// Тогда
	Ожидаем.Что(Результат.Остаток).Равно(Незавершенное);

КонецПроцедуры

&Тест
Процедура РазборПустогоЗначения() Экспорт

	// Дано
	Текст = "00:01.000001-7,CALL,1,Usr=,Context=,Rows=5" + ПС;

	// Когда
	Результат = ПарсерТехнологическогоЖурнала.Разобрать(Текст, Дата(2026, 10, 20, 9, 0, 0));

	// Тогда
	Свойства = Результат.События[0].Свойства;
	Ожидаем.Что(Свойства["Usr"]).Равно("");
	Ожидаем.Что(Свойства["Context"]).Равно("");
	Ожидаем.Что(Свойства["Rows"]).Равно("5");

КонецПроцедуры

&Тест
Процедура ПовторяющиесяСвойстваСобираютсяВМассив() Экспорт

	// Дано
	Текст = "00:01.000001-7,TLOCK,3,Regions=A,Regions=B,Regions=C" + ПС;

	// Когда
	Результат = ПарсерТехнологическогоЖурнала.Разобрать(Текст, Дата(2026, 10, 20, 9, 0, 0));

	// Тогда
	Значение = Результат.События[0].Свойства["Regions"];
	Ожидаем.Что(Значение).ИмеетТип("Массив");
	Ожидаем.Что(Значение).ИмеетДлину(3);
	Ожидаем.Что(Значение[2]).Равно("C");

КонецПроцедуры

&Тест
Процедура РазборФорматаВосемьДва() Экспорт

	// Дано - в 8.2 доли секунды и длительность в десятитысячных секунды
	Текст = "05:12.3456-15,CALL,1,Usr=Admin" + ПС;

	// Когда
	Результат = ПарсерТехнологическогоЖурнала.Разобрать(Текст, Дата(2026, 10, 20, 9, 0, 0));

	// Тогда
	Событие = Результат.События[0];
	Ожидаем.Что(Событие.Микросекунды).Равно(345600);
	Ожидаем.Что(Событие.Длительность).Равно(1500);

КонецПроцедуры

