&Тест
Процедура ИменаСвойствСДвоеточием() Экспорт

	// Дано
	Текст = "00:01.000001-7,CALL,1,t:clientID=12,t:applicationName=1CV8C,p:processName=base" + ПС;

	// Когда
	Результат = ПарсерТехнологическогоЖурнала.Разобрать(Текст, Дата(2026, 10, 20, 9, 0, 0));

