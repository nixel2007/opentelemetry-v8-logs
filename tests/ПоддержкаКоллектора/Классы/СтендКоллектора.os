// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
// BSLLS:MagicNumber-off
// BSLLS:NestedFunctionInParameters-off
// BSLLS:NumberOfOptionalParams-off
// Окружение тестов КоллекторЖурналов: временные каталоги журналов, перехват лога коллектора и поделка
// с настройками коллектора. Общее для наборов с настоящим и подменным опросчиком кластера.
#Использовать autumn
#Использовать asserts
#Использовать tempfiles
#Использовать logos
#Использовать opentelemetry

Перем ПС;
Перем ВременныеФайлы;
Перем КаталогТЖ;
Перем КаталогЖР;
Перем СообщенияЛога; // Массив из Структура - Текст, Уровень
Перем БлокировкаСообщенийЛога; // БлокировкаРесурса - лог пишут и фоновые задания коллектора
Перем СбойВыводаЛога; // Строка - на первом сообщении с этой подстрокой способ вывода бросает исключение

// Перед каждым тестом: новые каталоги журналов, перехват лога коллектора, сброс глобального SDK.
Процедура Подготовить() Экспорт
	ВременныеФайлы = Новый МенеджерВременныхФайлов;
	КаталогТЖ = ВременныеФайлы.СоздатьКаталог();
	КаталогЖР = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "1Cv8Log");
	СоздатьКаталог(КаталогЖР);
	СообщенияЛога = Новый Массив;
	БлокировкаСообщенийЛога = Новый БлокировкаРесурса(СообщенияЛога);
	СбойВыводаЛога = "";
	Для Каждого ИмяЛога Из ИменаЛоговКоллектора() Цикл
		Логирование.ПолучитьЛог(ИмяЛога).ДобавитьСпособВывода(ЭтотОбъект);
	КонецЦикла;
	// Поделка OneUnit регистрирует глобальный SDK, когда создает желуди с ОтелSdk (ЗапросыHTTPТехнологическогоЖурнала),
	// а повторная регистрация запрещена
	ОтелГлобальный.Сбросить();
КонецПроцедуры

// После каждого теста.
Процедура Удалить() Экспорт
	Для Каждого ИмяЛога Из ИменаЛоговКоллектора() Цикл
		Логирование.ПолучитьЛог(ИмяЛога).УдалитьСпособВывода(ЭтотОбъект);
	КонецЦикла;
	ОтелГлобальный.Сбросить();
	ВременныеФайлы.Удалить();
КонецПроцедуры

// Способ вывода лога
Процедура Вывести(Знач Сообщение, Знач УровеньСообщения) Экспорт
	БлокировкаСообщенийЛога.Заблокировать();
	СообщенияЛога.Добавить(Новый Структура("Текст, Уровень", Сообщение, УровеньСообщения));
	Сбой = ЗначениеЗаполнено(СбойВыводаЛога) И СтрНайти(Сообщение, СбойВыводаЛога) > 0;
	Если Сбой Тогда
		СбойВыводаЛога = "";
	КонецЕсли;
	БлокировкаСообщенийЛога.Разблокировать();
	Если Сбой Тогда
		ВызватьИсключение "Сбой вывода лога";
	КонецЕсли;
КонецПроцедуры

// Способ вывода лога
Процедура Закрыть() Экспорт
	Возврат;
КонецПроцедуры

// Способ вывода бросит исключение на первом сообщении с подстрокой.
Процедура СбойВыводаНаСообщении(Подстрока) Экспорт
	СбойВыводаЛога = Подстрока;
КонецПроцедуры

Функция СообщенияЛогаС(Подстрока) Экспорт
	Результат = Новый Массив;
	БлокировкаСообщенийЛога.Заблокировать();
	Для Каждого Сообщение Из СообщенияЛога Цикл
		Если СтрНайти(Сообщение.Текст, Подстрока) > 0 Тогда
			Результат.Добавить(Сообщение);
		КонецЕсли;
	КонецЦикла;
	БлокировкаСообщенийЛога.Разблокировать();
	Возврат Результат;
КонецФункции

Процедура ОчиститьСообщенияЛога() Экспорт
	БлокировкаСообщенийЛога.Заблокировать();
	СообщенияЛога.Очистить();
	БлокировкаСообщенийЛога.Разблокировать();
КонецПроцедуры

// Исключение конструктора желудя ОСень не пробрасывает: пишет его в свой лог и отдает Неопределено.
Процедура ПерехватыватьЛогОсени(Перехватывать) Экспорт
	ЛогОсени = Логирование.ПолучитьЛог("oscript.lib.autumn.application.context");
	Если Перехватывать Тогда
		ЛогОсени.ДобавитьСпособВывода(ЭтотОбъект);
	Иначе
		ЛогОсени.УдалитьСпособВывода(ЭтотОбъект);
	КонецЕсли;
КонецПроцедуры

Функция КаталогТехнологическогоЖурнала() Экспорт
	Возврат КаталогТЖ;
КонецФункции

Функция КаталогЖурналаРегистрации() Экспорт
	Возврат КаталогЖР;
КонецФункции

Функция СекцияКластера(АдресRAS, ИмяСервиса = "") Экспорт
	Секция = Новый Соответствие;
	Секция.Вставить("ras", АдресRAS);
	Если ЗначениеЗаполнено(ИмяСервиса) Тогда
		Секция.Вставить("service-name", ИмяСервиса);
	КонецЕсли;
	Возврат Секция;
КонецФункции

Функция НоваяПоделка(СекцияКластера = Неопределено, ИмяСервисаДанных = "", СЖурналами = Истина,
	ЧасовойПояс = "Etc/UTC", ЧасовойПоясЖурналаРегистрации = "") Экспорт

	ИсточникиДанных = Новый Соответствие;
	ИсточникиДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	СекцияData = Новый Соответствие;
	СекцияData.Вставить("ИсточникиДанных", ИсточникиДанных);

	ТехнологическийЖурнал = Новый Соответствие;
	ТехнологическийЖурнал.Вставить("path", КаталогТЖ);
	ТехнологическиеЖурналы = Новый Массив;
	ТехнологическиеЖурналы.Добавить(ТехнологическийЖурнал);

	ЖурналРегистрации = Новый Соответствие;
	ЖурналРегистрации.Вставить("path", КаталогЖР);
	ЖурналРегистрации.Вставить("infobase", "erp");
	Если ЗначениеЗаполнено(ЧасовойПоясЖурналаРегистрации) Тогда
		ЖурналРегистрации.Вставить("timezone", ЧасовойПоясЖурналаРегистрации);
	КонецЕсли;
	ЖурналыРегистрации = Новый Массив;
	ЖурналыРегистрации.Добавить(ЖурналРегистрации);

	СекцияЖурналов = Новый Соответствие;
	Если СЖурналами Тогда
		СекцияЖурналов.Вставить("techlog", ТехнологическиеЖурналы);
		СекцияЖурналов.Вставить("eventlog", ЖурналыРегистрации);
	КонецЕсли;
	СекцияЖурналов.Вставить("timezone", ЧасовойПояс);
	Если СекцияКластера <> Неопределено Тогда
		СекцияЖурналов.Вставить("cluster", СекцияКластера);
	КонецЕсли;
	Если ЗначениеЗаполнено(ИмяСервисаДанных) Тогда
		СекцияЖурналов.Вставить("service", Новый Соответствие);
		СекцияЖурналов["service"].Вставить("name", ИмяСервисаДанных);
	КонецЕсли;

	СекцияOtel = Новый Соответствие;
	Для Каждого Сигнал Из СтрРазделить("traces,metrics,logs", ",") Цикл
		Экспортер = Новый Соответствие;
		Экспортер.Вставить("exporter", "none");
		СекцияOtel.Вставить(Сигнал, Экспортер);
	КонецЦикла;
	СекцияOtel.Вставить("v8-logs", СекцияЖурналов);

	Детальки = Новый Соответствие;
	Детальки.Вставить("data", СекцияData);
	Детальки.Вставить("otel", СекцияOtel);

	Совет = Новый СоветДругогоМастера;
	Строитель = Совет.ПолучитьСтроительМенеджераПараметров();
	Строитель.ОчиститьПровайдеры();
	Строитель.ДобавитьПровайдерСоответствие(Детальки);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	Возврат Поделка;

КонецФункции

// Пишет в каталоги по файлу технологического журнала (два события) и журнала регистрации (одна запись).
Процедура ДописатьЖурналы() Экспорт
	Дописать(ОбъединитьПути(КаталогТЖ, "rphost_1", "26102009.log"),
		Символ(65279) + "05:12.000001-15,CALL,1" + ПС + "05:13.000001-1,EXCP,1,Descr=ошибка" + ПС);
	Дописать(ОбъединитьПути(КаталогЖР, "1Cv8.lgf"),
		Символ(65279) + "1CV8LOG(ver 2.0)" + ПС + "guid" + ПС + ПС + "{4,""_$Session$_.Start"",1}");
	Дописать(ОбъединитьПути(КаталогЖР, "20251020000000.lgp"),
		Символ(65279) + "1CV8LOG(ver 2.0)" + ПС + "guid" + ПС + ПС
		+ "{20251020090512,N,{0,0},0,0,0,1,1,I,""начало"",0,{""U""},"""",0,0,0,1,0,{0}}");
КонецПроцедуры

Функция ПолныйПуть(Каталог, Путь1, Путь2 = "") Экспорт
	Возврат Новый Файл(ОбъединитьПути(Каталог, Путь1, Путь2)).ПолноеИмя;
КонецФункции

Функция ЗапуститьВФоне(Коллектор) Экспорт
	Параметры = Новый Массив;
	Параметры.Добавить(Ложь);
	Возврат ФоновыеЗадания.Выполнить(Коллектор, "Запустить", Параметры);
КонецФункции

Процедура ОжидатьЗавершенияБезОшибок(Задание) Экспорт
	Ожидаем.Что(Задание.ОжидатьЗавершения(10000), "запуск коллектора завершился").ЭтоИстина();
	Если Задание.ИнформацияОбОшибке <> Неопределено Тогда
		ВызватьИсключение ПодробноеПредставлениеОшибки(Задание.ИнформацияОбОшибке);
	КонецЕсли;
	Ожидаем.Что(Задание.Состояние).Равно(СостояниеФоновогоЗадания.Завершено);
КонецПроцедуры

Процедура ДождатьсяСообщений(Подстрока, Количество) Экспорт
	Граница = ТекущаяУниверсальнаяДатаВМиллисекундах() + 10000;
	Пока СообщенияЛогаС(Подстрока).Количество() < Количество
		И ТекущаяУниверсальнаяДатаВМиллисекундах() < Граница Цикл
		Приостановить(50);
	КонецЦикла;
КонецПроцедуры

// Пустое название - сообщение любого задания
Функция СообщениеЗадания(Название, Событие) Экспорт
	Если Название = "" Тогда
		Возврат """ " + Событие;
	КонецЕсли;
	Возврат СтрШаблон("Задание ""%1"" %2", Название, Событие);
КонецФункции

Функция ИменаЛоговКоллектора()
	Возврат СтрРазделить("oscript.app.opentelemetry-v8-logs.КоллекторЖурналов,"
		+ "oscript.app.opentelemetry-v8-logs.ЗаданияКоллектора", ",");
КонецФункции

Процедура Дописать(Путь, Текст)
	СоздатьКаталог(Новый Файл(Путь).Путь);
	Буфер = ПолучитьБуферДвоичныхДанныхИзСтроки(Текст, "UTF-8", Ложь);
	Поток = Новый ФайловыйПоток(Путь, РежимОткрытияФайла.ОткрытьИлиСоздать, ДоступКФайлу.Запись);
	Поток.Перейти(0, ПозицияВПотоке.Конец);
	Поток.Записать(Буфер, 0, Буфер.Размер);
	Поток.Закрыть();
КонецПроцедуры

ПС = Символы.ПС;
