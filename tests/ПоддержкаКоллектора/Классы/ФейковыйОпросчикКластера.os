// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
// Фейк опросчика кластера: отдаёт заданный снимок или бросает заданное исключение,
// помнит пороги и учётные данные баз, с которыми создан опросчик.

Перем ТекущийСнимок;
Перем ТекстИсключения;
Перем ПорогиОпросчика;
Перем УчётныеДанныеОпросчика;

Функция ОтдаватьСнимок(Доступен, Ошибка = "") Экспорт
	ТекущийСнимок = Новый Структура("Время, Доступен, Ошибка, Показатели, Сеансы, Предупреждения",
		ТекущаяУниверсальнаяДата(), Доступен, Ошибка, Новый Массив, Новый Массив, Новый Массив);
	ТекстИсключения = "";
	Возврат ТекущийСнимок;
КонецФункции

Функция ОтдаватьПредупреждения(Предупреждения) Экспорт
	ТекущийСнимок = ОтдаватьСнимок(Истина);
	Для Каждого Предупреждение Из Предупреждения Цикл
		ТекущийСнимок.Предупреждения.Добавить(Предупреждение);
	КонецЦикла;
	Возврат ТекущийСнимок;
КонецФункции

Процедура БросатьИсключение(Текст) Экспорт
	ТекстИсключения = Текст;
КонецПроцедуры

Процедура Создан(ПорогиДлительностиСек, УчётныеДанныеБаз) Экспорт
	ПорогиОпросчика = ПорогиДлительностиСек;
	УчётныеДанныеОпросчика = УчётныеДанныеБаз;
КонецПроцедуры

Функция Пороги() Экспорт
	Возврат ПорогиОпросчика;
КонецФункции

Функция УчётныеДанныеБаз() Экспорт
	Возврат УчётныеДанныеОпросчика;
КонецФункции

Функция Снять() Экспорт
	Если ЗначениеЗаполнено(ТекстИсключения) Тогда
		ВызватьИсключение ТекстИсключения;
	КонецЕсли;
	Возврат ТекущийСнимок;
КонецФункции

ОтдаватьСнимок(Истина);
