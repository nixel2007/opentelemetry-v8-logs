&Пластилин
Перем ЗапросыHTTPТехнологическогоЖурнала;

Перем ПС;

&Тест
Процедура МаршрутHTTPСервисаБезШаблонаДоКорня() Экспорт

	// Дано
	Запрос = Запрос("GET", "/hs/mini/boom", "1C-BaseLocation: http://localhost/vrsmin");

	// Когда
	Маршрут = ЗапросыHTTPТехнологическогоЖурнала.Маршрут(Запрос);

	// Тогда
	Ожидаем.Что(Маршрут).Равно("/vrsmin/hs/mini/*");

КонецПроцедуры

&Тест
Процедура МаршрутHTTPСервисаПоШаблонуИзНастройки() Экспорт

	// Дано
	ЗапросыHTTPТехнологическогоЖурнала.ДобавитьШаблоныМаршрутов("/hs/dt/download/{ID}, /hs/dt/volume/{VolumeID}/*");
	Скачивание = Запрос("GET", "/hs/dt/download/6f1c?x=1", "1C-BaseLocation: http://localhost/erp/");
	Том = Запрос("POST", "/hs/dt/volume/12/a/b", "1C-BaseLocation: http://localhost/erp/");
	Хранилище = Запрос("GET", "/hs/dt/storage/s/1", "1C-BaseLocation: http://localhost/erp/");

	// Тогда
	Ожидаем.Что(ЗапросыHTTPТехнологическогоЖурнала.Маршрут(Скачивание)).Равно("/erp/hs/dt/download/{ID}");
	Ожидаем.Что(ЗапросыHTTPТехнологическогоЖурнала.Маршрут(Том)).Равно("/erp/hs/dt/volume/{VolumeID}/*");
	Ожидаем.Что(ЗапросыHTTPТехнологическогоЖурнала.Маршрут(Хранилище)).Равно("/erp/hs/dt/*");

КонецПроцедуры

&Тест
Процедура ШаблонHTTPСервисаНеЗависитОтРегистраИЗавершающейКосойЧерты() Экспорт

	// Дано
	ЗапросыHTTPТехнологическогоЖурнала.ДобавитьШаблоныМаршрутов("/hs/loyaltyservice/ping/");
	Запрос = Запрос("GET", "/hs/LoyaltyService/ping", "1C-BaseLocation: http://localhost/erp");

	// Тогда
	Ожидаем.Что(ЗапросыHTTPТехнологическогоЖурнала.Маршрут(Запрос)).Равно("/erp/hs/loyaltyservice/ping/");

КонецПроцедуры

&Тест
Процедура МаршрутВебСервисаСОперациейИзSOAPAction() Экспорт

	// Дано - IIS передает в URI адрес клиента, а исходный адрес описания - в 1C-OriginalLocation
	Запрос = Запрос("POST", "/ws/Ping",
		"1C-OriginalLocation: http://localhost/vrsfile/ws/ping.1cws",
		"1C-BaseLocation: http://localhost/vrsfile",
		"SOAPAction: ""http://localhost/ping#Ping:Ping""");

	// Тогда
	Ожидаем.Что(ЗапросыHTTPТехнологическогоЖурнала.Маршрут(Запрос)).Равно("/vrsfile/ws/ping.1cws/Ping");

КонецПроцедуры

&Тест
Процедура МаршрутОписанияВебСервисаБезОперации() Экспорт

	// Дано
	Запрос = Запрос("GET", "/ws/ping.1cws?wsdl",
		"1C-OriginalLocation: http://localhost:8314/vrsfile/ws/ping.1cws?wsdl",
		"1C-BaseLocation: http://localhost:8314/vrsfile/");

	// Тогда
	Ожидаем.Что(ЗапросыHTTPТехнологическогоЖурнала.Маршрут(Запрос)).Равно("/vrsfile/ws/ping.1cws");

КонецПроцедуры

&Тест
Процедура МаршрутOData() Экспорт

	// Дано
	Сущность = Запрос("PUT",
		"/odata/standard.odata/Catalog_Номенклатура(guid'00000000-0000-0000-0000-000000000001')/Товары",
		"1C-BaseLocation: http://localhost:8314/demo/");
	Метаданные = Запрос("GET", "/odata/standard.odata/$metadata", "1C-BaseLocation: http://localhost:8314/demo/");
	Корень = Запрос("GET", "/odata/standard.odata", "1C-BaseLocation: http://localhost:8314/demo/");

	// Тогда
	Ожидаем.Что(ЗапросыHTTPТехнологическогоЖурнала.Маршрут(Сущность))
		.Равно("/demo/odata/standard.odata/Catalog_Номенклатура");
	Ожидаем.Что(ЗапросыHTTPТехнологическогоЖурнала.Маршрут(Метаданные)).Равно("/demo/odata/standard.odata/$metadata");
	Ожидаем.Что(ЗапросыHTTPТехнологическогоЖурнала.Маршрут(Корень)).Равно("/demo/odata/standard.odata");

КонецПроцедуры

&Тест
Процедура МаршрутКлиентскогоПротоколаДоДвухСегментов() Экспорт

	// Дано
	Команды = Запрос("GET", "/e1cib/cmi/commands?subtree=false", "1C-BaseLocation: http://localhost/vrsmin");
	Вход = Запрос("POST", "/e1cib/login?version=8.5", "1C-BaseLocation: http://localhost/vrsmin");
	Форма = Запрос("GET", "/e1cib/logForm/id/123", "1C-BaseLocation: http://localhost/vrsmin");

	// Тогда
	Ожидаем.Что(ЗапросыHTTPТехнологическогоЖурнала.Маршрут(Команды)).Равно("/vrsmin/e1cib/cmi/commands");
	Ожидаем.Что(ЗапросыHTTPТехнологическогоЖурнала.Маршрут(Вход)).Равно("/vrsmin/e1cib/login");
	Ожидаем.Что(ЗапросыHTTPТехнологическогоЖурнала.Маршрут(Форма)).Равно("/vrsmin/e1cib/logForm/id");

КонецПроцедуры

&Тест
Процедура МаршрутСтатикиИПрочихАдресов() Экспорт

	// Дано
	Статика = Запрос("GET", "/e1csys/basic/_grid.zip?sysver=8.5", "1C-BaseLocation: http://localhost/vrsmin");
	СтатикаБезГруппы = Запрос("GET", "/e1csys/_grid.zip", "1C-BaseLocation: http://localhost/vrsmin");
	Прочее = Запрос("GET", "/favicon.ico", "1C-BaseLocation: http://localhost/vrsmin");

	// Тогда - группа ресурсов платформы остается, имя файла - нет
	Ожидаем.Что(ЗапросыHTTPТехнологическогоЖурнала.Маршрут(Статика)).Равно("/vrsmin/e1csys/basic/*");
	Ожидаем.Что(ЗапросыHTTPТехнологическогоЖурнала.Маршрут(СтатикаБезГруппы)).Равно("/vrsmin/e1csys/*");
	Ожидаем.Что(ЗапросыHTTPТехнологическогоЖурнала.Маршрут(Прочее)).Равно("/vrsmin/*");

КонецПроцедуры

&Тест
Процедура ПубликацияТонкогоКлиентаНапрямуюИБезЗаголовка() Экспорт

	// Дано - тонкий клиент напрямую к ibsrv и запрос без заголовка публикации
	Напрямую = Запрос("POST", "/e1cib/login", "1C-BaseLocation: e1c://server/localhost/vrsfile");
	БезПубликации = Запрос("POST", "/e1cib/login");

	// Тогда
	Ожидаем.Что(ЗапросыHTTPТехнологическогоЖурнала.Маршрут(Напрямую)).Равно("/vrsfile/e1cib/login");
	Ожидаем.Что(ЗапросыHTTPТехнологическогоЖурнала.Маршрут(БезПубликации)).Равно("/e1cib/login");

КонецПроцедуры

&Тест
Процедура АтрибутыЗапросаИОтвета() Экспорт

	// Дано
	Запрос = Запрос("GET", "/hs/mini/hello?name=1",
		"Host: localhost:8314",
		"User-Agent: curl/8.0.0",
		"X-Forwarded-For: 10.0.0.5, 10.0.0.1",
		"1C-OriginalLocation: https://localhost:8314/vrsfile/hs/mini/hello?name=1",
		"1C-BaseLocation: https://localhost:8314/vrsfile/");
	Ответ = Ответ("200");

	// Когда
	Атрибуты = ЗапросыHTTPТехнологическогоЖурнала.АтрибутыЗапроса(Запрос, Ответ);

	// Тогда
	Ожидаем.Что(Атрибуты["http.request.method"]).Равно("GET");
	Ожидаем.Что(Атрибуты["url.path"]).Равно("/hs/mini/hello");
	Ожидаем.Что(Атрибуты["url.query"]).Равно("name=1");
	Ожидаем.Что(Атрибуты["url.scheme"]).Равно("https");
	Ожидаем.Что(Атрибуты["server.address"]).Равно("localhost");
	Ожидаем.Что(Атрибуты["server.port"]).Равно(8314);
	Ожидаем.Что(Атрибуты["client.address"]).Равно("10.0.0.5");
	Ожидаем.Что(Атрибуты["user_agent.original"]).Равно("curl/8.0.0");
	Ожидаем.Что(Атрибуты["http.response.status_code"]).Равно(200);
	Ожидаем.Что(Атрибуты["v8.http.route"]).Равно("/vrsfile/hs/mini/*");
	Ожидаем.Что(Атрибуты["error.type"]).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ОшибкаСервераДаетТипОшибки() Экспорт

	// Дано
	Запрос = Запрос("GET", "/hs/mini/boom", "Host: localhost");

	// Когда
	Сервер = ЗапросыHTTPТехнологическогоЖурнала.АтрибутыЗапроса(Запрос, Ответ("500"));
	Клиент = ЗапросыHTTPТехнологическогоЖурнала.АтрибутыЗапроса(Запрос, Ответ("404"));

	// Тогда - по semconv HTTP-сервера ошибка - только 5xx
	Ожидаем.Что(Сервер["error.type"]).Равно("500");
	Ожидаем.Что(Клиент["error.type"]).Равно(Неопределено);
	Ожидаем.Что(Сервер["server.port"]).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура НеизвестныйМетодЗаменяетсяНаДругой() Экспорт

	// Дано
	Запрос = Запрос("PROPFIND", "/hs/mini/hello");

	// Когда
	Атрибуты = ЗапросыHTTPТехнологическогоЖурнала.АтрибутыЗапроса(Запрос, Неопределено);

	// Тогда
	Ожидаем.Что(Атрибуты["http.request.method"]).Равно("_OTHER");
	Ожидаем.Что(Атрибуты["http.request.method_original"]).Равно("PROPFIND");
	Ожидаем.Что(Атрибуты["http.response.status_code"]).Равно(Неопределено);

КонецПроцедуры

Функция Запрос(Метод, URI, Заголовок1 = "", Заголовок2 = "", Заголовок3 = "", Заголовок4 = "", Заголовок5 = "")
	Заголовки = Новый Массив;
	Для Каждого Заголовок Из СтрРазделить(СтрШаблон("%1|%2|%3|%4|%5",
			Заголовок1, Заголовок2, Заголовок3, Заголовок4, Заголовок5), "|", Ложь) Цикл
		Заголовки.Добавить(Заголовок);
	КонецЦикла;
	Свойства = Новый Соответствие;
	Свойства.Вставить("Method", Метод);
	Свойства.Вставить("URI", URI);
	Если Заголовки.Количество() > 0 Тогда
		Свойства.Вставить("Headers", СтрСоединить(Заголовки, ПС));
	КонецЕсли;
	Возврат Свойства;
КонецФункции

Функция Ответ(Статус)
	Свойства = Новый Соответствие;
	Свойства.Вставить("Status", Статус);
	Возврат Свойства;
КонецФункции

ПС = Символы.ПС;
