// BSLLS:MagicNumber-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
#Использовать ".."
#Использовать asserts
#Использовать opentelemetry

Перем ПС;
Перем ТранспортСпанов;
Перем ТранспортЛогов;
Перем ПровайдерТрассировки;
Перем ПровайдерЛогов;
Перем ПровайдерМетрик;

&ПередКаждым
Процедура Подготовить() Экспорт
	Ресурс = Новый ОтелРесурс(Истина, , Истина);
	ТранспортСпанов = Новый ОтелВПамятьТранспорт;
	ПровайдерТрассировки = Новый ОтелПровайдерТрассировки(Ресурс,
		Новый ОтелПростойПроцессорСпанов(Новый ОтелЭкспортерСпанов(ТранспортСпанов)));
	ТранспортЛогов = Новый ОтелВПамятьТранспорт;
	ПровайдерЛогов = Новый ОтелПровайдерЛогирования(Ресурс,
		Новый ОтелПростойПроцессорЛогов(Новый ОтелЭкспортерЛогов(ТранспортЛогов)));
	ПровайдерМетрик = Новый ОтелПровайдерМетрик(Ресурс);
КонецПроцедуры

&ПослеКаждого
Процедура Закрыть() Экспорт
	ПровайдерТрассировки.Закрыть();
	ПровайдерЛогов.Закрыть();
	ПровайдерМетрик.Закрыть();
КонецПроцедуры

&Тест
Процедура ВызовСВложеннымиСобытиямиСтановитсяТрассой() Экспорт

	// Дано - события пишутся по окончании: вложенные раньше вызова
	События = СобытияИзТекста(
		  "05:12.100000-20000,DBMSSQL,2,OSThread=7,Sql=SELECT 1" + ПС
		+ "05:12.300000-10000,SDBL,2,OSThread=7,Func=Select" + ПС
		+ "05:12.500000-500000,CALL,1,OSThread=7,Usr=Admin" + ПС);

	// Когда
	Экспортер().ОбработатьСобытияТехЖурнала(События, ОписаниеФайла());

	// Тогда
	Спаны = Спаны();
	Ожидаем.Что(Спаны).ИмеетДлину(3);
	Вызов = НайтиСпан(Спаны, "CALL");
	Запрос = НайтиСпан(Спаны, "DBMSSQL");
	Платформенный = НайтиСпан(Спаны, "SDBL");

	Ожидаем.Что(ЗначениеЗаполнено(Вызов["parentSpanId"])).ЭтоЛожь();
	Ожидаем.Что(Запрос["traceId"]).Равно(Вызов["traceId"]);
	Ожидаем.Что(Запрос["parentSpanId"]).Равно(Вызов["spanId"]);
	Ожидаем.Что(Платформенный["parentSpanId"]).Равно(Вызов["spanId"]);

	// 2026-10-20 09:05:12.5 UTC минус 0.5 с
	Ожидаем.Что(Вызов["startTimeUnixNano"]).Равно("1792487112000000000");
	Ожидаем.Что(Вызов["endTimeUnixNano"]).Равно("1792487112500000000");
	Ожидаем.Что(Запрос["startTimeUnixNano"]).Равно("1792487112080000000");

	Ожидаем.Что(Атрибуты(Вызов)["onec.techlog.Usr"]).Равно("Admin");
	Ожидаем.Что(Атрибуты(Запрос)["db.system.name"]).Равно("microsoft.sql_server");
	Ожидаем.Что(Запрос["kind"]).Равно(3);

КонецПроцедуры

&Тест
Процедура РодительВложенногоСобытияБлижайшийОхватывающий() Экспорт

	// Дано - DBMSSQL внутри SDBL внутри CALL
	События = СобытияИзТекста(
		  "05:12.100000-20000,DBMSSQL,3,OSThread=7" + ПС
		+ "05:12.150000-100000,SDBL,2,OSThread=7" + ПС
		+ "05:12.500000-500000,CALL,1,OSThread=7" + ПС);

	// Когда
	Экспортер().ОбработатьСобытияТехЖурнала(События, ОписаниеФайла());

	// Тогда
	Спаны = Спаны();
	Ожидаем.Что(НайтиСпан(Спаны, "DBMSSQL")["parentSpanId"]).Равно(НайтиСпан(Спаны, "SDBL")["spanId"]);
	Ожидаем.Что(НайтиСпан(Спаны, "SDBL")["parentSpanId"]).Равно(НайтиСпан(Спаны, "CALL")["spanId"]);

КонецПроцедуры

&Тест
Процедура СобытияДругогоПотокаИДоНачалаВызоваНеВходятВТрассу() Экспорт

	// Дано
	События = СобытияИзТекста(
		  "05:11.000000-1000,DBMSSQL,2,OSThread=7" + ПС
		+ "05:12.100000-1000,DBMSSQL,2,OSThread=8" + ПС
		+ "05:12.200000-1000,SDBL,2,OSThread=7" + ПС
		+ "05:12.500000-500000,CALL,1,OSThread=7" + ПС);

	// Когда
	Экспортер().ОбработатьСобытияТехЖурнала(События, ОписаниеФайла());

	// Тогда
	Спаны = Спаны();
	Ожидаем.Что(Спаны).ИмеетДлину(2);
	НайтиСпан(Спаны, "CALL");
	НайтиСпан(Спаны, "SDBL");

КонецПроцедуры

&Тест
Процедура ВложенныеСобытияИзПредыдущейПорцииВходятВТрассу() Экспорт

	// Дано
	Экспортер = Экспортер();
	Экспортер.ОбработатьСобытияТехЖурнала(СобытияИзТекста("05:12.100000-1000,DBMSSQL,2,OSThread=7" + ПС),
		ОписаниеФайла());

	// Когда
	Экспортер.ОбработатьСобытияТехЖурнала(СобытияИзТекста("05:12.500000-500000,CALL,1,OSThread=7" + ПС),
		ОписаниеФайла());

	// Тогда
	Спаны = Спаны();
	Ожидаем.Что(Спаны).ИмеетДлину(2);
	Ожидаем.Что(НайтиСпан(Спаны, "DBMSSQL")["parentSpanId"]).Равно(НайтиСпан(Спаны, "CALL")["spanId"]);

КонецПроцедуры

&Тест
Процедура ИсключениеСтановитсяСобытиемСпана() Экспорт

	// Дано
	События = СобытияИзТекста(
		  "05:12.200000-0,EXCP,2,OSThread=7,Exception=DataBaseException,Descr='Деление на 0'" + ПС
		+ "05:12.500000-500000,CALL,1,OSThread=7" + ПС);

	// Когда
	Экспортер().ОбработатьСобытияТехЖурнала(События, ОписаниеФайла());

	// Тогда
	Спаны = Спаны();
	Ожидаем.Что(Спаны).ИмеетДлину(1);
	СобытияСпана = Спаны[0]["events"];
	Ожидаем.Что(СобытияСпана).ИмеетДлину(1);
	Ожидаем.Что(СобытияСпана[0]["name"]).Равно("exception");
	Ожидаем.Что(СобытияСпана[0]["timeUnixNano"]).Равно("1792487112200000000");
	Атрибуты = Атрибуты(СобытияСпана[0]);
	Ожидаем.Что(Атрибуты["exception.message"]).Равно("Деление на 0");
	Ожидаем.Что(Атрибуты["exception.type"]).Равно("DataBaseException");

КонецПроцедуры

&Тест
Процедура ЗаписьЛогаВызоваСвязанаСТрассой() Экспорт

	// Дано
	События = СобытияИзТекста(
		  "05:12.100000-1000,DBMSSQL,2,OSThread=7" + ПС
		+ "05:12.500000-500000,CALL,1,OSThread=7" + ПС);

	// Когда
	Экспортер().ОбработатьСобытияТехЖурнала(События, ОписаниеФайла());

	// Тогда
	Вызов = НайтиСпан(Спаны(), "CALL");
	ЗаписьВызова = ЗаписиЛога()[1];
	Ожидаем.Что(ЗаписьВызова["traceId"]).Равно(Вызов["traceId"]);
	Ожидаем.Что(ЗаписьВызова["spanId"]).Равно(Вызов["spanId"]);

КонецПроцедуры

&Тест
Процедура БезТрассировщикаСпаныНеСоздаются() Экспорт

	// Дано
	События = СобытияИзТекста("05:12.500000-500000,CALL,1,OSThread=7" + ПС);
	Параметры = Новый Структура("ЧасовойПояс", "Etc/UTC");
	Экспортер = Новый ЭкспортерТехЖурнала(ПровайдерЛогов.ПолучитьЛоггер("test"),
		ПровайдерМетрик.ПолучитьМетр("test"), Неопределено, Параметры);

	// Когда
	Экспортер.ОбработатьСобытияТехЖурнала(События, ОписаниеФайла());

	// Тогда
	Ожидаем.Что(Спаны()).ИмеетДлину(0);
	Ожидаем.Что(ЗаписиЛога()).ИмеетДлину(1);

КонецПроцедуры

&Тест
Процедура КорневыеСобытияИзПараметров() Экспорт

	// Дано
	События = СобытияИзТекста(
		  "05:12.100000-1000,DBMSSQL,2,OSThread=7" + ПС
		+ "05:12.500000-500000,CALL,1,OSThread=7" + ПС);
	Параметры = Новый Структура("ЧасовойПояс, КорневыеСобытия", "Etc/UTC", "SDBL");

	// Когда
	Экспортер(Параметры).ОбработатьСобытияТехЖурнала(События, ОписаниеФайла());

	// Тогда
	Ожидаем.Что(Спаны()).ИмеетДлину(0);

КонецПроцедуры

Функция Экспортер(Параметры = Неопределено)
	Если Параметры = Неопределено Тогда
		Параметры = Новый Структура("ЧасовойПояс", "Etc/UTC");
	КонецЕсли;
	Возврат Новый ЭкспортерТехЖурнала(ПровайдерЛогов.ПолучитьЛоггер("test"), ПровайдерМетрик.ПолучитьМетр("test"),
		ПровайдерТрассировки.ПолучитьТрассировщик("test"), Параметры);
КонецФункции

Функция СобытияИзТекста(Текст)
	Возврат ПарсерТехЖурнала.Разобрать(Текст, Дата(2026, 10, 20, 9, 0, 0)).События;
КонецФункции

Функция ОписаниеФайла()
	Описание = Новый Структура;
	Описание.Вставить("Путь", "/var/log/1c/rphost_1234/26102009.log");
	Описание.Вставить("Каталог", "/var/log/1c");
	Описание.Вставить("Процесс", "rphost");
	Описание.Вставить("ИдПроцесса", "1234");
	Описание.Вставить("ДатаЧаса", Дата(2026, 10, 20, 9, 0, 0));
	Возврат Описание;
КонецФункции

Функция Спаны()
	Результат = Новый Массив;
	Для Каждого Отправка Из ТранспортСпанов.ПолучитьОтправленные() Цикл
		Для Каждого РесурсныеСпаны Из Отправка["Данные"]["resourceSpans"] Цикл
			Для Каждого СпаныОбласти Из РесурсныеСпаны["scopeSpans"] Цикл
				Для Каждого Спан Из СпаныОбласти["spans"] Цикл
					Результат.Добавить(Спан);
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция НайтиСпан(Спаны, Имя)
	Для Каждого Спан Из Спаны Цикл
		Если Спан["name"] = Имя Тогда
			Возврат Спан;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "Не найден спан " + Имя;
КонецФункции

Функция ЗаписиЛога()
	Результат = Новый Массив;
	Для Каждого Отправка Из ТранспортЛогов.ПолучитьОтправленные() Цикл
		Для Каждого РесурсныеЛоги Из Отправка["Данные"]["resourceLogs"] Цикл
			Для Каждого ЛогиОбласти Из РесурсныеЛоги["scopeLogs"] Цикл
				Для Каждого Запись Из ЛогиОбласти["logRecords"] Цикл
					Результат.Добавить(Запись);
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Атрибуты OTLP в виде соответствия ключ -> строковое представление значения
Функция Атрибуты(Объект)
	Результат = Новый Соответствие;
	Если Объект["attributes"] = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Атрибут Из Объект["attributes"] Цикл
		Значение = Атрибут["value"];
		Для Каждого Вид Из Значение Цикл
			Результат.Вставить(Атрибут["key"], Строка(Вид.Значение));
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

ПС = Символы.ПС;
