	// Когда
	Экспортер().ОбработатьЗаписиЖурналаРегистрации(МассивИз(Запись), ОписаниеЖурнала());

	// Тогда - у события пользователя представления нет, в теле и атрибуте идентификатор
	Ожидаем.Что(ЗаписиЛога()[0]["body"]["stringValue"]).Равно("otel.test | test test test...");
	Ожидаем.Что(Атрибуты(ЗаписиЛога()[0])["v8.eventlog.event.presentation"]).Равно("otel.test");

