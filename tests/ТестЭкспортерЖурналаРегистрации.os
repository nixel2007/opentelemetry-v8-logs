// BSLLS:MagicNumber-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
#Использовать ".."
#Использовать asserts
#Использовать opentelemetry

Перем ТранспортЛогов;
Перем ТранспортМетрик;
Перем ПровайдерЛогов;
Перем ПровайдерМетрик;

&ПередКаждым
Процедура Подготовить() Экспорт
	Ресурс = Новый ОтелРесурс(Истина, , Истина);
	ТранспортЛогов = Новый ОтелВПамятьТранспорт;
	ПровайдерЛогов = Новый ОтелПровайдерЛогирования(Ресурс,
		Новый ОтелПростойПроцессорЛогов(Новый ОтелЭкспортерЛогов(ТранспортЛогов)));
	ТранспортМетрик = Новый ОтелВПамятьТранспорт;
	ПровайдерМетрик = Новый ОтелПровайдерМетрик(Ресурс,
		Новый ОтелПериодическийЧитательМетрик(Новый ОтелЭкспортерМетрик(ТранспортМетрик), 3600000));
КонецПроцедуры

&ПослеКаждого
Процедура Закрыть() Экспорт
	ПровайдерЛогов.Закрыть();
	ПровайдерМетрик.Закрыть();
КонецПроцедуры

&Тест
Процедура ЗаписьЖурналаСтановитсяЗаписьюЛога() Экспорт

	// Дано
	Запись = ЗаписьЖурнала();

	// Когда
	Экспортер().ОбработатьЗаписиЖурналаРегистрации(МассивИз(Запись), ОписаниеЖурнала());

	// Тогда
	Записи = ЗаписиЛога();
	Ожидаем.Что(Записи).ИмеетДлину(1);
	ЗаписьЛога = Записи[0];
	Ожидаем.Что(ЗаписьЛога["timeUnixNano"]).Равно("1747495184000000000");
	Ожидаем.Что(ЗаписьЛога["severityNumber"]).Равно(17);
	Ожидаем.Что(ЗаписьЛога["body"]["stringValue"]).Равно("Не удалось провести документ");

	Атрибуты = Атрибуты(ЗаписьЛога);
	Ожидаем.Что(Атрибуты["onec.eventlog.event"]).Равно("_$Data$_.Post");
	Ожидаем.Что(Атрибуты["onec.infobase.name"]).Равно("erp");
	Ожидаем.Что(Атрибуты["user.name"]).Равно("Администратор");
	Ожидаем.Что(Атрибуты["user.id"]).Равно("8368e8b0-9829-4ae2-92bd-8d4ddd658d9a");
	Ожидаем.Что(Атрибуты["onec.eventlog.computer"]).Равно("COMP");
	Ожидаем.Что(Атрибуты["onec.eventlog.application"]).Равно("1CV8C");
	Ожидаем.Что(Атрибуты["onec.eventlog.connection"]).Равно("57");
	Ожидаем.Что(Атрибуты["onec.eventlog.session"]).Равно("8");
	Ожидаем.Что(Атрибуты["onec.eventlog.transaction.status"]).Равно("committed");
	Ожидаем.Что(Атрибуты["onec.eventlog.transaction.status_code"]).Равно("C");
	Ожидаем.Что(Атрибуты["onec.eventlog.transaction.id"]).Равно("4800");
	Ожидаем.Что(Атрибуты["onec.eventlog.metadata"]).Равно("Документ.Реализация");
	Ожидаем.Что(Атрибуты["onec.eventlog.metadata.uuid"]).Равно("2f25c58f-e234-48f8-9595-35f257c52b01");
	Ожидаем.Что(Атрибуты["onec.eventlog.data"]).Равно("47:976d00d8612c645111efb1744b0ce2e8");
	Ожидаем.Что(Атрибуты["onec.eventlog.data.presentation"]).Равно("Реализация 0001 от 17.05.2025");
	Ожидаем.Что(Атрибуты["onec.eventlog.server"]).Равно("srv1c");
	Ожидаем.Что(Атрибуты["onec.eventlog.port"]).Равно("1541");
	Ожидаем.Что(Атрибуты["onec.eventlog.sync_port"]).Равно("1560");
	Ожидаем.Что(Атрибуты["onec.eventlog.data_separation.ОбластьДанныхОсновныеДанные"]).Равно("7");
	Ожидаем.Что(Атрибуты["log.file.path"]).Равно("/srv/1c/reg_1541/ib/1Cv8Log/20250517000000.lgp");

КонецПроцедуры

&Тест
Процедура ПустыеЗначенияНеСтановятсяАтрибутами() Экспорт

	// Дано
	Запись = ЗаписьЖурнала();
	Запись.Метаданные = "";
	Запись.ИдМетаданных = "";
	Запись.Сервер = "";
	Запись.ОсновнойПорт = 0;
	Запись.СтатусТранзакции = "N";
	Запись.НомерТранзакции = 0;
	Запись.РазделениеДанныхСеанса = Новый Соответствие;

	// Когда
	Экспортер().ОбработатьЗаписиЖурналаРегистрации(МассивИз(Запись), ОписаниеЖурнала());

	// Тогда
	Атрибуты = Атрибуты(ЗаписиЛога()[0]);
	Ожидаем.Что(Атрибуты["onec.eventlog.metadata"]).Равно(Неопределено);
	Ожидаем.Что(Атрибуты["onec.eventlog.server"]).Равно(Неопределено);
	Ожидаем.Что(Атрибуты["onec.eventlog.port"]).Равно(Неопределено);
	Ожидаем.Что(Атрибуты["onec.eventlog.transaction.status"]).Равно(Неопределено);
	Ожидаем.Что(Атрибуты["onec.eventlog.transaction.status_code"]).Равно(Неопределено);
	Ожидаем.Что(Атрибуты["onec.eventlog.transaction.id"]).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура СтатусыТранзакций() Экспорт

	// Дано - в журналах событие _$Transaction$_.Commit идет со статусом C, Rollback - с R,
	// значение U (у изменений данных внутри транзакции) не расшифровывается
	Записи = Новый Массив;
	Для Каждого Статус Из СтрРазделить("C,R,U", ",") Цикл
		Запись = ЗаписьЖурнала();
		Запись.СтатусТранзакции = Статус;
		Записи.Добавить(Запись);
	КонецЦикла;

	// Когда
	Экспортер().ОбработатьЗаписиЖурналаРегистрации(Записи, ОписаниеЖурнала());

	// Тогда
	ЗаписиЛога = ЗаписиЛога();
	Ожидаем.Что(Атрибуты(ЗаписиЛога[0])["onec.eventlog.transaction.status"]).Равно("committed");
	Ожидаем.Что(Атрибуты(ЗаписиЛога[1])["onec.eventlog.transaction.status"]).Равно("rolled_back");
	Ожидаем.Что(Атрибуты(ЗаписиЛога[2])["onec.eventlog.transaction.status"]).Равно(Неопределено);
	Ожидаем.Что(Атрибуты(ЗаписиЛога[2])["onec.eventlog.transaction.status_code"]).Равно("U");

КонецПроцедуры

&Тест
Процедура ТелоБезКомментарияЭтоСобытие() Экспорт

	// Дано
	Запись = ЗаписьЖурнала();
	Запись.Комментарий = "";

	// Когда
	Экспортер().ОбработатьЗаписиЖурналаРегистрации(МассивИз(Запись), ОписаниеЖурнала());

	// Тогда
	Ожидаем.Что(ЗаписиЛога()[0]["body"]["stringValue"]).Равно("_$Data$_.Post");

КонецПроцедуры

&Тест
Процедура СерьезностьПоВажности() Экспорт

	// Дано
	Записи = Новый Массив;
	Для Каждого Важность Из СтрРазделить("E,W,I,N", ",") Цикл
		Запись = ЗаписьЖурнала();
		Запись.Важность = Важность;
		Записи.Добавить(Запись);
	КонецЦикла;

	// Когда
	Экспортер().ОбработатьЗаписиЖурналаРегистрации(Записи, ОписаниеЖурнала());

	// Тогда
	ЗаписиЛога = ЗаписиЛога();
	Ожидаем.Что(ЗаписиЛога[0]["severityNumber"]).Равно(17);
	Ожидаем.Что(ЗаписиЛога[1]["severityNumber"]).Равно(13);
	Ожидаем.Что(ЗаписиЛога[2]["severityNumber"]).Равно(9);
	Ожидаем.Что(ЗаписиЛога[3]["severityNumber"]).Равно(5);

КонецПроцедуры

&Тест
Процедура ЗаписиСчитаютсяМетрикой() Экспорт

	// Дано
	Записи = Новый Массив;
	Записи.Добавить(ЗаписьЖурнала());
	Записи.Добавить(ЗаписьЖурнала());

	// Когда
	Экспортер().ОбработатьЗаписиЖурналаРегистрации(Записи, ОписаниеЖурнала());
	ПровайдерМетрик.СброситьБуфер();

	// Тогда
	Метрика = НайтиМетрику("onec.eventlog.records");
	Точка = Метрика["sum"]["dataPoints"][0];
	Ожидаем.Что(Число(Точка["asInt"])).Равно(2);
	Атрибуты = Атрибуты(Точка);
	Ожидаем.Что(Атрибуты["onec.eventlog.event"]).Равно("_$Data$_.Post");
	Ожидаем.Что(Атрибуты["onec.eventlog.severity"]).Равно("ERROR");
	Ожидаем.Что(Атрибуты["onec.infobase.name"]).Равно("erp");
	Ожидаем.Что(Атрибуты["onec.eventlog.application"]).Равно("1CV8C");

КонецПроцедуры

Функция Экспортер()
	Параметры = Новый Структура("ЧасовойПояс", "Etc/UTC");
	Возврат Новый ЭкспортерЖурналаРегистрации(
		ПровайдерЛогов.ПолучитьЛоггер("test"), ПровайдерМетрик.ПолучитьМетр("test"), Параметры);
КонецФункции

Функция ЗаписьЖурнала()

	РазделениеДанных = Новый Соответствие;
	РазделениеДанных.Вставить("ОбластьДанныхОсновныеДанные", "7");

	Запись = Новый Структура;
	Запись.Вставить("Время", Дата(2025, 5, 17, 15, 19, 44));
	Запись.Вставить("СтатусТранзакции", "C");
	Запись.Вставить("ВремяТранзакции", Дата(2025, 5, 17, 15, 19, 43));
	Запись.Вставить("НомерТранзакции", 4800);
	Запись.Вставить("Пользователь", "Администратор");
	Запись.Вставить("ИдПользователя", "8368e8b0-9829-4ae2-92bd-8d4ddd658d9a");
	Запись.Вставить("Компьютер", "COMP");
	Запись.Вставить("Приложение", "1CV8C");
	Запись.Вставить("Соединение", 57);
	Запись.Вставить("Событие", "_$Data$_.Post");
	Запись.Вставить("Важность", "E");
	Запись.Вставить("Комментарий", "Не удалось провести документ");
	Запись.Вставить("Метаданные", "Документ.Реализация");
	Запись.Вставить("ИдМетаданных", "2f25c58f-e234-48f8-9595-35f257c52b01");
	Запись.Вставить("Данные", "47:976d00d8612c645111efb1744b0ce2e8");
	Запись.Вставить("ПредставлениеДанных", "Реализация 0001 от 17.05.2025");
	Запись.Вставить("Сервер", "srv1c");
	Запись.Вставить("ОсновнойПорт", 1541);
	Запись.Вставить("ВспомогательныйПорт", 1560);
	Запись.Вставить("Сеанс", 8);
	Запись.Вставить("РазделениеДанныхСеанса", РазделениеДанных);

	Возврат Запись;

КонецФункции

Функция ОписаниеЖурнала()
	Возврат Новый Структура("Путь, Каталог, ИнформационнаяБаза",
		"/srv/1c/reg_1541/ib/1Cv8Log/20250517000000.lgp", "/srv/1c/reg_1541/ib/1Cv8Log", "erp");
КонецФункции

Функция МассивИз(Значение)
	Результат = Новый Массив;
	Результат.Добавить(Значение);
	Возврат Результат;
КонецФункции

Функция ЗаписиЛога()
	Результат = Новый Массив;
	Для Каждого Отправка Из ТранспортЛогов.ПолучитьОтправленные() Цикл
		Для Каждого РесурсныеЛоги Из Отправка["Данные"]["resourceLogs"] Цикл
			Для Каждого ЛогиОбласти Из РесурсныеЛоги["scopeLogs"] Цикл
				Для Каждого Запись Из ЛогиОбласти["logRecords"] Цикл
					Результат.Добавить(Запись);
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция НайтиМетрику(Имя)
	Для Каждого Отправка Из ТранспортМетрик.ПолучитьОтправленные() Цикл
		Для Каждого РесурсныеМетрики Из Отправка["Данные"]["resourceMetrics"] Цикл
			Для Каждого МетрикиОбласти Из РесурсныеМетрики["scopeMetrics"] Цикл
				Для Каждого Метрика Из МетрикиОбласти["metrics"] Цикл
					Если Метрика["name"] = Имя Тогда
						Возврат Метрика;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	ВызватьИсключение "Не найдена метрика " + Имя;
КонецФункции

// Атрибуты OTLP в виде соответствия ключ -> строковое представление значения
Функция Атрибуты(Объект)
	Результат = Новый Соответствие;
	Для Каждого Атрибут Из Объект["attributes"] Цикл
		Значение = Атрибут["value"];
		Для Каждого Вид Из Значение Цикл
			Результат.Вставить(Атрибут["key"], Строка(Вид.Значение));
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции
