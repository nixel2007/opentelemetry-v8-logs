	Ожидаем.Что(Атрибуты["v8.eventlog.transaction.id"]).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура СтатусыТранзакций() Экспорт

	// Дано - в журналах событие _$Transaction$_.Commit идет со статусом C, Rollback - с R,
	// значение U (у изменений данных внутри транзакции) не расшифровывается
	Записи = Новый Массив;
	Для Каждого Статус Из СтрРазделить("C,R,U", ",") Цикл
		Запись = ЗаписьЖурнала();
		Запись.СтатусТранзакции = Статус;
		Записи.Добавить(Запись);
	КонецЦикла;

	// Когда
	Экспортер().ОбработатьЗаписиЖурналаРегистрации(Записи, ОписаниеЖурнала());

	// Тогда
	ЗаписиЛога = ЗаписиЛога();
	Ожидаем.Что(Атрибуты(ЗаписиЛога[0])["v8.eventlog.transaction.status"]).Равно("committed");
	Ожидаем.Что(Атрибуты(ЗаписиЛога[1])["v8.eventlog.transaction.status"]).Равно("rolled_back");
	Ожидаем.Что(Атрибуты(ЗаписиЛога[2])["v8.eventlog.transaction.status"]).Равно(Неопределено);
	Ожидаем.Что(Атрибуты(ЗаписиЛога[2])["v8.eventlog.transaction.status_code"]).Равно("U");

КонецПроцедуры

