&Тест
Процедура ЗаписиСчитаютсяМетрикой() Экспорт

	// Дано
	Записи = Массивы.ИзЭлементов(ЗаписьЖурнала(), ЗаписьЖурнала());

	// Когда
	Экспортер = Экспортер();
	Экспортер.ОбработатьЗаписиЖурналаРегистрации(Записи, ОписаниеЖурнала());
	Экспортер.ПодтвердитьПроход();
	Телеметрия.СброситьБуфер();

	// Тогда
	Метрика = НайтиМетрику("v8.eventlog.records");
	Точка = Метрика["sum"]["dataPoints"][0];
	Ожидаем.Что(Число(Точка["asInt"])).Равно(2);
	Атрибуты = Атрибуты(Точка);
	Ожидаем.Что(Атрибуты["v8.eventlog.event"]).Равно("_$Data$_.Post");
	Ожидаем.Что(Атрибуты["v8.eventlog.severity"]).Равно("ERROR");
	Ожидаем.Что(Атрибуты["v8.infobase.name"]).Равно("erp");
	Ожидаем.Что(Атрибуты["v8.eventlog.application"]).Равно("1CV8C");

КонецПроцедуры

&Тест
Процедура ОтмененныйПроходНеУчитываетсяВМетриках() Экспорт

	// Дано - проход с неудачной отправкой, затем повтор тех же записей
	Экспортер = Экспортер();
	Экспортер.ОбработатьЗаписиЖурналаРегистрации(МассивИз(ЗаписьЖурнала()), ОписаниеЖурнала());
	Экспортер.ОтменитьПроход();

	// Когда
	Экспортер.ОбработатьЗаписиЖурналаРегистрации(МассивИз(ЗаписьЖурнала()), ОписаниеЖурнала());
	Экспортер.ПодтвердитьПроход();
	Телеметрия.СброситьБуфер();

	// Тогда
	Точка = НайтиМетрику("v8.eventlog.records")["sum"]["dataPoints"][0];
	Ожидаем.Что(Число(Точка["asInt"])).Равно(1);

КонецПроцедуры

Функция Экспортер(ИмяСервиса = "")
	Возврат ТабакеркаЭкспортеров.Достать(Массивы.ИзЭлементов(Телеметрия, ИмяСервиса, "Etc/UTC"));
КонецФункции

// Атрибуты ресурса каждой записи лога в порядке отправки
Функция РесурсыЗаписейЛога()
	Результат = Новый Массив;
	Для Каждого Отправка Из ТранспортЛогов.ПолучитьОтправленные() Цикл
		Для Каждого РесурсныеЛоги Из Отправка["Данные"]["resourceLogs"] Цикл
			АтрибутыРесурса = Атрибуты(РесурсныеЛоги["resource"]);
			Для Каждого ЛогиОбласти Из РесурсныеЛоги["scopeLogs"] Цикл
				ОсталосьЗаписей = ЛогиОбласти["logRecords"].Количество();
				Пока ОсталосьЗаписей > 0 Цикл
					Результат.Добавить(АтрибутыРесурса);
					ОсталосьЗаписей = ОсталосьЗаписей - 1;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ЗаписьЖурнала()

	РазделениеДанных = Новый Соответствие;
	РазделениеДанных.Вставить("ОбластьДанныхОсновныеДанные", "7");

	Запись = Новый Структура;
	Запись.Вставить("Время", Дата(2025, 5, 17, 15, 19, 44));
	Запись.Вставить("СтатусТранзакции", "C");
	Запись.Вставить("ВремяТранзакции", Дата(2025, 5, 17, 15, 19, 43));
	Запись.Вставить("НомерТранзакции", 4800);
	Запись.Вставить("Пользователь", "Администратор");
	Запись.Вставить("ИдПользователя", "8368e8b0-9829-4ae2-92bd-8d4ddd658d9a");
	Запись.Вставить("Компьютер", "COMP");
	Запись.Вставить("Приложение", "1CV8C");
	Запись.Вставить("Соединение", 57);
	Запись.Вставить("Событие", "_$Data$_.Post");
	Запись.Вставить("Важность", "E");
	Запись.Вставить("Комментарий", "Не удалось провести документ");
	Запись.Вставить("Метаданные", "Документ.Реализация");
	Запись.Вставить("ИдМетаданных", "2f25c58f-e234-48f8-9595-35f257c52b01");
	Запись.Вставить("Данные", "47:976d00d8612c645111efb1744b0ce2e8");
	Запись.Вставить("ПредставлениеДанных", "Реализация 0001 от 17.05.2025");
	Запись.Вставить("Сервер", "srv1c");
	Запись.Вставить("ОсновнойПорт", 1541);
	Запись.Вставить("ВспомогательныйПорт", 1560);
	Запись.Вставить("Сеанс", 8);
	Запись.Вставить("РазделениеДанныхСеанса", РазделениеДанных);

	Возврат Запись;

КонецФункции

Функция ОписаниеЖурнала()
	Возврат Новый Структура("Путь, Каталог, ИнформационнаяБаза",
		"/srv/1c/reg_1541/ib/1Cv8Log/20250517000000.lgp", "/srv/1c/reg_1541/ib/1Cv8Log", "erp");
КонецФункции

Функция МассивИз(Значение)
	Результат = Новый Массив;
	Результат.Добавить(Значение);
	Возврат Результат;
КонецФункции

Функция ЗаписиЛога()
	Результат = Новый Массив;
	Для Каждого Отправка Из ТранспортЛогов.ПолучитьОтправленные() Цикл
		Для Каждого РесурсныеЛоги Из Отправка["Данные"]["resourceLogs"] Цикл
			Для Каждого ЛогиОбласти Из РесурсныеЛоги["scopeLogs"] Цикл
				Для Каждого Запись Из ЛогиОбласти["logRecords"] Цикл
					Результат.Добавить(Запись);
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция НайтиМетрику(Имя)
	Для Каждого Метрика Из ОтправленныеМетрики() Цикл
		Если Метрика["name"] = Имя Тогда
			Возврат Метрика;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "Не найдена метрика " + Имя;
КонецФункции

Функция ОтправленныеМетрики()
	Результат = Новый Массив;
	Для Каждого Отправка Из ТранспортМетрик.ПолучитьОтправленные() Цикл
		Для Каждого РесурсныеМетрики Из Отправка["Данные"]["resourceMetrics"] Цикл
			Для Каждого МетрикиОбласти Из РесурсныеМетрики["scopeMetrics"] Цикл
				Для Каждого Метрика Из МетрикиОбласти["metrics"] Цикл
					Результат.Добавить(Метрика);
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Атрибуты OTLP в виде соответствия ключ -> строковое представление значения
Функция Атрибуты(Объект)
	Результат = Новый Соответствие;
	Если Объект = Неопределено ИЛИ Объект["attributes"] = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Атрибут Из Объект["attributes"] Цикл
		Значение = Атрибут["value"];
		Для Каждого Вид Из Значение Цикл
			Результат.Вставить(Атрибут["key"], Строка(Вид.Значение));
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции
