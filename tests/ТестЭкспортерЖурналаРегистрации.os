&Тест
Процедура ЗаписиПроходаУчитываютсяОднимДобавлениемНаНаборАтрибутов() Экспорт

	// Дано
	Предупреждение = ЗаписьЖурнала();
	Предупреждение.Важность = "W";
	Записи = Массивы.ИзЭлементов(ЗаписьЖурнала(), Предупреждение, ЗаписьЖурнала());
	Шпион = Новый ШпионМетрик(ПровайдерЛогов);

	// Когда
	Экспортер = ТабакеркаЭкспортеров.Достать(Массивы.ИзЭлементов(Шпион, "", "Etc/UTC", Истина, Истина));
	Экспортер.ОбработатьЗаписиЖурналаРегистрации(Записи, ОписаниеЖурнала());
	Экспортер.ПодтвердитьПроход();

	// Тогда
	КоличестваПоСерьезности = Новый Соответствие;
	Для Каждого Вызов Из Шпион.Вызовы() Цикл
		Ожидаем.Что(Вызов.Инструмент).Равно("v8.eventlog.records");
		Ожидаем.Что(Вызов.Метод).Равно("Добавить");
		Ожидаем.Что(Вызов.Атрибуты.Получить("v8.eventlog.event")).Равно("_$Data$_.Post");
		Ожидаем.Что(Вызов.Атрибуты.Получить("v8.infobase.name")).Равно("erp");
		Ожидаем.Что(Вызов.Атрибуты.Получить("v8.eventlog.application")).Равно("1CV8C");
		КоличестваПоСерьезности.Вставить(Вызов.Атрибуты.Получить("v8.eventlog.severity"), Вызов.Значение);
	КонецЦикла;
	Ожидаем.Что(Шпион.Вызовы().Количество()).Равно(2);
	Ожидаем.Что(КоличестваПоСерьезности["ERROR"]).Равно(2);
	Ожидаем.Что(КоличестваПоСерьезности["WARN"]).Равно(1);

	// Подтвержденный проход больше не учитывается
	Экспортер.ПодтвердитьПроход();
	Ожидаем.Что(Шпион.Вызовы().Количество()).Равно(2);

КонецПроцедуры

&Тест
Процедура ОбрезкиПроходаУчитываютсяОднимДобавлениемНаНаборАтрибутов() Экспорт

	// Дано - две записи с обрезкой одного атрибута, разной длины
	Записи = Новый Массив;
	Для Каждого Длина Из Массивы.ИзЭлементов(3000, 2548) Цикл
		Запись = ЗаписьЖурнала();
		Запись.ПредставлениеДанных = Повтор("y", Длина);
		Записи.Добавить(Запись);
	КонецЦикла;
	Шпион = Новый ШпионМетрик(ПровайдерЛогов);

	// Когда
	Экспортер = ТабакеркаЭкспортеров.Достать(Массивы.ИзЭлементов(Шпион, "", "Etc/UTC", Истина, Истина));
	Экспортер.ОбработатьЗаписиЖурналаРегистрации(Записи, ОписаниеЖурнала());
	Экспортер.ПодтвердитьПроход();

	// Тогда - обрезки считаются количеством, байты - суммой
	Обрезки = Шпион.ВызовыИнструмента("v8.eventlog.truncated");
	Ожидаем.Что(Обрезки.Количество()).Равно(1);
	Ожидаем.Что(Обрезки[0].Значение).Равно(2);
	Ожидаем.Что(Обрезки[0].Атрибуты.Получить("v8.eventlog.truncation.attribute")).Равно("v8.eventlog.data.presentation");
	Байты = Шпион.ВызовыИнструмента("v8.eventlog.truncated.size");
	Ожидаем.Что(Байты.Количество()).Равно(1);
	Ожидаем.Что(Байты[0].Значение).Равно((3000 - 2048) + (2548 - 2048));
	Ожидаем.Что(Байты[0].Атрибуты.Получить("v8.eventlog.truncation.attribute")).Равно("v8.eventlog.data.presentation");

КонецПроцедуры

// Значения точек счетчика по цели обрезки: для тела - "body", для атрибута - его ключ
Функция ТочкиСчетчика(Имя)
	Результат = Новый Соответствие;
	Для Каждого Точка Из НайтиМетрику(Имя)["sum"]["dataPoints"] Цикл
		АтрибутыТочки = Атрибуты(Точка);
		Ключ = ?(АтрибутыТочки["v8.eventlog.truncation.target"] = "body", "body",
			АтрибутыТочки["v8.eventlog.truncation.attribute"]);
		Результат.Вставить(Ключ, Число(Точка["asInt"]));
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Ключи из атрибута v8.eventlog.truncation.attributes по алфавиту через запятую
Функция ОбрезанныеАтрибуты(Запись)
	Ключи = Новый СписокЗначений;
	Для Каждого Атрибут Из Запись["attributes"] Цикл
		Если Атрибут["key"] = "v8.eventlog.truncation.attributes" Тогда
			Для Каждого Элемент Из Атрибут["value"]["arrayValue"]["values"] Цикл
				Ключи.Добавить(Элемент["stringValue"]);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Ключи.СортироватьПоЗначению();
	Возврат СтрСоединить(Ключи.ВыгрузитьЗначения(), ",");
КонецФункции

// Строки атрибута-массива через запятую в порядке записи
Функция ЗначенияМассиваАтрибута(Запись, Ключ)
	Строки = Новый Массив;
	Для Каждого Элемент Из ЗначениеАтрибута(Запись, Ключ)["arrayValue"]["values"] Цикл
		Строки.Добавить(Элемент["stringValue"]);
	КонецЦикла;
	Возврат СтрСоединить(Строки, ",");
КонецФункции

Функция Повтор(Строка, Количество)
	Части = Новый Массив;
	Для Номер = 1 По Количество Цикл // BSLLS:UnusedLocalVariable-off
		Части.Добавить(Строка);
	КонецЦикла;
	Возврат СтрСоединить(Части);
КонецФункции

Функция РазмерUTF8(Строка)
	Возврат ПолучитьДвоичныеДанныеИзСтроки(Строка, "UTF-8").Размер();
КонецФункции

Функция Экспортер(ИмяСервиса = "", ИдСеансаВключен = Истина, ПропускатьДубли = Истина)
	Возврат ТабакеркаЭкспортеров.Достать(Массивы.ИзЭлементов(Телеметрия, ИмяСервиса, "Etc/UTC", ИдСеансаВключен,
		ПропускатьДубли));
КонецФункции

// Атрибуты ресурса каждой записи лога в порядке отправки
Функция РесурсыЗаписейЛога()
	Результат = Новый Массив;
	Для Каждого Отправка Из ТранспортЛогов.ПолучитьОтправленные() Цикл
		Для Каждого РесурсныеЛоги Из Отправка["Данные"]["resourceLogs"] Цикл
			АтрибутыРесурса = Атрибуты(РесурсныеЛоги["resource"]);
			Для Каждого ЛогиОбласти Из РесурсныеЛоги["scopeLogs"] Цикл
				ОсталосьЗаписей = ЛогиОбласти["logRecords"].Количество();
				Пока ОсталосьЗаписей > 0 Цикл
					Результат.Добавить(АтрибутыРесурса);
					ОсталосьЗаписей = ОсталосьЗаписей - 1;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ЗаписьЖурнала()

	РазделениеДанных = Новый Соответствие;
	РазделениеДанных.Вставить("ОбластьДанныхОсновныеДанные", "7");

	Запись = Новый Структура;
	Запись.Вставить("Время", Дата(2025, 5, 17, 15, 19, 44));
	Запись.Вставить("СтатусТранзакции", "C");
	Запись.Вставить("ВремяТранзакции", Дата(2025, 5, 17, 15, 19, 43));
	Запись.Вставить("НомерТранзакции", 4800);
	Запись.Вставить("Пользователь", "Администратор");
	Запись.Вставить("ИдПользователя", "8368e8b0-9829-4ae2-92bd-8d4ddd658d9a");
	Запись.Вставить("Компьютер", "COMP");
	Запись.Вставить("Приложение", "1CV8C");
	Запись.Вставить("Соединение", 57);
	Запись.Вставить("Событие", "_$Data$_.Post");
	Запись.Вставить("Важность", "E");
	Запись.Вставить("Комментарий", "Не удалось провести документ");
	Запись.Вставить("Метаданные", "Документ.Реализация");
	Запись.Вставить("ИдМетаданных", "2f25c58f-e234-48f8-9595-35f257c52b01");
	Запись.Вставить("Данные", "47:976d00d8612c645111efb1744b0ce2e8");
	Запись.Вставить("ПредставлениеДанных", "Реализация 0001 от 17.05.2025");
	Запись.Вставить("Сервер", "srv1c");
	Запись.Вставить("ОсновнойПорт", 1541);
	Запись.Вставить("ВспомогательныйПорт", 1560);
	Запись.Вставить("Сеанс", 8);
	Запись.Вставить("РазделениеДанныхСеанса", РазделениеДанных);

	Возврат Запись;

КонецФункции

Функция ОписаниеЖурнала()
	Возврат Новый Структура("Путь, Каталог, ИнформационнаяБаза",
		"/srv/1c/reg_1541/ib/1Cv8Log/20250517000000.lgp", "/srv/1c/reg_1541/ib/1Cv8Log", "erp");
КонецФункции

Функция МассивИз(Значение)
	Результат = Новый Массив;
	Результат.Добавить(Значение);
	Возврат Результат;
КонецФункции

Функция ЗаписиЛога()
	Результат = Новый Массив;
	Для Каждого Отправка Из ТранспортЛогов.ПолучитьОтправленные() Цикл
		Для Каждого РесурсныеЛоги Из Отправка["Данные"]["resourceLogs"] Цикл
			Для Каждого ЛогиОбласти Из РесурсныеЛоги["scopeLogs"] Цикл
				Для Каждого Запись Из ЛогиОбласти["logRecords"] Цикл
					Результат.Добавить(Запись);
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция НайтиМетрику(Имя)
	Для Каждого Метрика Из ОтправленныеМетрики() Цикл
		Если Метрика["name"] = Имя Тогда
			Возврат Метрика;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "Не найдена метрика " + Имя;
КонецФункции

Функция ОтправленныеМетрики()
	Результат = Новый Массив;
	Для Каждого Отправка Из ТранспортМетрик.ПолучитьОтправленные() Цикл
		Для Каждого РесурсныеМетрики Из Отправка["Данные"]["resourceMetrics"] Цикл
			Для Каждого МетрикиОбласти Из РесурсныеМетрики["scopeMetrics"] Цикл
				Для Каждого Метрика Из МетрикиОбласти["metrics"] Цикл
					Результат.Добавить(Метрика);
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Атрибуты OTLP в виде соответствия ключ -> строковое представление значения
Функция Атрибуты(Объект)
	Результат = Новый Соответствие;
	Если Объект = Неопределено ИЛИ Объект["attributes"] = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Атрибут Из Объект["attributes"] Цикл
		Значение = Атрибут["value"];
		Для Каждого Вид Из Значение Цикл
			Результат.Вставить(Атрибут["key"], Строка(Вид.Значение));
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ЗначениеАтрибута(Запись, Имя)

	Для Каждого Атрибут Из Запись["attributes"] Цикл
		Если Атрибут["key"] = Имя Тогда
			Возврат Атрибут["value"];
		КонецЕсли;
	КонецЦикла;

	ВызватьИсключение "Не найден атрибут " + Имя;

КонецФункции

// Проверяем исходные OTLP AnyValue: строки, пустые значения и вложенные коллекции
// должны сохраняться до преобразования в строковую модель конкретного приемника.
Процедура ПроверитьЗначениеOTLP(Ожидаемое, Значение)

	Если Ожидаемое = Неопределено Тогда
		Ожидаем.Что(Значение.Количество()).Равно(0);
	ИначеЕсли ТипЗнч(Ожидаемое) = Тип("Соответствие") Тогда
		Пары = Значение["kvlistValue"]["values"];
		Ожидаем.Что(Пары.Количество()).Равно(Ожидаемое.Количество());
		Ключи = Новый Массив;
		Для Каждого Пара Из Ожидаемое Цикл
			Ключи.Добавить(Пара.Ключ);
		КонецЦикла;

		Для Каждого Пара Из Пары Цикл
			Ожидаем.Что(Ключи.Найти(Пара["key"]) <> Неопределено).ЭтоИстина();
			ПроверитьЗначениеOTLP(Ожидаемое[Пара["key"]], Пара["value"]);
		КонецЦикла;
	ИначеЕсли ТипЗнч(Ожидаемое) = Тип("Массив") Тогда
		Элементы = Значение["arrayValue"]["values"];
		Ожидаем.Что(Элементы.Количество()).Равно(Ожидаемое.Количество());
		Для Индекс = 0 По Ожидаемое.ВГраница() Цикл
			ПроверитьЗначениеOTLP(Ожидаемое[Индекс], Элементы[Индекс]);
		КонецЦикла;
	Иначе
		Ожидаем.Что(Значение["stringValue"]).Равно(Ожидаемое);
	КонецЕсли;

КонецПроцедуры
