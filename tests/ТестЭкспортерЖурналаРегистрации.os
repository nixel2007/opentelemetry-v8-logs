// BSLLS:MagicNumber-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
// BSLLS:DuplicateStringLiteral-off
// BSLLS:MagicDate-off
// BSLLS:NestedFunctionInParameters-off
// BSLLS:Typo-off
#Использовать "../src/Экспорт"
#Использовать "./Поддержка"
#Использовать asserts
#Использовать opentelemetry
#Использовать collectionos

&Табакерка
&Пластилин("ТелеметрияЖурналов")
Перем ТабакеркаТелеметрии;

&Табакерка
&Пластилин("ЭкспортерЖурналаРегистрации")
Перем ТабакеркаЭкспортеров;

&Пластилин
Перем ПарсерЖурналаРегистрации;
&Пластилин
Перем ПарсерСкобочногоФормата;

Перем ТранспортЛогов;
Перем ТранспортМетрик;
Перем ПровайдерЛогов;
Перем ПровайдерТрассировки;
Перем Телеметрия;

&ПередКаждым
Процедура Подготовить() Экспорт
	Ресурс = Новый ОтелРесурс();
	ТранспортЛогов = Новый ОтелВПамятьТранспорт;
	ПровайдерЛогов = Новый ОтелПровайдерЛогирования(Ресурс,
		Новый ОтелПростойПроцессорЛогов(Новый ОтелЭкспортерЛогов(ТранспортЛогов)));
	ПровайдерТрассировки = Новый ОтелПровайдерТрассировки(Ресурс);
	ТранспортМетрик = Новый ОтелВПамятьТранспорт;
	Телеметрия = ТабакеркаТелеметрии.Достать(Массивы.ИзЭлементов(ПровайдерЛогов, ПровайдерТрассировки,
		Новый ОтелЭкспортерМетрик(ТранспортМетрик), 3600000, "1c", ""));
КонецПроцедуры

&ПослеКаждого
Процедура Закрыть() Экспорт
	Телеметрия.Закрыть();
	ПровайдерЛогов.Закрыть();
	ПровайдерТрассировки.Закрыть();
КонецПроцедуры

&Тест
Процедура ЗаписьЖурналаСтановитсяЗаписьюЛога() Экспорт

	// Дано
	Запись = ЗаписьЖурнала();

	// Когда
	Экспортер().ОбработатьЗаписиЖурналаРегистрации(МассивИз(Запись), ОписаниеЖурнала());

	// Тогда
	Записи = ЗаписиЛога();
	Ожидаем.Что(Записи).ИмеетДлину(1);
	ЗаписьЛога = Записи[0];
	Ожидаем.Что(ЗаписьЛога["timeUnixNano"]).Равно("1747495184000000000");
	Ожидаем.Что(ЗаписьЛога["severityNumber"]).Равно(17);
	Ожидаем.Что(ЗаписьЛога["body"]["stringValue"]).Равно(
		"Данные. Проведение | Документ.Реализация | Реализация 0001 от 17.05.2025 | Администратор"
		+ Символы.ПС + "Не удалось провести документ");

	// База - в ресурсе (индексируемая метка), а не в атрибутах записи
	Ресурс = РесурсыЗаписейЛога()[0];
	Ожидаем.Что(Ресурс["service.name"]).Равно("1c");
	Ожидаем.Что(Ресурс["v8.infobase.name"]).Равно("erp");

	Атрибуты = Атрибуты(ЗаписьЛога);
	Ожидаем.Что(Атрибуты["v8.eventlog.event"]).Равно("_$Data$_.Post");
	Ожидаем.Что(Атрибуты["v8.eventlog.event.presentation"]).Равно("Данные. Проведение");
	Ожидаем.Что(Атрибуты["v8.infobase.name"]).Равно(Неопределено);
	Ожидаем.Что(Атрибуты["user.name"]).Равно("Администратор");
	Ожидаем.Что(Атрибуты["user.id"]).Равно("8368e8b0-9829-4ae2-92bd-8d4ddd658d9a");
	Ожидаем.Что(Атрибуты.Получить("v8.eventlog.computer")).Равно(Неопределено);
	Ожидаем.Что(Атрибуты["client.address"]).Равно("COMP");
	Ожидаем.Что(Атрибуты["v8.eventlog.application"]).Равно("1CV8C");
	Ожидаем.Что(Атрибуты["v8.eventlog.connection"]).Равно("57");
	Ожидаем.Что(Атрибуты.Получить("v8.eventlog.session")).Равно(Неопределено);
	Ожидаем.Что(Атрибуты["session.id"]).Равно("8");
	Ожидаем.Что(Атрибуты["v8.eventlog.transaction.status"]).Равно("committed");
	Ожидаем.Что(Атрибуты["v8.eventlog.transaction.status_code"]).Равно("C");
	Ожидаем.Что(Атрибуты["v8.eventlog.transaction.id"]).Равно("4800");
	Ожидаем.Что(Атрибуты["v8.eventlog.metadata"]).Равно("Документ.Реализация");
	Ожидаем.Что(Атрибуты["v8.eventlog.metadata.uuid"]).Равно("2f25c58f-e234-48f8-9595-35f257c52b01");
	Ожидаем.Что(Атрибуты["v8.eventlog.data"]).Равно("47:976d00d8612c645111efb1744b0ce2e8");
	Ожидаем.Что(Атрибуты["v8.eventlog.data.presentation"]).Равно("Реализация 0001 от 17.05.2025");
	Ожидаем.Что(Атрибуты["v8.eventlog.server"]).Равно("srv1c");
	Ожидаем.Что(Атрибуты["v8.eventlog.port"]).Равно("1541");
	Ожидаем.Что(Атрибуты["v8.eventlog.sync_port"]).Равно("1560");
	Ожидаем.Что(Атрибуты["v8.eventlog.data_separation"]).Равно("ОбластьДанныхОсновныеДанные=7");
	Ожидаем.Что(Атрибуты["log.file.path"]).Равно("/srv/1c/reg_1541/ib/1Cv8Log/20250517000000.lgp");
	Ожидаем.Что(Атрибуты["log.file.name"]).Равно("20250517000000.lgp");

КонецПроцедуры

&Тест
Процедура РазделителиСеансаПишутсяОднимАтрибутом() Экспорт

	// Дано: два разделителя
	Запись = ЗаписьЖурнала();
	Запись.РазделениеДанныхСеанса.Вставить("Регион", "Север");

	// Когда
	Экспортер().ОбработатьЗаписиЖурналаРегистрации(МассивИз(Запись), ОписаниеЖурнала());

	// Тогда
	Атрибуты = Атрибуты(ЗаписиЛога()[0]);
	Ожидаем.Что(Атрибуты["v8.eventlog.data_separation"]).Равно("ОбластьДанныхОсновныеДанные=7, Регион=Север");

КонецПроцедуры

&Тест
Процедура РазделителиСеансаПишутсяИКлючамиВТранслите() Экспорт

	// Дано: разделитель с именем кириллицей в CamelCase и разделитель латиницей
	Запись = ЗаписьЖурнала();
	Запись.РазделениеДанныхСеанса.Вставить("Branch", "Север");

	// Когда
	Экспортер().ОбработатьЗаписиЖурналаРегистрации(МассивИз(Запись), ОписаниеЖурнала());

	// Тогда: ключ - латиница в нижнем регистре, значение как есть
	Атрибуты = Атрибуты(ЗаписиЛога()[0]);
	Ожидаем.Что(Атрибуты["v8.eventlog.data_separation.oblast_dannykh_osnovnye_dannye"]).Равно("7");
	Ожидаем.Что(Атрибуты["v8.eventlog.data_separation.branch"]).Равно("Север");
	Для Каждого Атрибут Из Атрибуты Цикл
		Ожидаем.Что(Атрибут.Ключ).Равно(ОтелУтилиты.Транслитерировать(Атрибут.Ключ));
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура РазобранныеДанныеЗаменяютЗначениеDataБезИзмененияДругойТелеметрии() Экспорт

	// Дано: одна и та же запись до и после добавления структурированного Data.
	Запись = ЗаписьЖурнала();
	Экспортер = Экспортер();
	Экспортер.ОбработатьЗаписиЖурналаРегистрации(МассивИз(Запись), ОписаниеЖурнала());
	Запись.Вставить("ДанныеJSON", "{""Name"":"""",""Enabled"":""false"",""Count"":""0""}");
	ПоляДанных = Новый Соответствие;
	ПоляДанных.Вставить("Name", "");
	ПоляДанных.Вставить("Enabled", "false");
	ПоляДанных.Вставить("Count", "0");
	Запись.Вставить("ПоляДанных", ПоляДанных);
	Экспортер.ОбработатьЗаписиЖурналаРегистрации(МассивИз(Запись), ОписаниеЖурнала());

	// Тогда: меняется только data; тело, остальные атрибуты, ресурс и метрики прежние.
	Логи = ЗаписиЛога();
	Ожидаем.Что(Логи).ИмеетДлину(2);
	Ожидаем.Что(Логи[1]["body"]["stringValue"]).Равно(Логи[0]["body"]["stringValue"]);
	Ожидаем.Что(Логи[1]["timeUnixNano"]).Равно(Логи[0]["timeUnixNano"]);
	СтарыеАтрибуты = Атрибуты(Логи[0]);
	НовыеАтрибуты = Атрибуты(Логи[1]);
	ПроверитьЗначениеOTLP(ПоляДанных, ЗначениеАтрибута(Логи[1], "v8.eventlog.data"));
	Ожидаем.Что(НовыеАтрибуты["v8.eventlog.data.json"]).Равно(Неопределено);
	Ожидаем.Что(НовыеАтрибуты.Количество()).Равно(СтарыеАтрибуты.Количество());

	Для Каждого Поле Из СтарыеАтрибуты Цикл
		Если Поле.Ключ = "v8.eventlog.data" Тогда
			Продолжить;
		КонецЕсли;

		Ожидаем.Что(НовыеАтрибуты[Поле.Ключ], Поле.Ключ).Равно(Поле.Значение);
	КонецЦикла;

	Ресурсы = РесурсыЗаписейЛога();
	Для Каждого Поле Из Ресурсы[0] Цикл
		Ожидаем.Что(Ресурсы[1][Поле.Ключ], Поле.Ключ).Равно(Поле.Значение);
	КонецЦикла;

	Экспортер.ПодтвердитьПроход();
	Телеметрия.СброситьБуфер();
	Точка = НайтиМетрику("v8.eventlog.records")["sum"]["dataPoints"][0];
	Ожидаем.Что(Число(Точка["asInt"])).Равно(2);
	Ожидаем.Что(Атрибуты(Точка).Количество()).Равно(4);
	Ожидаем.Что(Атрибуты(Точка)["v8.eventlog.data"]).Равно(Неопределено);
	Ожидаем.Что(Атрибуты(Точка)["v8.eventlog.data.json"]).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ПустойJSONСкаляраСохраняетЗначениеData() Экспорт

	Запись = ЗаписьЖурнала();
	Запись.Вставить("ДанныеJSON", "");
	Экспортер().ОбработатьЗаписиЖурналаРегистрации(МассивИз(Запись), ОписаниеЖурнала());

	Ожидаем.Что(Атрибуты(ЗаписиЛога()[0])["v8.eventlog.data"]).Равно(Запись.Данные);
	Ожидаем.Что(Атрибуты(ЗаписиЛога()[0])["v8.eventlog.data.json"]).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ВсеФормыDataПроходятОтПарсераДоАтрибутаOpenTelemetry() Экспорт

	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures", "eventlog-data.json"));
	Примеры = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();

	Экспортер = Экспортер();
	Ожидаемые = Новый Массив;
	Для Каждого Пример Из Примеры["cases"] Цикл
		Словарь = Новый СловарьЖурналаРегистрации;
		Словарь.Добавить(ПарсерСкобочногоФормата.Разобрать("{4,""" + Пример["eventCode"] + """,1}").Записи);
		Текст = "{20250517150813,N,{0,0},0,0,0,0,1,I,"""",0,"
			+ Пример["data"] + ","""",0,0,0,0,0,{0}}";
		Запись = ПарсерЖурналаРегистрации.ЗаписьЖурнала(
			ПарсерСкобочногоФормата.Разобрать(Текст).Записи[0], Словарь);

		Данные = Пример["expected"];
		Структурированные = Данные.Получить("$format") = Неопределено И Данные.Количество() > 0;
		Ожидаемые.Добавить(?(Структурированные, Данные, Запись.ДанныеJSON));
		Экспортер.ОбработатьЗаписиЖурналаРегистрации(МассивИз(Запись), ОписаниеЖурнала());
	КонецЦикла;

	Логи = ЗаписиЛога();
	Ожидаем.Что(Логи.Количество()).Равно(Ожидаемые.Количество());
	Для Индекс = 0 По Логи.ВГраница() Цикл
		Значения = Атрибуты(Логи[Индекс]);
		Ожидаем.Что(Ожидаемые[Индекс] <> "").ЭтоИстина();
		ПроверитьЗначениеOTLP(Ожидаемые[Индекс], ЗначениеАтрибута(Логи[Индекс], "v8.eventlog.data"));
		Ожидаем.Что(Значения["v8.eventlog.data.json"]).Равно(Неопределено);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура СтруктурированныйАтрибутСохраняетПустыеИНулевыеЗначения() Экспорт

	Запись = ЗаписьЖурнала();
	Поля = Новый Соответствие;
	Поля.Вставить("Empty", "");
	Поля.Вставить("Zero", 0);
	Поля.Вставить("False", Ложь);
	Поля.Вставить("Undefined", Неопределено);
	Поля.Вставить("Items", МассивИз(""));
	Запись.Вставить("ПоляДанных", Поля);
	Запись.Вставить("ДанныеJSON", "не должно передаваться");

	Экспортер().ОбработатьЗаписиЖурналаРегистрации(МассивИз(Запись), ОписаниеЖурнала());

	Значения = ЗначениеАтрибута(ЗаписиЛога()[0], "v8.eventlog.data")["kvlistValue"]["values"];
	Ожидаем.Что(Значения.Количество()).Равно(5);
	Ожидаем.Что(Значения[0]["value"]["stringValue"]).Равно("");
	Ожидаем.Что(Значения[1]["value"]["intValue"]).Равно(0);
	Ожидаем.Что(Значения[2]["value"]["boolValue"]).Равно(Ложь);
	Ожидаем.Что(Значения[3]["value"].Количество()).Равно(0);
	Ожидаем.Что(Значения[4]["value"]["arrayValue"]["values"][0]["stringValue"]).Равно("");

КонецПроцедуры

