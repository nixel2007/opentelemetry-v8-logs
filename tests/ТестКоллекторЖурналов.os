// BSLLS:MagicNumber-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
#Использовать autumn
#Использовать asserts
#Использовать tempfiles
#Использовать "../src/Коллектор"

Перем ПС;
Перем ВременныеФайлыТеста;
Перем КаталогТехнологическогоЖурнала;
Перем КаталогЖурналаРегистрации;

&ПередКаждым
Процедура Подготовить() Экспорт
	ВременныеФайлыТеста = Новый МенеджерВременныхФайлов;
	КаталогТехнологическогоЖурнала = ВременныеФайлыТеста.СоздатьКаталог();
	КаталогЖурналаРегистрации = ОбъединитьПути(ВременныеФайлыТеста.СоздатьКаталог(), "1Cv8Log");
	СоздатьКаталог(КаталогЖурналаРегистрации);
КонецПроцедуры

&ПослеКаждого
Процедура УдалитьВременныеФайлы() Экспорт
	ВременныеФайлыТеста.Удалить();
КонецПроцедуры

&Тест
Процедура ПроходЧитаетЖурналыИзНастроекИФиксируетПозиции() Экспорт

	// Дано
	Дописать(ОбъединитьПути(КаталогТехнологическогоЖурнала, "rphost_1", "26102009.log"),
		Символ(65279) + "05:12.000001-15,CALL,1" + ПС + "05:13.000001-1,EXCP,1,Descr=ошибка" + ПС);
	Дописать(ОбъединитьПути(КаталогЖурналаРегистрации, "1Cv8.lgf"),
		Символ(65279) + "1CV8LOG(ver 2.0)" + ПС + "guid" + ПС + ПС + "{4,""_$Session$_.Start"",1}");
	Дописать(ОбъединитьПути(КаталогЖурналаРегистрации, "20251020000000.lgp"),
		Символ(65279) + "1CV8LOG(ver 2.0)" + ПС + "guid" + ПС + ПС
		+ "{20251020090512,N,{0,0},0,0,0,1,1,I,""начало"",0,{""U""},"""",0,0,0,1,0,{0}}");

	Поделка = НоваяПоделка();
	Коллектор = Поделка.НайтиЖелудь("КоллекторЖурналов");

	// Когда
	Количество = Коллектор.ВыполнитьПроход();

	// Тогда
	Ожидаем.Что(Количество).Равно(3);
	Хранилище = Поделка.НайтиЖелудь("ХранилищеПозицийЧтения");
	ПутьТехнологическогоЖурнала = Новый Файл(ОбъединитьПути(КаталогТехнологическогоЖурнала, "rphost_1", "26102009.log")).ПолноеИмя;
	Ожидаем.Что(Хранилище.Позиция(ПутьТехнологическогоЖурнала)).Больше(0);
	Ожидаем.Что(Коллектор.ВыполнитьПроход()).Равно(0);

	Коллектор.Завершить();

КонецПроцедуры

Функция НоваяПоделка()

	ИсточникиДанных = Новый Соответствие;
	ИсточникиДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	СекцияData = Новый Соответствие;
	СекцияData.Вставить("ИсточникиДанных", ИсточникиДанных);

	ТехнологическийЖурнал = Новый Соответствие;
	ТехнологическийЖурнал.Вставить("path", КаталогТехнологическогоЖурнала);
	ТехнологическиеЖурналы = Новый Массив;
	ТехнологическиеЖурналы.Добавить(ТехнологическийЖурнал);

	ЖурналРегистрации = Новый Соответствие;
	ЖурналРегистрации.Вставить("path", КаталогЖурналаРегистрации);
	ЖурналРегистрации.Вставить("infobase", "erp");
	ЖурналыРегистрации = Новый Массив;
	ЖурналыРегистрации.Добавить(ЖурналРегистрации);

	СекцияЖурналов = Новый Соответствие;
	СекцияЖурналов.Вставить("techlog", ТехнологическиеЖурналы);
	СекцияЖурналов.Вставить("eventlog", ЖурналыРегистрации);
	СекцияЖурналов.Вставить("timezone", "Etc/UTC");

	СекцияOtel = Новый Соответствие;
	Для Каждого Сигнал Из СтрРазделить("traces,metrics,logs", ",") Цикл
		Экспортер = Новый Соответствие;
		Экспортер.Вставить("exporter", "none");
		СекцияOtel.Вставить(Сигнал, Экспортер);
	КонецЦикла;
	СекцияOtel.Вставить("v8-logs", СекцияЖурналов);

	Детальки = Новый Соответствие;
	Детальки.Вставить("data", СекцияData);
	Детальки.Вставить("otel", СекцияOtel);

	Совет = Новый СоветДругогоМастера;
	Совет.ЗначенияДеталек(Детальки);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	Возврат Поделка;

КонецФункции

Процедура Дописать(Путь, Текст)
	СоздатьКаталог(Новый Файл(Путь).Путь);
	Буфер = ПолучитьБуферДвоичныхДанныхИзСтроки(Текст, "UTF-8", Ложь);
	Поток = Новый ФайловыйПоток(Путь, РежимОткрытияФайла.ОткрытьИлиСоздать, ДоступКФайлу.Запись);
	Поток.Перейти(0, ПозицияВПотоке.Конец);
	Поток.Записать(Буфер, 0, Буфер.Размер);
	Поток.Закрыть();
КонецПроцедуры

ПС = Символы.ПС;
