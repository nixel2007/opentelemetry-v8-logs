&Тест
Процедура МетрикиКластераБезСвоегоИмениСервисаИдутСИменемДанных() Экспорт

	// Когда
	Коллектор = Стенд.НоваяПоделка(Стенд.СекцияКластера("localhost:1"), "erp-data").НайтиЖелудь("КоллекторЖурналов");

	// Тогда
	Ожидаем.Что(Стенд.СообщенияЛогаС("Кластер 1С: localhost:1, service.name: erp-data")).ИмеетДлину(1);
	Коллектор.Завершить();

КонецПроцедуры

&Тест
Процедура МетрикиКластераИдутСоСвоимИменемСервиса() Экспорт

	// Дано
	Секция = Стенд.СекцияКластера("localhost:1");
	Секция.Вставить("service-name", "1c-cluster");

	// Когда
	Коллектор = Стенд.НоваяПоделка(Секция, "erp-data").НайтиЖелудь("КоллекторЖурналов");

	// Тогда
	Ожидаем.Что(Стенд.СообщенияЛогаС("Кластер 1С: localhost:1, service.name: 1c-cluster")).ИмеетДлину(1);
	Коллектор.Завершить();

КонецПроцедуры

&Тест
Процедура МассивКластеровПодключаетКаждыйКластер() Экспорт

	// Дано
	Кластеры = Массивы.ИзЭлементов(Стенд.СекцияКластера("a.local:1545", "a"), Стенд.СекцияКластера("b.local:1546", "b"));

	// Когда
	Коллектор = Стенд.НоваяПоделка(Кластеры).НайтиЖелудь("КоллекторЖурналов");

	// Тогда
	Ожидаем.Что(Стенд.СообщенияЛогаС("Кластер 1С: a.local:1545, service.name: a")).ИмеетДлину(1);
	Ожидаем.Что(Стенд.СообщенияЛогаС("Кластер 1С: b.local:1546, service.name: b")).ИмеетДлину(1);
	Коллектор.Завершить();

КонецПроцедуры

&Тест
Процедура НедоступныйКластерНеПрерываетОднократныйЗапуск() Экспорт

	// Дано
	Коллектор = Стенд.НоваяПоделка(Стенд.СекцияКластера("localhost:1")).НайтиЖелудь("КоллекторЖурналов");

	// Когда
	Коллектор.Запустить(Истина);

	// Тогда
	Предупреждения = Стенд.СообщенияЛогаС("Кластер localhost:1 недоступен: ");
	Ожидаем.Что(Предупреждения).ИмеетДлину(1);
	Ожидаем.Что(Предупреждения[0].Уровень).Равно(УровниЛога.Предупреждение);

КонецПроцедуры

&Тест
Процедура ПовторнаяНедоступностьНеПовторяетПредупреждение() Экспорт

	// Дано
	Секция = Стенд.СекцияКластера("localhost:1");
	Секция.Вставить("interval", 0);
	Коллектор = Стенд.НоваяПоделка(Секция).НайтиЖелудь("КоллекторЖурналов");

	// Когда
	Коллектор.ОпроситьКластер();
	ОпроситьКластерСОтладкой(Коллектор);

	// Тогда
	Ожидаем.Что(Стенд.СообщенияЛогаС("Кластер localhost:1 недоступен: ")).ИмеетДлину(1);
	Повторные = Стенд.СообщенияЛогаС("Кластер localhost:1 по-прежнему недоступен: ");
	Ожидаем.Что(Повторные).ИмеетДлину(1);
	Ожидаем.Что(Повторные[0].Уровень).Равно(УровниЛога.Отладка);
	Коллектор.Завершить();

КонецПроцедуры

&Тест
Процедура ОпросКластераЖдетИнтервала() Экспорт

	// Дано
	Коллектор = Стенд.НоваяПоделка(Стенд.СекцияКластера("localhost:1")).НайтиЖелудь("КоллекторЖурналов");

	// Когда
	Коллектор.ОпроситьКластер();
	Стенд.ОчиститьСообщенияЛога();
	ОпроситьКластерСОтладкой(Коллектор);

	// Тогда
	Ожидаем.Что(Стенд.СообщенияЛогаС("недоступен")).ИмеетДлину(0);
	Коллектор.Завершить();

КонецПроцедуры

Процедура ОпроситьКластерСОтладкой(Коллектор)
	ЛогПриложения = Логирование.ПолучитьЛог("oscript.app.opentelemetry-v8-logs.КоллекторЖурналов");
	ПрежнийУровень = ЛогПриложения.Уровень();
	ЛогПриложения.УстановитьУровень(УровниЛога.Отладка);
	Попытка
		Коллектор.ОпроситьКластер();
	Исключение
		ЛогПриложения.УстановитьУровень(ПрежнийУровень);
		ВызватьИсключение;
	КонецПопытки;
	ЛогПриложения.УстановитьУровень(ПрежнийУровень);
КонецПроцедуры

&Тест
Процедура ПроходЧитаетЖурналыИзНастроекИФиксируетПозиции() Экспорт

	// Дано
	Стенд.ДописатьЖурналы();

	Поделка = Стенд.НоваяПоделка();
	Коллектор = Поделка.НайтиЖелудь("КоллекторЖурналов");

	// Когда
	Количество = Коллектор.ВыполнитьПроход();

	// Тогда
	Ожидаем.Что(Количество).Равно(3);
	Хранилище = Поделка.НайтиЖелудь("ХранилищеПозицийЧтения");
	ПутьТехнологическогоЖурнала = Стенд.ПолныйПуть(Стенд.КаталогТехнологическогоЖурнала(), "rphost_1", "26102009.log");
	Ожидаем.Что(Хранилище.Позиция(ПутьТехнологическогоЖурнала)).Больше(0);
	Ожидаем.Что(Коллектор.ВыполнитьПроход()).Равно(0);

	Коллектор.Завершить();

КонецПроцедуры

&Тест
Процедура ОстановкаНеЖдетПаузуМеждуПроходами() Экспорт

	// Дано - интервал по умолчанию 5 секунд, журналы пусты
	Коллектор = Стенд.НоваяПоделка().НайтиЖелудь("КоллекторЖурналов");
	Задание = Стенд.ЗапуститьВФоне(Коллектор);
	Стенд.ДождатьсяСообщений(Стенд.СообщениеЗадания("", "запущено"), 2);
	Приостановить(500);

	// Когда
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Коллектор.Остановить();
	Стенд.ДождатьсяСообщений(Стенд.СообщениеЗадания("", "остановлено"), 2);

	// Тогда - задания вышли из паузы, Завершить() в замер не входит
	Ожидаем.Что(ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало).Меньше(2000);
	Ожидаем.Что(Стенд.СообщенияЛогаС(Стенд.СообщениеЗадания("", "остановлено"))).ИмеетДлину(2);
	Стенд.ОжидатьЗавершенияБезОшибок(Задание);

КонецПроцедуры

&Тест
Процедура БезКластеровЗаданиеКластераНеЗапускается() Экспорт

	// Дано
	Коллектор = Стенд.НоваяПоделка().НайтиЖелудь("КоллекторЖурналов");

	// Когда
	Задание = Стенд.ЗапуститьВФоне(Коллектор);
	Стенд.ДождатьсяСообщений(Стенд.СообщениеЗадания("", "запущено"), 2);
	Приостановить(200);
	Коллектор.Остановить();

	// Тогда
	Стенд.ОжидатьЗавершенияБезОшибок(Задание);
	Ожидаем.Что(Стенд.СообщенияЛогаС(Стенд.СообщениеЗадания("технологический журнал", "запущено"))).ИмеетДлину(1);
	Ожидаем.Что(Стенд.СообщенияЛогаС(Стенд.СообщениеЗадания("журнал регистрации", "запущено"))).ИмеетДлину(1);
	Ожидаем.Что(Стенд.СообщенияЛогаС(Стенд.СообщениеЗадания("кластер", "запущено"))).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура БезЖурналовИКластеровЗапускПредупреждаетИЗавершается() Экспорт

	// Дано
	Коллектор = Стенд.НоваяПоделка(Неопределено, "", Ложь).НайтиЖелудь("КоллекторЖурналов");

	// Когда
	Задание = Стенд.ЗапуститьВФоне(Коллектор);

	// Тогда
	Стенд.ОжидатьЗавершенияБезОшибок(Задание);
	Предупреждения = Стенд.СообщенияЛогаС("Нет источников журналов и кластеров");
	Ожидаем.Что(Предупреждения).ИмеетДлину(1);
	Ожидаем.Что(Предупреждения[0].Уровень).Равно(УровниЛога.Предупреждение);
	Ожидаем.Что(Стенд.СообщенияЛогаС(Стенд.СообщениеЗадания("", "запущено"))).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура СбойЗаданияОстанавливаетКоллектор() Экспорт

	// Дано - вывод лога падает на сообщении, которое пишет задание кластера
	Стенд.СбойВыводаНаСообщении("Кластер localhost:1 недоступен");
	Коллектор = Стенд.НоваяПоделка(Стенд.СекцияКластера("localhost:1")).НайтиЖелудь("КоллекторЖурналов");

	// Когда
	Задание = Стенд.ЗапуститьВФоне(Коллектор);
	Завершилось = Задание.ОжидатьЗавершения(45000);

	// Тогда
	Ожидаем.Что(Завершилось, "запуск коллектора завершился").ЭтоИстина();
	Ожидаем.Что(Задание.Состояние).Равно(СостояниеФоновогоЗадания.ЗавершеноАварийно);
	Ожидаем.Что(Задание.ИнформацияОбОшибке.Описание).Содержит("""кластер""").Содержит("Сбой вывода лога");
	Ошибки = Стенд.СообщенияЛогаС(Стенд.СообщениеЗадания("кластер", "завершилось с ошибкой:"));
	Ожидаем.Что(Ошибки).ИмеетДлину(1);
	Ожидаем.Что(Ошибки[0].Уровень).Равно(УровниЛога.Ошибка);
	Ожидаем.Что(Ошибки[0].Текст).Содержит("Сбой вывода лога");
	Ожидаем.Что(Стенд.СообщенияЛогаС(Стенд.СообщениеЗадания("технологический журнал", "остановлено"))).ИмеетДлину(1);
	Ожидаем.Что(Стенд.СообщенияЛогаС(Стенд.СообщениеЗадания("журнал регистрации", "остановлено"))).ИмеетДлину(1);
	Ожидаем.Что(Стенд.СообщенияЛогаС("Завершение чтения журналов 1С")).ИмеетДлину(1);

КонецПроцедуры

&Тест
Процедура НеизвестныйЧасовойПоясНеДаетЗапуститься() Экспорт
	ЧасовойПоясНеДаетЗапуститься("Nowhere/Bad", "");
КонецПроцедуры

&Тест
Процедура НеизвестныйЧасовойПоясИсточникаНеДаетЗапуститься() Экспорт
	ЧасовойПоясНеДаетЗапуститься("Etc/UTC", "Nowhere/Bad");
КонецПроцедуры

Процедура ЧасовойПоясНеДаетЗапуститься(ЧасовойПояс, ЧасовойПоясЖурналаРегистрации)

	// Когда
	Стенд.ПерехватыватьЛогОсени(Истина);
	Коллектор = Стенд.НоваяПоделка(, , Истина, ЧасовойПояс, ЧасовойПоясЖурналаРегистрации)
		.НайтиЖелудь("КоллекторЖурналов");
	Стенд.ПерехватыватьЛогОсени(Ложь);

	// Тогда
	Ожидаем.Что(Коллектор).Равно(Неопределено);
	Ошибки = Стенд.СообщенияЛогаС("«Nowhere/Bad»");
	Ожидаем.Что(Ошибки).ИмеетДлину(1);
	Ожидаем.Что(Ошибки[0].Текст).Содержит("timezone");

КонецПроцедуры
