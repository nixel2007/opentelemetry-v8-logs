&Тест
&Изолированный(Уровень = "Процесс", Импорты = "../tests-isolated/ПодменаКластера")
Процедура БезЖурналаСеансовСнимокНеЗаписывается() Экспорт

	// Дано
	Фейки = НовыеФейкиКластера();
	Секция = СекцияКластера("127.0.0.1:1");
	Секция.Вставить("session-log", Ложь);
	Коллектор = НоваяПоделка(Секция).НайтиЖелудь("КоллекторЖурналов");

	// Когда
	Коллектор.ОпроситьКластер();

	// Тогда
	Ожидаем.Что(Фейки.ЭкспортерСеансов.ЗаписанныеСнимки()).ИмеетДлину(0);
	Ожидаем.Что(Фейки.Экспортер.Вызовы("Обновить")).ИмеетДлину(1);
	Коллектор.Завершить();

КонецПроцедуры

&Тест
&Изолированный(Уровень = "Процесс", Импорты = "../tests-isolated/ПодменаКластера")
Процедура ПредупрежденияОпросаПишутсяВЛогПриИзменении() Экспорт

	// Дано
	Фейки = НовыеФейкиКластера();
	Секция = СекцияКластера("127.0.0.1:1");
	Секция.Вставить("interval", 0);
	Коллектор = НоваяПоделка(Секция).НайтиЖелудь("КоллекторЖурналов");
	Фейки.Опросчик.ОтдаватьПредупреждения(Массивы.ИзЭлементов("база producer: нет прав", "база erp: нет прав"));
	Коллектор.ОпроситьКластер();

	// Когда
	Фейки.Опросчик.ОтдаватьПредупреждения(Массивы.ИзЭлементов("база producer: нет прав", "база erp: нет прав"));
	Коллектор.ОпроситьКластер();
	Фейки.Опросчик.ОтдаватьПредупреждения(Массивы.ИзЭлементов("база producer: нет прав"));
	Коллектор.ОпроситьКластер();

	// Тогда
	Первые = СообщенияЛогаС("база producer: нет прав");
	Ожидаем.Что(Первые).ИмеетДлину(2);
	Ожидаем.Что(Первые[0].Уровень).Равно(УровниЛога.Предупреждение);
	Ожидаем.Что(Первые[0].Текст).Содержит("127.0.0.1:1");
	Ожидаем.Что(СообщенияЛогаС("база erp: нет прав")).ИмеетДлину(1);
	Коллектор.Завершить();

КонецПроцедуры

Функция НастройкаБазы(Имя, Пользователь, Пароль)
	База = Новый Соответствие;
	База.Вставить("name", Имя);
	База.Вставить("user", Пользователь);
	База.Вставить("password", Пароль);
	Возврат База;
КонецФункции

// Фейкам передают вызовы верховные желуди из tests-isolated/ПодменаКластера: их подключает только изолированный
// процесс теста; каталог вне tests/, иначе рекурсивный прогон oneunit подключит их как наборы во все тесты
Функция НовыеФейкиКластера()
	Фейки = Новый Структура("Опросчик, Экспортер, ЭкспортерСеансов", Новый ФейковыйОпросчикКластера,
		Новый ФейковыйЭкспортерМетрикКластера, Новый ФейковыйЭкспортерСеансовКластера);
	ФейкиКластера.Подставить(Фейки.Опросчик, Фейки.Экспортер, Фейки.ЭкспортерСеансов);
	Возврат Фейки;
КонецФункции

Процедура ОпроситьКластерСОтладкой(Коллектор)
	ЛогПриложения = Логирование.ПолучитьЛог("oscript.app.opentelemetry-v8-logs");
	ПрежнийУровень = ЛогПриложения.Уровень();
	ЛогПриложения.УстановитьУровень(УровниЛога.Отладка);
	Попытка
		Коллектор.ОпроситьКластер();
	Исключение
		ЛогПриложения.УстановитьУровень(ПрежнийУровень);
		ВызватьИсключение;
	КонецПопытки;
	ЛогПриложения.УстановитьУровень(ПрежнийУровень);
КонецПроцедуры

&Тест
Процедура ПроходЧитаетЖурналыИзНастроекИФиксируетПозиции() Экспорт

	// Дано
	Дописать(ОбъединитьПути(КаталогТехнологическогоЖурнала, "rphost_1", "26102009.log"),
		Символ(65279) + "05:12.000001-15,CALL,1" + ПС + "05:13.000001-1,EXCP,1,Descr=ошибка" + ПС);
	Дописать(ОбъединитьПути(КаталогЖурналаРегистрации, "1Cv8.lgf"),
		Символ(65279) + "1CV8LOG(ver 2.0)" + ПС + "guid" + ПС + ПС + "{4,""_$Session$_.Start"",1}");
	Дописать(ОбъединитьПути(КаталогЖурналаРегистрации, "20251020000000.lgp"),
		Символ(65279) + "1CV8LOG(ver 2.0)" + ПС + "guid" + ПС + ПС
		+ "{20251020090512,N,{0,0},0,0,0,1,1,I,""начало"",0,{""U""},"""",0,0,0,1,0,{0}}");

	// Поделка OneUnit регистрирует глобальный SDK, если в текущем каталоге есть autumn-properties.json
	// с включенным otel, а повторная регистрация запрещена
	ОтелГлобальный.Сбросить();
	Поделка = НоваяПоделка();
	Коллектор = Поделка.НайтиЖелудь("КоллекторЖурналов");

	// Когда
	Количество = Коллектор.ВыполнитьПроход();

	// Тогда
	Ожидаем.Что(Количество).Равно(3);
	Хранилище = Поделка.НайтиЖелудь("ХранилищеПозицийЧтения");
	ПутьТехнологическогоЖурнала = Новый Файл(
		ОбъединитьПути(КаталогТехнологическогоЖурнала, "rphost_1", "26102009.log")).ПолноеИмя;
	Ожидаем.Что(Хранилище.Позиция(ПутьТехнологическогоЖурнала)).Больше(0);
	Ожидаем.Что(Коллектор.ВыполнитьПроход()).Равно(0);

	Коллектор.Завершить();

КонецПроцедуры

Функция СекцияКластера(АдресRAS)
	Секция = Новый Соответствие;
	Секция.Вставить("ras", АдресRAS);
	Возврат Секция;
КонецФункции

Функция СообщенияЛогаС(Подстрока)
	Результат = Новый Массив;
	Для Каждого Сообщение Из СообщенияЛога Цикл
		Если СтрНайти(Сообщение.Текст, Подстрока) > 0 Тогда
			Результат.Добавить(Сообщение);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция НоваяПоделка(СекцияКластера = Неопределено, ИмяСервисаДанных = "")

	ИсточникиДанных = Новый Соответствие;
	ИсточникиДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	СекцияData = Новый Соответствие;
	СекцияData.Вставить("ИсточникиДанных", ИсточникиДанных);

	ТехнологическийЖурнал = Новый Соответствие;
	ТехнологическийЖурнал.Вставить("path", КаталогТехнологическогоЖурнала);
	ТехнологическиеЖурналы = Новый Массив;
	ТехнологическиеЖурналы.Добавить(ТехнологическийЖурнал);

	ЖурналРегистрации = Новый Соответствие;
	ЖурналРегистрации.Вставить("path", КаталогЖурналаРегистрации);
	ЖурналРегистрации.Вставить("infobase", "erp");
	ЖурналыРегистрации = Новый Массив;
	ЖурналыРегистрации.Добавить(ЖурналРегистрации);

	СекцияЖурналов = Новый Соответствие;
	СекцияЖурналов.Вставить("techlog", ТехнологическиеЖурналы);
	СекцияЖурналов.Вставить("eventlog", ЖурналыРегистрации);
	СекцияЖурналов.Вставить("timezone", "Etc/UTC");
	Если СекцияКластера <> Неопределено Тогда
		СекцияЖурналов.Вставить("cluster", СекцияКластера);
	КонецЕсли;
	Если ЗначениеЗаполнено(ИмяСервисаДанных) Тогда
		СекцияЖурналов.Вставить("service", Новый Соответствие);
		СекцияЖурналов["service"].Вставить("name", ИмяСервисаДанных);
	КонецЕсли;

	СекцияOtel = Новый Соответствие;
	Для Каждого Сигнал Из СтрРазделить("traces,metrics,logs", ",") Цикл
		Экспортер = Новый Соответствие;
		Экспортер.Вставить("exporter", "none");
		СекцияOtel.Вставить(Сигнал, Экспортер);
	КонецЦикла;
	СекцияOtel.Вставить("v8-logs", СекцияЖурналов);

	Детальки = Новый Соответствие;
	Детальки.Вставить("data", СекцияData);
	Детальки.Вставить("otel", СекцияOtel);

	Совет = Новый СоветДругогоМастера;
	Строитель = Совет.ПолучитьСтроительМенеджераПараметров();
	Строитель.ОчиститьПровайдеры();
	Строитель.ДобавитьПровайдерСоответствие(Детальки);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	Возврат Поделка;

КонецФункции

Процедура Дописать(Путь, Текст)
	СоздатьКаталог(Новый Файл(Путь).Путь);
	Буфер = ПолучитьБуферДвоичныхДанныхИзСтроки(Текст, "UTF-8", Ложь);
	Поток = Новый ФайловыйПоток(Путь, РежимОткрытияФайла.ОткрытьИлиСоздать, ДоступКФайлу.Запись);
	Поток.Перейти(0, ПозицияВПотоке.Конец);
	Поток.Записать(Буфер, 0, Буфер.Размер);
	Поток.Закрыть();
КонецПроцедуры

ПС = Символы.ПС;
