КонецПроцедуры

Процедура ПорогДолгихВызововНеДаетЗапуститься(Пороги, НеверныйПорог)

	// Дано
	НовыеФейкиКластера();
	Секция = СекцияКластера("127.0.0.1:1");
	Секция.Вставить("long-call-thresholds", Пороги);

	// Когда
	// Исключение конструктора желудя ОСень не пробрасывает: пишет его в свой лог и отдает Неопределено
	ЛогОсени = Логирование.ПолучитьЛог("oscript.lib.autumn.application.context");
	ЛогОсени.ДобавитьСпособВывода(ЭтотОбъект);
	Коллектор = НоваяПоделка(Секция).НайтиЖелудь("КоллекторЖурналов");
	ЛогОсени.УдалитьСпособВывода(ЭтотОбъект);

	// Тогда
	Ожидаем.Что(Коллектор).Равно(Неопределено);
	Ошибки = СообщенияЛогаС("otel.v8-logs.cluster.long-call-thresholds");
	Ожидаем.Что(Ошибки).ИмеетДлину(1);
	Ожидаем.Что(Ошибки[0].Текст).Содержит("«" + НеверныйПорог + "»");

КонецПроцедуры

&Тест
&Изолированный(Уровень = "Процесс", Импорты = "../tests-isolated/ПодменаКластера")
Процедура УчётныеДанныеБазИзНастроекПередаютсяОпросчику() Экспорт

	// Дано
	Фейки = НовыеФейкиКластера();
	Секция = СекцияКластера("127.0.0.1:1");
	Базы = Новый Массив;
	Базы.Добавить(НастройкаБазы("producer", "Админ", "секрет"));
	Базы.Добавить(НастройкаБазы("erp", "Администратор", ""));
	Секция.Вставить("infobases", Базы);

	// Когда
	Коллектор = НоваяПоделка(Секция).НайтиЖелудь("КоллекторЖурналов");

	// Тогда
	УчётныеДанные = Фейки.Опросчик.УчётныеДанныеБаз();
	Ожидаем.Что(УчётныеДанные).ИмеетТип("Соответствие");
	Ожидаем.Что(УчётныеДанные.Количество()).Равно(2);
	Ожидаем.Что(УчётныеДанные["producer"]).ИмеетТип("Структура");
	Ожидаем.Что(УчётныеДанные["producer"].Пользователь).Равно("Админ");
	Ожидаем.Что(УчётныеДанные["producer"].Пароль).Равно("секрет");
	Ожидаем.Что(УчётныеДанные["erp"].Пользователь).Равно("Администратор");
	Ожидаем.Что(УчётныеДанные["erp"].Пароль).Равно("");
	Коллектор.Завершить();

КонецПроцедуры

