// BSLLS:MagicNumber-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
// BSLLS:DuplicateStringLiteral-off
// BSLLS:MagicDate-off
// BSLLS:NestedFunctionInParameters-off
// BSLLS:Typo-off
#Использовать autumn
#Использовать asserts
#Использовать tempfiles
#Использовать logos
#Использовать opentelemetry
#Использовать "../src/Коллектор"
#Использовать "./ПоддержкаКоллектора"

Перем ПС;
Перем ВременныеФайлыТеста;
Перем КаталогТехнологическогоЖурнала;
Перем КаталогЖурналаРегистрации;
Перем СообщенияЛога; // Массив из Структура - Текст, Уровень

&ПередКаждым
Процедура Подготовить() Экспорт
	ВременныеФайлыТеста = Новый МенеджерВременныхФайлов;
	КаталогТехнологическогоЖурнала = ВременныеФайлыТеста.СоздатьКаталог();
	КаталогЖурналаРегистрации = ОбъединитьПути(ВременныеФайлыТеста.СоздатьКаталог(), "1Cv8Log");
	СоздатьКаталог(КаталогЖурналаРегистрации);
	СообщенияЛога = Новый Массив;
	Логирование.ПолучитьЛог("oscript.app.opentelemetry-v8-logs").ДобавитьСпособВывода(ЭтотОбъект);
КонецПроцедуры

&ПослеКаждого
Процедура УдалитьВременныеФайлы() Экспорт
	Логирование.ПолучитьЛог("oscript.app.opentelemetry-v8-logs").УдалитьСпособВывода(ЭтотОбъект);
	ОтелГлобальный.Сбросить();
	ВременныеФайлыТеста.Удалить();
КонецПроцедуры

// Способ вывода лога приложения
Процедура Вывести(Знач Сообщение, Знач УровеньСообщения) Экспорт
	СообщенияЛога.Добавить(Новый Структура("Текст, Уровень", Сообщение, УровеньСообщения));
КонецПроцедуры

// Способ вывода лога приложения
Процедура Закрыть() Экспорт
	Возврат;
КонецПроцедуры

&Тест
Процедура БезАдресаКластераОпросНеВключается() Экспорт

	// Дано
	Коллектор = НоваяПоделка(СекцияКластера("")).НайтиЖелудь("КоллекторЖурналов");

	// Когда
	Коллектор.Запустить(Истина);

	// Тогда
	Ожидаем.Что(СообщенияЛогаС("Кластер")).ИмеетДлину(0);
	Ожидаем.Что(СообщенияЛогаС("Запуск чтения журналов 1С")).ИмеетДлину(1);

КонецПроцедуры

