	Повторные = СообщенияЛогаС("Кластер 127.0.0.1:1 по-прежнему недоступен: ");
	Ожидаем.Что(Повторные).ИмеетДлину(1);
	Ожидаем.Что(Повторные[0].Уровень).Равно(УровниЛога.Отладка);
	Коллектор.Завершить();

