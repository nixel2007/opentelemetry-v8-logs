// BSLLS:MagicNumber-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
// BSLLS:DuplicateStringLiteral-off
// BSLLS:NestedFunctionInParameters-off
// BSLLS:Typo-off
#Использовать "../src/Экспорт"
#Использовать asserts
#Использовать opentelemetry
#Использовать collectionos

&Табакерка
&Пластилин("ТелеметрияЖурналов")
Перем ТабакеркаТелеметрии;

&Табакерка
&Пластилин("ЭкспортерМетрикКластера")
Перем ТабакеркаЭкспортеров;

Перем ТранспортМетрик;
Перем ПровайдерЛогов;
Перем ПровайдерТрассировки;
Перем Телеметрия;

&ПередКаждым
Процедура Подготовить() Экспорт
	Ресурс = Новый ОтелРесурс(Истина, , Истина);
	ПровайдерЛогов = Новый ОтелПровайдерЛогирования(Ресурс,
		Новый ОтелПростойПроцессорЛогов(Новый ОтелЭкспортерЛогов(Новый ОтелВПамятьТранспорт)));
	ПровайдерТрассировки = Новый ОтелПровайдерТрассировки(Ресурс);
	ТранспортМетрик = Новый ОтелВПамятьТранспорт;
	Телеметрия = ТабакеркаТелеметрии.Достать(Массивы.ИзЭлементов(ПровайдерЛогов, ПровайдерТрассировки,
		Новый ОтелЭкспортерМетрик(ТранспортМетрик), 3600000, "1c", ""));
КонецПроцедуры

&ПослеКаждого
Процедура Закрыть() Экспорт
	Телеметрия.Закрыть();
	ПровайдерЛогов.Закрыть();
	ПровайдерТрассировки.Закрыть();
КонецПроцедуры

&Тест
Процедура КаждыйПоказательСнимкаУходитДатчиком() Экспорт

	// Дано
	Экспортер = Экспортер();

	// Когда
	Экспортер.Обновить(ПолныйСнимок());
	Метрики = Собрать();

	// Тогда
	Для Каждого Описание Из ПоказателиКонтракта() Цикл
		Метрика = НайтиМетрику(Метрики, Описание.Ключ);
		Ожидаем.Что(Метрика, "метрика " + Описание.Ключ).Не_().Равно(Неопределено);
		Ожидаем.Что(Метрика["unit"], "единица " + Описание.Ключ).Равно(Описание.Значение);
		Ожидаем.Что(ЗначениеЗаполнено(Метрика["description"]), "описание " + Описание.Ключ).ЭтоИстина();
		Ожидаем.Что(Метрика["gauge"], "gauge " + Описание.Ключ).Не_().Равно(Неопределено);
		Ожидаем.Что(Метрика["gauge"]["dataPoints"], "точки " + Описание.Ключ).ИмеетДлину(1);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТочкаПоказателяНесетЗначениеИАтрибутыСнимка() Экспорт

	// Дано
	Экспортер = Экспортер();

	// Когда
	Экспортер.Обновить(ПолныйСнимок());
	Метрики = Собрать();

	// Тогда
	Точка = ТочкиМетрики(Метрики, "v8.cluster.process.memory.usage")[0];
	Ожидаем.Что(ЗначениеТочки(Точка)).Равно(2048 * 1024);
	Ожидаем.Что(Точка["attributes"]).ИмеетДлину(3);
	Ожидаем.Что(АтрибутOtlp(Точка, "v8.cluster.name")["stringValue"]).Равно("Главный");
	Ожидаем.Что(АтрибутOtlp(Точка, "host.name")["stringValue"]).Равно("srv1");
	Ожидаем.Что(АтрибутOtlp(Точка, "process.pid")["intValue"]).Равно(1234);

	Точка = ТочкиМетрики(Метрики, "v8.cluster.processes")[0];
	Ожидаем.Что(ЗначениеТочки(Точка)).Равно(2);
	Ожидаем.Что(АтрибутOtlp(Точка, "v8.process.running")["boolValue"]).Равно(Истина);
	Ожидаем.Что(АтрибутOtlp(Точка, "v8.process.enabled")["boolValue"]).Равно(Ложь);

	Точка = ТочкиМетрики(Метрики, "v8.cluster.process.call.duration.avg")[0];
	Ожидаем.Что(ЗначениеТочки(Точка)).Равно(0.25);
	Ожидаем.Что(АтрибутOtlp(Точка, "v8.call.kind")["stringValue"]).Равно("db");

КонецПроцедуры

&Тест
Процедура ДоступныйКластерДаетЕдиницуДоступности() Экспорт

	// Дано
	Экспортер = Экспортер();

	// Когда
	Экспортер.Обновить(ПолныйСнимок());
	Метрики = Собрать();

	// Тогда
	ПроверитьДоступность(Метрики, 1);

КонецПроцедуры

&Тест
Процедура ДоПервогоОбновленияКластерНедоступен() Экспорт

	// Дано
	Экспортер();

	// Когда
	Метрики = Собрать();

	// Тогда
	ПроверитьДоступность(Метрики, 0);
	Ожидаем.Что(ТочкиПоказателей(Метрики)).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ПослеСбросаКластерНедоступен() Экспорт

	// Дано
	Экспортер = Экспортер();
	Экспортер.Обновить(ПолныйСнимок());
	Собрать();

	// Когда
	Экспортер.Сбросить();
	Метрики = Собрать();

	// Тогда
	ПроверитьДоступность(Метрики, 0);
	Ожидаем.Что(ТочкиПоказателей(Метрики)).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура НедоступныйСнимокДаетНольДоступности() Экспорт

	// Дано
	Экспортер = Экспортер();
	Экспортер.Обновить(ПолныйСнимок());
	Собрать();
	Снимок = Снимок(Ложь);
	Снимок.Ошибка = "Нет связи с RAS";

	// Когда
	Экспортер.Обновить(Снимок);
	Метрики = Собрать();

	// Тогда
	ПроверитьДоступность(Метрики, 0);
	Ожидаем.Что(ТочкиПоказателей(Метрики)).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура УшедшаяСерияНеПовторяетсяВСледующемСборе() Экспорт

	// Дано
	Экспортер = Экспортер();
	Снимок = Снимок();
	Снимок.Показатели.Добавить(Показатель("v8.cluster.sessions", 3, АтрибутыСеансов("1CV8C")));
	Снимок.Показатели.Добавить(Показатель("v8.cluster.sessions", 1, АтрибутыСеансов("BackgroundJob")));
	Экспортер.Обновить(Снимок);
	Ожидаем.Что(ТочкиМетрики(Собрать(), "v8.cluster.sessions")).ИмеетДлину(2);

	// Когда
	Снимок = Снимок();
	Снимок.Показатели.Добавить(Показатель("v8.cluster.sessions", 5, АтрибутыСеансов("1CV8C")));
	Экспортер.Обновить(Снимок);
	Точки = ТочкиМетрики(Собрать(), "v8.cluster.sessions");

	// Тогда
	Ожидаем.Что(Точки).ИмеетДлину(1);
	Ожидаем.Что(ЗначениеТочки(Точки[0])).Равно(5);
	Ожидаем.Что(АтрибутOtlp(Точки[0], "v8.session.app_id")["stringValue"]).Равно("1CV8C");

КонецПроцедуры

&Тест
Процедура РесурсМетрикКластера() Экспорт

	// Дано
	Экспортер = Экспортер("1c-cluster");

	// Когда
	Экспортер.Обновить(ПолныйСнимок());
	Собрать();

	// Тогда
	Отправки = ТранспортМетрик.ПолучитьОтправленные();
	РесурсныеМетрики = Отправки[Отправки.ВГраница()]["Данные"]["resourceMetrics"];
	Ожидаем.Что(РесурсныеМетрики).ИмеетДлину(1);
	Ресурс = РесурсныеМетрики[0]["resource"];
	Ожидаем.Что(АтрибутOtlp(Ресурс, "service.name")["stringValue"]).Равно("1c-cluster");
	Ожидаем.Что(АтрибутOtlp(Ресурс, "v8.infobase.name")).Равно(Неопределено);
	Для Каждого МетрикиОбласти Из РесурсныеМетрики[0]["scopeMetrics"] Цикл
		Ожидаем.Что(МетрикиОбласти["scope"]["name"]).Равно("opentelemetry-v8-logs.cluster");
	КонецЦикла;

КонецПроцедуры

Функция Экспортер(ИмяСервиса = "1c-cluster")
	Возврат ТабакеркаЭкспортеров.Достать(Массивы.ИзЭлементов(Телеметрия, ИмяСервиса));
КонецФункции

// Метрики последнего сбора: сброс буфера вызывает колбэки наблюдаемых инструментов
Функция Собрать()
	Телеметрия.СброситьБуфер();
	Отправки = ТранспортМетрик.ПолучитьОтправленные();
	Результат = Новый Массив;
	Если Отправки.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого РесурсныеМетрики Из Отправки[Отправки.ВГраница()]["Данные"]["resourceMetrics"] Цикл
		Для Каждого МетрикиОбласти Из РесурсныеМетрики["scopeMetrics"] Цикл
			Для Каждого Метрика Из МетрикиОбласти["metrics"] Цикл
				Результат.Добавить(Метрика);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура ПроверитьДоступность(Метрики, Ожидаемое)
	Метрика = НайтиМетрику(Метрики, "v8.cluster.up");
	Ожидаем.Что(Метрика, "метрика v8.cluster.up").Не_().Равно(Неопределено);
	Ожидаем.Что(Метрика["unit"]).Равно("");
	Точки = Метрика["gauge"]["dataPoints"];
	Ожидаем.Что(Точки).ИмеетДлину(1);
	Ожидаем.Что(ЗначениеТочки(Точки[0])).Равно(Ожидаемое);
	Атрибуты = Точки[0]["attributes"];
	Ожидаем.Что(Атрибуты = Неопределено ИЛИ Атрибуты.Количество() = 0, "атрибуты v8.cluster.up").ЭтоИстина();
КонецПроцедуры

Функция НайтиМетрику(Метрики, Имя)
	Для Каждого Метрика Из Метрики Цикл
		Если Метрика["name"] = Имя Тогда
			Возврат Метрика;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция ТочкиМетрики(Метрики, Имя)
	Метрика = НайтиМетрику(Метрики, Имя);
	Если Метрика = Неопределено ИЛИ Метрика["gauge"] = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Возврат Метрика["gauge"]["dataPoints"];
КонецФункции

// Точки всех метрик, кроме v8.cluster.up
Функция ТочкиПоказателей(Метрики)
	Результат = Новый Массив;
	Для Каждого Метрика Из Метрики Цикл
		Если Метрика["name"] = "v8.cluster.up" Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Точка Из ТочкиМетрики(Метрики, Метрика["name"]) Цикл
			Результат.Добавить(Точка);
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ЗначениеТочки(Точка)
	Если Точка["asDouble"] <> Неопределено Тогда
		Возврат Точка["asDouble"];
	КонецЕсли;
	Возврат Число(Точка["asInt"]);
КонецФункции

Функция АтрибутOtlp(Объект, Ключ)
	Если Объект["attributes"] = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого Атрибут Из Объект["attributes"] Цикл
		Если Атрибут["key"] = Ключ Тогда
			Возврат Атрибут["value"];
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Имена и единицы показателей: счётные - в аннотированной форме ({session}), безразмерные - пустые,
// иначе в Prometheus единица "1" даёт суффикс _ratio
Функция ПоказателиКонтракта()
	Результат = Новый Соответствие;
	Результат.Вставить("v8.cluster.sessions", "{session}");
	Результат.Вставить("v8.cluster.sessions.blocked", "{session}");
	Результат.Вставить("v8.cluster.sessions.memory.delta", "By");
	Результат.Вставить("v8.cluster.sessions.cpu_time", "s");
	Результат.Вставить("v8.cluster.sessions.calls", "{call}");
	Результат.Вставить("v8.cluster.sessions.call.duration", "s");
	Результат.Вставить("v8.cluster.sessions.io", "By");
	Результат.Вставить("v8.cluster.sessions.long_calls", "{session}");
	Результат.Вставить("v8.cluster.infobase.scheduled_jobs_denied", "");
	Результат.Вставить("v8.cluster.infobase.sessions_denied", "");
	Результат.Вставить("v8.cluster.connections", "{connection}");
	Результат.Вставить("v8.cluster.processes", "{process}");
	Результат.Вставить("v8.cluster.process.memory.usage", "By");
	Результат.Вставить("v8.cluster.process.connections", "{connection}");
	Результат.Вставить("v8.cluster.process.available_performance", "");
	Результат.Вставить("v8.cluster.process.call.duration.avg", "s");
	Результат.Вставить("v8.cluster.licenses.used", "{session}");
	Результат.Вставить("v8.cluster.licenses.total", "{user}");
	Возврат Результат;
КонецФункции

// Снимок с одним показателем на каждое имя из таблицы контракта
Функция ПолныйСнимок()
	Снимок = Снимок();
	Показатели = Снимок.Показатели;
	АтрибутыСеансовХоста = АтрибутыСеансов("1CV8C");
	АтрибутыСеансовХоста.Вставить("host.name", "srv1");
	Показатели.Добавить(Показатель("v8.cluster.sessions", 3, АтрибутыСеансовХоста));
	Показатели.Добавить(Показатель("v8.cluster.sessions.blocked", 1,
		Атрибуты("v8.cluster.name", "Главный", "v8.infobase.name", "erp", "v8.block.kind", "lock")));
	АтрибутыОкна = АтрибутыСБП();
	АтрибутыОкна.Вставить("v8.window", "current");
	Показатели.Добавить(Показатель("v8.cluster.sessions.memory.delta", -1048576, АтрибутыОкна));
	Показатели.Добавить(Показатель("v8.cluster.sessions.cpu_time", 12.5, АтрибутыОкна));
	АтрибутыОкна5Минут = АтрибутыСБП();
	АтрибутыОкна5Минут.Вставить("v8.window", "last5min");
	Показатели.Добавить(Показатель("v8.cluster.sessions.calls", 340, АтрибутыОкна5Минут));
	АтрибутыДлительности = АтрибутыСБП();
	АтрибутыДлительности.Вставить("v8.call.kind", "call");
	АтрибутыДлительности.Вставить("v8.window", "current");
	Показатели.Добавить(Показатель("v8.cluster.sessions.call.duration", 81.2, АтрибутыДлительности));
	АтрибутыВводаВывода = АтрибутыСБП();
	АтрибутыВводаВывода.Вставить("v8.io.direction", "read");
	АтрибутыВводаВывода.Вставить("v8.window", "last5min");
	Показатели.Добавить(Показатель("v8.cluster.sessions.io", 4096, АтрибутыВводаВывода));
	АтрибутыДолгих = АтрибутыСБП();
	АтрибутыДолгих.Вставить("v8.duration.threshold", 60);
	Показатели.Добавить(Показатель("v8.cluster.sessions.long_calls", 0, АтрибутыДолгих));
	Показатели.Добавить(Показатель("v8.cluster.infobase.scheduled_jobs_denied", 1,
		Атрибуты("v8.cluster.name", "Главный", "v8.infobase.name", "erp")));
	Показатели.Добавить(Показатель("v8.cluster.infobase.sessions_denied", 0,
		Атрибуты("v8.cluster.name", "Главный", "v8.infobase.name", "erp")));
	Показатели.Добавить(Показатель("v8.cluster.connections", 4,
		Атрибуты("v8.cluster.name", "Главный", "v8.infobase.name", "erp", "host.name", "srv1",
			"process.pid", 1234, "v8.connection.app_id", "1CV8C")));
	Показатели.Добавить(Показатель("v8.cluster.processes", 2,
		Атрибуты("v8.cluster.name", "Главный", "host.name", "srv1",
			"v8.process.running", Истина, "v8.process.enabled", Ложь)));
	Показатели.Добавить(Показатель("v8.cluster.process.memory.usage", 2048 * 1024, АтрибутыПроцесса()));
	Показатели.Добавить(Показатель("v8.cluster.process.connections", 7, АтрибутыПроцесса()));
	Показатели.Добавить(Показатель("v8.cluster.process.available_performance", 150, АтрибутыПроцесса()));
	АтрибутыВызова = АтрибутыПроцесса();
	АтрибутыВызова.Вставить("v8.call.kind", "db");
	Показатели.Добавить(Показатель("v8.cluster.process.call.duration.avg", 0.25, АтрибутыВызова));
	Показатели.Добавить(Показатель("v8.cluster.licenses.used", 5, АтрибутыЛицензии()));
	Показатели.Добавить(Показатель("v8.cluster.licenses.total", 50, АтрибутыЛицензии()));
	Возврат Снимок;
КонецФункции

Функция Снимок(Доступен = Истина)
	Снимок = Новый Структура;
	Снимок.Вставить("Время", ТекущаяУниверсальнаяДата());
	Снимок.Вставить("Доступен", Доступен);
	Снимок.Вставить("Ошибка", "");
	Снимок.Вставить("Показатели", Новый Массив);
	Снимок.Вставить("Сеансы", Новый Массив);
	Снимок.Вставить("Предупреждения", Новый Массив);
	Возврат Снимок;
КонецФункции

Функция Показатель(Имя, Значение, Атрибуты)
	Возврат Новый Структура("Имя, Значение, Атрибуты", Имя, Значение, Атрибуты);
КонецФункции

Функция АтрибутыСеансов(Приложение)
	Возврат Атрибуты("v8.cluster.name", "Главный", "v8.infobase.name", "erp", "v8.session.app_id", Приложение);
КонецФункции

// Разрез сеансов: кластер, база, приложение, пользователь
Функция АтрибутыСБП()
	Возврат Атрибуты("v8.cluster.name", "Главный", "v8.infobase.name", "erp", "v8.session.app_id", "1CV8C",
		"user.name", "Иванов");
КонецФункции

Функция АтрибутыЛицензии()
	Возврат Атрибуты("v8.cluster.name", "Главный", "v8.license.series", "8100000001",
		"v8.license.server", "srv1", "v8.license.type", "0");
КонецФункции

Функция АтрибутыПроцесса()
	Возврат Атрибуты("v8.cluster.name", "Главный", "host.name", "srv1", "process.pid", 1234);
КонецФункции

// BSLLS:NumberOfOptionalParams-off
Функция Атрибуты(Ключ1, Значение1, Ключ2 = Неопределено, Значение2 = Неопределено,
	Ключ3 = Неопределено, Значение3 = Неопределено, Ключ4 = Неопределено, Значение4 = Неопределено,
	Ключ5 = Неопределено, Значение5 = Неопределено)
	// BSLLS:NumberOfOptionalParams-on
	Результат = Новый Соответствие;
	Результат.Вставить(Ключ1, Значение1);
	Если Ключ2 <> Неопределено Тогда
		Результат.Вставить(Ключ2, Значение2);
	КонецЕсли;
	Если Ключ3 <> Неопределено Тогда
		Результат.Вставить(Ключ3, Значение3);
	КонецЕсли;
	Если Ключ4 <> Неопределено Тогда
		Результат.Вставить(Ключ4, Значение4);
	КонецЕсли;
	Если Ключ5 <> Неопределено Тогда
		Результат.Вставить(Ключ5, Значение5);
	КонецЕсли;
	Возврат Результат;
КонецФункции
