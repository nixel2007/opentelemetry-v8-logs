#Использовать autumn
#Использовать asserts
#Использовать tempfiles
#Использовать collectionos
#Использовать "../src/Коллектор"

Перем Хранилище;

&ПередКаждым
Процедура Подготовить() Экспорт
	Хранилище = НовоеХранилище("КоннекторInMemory");
КонецПроцедуры

&Тест
&ВыключенЕсли(Значение = "() -> SQLiteНедоступен()", Причина = "в пакете sql нет нативной SQLite для macOS arm64")
Процедура ПозицииИзДвухПотоковСохраняютсяВSQLite() Экспорт

	// Дано - пул entity дает каждому потоку свое соединение с одним файлом SQLite
	ВременныеФайлыТеста = Новый МенеджерВременныхФайлов;
	ХранилищеSQLite = НовоеХранилище("КоннекторSQLite",
		"Data Source=" + ОбъединитьПути(ВременныеФайлыТеста.СоздатьКаталог(), "positions.db"));

	// Когда
	Задания = Новый Массив;
	Для Каждого Префикс Из Массивы.ИзЭлементов("/var/log/1c/rphost_1/", "/var/log/1c/rphost_2/") Цикл
		Параметры = Новый Массив;
		Параметры.Добавить(ХранилищеSQLite);
		Параметры.Добавить(Префикс);
		Задания.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, "УстановитьПозиции", Параметры));
	КонецЦикла;
	Ожидаем.Что(ФоновыеЗадания.ОжидатьВсе(Задания, 60000), "задания завершились").ЭтоИстина();

	// Тогда
	Для Каждого Задание Из Задания Цикл
		Если Задание.ИнформацияОбОшибке <> Неопределено Тогда
			ВызватьИсключение ПодробноеПредставлениеОшибки(Задание.ИнформацияОбОшибке);
		КонецЕсли;
	КонецЦикла;
	Для Номер = 1 По 50 Цикл
		Ожидаем.Что(ХранилищеSQLite.Позиция("/var/log/1c/rphost_1/" + Номер)).Равно(Номер);
		Ожидаем.Что(ХранилищеSQLite.Позиция("/var/log/1c/rphost_2/" + Номер)).Равно(Номер);
	КонецЦикла;

	// Соединения пула держат файл базы: на Windows каталог может не удалиться
	Попытка
		ВременныеФайлыТеста.Удалить();
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// В пакете sql нет SQLite.Interop для macOS arm64; ТипПлатформы на arm64 тоже MacOS_x86_64, поэтому uname
Функция SQLiteНедоступен() Экспорт
	СистемнаяИнформация = Новый СистемнаяИнформация;
	Если СтрНайти(Строка(СистемнаяИнформация.ТипПлатформы), "MacOS") = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Процесс = СоздатьПроцесс("uname -m", , Истина);
	Процесс.Запустить();
	Процесс.ОжидатьЗавершения();
	Возврат СокрЛП(Процесс.ПотокВывода.Прочитать()) = "arm64";
КонецФункции

// Тело фонового задания теста
Процедура УстановитьПозиции(ХранилищеПозиций, Префикс) Экспорт
	Для Номер = 1 По 50 Цикл
		ХранилищеПозиций.УстановитьПозицию(Префикс + Номер, Номер);
	КонецЦикла;
КонецПроцедуры

Функция НовоеХранилище(ТипКоннектора, СтрокаСоединения = "")

	ИсточникиДанных = Новый Соответствие;
	ИсточникиДанных.Вставить("ТипКоннектора", ТипКоннектора);
	Если ЗначениеЗаполнено(СтрокаСоединения) Тогда
		ИсточникиДанных.Вставить("СтрокаСоединения", СтрокаСоединения);
	КонецЕсли;
	СекцияData = Новый Соответствие;
	СекцияData.Вставить("ИсточникиДанных", ИсточникиДанных);
	Детальки = Новый Соответствие;
	Детальки.Вставить("data", СекцияData);

	Совет = Новый СоветДругогоМастера;
	Строитель = Совет.ПолучитьСтроительМенеджераПараметров();
	Строитель.ОчиститьПровайдеры();
	Строитель.ДобавитьПровайдерСоответствие(Детальки);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	Возврат Поделка.НайтиЖелудь("ХранилищеПозицийЧтения");

КонецФункции

&Тест
Процедура НеизвестнаяПозиция() Экспорт
	Ожидаем.Что(Хранилище.Позиция("/var/log/1c/rphost_1/26102009.log")).Равно(Неопределено);
КонецПроцедуры

&Тест
Процедура УстановкаИЧтениеПозиции() Экспорт

	// Когда
	Хранилище.УстановитьПозицию("/var/log/1c/rphost_1/26102009.log", 100);
	Хранилище.УстановитьПозицию("/var/log/1c/rphost_1/26102009.log", 3000000000);

	// Тогда
	Ожидаем.Что(Хранилище.Позиция("/var/log/1c/rphost_1/26102009.log")).Равно(3000000000);

КонецПроцедуры

&Тест
Процедура УдалениеПозиции() Экспорт

	// Дано
	Хранилище.УстановитьПозицию("/var/log/1c/rphost_1/26102009.log", 100);

	// Когда
	Хранилище.УдалитьПозицию("/var/log/1c/rphost_1/26102009.log");

	// Тогда
	Ожидаем.Что(Хранилище.Позиция("/var/log/1c/rphost_1/26102009.log")).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура КлючиПоПрефиксу() Экспорт

	// Дано
	Хранилище.УстановитьПозицию("/var/log/1c/rphost_1/26102009.log", 1);
	Хранилище.УстановитьПозицию("/var/log/1c/rphost_2/26102009.log", 2);
	Хранилище.УстановитьПозицию("/srv/1Cv8Log/20251020000000.lgp", 3);

	// Когда
	Ключи = Хранилище.Ключи("/var/log/1c/");

	// Тогда
	Ожидаем.Что(Ключи).ИмеетДлину(2);
	Ожидаем.Что(Ключи).Содержит("/var/log/1c/rphost_2/26102009.log");

КонецПроцедуры
