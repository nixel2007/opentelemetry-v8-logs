// BSLLS:MagicNumber-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
// BSLLS:DuplicateStringLiteral-off
// BSLLS:MagicDate-off
// BSLLS:NestedFunctionInParameters-off
// BSLLS:Typo-off
#Использовать autumn
#Использовать asserts
#Использовать "../src/Коллектор"

Перем Хранилище;

&ПередКаждым
Процедура Подготовить() Экспорт

	ИсточникиДанных = Новый Соответствие;
	ИсточникиДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	СекцияData = Новый Соответствие;
	СекцияData.Вставить("ИсточникиДанных", ИсточникиДанных);
	Детальки = Новый Соответствие;
	Детальки.Вставить("data", СекцияData);

	Совет = Новый СоветДругогоМастера;
	Совет.ЗначенияДеталек(Детальки);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	Хранилище = Поделка.НайтиЖелудь("ХранилищеПозицийЧтения");

КонецПроцедуры

&Тест
Процедура НеизвестнаяПозиция() Экспорт
	Ожидаем.Что(Хранилище.Позиция("/var/log/1c/rphost_1/26102009.log")).Равно(Неопределено);
КонецПроцедуры

&Тест
Процедура УстановкаИЧтениеПозиции() Экспорт

	// Когда
	Хранилище.УстановитьПозицию("/var/log/1c/rphost_1/26102009.log", 100);
	Хранилище.УстановитьПозицию("/var/log/1c/rphost_1/26102009.log", 3000000000);

	// Тогда
	Ожидаем.Что(Хранилище.Позиция("/var/log/1c/rphost_1/26102009.log")).Равно(3000000000);

КонецПроцедуры

&Тест
Процедура УдалениеПозиции() Экспорт

	// Дано
	Хранилище.УстановитьПозицию("/var/log/1c/rphost_1/26102009.log", 100);

	// Когда
	Хранилище.УдалитьПозицию("/var/log/1c/rphost_1/26102009.log");

	// Тогда
	Ожидаем.Что(Хранилище.Позиция("/var/log/1c/rphost_1/26102009.log")).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура КлючиПоПрефиксу() Экспорт

	// Дано
	Хранилище.УстановитьПозицию("/var/log/1c/rphost_1/26102009.log", 1);
	Хранилище.УстановитьПозицию("/var/log/1c/rphost_2/26102009.log", 2);
	Хранилище.УстановитьПозицию("/srv/1Cv8Log/20251020000000.lgp", 3);

	// Когда
	Ключи = Хранилище.Ключи("/var/log/1c/");

	// Тогда
	Ожидаем.Что(Ключи).ИмеетДлину(2);
	Ожидаем.Что(Ключи).Содержит("/var/log/1c/rphost_2/26102009.log");

КонецПроцедуры
