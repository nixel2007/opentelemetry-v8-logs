// BSLLS:MagicNumber-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
#Использовать ".."
#Использовать asserts
#Использовать opentelemetry

Перем ПС;
Перем ТранспортЛогов;
Перем ТранспортМетрик;
Перем ПровайдерЛогов;
Перем ПровайдерМетрик;

&ПередКаждым
Процедура Подготовить() Экспорт
	Ресурс = Новый ОтелРесурс(Истина, , Истина);
	ТранспортЛогов = Новый ОтелВПамятьТранспорт;
	ПровайдерЛогов = Новый ОтелПровайдерЛогирования(Ресурс,
		Новый ОтелПростойПроцессорЛогов(Новый ОтелЭкспортерЛогов(ТранспортЛогов)));
	ТранспортМетрик = Новый ОтелВПамятьТранспорт;
	ПровайдерМетрик = Новый ОтелПровайдерМетрик(Ресурс,
		Новый ОтелПериодическийЧитательМетрик(Новый ОтелЭкспортерМетрик(ТранспортМетрик), 3600000));
КонецПроцедуры

&ПослеКаждого
Процедура Закрыть() Экспорт
	ПровайдерЛогов.Закрыть();
	ПровайдерМетрик.Закрыть();
КонецПроцедуры

&Тест
Процедура СобытиеСтановитсяЗаписьюЛога() Экспорт

	// Дано
	Событие = Событие("05:12.345678-15,CALL,1,Usr=Admin,p:processName=erp");

	// Когда
	Экспортер().ОбработатьСобытияТехЖурнала(МассивИз(Событие), ОписаниеФайла());

	// Тогда
	Записи = ЗаписиЛога();
	Ожидаем.Что(Записи).ИмеетДлину(1);
	Запись = Записи[0];
	Ожидаем.Что(Запись["timeUnixNano"]).Равно("1792487112345678000");
	Ожидаем.Что(Запись["severityNumber"]).Равно(9);
	Ожидаем.Что(Запись["body"]["stringValue"]).Равно("05:12.345678-15,CALL,1,Usr=Admin,p:processName=erp");

	Атрибуты = Атрибуты(Запись);
	Ожидаем.Что(Атрибуты["onec.techlog.event.name"]).Равно("CALL");
	Ожидаем.Что(Атрибуты["onec.techlog.duration"]).Равно("15");
	Ожидаем.Что(Атрибуты["onec.techlog.depth"]).Равно("1");
	Ожидаем.Что(Атрибуты["onec.techlog.Usr"]).Равно("Admin");
	Ожидаем.Что(Атрибуты["onec.techlog.p:processName"]).Равно("erp");
	Ожидаем.Что(Атрибуты["process.executable.name"]).Равно("rphost");
	Ожидаем.Что(Атрибуты["process.pid"]).Равно("1234");
	Ожидаем.Что(Атрибуты["log.file.path"]).Равно("/var/log/1c/rphost_1234/26102009.log");

КонецПроцедуры

&Тест
Процедура МестноеВремяПереводитсяВUTCПоЧасовомуПоясу() Экспорт

	// Дано
	Событие = Событие("05:12.345678-15,CALL,1");
	Параметры = Новый Структура("ЧасовойПояс", "Europe/Moscow");

	// Когда
	Экспортер(Параметры).ОбработатьСобытияТехЖурнала(МассивИз(Событие), ОписаниеФайла());

	// Тогда
	Ожидаем.Что(ЗаписиЛога()[0]["timeUnixNano"]).Равно("1792476312345678000");

КонецПроцедуры

&Тест
Процедура СерьезностьПоИмениСобытия() Экспорт

	// Дано
	События = Новый Массив;
	События.Добавить(Событие("05:12.000001-0,EXCP,1,Descr=ошибка"));
	События.Добавить(Событие("05:12.000002-0,TDEADLOCK,1"));
	События.Добавить(Событие("05:12.000003-0,TTIMEOUT,1"));
	События.Добавить(Событие("05:12.000004-0,ATTN,1"));
	События.Добавить(Событие("05:12.000005-0,DBMSSQL,1"));

	// Когда
	Экспортер().ОбработатьСобытияТехЖурнала(События, ОписаниеФайла());

	// Тогда
	Записи = ЗаписиЛога();
	Ожидаем.Что(Записи[0]["severityNumber"]).Равно(17);
	Ожидаем.Что(Записи[0]["severityText"]).Равно("ERROR");
	Ожидаем.Что(Записи[1]["severityNumber"]).Равно(13);
	Ожидаем.Что(Записи[2]["severityNumber"]).Равно(13);
	Ожидаем.Что(Записи[3]["severityNumber"]).Равно(13);
	Ожидаем.Что(Записи[4]["severityNumber"]).Равно(9);

КонецПроцедуры

&Тест
Процедура ПовторяющиесяСвойстваСтановятсяМассивом() Экспорт

	// Дано
	Событие = Событие("05:12.000001-0,SDBL,1,Func=BeginTransaction,Func=CommitTransaction");

	// Когда
	Экспортер().ОбработатьСобытияТехЖурнала(МассивИз(Событие), ОписаниеФайла());

	// Тогда
	Значение = АтрибутOtlp(ЗаписиЛога()[0], "onec.techlog.Func");
	Значения = Значение["arrayValue"]["values"];
	Ожидаем.Что(Значения).ИмеетДлину(2);
	Ожидаем.Что(Значения[1]["stringValue"]).Равно("CommitTransaction");

КонецПроцедуры

&Тест
Процедура ДлительностьЗаписываетсяВГистограмму() Экспорт

	// Дано
	События = Новый Массив;
	События.Добавить(Событие("05:12.000001-15,DBMSSQL,1,p:processName=erp"));
	События.Добавить(Событие("05:12.000002-5,DBMSSQL,1,p:processName=erp"));

	// Когда
	Экспортер().ОбработатьСобытияТехЖурнала(События, ОписаниеФайла());
	ПровайдерМетрик.СброситьБуфер();

	// Тогда
	Метрика = НайтиМетрику("onec.techlog.event.duration");
	Ожидаем.Что(Метрика["unit"]).Равно("s");
	Точка = Метрика["histogram"]["dataPoints"][0];
	Ожидаем.Что(Число(Точка["count"])).Равно(2);
	Ожидаем.Что(Точка["sum"]).Равно(0.00002);
	Атрибуты = Атрибуты(Точка);
	Ожидаем.Что(Атрибуты["onec.techlog.event.name"]).Равно("DBMSSQL");
	Ожидаем.Что(Атрибуты["process.executable.name"]).Равно("rphost");
	Ожидаем.Что(Атрибуты["onec.infobase.name"]).Равно("erp");

КонецПроцедуры

Функция Экспортер(Параметры = Неопределено)
	Если Параметры = Неопределено Тогда
		Параметры = Новый Структура("ЧасовойПояс", "Etc/UTC");
	КонецЕсли;
	Возврат Новый ЭкспортерТехЖурнала(
		ПровайдерЛогов.ПолучитьЛоггер("test"), ПровайдерМетрик.ПолучитьМетр("test"), Неопределено, Параметры);
КонецФункции

Функция Событие(Текст)
	Возврат ПарсерТехЖурнала.Разобрать(Текст + ПС, Дата(2026, 10, 20, 9, 0, 0)).События[0];
КонецФункции

Функция МассивИз(Значение)
	Результат = Новый Массив;
	Результат.Добавить(Значение);
	Возврат Результат;
КонецФункции

Функция ОписаниеФайла()
	Описание = Новый Структура;
	Описание.Вставить("Путь", "/var/log/1c/rphost_1234/26102009.log");
	Описание.Вставить("Каталог", "/var/log/1c");
	Описание.Вставить("Процесс", "rphost");
	Описание.Вставить("ИдПроцесса", "1234");
	Описание.Вставить("ДатаЧаса", Дата(2026, 10, 20, 9, 0, 0));
	Возврат Описание;
КонецФункции

Функция ЗаписиЛога()
	Результат = Новый Массив;
	Для Каждого Отправка Из ТранспортЛогов.ПолучитьОтправленные() Цикл
		Для Каждого РесурсныеЛоги Из Отправка["Данные"]["resourceLogs"] Цикл
			Для Каждого ЛогиОбласти Из РесурсныеЛоги["scopeLogs"] Цикл
				Для Каждого Запись Из ЛогиОбласти["logRecords"] Цикл
					Результат.Добавить(Запись);
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция НайтиМетрику(Имя)
	Для Каждого Отправка Из ТранспортМетрик.ПолучитьОтправленные() Цикл
		Для Каждого РесурсныеМетрики Из Отправка["Данные"]["resourceMetrics"] Цикл
			Для Каждого МетрикиОбласти Из РесурсныеМетрики["scopeMetrics"] Цикл
				Для Каждого Метрика Из МетрикиОбласти["metrics"] Цикл
					Если Метрика["name"] = Имя Тогда
						Возврат Метрика;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	ВызватьИсключение "Не найдена метрика " + Имя;
КонецФункции

// Атрибуты OTLP в виде соответствия ключ -> строковое представление значения
Функция Атрибуты(Объект)
	Результат = Новый Соответствие;
	Для Каждого Атрибут Из Объект["attributes"] Цикл
		Значение = Атрибут["value"];
		Для Каждого Вид Из Значение Цикл
			Результат.Вставить(Атрибут["key"], Строка(Вид.Значение));
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция АтрибутOtlp(Объект, Ключ)
	Для Каждого Атрибут Из Объект["attributes"] Цикл
		Если Атрибут["key"] = Ключ Тогда
			Возврат Атрибут["value"];
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

ПС = Символы.ПС;
