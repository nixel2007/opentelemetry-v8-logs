// BSLLS:Typo-off
#Использовать "../src/Экспорт"
#Использовать asserts
#Использовать opentelemetry

Перем Транспорт;
Перем ТранспортМетрик;
Перем ПровайдерЛогов;
Перем ПровайдерТрассировки;
Перем Телеметрия;

&ПередКаждым
Процедура Подготовить() Экспорт

	// Телеметрия самого коллектора
	РесурсКоллектора = Новый ОтелРесурс(Истина, , Истина);
	РесурсКоллектора.Атрибуты().Установить("service.name", "opentelemetry-v8-logs");
	РесурсКоллектора.Атрибуты().Установить("process.pid", 4242);
	Транспорт = Новый ОтелВПамятьТранспорт;
	ПровайдерЛогов = Новый ОтелПровайдерЛогирования(РесурсКоллектора,
		Новый ОтелПростойПроцессорЛогов(Новый ОтелЭкспортерЛогов(Транспорт)));
	ПровайдерТрассировки = Новый ОтелПровайдерТрассировки(РесурсКоллектора,
		Новый ОтелПростойПроцессорСпанов(Новый ОтелЭкспортерСпанов(Транспорт)));

	ТранспортМетрик = Новый ОтелВПамятьТранспорт;
	Телеметрия = Новый ТелеметрияЖурналов(ПровайдерЛогов, ПровайдерТрассировки,
		Новый ОтелЭкспортерМетрик(ТранспортМетрик), 3600000, "1c", "deployment.environment.name=prod");

КонецПроцедуры

&ПослеКаждого
Процедура Закрыть() Экспорт
	Телеметрия.Закрыть();
	ПровайдерЛогов.Закрыть();
	ПровайдерТрассировки.Закрыть();
КонецПроцедуры

&Тест
Процедура ЛогиДанныхИКоллектораВРазныхСервисах() Экспорт

	// Когда
	ЗаписатьЛог(Телеметрия.ДляСервиса("").ПровайдерЛогирования.ПолучитьЛоггер("test"), "данные");
	ЗаписатьЛог(ПровайдерЛогов.ПолучитьЛоггер("collector"), "коллектор");

	// Тогда
	Ресурсы = РесурсыЗаписей("resourceLogs", "scopeLogs", "logRecords");
	Ожидаем.Что(Ресурсы["данные"]["service.name"]).Равно("1c");
	Ожидаем.Что(Ресурсы["коллектор"]["service.name"]).Равно("opentelemetry-v8-logs");

КонецПроцедуры

&Тест
Процедура РесурсДанныхБезАтрибутовПроцессаКоллектора() Экспорт

	// Когда
	ЗаписатьЛог(Телеметрия.ДляСервиса("").ПровайдерЛогирования.ПолучитьЛоггер("test"), "данные");

	// Тогда
	Ресурс = РесурсыЗаписей("resourceLogs", "scopeLogs", "logRecords")["данные"];
	Ожидаем.Что(Ресурс["process.pid"]).Равно(Неопределено);
	Ожидаем.Что(Ресурс["deployment.environment.name"]).Равно("prod");

КонецПроцедуры

&Тест
Процедура ИмяСервисаИсточникаЗаменяетОбщее() Экспорт

	// Когда
	ЗаписатьЛог(Телеметрия.ДляСервиса("erp").ПровайдерЛогирования.ПолучитьЛоггер("test"), "erp");
	ЗаписатьЛог(Телеметрия.ДляСервиса("").ПровайдерЛогирования.ПолучитьЛоггер("test"), "общий");

	// Тогда
	Ресурсы = РесурсыЗаписей("resourceLogs", "scopeLogs", "logRecords");
	Ожидаем.Что(Ресурсы["erp"]["service.name"]).Равно("erp");
	Ожидаем.Что(Ресурсы["общий"]["service.name"]).Равно("1c");

КонецПроцедуры

&Тест
Процедура ИнформационнаяБазаВРесурсеДанных() Экспорт

	// Когда
	ЗаписатьЛог(Телеметрия.ДляСервиса("", "erp").ПровайдерЛогирования.ПолучитьЛоггер("test"), "erp");
	ЗаписатьЛог(Телеметрия.ДляСервиса("", "hrm").ПровайдерЛогирования.ПолучитьЛоггер("test"), "hrm");
	ЗаписатьЛог(Телеметрия.ДляСервиса("").ПровайдерЛогирования.ПолучитьЛоггер("test"), "без базы");

	// Тогда
	Ресурсы = РесурсыЗаписей("resourceLogs", "scopeLogs", "logRecords");
	Ожидаем.Что(Ресурсы["erp"]["v8.infobase.name"]).Равно("erp");
	Ожидаем.Что(Ресурсы["erp"]["service.name"]).Равно("1c");
	Ожидаем.Что(Ресурсы["hrm"]["v8.infobase.name"]).Равно("hrm");
	Ожидаем.Что(Ресурсы["без базы"]["v8.infobase.name"]).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ОднаБазаОдниПровайдеры() Экспорт
	Ожидаем.Что(Телеметрия.ДляСервиса("", "erp")).Равно(Телеметрия.ДляСервиса("1c", "erp"));
	Ожидаем.Что(Телеметрия.ДляСервиса("", "erp")).Не_().Равно(Телеметрия.ДляСервиса("", "hrm"));
КонецПроцедуры

&Тест
Процедура ОдинСервисОдниПровайдеры() Экспорт
	Ожидаем.Что(Телеметрия.ДляСервиса("erp")).Равно(Телеметрия.ДляСервиса("erp"));
	Ожидаем.Что(Телеметрия.ДляСервиса("")).Равно(Телеметрия.ДляСервиса("1c"));
КонецПроцедуры

&Тест
Процедура СпаныДанныхВСервисеДанных() Экспорт

	// Когда
	Трассировщик = Телеметрия.ДляСервиса("").ПровайдерТрассировки.ПолучитьТрассировщик("test");
	Трассировщик.НачатьСпан("данные").Завершить();
	ПровайдерТрассировки.ПолучитьТрассировщик("collector").НачатьСпан("коллектор").Завершить();

	// Тогда
	Ресурсы = РесурсыЗаписей("resourceSpans", "scopeSpans", "spans", "name");
	Ожидаем.Что(Ресурсы["данные"]["service.name"]).Равно("1c");
	Ожидаем.Что(Ресурсы["коллектор"]["service.name"]).Равно("opentelemetry-v8-logs");

КонецПроцедуры

&Тест
Процедура МетрикиДанныхВСервисеДанныхПослеСброса() Экспорт

	// Дано
	Счетчик = Телеметрия.ДляСервиса("").ПровайдерМетрик.ПолучитьМетр("test").СоздатьСчетчик("test.counter");
	Счетчик.Добавить(1);

	// Когда
	Результат = Телеметрия.СброситьБуфер();

	// Тогда
	Ожидаем.Что(Результат.Успешно()).ЭтоИстина();
	Отправленные = ТранспортМетрик.ПолучитьОтправленные();
	Ожидаем.Что(Отправленные.Количество()).Больше(0);
	РесурсOtlp = Отправленные[0]["Данные"]["resourceMetrics"][0]["resource"];
	Ожидаем.Что(АтрибутыOtlp(РесурсOtlp)["service.name"]).Равно("1c");

КонецПроцедуры

Процедура ЗаписатьЛог(Логгер, Тело)
	Запись = Логгер.СоздатьЗаписьЛога();
	Запись.УстановитьТело(Тело);
	Логгер.Записать(Запись, Новый Соответствие);
КонецПроцедуры

// Атрибуты ресурса для каждой записи: тело (или поле ПолеКлюча) записи -> атрибуты ресурса
Функция РесурсыЗаписей(КлючРесурсов, КлючОбластей, КлючЗаписей, ПолеКлюча = "body")
	Результат = Новый Соответствие;
	Для Каждого Отправка Из Транспорт.ПолучитьОтправленные() Цикл
		Данные = Отправка["Данные"];
		Если Данные[КлючРесурсов] = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Ресурсные Из Данные[КлючРесурсов] Цикл
			ДобавитьРесурсыЗаписей(Результат, Ресурсные, КлючОбластей, КлючЗаписей, ПолеКлюча);
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура ДобавитьРесурсыЗаписей(Результат, Ресурсные, КлючОбластей, КлючЗаписей, ПолеКлюча)
	АтрибутыРесурса = АтрибутыOtlp(Ресурсные["resource"]);
	Для Каждого Области Из Ресурсные[КлючОбластей] Цикл
		Для Каждого Запись Из Области[КлючЗаписей] Цикл
			Ключ = Запись[ПолеКлюча];
			Если ТипЗнч(Ключ) = Тип("Соответствие") Тогда
				Ключ = Ключ["stringValue"];
			КонецЕсли;
			Результат.Вставить(Ключ, АтрибутыРесурса);
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

Функция АтрибутыOtlp(Объект)
	Результат = Новый Соответствие;
	Если Объект = Неопределено ИЛИ Объект["attributes"] = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Атрибут Из Объект["attributes"] Цикл
		Для Каждого Вид Из Атрибут["value"] Цикл
			Результат.Вставить(Атрибут["key"], Строка(Вид.Значение));
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции
