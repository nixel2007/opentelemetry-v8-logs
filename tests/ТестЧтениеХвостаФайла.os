// BSLLS:MagicNumber-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
#Использовать ".."
#Использовать asserts
#Использовать tempfiles

Перем ПС;
Перем ВременныеФайлыТеста;

&ПослеКаждого
Процедура УдалитьВременныеФайлы() Экспорт
	ВременныеФайлыТеста.Удалить();
КонецПроцедуры

&Тест
Процедура ЧтениеСНачалаПропускаетBOM() Экспорт

	// Дано
	Путь = ФайлСТекстом("строка1" + ПС + "строка2" + ПС, Истина);

	// Когда
	Результат = ЧтениеХвостаФайла.Прочитать(Путь, 0, 1024);

	// Тогда
	Ожидаем.Что(Результат.Текст).Равно("строка1" + ПС + "строка2" + ПС);
	Ожидаем.Что(Результат.Начало).Равно(3);
	Ожидаем.Что(Результат.Конец).Равно(3 + 28);
	Ожидаем.Что(Результат.РазмерФайла).Равно(3 + 28);

КонецПроцедуры

&Тест
Процедура ЧтениеСПозиции() Экспорт

	// Дано
	Путь = ФайлСТекстом("строка1" + ПС + "строка2" + ПС, Истина);

	// Когда
	Результат = ЧтениеХвостаФайла.Прочитать(Путь, 3 + 14, 1024);

	// Тогда
	Ожидаем.Что(Результат.Текст).Равно("строка2" + ПС);
	Ожидаем.Что(Результат.Начало).Равно(17);
	Ожидаем.Что(Результат.Конец).Равно(31);

КонецПроцедуры

&Тест
Процедура НеполнаяСтрокаНеЧитается() Экспорт

	// Дано
	Путь = ФайлСТекстом("строка1" + ПС + "хвост", Ложь);

	// Когда
	Результат = ЧтениеХвостаФайла.Прочитать(Путь, 0, 1024);

	// Тогда
	Ожидаем.Что(Результат.Текст).Равно("строка1" + ПС);
	Ожидаем.Что(Результат.Конец).Равно(14);
	Ожидаем.Что(Результат.РазмерФайла).Равно(24);

КонецПроцедуры

&Тест
Процедура НеполнаяСтрокаЧитаетсяПоЗапросу() Экспорт

	// Дано
	Путь = ФайлСТекстом("строка1" + ПС + "хвост", Ложь);

	// Когда
	Результат = ЧтениеХвостаФайла.Прочитать(Путь, 0, 1024, Истина);

	// Тогда
	Ожидаем.Что(Результат.Текст).Равно("строка1" + ПС + "хвост");
	Ожидаем.Что(Результат.Конец).Равно(24);

КонецПроцедуры

&Тест
Процедура НетНовыхДанных() Экспорт

	// Дано
	Путь = ФайлСТекстом("строка1" + ПС, Ложь);

	// Когда
	Результат = ЧтениеХвостаФайла.Прочитать(Путь, 14, 1024);

	// Тогда
	Ожидаем.Что(Результат.Текст).Равно("");
	Ожидаем.Что(Результат.Конец).Равно(14);

КонецПроцедуры

&Тест
Процедура ЧтениеОграничиваетсяМаксимумомБайт() Экспорт

	// Дано
	Путь = ФайлСТекстом("aaaa" + ПС + "bbbb" + ПС + "cccc" + ПС, Ложь);

	// Когда
	Результат = ЧтениеХвостаФайла.Прочитать(Путь, 0, 12);

	// Тогда
	Ожидаем.Что(Результат.Текст).Равно("aaaa" + ПС + "bbbb" + ПС);
	Ожидаем.Что(Результат.Конец).Равно(10);
	Ожидаем.Что(Результат.БуферЗаполнен).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СтрокаДлиннееМаксимумаНеЧитается() Экспорт

	// Дано
	Путь = ФайлСТекстом("aaaaaaaaaaaaaaaa" + ПС, Ложь);

	// Когда
	Результат = ЧтениеХвостаФайла.Прочитать(Путь, 0, 8);

	// Тогда
	Ожидаем.Что(Результат.Текст).Равно("");
	Ожидаем.Что(Результат.Конец).Равно(0);
	Ожидаем.Что(Результат.БуферЗаполнен).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПозицияЗаКонцомФайлаПриУсечении() Экспорт

	// Дано
	Путь = ФайлСТекстом("строка1" + ПС, Ложь);

	// Когда
	Результат = ЧтениеХвостаФайла.Прочитать(Путь, 1000, 1024);

	// Тогда
	Ожидаем.Что(Результат.ФайлУсечен).ЭтоИстина();
	Ожидаем.Что(Результат.Текст).Равно("");

КонецПроцедуры

&Тест
Процедура ЧтениеПоГраницеСимволаБезПереводаСтроки() Экспорт

	// Дано
	Путь = ФайлСТекстом("{1}," + ПС + "{2}", Ложь);

	// Когда
	Результат = ЧтениеХвостаФайла.Прочитать(Путь, 0, 1024, Ложь, Истина);

	// Тогда
	Ожидаем.Что(Результат.Текст).Равно("{1}," + ПС + "{2}");
	Ожидаем.Что(Результат.Конец).Равно(8);

КонецПроцедуры

&Тест
Процедура ЧтениеПоГраницеСимволаНеРазрезаетСимвол() Экспорт

	// Дано - порция в 8 байт обрывается на первом байте второй "б"
	Путь = ФайлСТекстом("aaaa" + ПС + "ббб", Ложь);

	// Когда
	Результат = ЧтениеХвостаФайла.Прочитать(Путь, 0, 8, Ложь, Истина);

	// Тогда
	Ожидаем.Что(Результат.Текст).Равно("aaaa" + ПС + "б");
	Ожидаем.Что(Результат.Конец).Равно(7);
	Ожидаем.Что(Результат.БуферЗаполнен).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЧтениеПоГраницеСимволаСЧетырехбайтнымСимволом() Экспорт

	// Дано - символ вне BMP занимает 4 байта, порция обрывается на третьем
	Путь = ФайлСТекстом("ab" + Символ(55357) + Символ(56832), Ложь);

	// Когда
	Результат = ЧтениеХвостаФайла.Прочитать(Путь, 0, 5, Ложь, Истина);

	// Тогда
	Ожидаем.Что(Результат.Текст).Равно("ab");
	Ожидаем.Что(Результат.Конец).Равно(2);

КонецПроцедуры

&Тест
Процедура РазмерВБайтах() Экспорт
	Ожидаем.Что(ЧтениеХвостаФайла.РазмерВБайтах("строка1" + ПС)).Равно(14);
	Ожидаем.Что(ЧтениеХвостаФайла.РазмерВБайтах("")).Равно(0);
КонецПроцедуры

Функция ФайлСТекстом(Текст, СBOM)

	Путь = ВременныеФайлыТеста.НовоеИмяФайла("log");
	Буфер = ПолучитьБуферДвоичныхДанныхИзСтроки(?(СBOM, Символ(65279), "") + Текст, "UTF-8", Ложь);
	Поток = Новый ФайловыйПоток(Путь, РежимОткрытияФайла.Создать, ДоступКФайлу.Запись);
	Поток.Записать(Буфер, 0, Буфер.Размер);
	Поток.Закрыть();

	Возврат Путь;

КонецФункции

ПС = Символы.ПС;
ВременныеФайлыТеста = Новый МенеджерВременныхФайлов;
