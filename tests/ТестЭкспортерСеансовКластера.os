// BSLLS:Typo-off
#Использовать "../src/Экспорт"
#Использовать asserts
#Использовать opentelemetry
#Использовать collectionos

&Табакерка
&Пластилин("ТелеметрияЖурналов")
Перем ТабакеркаТелеметрии;

&Табакерка
&Пластилин("ЭкспортерСеансовКластера")
Перем ТабакеркаЭкспортеров;

Перем ТранспортЛогов;
Перем ПровайдерЛогов;
Перем ПровайдерТрассировки;
Перем Телеметрия;

&ПередКаждым
Процедура Подготовить() Экспорт
	Ресурс = Новый ОтелРесурс(Истина, , Истина);
	ТранспортЛогов = Новый ОтелВПамятьТранспорт;
	ПровайдерЛогов = Новый ОтелПровайдерЛогирования(Ресурс,
		Новый ОтелПростойПроцессорЛогов(Новый ОтелЭкспортерЛогов(ТранспортЛогов)));
	ПровайдерТрассировки = Новый ОтелПровайдерТрассировки(Ресурс);
	Телеметрия = ТабакеркаТелеметрии.Достать(Массивы.ИзЭлементов(ПровайдерЛогов, ПровайдерТрассировки,
		Новый ОтелЭкспортерМетрик(Новый ОтелВПамятьТранспорт), 3600000, "1c", ""));
КонецПроцедуры

&ПослеКаждого
Процедура Закрыть() Экспорт
	Телеметрия.Закрыть();
	ПровайдерЛогов.Закрыть();
	ПровайдерТрассировки.Закрыть();
КонецПроцедуры

&Тест
Процедура КаждыйСеансСнимкаСтановитсяЗаписьюЛога() Экспорт

	// Дано
	Снимок = Снимок();
	Снимок.Сеансы.Добавить(Сеанс(1022, "erp", "1CV8C", "Иванов"));
	Снимок.Сеансы.Добавить(Сеанс(1023, "erp", "BackgroundJob", ""));
	Снимок.Сеансы.Добавить(Сеанс(7, "zup", "WebClient", "Петров"));

	// Когда
	Экспортер("1c-cluster").Записать(Снимок);

	// Тогда
	Записи = ЗаписиЛога();
	Ожидаем.Что(Записи).ИмеетДлину(3);
	Ресурсы = РесурсыЗаписейЛога();
	Ожидаем.Что(Ресурсы[0]["service.name"]).Равно("1c-cluster");
	Ожидаем.Что(Ресурсы[0]["v8.infobase.name"]).Равно("erp");
	Ожидаем.Что(Ресурсы[2]["service.name"]).Равно("1c-cluster");
	Ожидаем.Что(Ресурсы[2]["v8.infobase.name"]).Равно("zup");

КонецПроцедуры

&Тест
Процедура ЗаписьСеансаНесетВремяСнимкаСерьезностьИТело() Экспорт

	// Дано
	Снимок = Снимок();
	Снимок.Время = Дата(2025, 5, 17, 15, 19, 44);
	Снимок.Сеансы.Добавить(Сеанс(1022, "erp", "1CV8C", "Иванов"));

	// Когда
	Экспортер().Записать(Снимок);

	// Тогда
	Записи = ЗаписиЛога();
	Ожидаем.Что(Записи).ИмеетДлину(1);
	Ожидаем.Что(Записи[0]["timeUnixNano"]).Равно("1747495184000000000");
	Ожидаем.Что(Записи[0]["severityNumber"]).Равно(9);
	Ожидаем.Что(Записи[0]["body"]["stringValue"]).Равно("Сеанс 1022 1CV8C Иванов");

КонецПроцедуры

&Тест
Процедура ПустыеЧастиТелаПропускаются() Экспорт

	// Дано
	Снимок = Снимок();
	Снимок.Сеансы.Добавить(Сеанс(1023, "erp", "BackgroundJob", ""));
	Сеанс = Новый Структура("Атрибуты", Новый Соответствие);
	Сеанс.Атрибуты.Вставить("v8.cluster.name", "Главный");
	Сеанс.Атрибуты.Вставить("user.name", "Петров");
	Снимок.Сеансы.Добавить(Сеанс);

	// Когда
	Экспортер().Записать(Снимок);

	// Тогда
	Записи = ЗаписиЛога();
	Ожидаем.Что(Записи).ИмеетДлину(2);
	Ожидаем.Что(Записи[0]["body"]["stringValue"]).Равно("Сеанс 1023 BackgroundJob");
	Ожидаем.Что(Записи[1]["body"]["stringValue"]).Равно("Сеанс Петров");

КонецПроцедуры

&Тест
Процедура ОбластьЗаписейСеансов() Экспорт

	// Дано
	Снимок = Снимок();
	Снимок.Сеансы.Добавить(Сеанс(1022, "erp", "1CV8C", "Иванов"));

	// Когда
	Экспортер().Записать(Снимок);

	// Тогда
	Области = ОбластиЗаписейЛога();
	Ожидаем.Что(Области).ИмеетДлину(1);
	Ожидаем.Что(Области[0]).Равно("opentelemetry-v8-logs.cluster");

КонецПроцедуры

&Тест
Процедура АтрибутыСеансаПереносятсяВЗаписьКакЕсть() Экспорт

	// Дано
	Сеанс = Сеанс(1022, "erp", "1CV8C", "Иванов");
	Атрибуты = Сеанс.Атрибуты;
	Атрибуты.Вставить("host.name", "srv1");
	Атрибуты.Вставить("process.pid", 1234);
	Атрибуты.Вставить("v8.session.started_at", "2025-05-17T15:00:00");
	Атрибуты.Вставить("v8.session.hibernated", Ложь);
	Атрибуты.Вставить("v8.session.memory.current", 1048576);
	Атрибуты.Вставить("v8.session.blocked.db", 0);
	Атрибуты.Вставить("v8.session.license.series", "8100000001, 8100000002");
	Снимок = Снимок();
	Снимок.Сеансы.Добавить(Сеанс);

	// Когда
	Экспортер().Записать(Снимок);

	// Тогда
	Запись = ЗаписиЛога()[0];
	Ожидаем.Что(Запись["attributes"]).ИмеетДлину(Атрибуты.Количество() - 1);
	Ожидаем.Что(ЗначениеАтрибута(Запись, "v8.cluster.name")["stringValue"]).Равно("Главный");
	Ожидаем.Что(Число(ЗначениеАтрибута(Запись, "v8.session.id")["intValue"])).Равно(1022);
	Ожидаем.Что(ЗначениеАтрибута(Запись, "v8.session.app_id")["stringValue"]).Равно("1CV8C");
	Ожидаем.Что(ЗначениеАтрибута(Запись, "user.name")["stringValue"]).Равно("Иванов");
	Ожидаем.Что(ЗначениеАтрибута(Запись, "host.name")["stringValue"]).Равно("srv1");
	Ожидаем.Что(Число(ЗначениеАтрибута(Запись, "process.pid")["intValue"])).Равно(1234);
	Ожидаем.Что(ЗначениеАтрибута(Запись, "v8.session.started_at")["stringValue"]).Равно("2025-05-17T15:00:00");
	Ожидаем.Что(ЗначениеАтрибута(Запись, "v8.session.hibernated")["boolValue"]).Равно(Ложь);
	Ожидаем.Что(Число(ЗначениеАтрибута(Запись, "v8.session.memory.current")["intValue"])).Равно(1048576);
	Ожидаем.Что(Число(ЗначениеАтрибута(Запись, "v8.session.blocked.db")["intValue"])).Равно(0);
	Ожидаем.Что(ЗначениеАтрибута(Запись, "v8.session.license.series")["stringValue"])
		.Равно("8100000001, 8100000002");

КонецПроцедуры

&Тест
Процедура БазаСеансаТолькоВРесурсеЗаписи() Экспорт

	// Дано
	Снимок = Снимок();
	Снимок.Сеансы.Добавить(Сеанс(1022, "erp", "1CV8C", "Иванов"));

	// Когда
	Экспортер().Записать(Снимок);

	// Тогда: ключ метаданных совпал бы с меткой потока Loki v8_infobase_name
	Ожидаем.Что(РесурсыЗаписейЛога()[0]["v8.infobase.name"]).Равно("erp");
	Ожидаем.Что(АтрибутыСтроками(ЗаписиЛога()[0])["v8.infobase.name"]).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура СеансБезБазыИдетВРесурсБезБазы() Экспорт

	// Дано
	Сеанс = Сеанс(5, "", "RAS", "");
	Снимок = Снимок();
	Снимок.Сеансы.Добавить(Сеанс);

	// Когда
	Экспортер("1c-cluster").Записать(Снимок);

	// Тогда
	Ресурсы = РесурсыЗаписейЛога();
	Ожидаем.Что(Ресурсы).ИмеетДлину(1);
	Ожидаем.Что(Ресурсы[0]["service.name"]).Равно("1c-cluster");
	Ожидаем.Что(Ресурсы[0]["v8.infobase.name"]).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура НедоступныйСнимокНеПишетЗаписей() Экспорт

	// Дано
	Снимок = Снимок(Ложь);
	Снимок.Ошибка = "Нет связи с RAS";
	Снимок.Сеансы.Добавить(Сеанс(1022, "erp", "1CV8C", "Иванов"));

	// Когда
	Экспортер().Записать(Снимок);

	// Тогда
	Ожидаем.Что(ЗаписиЛога()).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура СнимокБезСеансовНеПишетЗаписей() Экспорт

	// Дано
	Снимок = Снимок();

	// Когда
	Экспортер().Записать(Снимок);

	// Тогда
	Ожидаем.Что(ЗаписиЛога()).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ПовторныйСнимокПишетТолькоСвоиСеансы() Экспорт

	// Дано
	Экспортер = Экспортер();
	Снимок = Снимок();
	Снимок.Сеансы.Добавить(Сеанс(1022, "erp", "1CV8C", "Иванов"));
	Снимок.Сеансы.Добавить(Сеанс(7, "zup", "WebClient", "Петров"));
	Экспортер.Записать(Снимок);
	Ожидаем.Что(ЗаписиЛога()).ИмеетДлину(2);

	// Когда
	Экспортер.Записать(Снимок);

	// Тогда
	Ожидаем.Что(ЗаписиЛога()).ИмеетДлину(4);
	Ресурсы = РесурсыЗаписейЛога();
	Ожидаем.Что(Ресурсы[2]["v8.infobase.name"]).Равно("erp");
	Ожидаем.Что(Ресурсы[3]["v8.infobase.name"]).Равно("zup");

КонецПроцедуры

Функция Экспортер(ИмяСервиса = "1c-cluster")
	Возврат ТабакеркаЭкспортеров.Достать(Массивы.ИзЭлементов(Телеметрия, ИмяСервиса));
КонецФункции

Функция Снимок(Доступен = Истина)
	Снимок = Новый Структура;
	Снимок.Вставить("Время", ТекущаяУниверсальнаяДата());
	Снимок.Вставить("Доступен", Доступен);
	Снимок.Вставить("Ошибка", "");
	Снимок.Вставить("Показатели", Новый Массив);
	Снимок.Вставить("Сеансы", Новый Массив);
	Снимок.Вставить("Предупреждения", Новый Массив);
	Возврат Снимок;
КонецФункции

// Сеанс снимка: пустые строки, как у опросчика, не ставятся
Функция Сеанс(Номер, База, Приложение, Пользователь)
	Атрибуты = Новый Соответствие;
	Атрибуты.Вставить("v8.cluster.name", "Главный");
	Если ЗначениеЗаполнено(База) Тогда
		Атрибуты.Вставить("v8.infobase.name", База);
	КонецЕсли;
	Атрибуты.Вставить("v8.session.id", Номер);
	Если ЗначениеЗаполнено(Приложение) Тогда
		Атрибуты.Вставить("v8.session.app_id", Приложение);
	КонецЕсли;
	Если ЗначениеЗаполнено(Пользователь) Тогда
		Атрибуты.Вставить("user.name", Пользователь);
	КонецЕсли;
	Возврат Новый Структура("Атрибуты", Атрибуты);
КонецФункции

Функция ЗаписиЛога()
	Результат = Новый Массив;
	Для Каждого Отправка Из ТранспортЛогов.ПолучитьОтправленные() Цикл
		Для Каждого РесурсныеЛоги Из Отправка["Данные"]["resourceLogs"] Цикл
			Для Каждого ЛогиОбласти Из РесурсныеЛоги["scopeLogs"] Цикл
				Для Каждого Запись Из ЛогиОбласти["logRecords"] Цикл
					Результат.Добавить(Запись);
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Атрибуты ресурса каждой записи лога в порядке отправки
Функция РесурсыЗаписейЛога()
	Результат = Новый Массив;
	Для Каждого Отправка Из ТранспортЛогов.ПолучитьОтправленные() Цикл
		Для Каждого РесурсныеЛоги Из Отправка["Данные"]["resourceLogs"] Цикл
			АтрибутыРесурса = АтрибутыСтроками(РесурсныеЛоги["resource"]);
			Для Каждого ЛогиОбласти Из РесурсныеЛоги["scopeLogs"] Цикл
				Для Каждого Запись Из ЛогиОбласти["logRecords"] Цикл
					Результат.Добавить(АтрибутыРесурса);
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Различные имена областей отправленных записей
Функция ОбластиЗаписейЛога()
	Результат = Новый Массив;
	Для Каждого Отправка Из ТранспортЛогов.ПолучитьОтправленные() Цикл
		Для Каждого РесурсныеЛоги Из Отправка["Данные"]["resourceLogs"] Цикл
			Для Каждого ЛогиОбласти Из РесурсныеЛоги["scopeLogs"] Цикл
				Имя = ЛогиОбласти["scope"]["name"];
				Если Результат.Найти(Имя) = Неопределено Тогда
					Результат.Добавить(Имя);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Атрибуты OTLP в виде соответствия ключ -> строковое представление значения
Функция АтрибутыСтроками(Объект)
	Результат = Новый Соответствие;
	Если Объект = Неопределено ИЛИ Объект["attributes"] = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Атрибут Из Объект["attributes"] Цикл
		Для Каждого Вид Из Атрибут["value"] Цикл
			Результат.Вставить(Атрибут["key"], Строка(Вид.Значение));
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ЗначениеАтрибута(Запись, Имя)
	Для Каждого Атрибут Из Запись["attributes"] Цикл
		Если Атрибут["key"] = Имя Тогда
			Возврат Атрибут["value"];
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "Не найден атрибут " + Имя;
КонецФункции
