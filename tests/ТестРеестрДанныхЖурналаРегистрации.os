&Тест
Процедура РегистрацияИзолируетФормуИЗапрещаетИзменятьПоля() Экспорт

	Формы = Новый КонструкторыДанныхЖурналаРегистрации;
	Форма = Формы.Позиционная("P").Поля("Name");
	Поле = ПоляДанныхСобытийЖурналаРегистрации.Событие("test.registry.snapshot")
		.Поле("Name").ТипПоля("Строка");
	Поле.Форма(Форма).Зарегистрировать();
	Форма.Поле("Extra");
	Данные = Разобрать("test.registry.snapshot", "{P,{{S,User}}}");
	Ожидаем.Что(Данные["Name"]).Равно("User");
	ОжидатьОшибку(Поле, "Пропустить", Новый Массив, "уже зарегистрировано");

КонецПроцедуры

Функция Разобрать(Код, Текст)

	Узел = ПарсерСкобочногоФормата.Разобрать(Текст).Записи[0];
	Возврат РазборДанныхЖурналаРегистрации.Разобрать(Код, Узел);

КонецФункции

Процедура ОжидатьОшибку(Объект, Метод, Параметры, ЧастьТекста)

	Ошибка = "";
	Попытка
		Рефлектор = Новый Рефлектор;
		Рефлектор.ВызватьМетод(Объект, Метод, Параметры);
	Исключение
		Ошибка = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(СтрНайти(Ошибка, ЧастьТекста) > 0, Ошибка).ЭтоИстина();

