// BSLLS:DuplicateStringLiteral-off
// BSLLS:MagicNumber-off
#Использовать "../src/ЖурналРегистрации"
#Использовать asserts

&Пластилин
Перем ПоляДанныхСобытийЖурналаРегистрации;
&Пластилин
Перем РазборДанныхЖурналаРегистрации;
&Пластилин
Перем ПарсерСкобочногоФормата;

&Тест
Процедура ПереименованиеСохраняетМассивАКоличествоАгрегирует() Экспорт

	Формы = Новый КонструкторыДанныхЖурналаРегистрации;
	ПоляДанныхСобытийЖурналаРегистрации.Событие("test.registry.rename")
		.Поле("Names").ТипПоля("МассивСтрок").Как("Aliases")
		.Поле("OtherNames").ТипПоля("МассивСтрок").Как("Count", Формы.Количество())
		.Форма(Формы.Позиционная("P").ВсеПоля())
		.Зарегистрировать();
	Данные = Разобрать("test.registry.rename", "{P,{{A,{2,{S,A},{S,B}}},{A,{1,{S,C}}}}}");
	Ожидаем.Что(ТипЗнч(Данные["Aliases"])).Равно(Тип("Массив"));
	Ожидаем.Что(СтрСоединить(Данные["Aliases"], ",")).Равно("A,B");
	Ожидаем.Что(Данные["Count"]).Равно("1");
	Ожидаем.Что(Данные["Names"]).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура УникальныеСтрокиУчитываютРегистрПробелыИПустыеЗначения() Экспорт

	Формы = Новый КонструкторыДанныхЖурналаРегистрации;
	ПоляДанныхСобытийЖурналаРегистрации.Событие("test.registry.unique.strings")
		.Поле("Names").ТипПоля("МассивСтрок").Как("UniqueCount", Формы.КоличествоУникальных())
		.Поле("AllNames").ТипПоля("МассивСтрок").Как("Count", Формы.Количество())
		.Форма(Формы.Позиционная("P").ВсеПоля())
		.Зарегистрировать();

	МассивСтрок = "{A,{7,{S,a},{S,a},{S,A},{S,""""},{S,""""},{S,""a ""},{S,a}}}";
	Данные = Разобрать("test.registry.unique.strings", "{P,{" + МассивСтрок + "," + МассивСтрок + "}}");
	Ожидаем.Что(Данные["UniqueCount"]).Равно("4");
	Ожидаем.Что(Данные["Count"]).Равно("7");

	Данные = Разобрать("test.registry.unique.strings", "{P,{{A,{0}},{A,{0}}}}");
	Ожидаем.Что(Данные["UniqueCount"]).Равно("0");
	Ожидаем.Что(Данные["Count"]).Равно("0");

КонецПроцедуры

&Тест
Процедура УникальныеСсылкиСравниваютсяПоТипуИОбъектуБезУчетаРегистраUUID() Экспорт

	Формы = Новый КонструкторыДанныхЖурналаРегистрации;
	ПоляДанныхСобытийЖурналаРегистрации.Событие("test.registry.unique.references")
		.Поле("Roles").ТипПоля("МассивСсылок").Как("UniqueCount", Формы.КоличествоУникальных())
		.Поле("AllRoles").ТипПоля("МассивСсылок").Как("Count", Формы.Количество())
		.Форма(Формы.Позиционная("P").ВсеПоля())
		.Зарегистрировать();

	Первая = "{O,{#,fc01b5df-97fe-449b-83d4-218a090e681e,abcdefab-1234-5678-9abc-def012345678}}";
	ДругойТип = "{O,{#,fc01b5df-97fe-449b-83d4-218a090e681f,abcdefab-1234-5678-9abc-def012345678}}";
	ДругойОбъект = "{O,{#,fc01b5df-97fe-449b-83d4-218a090e681e,abcdefab-1234-5678-9abc-def012345679}}";
	Ссылки = "{A,{4," + Первая + "," + ВРег(Первая) + "," + ДругойТип + "," + ДругойОбъект + "}}";
	Данные = Разобрать("test.registry.unique.references", "{P,{" + Ссылки + "," + Ссылки + "}}");
	Ожидаем.Что(Данные["UniqueCount"]).Равно("3");
	Ожидаем.Что(Данные["Count"]).Равно("4");

	Данные = Разобрать("test.registry.unique.references", "{P,{{A,{0}},{A,{0}}}}");
	Ожидаем.Что(Данные["UniqueCount"]).Равно("0");

КонецПроцедуры

&Тест
Процедура ПодсчетУникальныхПроверяетВсеЭлементыИСчетчикМассива() Экспорт

	Формы = Новый КонструкторыДанныхЖурналаРегистрации;
	Для Каждого ТипМассива Из СтрРазделить("МассивСтрок,МассивСсылок", ",") Цикл
		Код = "test.registry.unique.invalid." + ТипМассива;
		ПоляДанныхСобытийЖурналаРегистрации.Событие(Код)
			.Поле("Items").ТипПоля(ТипМассива).Как("Count", Формы.КоличествоУникальных())
			.Форма(Формы.Позиционная("P").ВсеПоля())
			.Зарегистрировать();

		Элемент = ?(ТипМассива = "МассивСтрок", "{S,a}",
			"{O,{#,fc01b5df-97fe-449b-83d4-218a090e681e,abcdefab-1234-5678-9abc-def012345678}}");
		Неверные = Новый Массив;
		Неверные.Добавить("{P,{{A,{3," + Элемент + "," + Элемент + ",{N,1}}}}}");
		Неверные.Добавить("{P,{{A,{2," + Элемент + "}}}}");
		Неверные.Добавить("{P,{{A,{1," + Элемент + "," + Элемент + "}}}}");
		Неверные.Добавить("{P,{{A,{1,{O,{#,invalid,invalid}}}}}}");

		Для Каждого Текст Из Неверные Цикл
			Данные = Разобрать(Код, Текст);
			Ожидаем.Что(Данные["$format"]).Равно("1c-brackets-v1");
			Ожидаем.Что(Данные["Count"]).Равно(Неопределено);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура КоличествоУникальныхДоступноТолькоМассивамБезПреобразования() Экспорт

	Реестр = Новый ПоляДанныхСобытийЖурналаРегистрации;
	Агрегаты = Новый КонструкторыДанныхЖурналаРегистрации;
	Параметры = Новый Массив;
	Параметры.Добавить("Count");
	Параметры.Добавить(Агрегаты.КоличествоУникальных());

	Поле = Реестр.Событие("test.invalid.unique.scalar").Поле("Name").ТипПоля("Строка");
	ОжидатьОшибку(Поле, "Как", Параметры, "Агрегат применяется только к массивам");

	Поле = Реестр.Событие("test.invalid.unique.item").Поле("Names")
		.ТипПоля("МассивСтрок").ЭлементыВыгрузки();
	ОжидатьОшибку(Поле, "Как", Параметры, "Агрегат нельзя совмещать");

	Поле = Реестр.Событие("test.invalid.unique.aggregate").Поле("Names")
		.ТипПоля("МассивСтрок").Как("Count", Агрегаты.КоличествоУникальных());
	ОжидатьОшибку(Поле, "ЭлементыВыгрузки", Новый Массив, "без агрегата");

КонецПроцедуры

&Тест
Процедура ПропускНеУбираетПроверкуИСлотИсходногоПоля() Экспорт

	Формы = Новый КонструкторыДанныхЖурналаРегистрации;
	ПоляДанныхСобытийЖурналаРегистрации.Событие("test.registry.skip")
		.Поле("Roles").ТипПоля("МассивСсылок").Пропустить()
		.Поле("Name").ТипПоля("Строка")
		.Форма(Формы.Позиционная("P").ВсеПоля())
		.Зарегистрировать();
	Данные = Разобрать("test.registry.skip", "{P,{{A,{0}},{S,User}}}");
	Ожидаем.Что(Данные.Количество()).Равно(1);
	Ожидаем.Что(Данные["Name"]).Равно("User");
	Данные = Разобрать("test.registry.skip", "{P,{{A,{1,{S,broken}}},{S,User}}}");
	Ожидаем.Что(Данные["$format"]).Равно("1c-brackets-v1");

КонецПроцедуры

&Тест
Процедура ИсключениеПоляИзФормыСдвигаетФизическиеПозиции() Экспорт

	Формы = Новый КонструкторыДанныхЖурналаРегистрации;
	Исключенные = СтрРазделить("Interface,Legacy", ",");
	ПоляДанныхСобытийЖурналаРегистрации.Событие("test.registry.except")
		.Поле("Name").ТипПоля("Строка")
		.Поле("Interface").ТипПоля("Ссылка")
		.Поле("Legacy").ТипПоля("Незаданное")
		.Поле("Enabled").ТипПоля("Булево")
		.Форма(Формы.Позиционная("P", "old").ВсеПоляКроме("Interface,Legacy"))
		.Форма(Формы.Позиционная("P", "new").ВсеПоляКроме(Исключенные))
		.Зарегистрировать();
	Для Каждого Маркер Из СтрРазделить("old,new", ",") Цикл
		Данные = Разобрать("test.registry.except", "{P,{" + Маркер + ",{S,User},{B,1}}}");
		Ожидаем.Что(Данные["Name"]).Равно("User");
		Ожидаем.Что(Данные["Enabled"]).Равно("true");
		Ожидаем.Что(Данные.Количество()).Равно(2);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ЯвныеСпискиИЦепочкаПолейЗадаютПорядокЧтения() Экспорт

	Формы = Новый КонструкторыДанныхЖурналаРегистрации;
	ПоляДанныхСобытийЖурналаРегистрации.Событие("test.registry.order")
		.Поле("Name").ТипПоля("Строка")
		.Поле("Enabled").ТипПоля("Булево")
		.Форма(Формы.Позиционная("P", "csv").Поля("Enabled,Name"))
		.Форма(Формы.Позиционная("P", "array").Поля(СтрРазделить("Enabled,Name", ",")))
		.Форма(Формы.Позиционная("P", "chain").Поле("Enabled").Поле("Name"))
		.Зарегистрировать();
	Для Каждого Маркер Из СтрРазделить("csv,array,chain", ",") Цикл
		Данные = Разобрать("test.registry.order", "{P,{" + Маркер + ",{B,0},{S,User}}}");
		Ожидаем.Что(Данные["Name"]).Равно("User");
		Ожидаем.Что(Данные["Enabled"]).Равно("false");
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура МаскаЧитаетПоВозрастаниюБитовИНеРазрешаетДругиеКомбинации() Экспорт

	Формы = Новый КонструкторыДанныхЖурналаРегистрации;
