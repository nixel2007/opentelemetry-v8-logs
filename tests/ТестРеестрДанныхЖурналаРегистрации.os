&Тест
Процедура ВложеннаяФормаПроверяетРазмерыЛитералыИТипы() Экспорт

	Формы = Новый КонструкторыДанныхЖурналаРегистрации;
	ПоляДанныхСобытийЖурналаРегистрации.Событие("test.registry.nested")
		.Поле("Name").ТипПоля("Строка")
		.Форма(Формы.Структура("P").Размер(2).Литерал("0", "1")
			.РазмерУзла("1", 2).Литерал("1.0", "Имя").ПолеПоПути("Name", "1.1"))
		.Зарегистрировать();
	Данные = Разобрать("test.registry.nested", "{P,{1,{Имя,{S,User}}}}");
	Ожидаем.Что(Данные["Name"]).Равно("User");
	Неверные = Новый Массив;
	Неверные.Добавить("{P,{1,{Другое,{S,User}}}}");
	Неверные.Добавить("{P,{1,{Имя,{S,User},extra}}}");
	Неверные.Добавить("{P,{1,{Имя,{N,1}}}}");
	Неверные.Добавить("{P,{1,{Имя,{S,User}},extra}}");
	Для Каждого Текст Из Неверные Цикл
		Данные = Разобрать("test.registry.nested", Текст);
		Ожидаем.Что(Данные["Name"]).Равно(Неопределено);
		Ожидаем.Что(Данные["nodes"] <> Неопределено).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

