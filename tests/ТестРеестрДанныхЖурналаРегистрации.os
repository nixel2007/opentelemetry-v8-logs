	Поле = Реестр.Событие("test.invalid.type").Поле("Name");
	Параметры = Новый Массив;
	Параметры.Добавить("Несуществующий");
	ОжидатьОшибку(Поле, "ТипПоля", Параметры, "Неизвестный тип поля");
	Событие = Поле.Форма(Формы.Позиционная("P").ВсеПоля());
	ОжидатьОшибку(Событие, "Зарегистрировать", Новый Массив, "Не задан тип поля");
	Ожидаем.Что(Реестр.Описание("test.invalid.type")).Равно(Неопределено);
	Поле.ТипПоля("Строка");
	Параметры[0] = "Число";
	ОжидатьОшибку(Поле, "ТипПоля", Параметры, "Тип поля уже задан");

