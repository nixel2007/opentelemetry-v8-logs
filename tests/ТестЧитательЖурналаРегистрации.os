// BSLLS:MagicNumber-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
#Использовать "../src/ЖурналРегистрации"
#Использовать asserts
#Использовать tempfiles
#Использовать collectionos

&Табакерка
&Пластилин("ЧитательЖурналаРегистрации")
Перем ТабакеркаЧитателей;

Перем ПС;
Перем ВременныеФайлыТеста;
Перем Каталог;
Перем Хранилище;
Перем Полученные; // Массив из Структура("Запись, Журнал")

&ПередКаждым
Процедура Подготовить() Экспорт
	ВременныеФайлыТеста = Новый МенеджерВременныхФайлов;
	Каталог = ОбъединитьПути(ВременныеФайлыТеста.СоздатьКаталог(), "ib-guid", "1Cv8Log");
	СоздатьКаталог(Каталог);
	Хранилище = Новый ХранилищеПозицийВПамяти;
	Полученные = Новый Массив;
КонецПроцедуры

&ПослеКаждого
Процедура УдалитьВременныеФайлы() Экспорт
	ВременныеФайлыТеста.Удалить();
КонецПроцедуры

// Обработчик записей для читателя
Процедура ОбработатьЗаписиЖурналаРегистрации(Записи, ОписаниеЖурнала) Экспорт
	Для Каждого Запись Из Записи Цикл
		Полученные.Добавить(Новый Структура("Запись, Журнал", Запись, ОписаниеЖурнала));
	КонецЦикла;
КонецПроцедуры

&Тест
Процедура ЧтениеЗаписейСоСловарем() Экспорт

	// Дано
	ДописатьСловарь(ЗаголовокФайла()
		+ "{1,8368e8b0-9829-4ae2-92bd-8d4ddd658d9a,""Администратор"",1}," + ПС
		+ "{2,""COMP"",1}," + ПС
		+ "{3,""1CV8C"",1}," + ПС
		+ "{4,""_$Session$_.Start"",1}," + ПС);
	Дописать("20251020000000.lgp", ЗаголовокФайла() + Запись("20251020090512", "I", "Начало"));

	// Когда
	Читатель = ЧитательКаталога();
	Количество = Читатель.Прочитать(ЭтотОбъект);

	// Тогда
	Ожидаем.Что(Количество).Равно(1);
	Запись = Полученные[0].Запись;
	Ожидаем.Что(Запись.Время).Равно(Дата(2025, 10, 20, 9, 5, 12));
	Ожидаем.Что(Запись.Пользователь).Равно("Администратор");
	Ожидаем.Что(Запись.Компьютер).Равно("COMP");
	Ожидаем.Что(Запись.Приложение).Равно("1CV8C");
	Ожидаем.Что(Запись.Событие).Равно("_$Session$_.Start");
	Ожидаем.Что(Запись.Комментарий).Равно("Начало");
	Ожидаем.Что(Полученные[0].Журнал.ИнформационнаяБаза).Равно("ib-guid");
	Ожидаем.Что(Полученные[0].Журнал.Путь).Равно(ОбъединитьПути(Каталог, "20251020000000.lgp"));

КонецПроцедуры

&Тест
Процедура ИмяИнформационнойБазыИзПараметров() Экспорт

	// Дано
	ДописатьСловарь(ЗаголовокФайла());
	Дописать("20251020000000.lgp", ЗаголовокФайла() + Запись("20251020090512", "I", ""));

	// Когда
	Читатель = ЧитательКаталога("erp");
	Читатель.Прочитать(ЭтотОбъект);

	// Тогда
	Ожидаем.Что(Полученные[0].Журнал.ИнформационнаяБаза).Равно("erp");

КонецПроцедуры

&Тест
Процедура ДописанныеСловарьИЗаписиЧитаютсяСледующимПроходом() Экспорт

	// Дано
	ДописатьСловарь(ЗаголовокФайла() + "{4,""_$Session$_.Start"",1}," + ПС);
	Дописать("20251020000000.lgp", ЗаголовокФайла() + Запись("20251020090512", "I", "первая"));
	Читатель = ЧитательКаталога();
	Читатель.Прочитать(ЭтотОбъект);
	Полученные.Очистить();

	// Когда
	ДописатьСловарь("{4,""_$Session$_.Finish"",2}," + ПС);
	Дописать("20251020000000.lgp", Запись("20251020090513", "I", "вторая", 2));
	Читатель.Прочитать(ЭтотОбъект);

	// Тогда
	Ожидаем.Что(Полученные).ИмеетДлину(1);
	Ожидаем.Что(Полученные[0].Запись.Комментарий).Равно("вторая");
	Ожидаем.Что(Полученные[0].Запись.Событие).Равно("_$Session$_.Finish");

КонецПроцедуры

&Тест
Процедура НезавершеннаяЗаписьДочитываетсяПозже() Экспорт

	// Дано
	ДописатьСловарь(ЗаголовокФайла());
	Полная = Запись("20251020090512", "E", "многострочный" + ПС + "комментарий");
	Граница = СтрНайти(Полная, "комментарий");
	Дописать("20251020000000.lgp", ЗаголовокФайла() + Лев(Полная, Граница - 1));
	Читатель = ЧитательКаталога();
	Читатель.Прочитать(ЭтотОбъект);
	Ожидаем.Что(Полученные).ИмеетДлину(0);

	// Когда
	Дописать("20251020000000.lgp", Сред(Полная, Граница));
	Читатель.Прочитать(ЭтотОбъект);

	// Тогда
	Ожидаем.Что(Полученные).ИмеетДлину(1);
	Ожидаем.Что(Полученные[0].Запись.Комментарий).Равно("многострочный" + ПС + "комментарий");
	Ожидаем.Что(Полученные[0].Запись.Важность).Равно("E");

КонецПроцедуры

&Тест
Процедура ПослеПерезапускаСловарьЧитаетсяЗановоАЗаписиПродолжаются() Экспорт

	// Дано
	ДописатьСловарь(ЗаголовокФайла() + "{4,""_$Session$_.Start"",1}," + ПС);
	Дописать("20251020000000.lgp", ЗаголовокФайла() + Запись("20251020090512", "I", "первая"));
	Читатель = ЧитательКаталога();
	Читатель.Прочитать(ЭтотОбъект);
	Читатель.ЗафиксироватьПозиции();
	Дописать("20251020000000.lgp", Запись("20251020090513", "I", "вторая"));
	Полученные.Очистить();

	// Когда
	НовыйЧитатель = ЧитательКаталога();
	НовыйЧитатель.Прочитать(ЭтотОбъект);

	// Тогда
	Ожидаем.Что(Полученные).ИмеетДлину(1);
	Ожидаем.Что(Полученные[0].Запись.Комментарий).Равно("вторая");
	Ожидаем.Что(Полученные[0].Запись.Событие).Равно("_$Session$_.Start");

КонецПроцедуры

&Тест
Процедура ФайлыЧитаютсяПоПорядку() Экспорт

	// Дано
	ДописатьСловарь(ЗаголовокФайла());
	Дописать("20251021000000.lgp", ЗаголовокФайла() + Запись("20251021000001", "I", "вторая"));
	Дописать("20251020000000.lgp", ЗаголовокФайла() + Запись("20251020235959", "I", "первая"));

	// Когда
	Читатель = ЧитательКаталога();
	Читатель.Прочитать(ЭтотОбъект);

	// Тогда
	Ожидаем.Что(Полученные).ИмеетДлину(2);
	Ожидаем.Что(Полученные[0].Запись.Комментарий).Равно("первая");
	Ожидаем.Что(Полученные[1].Запись.Комментарий).Равно("вторая");

КонецПроцедуры

&Тест
Процедура НачалоСКонцаПропускаетСуществующиеЗаписи() Экспорт

	// Дано
	ДописатьСловарь(ЗаголовокФайла() + "{4,""_$Session$_.Start"",1}," + ПС);
	Дописать("20251020000000.lgp", ЗаголовокФайла() + Запись("20251020090512", "I", "старая"));
	Читатель = ЧитательКаталога(, Истина);
	Читатель.Прочитать(ЭтотОбъект);
	Ожидаем.Что(Полученные).ИмеетДлину(0);

	// Когда
	Дописать("20251020000000.lgp", Запись("20251020090513", "I", "новая"));
	Читатель.Прочитать(ЭтотОбъект);

	// Тогда - словарь прочитан целиком, хотя записи пропущены
	Ожидаем.Что(Полученные).ИмеетДлину(1);
	Ожидаем.Что(Полученные[0].Запись.Комментарий).Равно("новая");
	Ожидаем.Что(Полученные[0].Запись.Событие).Равно("_$Session$_.Start");

КонецПроцедуры

&Тест
Процедура ПоследняяЗаписьБезПереводаСтрокиЧитаетсяСразу() Экспорт

	// Дано - платформа ставит разделитель ",<перевод строки>" перед следующей записью,
	// поэтому последняя запись файла не заканчивается переводом строки
	ДописатьСловарь(ЗаголовокФайла() + "{4,""_$Session$_.Start"",1}");
	Дописать("20251020000000.lgp", ЗаголовокФайла() + ЗаписьПлатформы("20251020090512", "первая"));
	Читатель = ЧитательКаталога();
	Читатель.Прочитать(ЭтотОбъект);
	Ожидаем.Что(Полученные).ИмеетДлину(1);
	Полученные.Очистить();

	// Когда
	ДописатьСловарь("," + Символы.ВК + ПС + "{4,""_$Session$_.Finish"",2}");
	Дописать("20251020000000.lgp", "," + Символы.ВК + ПС + ЗаписьПлатформы("20251020090513", "вторая", 2));
	Читатель.Прочитать(ЭтотОбъект);

	// Тогда
	Ожидаем.Что(Полученные).ИмеетДлину(1);
	Ожидаем.Что(Полученные[0].Запись.Комментарий).Равно("вторая");
	Ожидаем.Что(Полученные[0].Запись.Событие).Равно("_$Session$_.Finish");

КонецПроцедуры

&Тест
Процедура НекорректнаяЗаписьПропускается() Экспорт

	// Дано
	ДописатьСловарь(ЗаголовокФайла());
	Дописать("20251020000000.lgp", ЗаголовокФайла() + "{20251020090512,N}," + ПС
		+ Запись("20251020090513", "I", "корректная"));

	// Когда
	Читатель = ЧитательКаталога();
	Читатель.Прочитать(ЭтотОбъект);

	// Тогда
	Ожидаем.Что(Полученные).ИмеетДлину(1);
	Ожидаем.Что(Полученные[0].Запись.Комментарий).Равно("корректная");

КонецПроцедуры

&Тест
Процедура КаталогБезСловаряНеЧитается() Экспорт

	// Дано
	Дописать("20251020000000.lgp", ЗаголовокФайла() + Запись("20251020090512", "I", ""));

	// Когда
	Читатель = ЧитательКаталога();
	Количество = Читатель.Прочитать(ЭтотОбъект);

	// Тогда
	Ожидаем.Что(Количество).Равно(0);

КонецПроцедуры

Функция ЧитательКаталога(ИмяБазы = "", НачинатьСКонца = Ложь)
	Возврат ТабакеркаЧитателей.Достать(Массивы.ИзЭлементов(Каталог, Хранилище, ИмяБазы, НачинатьСКонца, 4194304));
КонецФункции

Функция ЗаголовокФайла()
	Возврат Символ(65279) + "1CV8LOG(ver 2.0)" + ПС + "1ed9cff4-8a21-4bf4-8f5b-08731ea05d24" + ПС + ПС;
КонецФункции

Функция Запись(Время, Важность, Комментарий, Событие = 1)
	Возврат СтрШаблон("{%1,N,%3{0,0},1,1,1,1,%4,%2,""%5"",0,%3{""U""},"""",0,0,0,1,0,%3{0}%3},%3",
		Время, Важность, ПС, Формат(Событие, "ЧГ=0"), СтрЗаменить(Комментарий, """", """"""));
КонецФункции

// Запись в том виде, в каком ее пишет платформа: CRLF внутри, без разделителя в конце
Функция ЗаписьПлатформы(Время, Комментарий, Событие = 1)
	ВКПС = Символы.ВК + ПС;
	Возврат СтрШаблон("{%1,N,%3{0,0},1,1,1,1,%4,I,""%2"",0,%3{""U""},"""",0,0,0,1,0,%3{0}%3}",
		Время, Комментарий, ВКПС, Формат(Событие, "ЧГ=0"));
КонецФункции

Процедура ДописатьСловарь(Текст)
	Дописать("1Cv8.lgf", Текст);
КонецПроцедуры

Процедура Дописать(ИмяФайла, Текст)

	Путь = ОбъединитьПути(Каталог, ИмяФайла);
	Буфер = ПолучитьБуферДвоичныхДанныхИзСтроки(Текст, "UTF-8", Ложь);
	Поток = Новый ФайловыйПоток(Путь, РежимОткрытияФайла.ОткрытьИлиСоздать, ДоступКФайлу.Запись);
	Поток.Перейти(0, ПозицияВПотоке.Конец);
	Поток.Записать(Буфер, 0, Буфер.Размер);
	Поток.Закрыть();

КонецПроцедуры

ПС = Символы.ПС;
