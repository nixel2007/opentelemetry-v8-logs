// BSLLS:MagicNumber-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
#Использовать "../src/ТехнологическийЖурнал"
#Использовать asserts
#Использовать tempfiles
#Использовать logos
#Использовать collectionos

&Табакерка
&Пластилин("ЧитательТехнологическогоЖурнала")
Перем ТабакеркаЧитателей;

Перем ПС;
Перем ВременныеФайлыТеста;
Перем Каталог;
Перем Хранилище;
Перем Полученные; // Массив из Структура("Событие, Файл")
Перем СообщенияЛога; // Массив из Строка

&ПередКаждым
Процедура Подготовить() Экспорт
	ВременныеФайлыТеста = Новый МенеджерВременныхФайлов;
	Каталог = ВременныеФайлыТеста.СоздатьКаталог();
	Хранилище = Новый ХранилищеПозицийВПамяти;
	Полученные = Новый Массив;
	СообщенияЛога = Новый Массив;
	Логирование.ПолучитьЛог("oscript.app.opentelemetry-v8-logs").ДобавитьСпособВывода(ЭтотОбъект);
КонецПроцедуры

&ПослеКаждого
Процедура УдалитьВременныеФайлы() Экспорт
	Логирование.ПолучитьЛог("oscript.app.opentelemetry-v8-logs").УдалитьСпособВывода(ЭтотОбъект);
	ВременныеФайлыТеста.Удалить();
КонецПроцедуры

// Способ вывода лога приложения
Процедура Вывести(Знач Сообщение, Знач УровеньСообщения) Экспорт
	СообщенияЛога.Добавить(Сообщение);
КонецПроцедуры

// Способ вывода лога приложения
Процедура Закрыть() Экспорт
	Возврат;
КонецПроцедуры

// Обработчик событий для читателя
Процедура ОбработатьСобытияТехнологическогоЖурнала(События, ОписаниеФайла) Экспорт
	Для Каждого Событие Из События Цикл
		Полученные.Добавить(Новый Структура("Событие, Файл", Событие, ОписаниеФайла));
	КонецЦикла;
КонецПроцедуры

&Тест
Процедура ЧтениеСобытийИзКаталоговПроцессов() Экспорт

	// Дано
	Дописать("rphost_1234/26102009.log", "05:12.345678-15,CALL,1,Usr=Admin" + ПС, Истина);
	Дописать("rmngr_77/26102009.log", "05:13.000001-1,CONN,0,Txt=ok" + ПС, Истина);

	// Когда
	Читатель = ЧитательКаталога();
	Количество = Читатель.Прочитать(ЭтотОбъект);

	// Тогда
	Ожидаем.Что(Количество).Равно(2);
	Ожидаем.Что(Полученные).ИмеетДлину(2);
	Вызов = НайтиСобытие("CALL");
	Ожидаем.Что(Вызов.Событие.Время).Равно(Дата(2026, 10, 20, 9, 5, 12));
	Ожидаем.Что(Вызов.Файл.Процесс).Равно("rphost");
	Ожидаем.Что(Вызов.Файл.ИдПроцесса).Равно("1234");
	Ожидаем.Что(Вызов.Файл.Путь).Равно(ПутьВКаталоге("rphost_1234/26102009.log"));
	Ожидаем.Что(НайтиСобытие("CONN").Файл.Процесс).Равно("rmngr");

КонецПроцедуры

&Тест
Процедура НачалоСКонцаНеТеряетДописанноеПослеОтката() Экспорт

	// Дано - первый проход с конца, отправка не удалась
	Дописать("rphost_1/26102009.log", "05:12.000001-15,CALL,1,Usr=Admin" + ПС, Истина);
	Читатель = ЧитательКаталога(Истина);
	Читатель.Прочитать(ЭтотОбъект);
	Читатель.ОткатитьПозиции();

	// Когда
	Дописать("rphost_1/26102009.log", "05:13.000001-1,SCALL,1,Usr=Admin" + ПС);
	Читатель.Прочитать(ЭтотОбъект);

	// Тогда
	Ожидаем.Что(Полученные).ИмеетДлину(1);
	Ожидаем.Что(Полученные[0].Событие.Имя).Равно("SCALL");

КонецПроцедуры

&Тест
Процедура НачалоСКонцаНеТеряетДописанноеПослеПерезапускаДоФиксации() Экспорт

	// Дано - первый проход с конца, процесс остановился до фиксации
	Дописать("rphost_1/26102009.log", "05:12.000001-15,CALL,1,Usr=Admin" + ПС, Истина);
	ЧитательКаталога(Истина).Прочитать(ЭтотОбъект);

	// Когда
	Дописать("rphost_1/26102009.log", "05:13.000001-1,SCALL,1,Usr=Admin" + ПС);
	ЧитательКаталога(Истина).Прочитать(ЭтотОбъект);

	// Тогда
	Ожидаем.Что(Полученные).ИмеетДлину(1);
	Ожидаем.Что(Полученные[0].Событие.Имя).Равно("SCALL");

КонецПроцедуры

&Тест
Процедура ФиксацияНеУдаляетПозицииДругихИсточников() Экспорт

	// Дано - журнал регистрации внутри каталога ТЖ и соседний каталог с тем же началом имени
	Дописать("rphost_1/26102009.log", "05:12.000001-1,CALL,1,Usr=a" + ПС, Истина);
	ВложенныйФайл = ПутьВКаталоге("1Cv8Log/20261018000000.lgp");
	Дописать("1Cv8Log/20261018000000.lgp", "{}");
	СоседнийКаталог = "../" + Новый Файл(Каталог).Имя + "-other";
	Дописать(СоседнийКаталог + "/rphost_2/26102009.log", "05:12.000001-1,CALL,1,Usr=b" + ПС);
	СоседнийФайл = Новый Файл(ПутьВКаталоге(СоседнийКаталог + "/rphost_2/26102009.log")).ПолноеИмя;
	Хранилище.УстановитьПозицию(ВложенныйФайл, 2);
	Хранилище.УстановитьПозицию(СоседнийФайл, 30);

	// Когда
	Читатель = ЧитательКаталога();
	Читатель.Прочитать(ЭтотОбъект);
	Читатель.ЗафиксироватьПозиции();

	// Тогда
	Ожидаем.Что(Хранилище.Позиция(ВложенныйФайл)).Равно(2);
	Ожидаем.Что(Хранилище.Позиция(СоседнийФайл)).Равно(30);
	УдалитьФайлы(Новый Файл(ПутьВКаталоге(СоседнийКаталог)).ПолноеИмя);

КонецПроцедуры

&Тест
Процедура ФиксацияУдаляетПозицииУдаленныхФайлов() Экспорт

	// Дано
	Дописать("rphost_1/26102009.log", "05:12.000001-1,CALL,1,Usr=a" + ПС, Истина);
	Дописать("rphost_1/26102010.log", "05:12.000001-1,CALL,1,Usr=b" + ПС, Истина);
	Читатель = ЧитательКаталога();
	Читатель.Прочитать(ЭтотОбъект);
	Читатель.ЗафиксироватьПозиции();

	// Когда
	УдалитьФайлы(ПутьВКаталоге("rphost_1/26102009.log"));
	Читатель.Прочитать(ЭтотОбъект);
	Читатель.ЗафиксироватьПозиции();

	// Тогда
	Ожидаем.Что(Хранилище.Позиция(ПутьВКаталоге("rphost_1/26102009.log"))).Равно(Неопределено);
	Ожидаем.Что(Хранилище.Позиция(ПутьВКаталоге("rphost_1/26102010.log"))).Больше(0);

КонецПроцедуры

&Тест
Процедура СобытиеСНеверныйЗаголовкомПропускаетсяСПредупреждением() Экспорт

	// Дано
	Путь = ПутьВКаталоге("rphost_1/26102009.log");
	Дописать("rphost_1/26102009.log", "05:12.000001-1,CALL" + ПС + "05:13.000001-1,CONN,0,Txt=ok" + ПС, Истина);
	Читатель = ЧитательКаталога();

	// Когда
	Читатель.Прочитать(ЭтотОбъект);
	Полученные.Очистить();
	Читатель.Прочитать(ЭтотОбъект);
	Дописать("rphost_1/26102009.log", "05:14.000001-1,SCALL,1" + ПС);
	Читатель.Прочитать(ЭтотОбъект);

	// Тогда - источник не останавливается и дочитывает новые события
	Ожидаем.Что(Полученные).ИмеетДлину(1);
	Ожидаем.Что(Полученные[0].Событие.Имя).Равно("SCALL");
	Предупреждения = Новый Массив;
	Для Каждого Сообщение Из СообщенияЛога Цикл
		Если СтрНайти(Сообщение, "пропущено") > 0 Тогда
			Предупреждения.Добавить(Сообщение);
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(Предупреждения).ИмеетДлину(1);
	Ожидаем.Что(Предупреждения[0]).Содержит(Путь);

КонецПроцедуры

&Тест
Процедура НачалоЧтенияАктивногоФайлаЛогируетсяОдинРаз() Экспорт

	// Дано
	Путь = ПутьВКаталоге("rphost_1/26102009.log");
	Дописать("rphost_1/26102009.log", "05:12.000001-1,CALL,1,Usr=a" + ПС, Истина);
	Читатель = ЧитательКаталога();

	// Когда
	Читатель.Прочитать(ЭтотОбъект);
	Дописать("rphost_1/26102009.log", "05:13.000001-1,CALL,1,Usr=b" + ПС);
	Читатель.Прочитать(ЭтотОбъект);
	Читатель.Прочитать(ЭтотОбъект);

	// Тогда
	Ожидаем.Что(СообщенияЛога).ИмеетДлину(1);
	Ожидаем.Что(СообщенияЛога[0]).Содержит("Начато чтение файла журнала " + Путь + " с позиции 0");

КонецПроцедуры

&Тест
Процедура ПолноеПрочтениеЗавершенногоФайлаЛогируетсяОдинРаз() Экспорт

	// Дано
	Путь = ПутьВКаталоге("rphost_1/26102009.log");
	Дописать("rphost_1/26102009.log", "05:12.000001-1,CALL,1,Usr=a" + ПС, Истина);
	Читатель = ЧитательКаталога();
	Читатель.Прочитать(ЭтотОбъект);
	Дописать("rphost_1/26102009.log", "05:13.000001-1,CALL,1,Usr=b" + ПС);
	Читатель.Прочитать(ЭтотОбъект);
	СообщенияЛога.Очистить();

	// Когда - появился файл следующего часа, прежний файл больше не дописывается
	Дописать("rphost_1/26102010.log", "05:12.000001-1,CALL,1,Usr=c" + ПС, Истина);
	Читатель.Прочитать(ЭтотОбъект);
	Читатель.Прочитать(ЭтотОбъект);

	// Тогда
	Ожидаем.Что(СообщенияЛога).ИмеетДлину(2);
	Ожидаем.Что(СообщенияЛога[0]).Содержит("Файл журнала прочитан полностью: " + Путь + ", записей 2");
	Ожидаем.Что(СообщенияЛога[1]).Содержит("Начато чтение файла журнала " + ПутьВКаталоге("rphost_1/26102010.log"));

КонецПроцедуры

&Тест
Процедура ФайлыПрочитанныеВПрошлыйЗапускНеЛогируются() Экспорт

	// Дано
	Дописать("rphost_1/26102009.log", "05:12.000001-1,CALL,1,Usr=a" + ПС, Истина);
	Дописать("rphost_1/26102010.log", "05:12.000001-1,CALL,1,Usr=b" + ПС, Истина);
	Читатель = ЧитательКаталога();
	Читатель.Прочитать(ЭтотОбъект);
	Читатель.ЗафиксироватьПозиции();
	СообщенияЛога.Очистить();

	// Когда - новый запуск с сохраненными позициями
	Читатель = ЧитательКаталога();
	Читатель.Прочитать(ЭтотОбъект);

	// Тогда
	Ожидаем.Что(СообщенияЛога).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ПродолжениеЧтенияПослеПерезапускаЛогируетсяСПозиции() Экспорт

	// Дано
	Путь = ПутьВКаталоге("rphost_1/26102009.log");
	Первое = "05:12.000001-1,CALL,1,Usr=a" + ПС;
	Дописать("rphost_1/26102009.log", Первое, Истина);
	Читатель = ЧитательКаталога();
	Читатель.Прочитать(ЭтотОбъект);
	Читатель.ЗафиксироватьПозиции();
	Дописать("rphost_1/26102009.log", "05:13.000001-1,CALL,1,Usr=b" + ПС);
	СообщенияЛога.Очистить();

	// Когда
	Читатель = ЧитательКаталога();
	Читатель.Прочитать(ЭтотОбъект);

	// Тогда - позиция после BOM и первой строки
	Ожидаем.Что(СообщенияЛога).ИмеетДлину(1);
	Ожидаем.Что(СообщенияЛога[0]).Содержит(СтрШаблон("Начато чтение файла журнала %1 с позиции %2",
		Путь, Формат(3 + СтрДлина(Первое), "ЧГ=0")));

КонецПроцедуры

&Тест
Процедура ФайлыРазныхКаталоговЧитаютсяПоПорядкуЧасов() Экспорт

	// Дано
	Дописать("rphost_1/26102010.log", "05:12.000001-1,CALL,1,Usr=a10" + ПС, Истина);
	Дописать("rphost_1/26102009.log", "05:12.000001-1,CALL,1,Usr=a09" + ПС, Истина);
	Дописать("rmngr_2/26102009.log", "05:12.000001-1,CALL,1,Usr=b09" + ПС, Истина);
	Дописать("rmngr_2/26102010.log", "05:12.000001-1,CALL,1,Usr=b10" + ПС, Истина);
	Дописать("rmngr_2/26102011.log", "05:12.000001-1,CALL,1,Usr=b11" + ПС, Истина);

	// Когда
	Читатель = ЧитательКаталога();
	Читатель.Прочитать(ЭтотОбъект);

	// Тогда
	Часы = Новый Массив;
	Для Каждого Полученное Из Полученные Цикл
		Часы.Добавить(Прав(Полученное.Событие.Свойства["Usr"], 2));
	КонецЦикла;
	Ожидаем.Что(СтрСоединить(Часы, ",")).Равно("09,09,10,10,11");

КонецПроцедуры

&Тест
Процедура ПовторноеЧтениеВозвращаетТолькоДописанное() Экспорт

	// Дано
	Дописать("rphost_1/26102009.log", "05:12.000001-15,CALL,1,Usr=Admin" + ПС, Истина);
	Читатель = ЧитательКаталога();
	Читатель.Прочитать(ЭтотОбъект);
	Полученные.Очистить();

	// Когда
	Дописать("rphost_1/26102009.log", "05:13.000001-1,SCALL,1,Usr=Admin" + ПС);
	Читатель.Прочитать(ЭтотОбъект);

	// Тогда
	Ожидаем.Что(Полученные).ИмеетДлину(1);
	Ожидаем.Что(Полученные[0].Событие.Имя).Равно("SCALL");

КонецПроцедуры

&Тест
Процедура ПозицииСохраняютсяТолькоПослеФиксации() Экспорт

	// Дано
	Дописать("rphost_1/26102009.log", "05:12.000001-15,CALL,1,Usr=Admin" + ПС, Истина);

	// Когда
	Читатель = ЧитательКаталога();
	Читатель.Прочитать(ЭтотОбъект);
	ПозицияДоФиксации = Хранилище.Позиция(ПутьВКаталоге("rphost_1/26102009.log"));
	Читатель.ЗафиксироватьПозиции();

	// Тогда
	Ожидаем.Что(ПозицияДоФиксации).Равно(Неопределено);
	Ожидаем.Что(Хранилище.Позиция(ПутьВКаталоге("rphost_1/26102009.log"))).Равно(3 + 33);

КонецПроцедуры

&Тест
Процедура ПослеПерезапускаЧтениеПродолжаетсяСЗафиксированнойПозиции() Экспорт

	// Дано
	Дописать("rphost_1/26102009.log", "05:12.000001-15,CALL,1,Usr=Admin" + ПС, Истина);
	Читатель = ЧитательКаталога();
	Читатель.Прочитать(ЭтотОбъект);
	Читатель.ЗафиксироватьПозиции();
	Дописать("rphost_1/26102009.log", "05:13.000001-1,SCALL,1,Usr=Admin" + ПС);
	Полученные.Очистить();

	// Когда
	НовыйЧитатель = ЧитательКаталога();
	НовыйЧитатель.Прочитать(ЭтотОбъект);

	// Тогда
	Ожидаем.Что(Полученные).ИмеетДлину(1);
	Ожидаем.Что(Полученные[0].Событие.Имя).Равно("SCALL");

КонецПроцедуры

&Тест
Процедура НезавершенноеСобытиеДочитываетсяПозже() Экспорт

	// Дано
	Дописать("rphost_1/26102009.log", "05:12.000001-15,EXCP,1,Descr='начало" + ПС, Истина);
	Читатель = ЧитательКаталога();
	Читатель.Прочитать(ЭтотОбъект);
	Ожидаем.Что(Полученные).ИмеетДлину(0);

	// Когда
	Дописать("rphost_1/26102009.log", "конец'" + ПС);
	Читатель.Прочитать(ЭтотОбъект);

	// Тогда
	Ожидаем.Что(Полученные).ИмеетДлину(1);
	Ожидаем.Что(Полученные[0].Событие.Свойства["Descr"]).Равно("начало" + ПС + "конец");

КонецПроцедуры

&Тест
Процедура ФайлПрошлогоЧасаДочитываетсяДоКонца() Экспорт

	// Дано - последнее событие прошлого часа с незакрытой кавычкой
	Дописать("rphost_1/26102009.log", "59:59.000001-15,EXCP,1,Descr='оборвано" + ПС, Истина);
	Дописать("rphost_1/26102010.log", "00:01.000001-1,CALL,1,Usr=Admin" + ПС, Истина);

	// Когда
	Читатель = ЧитательКаталога();
	Читатель.Прочитать(ЭтотОбъект);

	// Тогда
	Ожидаем.Что(Полученные).ИмеетДлину(2);
	Ожидаем.Что(Полученные[0].Событие.Имя).Равно("EXCP");
	Ожидаем.Что(Полученные[1].Событие.Время).Равно(Дата(2026, 10, 20, 10, 0, 1));

КонецПроцедуры

&Тест
Процедура НачалоСКонцаПропускаетСуществующиеДанные() Экспорт

	// Дано
	Дописать("rphost_1/26102009.log", "05:12.000001-15,CALL,1,Usr=Admin" + ПС, Истина);
	Читатель = ЧитательКаталога(Истина);
	Читатель.Прочитать(ЭтотОбъект);
	Ожидаем.Что(Полученные).ИмеетДлину(0);

	// Когда
	Дописать("rphost_1/26102009.log", "05:13.000001-1,SCALL,1,Usr=Admin" + ПС);
	Дописать("rphost_1/26102010.log", "00:01.000001-1,CALL,1,Usr=Admin" + ПС, Истина);
	Читатель.Прочитать(ЭтотОбъект);

	// Тогда - дописанное и новые файлы читаются
	Ожидаем.Что(Полученные).ИмеетДлину(2);
	Ожидаем.Что(Полученные[0].Событие.Имя).Равно("SCALL");
	Ожидаем.Что(Полученные[1].Событие.Имя).Равно("CALL");

КонецПроцедуры

&Тест
Процедура НачалоСКонцаПрименяетсяТолькоПриПервомЗапуске() Экспорт

	// Дано
	Читатель = ЧитательКаталога(Истина);
	Читатель.Прочитать(ЭтотОбъект);
	Читатель.ЗафиксироватьПозиции();
	Дописать("rphost_1/26102009.log", "05:12.000001-15,CALL,1,Usr=Admin" + ПС, Истина);

	// Когда
	НовыйЧитатель = ЧитательКаталога(Истина);
	НовыйЧитатель.Прочитать(ЭтотОбъект);

	// Тогда
	Ожидаем.Что(Полученные).ИмеетДлину(1);

