КонецПроцедуры

&Тест
Процедура УсеченныйФайлЧитаетсяЗаново() Экспорт

	// Дано
	Дописать("rphost_1/26102009.log", "05:12.000001-15,CALL,1,Usr=Admin,Context=длинный контекст" + ПС, Истина);
	Читатель = Новый ЧитательТехнологическогоЖурнала(Каталог, Хранилище);
	Читатель.Прочитать(ЭтотОбъект);
	Полученные.Очистить();

	// Когда
	УдалитьФайлы(ПутьВКаталоге("rphost_1/26102009.log"));
	Дописать("rphost_1/26102009.log", "05:13.000001-1,SCALL,1" + ПС, Истина);
	Читатель.Прочитать(ЭтотОбъект);

	// Тогда
	Ожидаем.Что(Полученные).ИмеетДлину(1);
	Ожидаем.Что(Полученные[0].Событие.Имя).Равно("SCALL");

КонецПроцедуры

&Тест
Процедура СобытиеДлиннееПорцииЧтения() Экспорт

	// Дано
	Длинное = "05:12.000001-15,CALL,1,Context='" + СтрСоединить(Новый Массив(200), "контекст" + ПС) + "'" + ПС;
	Дописать("rphost_1/26102009.log", Длинное, Истина);
	Параметры = Новый Структура("МаксимумБайт", 256);

	// Когда
	Читатель = Новый ЧитательТехнологическогоЖурнала(Каталог, Хранилище, Параметры);
	Читатель.Прочитать(ЭтотОбъект);

	// Тогда
	Ожидаем.Что(Полученные).ИмеетДлину(1);
	Ожидаем.Что(Полученные[0].Событие.Имя).Равно("CALL");

КонецПроцедуры

&Тест
Процедура ПозицииУдаленныхФайловУдаляютсяПриФиксации() Экспорт

	// Дано
	Дописать("rphost_1/26102009.log", "05:12.000001-15,CALL,1" + ПС, Истина);
	Читатель = Новый ЧитательТехнологическогоЖурнала(Каталог, Хранилище);
	Читатель.Прочитать(ЭтотОбъект);
	Читатель.ЗафиксироватьПозиции();

	// Когда
	УдалитьФайлы(ПутьВКаталоге("rphost_1/26102009.log"));
	Читатель.Прочитать(ЭтотОбъект);
	Читатель.ЗафиксироватьПозиции();

	// Тогда
	Ожидаем.Что(Хранилище.Позиция(ПутьВКаталоге("rphost_1/26102009.log"))).Равно(Неопределено);

КонецПроцедуры

Функция НайтиСобытие(Имя)
	Для Каждого Полученное Из Полученные Цикл
		Если Полученное.Событие.Имя = Имя Тогда
			Возврат Полученное;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "Не найдено событие " + Имя;
КонецФункции

Функция ПутьВКаталоге(ОтносительныйПуть)
	Возврат ОбъединитьПути(Каталог, ОтносительныйПуть);
КонецФункции

Процедура Дописать(ОтносительныйПуть, Текст, СBOM = Ложь)

	Путь = ПутьВКаталоге(ОтносительныйПуть);
	СоздатьКаталог(Новый Файл(Путь).Путь);

	Буфер = ПолучитьБуферДвоичныхДанныхИзСтроки(?(СBOM, Символ(65279), "") + Текст, "UTF-8", Ложь);
	Поток = Новый ФайловыйПоток(Путь, РежимОткрытияФайла.ОткрытьИлиСоздать, ДоступКФайлу.Запись);
	Поток.Перейти(0, ПозицияВПотоке.Конец);
	Поток.Записать(Буфер, 0, Буфер.Размер);
	Поток.Закрыть();

КонецПроцедуры

ПС = Символы.ПС;
