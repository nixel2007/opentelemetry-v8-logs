// BSLLS:MagicNumber-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
#Использовать ".."
#Использовать asserts
#Использовать tempfiles

Перем ПС;
Перем ВременныеФайлыТеста;
Перем Каталог;
Перем Хранилище;
Перем Полученные; // Массив из Структура("Событие, Файл")

&ПередКаждым
Процедура Подготовить() Экспорт
	ВременныеФайлыТеста = Новый МенеджерВременныхФайлов;
	Каталог = ВременныеФайлыТеста.СоздатьКаталог();
	Хранилище = Новый ХранилищеПозицийВПамяти;
	Полученные = Новый Массив;
КонецПроцедуры

&ПослеКаждого
Процедура УдалитьВременныеФайлы() Экспорт
	ВременныеФайлыТеста.Удалить();
КонецПроцедуры

// Обработчик событий для читателя
Процедура ОбработатьСобытияТехнологическогоЖурнала(События, ОписаниеФайла) Экспорт
	Для Каждого Событие Из События Цикл
		Полученные.Добавить(Новый Структура("Событие, Файл", Событие, ОписаниеФайла));
	КонецЦикла;
КонецПроцедуры

&Тест
Процедура ЧтениеСобытийИзКаталоговПроцессов() Экспорт

	// Дано
	Дописать("rphost_1234/26102009.log", "05:12.345678-15,CALL,1,Usr=Admin" + ПС, Истина);
	Дописать("rmngr_77/26102009.log", "05:13.000001-1,CONN,0,Txt=ok" + ПС, Истина);

	// Когда
	Читатель = Новый ЧитательТехнологическогоЖурнала(Каталог, Хранилище);
	Количество = Читатель.Прочитать(ЭтотОбъект);

	// Тогда
	Ожидаем.Что(Количество).Равно(2);
	Ожидаем.Что(Полученные).ИмеетДлину(2);
	Вызов = НайтиСобытие("CALL");
	Ожидаем.Что(Вызов.Событие.Время).Равно(Дата(2026, 10, 20, 9, 5, 12));
	Ожидаем.Что(Вызов.Файл.Процесс).Равно("rphost");
	Ожидаем.Что(Вызов.Файл.ИдПроцесса).Равно("1234");
	Ожидаем.Что(Вызов.Файл.Путь).Равно(ПутьВКаталоге("rphost_1234/26102009.log"));
	Ожидаем.Что(НайтиСобытие("CONN").Файл.Процесс).Равно("rmngr");

КонецПроцедуры

&Тест
Процедура ПовторноеЧтениеВозвращаетТолькоДописанное() Экспорт

	// Дано
	Дописать("rphost_1/26102009.log", "05:12.000001-15,CALL,1,Usr=Admin" + ПС, Истина);
	Читатель = Новый ЧитательТехнологическогоЖурнала(Каталог, Хранилище);
	Читатель.Прочитать(ЭтотОбъект);
	Полученные.Очистить();

	// Когда
	Дописать("rphost_1/26102009.log", "05:13.000001-1,SCALL,1,Usr=Admin" + ПС);
	Читатель.Прочитать(ЭтотОбъект);

	// Тогда
	Ожидаем.Что(Полученные).ИмеетДлину(1);
	Ожидаем.Что(Полученные[0].Событие.Имя).Равно("SCALL");

КонецПроцедуры

&Тест
Процедура ПозицииСохраняютсяТолькоПослеФиксации() Экспорт

	// Дано
	Дописать("rphost_1/26102009.log", "05:12.000001-15,CALL,1,Usr=Admin" + ПС, Истина);

	// Когда
	Читатель = Новый ЧитательТехнологическогоЖурнала(Каталог, Хранилище);
	Читатель.Прочитать(ЭтотОбъект);
	ПозицияДоФиксации = Хранилище.Позиция(ПутьВКаталоге("rphost_1/26102009.log"));
	Читатель.ЗафиксироватьПозиции();

	// Тогда
	Ожидаем.Что(ПозицияДоФиксации).Равно(Неопределено);
	Ожидаем.Что(Хранилище.Позиция(ПутьВКаталоге("rphost_1/26102009.log"))).Равно(3 + 33);

КонецПроцедуры

&Тест
Процедура ПослеПерезапускаЧтениеПродолжаетсяСЗафиксированнойПозиции() Экспорт

	// Дано
	Дописать("rphost_1/26102009.log", "05:12.000001-15,CALL,1,Usr=Admin" + ПС, Истина);
	Читатель = Новый ЧитательТехнологическогоЖурнала(Каталог, Хранилище);
	Читатель.Прочитать(ЭтотОбъект);
	Читатель.ЗафиксироватьПозиции();
	Дописать("rphost_1/26102009.log", "05:13.000001-1,SCALL,1,Usr=Admin" + ПС);
	Полученные.Очистить();

	// Когда
	НовыйЧитатель = Новый ЧитательТехнологическогоЖурнала(Каталог, Хранилище);
	НовыйЧитатель.Прочитать(ЭтотОбъект);

	// Тогда
	Ожидаем.Что(Полученные).ИмеетДлину(1);
	Ожидаем.Что(Полученные[0].Событие.Имя).Равно("SCALL");

КонецПроцедуры

&Тест
Процедура НезавершенноеСобытиеДочитываетсяПозже() Экспорт

	// Дано
	Дописать("rphost_1/26102009.log", "05:12.000001-15,EXCP,1,Descr='начало" + ПС, Истина);
	Читатель = Новый ЧитательТехнологическогоЖурнала(Каталог, Хранилище);
	Читатель.Прочитать(ЭтотОбъект);
	Ожидаем.Что(Полученные).ИмеетДлину(0);

	// Когда
	Дописать("rphost_1/26102009.log", "конец'" + ПС);
	Читатель.Прочитать(ЭтотОбъект);

	// Тогда
	Ожидаем.Что(Полученные).ИмеетДлину(1);
	Ожидаем.Что(Полученные[0].Событие.Свойства["Descr"]).Равно("начало" + ПС + "конец");

КонецПроцедуры

&Тест
Процедура ФайлПрошлогоЧасаДочитываетсяДоКонца() Экспорт

	// Дано - последнее событие прошлого часа с незакрытой кавычкой
	Дописать("rphost_1/26102009.log", "59:59.000001-15,EXCP,1,Descr='оборвано" + ПС, Истина);
	Дописать("rphost_1/26102010.log", "00:01.000001-1,CALL,1,Usr=Admin" + ПС, Истина);

	// Когда
	Читатель = Новый ЧитательТехнологическогоЖурнала(Каталог, Хранилище);
	Читатель.Прочитать(ЭтотОбъект);

	// Тогда
	Ожидаем.Что(Полученные).ИмеетДлину(2);
	Ожидаем.Что(Полученные[0].Событие.Имя).Равно("EXCP");
	Ожидаем.Что(Полученные[1].Событие.Время).Равно(Дата(2026, 10, 20, 10, 0, 1));

КонецПроцедуры

&Тест
Процедура НачалоСКонцаПропускаетСуществующиеДанные() Экспорт

	// Дано
	Дописать("rphost_1/26102009.log", "05:12.000001-15,CALL,1,Usr=Admin" + ПС, Истина);
	Параметры = Новый Структура("НачинатьСКонца", Истина);
	Читатель = Новый ЧитательТехнологическогоЖурнала(Каталог, Хранилище, Параметры);
	Читатель.Прочитать(ЭтотОбъект);
	Ожидаем.Что(Полученные).ИмеетДлину(0);

	// Когда
	Дописать("rphost_1/26102009.log", "05:13.000001-1,SCALL,1,Usr=Admin" + ПС);
	Дописать("rphost_1/26102010.log", "00:01.000001-1,CALL,1,Usr=Admin" + ПС, Истина);
	Читатель.Прочитать(ЭтотОбъект);

	// Тогда - дописанное и новые файлы читаются
	Ожидаем.Что(Полученные).ИмеетДлину(2);
	Ожидаем.Что(Полученные[0].Событие.Имя).Равно("SCALL");
	Ожидаем.Что(Полученные[1].Событие.Имя).Равно("CALL");

КонецПроцедуры

&Тест
Процедура НачалоСКонцаПрименяетсяТолькоПриПервомЗапуске() Экспорт

	// Дано
	Параметры = Новый Структура("НачинатьСКонца", Истина);
	Читатель = Новый ЧитательТехнологическогоЖурнала(Каталог, Хранилище, Параметры);
	Читатель.Прочитать(ЭтотОбъект);
	Читатель.ЗафиксироватьПозиции();
	Дописать("rphost_1/26102009.log", "05:12.000001-15,CALL,1,Usr=Admin" + ПС, Истина);

	// Когда
	НовыйЧитатель = Новый ЧитательТехнологическогоЖурнала(Каталог, Хранилище, Параметры);
	НовыйЧитатель.Прочитать(ЭтотОбъект);

	// Тогда
	Ожидаем.Что(Полученные).ИмеетДлину(1);

КонецПроцедуры

&Тест
Процедура ЧтениеФорматаJSON() Экспорт

	// Дано
	Дописать("rphost_1/26102009.log",
		"{""ts"":""2026-10-20T09:05:12.000001"",""duration"":""15"",""name"":""CALL"",""depth"":""1"",""process"":""rphost""}"
		+ ПС, Истина);

	// Когда
	Читатель = Новый ЧитательТехнологическогоЖурнала(Каталог, Хранилище);
	Читатель.Прочитать(ЭтотОбъект);

	// Тогда
	Ожидаем.Что(Полученные).ИмеетДлину(1);
	Ожидаем.Что(Полученные[0].Событие.Имя).Равно("CALL");
	Ожидаем.Что(Полученные[0].Событие.Длительность).Равно(15);

КонецПроцедуры

&Тест
Процедура ПлоскоеРазмещениеФайлов() Экспорт

	// Дано
