	Ожидаем.Что(Тело.Обрезано).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТелоОбрезаетсяДоЛимитаСМеткой() Экспорт

	// Дано
	Ограничение = Новый ОграничениеРазмеровТелеметрии(30, 0, 0);

	// Когда
	Тело = Ограничение.ОграничитьТело(Повтор("x", 50));

	// Тогда
	Ожидаем.Что(Тело.Обрезано).ЭтоИстина();
	Ожидаем.Что(Тело.Значение).Равно(Повтор("x", 16) + Метка);
	Ожидаем.Что(Тело.ИсходныйРазмер).Равно(50);
	Ожидаем.Что(Тело.Размер).Равно(30);
	Ожидаем.Что(Тело.Ключи).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ТелоВПределахЛимитаНеМеняется() Экспорт

	// Дано
	Ограничение = Новый ОграничениеРазмеровТелеметрии(30, 0, 0);
	Значения = Новый Массив;
	Значения.Добавить(ЗначениеТела("a", 3, 28));

	// Когда
	Тело = Ограничение.ОграничитьТело("a=" + Повтор("x", 28), Значения);

	// Тогда
	Ожидаем.Что(Тело.Обрезано).ЭтоЛожь();
	Ожидаем.Что(Тело.Значение).Равно("a=" + Повтор("x", 28));
	Ожидаем.Что(Тело.Ключи).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ТелоОбрезаетсяВнутриЗначения() Экспорт

	// Дано - «ж» занимает 2 байта: тело 115 байт, значение «a» - 100
	Ограничение = Новый ОграничениеРазмеровТелеметрии(60, 0, 0);
	Тело = "a=" + Повтор("ж", 50) + ",b=конец";
	Значения = Новый Массив;
	Значения.Добавить(ЗначениеТела("a", 3, 50));
	Значения.Добавить(ЗначениеТела("b", 56, 5));

	// Когда
	Результат = Ограничение.ОграничитьТело(Тело, Значения);

	// Тогда
	Ожидаем.Что(Результат.Обрезано).ЭтоИстина();
	Ожидаем.Что(Результат.Значение).Равно("a=" + Повтор("ж", 15) + Метка + ",b=конец");
	Ожидаем.Что(Результат.ИсходныйРазмер).Равно(115);
	Ожидаем.Что(Результат.Размер).Равно(59);
	Ожидаем.Что(Результат.Ключи).ИмеетДлину(1);
	Ожидаем.Что(Результат.Ключи[0]).Равно("a");

КонецПроцедуры

&Тест
Процедура ВТелеСначалаОбрезаетсяСамоеДлинноеЗначение() Экспорт

	// Дано - тело 355 байт: значение «a» - 200, «b» - 150
	Ограничение = Новый ОграничениеРазмеровТелеметрии(100, 0, 0);
	Тело = "a=" + Повтор("x", 200) + ",b=" + Повтор("y", 150);
	Значения = Новый Массив;
	Значения.Добавить(ЗначениеТела("a", 3, 200));
	Значения.Добавить(ЗначениеТела("b", 206, 150));

	// Когда
	Результат = Ограничение.ОграничитьТело(Тело, Значения);

	// Тогда - «a» обрезано до 15 байт (символ и метка), «b» - на остаток превышения
	Ожидаем.Что(Результат.Значение).Равно("a=x" + Метка + ",b=" + Повтор("y", 66) + Метка);
	Ожидаем.Что(Результат.Размер).Равно(100);
	Ожидаем.Что(Результат.Ключи).ИмеетДлину(2);
	Ожидаем.Что(Результат.Ключи[0]).Равно("a");
	Ожидаем.Что(Результат.Ключи[1]).Равно("b");

КонецПроцедуры

&Тест
Процедура НедопустимоеОкончаниеОбрезанногоЗначенияОтбрасывается() Экспорт

	// Дано - нечетное число кавычек в конце обрезанного значения разрывает удвоенную кавычку
	Ограничение = Новый ОграничениеРазмеровТелеметрии(26, 0, 0);
	НечетныеКавычки = Новый РегулярноеВыражение("(?<!')'(?:'')*\z");
	Разорванная = Новый Массив;
	Разорванная.Добавить(ЗначениеТела("S", 4, 55, НечетныеКавычки));

	// Когда
	Результат = Ограничение.ОграничитьТело("S='abc''" + Повтор("x", 50) + "',R=1", Разорванная);
	Целая = Ограничение.ОграничитьТело("S='ab''" + Повтор("x", 51) + "',R=1", Разорванная);

	// Тогда
	Ожидаем.Что(Результат.Значение).Равно("S='abc" + Метка + "',R=1");
	Ожидаем.Что(Целая.Значение).Равно("S='ab''" + Метка + "',R=1");

КонецПроцедуры

&Тест
Процедура ТелоОбрезаетсяСправаЕслиБезЗначенийНеПомещается() Экспорт

	// Дано - без значения «a» тело 42 байта при лимите 30
	Ограничение = Новый ОграничениеРазмеровТелеметрии(30, 0, 0);
	Значения = Новый Массив;
	Значения.Добавить(ЗначениеТела("a", 43, 20));

	// Когда
	Результат = Ограничение.ОграничитьТело(Повтор("x", 40) + "a=" + Повтор("y", 20), Значения);

	// Тогда
	Ожидаем.Что(Результат.Значение).Равно(Повтор("x", 16) + Метка);
	Ожидаем.Что(Результат.Размер).Равно(30);
	Ожидаем.Что(Результат.Ключи).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ПревышениеЛимитаТелаСчитаетсяВБайтах() Экспорт

	// Дано - «ж» занимает 2 байта
	Ограничение = Новый ОграничениеРазмеровТелеметрии(30, 0, 0);
	БезЛимита = Новый ОграничениеРазмеровТелеметрии(0, 0, 0);

	// Тогда
	Ожидаем.Что(Ограничение.ТелоПревышаетЛимит(Повтор("ж", 15))).ЭтоЛожь();
	Ожидаем.Что(Ограничение.ТелоПревышаетЛимит(Повтор("ж", 16))).ЭтоИстина();
	Ожидаем.Что(БезЛимита.ТелоПревышаетЛимит(Повтор("ж", 100))).ЭтоЛожь();

КонецПроцедуры

Функция ЗначениеТела(Ключ, Начало, Длина, НедопустимоеОкончание = Неопределено)
	Возврат Новый Структура("Ключ, Начало, Длина, НедопустимоеОкончание", Ключ, Начало, Длина, НедопустимоеОкончание);
КонецФункции

Функция Повтор(Строка, Количество)
	Части = Новый Массив;
	Для Номер = 1 По Количество Цикл // BSLLS:UnusedLocalVariable-off
		Части.Добавить(Строка);
	КонецЦикла;
	Возврат СтрСоединить(Части);
КонецФункции

Функция РазмерUTF8(Строка)
	Возврат ПолучитьДвоичныеДанныеИзСтроки(Строка, "UTF-8").Размер();
КонецФункции

Метка = "...[truncated]";
