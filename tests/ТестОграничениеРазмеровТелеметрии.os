// BSLLS:MagicNumber-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
// BSLLS:DuplicateStringLiteral-off
#Использовать "../src/Экспорт"
#Использовать asserts

Перем Метка;

&Тест
Процедура ЗначениеВПределахЛимитаНеМеняется() Экспорт

	// Дано
	Ограничение = Новый ОграничениеРазмеровТелеметрии(30, 30, 0);
	Атрибуты = Новый Соответствие;
	Атрибуты.Вставить("a", Повтор("x", 30));

	// Когда
	Обрезки = Ограничение.ОграничитьАтрибуты(Атрибуты);

	// Тогда
	Ожидаем.Что(Атрибуты["a"]).Равно(Повтор("x", 30));
	Ожидаем.Что(Обрезки).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ДлинноеЗначениеОбрезаетсяДоЛимитаСМеткойВКонце() Экспорт

	// Дано
	Ограничение = Новый ОграничениеРазмеровТелеметрии(0, 30, 0);
	Атрибуты = Новый Соответствие;
	Атрибуты.Вставить("a", Повтор("x", 50));

	// Когда
	Обрезки = Ограничение.ОграничитьАтрибуты(Атрибуты);

	// Тогда
	Ожидаем.Что(Атрибуты["a"]).Равно(Повтор("x", 16) + Метка);
	Ожидаем.Что(РазмерUTF8(Атрибуты["a"])).Равно(30);
	Ожидаем.Что(Обрезки).ИмеетДлину(1);
	Ожидаем.Что(Обрезки[0].Ключ).Равно("a");
	Ожидаем.Что(Обрезки[0].ИсходныйРазмер).Равно(50);
	Ожидаем.Что(Обрезки[0].Размер).Равно(30);

КонецПроцедуры

&Тест
Процедура ЛимитСчитаетсяВБайтахИРежетсяПоГраницеСимвола() Экспорт

	// Дано - символ «ж» занимает 2 байта, под текст до метки остается 7 байт
	Ограничение = Новый ОграничениеРазмеровТелеметрии(0, 21, 0);
	Атрибуты = Новый Соответствие;
	Атрибуты.Вставить("a", Повтор("ж", 20));

	// Когда
	Ограничение.ОграничитьАтрибуты(Атрибуты);

	// Тогда
	Ожидаем.Что(Атрибуты["a"]).Равно("жжж" + Метка);
	Ожидаем.Что(РазмерUTF8(Атрибуты["a"])).Равно(20);

КонецПроцедуры

&Тест
Процедура СуррогатнаяПараНеРазрезается() Экспорт

	// Дано - символ вне BMP: два символа строки, 4 байта UTF-8; значение 21 байт, под текст до метки
	// остается 4 байта
	Смайл = Символ(55357) + Символ(56832);
	Ограничение = Новый ОграничениеРазмеровТелеметрии(0, 18, 0);
	Атрибуты = Новый Соответствие;
	Атрибуты.Вставить("a", "a" + Смайл + Смайл + Смайл + Смайл + Смайл);

	// Когда
	Ограничение.ОграничитьАтрибуты(Атрибуты);

	// Тогда
	Ожидаем.Что(Атрибуты["a"]).Равно("a" + Метка);

КонецПроцедуры

&Тест
Процедура МассивСтрокОбрезаетсяПоэлементно() Экспорт

	// Дано
	Ограничение = Новый ОграничениеРазмеровТелеметрии(0, 30, 0);
	Атрибуты = Новый Соответствие;
	Значения = Новый Массив;
	Значения.Добавить(Повтор("x", 50));
	Значения.Добавить("short");
	Атрибуты.Вставить("a", Значения);

	// Когда
	Обрезки = Ограничение.ОграничитьАтрибуты(Атрибуты);

	// Тогда
	Ожидаем.Что(Атрибуты["a"][0]).Равно(Повтор("x", 16) + Метка);
	Ожидаем.Что(Атрибуты["a"][1]).Равно("short");
	Ожидаем.Что(Значения[0]).Равно(Повтор("x", 50));
	Ожидаем.Что(Обрезки).ИмеетДлину(1);
	Ожидаем.Что(Обрезки[0].Ключ).Равно("a");
	Ожидаем.Что(Обрезки[0].ИсходныйРазмер).Равно(55);
	Ожидаем.Что(Обрезки[0].Размер).Равно(35);

КонецПроцедуры

&Тест
Процедура ВложенноеСоответствиеОбрезаетсяРекурсивно() Экспорт

	// Дано
	Ограничение = Новый ОграничениеРазмеровТелеметрии(0, 30, 0);
	Вложенное = Новый Соответствие;
	Вложенное.Вставить("z", Повтор("z", 50));
	Вложенное.Вставить("n", 5);
	Данные = Новый Соответствие;
	Данные.Вставить("x", Повтор("x", 50));
	Данные.Вставить("y", Вложенное);
	Данные.Вставить("s", "short");
	Атрибуты = Новый Соответствие;
	Атрибуты.Вставить("d", Данные);

	// Когда
	Обрезки = Ограничение.ОграничитьАтрибуты(Атрибуты);

	// Тогда
	Ожидаем.Что(Атрибуты["d"]["x"]).Равно(Повтор("x", 16) + Метка);
	Ожидаем.Что(Атрибуты["d"]["y"]["z"]).Равно(Повтор("z", 16) + Метка);
	Ожидаем.Что(Атрибуты["d"]["y"]["n"]).Равно(5);
	Ожидаем.Что(Атрибуты["d"]["s"]).Равно("short");
	Ожидаем.Что(Данные["x"]).Равно(Повтор("x", 50));
	Ожидаем.Что(Вложенное["z"]).Равно(Повтор("z", 50));
	Ожидаем.Что(Обрезки).ИмеетДлину(1);
	Ожидаем.Что(Обрезки[0].Ключ).Равно("d");
	Ожидаем.Что(Обрезки[0].ИсходныйРазмер).Равно(105);
	Ожидаем.Что(Обрезки[0].Размер).Равно(65);

КонецПроцедуры

&Тест
Процедура СуммаАтрибутовУчитываетВложенныеКлючиИСтроки() Экспорт

	// Дано - m (1) + a (1) + 60 + k (1) + 60 = 123 байта при бюджете 100; обрезается строка верхнего уровня
	Ограничение = Новый ОграничениеРазмеровТелеметрии(0, 1000, 100);
	Вложенное = Новый Соответствие;
	Вложенное.Вставить("a", Повтор("x", 60));
	Атрибуты = Новый Соответствие;
	Атрибуты.Вставить("m", Вложенное);
	Атрибуты.Вставить("k", Повтор("y", 60));

	// Когда
	Обрезки = Ограничение.ОграничитьАтрибуты(Атрибуты);

	// Тогда
	Ожидаем.Что(РазмерUTF8(Атрибуты["k"])).Равно(37);
	Ожидаем.Что(Атрибуты["m"]["a"]).Равно(Повтор("x", 60));
	Ожидаем.Что(Обрезки).ИмеетДлину(1);
	Ожидаем.Что(Обрезки[0].Ключ).Равно("k");

КонецПроцедуры

&Тест
Процедура НестроковыеЗначенияНеОбрезаются() Экспорт

	// Дано
	Ограничение = Новый ОграничениеРазмеровТелеметрии(0, 15, 0);
	Атрибуты = Новый Соответствие;
	Атрибуты.Вставить("n", 12345678901234567);
	Атрибуты.Вставить("b", Истина);

	// Когда
	Обрезки = Ограничение.ОграничитьАтрибуты(Атрибуты);

	// Тогда
	Ожидаем.Что(Атрибуты["n"]).Равно(12345678901234567);
	Ожидаем.Что(Атрибуты["b"]).Равно(Истина);
	Ожидаем.Что(Обрезки).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура СуммаАтрибутовОграничиваетсяОбрезкойСамогоДлинногоЗначения() Экспорт

	// Дано - ключи по 2 байта: 6 + 60 + 40 + 5 = 111 байт при бюджете 100
	Ограничение = Новый ОграничениеРазмеровТелеметрии(0, 1000, 100);
	Атрибуты = Новый Соответствие;
	Атрибуты.Вставить("k1", Повтор("x", 60));
	Атрибуты.Вставить("k2", Повтор("y", 40));
	Атрибуты.Вставить("k3", Повтор("z", 5));

	// Когда
	Обрезки = Ограничение.ОграничитьАтрибуты(Атрибуты);

	// Тогда
	Ожидаем.Что(Атрибуты["k1"]).Равно(Повтор("x", 35) + Метка);
	Ожидаем.Что(Атрибуты["k2"]).Равно(Повтор("y", 40));
	Ожидаем.Что(Атрибуты["k3"]).Равно(Повтор("z", 5));
	Ожидаем.Что(Обрезки).ИмеетДлину(1);
	Ожидаем.Что(Обрезки[0].Ключ).Равно("k1");
	Ожидаем.Что(Обрезки[0].ИсходныйРазмер).Равно(60);
	Ожидаем.Что(Обрезки[0].Размер).Равно(49);

КонецПроцедуры

&Тест
Процедура ЗначениеОбрезанноеЛимитомИСуммойУчитываетсяОдинРаз() Экспорт

	// Дано - лимит значения 40, затем сумма 2 + 40 + 2 + 30 = 74 при бюджете 60
	Ограничение = Новый ОграничениеРазмеровТелеметрии(0, 40, 60);
	Атрибуты = Новый Соответствие;
	Атрибуты.Вставить("k1", Повтор("x", 100));
	Атрибуты.Вставить("k2", Повтор("y", 30));

	// Когда
	Обрезки = Ограничение.ОграничитьАтрибуты(Атрибуты);

	// Тогда
	Ожидаем.Что(РазмерUTF8(Атрибуты["k1"])).Равно(26);
	Ожидаем.Что(Атрибуты["k2"]).Равно(Повтор("y", 30));
	Ожидаем.Что(Обрезки).ИмеетДлину(1);
	Ожидаем.Что(Обрезки[0].ИсходныйРазмер).Равно(100);
	Ожидаем.Что(Обрезки[0].Размер).Равно(26);

КонецПроцедуры

&Тест
Процедура НулевыеЛимитыНичегоНеОграничивают() Экспорт

	// Дано
	Ограничение = Новый ОграничениеРазмеровТелеметрии(0, 0, 0);
	Атрибуты = Новый Соответствие;
	Атрибуты.Вставить("a", Повтор("x", 5000));

	// Когда
	Обрезки = Ограничение.ОграничитьАтрибуты(Атрибуты);
	Тело = Ограничение.ОграничитьТело(Повтор("x", 5000));

	// Тогда
	Ожидаем.Что(СтрДлина(Атрибуты["a"])).Равно(5000);
	Ожидаем.Что(Обрезки).ИмеетДлину(0);
	Ожидаем.Что(Тело.Обрезано).ЭтоЛожь();
	Ожидаем.Что(СтрДлина(Тело.Значение)).Равно(5000);

КонецПроцедуры

&Тест
Процедура ЛимитМеньшеМеткиОбрезаетБезМетки() Экспорт

	// Дано - метка занимает 14 байт и в лимит 10 не помещается
	Ограничение = Новый ОграничениеРазмеровТелеметрии(10, 10, 0);
	Атрибуты = Новый Соответствие;
	Атрибуты.Вставить("a", Повтор("x", 50));

	// Когда
	Ограничение.ОграничитьАтрибуты(Атрибуты);
	Тело = Ограничение.ОграничитьТело(Повтор("x", 50));

	// Тогда
	Ожидаем.Что(Атрибуты["a"]).Равно(Повтор("x", 10));
	Ожидаем.Что(Тело.Значение).Равно(Повтор("x", 10));
	Ожидаем.Что(Тело.Размер).Равно(10);

КонецПроцедуры

&Тест
Процедура ОтрицательныеЛимитыНичегоНеОграничивают() Экспорт

	// Дано
	Ограничение = Новый ОграничениеРазмеровТелеметрии(-1, -1, -1);
	Атрибуты = Новый Соответствие;
	Атрибуты.Вставить("a", Повтор("x", 5000));

	// Когда
	Обрезки = Ограничение.ОграничитьАтрибуты(Атрибуты);
	Тело = Ограничение.ОграничитьТело(Повтор("x", 5000));

	// Тогда
	Ожидаем.Что(СтрДлина(Атрибуты["a"])).Равно(5000);
