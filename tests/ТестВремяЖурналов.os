// BSLLS:MagicNumber-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
// BSLLS:DuplicateStringLiteral-off
// BSLLS:MagicDate-off
#Использовать "../src/Экспорт"
#Использовать asserts

&Пластилин
Перем ВремяЖурналов;

&Тест
Процедура МикросекундыСовпадаютСУниверсальнымВременемВокругПереходаНаЗимнееВремя() Экспорт

	// Дано - час до перехода, повторяющийся час и час после, с шагом в минуту
	ПроверитьИнтервалПоМинутам(Дата("20261025000000"), Дата("20261025040000"), "Europe/Berlin");

КонецПроцедуры

&Тест
Процедура МикросекундыСовпадаютСУниверсальнымВременемВокругПереходаНаЛетнееВремя() Экспорт

	// Дано - часы до и после пропущенного часа 02:00-03:00
	ПроверитьИнтервалПоМинутам(Дата("20260329000000"), Дата("20260329015900"), "Europe/Berlin");
	ПроверитьИнтервалПоМинутам(Дата("20260329030000"), Дата("20260329050000"), "Europe/Berlin");

КонецПроцедуры

&Тест
Процедура ВремяИзПропущенногоЧасаВызываетИсключение() Экспорт

	// Дано
	Параметры = Новый Массив;
	Параметры.Добавить(Дата("20260329023000"));
	Параметры.Добавить(0);
	Параметры.Добавить("Europe/Berlin");

	// Тогда - как и УниверсальноеВремя
	Ожидаем.Что(ВремяЖурналов).Метод("ВМикросекунды", Параметры).ВыбрасываетИсключение("invalid time");

КонецПроцедуры

&Тест
Процедура ЧасовыеПоясаЧередуются() Экспорт

	// Дано
	МестноеВремя = Дата("20261021120000");

	// Когда - один и тот же час в разных поясах подряд
	Москва = ВремяЖурналов.ВМикросекунды(МестноеВремя, 1, "Europe/Moscow");
	Смещение = ВремяЖурналов.ВМикросекунды(МестноеВремя, 1, "GMT+02:00");
	СноваМосква = ВремяЖурналов.ВМикросекунды(МестноеВремя, 1, "Europe/Moscow");

	// Тогда
	Ожидаем.Что(Москва).Равно(Микросекунды(УниверсальноеВремя(МестноеВремя, "Europe/Moscow")) + 1);
	Ожидаем.Что(Смещение).Равно(Микросекунды(УниверсальноеВремя(МестноеВремя, "GMT+02:00")) + 1);
	Ожидаем.Что(СноваМосква).Равно(Москва);

КонецПроцедуры

Процедура ПроверитьИнтервалПоМинутам(Начало, Конец, ЧасовойПояс)
	СекундВМинуте = 60;
	МестноеВремя = Начало;
	Пока МестноеВремя <= Конец Цикл
		Ожидаем.Что(ВремяЖурналов.ВМикросекунды(МестноеВремя, 7, ЧасовойПояс))
			.Равно(Микросекунды(УниверсальноеВремя(МестноеВремя, ЧасовойПояс)) + 7);
		МестноеВремя = МестноеВремя + СекундВМинуте;
	КонецЦикла;
КонецПроцедуры

Функция Микросекунды(УниверсальноеВремя)
	Возврат (УниверсальноеВремя - Дата("19700101")) * 1000000;
КонецФункции
