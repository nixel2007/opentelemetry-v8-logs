	БезСерии = Атрибуты("v8.cluster.name", "Главный", "v8.license.type", "0");
	Ожидаем.Что(Показатели(Снимок, "v8.cluster.licenses.used")).ИмеетДлину(2);
	Ожидаем.Что(Значение(Снимок, "v8.cluster.licenses.used", Серия)).Равно(3);
	Ожидаем.Что(Значение(Снимок, "v8.cluster.licenses.used", БезСерии)).Равно(1);
	Ожидаем.Что(Показатели(Снимок, "v8.cluster.licenses.total")).ИмеетДлину(2);
	Ожидаем.Что(Значение(Снимок, "v8.cluster.licenses.total", Серия)).Равно(70);
	Ожидаем.Что(Значение(Снимок, "v8.cluster.licenses.total", БезСерии)).Равно(10);

