	// Когда
	Снимок = Опросчик().Снять();

	// Тогда
	Ожидаем.Что(Показатели(Снимок, "v8.cluster.sessions.long_calls")).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура СеансыСчитаютсяПоХостуРабочегоПроцесса() Экспорт

	// Дано
	Клиент.ДобавитьКластер("c1", "Главный");
	Клиент.ДобавитьБазу("c1", "b1", "erp");
	Клиент.ДобавитьПроцесс("c1", "p1", Новый Структура("Хост, Pid", "srv1", "4242"));
	Клиент.ДобавитьПроцесс("c1", "p2", Новый Структура("Хост, Pid", "srv2", "4343"));
	Клиент.ДобавитьСеанс("c1", Новый Структура("ИдБазы, Приложение, ИдПроцесса", "b1", "1CV8C", "p1"));
	Клиент.ДобавитьСеанс("c1", Новый Структура("ИдБазы, Приложение, ИдПроцесса", "b1", "1CV8C", "p1"));
	Клиент.ДобавитьСеанс("c1", Новый Структура("ИдБазы, Приложение, ИдПроцесса", "b1", "1CV8C", "p2"));
	Клиент.ДобавитьСеанс("c1", Новый Структура("ИдБазы, Приложение", "b1", "1CV8C"));

	// Когда
	Снимок = Опросчик().Снять();

	// Тогда
	Ожидаем.Что(Показатели(Снимок, "v8.cluster.sessions")).ИмеетДлину(3);
	Ожидаем.Что(Значение(Снимок, "v8.cluster.sessions", Атрибуты("v8.cluster.name", "Главный",
		"v8.infobase.name", "erp", "v8.session.app_id", "1CV8C", "host.name", "srv1"))).Равно(2);
	Ожидаем.Что(Значение(Снимок, "v8.cluster.sessions", Атрибуты("v8.cluster.name", "Главный",
		"v8.infobase.name", "erp", "v8.session.app_id", "1CV8C", "host.name", "srv2"))).Равно(1);
	Ожидаем.Что(Значение(Снимок, "v8.cluster.sessions", АтрибутыСеансов("erp", "1CV8C"))).Равно(1);

КонецПроцедуры

&Тест
Процедура СнимокСодержитСеансыСАтрибутамиПоКонтракту() Экспорт

	// Дано
	Клиент.ДобавитьКластер("c1", "Главный");
	Клиент.ДобавитьБазу("c1", "b1", "erp");
	Клиент.ДобавитьПроцесс("c1", "p1", Новый Структура("Хост, Pid", "srv1", "4242"));
	Поля = Новый Структура;
	Поля.Вставить("ИдБазы", "b1");
	Поля.Вставить("ИдПроцесса", "p1");
	Поля.Вставить("Приложение", "1CV8C");
	Поля.Вставить("Номер", 17);
	Поля.Вставить("ИмяПользователя", "Петров");
	Поля.Вставить("Хост", "client-pc");
	Поля.Вставить("АдресКлиента", "10.0.0.5");
	Поля.Вставить("Начало", Дата(2026, 10, 24, 9, 5, 7));
	Поля.Вставить("ПоследняяАктивность", Дата(2026, 10, 24, 10, 0, 0));
	Поля.Вставить("Спящий", Истина);
	Поля.Вставить("БлокированоСУБД", 1);
	Поля.Вставить("БлокированоБлокировками", 2);
	ДополнитьТройкой(Поля, "ПамятьТекущая, ПамятьЗа5Минут, ПамятьВсего", 100);
	ДополнитьТройкой(Поля, "ЧтениеТекущее, ЧтениеЗа5Минут, ЧтениеВсего", 200);
	ДополнитьТройкой(Поля, "ЗаписьТекущая, ЗаписьЗа5Минут, ЗаписьВсего", 300);
	ДополнитьТройкой(Поля, "ДлительностьТекущая, ДлительностьЗа5Минут, ДлительностьВсего", 400);
	ДополнитьТройкой(Поля, "ДлительностьСУБДТекущая, ДлительностьСУБДЗа5Минут, ДлительностьСУБДВсего", 500);
	ДополнитьТройкой(Поля, "ПроцессорноеВремяТекущее, ПроцессорноеВремяЗа5Минут, ПроцессорноеВремяВсего", 600);
	ДополнитьТройкой(Поля, "ВызововВсего, ВызововЗа5Минут", 700);
	ДополнитьТройкой(Поля, "БайтВсего, БайтЗа5Минут", 800);
	ДополнитьТройкой(Поля, "БайтСУБДВсего, БайтСУБДЗа5Минут", 900);
	Поля.Вставить("ТекущийСервис", "EventLogService");
	Поля.Вставить("РазделениеДанных", "'Область'=1");
	Поля.Вставить("Лицензии", МассивИз(Клиент.Лицензия("a.lic", "8100", 50), Клиент.Лицензия("b.lic", "8200", 10),
		Клиент.Лицензия("c.lic", "8100", 5)));
	Клиент.ДобавитьСеанс("c1", Поля);

	// Когда
	Снимок = Опросчик().Снять();

	// Тогда
	Ожидаемые = Новый Соответствие;
	Ожидаемые.Вставить("v8.cluster.name", "Главный");
	Ожидаемые.Вставить("v8.infobase.name", "erp");
	Ожидаемые.Вставить("v8.session.id", 17);
	Ожидаемые.Вставить("v8.session.app_id", "1CV8C");
	Ожидаемые.Вставить("user.name", "Петров");
	Ожидаемые.Вставить("host.name", "srv1");
	Ожидаемые.Вставить("process.pid", 4242);
	Ожидаемые.Вставить("v8.session.client.host", "client-pc");
	Ожидаемые.Вставить("client.address", "10.0.0.5");
	Ожидаемые.Вставить("v8.session.started_at", "2026-10-24T09:05:07");
	Ожидаемые.Вставить("v8.session.last_active_at", "2026-10-24T10:00:00");
	Ожидаемые.Вставить("v8.session.hibernated", Истина);
	Ожидаемые.Вставить("v8.session.blocked.db", 1);
	Ожидаемые.Вставить("v8.session.blocked.lock", 2);
	ВставитьТройку(Ожидаемые, "v8.session.memory", "current, last5min, total", 100);
	ВставитьТройку(Ожидаемые, "v8.session.read", "current, last5min, total", 200);
	ВставитьТройку(Ожидаемые, "v8.session.write", "current, last5min, total", 300);
	ВставитьТройку(Ожидаемые, "v8.session.duration", "current, last5min, total", 400);
	ВставитьТройку(Ожидаемые, "v8.session.duration.dbms", "current, last5min, total", 500);
	ВставитьТройку(Ожидаемые, "v8.session.cpu_time", "current, last5min, total", 600);
	ВставитьТройку(Ожидаемые, "v8.session.calls", "total, last5min", 700);
	ВставитьТройку(Ожидаемые, "v8.session.bytes", "total, last5min", 800);
	ВставитьТройку(Ожидаемые, "v8.session.dbms_bytes", "total, last5min", 900);
	Ожидаемые.Вставить("v8.session.current_service", "EventLogService");
	Ожидаемые.Вставить("v8.session.data_separation", "'Область'=1");
	Ожидаемые.Вставить("v8.session.license.series", "8100, 8200");
	Ожидаем.Что(Снимок.Сеансы).ИмеетДлину(1);
	Ожидаем.Что(ПредставлениеАтрибутов(Снимок.Сеансы[0].Атрибуты)).Равно(ПредставлениеАтрибутов(Ожидаемые));

КонецПроцедуры

&Тест
Процедура СеансБезСвязейИДатНеПолучаетПустыхАтрибутов() Экспорт

	// Дано
	Клиент.ДобавитьКластер("c1", "Главный");
	Клиент.ДобавитьСеанс("c1", Новый Структура("ИмяПользователя, Хост, АдресКлиента", "", "", ""));

	// Когда
	Снимок = Опросчик().Снять();

	// Тогда
	Ожидаем.Что(Снимок.Сеансы).ИмеетДлину(1);
	АтрибутыСеанса = Снимок.Сеансы[0].Атрибуты;
	Для Каждого Ключ Из СтрРазделить("v8.infobase.name, v8.session.app_id, user.name, host.name, process.pid,
		|v8.session.client.host, client.address, v8.session.started_at, v8.session.last_active_at,
		|v8.session.current_service, v8.session.data_separation, v8.session.license.series", ", " + Символы.ПС, Ложь) Цикл
		Ожидаем.Что(АтрибутыСеанса[Ключ], Ключ).Равно(Неопределено);
	КонецЦикла;
	Ожидаем.Что(АтрибутыСеанса["v8.cluster.name"]).Равно("Главный");
	Ожидаем.Что(АтрибутыСеанса["v8.session.id"]).Равно(0);
	Ожидаем.Что(АтрибутыСеанса["v8.session.memory.current"]).Равно(0);
	Ожидаем.Что(АтрибутыСеанса["v8.session.hibernated"]).Равно(Ложь);

КонецПроцедуры

&Тест
Процедура УдачныйОпросНеДаетПредупреждений() Экспорт

	// Дано
	Клиент.ДобавитьКластер("c1", "Главный");
	Клиент.ДобавитьСеанс("c1");

	// Когда
	Снимок = Опросчик().Снять();

	// Тогда
	Ожидаем.Что(Снимок.Сеансы).ИмеетДлину(1);
	Ожидаем.Что(Снимок.Предупреждения).ИмеетТип("Массив");
	Ожидаем.Что(Снимок.Предупреждения).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура НедоступныйКластерДаетПустыеСеансыИПредупреждения() Экспорт

	// Дано
	Клиент.ДобавитьКластер("c1", "Главный");
	Клиент.ДобавитьСеанс("c1");
	Клиент.ОтказыватьПриПодключении("RAS не отвечает");

	// Когда
	Снимок = Опросчик().Снять();

	// Тогда
	Для Каждого Ключ Из СтрРазделить("Время, Доступен, Ошибка, Показатели, Сеансы, Предупреждения", ", ", Ложь) Цикл
		Ожидаем.Что(Снимок.Свойство(Ключ), Ключ).ЭтоИстина();
	КонецЦикла;
	Ожидаем.Что(Снимок.Доступен).Равно(Ложь);
	Ожидаем.Что(Снимок.Сеансы).ИмеетДлину(0);
	Ожидаем.Что(Снимок.Предупреждения).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура БазыСУчетнымиДаннымиПолучаютБлокировки() Экспорт

	// Дано
	Клиент.ДобавитьКластер("c1", "Главный");
	Клиент.ДобавитьБазу("c1", "b1", "erp", Новый Структура("БлокировкаРегламентных, БлокировкаСеансов", Истина, Ложь));
	Клиент.ДобавитьБазу("c1", "b2", "zup", Новый Структура("БлокировкаРегламентных, БлокировкаСеансов", Ложь, Истина));
	Клиент.ДобавитьБазу("c1", "b3", "hrm", Новый Структура("БлокировкаРегламентных, БлокировкаСеансов", Истина, Истина));
	УчетныеДанные = Новый Соответствие;
	УчетныеДанные.Вставить("erp", Новый Структура("Пользователь, Пароль", "erp-admin", "erp-secret"));
	УчетныеДанные.Вставить("zup", Новый Структура("Пользователь, Пароль", "zup-admin", ""));

	// Когда
	Снимок = Опросчик( , , , , УчетныеДанные).Снять();

	// Тогда
	Ожидаем.Что(Клиент.Вызовы()).Содержит("АутентифицироватьБазу:c1:erp-admin:erp-secret");
	Ожидаем.Что(Клиент.Вызовы()).Содержит("ИнформацияОБазе:c1:b1");
	Ожидаем.Что(Клиент.Вызовы()).Содержит("АутентифицироватьБазу:c1:zup-admin:");
	Ожидаем.Что(Клиент.Вызовы()).Содержит("ИнформацияОБазе:c1:b2");
	Ожидаем.Что(Клиент.Вызовы()).Не_().Содержит("ИнформацияОБазе:c1:b3");
	Ожидаем.Что(Показатели(Снимок, "v8.cluster.infobase.scheduled_jobs_denied")).ИмеетДлину(2);
	Ожидаем.Что(Показатели(Снимок, "v8.cluster.infobase.sessions_denied")).ИмеетДлину(2);
	Ожидаем.Что(Значение(Снимок, "v8.cluster.infobase.scheduled_jobs_denied", База("erp"))).Равно(1);
	Ожидаем.Что(Значение(Снимок, "v8.cluster.infobase.sessions_denied", База("erp"))).Равно(0);
	Ожидаем.Что(Значение(Снимок, "v8.cluster.infobase.scheduled_jobs_denied", База("zup"))).Равно(0);
	Ожидаем.Что(Значение(Снимок, "v8.cluster.infobase.sessions_denied", База("zup"))).Равно(1);

КонецПроцедуры

