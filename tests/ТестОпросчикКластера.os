#Использовать "../src/Кластер"
#Использовать "./Поддержка"
#Использовать asserts
#Использовать collectionos

&Табакерка
&Пластилин("ОпросчикКластера")
Перем ТабакеркаОпросчиков;

Перем Клиент; // ФейковыйКлиентКластера - клиент RAS и его фабрика

&ПередКаждым
Процедура Подготовить() Экспорт
	Клиент = Новый ФейковыйКлиентКластера;
КонецПроцедуры

&Тест
Процедура УдачныйОпросДаетДоступныйСнимок() Экспорт

	// Дано
	Клиент.ДобавитьКластер("c1", "Главный");
	Момент = ТекущаяУниверсальнаяДата();

	// Когда
	Снимок = Опросчик().Снять();

	// Тогда
	Ожидаем.Что(Снимок.Доступен).ЭтоИстина();
	Ожидаем.Что(Снимок.Ошибка).Равно("");
	Ожидаем.Что(Снимок.Время >= Момент).ЭтоИстина();
	Ожидаем.Что(Снимок.Показатели).ИмеетТип("Массив");

КонецПроцедуры

&Тест
Процедура СеансыСчитаютсяПоБазеИПриложению() Экспорт

	// Дано
	Клиент.ДобавитьКластер("c1", "Главный");
	Клиент.ДобавитьБазу("c1", "b1", "erp");
	Клиент.ДобавитьБазу("c1", "b2", "zup");
	Клиент.ДобавитьСеанс("c1", Новый Структура("ИдБазы, Приложение", "b1", "1CV8C"));
	Клиент.ДобавитьСеанс("c1", Новый Структура("ИдБазы, Приложение", "b1", "1CV8C"));
	Клиент.ДобавитьСеанс("c1", Новый Структура("ИдБазы, Приложение", "b1", "WebClient"));
	Клиент.ДобавитьСеанс("c1", Новый Структура("ИдБазы, Приложение", "b2", "BackgroundJob"));

	// Когда
	Снимок = Опросчик().Снять();

	// Тогда
	Ожидаем.Что(Показатели(Снимок, "v8.cluster.sessions")).ИмеетДлину(3);
	Ожидаем.Что(Значение(Снимок, "v8.cluster.sessions", АтрибутыСеансов("erp", "1CV8C"))).Равно(2);
	Ожидаем.Что(Значение(Снимок, "v8.cluster.sessions", АтрибутыСеансов("erp", "WebClient"))).Равно(1);
	Ожидаем.Что(Значение(Снимок, "v8.cluster.sessions", АтрибутыСеансов("zup", "BackgroundJob"))).Равно(1);
	ПроверитьУникальность(Снимок);

КонецПроцедуры

&Тест
Процедура ЗаблокированныеСеансыСчитаютсяПоВидуБлокировки() Экспорт

	// Дано
	Клиент.ДобавитьКластер("c1", "Главный");
	Клиент.ДобавитьБазу("c1", "b1", "erp");
	Клиент.ДобавитьСеанс("c1", Новый Структура("ИдБазы, БлокированоСУБД", "b1", 3));
	Клиент.ДобавитьСеанс("c1", Новый Структура("ИдБазы, БлокированоБлокировками", "b1", 1));
	Клиент.ДобавитьСеанс("c1", Новый Структура("ИдБазы, БлокированоСУБД, БлокированоБлокировками", "b1", 1, 2));
	Клиент.ДобавитьСеанс("c1", Новый Структура("ИдБазы", "b1"));

	// Когда
	Снимок = Опросчик().Снять();

	// Тогда
	Ожидаем.Что(Показатели(Снимок, "v8.cluster.sessions.blocked")).ИмеетДлину(2);
	Ожидаем.Что(Значение(Снимок, "v8.cluster.sessions.blocked",
		Атрибуты("v8.cluster.name", "Главный", "v8.infobase.name", "erp", "v8.block.kind", "db"))).Равно(2);
	Ожидаем.Что(Значение(Снимок, "v8.cluster.sessions.blocked",
		Атрибуты("v8.cluster.name", "Главный", "v8.infobase.name", "erp", "v8.block.kind", "lock"))).Равно(2);

КонецПроцедуры

&Тест
Процедура ПамятьСеансовСуммируетсяПоБазеПриложениюИПользователю() Экспорт

	// Дано
	Клиент.ДобавитьКластер("c1", "Главный");
	Клиент.ДобавитьБазу("c1", "b1", "erp");
	Клиент.ДобавитьБазу("c1", "b2", "zup");
	Клиент.ДобавитьСеанс("c1", Новый Структура("ИдБазы, Приложение, ПамятьТекущая", "b1", "1CV8C", 100));
	Клиент.ДобавитьСеанс("c1", Новый Структура("ИдБазы, Приложение, ПамятьТекущая", "b1", "1CV8C", 250));
	Клиент.ДобавитьСеанс("c1", Новый Структура("ИдБазы, Приложение, ИмяПользователя, ПамятьТекущая", "b1", "1CV8C",
		"Петров", 40));
	Клиент.ДобавитьСеанс("c1", Новый Структура("ИдБазы, Приложение, ПамятьТекущая", "b1", "WebClient", 3));
	Клиент.ДобавитьСеанс("c1", Новый Структура("ИдБазы, Приложение, ПамятьТекущая", "b2", "1CV8C", 7));

	// Когда
	Снимок = Опросчик().Снять();

	// Тогда
	Ожидаем.Что(Показатели(Снимок, "v8.cluster.sessions.memory.usage")).ИмеетДлину(4);
	Ожидаем.Что(Значение(Снимок, "v8.cluster.sessions.memory.usage", СБП("erp", "1CV8C"))).Равно(350);
	Ожидаем.Что(Значение(Снимок, "v8.cluster.sessions.memory.usage", СБП("erp", "1CV8C", "Петров"))).Равно(40);
	Ожидаем.Что(Значение(Снимок, "v8.cluster.sessions.memory.usage", СБП("erp", "WebClient"))).Равно(3);
	Ожидаем.Что(Значение(Снимок, "v8.cluster.sessions.memory.usage", СБП("zup", "1CV8C"))).Равно(7);
	ПроверитьУникальность(Снимок);

КонецПроцедуры

&Тест
Процедура ВремяВызовыИВводВыводСеансовСуммируютсяПоБазеПриложениюИПользователю() Экспорт

	// Дано
	Клиент.ДобавитьКластер("c1", "Главный");
	Клиент.ДобавитьБазу("c1", "b1", "erp");
	Клиент.ДобавитьСеанс("c1", ПоляНагрузки(1500, 10, 2000, 500, 4096, 1024));
	Клиент.ДобавитьСеанс("c1", ПоляНагрузки(2500, 5, 3000, 250, 100, 10));

	// Когда
	Снимок = Опросчик().Снять();

	// Тогда
	Разрез = СБП("erp", "1CV8C");
	Ожидаем.Что(Значение(Снимок, "v8.cluster.sessions.cpu_time", Разрез)).Равно(4);
	Ожидаем.Что(Значение(Снимок, "v8.cluster.sessions.calls", Разрез)).Равно(15);
	Ожидаем.Что(Показатели(Снимок, "v8.cluster.sessions.call.duration")).ИмеетДлину(2);
	Ожидаем.Что(Значение(Снимок, "v8.cluster.sessions.call.duration", СБП("erp", "1CV8C", , "v8.call.kind", "call")))
		.Равно(5);
	Ожидаем.Что(Значение(Снимок, "v8.cluster.sessions.call.duration", СБП("erp", "1CV8C", , "v8.call.kind", "db")))
		.Равно(0.75);
	Ожидаем.Что(Показатели(Снимок, "v8.cluster.sessions.io")).ИмеетДлину(2);
	Ожидаем.Что(Значение(Снимок, "v8.cluster.sessions.io", СБП("erp", "1CV8C", , "v8.io.direction", "read")))
		.Равно(4196);
	Ожидаем.Что(Значение(Снимок, "v8.cluster.sessions.io", СБП("erp", "1CV8C", , "v8.io.direction", "write")))
		.Равно(1034);

КонецПроцедуры

&Тест
Процедура ДолгиеВызовыСчитаютсяПоКаждомуПорогуСНулевымиТочками() Экспорт

	// Дано
	Клиент.ДобавитьКластер("c1", "Главный");
	Клиент.ДобавитьБазу("c1", "b1", "erp");
	Клиент.ДобавитьБазу("c1", "b2", "zup");
	Клиент.ДобавитьСеанс("c1", Новый Структура("ИдБазы, Приложение, ДлительностьТекущая", "b1", "1CV8C", 59999));
	Клиент.ДобавитьСеанс("c1", Новый Структура("ИдБазы, Приложение, ДлительностьТекущая", "b1", "1CV8C", 60000));
	Клиент.ДобавитьСеанс("c1", Новый Структура("ИдБазы, Приложение, ДлительностьТекущая", "b1", "1CV8C", 3600000));
	Клиент.ДобавитьСеанс("c1", Новый Структура("ИдБазы, Приложение", "b2", "1CV8C"));

	// Когда
	Снимок = Опросчик( , , , МассивИз(60, 3600)).Снять();

	// Тогда
	Ожидаем.Что(Показатели(Снимок, "v8.cluster.sessions.long_calls")).ИмеетДлину(4);
	Ожидаем.Что(Значение(Снимок, "v8.cluster.sessions.long_calls", Порог("erp", 60))).Равно(2);
	Ожидаем.Что(Значение(Снимок, "v8.cluster.sessions.long_calls", Порог("erp", 3600))).Равно(1);
	Ожидаем.Что(Значение(Снимок, "v8.cluster.sessions.long_calls", Порог("zup", 60))).Равно(0);
	Ожидаем.Что(Значение(Снимок, "v8.cluster.sessions.long_calls", Порог("zup", 3600))).Равно(0);

КонецПроцедуры

