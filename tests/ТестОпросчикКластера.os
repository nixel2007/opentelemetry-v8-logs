	// Дано
	Клиент.ДобавитьКластер("c1", "Главный");
	Клиент.ДобавитьКластер("c2", "Резервный");

	// Когда
	Опросчик().Снять();

	// Тогда
	Ожидаем.Что(Клиент.Вызовы()).Содержит("АутентифицироватьКластер:c1:admin:secret");
	Ожидаем.Что(Клиент.Вызовы()).Содержит("АутентифицироватьКластер:c2:admin:secret");

КонецПроцедуры

&Тест
Процедура КластерАутентифицируетсяИБезЛогина() Экспорт

	// Дано
	Клиент.ДобавитьКластер("c1", "Главный");

	// Когда
	БезЛогина = ТабакеркаОпросчиков.Достать(Массивы.ИзЭлементов("ras-host", 1545, "", "", "", "", 10000,
		Новый Массив, Новый Соответствие));
	БезЛогина.УстановитьФабрикуКлиентов(Клиент);
	БезЛогина.Снять();

	// Тогда
	Ожидаем.Что(Клиент.Вызовы()).Содержит("АутентифицироватьКластер:c1::");

КонецПроцедуры

&Тест
Процедура КаждыйКластерПолучаетСвоиПоказатели() Экспорт

	// Дано
	Клиент.ДобавитьКластер("c1", "Главный");
	Клиент.ДобавитьКластер("c2", "Резервный");
	Клиент.ДобавитьБазу("c1", "b1", "erp");
	Клиент.ДобавитьБазу("c2", "b1", "erp");
	Клиент.ДобавитьСеанс("c1", Новый Структура("ИдБазы, Приложение", "b1", "1CV8C"));
	Клиент.ДобавитьСеанс("c2", Новый Структура("ИдБазы, Приложение", "b1", "1CV8C"));
	Клиент.ДобавитьСеанс("c2", Новый Структура("ИдБазы, Приложение", "b1", "1CV8C"));

	// Когда
	Снимок = Опросчик().Снять();

	// Тогда
	Ожидаем.Что(Значение(Снимок, "v8.cluster.sessions", АтрибутыСеансов("erp", "1CV8C"))).Равно(1);
	Ожидаем.Что(Значение(Снимок, "v8.cluster.sessions",
		Атрибуты("v8.cluster.name", "Резервный", "v8.infobase.name", "erp", "v8.session.app_id", "1CV8C")))
		.Равно(2);
	ПроверитьУникальность(Снимок);

КонецПроцедуры

&Тест
Процедура КаждыйСнятьПодключаетсяЗановоИОтключается() Экспорт

	// Дано
	Клиент.ДобавитьКластер("c1", "Главный");
	Повторный = Опросчик();

	// Когда
	Повторный.Снять();
	Повторный.Снять();

	// Тогда
	Ожидаем.Что(ЧислоВызовов("Создать:ras-host:1545")).Равно(2);
	Ожидаем.Что(ЧислоВызовов("Подключить")).Равно(2);
	Ожидаем.Что(ЧислоВызовов("Отключить")).Равно(2);

КонецПроцедуры

&Тест
Процедура ТаймаутДоходитДоФабрикиКлиентов() Экспорт

	// Дано
	Клиент.ДобавитьКластер("c1", "Главный");

	// Когда
	Опросчик("", "", 2500).Снять();

	// Тогда
	Ожидаем.Что(Клиент.Вызовы()).Содержит("ТаймаутМс:2500");

КонецПроцедуры

Функция Опросчик(ПользовательАгента = "", ПарольАгента = "", ТаймаутМс = 10000, Пороги = Неопределено,
	УчетныеДанные = Неопределено)
	Результат = ТабакеркаОпросчиков.Достать(Массивы.ИзЭлементов("ras-host", 1545, "admin", "secret",
		ПользовательАгента, ПарольАгента, ТаймаутМс, ?(Пороги = Неопределено, Новый Массив, Пороги),
		?(УчетныеДанные = Неопределено, Новый Соответствие, УчетныеДанные)));
	Результат.УстановитьФабрикуКлиентов(Клиент);
	Возврат Результат;
КонецФункции

Функция Показатели(Снимок, Имя)
	Результат = Новый Массив;
	Для Каждого Показатель Из Снимок.Показатели Цикл
		Если Показатель.Имя = Имя Тогда
			Результат.Добавить(Показатель);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Значение единственного показателя с именем и ровно этим набором атрибутов
Функция Значение(Снимок, Имя, ОжидаемыеАтрибуты)
	Найденные = Новый Массив;
	Для Каждого Показатель Из Показатели(Снимок, Имя) Цикл
		Если ПредставлениеАтрибутов(Показатель.Атрибуты) = ПредставлениеАтрибутов(ОжидаемыеАтрибуты) Тогда
			Найденные.Добавить(Показатель);
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(Найденные, СтрШаблон("%1 %2", Имя, ПредставлениеАтрибутов(ОжидаемыеАтрибуты))).ИмеетДлину(1);
	Возврат Найденные[0].Значение;
КонецФункции

Процедура ПроверитьУникальность(Снимок)
	Увиденные = Новый Соответствие;
	Для Каждого Показатель Из Снимок.Показатели Цикл
		Ключ = Показатель.Имя + " " + ПредставлениеАтрибутов(Показатель.Атрибуты);
		Ожидаем.Что(Увиденные[Ключ], Ключ).Равно(Неопределено);
		Увиденные.Вставить(Ключ, Истина);
	КонецЦикла;
КонецПроцедуры

// Ключи по алфавиту, значения с типом: равенство представлений - равенство наборов атрибутов
Функция ПредставлениеАтрибутов(Атрибуты)
	Ключи = Новый СписокЗначений;
	Для Каждого КлючИЗначение Из Атрибуты Цикл
		Ключи.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;
	Ключи.СортироватьПоЗначению();
	Части = Новый Массив;
	Для Каждого Ключ Из Ключи Цикл
		Части.Добавить(СтрШаблон("%1=%2:%3", Ключ.Значение, ТипЗнч(Атрибуты[Ключ.Значение]),
			Атрибуты[Ключ.Значение]));
	КонецЦикла;
	Возврат СтрСоединить(Части, "; ");
КонецФункции

Функция Атрибуты(К1, З1, К2 = Неопределено, З2 = Неопределено, К3 = Неопределено, З3 = Неопределено,
	К4 = Неопределено, З4 = Неопределено, К5 = Неопределено, З5 = Неопределено)
	Результат = Новый Соответствие;
	Результат.Вставить(К1, З1);
	Пары = Массивы.ИзЭлементов(К2, З2, К3, З3, К4, З4, К5, З5);
	Для Индекс = 0 По 3 Цикл
		Если Пары[Индекс * 2] <> Неопределено Тогда
			Результат.Вставить(Пары[Индекс * 2], Пары[Индекс * 2 + 1]);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция АтрибутыСеансов(База, Приложение)
	Возврат Атрибуты("v8.cluster.name", "Главный", "v8.infobase.name", База, "v8.session.app_id", Приложение);
КонецФункции

// Разрез «СБП» с необязательной пятой парой атрибутов
Функция СБП(База, Приложение, Пользователь = "Иванов", К = Неопределено, З = Неопределено)
	Возврат Атрибуты("v8.cluster.name", "Главный", "v8.infobase.name", База, "v8.session.app_id", Приложение,
		"user.name", Пользователь, К, З);
КонецФункции

Функция Порог(База, Секунд)
	Возврат СБП(База, "1CV8C", , "v8.duration.threshold", Секунд);
КонецФункции

Функция База(Имя)
	Возврат Атрибуты("v8.cluster.name", "Главный", "v8.infobase.name", Имя);
КонецФункции

Функция ПоляНагрузки(ПроцессорноеВремяВсего, ВызововВсего, ДлительностьВсего, ДлительностьСУБДВсего, ЧтениеВсего,
	ЗаписьВсего)
	Поля = Новый Структура("ИдБазы, Приложение", "b1", "1CV8C");
	Поля.Вставить("ПроцессорноеВремяВсего", ПроцессорноеВремяВсего);
	Поля.Вставить("ВызововВсего", ВызововВсего);
	Поля.Вставить("ДлительностьВсего", ДлительностьВсего);
	Поля.Вставить("ДлительностьСУБДВсего", ДлительностьСУБДВсего);
	Поля.Вставить("ЧтениеВсего", ЧтениеВсего);
	Поля.Вставить("ЗаписьВсего", ЗаписьВсего);
	Возврат Поля;
КонецФункции

// Поля по порядку получают Основание + 1, Основание + 2, ...
Процедура ДополнитьТройкой(Поля, Имена, Основание)
	Номер = 0;
	Для Каждого Имя Из СтрРазделить(Имена, ", ", Ложь) Цикл
		Номер = Номер + 1;
		Поля.Вставить(Имя, Основание + Номер);
	КонецЦикла;
КонецПроцедуры

Процедура ВставитьТройку(Атрибуты, Префикс, Суффиксы, Основание)
	Номер = 0;
	Для Каждого Суффикс Из СтрРазделить(Суффиксы, ", ", Ложь) Цикл
		Номер = Номер + 1;
		Атрибуты.Вставить(Префикс + "." + Суффикс, Основание + Номер);
	КонецЦикла;
КонецПроцедуры

Функция ВидВызова(Вид)
	Возврат Атрибуты("v8.cluster.name", "Главный", "host.name", "srv1", "process.pid", 4242, "v8.call.kind", Вид);
КонецФункции

Функция ЧислоВызовов(Вызов)
	Количество = 0;
	Для Каждого Сделанный Из Клиент.Вызовы() Цикл
		Если Сделанный = Вызов Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Количество;
КонецФункции

Функция МассивИз(Э1, Э2 = Неопределено, Э3 = Неопределено)
	Результат = Новый Массив;
	Для Каждого Элемент Из Массивы.ИзЭлементов(Э1, Э2, Э3) Цикл
		Если Элемент <> Неопределено Тогда
			Результат.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции
