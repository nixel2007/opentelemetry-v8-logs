&Тест
Процедура МетрикиПроцессаСнимаютсяСЕгоПолей() Экспорт

	// Дано
	Клиент.ДобавитьКластер("c1", "Главный");
	Поля = Новый Структура;
	Поля.Вставить("Хост", "srv1");
	Поля.Вставить("Pid", "4242");
	Поля.Вставить("ПамятьКБ", 2048);
	Поля.Вставить("Соединений", 7);
	Поля.Вставить("ДоступнаяПроизводительность", 150);
	Поля.Вставить("СредняяДлительностьВызова", 0.5);
	Поля.Вставить("СредняяДлительностьВызоваСУБД", 0.1);
	Поля.Вставить("СредняяДлительностьБлокировок", 0.2);
	Поля.Вставить("СредняяДлительностьСерверногоВызова", 0.3);
	Поля.Вставить("СредняяДлительностьОбратногоВызова", 0.4);
	Клиент.ДобавитьПроцесс("c1", "p1", Поля);

	// Когда
	Снимок = Опросчик().Снять();

	// Тогда
	Процесс = Атрибуты("v8.cluster.name", "Главный", "host.name", "srv1", "process.pid", 4242);
	Ожидаем.Что(Значение(Снимок, "v8.cluster.process.memory.usage", Процесс)).Равно(2048 * 1024);
	Ожидаем.Что(Значение(Снимок, "v8.cluster.process.connections", Процесс)).Равно(7);
	Ожидаем.Что(Значение(Снимок, "v8.cluster.process.available_performance", Процесс)).Равно(150);
	Ожидаем.Что(Показатели(Снимок, "v8.cluster.process.call.duration.avg")).ИмеетДлину(5);
	Ожидаем.Что(Значение(Снимок, "v8.cluster.process.call.duration.avg", ВидВызова("call"))).Равно(0.5);
	Ожидаем.Что(Значение(Снимок, "v8.cluster.process.call.duration.avg", ВидВызова("db"))).Равно(0.1);
	Ожидаем.Что(Значение(Снимок, "v8.cluster.process.call.duration.avg", ВидВызова("lock"))).Равно(0.2);
	Ожидаем.Что(Значение(Снимок, "v8.cluster.process.call.duration.avg", ВидВызова("server"))).Равно(0.3);
	Ожидаем.Что(Значение(Снимок, "v8.cluster.process.call.duration.avg", ВидВызова("back"))).Равно(0.4);

КонецПроцедуры

