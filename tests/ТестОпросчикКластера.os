Процедура ЛицензииСчитаютсяПоСерииСДедупликациейФайлов() Экспорт

	// Дано
	Клиент.ДобавитьКластер("c1", "Главный");
	ФайлА = Клиент.Лицензия("file-a.lic", "8100", 50);
	ФайлВ = Клиент.Лицензия("file-b.lic", "", 10);
	ФайлС = Клиент.Лицензия("file-c.lic", "8100", 20);
	Клиент.ДобавитьСеанс("c1", Новый Структура("Лицензии", МассивИз(ФайлА)));
	Клиент.ДобавитьСеанс("c1", Новый Структура("Лицензии", МассивИз(Клиент.Лицензия("file-a.lic", "8100", 50))));
	Клиент.ДобавитьСеанс("c1", Новый Структура("Лицензии", МассивИз(ФайлВ)));
	Клиент.ДобавитьСеанс("c1", Новый Структура("Лицензии", МассивИз(ФайлА, ФайлС)));
	Клиент.ДобавитьСеанс("c1");
	Клиент.ДобавитьПроцесс("c1", "p1", Новый Структура("Хост, Pid, Лицензии", "srv1", "1", МассивИз(ФайлА)));

