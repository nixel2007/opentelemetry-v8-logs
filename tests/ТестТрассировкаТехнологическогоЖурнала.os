Процедура КорневыеСобытияИзПараметров() Экспорт

	// Когда
	Экспортер(, "CALL,SCALL").ОбработатьСобытияТехнологическогоЖурнала(
		События("05:12.500000-500000,SCALL,1,OSThread=7,t:clientID=5"), ОписаниеФайла());

