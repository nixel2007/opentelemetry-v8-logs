&Тест
Процедура HTTPЗапросПереноситсяВСпанВызова() Экспорт

	// Дано - пара VRS внутри вызова, как в rphost за веб-сервером
	События = События(
		ЗапросVRS("05:12.100000-0", 2, "GET", "/hs/mini/hello?name=1"),
		"05:12.400000-0,VRSRESPONSE,2,OSThread=7,t:clientID=5,Status=200,Phrase=OK",
		"05:12.500000-500000,CALL,1,OSThread=7,t:clientID=5,IName=IVResourceRemoteConnection,MName=send");

	// Когда
	Экспортер().ОбработатьЗаписи(События, ОписаниеФайла());

	// Тогда - вызов стал HTTP-спаном сервера, события VRS остались спанами
	Спаны = Спаны();
	Ожидаем.Что(Спаны).ИмеетДлину(3);
	Вызов = НайтиСпан(Спаны, "GET /vrsmin/hs/mini/*");
	Ожидаем.Что(Вызов["kind"]).Равно(2);
	Ожидаем.Что(Вызов["status"]["code"]).Не_().Равно(2);
	Атрибуты = Атрибуты(Вызов);
	Ожидаем.Что(Атрибуты["http.request.method"]).Равно("GET");
	Ожидаем.Что(Атрибуты["url.path"]).Равно("/hs/mini/hello");
	Ожидаем.Что(Атрибуты["url.query"]).Равно("name=1");
	Ожидаем.Что(Атрибуты["http.response.status_code"]).Равно("200");
	Ожидаем.Что(Атрибуты["http.route"]).Равно("/vrsmin/hs/mini/*");
	Ожидаем.Что(Атрибуты["v8.http.route"]).Равно(Неопределено);
	Ожидаем.Что(Атрибуты["client.address"]).Равно("10.0.0.5");
	Ожидаем.Что(НайтиСпан(Спаны, "VRSREQUEST")["parentSpanId"]).Равно(Вызов["spanId"]);
	Ожидаем.Что(НайтиСпан(Спаны, "VRSRESPONSE")["parentSpanId"]).Равно(Вызов["spanId"]);

	// Тогда - запись лога вызова несет те же атрибуты
	Записи = ЗаписиЛога();
	Ожидаем.Что(Записи).ИмеетДлину(3);
	Ожидаем.Что(ПредставлениеАтрибутов(Записи[2])).Равно(ПредставлениеАтрибутов(Вызов));

КонецПроцедуры

