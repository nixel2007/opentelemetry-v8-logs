	Ожидаем.Что(Спаны[0]["parentSpanId"]).Равно(Спаны[1]["spanId"]);
	Ожидаем.Что(Спаны[0]["traceId"]).Равно(Спаны[1]["traceId"]);
	Ожидаем.Что(ЗначениеЗаполнено(Спаны[1]["parentSpanId"])).ЭтоЛожь();
	Ожидаем.Что(ЗаписиЛога()[0]["spanId"]).Равно(Спаны[0]["spanId"]);

КонецПроцедуры

&Тест
Процедура СобственныйМетодВызоваВажнееКонтекстаПотомков() Экспорт

	// Дано - у вызова контекста нет, у его событий есть: по нему видно, что делал пользователь
	Текст = "05:12.100000-1000,SDBL,1,OSThread=7,Sdbl=SELECT 1" + ПС
		+ "05:12.200000-1000,SDBL,1,OSThread=7,Context='Form.Write : Document.Doc.ObjectForm" + ПС
		+ "Document.Doc.ObjectModule : 18 : Query.Execute();'" + ПС
		+ "05:12.500000-500000,CALL,0,OSThread=7,IName=IWorker,MName=execute" + ПС
		+ "05:13.500000-500000,CALL,0,OSThread=7,IName=IWorker,MName=execute" + ПС;
	События = ПарсерТехнологическогоЖурнала.Разобрать(Текст, Дата(2026, 10, 20, 9, 0, 0)).События;

	// Когда
	Экспортер().ОбработатьЗаписи(События, ОписаниеФайла());

	// Тогда - следующий вызов без событий с контекстом называется по методу
	Спаны = Спаны();
	Ожидаем.Что(Спаны[2]["name"]).Равно("CALL IWorker.execute");
	Ожидаем.Что(Атрибуты(Спаны[2])["v8.techlog.IName"]).Равно("IWorker");
	Ожидаем.Что(Спаны[3]["name"]).Равно("CALL IWorker.execute");

КонецПроцедуры

&Тест
Процедура СобытиеНулевогоУровняСтановитсяКорнем() Экспорт

	// Дано - ниже уровня 0 стека нет, поэтому родителя у такого события быть не может
	События = События(
		  "05:12.100000-1000,SCALL,0,OSThread=7",
		  "05:12.300000-1000,SDBL,0,OSThread=7");

	// Когда
	Экспортер().ОбработатьЗаписи(События, ОписаниеФайла());

	// Тогда - каждое событие сразу отправлено своей трассой
	Спаны = Спаны();
	Ожидаем.Что(Спаны).ИмеетДлину(2);
	Ожидаем.Что(ЗначениеЗаполнено(Спаны[0]["parentSpanId"])).ЭтоЛожь();
	Ожидаем.Что(ЗначениеЗаполнено(Спаны[1]["parentSpanId"])).ЭтоЛожь();
	Ожидаем.Что(Спаны[0]["traceId"]).Не_().Равно(Спаны[1]["traceId"]);

КонецПроцедуры

&Тест
Процедура КореньНеОхватывающийОжидающиеСобытияНеЗабираетИхВСвоюТрассу() Экспорт

	// Дано - событие ждет родителя уровня 0, но вызов начался после него
	События = События(
		  "05:12.100000-1000,SCALL,1,OSThread=7",
		  "05:13.500000-500000,CALL,0,OSThread=7");

	// Когда
	Экспортер().ОбработатьЗаписи(События, ОписаниеФайла());

	// Тогда - ожидавшее событие закрыто своей трассой с синтетическим корнем
	Спаны = Спаны();
	Ожидаем.Что(Спаны).ИмеетДлину(3);
	Синтетический = НайтиСинтетическийСпан(Спаны);
	Вызов = НайтиСпан(Спаны, "CALL");
	Ожидаем.Что(Спаны[0]["parentSpanId"]).Равно(Синтетический["spanId"]);
	Ожидаем.Что(ЗначениеЗаполнено(Синтетический["parentSpanId"])).ЭтоЛожь();
	Ожидаем.Что(Вызов["traceId"]).Не_().Равно(Синтетический["traceId"]);
	Ожидаем.Что(ЗначениеЗаполнено(Вызов["parentSpanId"])).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ВПроцессеКлиентаСобытияНакапливаютсяДоСобытияНулевогоУровня() Экспорт

	// Дано - файловая база: код пользователя выполняется в процессе клиента без событий CALL
	События = События(
		  "05:12.100000-1000,SDBL,3,OSThread=7,Sdbl=UPDATE Document54 SET Posted=TRUE",
		  "05:12.150000-60000,SDBL,2,OSThread=7,Func=Transaction",
		  "05:12.200000-110000,SDBL,1,OSThread=7,Func=HoldConnection",
		  "05:12.300000-1000,SDBL,1,OSThread=7,Sdbl=SELECT ID FROM Document54");
	Экспортер = Экспортер();

	// Когда
	Экспортер.ОбработатьЗаписи(События, ОписаниеФайла(, "1cv8c"));

	// Тогда - спаны ждут, пока станет ясно, какие события верхнеуровневые; логи отправлены без трассы
	Ожидаем.Что(Спаны()).ИмеетДлину(0);
	Ожидаем.Что(ЗаписиЛога()).ИмеетДлину(4);
	Ожидаем.Что(ЗначениеЗаполнено(ЗаписиЛога()[0]["traceId"])).ЭтоЛожь();

	// Когда - событие уровня 0: охватить ожидающие события теперь не может ничто
	Экспортер.ОбработатьЗаписи(
		События("05:13.000000-1000,SDBL,0,OSThread=7,Sdbl=SELECT 1"), ОписаниеФайла(, "1cv8c"));

	// Тогда - у каждого верхнеуровневого события своя трасса
	Спаны = Спаны();
	Ожидаем.Что(Спаны).ИмеетДлину(5);
	Соединение = НайтиСпан(Спаны, "SDBL HoldConnection");
	Транзакция = НайтиСпан(Спаны, "SDBL Transaction");
	Изменение = НайтиСпан(Спаны, "SDBL UPDATE Document54");
	Чтение = НайтиСпан(Спаны, "SDBL SELECT Document54");
	Ожидаем.Что(ЗначениеЗаполнено(Соединение["parentSpanId"])).ЭтоЛожь();
	Ожидаем.Что(Транзакция["parentSpanId"]).Равно(Соединение["spanId"]);
	Ожидаем.Что(Изменение["parentSpanId"]).Равно(Транзакция["spanId"]);
	Ожидаем.Что(Изменение["traceId"]).Равно(Соединение["traceId"]);
	Ожидаем.Что(ЗначениеЗаполнено(Чтение["parentSpanId"])).ЭтоЛожь();
	Ожидаем.Что(Чтение["traceId"]).Не_().Равно(Соединение["traceId"]);
	Ожидаем.Что(Атрибуты(Чтение)["log.file.path"]).Равно("/var/log/1c/1cv8c_1234/26102009.log");
	Ожидаем.Что(Атрибуты(Чтение)["log.file.name"]).Равно("26102009.log");

КонецПроцедуры

&Тест
Процедура НакопленныеТрассыОтправляютсяПослеМинутыПростояПотока() Экспорт

	// Дано - событие закончилось в 1792487112100000 мкс Unix epoch, новых событий в журнале нет
	Экспортер = Экспортер();
	Экспортер.ОбработатьЗаписи(
		События("05:12.100000-1000,SDBL,1,OSThread=7"), ОписаниеФайла(, "1cv8c"));

	// Когда - проход завершился через 59 секунд
	Экспортер.ЗавершитьПроход(1792487112100000 + 59000000);

	// Тогда
	Ожидаем.Что(Спаны()).ИмеетДлину(0);

	// Когда - проход завершился через 61 секунду
	Экспортер.ЗавершитьПроход(1792487112100000 + 61000000);

	// Тогда
	Ожидаем.Что(Спаны()).ИмеетДлину(1);

КонецПроцедуры

&Тест
Процедура НакопленныеТрассыОтправляютсяПриЗакрытии() Экспорт

	// Дано
	Экспортер = Экспортер();
	Экспортер.ОбработатьЗаписи(
		События("05:12.100000-1000,SDBL,1,OSThread=7"), ОписаниеФайла(, "1cv8c"));

	// Когда
	Экспортер.Закрыть();

	// Тогда
	Ожидаем.Что(Спаны()).ИмеетДлину(1);

КонецПроцедуры

&Тест
Процедура РежимТрассЗадаетсяЯвно() Экспорт

	// Дано
	Потоковый = Экспортер("streaming");
	Накопительный = Экспортер("buffered");

	// Когда - режим не зависит от имени процесса
	Потоковый.ОбработатьЗаписи(
		События("05:12.100000-1000,SDBL,1,OSThread=7"), ОписаниеФайла(, "1cv8c"));
	Накопительный.ОбработатьЗаписи(
		События("05:12.100000-1000,SDBL,1,OSThread=7"), ОписаниеФайла(, "rphost"));

	// Тогда - отправлен только спан потокового режима
	Ожидаем.Что(Спаны()).ИмеетДлину(1);

