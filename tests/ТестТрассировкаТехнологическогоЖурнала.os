Процедура ВызовПродолжаетВнешнююТрассуИзTraceparent() Экспорт

	// Дано - HTTP-запрос с заголовком traceparent внутри вызова
	События = События(
		ЗапросVRS("05:12.100000-0", 2, "GET", "/hs/mini/hello", "traceparent: " + ВнешнийTraceparent()),
		"05:12.400000-0,VRSRESPONSE,2,OSThread=7,t:clientID=5,Status=200,Phrase=OK",
		"05:12.500000-500000,CALL,1,OSThread=7,t:clientID=5,IName=IVResourceRemoteConnection,MName=send");

	// Когда
	Экспортер().ОбработатьЗаписи(События, ОписаниеФайла());

	// Тогда - вызов - потомок внешнего спана, вся трасса потока - во внешней трассе
	Спаны = Спаны();
	Вызов = НайтиСпан(Спаны, "GET /vrsmin/hs/mini/*");
	Ожидаем.Что(Вызов["parentSpanId"]).Равно(ВнешнийИдСпана());
	Для Каждого Спан Из Спаны Цикл
		Ожидаем.Что(Спан["traceId"]).Равно(ВнешнийИдТрассировки());
	КонецЦикла;
	Ожидаем.Что(НайтиСпан(Спаны, "VRSREQUEST")["parentSpanId"]).Равно(Вызов["spanId"]);
	Ожидаем.Что(Атрибуты(Вызов)["v8.trace.detached_trace_id"]).Равно(Неопределено);
	Ожидаем.Что(Вызов["links"] = Неопределено ИЛИ Вызов["links"].Количество() = 0).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СпаныДоЗапросаСTraceparentОстаютсяВПрежнейТрассеСоСсылкой() Экспорт

	// Дано - поиск процесса в кластере записан в вызове раньше HTTP-запроса
	События = События(
		"05:12.050000-1,SCALL,2,OSThread=7,t:clientID=5,IName=IClusterState,MName=getWorkProcess",
		ЗапросVRS("05:12.100000-0", 2, "GET", "/hs/mini/hello", "traceparent: " + ВнешнийTraceparent()),
		"05:12.400000-0,VRSRESPONSE,2,OSThread=7,t:clientID=5,Status=200,Phrase=OK",
		"05:12.500000-500000,CALL,1,OSThread=7,t:clientID=5,IName=IVResourceRemoteConnection,MName=send");

	// Когда
	Экспортер().ОбработатьЗаписи(События, ОписаниеФайла());

	// Тогда - спан, отправленный до запроса, остался в прежней трассе
	Спаны = Спаны();
	Вызов = НайтиСпан(Спаны, "GET /vrsmin/hs/mini/*");
	Ранний = НайтиСпан(Спаны, "SCALL");
	ПрежняяТрасса = Ранний["traceId"];
	Ожидаем.Что(ПрежняяТрасса).Не_().Равно(ВнешнийИдТрассировки());
	Ожидаем.Что(Ранний["parentSpanId"]).Равно(Вызов["spanId"]);
	Ожидаем.Что(Вызов["traceId"]).Равно(ВнешнийИдТрассировки());
	Ожидаем.Что(Вызов["parentSpanId"]).Равно(ВнешнийИдСпана());

	// Тогда - вызов ссылается на прежнюю трассу ссылкой и атрибутом, запись лога вызова - атрибутом
	Ожидаем.Что(Атрибуты(Вызов)["v8.trace.detached_trace_id"]).Равно(ПрежняяТрасса);
	// Ссылка - на первый спан прежней трассы: ссылку спана на свой же идентификатор в другой трассе
	// Grafana не отображает
	Ожидаем.Что(Вызов["links"]).ИмеетДлину(1);
	Ожидаем.Что(Вызов["links"][0]["traceId"]).Равно(ПрежняяТрасса);
	Ожидаем.Что(Вызов["links"][0]["spanId"]).Равно(Ранний["spanId"]);
	ЗаписьВызова = ЗаписиЛога()[3];
	Ожидаем.Что(Атрибуты(ЗаписьВызова)["v8.trace.detached_trace_id"]).Равно(ПрежняяТрасса);

КонецПроцедуры

&Тест
Процедура ВРежимеНакопленияВсяТрассаВызоваВоВнешнейТрассе() Экспорт

	// Дано
	События = События(
		"05:12.050000-1,SCALL,2,OSThread=7,t:clientID=5,IName=IClusterState,MName=getWorkProcess",
		ЗапросVRS("05:12.100000-0", 2, "GET", "/hs/mini/hello", "traceparent: " + ВнешнийTraceparent()),
		"05:12.400000-0,VRSRESPONSE,2,OSThread=7,t:clientID=5,Status=200,Phrase=OK",
		"05:12.500000-500000,CALL,1,OSThread=7,t:clientID=5,IName=IVResourceRemoteConnection,MName=send");

	// Когда
	Экспортер = Экспортер("buffered");
	Экспортер.ОбработатьЗаписи(События, ОписаниеФайла());
	Экспортер.Закрыть();

	// Тогда - дерево вызова отправляется целиком, прежней трассы нет
	Спаны = Спаны();
	Ожидаем.Что(Спаны).ИмеетДлину(4);
	Для Каждого Спан Из Спаны Цикл
		Ожидаем.Что(Спан["traceId"]).Равно(ВнешнийИдТрассировки());
	КонецЦикла;
	Вызов = НайтиСпан(Спаны, "GET /vrsmin/hs/mini/*");
	Ожидаем.Что(Вызов["parentSpanId"]).Равно(ВнешнийИдСпана());
	Ожидаем.Что(Атрибуты(Вызов)["v8.trace.detached_trace_id"]).Равно(Неопределено);

КонецПроцедуры

