&Тест
Процедура УстаревшийHTTPЗапросУдаляетсяПослеПрохода() Экспорт

	// Дано - пара VRS без вызова, как в w3wp
	Экспортер = Экспортер();
	Экспортер.ОбработатьЗаписи(События(
		ЗапросVRS("05:12.100000-0", 2, "GET", "/hs/mini/hello"),
		"05:12.400000-0,VRSRESPONSE,2,OSThread=7,t:clientID=5,Status=200,Phrase=OK"), ОписаниеФайла());

	// Когда - проход через два часа, и только потом вызов, будто бы охватывающий запрос
	ДваЧасаСпустя = Дата(2026, 10, 20, 11, 0, 0);
	Экспортер.ЗавершитьПроход(МикросекундыUnix(Дата(2026, 10, 20, 11, 5, 0)));
	Вызов = ПарсерТехнологическогоЖурнала.Разобрать(
		"05:12.500000-7200400000,CALL,1,OSThread=7,t:clientID=5,IName=IVResourceRemoteConnection,MName=send" + ПС,
		ДваЧасаСпустя).События;
	Экспортер.ОбработатьЗаписи(Вызов, ОписаниеФайла(ДваЧасаСпустя));

	// Тогда - запрос, который дольше времени зависания трасс ждал вызова, забыт
	Ожидаем.Что(Атрибуты(НайтиСпан(Спаны(), "CALL"))["http.request.method"]).Равно(Неопределено);

КонецПроцедуры

