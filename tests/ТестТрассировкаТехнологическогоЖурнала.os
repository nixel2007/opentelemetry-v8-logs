КонецПроцедуры

&Тест
Процедура МестоИсключенияБезКонтекстаИзОписания() Экспорт

	// Когда
	Экспортер().ОбработатьЗаписи(События(
		"05:12.100000-1000,EXCP,1,OSThread=7,Exception=RuntimeException,"
			+ "Descr='{ОбщийМодуль.Тест.Модуль(42)}: Деление на 0'"), ОписаниеФайла());

	// Тогда
	Атрибуты = Атрибуты(ЗаписиЛога()[0]);
	Ожидаем.Что(Атрибуты["code.file.path"]).Равно("ОбщийМодуль.Тест.Модуль");
	Ожидаем.Что(Атрибуты["code.line.number"]).Равно("42");
	Ожидаем.Что(Атрибуты.Получить("code.stacktrace")).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура СобытиеБезКонтекстаНеПолучаетМестоВКоде() Экспорт

	// Когда
	Экспортер().ОбработатьЗаписи(События(
		"05:12.100000-1000,DBMSSQL,1,OSThread=7,Sql=SELECT 1"), ОписаниеФайла());

	// Тогда
	Для Каждого Атрибут Из Атрибуты(Спаны()[0]) Цикл
		Ожидаем.Что(СтрНачинаетсяС(Атрибут.Ключ, "code.")).ЭтоЛожь();
	КонецЦикла;

КонецПроцедуры

// Свойство Context из строк кадров: каждый следующий кадр с отступом на табуляцию больше
&Тест
Процедура СпанПолучаетОбрезанныеАтрибутыСобытияБезРазмераТела() Экспорт

	// Дано
	События = События(
		"05:12.100000-1000,DBMSSQL,1,OSThread=7,Sql='" + Повтор("x", 200000) + "'",
		"05:12.500000-500000,CALL,0,OSThread=7");

	// Когда
	Экспортер().ОбработатьЗаписи(События, ОписаниеФайла());

	// Тогда
	Спан = НайтиСпан(Спаны(), "DBMSSQL");
	Атрибуты = Атрибуты(Спан);
	Ожидаем.Что(РазмерUTF8(Атрибуты["v8.techlog.Sql"])).Равно(2048);
	Ожидаем.Что(СтрЗаканчиваетсяНа(Атрибуты["v8.techlog.Sql"], "...[truncated]")).ЭтоИстина();
	Ожидаем.Что(ОбрезанныеАтрибуты(Спан)).Равно("v8.techlog.Sql");
	Ожидаем.Что(Атрибуты.Получить("v8.techlog.truncation.body.original_size")).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура СобытиеСпанаИсключенияРежимаНакопленияОбрезается() Экспорт

	// Дано
	События = События(
		"05:12.200000-0,EXCP,0,OSThread=7,Exception=DataBaseException,Descr='" + Повтор("x", 5000) + "'");

	// Когда
	Экспортер("buffered").ОбработатьЗаписи(События, ОписаниеФайла(, "1cv8c"));

	// Тогда
	СобытиеСпана = НайтиСпан(Спаны(), "EXCP")["events"][0];
	Атрибуты = Атрибуты(СобытиеСпана);
	Ожидаем.Что(РазмерUTF8(Атрибуты["exception.stacktrace"])).Равно(2048);
	Ожидаем.Что(РазмерUTF8(Атрибуты["exception.message"])).Равно(2048);
	Ожидаем.Что(ОбрезанныеАтрибуты(СобытиеСпана)).Равно("exception.message,exception.stacktrace");

КонецПроцедуры

// Ключи из атрибута v8.techlog.truncation.attributes по алфавиту через запятую
Функция ОбрезанныеАтрибуты(Объект)
	Ключи = Новый СписокЗначений;
	Для Каждого Атрибут Из Объект["attributes"] Цикл
		Если Атрибут["key"] = "v8.techlog.truncation.attributes" Тогда
			Для Каждого Элемент Из Атрибут["value"]["arrayValue"]["values"] Цикл
				Ключи.Добавить(Элемент["stringValue"]);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Ключи.СортироватьПоЗначению();
	Возврат СтрСоединить(Ключи.ВыгрузитьЗначения(), ",");
КонецФункции

Функция Повтор(Строка, Количество)
	Части = Новый Массив;
	Для Номер = 1 По Количество Цикл // BSLLS:UnusedLocalVariable-off
		Части.Добавить(Строка);
	КонецЦикла;
	Возврат СтрСоединить(Части);
КонецФункции

Функция РазмерUTF8(Строка)
	Возврат ПолучитьДвоичныеДанныеИзСтроки(Строка, "UTF-8").Размер();
КонецФункции

Функция Контекст(Кадр1, Кадр2 = "", Кадр3 = "")
	Возврат "Context='" + ЗначениеКонтекста(Кадр1, Кадр2, Кадр3) + "'";
КонецФункции

Функция ЗначениеКонтекста(Кадр1, Кадр2 = "", Кадр3 = "")
	Кадры = Новый Массив;
	Кадры.Добавить(Кадр1);
	Если ЗначениеЗаполнено(Кадр2) Тогда
		Кадры.Добавить(Символы.Таб + Кадр2);
	КонецЕсли;
	Если ЗначениеЗаполнено(Кадр3) Тогда
		Кадры.Добавить(Символы.Таб + Символы.Таб + Кадр3);
	КонецЕсли;
	Возврат СтрСоединить(Кадры, ПС);
КонецФункции

Функция Экспортер(РежимТрасс = "auto", КорневыеСобытия = "CALL", ТрассыВключены = Истина,
	ВозвращенныеСтрокиВключены = Истина, ИдСеансаВключен = Истина)
	Возврат ТабакеркаЭкспортеров.Достать(Массивы.ИзЭлементов(Телеметрия, "", "Etc/UTC", "",
		ТрассыВключены, КорневыеСобытия, РежимТрасс, ВозвращенныеСтрокиВключены, ИдСеансаВключен, Истина));
КонецФункции

Функция События(Строка1, Строка2 = "", Строка3 = "", Строка4 = "")
	Строки = Новый Массив;
	Для Каждого Строка Из СтрРазделить(СтрШаблон("%1|%2|%3|%4", Строка1, Строка2, Строка3, Строка4), "|", Ложь) Цикл
		Строки.Добавить(Строка);
	КонецЦикла;
	Текст = СтрСоединить(Строки, ПС) + ПС;
	Возврат ПарсерТехнологическогоЖурнала.Разобрать(Текст, Дата(2026, 10, 20, 9, 0, 0)).События;
КонецФункции

Функция ОписаниеФайла(ДатаЧаса = Неопределено, Процесс = "rphost")
	Описание = Новый Структура;
	Описание.Вставить("Путь", СтрШаблон("/var/log/1c/%1_1234/26102009.log", Процесс));
	Описание.Вставить("Каталог", "/var/log/1c");
	Описание.Вставить("Процесс", Процесс);
	Описание.Вставить("ИдПроцесса", "1234");
	Описание.Вставить("ДатаЧаса", ?(ДатаЧаса = Неопределено, Дата(2026, 10, 20, 9, 0, 0), ДатаЧаса));
	Возврат Описание;
КонецФункции

Функция Спаны()
	Результат = Новый Массив;
	Для Каждого Отправка Из ТранспортСпанов.ПолучитьОтправленные() Цикл
		Для Каждого РесурсныеСпаны Из Отправка["Данные"]["resourceSpans"] Цикл
			Для Каждого СпаныОбласти Из РесурсныеСпаны["scopeSpans"] Цикл
				Для Каждого Спан Из СпаныОбласти["spans"] Цикл
					Результат.Добавить(Спан);
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Спан с заданным именем; если такого нет - первый спан, имя которого начинается с имени события
Функция НайтиСпан(Спаны, Имя)
	Для Каждого Спан Из Спаны Цикл
		Если Спан["name"] = Имя Тогда
			Возврат Спан;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Спан Из Спаны Цикл
		Если СтрНачинаетсяС(Спан["name"], Имя + " ") Тогда
			Возврат Спан;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "Не найден спан " + Имя;
КонецФункции

Функция НайтиСинтетическийСпан(Спаны)
	Для Каждого Спан Из Спаны Цикл
		Если Атрибуты(Спан)["v8.techlog.synthetic"] <> Неопределено Тогда
			Возврат Спан;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "Не найден синтетический спан";
КонецФункции

Функция ЗаписиЛога()
	Результат = Новый Массив;
	Для Каждого Отправка Из ТранспортЛогов.ПолучитьОтправленные() Цикл
		Для Каждого РесурсныеЛоги Из Отправка["Данные"]["resourceLogs"] Цикл
			Для Каждого ЛогиОбласти Из РесурсныеЛоги["scopeLogs"] Цикл
				Для Каждого Запись Из ЛогиОбласти["logRecords"] Цикл
					Результат.Добавить(Запись);
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Атрибуты OTLP в виде соответствия ключ -> строковое представление значения
Функция СпанПоИдентификатору(Спаны, ИдСпана)
	Для Каждого Спан Из Спаны Цикл
		Если Спан["spanId"] = ИдСпана Тогда
			Возврат Спан;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "Не найден спан " + ИдСпана;
КонецФункции

Функция ПредставлениеАтрибутов(Объект)
	Строки = Новый СписокЗначений;
	Для Каждого КлючИЗначение Из Атрибуты(Объект) Цикл
		Строки.Добавить(КлючИЗначение.Ключ + "=" + КлючИЗначение.Значение);
	КонецЦикла;
	Строки.СортироватьПоЗначению();
	Возврат СтрСоединить(Строки.ВыгрузитьЗначения(), Символы.ПС);
КонецФункции

Функция Атрибуты(Объект)
	Результат = Новый Соответствие;
	Если Объект["attributes"] = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Атрибут Из Объект["attributes"] Цикл
		Значение = Атрибут["value"];
		Для Каждого Вид Из Значение Цикл
			Результат.Вставить(Атрибут["key"], Строка(Вид.Значение));
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

ПС = Символы.ПС;
