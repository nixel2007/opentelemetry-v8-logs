// BSLLS:MagicNumber-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
#Использовать "../src/Экспорт"
#Использовать "../src/ТехнологическийЖурнал"
#Использовать asserts
#Использовать opentelemetry
#Использовать collectionos

&Пластилин
Перем ПарсерТехнологическогоЖурнала;

&Табакерка
&Пластилин("ТелеметрияЖурналов")
Перем ТабакеркаТелеметрии;

&Табакерка
&Пластилин("ЭкспортерТехнологическогоЖурнала")
Перем ТабакеркаЭкспортеров;

Перем ПС;
Перем ТранспортСпанов;
Перем ТранспортЛогов;
Перем ПровайдерТрассировки;
Перем ПровайдерЛогов;
Перем Телеметрия;

&ПередКаждым
Процедура Подготовить() Экспорт
	Ресурс = Новый ОтелРесурс(Истина, , Истина);
	ТранспортСпанов = Новый ОтелВПамятьТранспорт;
	ПровайдерТрассировки = Новый ОтелПровайдерТрассировки(Ресурс,
		Новый ОтелПростойПроцессорСпанов(Новый ОтелЭкспортерСпанов(ТранспортСпанов)));
	ТранспортЛогов = Новый ОтелВПамятьТранспорт;
	ПровайдерЛогов = Новый ОтелПровайдерЛогирования(Ресурс,
		Новый ОтелПростойПроцессорЛогов(Новый ОтелЭкспортерЛогов(ТранспортЛогов)));
	Телеметрия = ТабакеркаТелеметрии.Достать(Массивы.ИзЭлементов(ПровайдерЛогов, ПровайдерТрассировки,
		Неопределено, 3600000, "1c", ""));
КонецПроцедуры

&ПослеКаждого
Процедура Закрыть() Экспорт
	Телеметрия.Закрыть();
	ПровайдерТрассировки.Закрыть();
	ПровайдерЛогов.Закрыть();
КонецПроцедуры

&Тест
Процедура ВложенноеСобытиеОтправляетсяСразуСоСсылкойНаБудущийВызов() Экспорт

	// Дано
	Экспортер = Экспортер();

	// Когда - вложенное событие прочитано, вызов еще не записан
	Экспортер.ОбработатьСобытияТехнологическогоЖурнала(
		События("05:12.100000-20000,DBMSSQL,2,OSThread=7,t:clientID=5,Sql=SELECT 1"), ОписаниеФайла());

	// Тогда - спан уже отправлен
	Спаны = Спаны();
	Ожидаем.Что(Спаны).ИмеетДлину(1);
	Запрос = Спаны[0];
	Ожидаем.Что(ЗначениеЗаполнено(Запрос["parentSpanId"])).ЭтоИстина();

	// Когда - записан вызов
	Экспортер.ОбработатьСобытияТехнологическогоЖурнала(
		События("05:12.500000-500000,CALL,1,OSThread=7,t:clientID=5,Usr=Admin"), ОписаниеФайла());

	// Тогда - вызов получил заранее выданный идентификатор и трассу
	Вызов = НайтиСпан(Спаны(), "CALL");
	Ожидаем.Что(Вызов["spanId"]).Равно(Запрос["parentSpanId"]);
	Ожидаем.Что(Вызов["traceId"]).Равно(Запрос["traceId"]);
	Ожидаем.Что(ЗначениеЗаполнено(Вызов["parentSpanId"])).ЭтоЛожь();
	Ожидаем.Что(Вызов["startTimeUnixNano"]).Равно("1792487112000000000");
	Ожидаем.Что(Вызов["endTimeUnixNano"]).Равно("1792487112500000000");
	Ожидаем.Что(Атрибуты(Вызов)["v8.techlog.Usr"]).Равно("Admin");
	Ожидаем.Что(Запрос["startTimeUnixNano"]).Равно("1792487112080000000");
	Ожидаем.Что(Атрибуты(Запрос)["db.system.name"]).Равно("microsoft.sql_server");
	Ожидаем.Что(Запрос["kind"]).Равно(3);

КонецПроцедуры

&Тест
Процедура ВложенностьПоУровням() Экспорт

	// Дано - DBMSSQL внутри SDBL внутри CALL
	События = События(
		  "05:12.100000-20000,DBMSSQL,3,OSThread=7,t:clientID=5",
		  "05:12.150000-100000,SDBL,2,OSThread=7,t:clientID=5",
		  "05:12.500000-500000,CALL,1,OSThread=7,t:clientID=5");

	// Когда
	Экспортер().ОбработатьСобытияТехнологическогоЖурнала(События, ОписаниеФайла());

	// Тогда
	Спаны = Спаны();
	Ожидаем.Что(Спаны).ИмеетДлину(3);
	Ожидаем.Что(НайтиСпан(Спаны, "DBMSSQL")["parentSpanId"]).Равно(НайтиСпан(Спаны, "SDBL")["spanId"]);
	Ожидаем.Что(НайтиСпан(Спаны, "SDBL")["parentSpanId"]).Равно(НайтиСпан(Спаны, "CALL")["spanId"]);

КонецПроцедуры

&Тест
Процедура ПропущенныйУровеньЗаполняетсяСинтетическимСпаном() Экспорт

	// Дано - событие уровня 2 не пишется в журнал
	События = События(
		  "05:12.100000-20000,DBMSSQL,3,OSThread=7,t:clientID=5",
		  "05:12.500000-500000,CALL,1,OSThread=7,t:clientID=5");

	// Когда
	Экспортер().ОбработатьСобытияТехнологическогоЖурнала(События, ОписаниеФайла());

	// Тогда
	Спаны = Спаны();
	Ожидаем.Что(Спаны).ИмеетДлину(3);
	Синтетический = НайтиСинтетическийСпан(Спаны);
	Ожидаем.Что(НайтиСпан(Спаны, "DBMSSQL")["parentSpanId"]).Равно(Синтетический["spanId"]);
	Ожидаем.Что(Синтетический["parentSpanId"]).Равно(НайтиСпан(Спаны, "CALL")["spanId"]);
	Ожидаем.Что(Синтетический["startTimeUnixNano"]).Равно("1792487112080000000");
	Ожидаем.Что(Синтетический["endTimeUnixNano"]).Равно("1792487112100000000");
	Ожидаем.Что(Атрибуты(Синтетический)["v8.techlog.depth"]).Равно("2");

КонецПроцедуры

&Тест
Процедура СобытиеНеОхватывающееПотомковНеСтановитсяРодителем() Экспорт

	// Дано - TLOCK уровня 2 записан после DBMSSQL уровня 3, но не охватывает его по времени:
	// настоящий родитель DBMSSQL не попал в журнал
	События = События(
		  "05:12.100000-20000,DBMSSQL,3,OSThread=7,t:clientID=5",
		  "05:12.350000-50000,TLOCK,2,OSThread=7,t:clientID=5",
		  "05:12.500000-500000,CALL,1,OSThread=7,t:clientID=5");

	// Когда
	Экспортер().ОбработатьСобытияТехнологическогоЖурнала(События, ОписаниеФайла());

	// Тогда
	Спаны = Спаны();
	Ожидаем.Что(Спаны).ИмеетДлину(4);
	Вызов = НайтиСпан(Спаны, "CALL");
	Синтетический = НайтиСинтетическийСпан(Спаны);
	Ожидаем.Что(НайтиСпан(Спаны, "DBMSSQL")["parentSpanId"]).Равно(Синтетический["spanId"]);
	Ожидаем.Что(Синтетический["parentSpanId"]).Равно(Вызов["spanId"]);
	Ожидаем.Что(НайтиСпан(Спаны, "TLOCK")["parentSpanId"]).Равно(Вызов["spanId"]);

КонецПроцедуры

&Тест
Процедура РазныеПотокиИКлиентыВРазныхТрассах() Экспорт

	// Дано
	События = События(
		  "05:12.100000-1000,DBMSSQL,2,OSThread=8,t:clientID=5",
		  "05:12.200000-1000,DBMSSQL,2,OSThread=7,t:clientID=6",
		  "05:12.300000-1000,SDBL,2,OSThread=7,t:clientID=5",
		  "05:12.500000-500000,CALL,1,OSThread=7,t:clientID=5");

	// Когда
	Экспортер().ОбработатьСобытияТехнологическогоЖурнала(События, ОписаниеФайла());

	// Тогда
	Спаны = Спаны();
	Вызов = НайтиСпан(Спаны, "CALL");
	Ожидаем.Что(НайтиСпан(Спаны, "SDBL")["traceId"]).Равно(Вызов["traceId"]);
	Для Каждого Спан Из Спаны Цикл
		Если Спан["name"] = "DBMSSQL" Тогда
			Ожидаем.Что(Спан["traceId"]).Не_().Равно(Вызов["traceId"]);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура СобытияБезКлиентаСвязываютсяСВызовомПотока() Экспорт

	// Дано - вызов и его события без t:clientID, вызов на уровне 0
	События = События(
		  "05:12.100000-1000,SDBL,1,OSThread=7,Sdbl=SELECT 1",
		  "05:12.500000-500000,CALL,0,OSThread=7,IName=IWorker,MName=execute");

	// Когда
	Экспортер().ОбработатьСобытияТехнологическогоЖурнала(События, ОписаниеФайла());

	// Тогда
	Спаны = Спаны();
	Ожидаем.Что(Спаны).ИмеетДлину(2);
	Ожидаем.Что(Спаны[0]["parentSpanId"]).Равно(Спаны[1]["spanId"]);
	Ожидаем.Что(Спаны[0]["traceId"]).Равно(Спаны[1]["traceId"]);
	Ожидаем.Что(ЗначениеЗаполнено(Спаны[1]["parentSpanId"])).ЭтоЛожь();
	Ожидаем.Что(ЗаписиЛога()[0]["spanId"]).Равно(Спаны[0]["spanId"]);

КонецПроцедуры

&Тест
Процедура ВызовНазываетсяКонтекстомВложенныхСобытий() Экспорт

	// Дано - у вызова контекста нет, у его событий есть: по нему видно, что делал пользователь
	Текст = "05:12.100000-1000,SDBL,1,OSThread=7,Sdbl=SELECT 1" + ПС
		+ "05:12.200000-1000,SDBL,1,OSThread=7,Context='Form.Write : Document.Doc.ObjectForm" + ПС
		+ "Document.Doc.ObjectModule : 18 : Query.Execute();'" + ПС
		+ "05:12.500000-500000,CALL,0,OSThread=7,IName=IWorker,MName=execute" + ПС
		+ "05:13.500000-500000,CALL,0,OSThread=7,IName=IWorker,MName=execute" + ПС;
	События = ПарсерТехнологическогоЖурнала.Разобрать(Текст, Дата(2026, 10, 20, 9, 0, 0)).События;

	// Когда
	Экспортер().ОбработатьСобытияТехнологическогоЖурнала(События, ОписаниеФайла());

	// Тогда - следующий вызов без событий с контекстом называется по методу
	Спаны = Спаны();
	Ожидаем.Что(Спаны[2]["name"]).Равно("CALL Form.Write : Document.Doc.ObjectForm");
	Ожидаем.Что(Атрибуты(Спаны[2])["v8.techlog.IName"]).Равно("IWorker");
	Ожидаем.Что(Спаны[3]["name"]).Равно("CALL IWorker.execute");

КонецПроцедуры

&Тест
Процедура СобытиеНулевогоУровняСтановитсяКорнем() Экспорт

	// Дано - ниже уровня 0 стека нет, поэтому родителя у такого события быть не может
	События = События(
		  "05:12.100000-1000,SCALL,0,OSThread=7",
		  "05:12.300000-1000,SDBL,0,OSThread=7");

	// Когда
	Экспортер().ОбработатьСобытияТехнологическогоЖурнала(События, ОписаниеФайла());

	// Тогда - каждое событие сразу отправлено своей трассой
	Спаны = Спаны();
	Ожидаем.Что(Спаны).ИмеетДлину(2);
	Ожидаем.Что(ЗначениеЗаполнено(Спаны[0]["parentSpanId"])).ЭтоЛожь();
	Ожидаем.Что(ЗначениеЗаполнено(Спаны[1]["parentSpanId"])).ЭтоЛожь();
	Ожидаем.Что(Спаны[0]["traceId"]).Не_().Равно(Спаны[1]["traceId"]);

КонецПроцедуры

&Тест
Процедура КореньНеОхватывающийОжидающиеСобытияНеЗабираетИхВСвоюТрассу() Экспорт

	// Дано - событие ждет родителя уровня 0, но вызов начался после него
	События = События(
		  "05:12.100000-1000,SCALL,1,OSThread=7",
		  "05:13.500000-500000,CALL,0,OSThread=7");

	// Когда
	Экспортер().ОбработатьСобытияТехнологическогоЖурнала(События, ОписаниеФайла());

	// Тогда - ожидавшее событие закрыто своей трассой с синтетическим корнем
	Спаны = Спаны();
	Ожидаем.Что(Спаны).ИмеетДлину(3);
	Синтетический = НайтиСинтетическийСпан(Спаны);
	Вызов = НайтиСпан(Спаны, "CALL");
	Ожидаем.Что(Спаны[0]["parentSpanId"]).Равно(Синтетический["spanId"]);
	Ожидаем.Что(ЗначениеЗаполнено(Синтетический["parentSpanId"])).ЭтоЛожь();
	Ожидаем.Что(Вызов["traceId"]).Не_().Равно(Синтетический["traceId"]);
	Ожидаем.Что(ЗначениеЗаполнено(Вызов["parentSpanId"])).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ВПроцессеКлиентаСобытияНакапливаютсяДоСобытияНулевогоУровня() Экспорт

	// Дано - файловая база: код пользователя выполняется в процессе клиента без событий CALL
	События = События(
		  "05:12.100000-1000,SDBL,3,OSThread=7,Sdbl=UPDATE Document54 SET Posted=TRUE",
		  "05:12.150000-60000,SDBL,2,OSThread=7,Func=Transaction",
		  "05:12.200000-110000,SDBL,1,OSThread=7,Func=HoldConnection",
		  "05:12.300000-1000,SDBL,1,OSThread=7,Sdbl=SELECT ID FROM Document54");
	Экспортер = Экспортер();

	// Когда
	Экспортер.ОбработатьСобытияТехнологическогоЖурнала(События, ОписаниеФайла(, "1cv8c"));

	// Тогда - спаны ждут, пока станет ясно, какие события верхнеуровневые; логи отправлены без трассы
	Ожидаем.Что(Спаны()).ИмеетДлину(0);
	Ожидаем.Что(ЗаписиЛога()).ИмеетДлину(4);
	Ожидаем.Что(ЗначениеЗаполнено(ЗаписиЛога()[0]["traceId"])).ЭтоЛожь();

	// Когда - событие уровня 0: охватить ожидающие события теперь не может ничто
	Экспортер.ОбработатьСобытияТехнологическогоЖурнала(
		События("05:13.000000-1000,SDBL,0,OSThread=7,Sdbl=SELECT 1"), ОписаниеФайла(, "1cv8c"));

	// Тогда - у каждого верхнеуровневого события своя трасса
	Спаны = Спаны();
	Ожидаем.Что(Спаны).ИмеетДлину(5);
	Соединение = НайтиСпан(Спаны, "SDBL HoldConnection");
	Транзакция = НайтиСпан(Спаны, "SDBL Transaction");
	Изменение = НайтиСпан(Спаны, "SDBL UPDATE Document54");
	Чтение = НайтиСпан(Спаны, "SDBL SELECT Document54");
	Ожидаем.Что(ЗначениеЗаполнено(Соединение["parentSpanId"])).ЭтоЛожь();
	Ожидаем.Что(Транзакция["parentSpanId"]).Равно(Соединение["spanId"]);
	Ожидаем.Что(Изменение["parentSpanId"]).Равно(Транзакция["spanId"]);
	Ожидаем.Что(Изменение["traceId"]).Равно(Соединение["traceId"]);
	Ожидаем.Что(ЗначениеЗаполнено(Чтение["parentSpanId"])).ЭтоЛожь();
	Ожидаем.Что(Чтение["traceId"]).Не_().Равно(Соединение["traceId"]);
	Ожидаем.Что(Атрибуты(Чтение)["log.file.path"]).Равно("/var/log/1c/1cv8c_1234/26102009.log");

КонецПроцедуры

&Тест
Процедура НакопленныеТрассыОтправляютсяПослеМинутыПростояПотока() Экспорт

	// Дано - событие закончилось в 1792487112100000 мкс Unix epoch, новых событий в журнале нет
	Экспортер = Экспортер();
	Экспортер.ОбработатьСобытияТехнологическогоЖурнала(
		События("05:12.100000-1000,SDBL,1,OSThread=7"), ОписаниеФайла(, "1cv8c"));

	// Когда - проход завершился через 59 секунд
	Экспортер.ЗавершитьПроход(1792487112100000 + 59000000);

	// Тогда
	Ожидаем.Что(Спаны()).ИмеетДлину(0);

	// Когда - проход завершился через 61 секунду
	Экспортер.ЗавершитьПроход(1792487112100000 + 61000000);

	// Тогда
	Ожидаем.Что(Спаны()).ИмеетДлину(1);

КонецПроцедуры

&Тест
Процедура НакопленныеТрассыОтправляютсяПриЗакрытии() Экспорт

	// Дано
	Экспортер = Экспортер();
	Экспортер.ОбработатьСобытияТехнологическогоЖурнала(
		События("05:12.100000-1000,SDBL,1,OSThread=7"), ОписаниеФайла(, "1cv8c"));

	// Когда
	Экспортер.Закрыть();

	// Тогда
	Ожидаем.Что(Спаны()).ИмеетДлину(1);

КонецПроцедуры

&Тест
Процедура РежимТрассЗадаетсяЯвно() Экспорт

	// Дано
	Потоковый = Экспортер("streaming");
	Накопительный = Экспортер("buffered");

	// Когда - режим не зависит от имени процесса
	Потоковый.ОбработатьСобытияТехнологическогоЖурнала(
		События("05:12.100000-1000,SDBL,1,OSThread=7"), ОписаниеФайла(, "1cv8c"));
	Накопительный.ОбработатьСобытияТехнологическогоЖурнала(
		События("05:12.100000-1000,SDBL,1,OSThread=7"), ОписаниеФайла(, "rphost"));

	// Тогда - отправлен только спан потокового режима
	Ожидаем.Что(Спаны()).ИмеетДлину(1);

КонецПроцедуры

&Тест
Процедура ИменаСпановОписываютОперацию() Экспорт

	// Дано
	События = События(
		  "05:12.100000-1000,TLOCK,2,OSThread=7,Regions=Document54.REFLOCK,Locks='Document54.REFLOCK Exclusive'",
		  "05:12.110000-1000,EXCP,2,OSThread=7,Exception=DatabaseException8,Descr=Ошибка",
		  "05:12.120000-1000,DBMSSQL,2,OSThread=7,Sql='INSERT INTO _Document54 (_IDRRef) VALUES (?)'",
		  "05:12.500000-500000,CALL,1,OSThread=7,IName=IWorker,MName=execute");
	События.Добавить(События("05:13.000000-1000,SCALL,0,OSThread=8,Method=methodsCount")[0]);

	// Когда
	Экспортер().ОбработатьСобытияТехнологическогоЖурнала(События, ОписаниеФайла());

	// Тогда
	Спаны = Спаны();
	НайтиСпан(Спаны, "TLOCK Document54.REFLOCK");
	НайтиСпан(Спаны, "EXCP DatabaseException8");
	НайтиСпан(Спаны, "DBMSSQL INSERT _Document54");
	НайтиСпан(Спаны, "CALL IWorker.execute");
	НайтиСпан(Спаны, "SCALL methodsCount");

КонецПроцедуры

&Тест
Процедура СледующийВызовПотокаНачинаетНовуюТрассу() Экспорт

	// Дано
	События = События(
		  "05:12.100000-1000,DBMSSQL,2,OSThread=7,t:clientID=5",
		  "05:12.500000-500000,CALL,1,OSThread=7,t:clientID=5",
		  "05:13.100000-1000,DBMSSQL,2,OSThread=7,t:clientID=5",
		  "05:13.500000-500000,CALL,1,OSThread=7,t:clientID=5");

	// Когда
	Экспортер().ОбработатьСобытияТехнологическогоЖурнала(События, ОписаниеФайла());

	// Тогда
	Спаны = Спаны();
	Ожидаем.Что(Спаны).ИмеетДлину(4);
	Ожидаем.Что(Спаны[0]["traceId"]).Равно(Спаны[1]["traceId"]);
	Ожидаем.Что(Спаны[2]["traceId"]).Равно(Спаны[3]["traceId"]);
	Ожидаем.Что(Спаны[2]["traceId"]).Не_().Равно(Спаны[0]["traceId"]);
	Ожидаем.Что(Спаны[2]["parentSpanId"]).Равно(Спаны[3]["spanId"]);

КонецПроцедуры

&Тест
Процедура ИсключениеСтановитсяСпаномСОшибкой() Экспорт

	// Дано
	События = События(
		  "05:12.200000-0,EXCP,2,OSThread=7,t:clientID=5,Exception=DataBaseException,Descr='Деление на 0'",
		  "05:12.500000-500000,CALL,1,OSThread=7,t:clientID=5");

	// Когда
	Экспортер().ОбработатьСобытияТехнологическогоЖурнала(События, ОписаниеФайла());

	// Тогда
	Спаны = Спаны();
	СпанИсключения = НайтиСпан(Спаны, "EXCP");
	Ожидаем.Что(СпанИсключения["parentSpanId"]).Равно(НайтиСпан(Спаны, "CALL")["spanId"]);
	Ожидаем.Что(СпанИсключения["status"]["code"]).Равно(2);
	СобытияСпана = СпанИсключения["events"];
	Ожидаем.Что(СобытияСпана).ИмеетДлину(1);
	Ожидаем.Что(СобытияСпана[0]["name"]).Равно("exception");
	Атрибуты = Атрибуты(СобытияСпана[0]);
	Ожидаем.Что(Атрибуты["exception.message"]).Равно("Деление на 0");
	Ожидаем.Что(Атрибуты["exception.type"]).Равно("DataBaseException");

КонецПроцедуры

&Тест
Процедура КаждаяЗаписьЛогаСвязанаСоСвоимСпаном() Экспорт

	// Дано
	События = События(
		  "05:12.100000-1000,DBMSSQL,2,OSThread=7,t:clientID=5",
		  "05:12.500000-500000,CALL,1,OSThread=7,t:clientID=5");

	// Когда
	Экспортер().ОбработатьСобытияТехнологическогоЖурнала(События, ОписаниеФайла());

	// Тогда
	Спаны = Спаны();
	Записи = ЗаписиЛога();
	Запрос = НайтиСпан(Спаны, "DBMSSQL");
	Вызов = НайтиСпан(Спаны, "CALL");
	Ожидаем.Что(Записи[0]["traceId"]).Равно(Запрос["traceId"]);
	Ожидаем.Что(Записи[0]["spanId"]).Равно(Запрос["spanId"]);
	Ожидаем.Что(Записи[1]["traceId"]).Равно(Вызов["traceId"]);
	Ожидаем.Что(Записи[1]["spanId"]).Равно(Вызов["spanId"]);

КонецПроцедуры

&Тест
Процедура ЗависшаяТрассаЗакрываетсяСинтетическимКорнем() Экспорт

	// Дано - вызов клиента 5 так и не записан, а журнал ушел на час вперед
	Экспортер = Экспортер();
	Экспортер.ОбработатьСобытияТехнологическогоЖурнала(
		События("05:12.100000-1000,DBMSSQL,2,OSThread=7,t:clientID=5"), ОписаниеФайла());

	// Когда
	ЧасСпустя = Дата(2026, 10, 20, 11, 0, 0);
	СобытияЧасСпустя = ПарсерТехнологическогоЖурнала.Разобрать("05:12.500000-500000,CALL,1,OSThread=9,t:clientID=6" + ПС,
		ЧасСпустя).События;
	Экспортер.ОбработатьСобытияТехнологическогоЖурнала(СобытияЧасСпустя, ОписаниеФайла(ЧасСпустя));

	// Тогда
	Спаны = Спаны();
	Синтетический = НайтиСинтетическийСпан(Спаны);
	Ожидаем.Что(НайтиСпан(Спаны, "DBMSSQL")["parentSpanId"]).Равно(Синтетический["spanId"]);
	Ожидаем.Что(ЗначениеЗаполнено(Синтетический["parentSpanId"])).ЭтоЛожь();

КонецПроцедуры

