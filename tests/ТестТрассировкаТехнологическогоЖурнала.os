Функция ВнешнийИдТрассировки()
	Возврат "4bf92f3577b34da6a3ce929d0e0e4736";
КонецФункции

Функция ВнешнийИдСпана()
	Возврат "00f067aa0ba902b7";
КонецФункции

Функция ВнешнийTraceparent()
	Возврат СтрШаблон("00-%1-%2-01", ВнешнийИдТрассировки(), ВнешнийИдСпана());
КонецФункции

Функция МикросекундыUnix(Момент)
	Возврат (Момент - Дата(1970, 1, 1)) * 1000000;
КонецФункции

Функция ЗапросVRS(Время, Уровень, Метод, URI, ДополнительныйЗаголовок = "")
	Заголовки = "Host: localhost" + ПС + "User-Agent: curl/8.0.0" + ПС + "X-Forwarded-For: 10.0.0.5" + ПС
		+ "1C-BaseLocation: http://localhost/vrsmin";
	Если ЗначениеЗаполнено(ДополнительныйЗаголовок) Тогда
		Заголовки = Заголовки + ПС + ДополнительныйЗаголовок;
	КонецЕсли;
	Возврат СтрШаблон("%1,VRSREQUEST,%2,OSThread=7,t:clientID=5,Method=%3,URI=%4,Headers='%5',Body=0",
		Время, Уровень, Метод, URI, Заголовки);
КонецФункции

