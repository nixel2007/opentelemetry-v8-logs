Процедура ДинамическийКодДаетМестоВызвавшегоКадра() Экспорт

	// Когда - номер строки динамического кода относится к тексту, переданному в Выполнить
	Экспортер().ОбработатьЗаписи(События(
		"05:12.100000-1000,SDBL,1,OSThread=7," + Контекст(
			"ОбщийМодуль.Обмен.Модуль : 479 : Дополнить(Структура);",
			"ОбщийМодуль.Обмен.Модуль : 1022 : Выполнить(Стр.Выражение);",
			" : 13 : Выборка = Запрос.Выполнить().Выбрать();")), ОписаниеФайла());

	// Тогда
	Атрибуты = Атрибуты(Спаны()[0]);
	Ожидаем.Что(Атрибуты["code.file.path"]).Равно("ОбщийМодуль.Обмен.Модуль");
	Ожидаем.Что(Атрибуты["code.line.number"]).Равно("1022");
	Ожидаем.Что(Атрибуты["code.function.name"]).Равно("ОбщийМодуль.Обмен.Модуль.Дополнить");

КонецПроцедуры

&Тест
Процедура КонтекстБезКадровДаетТолькоСтек() Экспорт

	// Когда
	Экспортер().ОбработатьЗаписи(События(
		"05:12.100000-1000,SDBL,1,OSThread=7," + Контекст(
			"Форма.Записать : Документ.Заказ.Форма.ФормаДокумента")), ОписаниеФайла());

	// Тогда
	Атрибуты = Атрибуты(Спаны()[0]);
	Ожидаем.Что(Атрибуты["code.stacktrace"]).Равно("Форма.Записать : Документ.Заказ.Форма.ФормаДокумента");
	Ожидаем.Что(Атрибуты.Получить("code.file.path")).Равно(Неопределено);
	Ожидаем.Что(Атрибуты.Получить("code.line.number")).Равно(Неопределено);
	Ожидаем.Что(Атрибуты.Получить("code.function.name")).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура НомерСтрокиВнеДиапазонаНеЗаписывается() Экспорт

	// Когда
	Экспортер().ОбработатьЗаписи(События(
		"05:12.100000-1000,SDBL,1,OSThread=7," + Контекст(
			"ОбщийМодуль.Обмен.Модуль : 99999999999999999999999999999999 : Т = Запрос.Выполнить();")),
		ОписаниеФайла());

	// Тогда
	Атрибуты = Атрибуты(Спаны()[0]);
	Ожидаем.Что(Атрибуты["code.file.path"]).Равно("ОбщийМодуль.Обмен.Модуль");
