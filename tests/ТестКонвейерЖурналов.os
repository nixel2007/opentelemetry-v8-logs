// BSLLS:MagicNumber-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
// BSLLS:DuplicateStringLiteral-off
// BSLLS:MagicDate-off
// BSLLS:NestedFunctionInParameters-off
// BSLLS:Typo-off
#Использовать "../src/Конвейер"
#Использовать "../src/ТехнологическийЖурнал"
#Использовать asserts
#Использовать tempfiles
#Использовать opentelemetry
#Использовать collectionos
#Использовать extends

&Табакерка
&Пластилин("КонвейерЖурналов")
Перем ТабакеркаКонвейеров;

&Табакерка
&Пластилин("ЧитательТехнологическогоЖурнала")
Перем ТабакеркаЧитателей;

Перем ПС;
Перем ВременныеФайлыТеста;
Перем Каталог;
Перем Хранилище;
Перем Полученные;
Перем ПакетыПолученных;
Перем Сбросы;
Перем СбросУспешен;
Перем СбросыДоЗавершенияПрохода;
Перем ЭкспортерЗакрыт;
Перем ИтогиПроходов;
Перем БлокировкаИтоговПроходов;
Перем ЖурналСбросов; // Массив из Строка, Неопределено - вход и выход сбросов буфера из разных потоков
Перем БлокировкаЖурналаСбросов;

&Тест
Процедура КонвейерРеализуетИнтерфейсОбработчикаЗаписей() Экспорт
	Валидатор = Новый ВалидаторРеализации;
	Валидатор.РеализуетИнтерфейс(НовыйКонвейер(), "ИнтерфейсОбработчикЗаписей", Истина);
КонецПроцедуры

&ПередКаждым
Процедура Подготовить() Экспорт
	ЭкспортерЗакрыт = Ложь;
	ИтогиПроходов = Новый Массив;
	БлокировкаИтоговПроходов = Новый БлокировкаРесурса(ИтогиПроходов);
	ЖурналСбросов = Неопределено;
	ВременныеФайлыТеста = Новый МенеджерВременныхФайлов;
	Каталог = ВременныеФайлыТеста.СоздатьКаталог();
	Хранилище = Новый ХранилищеПозицийВПамяти;
	Полученные = Новый Массив;
	ПакетыПолученных = Новый Массив;
	Сбросы = 0;
	СбросУспешен = Истина;
	СбросыДоЗавершенияПрохода = Неопределено;
КонецПроцедуры

&ПослеКаждого
Процедура УдалитьВременныеФайлы() Экспорт
	ВременныеФайлыТеста.Удалить();
КонецПроцедуры

// Экспортер событий
// BSLLS:UnusedParameters-off
Процедура ОбработатьЗаписи(События, ОписаниеФайла) Экспорт
	ПакетыПолученных.Добавить(События.Количество());
	Для Каждого Событие Из События Цикл
		Полученные.Добавить(Событие);
	КонецЦикла;
КонецПроцедуры
// BSLLS:UnusedParameters-on

// Экспортер: завершение прохода
Процедура ЗавершитьПроход() Экспорт
	СбросыДоЗавершенияПрохода = Сбросы;
КонецПроцедуры

// Экспортер: закрытие
Процедура Закрыть() Экспорт
	ЭкспортерЗакрыт = Истина;
КонецПроцедуры

// Экспортер: данные прохода переданы и позиции зафиксированы
Процедура ПодтвердитьПроход() Экспорт
	БлокировкаИтоговПроходов.Заблокировать();
	ИтогиПроходов.Добавить("подтвержден");
	БлокировкаИтоговПроходов.Разблокировать();
КонецПроцедуры

// Экспортер: проход откатывается, записи будут прочитаны повторно
Процедура ОтменитьПроход() Экспорт
	БлокировкаИтоговПроходов.Заблокировать();
	ИтогиПроходов.Добавить("отменен");
	БлокировкаИтоговПроходов.Разблокировать();
КонецПроцедуры

&Тест
Процедура ПриЗакрытииКонвейерЗакрываетЭкспортерыИСбрасываетБуфер() Экспорт

	// Дано - экспортер может держать накопленные трассы до закрытия
	Конвейер = НовыйКонвейер();
	Конвейер.Добавить(ТабакеркаЧитателей.Достать(Массивы.ИзЭлементов(Каталог, Хранилище, Ложь, 4194304)), ЭтотОбъект);

	// Когда
	Конвейер.Закрыть();

	// Тогда
	Ожидаем.Что(ЭкспортерЗакрыт).ЭтоИстина();
	Ожидаем.Что(Сбросы).Равно(1);

КонецПроцедуры

// Сброс буферов телеметрии
// BSLLS:UnusedParameters-off
Функция СброситьБуфер(ТаймаутМс = 0) Экспорт
	Если ЖурналСбросов <> Неопределено Тогда
		ЗаписатьВЖурналСбросов("вход");
		Приостановить(50);
		ЗаписатьВЖурналСбросов("выход");
	КонецЕсли;
	Сбросы = Сбросы + 1;
	Возврат ?(СбросУспешен, ОтелРезультатыЭкспорта.Успех(), ОтелРезультатыЭкспорта.Ошибка());
КонецФункции
// BSLLS:UnusedParameters-on

&Тест
Процедура КонвейерыОднойТелеметрииНеСбрасываютБуферОдновременно() Экспорт

	// Дано - буфер SDK общий, сбой сброса из одного потока теряет записи другого
	ЖурналСбросов = Новый Массив;
	БлокировкаЖурналаСбросов = Новый БлокировкаРесурса(ЖурналСбросов);
	Задания = Новый Массив;
	Для Номер = 1 По 2 Цикл
		КаталогИсточника = ВременныеФайлыТеста.СоздатьКаталог();
		Конвейер = НовыйКонвейер();
		Конвейер.Добавить(ТабакеркаЧитателей.Достать(
			Массивы.ИзЭлементов(КаталогИсточника, Новый ХранилищеПозицийВПамяти, Ложь, 4194304)), ЭтотОбъект);

		// Когда
		Параметры = Новый Массив;
		Параметры.Добавить(Конвейер);
		Параметры.Добавить(5);
		Задания.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, "ВыполнитьПроходы", Параметры));
	КонецЦикла;
	Ожидаем.Что(ФоновыеЗадания.ОжидатьВсе(Задания, 30000), "задания завершились").ЭтоИстина();

	// Тогда
	Для Каждого Задание Из Задания Цикл
		Если Задание.ИнформацияОбОшибке <> Неопределено Тогда
			ВызватьИсключение ПодробноеПредставлениеОшибки(Задание.ИнформацияОбОшибке);
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(ЖурналСбросов).ИмеетДлину(20);
	Для Номер = 1 По ЖурналСбросов.ВГраница() Цикл
		Ожидаем.Что(ЖурналСбросов[Номер - 1] = "вход" И ЖурналСбросов[Номер] = "вход",
			"сбросы двух конвейеров перекрылись").ЭтоЛожь();
	КонецЦикла;

КонецПроцедуры

// Тело фонового задания теста
Процедура ВыполнитьПроходы(Конвейер, Количество) Экспорт
	Для Номер = 1 По Количество Цикл
		Конвейер.ВыполнитьПроход();
	КонецЦикла;
КонецПроцедуры

Процедура ЗаписатьВЖурналСбросов(Событие)
	БлокировкаЖурналаСбросов.Заблокировать();
	ЖурналСбросов.Добавить(Событие);
	БлокировкаЖурналаСбросов.Разблокировать();
КонецПроцедуры

&Тест
Процедура ПослеЧтенияЭкспортерЗавершаетПроходИБуферСбрасывается() Экспорт

	// Дано
	Дописать("rphost_1/26102009.log", "05:12.000001-15,CALL,1" + ПС);
	Конвейер = НовыйКонвейер();
	Конвейер.Добавить(ТабакеркаЧитателей.Достать(Массивы.ИзЭлементов(Каталог, Хранилище, Ложь, 4194304)), ЭтотОбъект);

	// Когда
	Конвейер.ВыполнитьПроход();

	// Тогда - то, что экспортер отправил при завершении прохода, тоже сброшено
	Ожидаем.Что(СбросыДоЗавершенияПрохода).Равно(1);
	Ожидаем.Что(Сбросы).Равно(2);

КонецПроцедуры

&Тест
Процедура ПроходПередаетСобытияСбрасываетБуферИФиксируетПозиции() Экспорт

	// Дано
	Дописать("rphost_1/26102009.log", "05:12.000001-15,CALL,1" + ПС, Истина);
	Конвейер = НовыйКонвейер();
	Конвейер.Добавить(ТабакеркаЧитателей.Достать(Массивы.ИзЭлементов(Каталог, Хранилище, Ложь, 4194304)), ЭтотОбъект);

	// Когда
	Количество = Конвейер.ВыполнитьПроход();

	// Тогда
	Ожидаем.Что(Количество).Равно(1);
	Ожидаем.Что(Полученные).ИмеетДлину(1);
	// Сброс после пакета и после завершения прохода экспортером
	Ожидаем.Что(Сбросы).Равно(2);
	Ожидаем.Что(Хранилище.Позиция(ПутьВКаталоге("rphost_1/26102009.log"))).Равно(3 + 23);

КонецПроцедуры

&Тест
Процедура ПриОшибкеСбросаПозицииНеФиксируютсяИСобытияЧитаютсяПовторно() Экспорт

	// Дано
	Дописать("rphost_1/26102009.log", "05:12.000001-15,CALL,1" + ПС, Истина);
	Конвейер = НовыйКонвейер();
	Конвейер.Добавить(ТабакеркаЧитателей.Достать(Массивы.ИзЭлементов(Каталог, Хранилище, Ложь, 4194304)), ЭтотОбъект);
	СбросУспешен = Ложь;

	// Когда
	Конвейер.ВыполнитьПроход();
	СбросУспешен = Истина;
	Конвейер.ВыполнитьПроход();

	// Тогда
	Ожидаем.Что(Полученные).ИмеетДлину(2);
	Ожидаем.Что(Хранилище.Позиция(ПутьВКаталоге("rphost_1/26102009.log"))).Равно(3 + 23);
	Ожидаем.Что(СтрСоединить(ИтогиПроходов, ",")).Равно("отменен,подтвержден");

КонецПроцедуры

&Тест
Процедура СобытияПередаютсяПакетамиСоСбросомБуфера() Экспорт

	// Дано
	Текст = "";
	Для Номер = 1 По 5 Цикл
		Текст = Текст + "05:12.00000" + Номер + "-15,CALL,1" + ПС;
	КонецЦикла;
	Дописать("rphost_1/26102009.log", Текст, Истина);
	Конвейер = НовыйКонвейер(2);
	Конвейер.Добавить(ТабакеркаЧитателей.Достать(Массивы.ИзЭлементов(Каталог, Хранилище, Ложь, 4194304)), ЭтотОбъект);

	// Когда
	Конвейер.ВыполнитьПроход();

	// Тогда - пакеты по 2 события, сброс после каждого пакета и после завершения прохода
	Ожидаем.Что(Полученные).ИмеетДлину(5);
	Ожидаем.Что(ПакетыПолученных).ИмеетДлину(3);
	Ожидаем.Что(ПакетыПолученных[0]).Равно(2);
	Ожидаем.Что(ПакетыПолученных[2]).Равно(1);
	Ожидаем.Что(Сбросы).Равно(4);

КонецПроцедуры

&Тест
Процедура ОшибкаЧтенияИсточникаНеОстанавливаетОстальные() Экспорт

	// Дано
	Дописать("rphost_1/26102009.log", "05:12.000001-15,CALL,1" + ПС, Истина);
	Конвейер = НовыйКонвейер();
	Конвейер.Добавить(ЭтотОбъект, ЭтотОбъект);
	Конвейер.Добавить(ТабакеркаЧитателей.Достать(Массивы.ИзЭлементов(Каталог, Хранилище, Ложь, 4194304)), ЭтотОбъект);

	// Когда
	Конвейер.ВыполнитьПроход();

	// Тогда
	Ожидаем.Что(Полученные).ИмеетДлину(1);

КонецПроцедуры

// Читатель, который всегда падает
// BSLLS:UnusedParameters-off
// BSLLS:FunctionShouldHaveReturn-off
Функция Прочитать(Обработчик) Экспорт
	ВызватьИсключение "Каталог недоступен";
КонецФункции
// BSLLS:FunctionShouldHaveReturn-on
// BSLLS:UnusedParameters-on

Процедура ЗафиксироватьПозиции() Экспорт
КонецПроцедуры

Процедура ОткатитьПозиции() Экспорт
КонецПроцедуры

Функция НовыйКонвейер(РазмерПакета = 1000)
	Возврат ТабакеркаКонвейеров.Достать(Массивы.ИзЭлементов(ЭтотОбъект, РазмерПакета));
КонецФункции

Функция ПутьВКаталоге(ОтносительныйПуть)
	Возврат Новый Файл(ОбъединитьПути(Каталог, ОтносительныйПуть)).ПолноеИмя;
КонецФункции

Процедура Дописать(ОтносительныйПуть, Текст, СBOM = Ложь)

	Путь = ОбъединитьПути(Каталог, ОтносительныйПуть);
	СоздатьКаталог(Новый Файл(Путь).Путь);

	Буфер = ПолучитьБуферДвоичныхДанныхИзСтроки(?(СBOM, Символ(65279), "") + Текст, "UTF-8", Ложь);
	Поток = Новый ФайловыйПоток(Путь, РежимОткрытияФайла.ОткрытьИлиСоздать, ДоступКФайлу.Запись);
	Поток.Перейти(0, ПозицияВПотоке.Конец);
	Поток.Записать(Буфер, 0, Буфер.Размер);
	Поток.Закрыть();

КонецПроцедуры

ПС = Символы.ПС;
