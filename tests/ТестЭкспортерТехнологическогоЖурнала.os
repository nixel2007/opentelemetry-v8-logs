&Тест
Процедура ДлительностьЗаписываетсяВГистограмму() Экспорт

	// Дано
	События = Новый Массив;
	События.Добавить(Событие("05:12.000001-15,DBMSSQL,1,p:processName=erp"));
	События.Добавить(Событие("05:12.000002-5,DBMSSQL,1,p:processName=erp"));

	// Когда
	Экспортер = Экспортер();
	Экспортер.ОбработатьСобытияТехнологическогоЖурнала(События, ОписаниеФайла());
	Экспортер.ПодтвердитьПроход();
	Телеметрия.СброситьБуфер();

	// Тогда
	Метрика = НайтиМетрику("v8.techlog.event.duration");
	Ожидаем.Что(Метрика["unit"]).Равно("s");
	Точка = Метрика["histogram"]["dataPoints"][0];
	Ожидаем.Что(Число(Точка["count"])).Равно(2);
	Ожидаем.Что(Точка["sum"]).Равно(0.00002);
	Атрибуты = Атрибуты(Точка);
	Ожидаем.Что(Атрибуты["v8.techlog.event.name"]).Равно("DBMSSQL");
	Ожидаем.Что(Атрибуты["process.executable.name"]).Равно("rphost");
	Ожидаем.Что(Атрибуты["v8.infobase.name"]).Равно("erp");

КонецПроцедуры

&Тест
Процедура ОтмененныйПроходНеУчитываетсяВГистограмме() Экспорт

	// Дано - проход с неудачной отправкой, затем повтор того же события
	Экспортер = Экспортер();
	Экспортер.ОбработатьСобытияТехнологическогоЖурнала(
		МассивИз(Событие("05:12.000001-15,DBMSSQL,1,p:processName=erp")), ОписаниеФайла());
	Экспортер.ОтменитьПроход();

	// Когда
	Экспортер.ОбработатьСобытияТехнологическогоЖурнала(
		МассивИз(Событие("05:12.000001-15,DBMSSQL,1,p:processName=erp")), ОписаниеФайла());
	Экспортер.ПодтвердитьПроход();
	Телеметрия.СброситьБуфер();

	// Тогда
	Точка = НайтиМетрику("v8.techlog.event.duration")["histogram"]["dataPoints"][0];
	Ожидаем.Что(Число(Точка["count"])).Равно(1);

КонецПроцедуры

Функция Экспортер(ЧасовойПояс = "Etc/UTC", ИнформационнаяБаза = "", ИмяСервиса = "")
	Возврат ТабакеркаЭкспортеров.Достать(Массивы.ИзЭлементов(Телеметрия, ИмяСервиса, ЧасовойПояс,
		ИнформационнаяБаза, Истина, "CALL", "auto"));
КонецФункции

// Атрибуты ресурса каждой записи лога в порядке отправки
Функция РесурсыЗаписейЛога()
	Результат = Новый Массив;
	Для Каждого Отправка Из ТранспортЛогов.ПолучитьОтправленные() Цикл
		Для Каждого РесурсныеЛоги Из Отправка["Данные"]["resourceLogs"] Цикл
			АтрибутыРесурса = Атрибуты(РесурсныеЛоги["resource"]);
			Для Каждого ЛогиОбласти Из РесурсныеЛоги["scopeLogs"] Цикл
				Для Каждого Запись Из ЛогиОбласти["logRecords"] Цикл // BSLLS:UnusedLocalVariable-off
					Результат.Добавить(АтрибутыРесурса);
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция Событие(Текст)
	Возврат ПарсерТехнологическогоЖурнала.Разобрать(Текст + ПС, Дата(2026, 10, 20, 9, 0, 0)).События[0];
КонецФункции

Функция МассивИз(Значение)
	Результат = Новый Массив;
	Результат.Добавить(Значение);
	Возврат Результат;
КонецФункции

Функция ОписаниеФайла()
	Описание = Новый Структура;
	Описание.Вставить("Путь", "/var/log/1c/rphost_1234/26102009.log");
	Описание.Вставить("Каталог", "/var/log/1c");
	Описание.Вставить("Процесс", "rphost");
	Описание.Вставить("ИдПроцесса", "1234");
	Описание.Вставить("ДатаЧаса", Дата(2026, 10, 20, 9, 0, 0));
	Возврат Описание;
КонецФункции

Функция ЗаписиЛога()
	Результат = Новый Массив;
	Для Каждого Отправка Из ТранспортЛогов.ПолучитьОтправленные() Цикл
		Для Каждого РесурсныеЛоги Из Отправка["Данные"]["resourceLogs"] Цикл
			Для Каждого ЛогиОбласти Из РесурсныеЛоги["scopeLogs"] Цикл
				Для Каждого Запись Из ЛогиОбласти["logRecords"] Цикл
					Результат.Добавить(Запись);
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция НайтиМетрику(Имя)
	Для Каждого Отправка Из ТранспортМетрик.ПолучитьОтправленные() Цикл
		Для Каждого РесурсныеМетрики Из Отправка["Данные"]["resourceMetrics"] Цикл
			Для Каждого МетрикиОбласти Из РесурсныеМетрики["scopeMetrics"] Цикл
				Для Каждого Метрика Из МетрикиОбласти["metrics"] Цикл
					Если Метрика["name"] = Имя Тогда
						Возврат Метрика;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	ВызватьИсключение "Не найдена метрика " + Имя;
КонецФункции

// Атрибуты OTLP в виде соответствия ключ -> строковое представление значения
Функция Атрибуты(Объект)
	Результат = Новый Соответствие;
	Если Объект = Неопределено ИЛИ Объект["attributes"] = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Атрибут Из Объект["attributes"] Цикл
		Значение = Атрибут["value"];
		Для Каждого Вид Из Значение Цикл
			Результат.Вставить(Атрибут["key"], Строка(Вид.Значение));
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция АтрибутOtlp(Объект, Ключ)
	Для Каждого Атрибут Из Объект["attributes"] Цикл
		Если Атрибут["key"] = Ключ Тогда
			Возврат Атрибут["value"];
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

ПС = Символы.ПС;
