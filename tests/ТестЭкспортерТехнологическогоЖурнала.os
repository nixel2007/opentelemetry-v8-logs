	События.Добавить(Событие("05:12.000003-0,TTIMEOUT,1"));
	События.Добавить(Событие("05:12.000004-0,ATTN,1"));
	События.Добавить(Событие("05:12.000005-0,DBMSSQL,1"));

	// Когда
	Экспортер().ОбработатьСобытияТехнологическогоЖурнала(События, ОписаниеФайла());

	// Тогда
