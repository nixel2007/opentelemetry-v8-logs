&Тест
Процедура ДлинноеТелоЗаписиОбрезаетсяВнутриЗначенияИПомечается() Экспорт

	// Дано
	Событие = Событие("05:12.000001-15,DBMSSQL,1,Sql='" + Повтор("x", 140000) + "',Rows=1,Context='Форма.Вызов'");
	ИсходныйРазмер = РазмерUTF8(Событие.Текст);

	// Когда
	Экспортер().ОбработатьСобытияТехнологическогоЖурнала(МассивИз(Событие), ОписаниеФайла());

	// Тогда - свойства после обрезанного значения остаются в теле
	Запись = ЗаписиЛога()[0];
	Тело = Запись["body"]["stringValue"];
	Ожидаем.Что(РазмерUTF8(Тело)).Равно(131072);
	Ожидаем.Что(СтрНачинаетсяС(Тело, "05:12.000001-15,DBMSSQL,1,Sql='xxx")).ЭтоИстина();
	Ожидаем.Что(СтрЗаканчиваетсяНа(Тело, "x...[truncated]',Rows=1,Context='Форма.Вызов'")).ЭтоИстина();
	Ожидаем.Что(Атрибуты(Запись)["v8.techlog.truncation.body.original_size"]).Равно(Строка(ИсходныйРазмер));
	Ожидаем.Что(ЗначенияМассиваАтрибута(Запись, "v8.techlog.truncation.body.attributes")).Равно("Sql");

