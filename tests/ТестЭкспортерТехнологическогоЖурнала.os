КонецПроцедуры

// Значения точек счетчика по цели обрезки: для тела - "body", для атрибута - его ключ
Функция ТочкиСчетчика(Имя)
	Результат = Новый Соответствие;
	Для Каждого Точка Из НайтиМетрику(Имя)["sum"]["dataPoints"] Цикл
		АтрибутыТочки = Атрибуты(Точка);
		Ключ = ?(АтрибутыТочки["v8.techlog.truncation.target"] = "body", "body",
			АтрибутыТочки["v8.techlog.truncation.attribute"]);
		Результат.Вставить(Ключ, Число(Точка["asInt"]));
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Ключи из атрибута v8.techlog.truncation.attributes по алфавиту через запятую
Функция ОбрезанныеАтрибуты(Запись)
	Значение = АтрибутOtlp(Запись, "v8.techlog.truncation.attributes");
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Ключи = Новый СписокЗначений;
	Для Каждого Элемент Из Значение["arrayValue"]["values"] Цикл
		Ключи.Добавить(Элемент["stringValue"]);
	КонецЦикла;
	Ключи.СортироватьПоЗначению();
	Возврат СтрСоединить(Ключи.ВыгрузитьЗначения(), ",");
КонецФункции

// Строки атрибута-массива через запятую в порядке записи
Функция ЗначенияМассиваАтрибута(Запись, Ключ)
	Значение = АтрибутOtlp(Запись, Ключ);
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Строки = Новый Массив;
	Для Каждого Элемент Из Значение["arrayValue"]["values"] Цикл
		Строки.Добавить(Элемент["stringValue"]);
	КонецЦикла;
	Возврат СтрСоединить(Строки, ",");
КонецФункции

Функция Повтор(Строка, Количество)
	Части = Новый Массив;
	Для Номер = 1 По Количество Цикл // BSLLS:UnusedLocalVariable-off
		Части.Добавить(Строка);
	КонецЦикла;
	Возврат СтрСоединить(Части);
КонецФункции

Функция РазмерUTF8(Строка)
	Возврат ПолучитьДвоичныеДанныеИзСтроки(Строка, "UTF-8").Размер();
КонецФункции

Функция Экспортер(ЧасовойПояс = "Etc/UTC", ИнформационнаяБаза = "", ИмяСервиса = "", ПропускатьДубли = Истина)
	Возврат ТабакеркаЭкспортеров.Достать(Массивы.ИзЭлементов(Телеметрия, ИмяСервиса, ЧасовойПояс,
		ИнформационнаяБаза, Истина, "CALL", "auto", Истина, Истина, ПропускатьДубли));
КонецФункции

// Атрибуты ресурса каждой записи лога в порядке отправки
Функция РесурсыЗаписейЛога()
	Результат = Новый Массив;
	Для Каждого Отправка Из ТранспортЛогов.ПолучитьОтправленные() Цикл
		Для Каждого РесурсныеЛоги Из Отправка["Данные"]["resourceLogs"] Цикл
			АтрибутыРесурса = Атрибуты(РесурсныеЛоги["resource"]);
			Для Каждого ЛогиОбласти Из РесурсныеЛоги["scopeLogs"] Цикл
				ОсталосьЗаписей = ЛогиОбласти["logRecords"].Количество();
				Пока ОсталосьЗаписей > 0 Цикл
					Результат.Добавить(АтрибутыРесурса);
					ОсталосьЗаписей = ОсталосьЗаписей - 1;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

&Тест
Процедура СекретыЗаголовковИЗапросаНеПопадаютВТелеметрию() Экспорт

	// Дано
	Заголовки = "Host: localhost" + ПС
		+ "Authorization: Bearer first" + ПС
		+ " secret" + ПС
		+ "Cookie: sid=abc" + ПС
		+ "Set-Cookie: a=b" + ПС
		+ "Proxy-Authorization: Basic zz" + ПС
		+ "X-Api-Key: kkk" + ПС
		+ "X-Auth-Token: ttt" + ПС
		+ "X-Secret: sss" + ПС
		+ "Accept: text/plain" + ПС
		+ " charset=utf-8" + ПС
		+ "1C-OriginalLocation: http://h/demo/hs/x?token=abc&n=1" + ПС
		+ "Referer: http://h/demo/e1cib?access_token=zzz" + ПС
		+ "Location: http://h/cb?code=c&password=p" + ПС
		+ "1C-BaseLocation: http://h/demo?token=base" + ПС
		+ "1C-ConnectString: Pwd=p;Srvr=h;DBPwd=db;SPwd=s;Ref=demo" + ПС
		+ "1C-ApplicationName: 1CV8C" + ПС
		+ "1C-SDCVersion: 2" + ПС
		+ "1C-openIDLifetime: 43200";
	Текст = "05:12.345678-1,VRSREQUEST,1,Method=GET,URI='/odata/standard.odata?access%5Ftoken=secret&format=json',"
		+ "Headers='" + Заголовки + "',url.query='access%5Ftoken=secret&x=1&password=p&code=c&sig=s&token=t'";

	// Когда
	Экспортер().ОбработатьСобытияТехнологическогоЖурнала(МассивИз(Событие(Текст)), ОписаниеФайла());

	// Тогда
	Запись = ЗаписиЛога()[0];
	Атрибуты = Атрибуты(Запись);
	Ожидаем.Что(Атрибуты["v8.techlog.URI"]).Равно("/odata/standard.odata?access%5Ftoken=***&format=json");
	Ожидаем.Что(Атрибуты["v8.techlog.url.query"]).Равно("access%5Ftoken=***&x=1&password=***&code=c&sig=***&token=***");
	ЗаголовкиАтрибута = Атрибуты["v8.techlog.Headers"];
	Ожидаем.Что(СтрНайти(ЗаголовкиАтрибута, "Host: localhost") > 0).ЭтоИстина();
	Ожидаем.Что(СтрНайти(ЗаголовкиАтрибута, "Accept: text/plain") > 0).ЭтоИстина();
	Ожидаем.Что(СтрНайти(ЗаголовкиАтрибута, " charset=utf-8") > 0).ЭтоИстина();
	Ожидаем.Что(СтрНайти(ЗаголовкиАтрибута, "Authorization: ***") > 0).ЭтоИстина();
	Ожидаем.Что(СтрНайти(ЗаголовкиАтрибута, " ***") > 0).ЭтоИстина();
	Ожидаем.Что(СтрНайти(ЗаголовкиАтрибута, "secret") > 0).ЭтоЛожь();
	Ожидаем.Что(СтрНайти(ЗаголовкиАтрибута, "Cookie: ***") > 0).ЭтоИстина();
	Ожидаем.Что(СтрНайти(ЗаголовкиАтрибута, "Set-Cookie: ***") > 0).ЭтоИстина();
	Ожидаем.Что(СтрНайти(ЗаголовкиАтрибута, "Proxy-Authorization: ***") > 0).ЭтоИстина();
	Ожидаем.Что(СтрНайти(ЗаголовкиАтрибута, "X-Api-Key: ***") > 0).ЭтоИстина();
	Ожидаем.Что(СтрНайти(ЗаголовкиАтрибута, "X-Auth-Token: ***") > 0).ЭтоИстина();
	Ожидаем.Что(СтрНайти(ЗаголовкиАтрибута, "X-Secret: ***") > 0).ЭтоИстина();
	Ожидаем.Что(СтрНайти(ЗаголовкиАтрибута, "1C-OriginalLocation: http://h/demo/hs/x?token=***&n=1") > 0).ЭтоИстина();
	Ожидаем.Что(СтрНайти(ЗаголовкиАтрибута, "token=abc") > 0).ЭтоЛожь();
	Ожидаем.Что(СтрНайти(ЗаголовкиАтрибута, "Referer: http://h/demo/e1cib?access_token=***") > 0).ЭтоИстина();
	Ожидаем.Что(СтрНайти(ЗаголовкиАтрибута, "access_token=zzz") > 0).ЭтоЛожь();
	Ожидаем.Что(СтрНайти(ЗаголовкиАтрибута, "Location: http://h/cb?code=c&password=***") > 0).ЭтоИстина();
	Ожидаем.Что(СтрНайти(ЗаголовкиАтрибута, "1C-BaseLocation: http://h/demo?token=***") > 0).ЭтоИстина();
	Ожидаем.Что(СтрНайти(ЗаголовкиАтрибута, "1C-ConnectString: Pwd=***;Srvr=h;DBPwd=***;SPwd=***;Ref=demo") > 0)
		.ЭтоИстина();
	Ожидаем.Что(СтрНайти(ЗаголовкиАтрибута, "1C-ApplicationName: 1CV8C") > 0).ЭтоИстина();
	Ожидаем.Что(СтрНайти(ЗаголовкиАтрибута, "1C-SDCVersion: 2") > 0).ЭтоИстина();
	Ожидаем.Что(СтрНайти(ЗаголовкиАтрибута, "1C-openIDLifetime: 43200") > 0).ЭтоИстина();
