&Тест
Процедура ЗаголовокИзНастройкиЦеликомНеПопадаетВТелеметрию() Экспорт

	// Дано
	АтрибутыСобытийТехнологическогоЖурнала.ДополнитьСекретныеЗаголовки("X-My-Company-Custom-Auth");
	Заголовки = "X-My-Company-Custom-Auth: Bearer qwerty" + ПС
		+ " tail" + ПС
		+ "X-My-Company-Custom-Auth-Extra: keep" + ПС
		+ "Host: localhost";
	Текст = "05:12.345678-1,VRSREQUEST,1,Headers='" + Заголовки + "'";

	// Когда
	Экспортер().ОбработатьСобытияТехнологическогоЖурнала(МассивИз(Событие(Текст)), ОписаниеФайла());

	// Тогда
	Запись = ЗаписиЛога()[0];
	ЗаголовкиАтрибута = Атрибуты(Запись)["v8.techlog.Headers"];
	Ожидаем.Что(СтрНайти(ЗаголовкиАтрибута, "X-My-Company-Custom-Auth: ***") > 0).ЭтоИстина();
	Ожидаем.Что(СтрНайти(ЗаголовкиАтрибута, " ***") > 0).ЭтоИстина();
	Ожидаем.Что(СтрНайти(ЗаголовкиАтрибута, "qwerty") > 0).ЭтоЛожь();
	Ожидаем.Что(СтрНайти(ЗаголовкиАтрибута, "tail") > 0).ЭтоЛожь();
	Ожидаем.Что(СтрНайти(ЗаголовкиАтрибута, "X-My-Company-Custom-Auth-Extra: keep") > 0).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Запись["body"]["stringValue"], "qwerty") > 0).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура СекретыЗаголовкаВФорматеJSONНеПопадаютВТелеметрию() Экспорт

	// Дано
	Текст = "{""ts"":""2026-06-20T03:04:58.000001"",""duration"":""1"",""name"":""VRSREQUEST"",""depth"":""1"","
		+ """URI"":""/odata?token=secret&x=1"",""Headers"":""Authorization: Basic YWRtaW46c2VjcmV0""}";
	Событие = ПарсерТехнологическогоЖурналаJSON.Разобрать(Текст, Истина).События[0];

	// Когда
	Экспортер().ОбработатьСобытияТехнологическогоЖурнала(МассивИз(Событие), ОписаниеФайла());

	// Тогда
	Запись = ЗаписиЛога()[0];
	Атрибуты = Атрибуты(Запись);
	Ожидаем.Что(Атрибуты["v8.techlog.URI"]).Равно("/odata?token=***&x=1");
	Ожидаем.Что(Атрибуты["v8.techlog.Headers"]).Равно("Authorization: ***");
	Ожидаем.Что(СтрНайти(Запись["body"]["stringValue"], "secret") > 0).ЭтоЛожь();
	Ожидаем.Что(СтрНайти(Запись["body"]["stringValue"], "YWRtaW46c2VjcmV0") > 0).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ПродолжениеСекретногоЗаголовкаСПереводомCRLFНеОстаетсяВТексте() Экспорт

	// Дано
	Перевод = Символы.ВК + Символы.ПС;
	Заголовки = "Host: localhost" + Перевод
		+ "Authorization: Bearer folded-secret" + Перевод
		+ " folded-secret" + Перевод
		+ "Accept: text/plain" + Перевод
		+ " charset=utf-8";
	Текст = "05:12.345678-1,VRSREQUEST,1,Headers='" + Заголовки + "'";

	// Когда
	Экспортер().ОбработатьСобытияТехнологическогоЖурнала(МассивИз(Событие(Текст)), ОписаниеФайла());

	// Тогда
	Запись = ЗаписиЛога()[0];
	Атрибуты = Атрибуты(Запись);
	Ожидаем.Что(Атрибуты["v8.techlog.Headers"]).Равно("Host: localhost" + ПС
		+ "Authorization: ***" + ПС
		+ " ***" + ПС
		+ "Accept: text/plain" + ПС
		+ " charset=utf-8");
	Тело = Запись["body"]["stringValue"];
	Ожидаем.Что(СтрНайти(Тело, "folded-secret") > 0).ЭтоЛожь();
	Ожидаем.Что(СтрНайти(Тело, ПС + ПС) > 0).ЭтоЛожь();
	Ожидаем.Что(СтрНайти(Тело, " charset=utf-8") > 0).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПродолжениеСекретногоЗаголовкаСПереводомCRLFНеОстаетсяВJSON() Экспорт

	// Дано
	Текст = "{""ts"":""2026-06-20T03:04:58.000001"",""duration"":""1"",""name"":""VRSREQUEST"",""depth"":""1"","
		+ """Headers"":""Host: localhost\r\nAuthorization: Bearer folded-secret\r\n folded-secret\r\n"
		+ "Accept: text/plain\r\n charset=utf-8""}";
	Событие = ПарсерТехнологическогоЖурналаJSON.Разобрать(Текст, Истина).События[0];

	// Когда
	Экспортер().ОбработатьСобытияТехнологическогоЖурнала(МассивИз(Событие), ОписаниеФайла());

	// Тогда
	Запись = ЗаписиЛога()[0];
	Перевод = Символы.ВК + Символы.ПС;
	Ожидаем.Что(Атрибуты(Запись)["v8.techlog.Headers"]).Равно("Host: localhost" + Перевод
		+ "Authorization: ***" + Перевод
		+ " ***" + Перевод
		+ "Accept: text/plain" + Перевод
		+ " charset=utf-8");
	Тело = Запись["body"]["stringValue"];
	Ожидаем.Что(СтрНайти(Тело, "folded-secret") > 0).ЭтоЛожь();
	Ожидаем.Что(СтрНайти(Тело, "Authorization: ***\r\n ***") > 0).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело, "\r\n\r\n") > 0).ЭтоЛожь();
	Ожидаем.Что(СтрНайти(Тело, " charset=utf-8") > 0).ЭтоИстина();

КонецПроцедуры

Функция Событие(Текст)
	Возврат ПарсерТехнологическогоЖурнала.Разобрать(Текст + ПС, Дата(2026, 10, 20, 9, 0, 0)).События[0];
КонецФункции

Функция МассивИз(Значение)
	Результат = Новый Массив;
	Результат.Добавить(Значение);
	Возврат Результат;
КонецФункции

Функция ОписаниеФайла()
	Описание = Новый Структура;
	Описание.Вставить("Путь", "/var/log/1c/rphost_1234/26102009.log");
	Описание.Вставить("Каталог", "/var/log/1c");
	Описание.Вставить("Процесс", "rphost");
	Описание.Вставить("ИдПроцесса", "1234");
	Описание.Вставить("ДатаЧаса", Дата(2026, 10, 20, 9, 0, 0));
	Возврат Описание;
КонецФункции

Функция ЗаписиЛога()
	Результат = Новый Массив;
	Для Каждого Отправка Из ТранспортЛогов.ПолучитьОтправленные() Цикл
		Для Каждого РесурсныеЛоги Из Отправка["Данные"]["resourceLogs"] Цикл
			Для Каждого ЛогиОбласти Из РесурсныеЛоги["scopeLogs"] Цикл
				Для Каждого Запись Из ЛогиОбласти["logRecords"] Цикл
					Результат.Добавить(Запись);
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция НайтиМетрику(Имя)
	Для Каждого Метрика Из ОтправленныеМетрики() Цикл
		Если Метрика["name"] = Имя Тогда
			Возврат Метрика;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "Не найдена метрика " + Имя;
КонецФункции

Функция ЕстьМетрика(Имя)
	Для Каждого Метрика Из ОтправленныеМетрики() Цикл
		Если Метрика["name"] = Имя Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция ОтправленныеМетрики()
	Результат = Новый Массив;
	Для Каждого Отправка Из ТранспортМетрик.ПолучитьОтправленные() Цикл
		Для Каждого РесурсныеМетрики Из Отправка["Данные"]["resourceMetrics"] Цикл
			Для Каждого МетрикиОбласти Из РесурсныеМетрики["scopeMetrics"] Цикл
				Для Каждого Метрика Из МетрикиОбласти["metrics"] Цикл
					Результат.Добавить(Метрика);
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Атрибуты OTLP в виде соответствия ключ -> строковое представление значения
Функция Атрибуты(Объект)
	Результат = Новый Соответствие;
	Если Объект = Неопределено ИЛИ Объект["attributes"] = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Атрибут Из Объект["attributes"] Цикл
		Значение = Атрибут["value"];
		Для Каждого Вид Из Значение Цикл
			Результат.Вставить(Атрибут["key"], Строка(Вид.Значение));
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция АтрибутOtlp(Объект, Ключ)
	Для Каждого Атрибут Из Объект["attributes"] Цикл
		Если Атрибут["key"] = Ключ Тогда
			Возврат Атрибут["value"];
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

ПС = Символы.ПС;
