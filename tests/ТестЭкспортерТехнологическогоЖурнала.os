Процедура ИсключениеСЦепочкойОшибокПолучаетТекстПервогоУровняИЦепочкуВСтеке() Экспорт

	// Дано
	Описание = "src\rserver\src\RMngrCalls.cpp(536):" + ПС
		+ "60c686dc-798f-4d17-aadb-a90156a16eb8" + ПС
		+ "60c686dc-798f-4d17-aadb-a90156a16eb8: Сеанс отсутствует или удален" + ПС
