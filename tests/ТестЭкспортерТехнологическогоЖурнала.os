&Тест
Процедура ДлительностьЗаписываетсяВГистограмму() Экспорт

	// Дано
	События = Новый Массив;
	События.Добавить(Событие("05:12.000001-15,DBMSSQL,1,p:processName=erp"));
	События.Добавить(Событие("05:12.000002-5,DBMSSQL,1,p:processName=erp"));

	// Когда
	Экспортер = Экспортер();
	Экспортер.ОбработатьСобытияТехнологическогоЖурнала(События, ОписаниеФайла());
	Экспортер.ПодтвердитьПроход();
	Телеметрия.СброситьБуфер();

	// Тогда
	Метрика = НайтиМетрику("v8.techlog.event.duration");
	Ожидаем.Что(Метрика["unit"]).Равно("s");
	Точка = Метрика["histogram"]["dataPoints"][0];
	Ожидаем.Что(Число(Точка["count"])).Равно(2);
	Ожидаем.Что(Точка["sum"]).Равно(0.00002);
	Атрибуты = Атрибуты(Точка);
	Ожидаем.Что(Атрибуты["v8.techlog.event.name"]).Равно("DBMSSQL");
	Ожидаем.Что(Атрибуты["process.executable.name"]).Равно("rphost");
	Ожидаем.Что(Атрибуты["v8.infobase.name"]).Равно("erp");

КонецПроцедуры

&Тест
Процедура ОтмененныйПроходНеУчитываетсяВГистограмме() Экспорт

	// Дано - проход с неудачной отправкой, затем повтор того же события
	Экспортер = Экспортер();
	Экспортер.ОбработатьСобытияТехнологическогоЖурнала(
		МассивИз(Событие("05:12.000001-15,DBMSSQL,1,p:processName=erp")), ОписаниеФайла());
	Экспортер.ОтменитьПроход();

	// Когда
	Экспортер.ОбработатьСобытияТехнологическогоЖурнала(
		МассивИз(Событие("05:12.000001-15,DBMSSQL,1,p:processName=erp")), ОписаниеФайла());
	Экспортер.ПодтвердитьПроход();
	Телеметрия.СброситьБуфер();

	// Тогда
	Точка = НайтиМетрику("v8.techlog.event.duration")["histogram"]["dataPoints"][0];
	Ожидаем.Что(Число(Точка["count"])).Равно(1);

КонецПроцедуры

&Тест
Процедура ДлительностьОбращенияКСУБДЗаписываетсяВМетрикуОперацийБД() Экспорт

	// Дано
	События = Новый Массив;
	События.Добавить(Событие("05:12.000001-15,DBMSSQL,1,p:processName=erp,DataBase=srv1c\erp,Sql=SELECT 1"));
	События.Добавить(Событие("05:12.000002-5,DBMSSQL,1,p:processName=erp,DataBase=srv1c\erp,Sql=SELECT 2"));

	// Когда
	Экспортер = Экспортер();
	Экспортер.ОбработатьСобытияТехнологическогоЖурнала(События, ОписаниеФайла());
	Экспортер.ПодтвердитьПроход();
	Телеметрия.СброситьБуфер();

	// Тогда - атрибуты семантических соглашений, без свойств события: от них разрастаются ряды
	Метрика = НайтиМетрику("db.client.operation.duration");
	Ожидаем.Что(Метрика["unit"]).Равно("s");
	Точка = Метрика["histogram"]["dataPoints"][0];
	Ожидаем.Что(Число(Точка["count"])).Равно(2);
	Ожидаем.Что(Точка["sum"]).Равно(0.00002);
	Атрибуты = Атрибуты(Точка);
	Ожидаем.Что(Атрибуты.Количество()).Равно(3);
	Ожидаем.Что(Атрибуты["db.system.name"]).Равно("microsoft.sql_server");
	Ожидаем.Что(Атрибуты["db.namespace"]).Равно("erp");
	Ожидаем.Что(Атрибуты["server.address"]).Равно("srv1c");

КонецПроцедуры

&Тест
