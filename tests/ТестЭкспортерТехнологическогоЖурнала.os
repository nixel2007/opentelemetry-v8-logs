Процедура ИсключениеЗаписываетсяСобытиемException() Экспорт

	// Дано
	Событие = Событие("05:12.000001-0,EXCP,1,Exception=DataBaseException,Descr='Деление на 0'");

	// Когда
	Экспортер().ОбработатьСобытияТехнологическогоЖурнала(МассивИз(Событие), ОписаниеФайла());

