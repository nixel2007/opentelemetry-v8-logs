&Тест
Процедура СерьезностьИзСвойстваLevel() Экспорт

	// Дано - платформа оценивает событие сама: EXCP бывает и WARNING, и INFO
	События = Новый Массив;
	События.Добавить(Событие("05:12.000001-0,SDBL,1,level=TRACE"));
	События.Добавить(Событие("05:12.000002-0,SDBL,1,level=DEBUG"));
	События.Добавить(Событие("05:12.000003-0,CALL,1,level=INFO"));
	События.Добавить(Событие("05:12.000004-0,EXCP,1,level=WARNING"));
	События.Добавить(Событие("05:12.000005-0,EXCP,1,level=INFO"));
	События.Добавить(Событие("05:12.000006-0,EXCPCNTX,1,level=ERROR"));
	События.Добавить(Событие("05:12.000007-0,EXCP,1,level=UNKNOWN"));

	// Когда
	Экспортер().ОбработатьСобытияТехнологическогоЖурнала(События, ОписаниеФайла());

	// Тогда - неизвестное значение level - по имени события
	Записи = ЗаписиЛога();
	Ожидаем.Что(Записи[0]["severityNumber"]).Равно(1);
	Ожидаем.Что(Записи[0]["severityText"]).Равно("TRACE");
	Ожидаем.Что(Записи[1]["severityNumber"]).Равно(5);
	Ожидаем.Что(Записи[1]["severityText"]).Равно("DEBUG");
	Ожидаем.Что(Записи[2]["severityNumber"]).Равно(9);
	Ожидаем.Что(Записи[3]["severityNumber"]).Равно(13);
	Ожидаем.Что(Записи[3]["severityText"]).Равно("WARN");
	Ожидаем.Что(Записи[4]["severityNumber"]).Равно(9);
	Ожидаем.Что(Записи[5]["severityNumber"]).Равно(17);
	Ожидаем.Что(Записи[6]["severityNumber"]).Равно(17);

КонецПроцедуры

