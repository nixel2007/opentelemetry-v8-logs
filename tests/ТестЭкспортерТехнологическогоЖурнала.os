	// Когда
	Экспортер = Экспортер();
	Экспортер.ОбработатьСобытияТехнологическогоЖурнала(
		МассивИз(Событие("05:12.000001-15,DBPOSTGRS,1,DataBase=srv1c\erp")), ОписаниеФайла());
	Экспортер.ПодтвердитьПроход();
	Телеметрия.СброситьБуфер();

	// Тогда
	Точка = НайтиМетрику("db.client.operation.duration")["histogram"]["dataPoints"][0];
	Ожидаем.Что(СтрСоединить(Точка["explicitBounds"], ";"))
		.Равно(СтрСоединить(ОтелСемантическиеСоглашения.ГраницыДлительностиОперацииБД(), ";"));

КонецПроцедуры

&Тест
Процедура СобытиеНеСУБДНеПопадаетВМетрикуОперацийБД() Экспорт

