КонецПроцедуры

// Пара VRS внутри вызова, как в rphost за веб-сервером
Функция СобытияHTTPЗапроса(Статус)
	Заголовки = "Host: localhost" + ПС + "1C-BaseLocation: http://localhost/vrsmin" + ПС
		+ "1C-OriginalLocation: http://localhost/vrsmin/hs/mini/hello";
	Текст = СтрШаблон("05:12.100000-0,VRSREQUEST,1,OSThread=7,t:clientID=5,Method=GET,URI=/hs/mini/hello,"
		+ "Headers='%1',Body=0", Заголовки) + ПС
		+ СтрШаблон("05:12.400000-0,VRSRESPONSE,1,OSThread=7,t:clientID=5,Status=%1,Phrase=OK", Статус) + ПС
		+ "05:12.500000-500000,CALL,0,OSThread=7,t:clientID=5,IName=IVResourceRemoteConnection,MName=send" + ПС;
	Возврат ПарсерТехнологическогоЖурнала.Разобрать(Текст, Дата(2026, 10, 20, 9, 0, 0)).События;
КонецФункции

