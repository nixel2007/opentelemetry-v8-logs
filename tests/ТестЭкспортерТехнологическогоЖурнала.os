#Использовать "../src/Экспорт"
#Использовать "../src/ТехнологическийЖурнал"
#Использовать asserts
#Использовать opentelemetry
#Использовать collectionos

&Пластилин
Перем ПарсерТехнологическогоЖурнала;

&Пластилин
Перем ПарсерТехнологическогоЖурналаJSON;

&Пластилин
Перем АтрибутыСобытийТехнологическогоЖурнала;

&Табакерка
&Пластилин("ТелеметрияЖурналов")
Перем ТабакеркаТелеметрии;

&Табакерка
&Пластилин("ЭкспортерТехнологическогоЖурнала")
Перем ТабакеркаЭкспортеров;

Перем ПС;
Перем ТранспортЛогов;
Перем ТранспортМетрик;
Перем ПровайдерЛогов;
Перем ПровайдерТрассировки;
Перем Телеметрия;

&ПередКаждым
Процедура Подготовить() Экспорт
	Ресурс = Новый ОтелРесурс();
	ТранспортЛогов = Новый ОтелВПамятьТранспорт;
	ПровайдерЛогов = Новый ОтелПровайдерЛогирования(Ресурс,
		Новый ОтелПростойПроцессорЛогов(Новый ОтелЭкспортерЛогов(ТранспортЛогов)));
	ПровайдерТрассировки = Новый ОтелПровайдерТрассировки(Ресурс);
	ТранспортМетрик = Новый ОтелВПамятьТранспорт;
	Телеметрия = ТабакеркаТелеметрии.Достать(Массивы.ИзЭлементов(ПровайдерЛогов, ПровайдерТрассировки,
		Новый ОтелЭкспортерМетрик(ТранспортМетрик), 3600000, "1c", ""));
КонецПроцедуры

&ПослеКаждого
Процедура Закрыть() Экспорт
	Телеметрия.Закрыть();
	ПровайдерЛогов.Закрыть();
	ПровайдерТрассировки.Закрыть();
КонецПроцедуры

&Тест
Процедура СобытиеСтановитсяЗаписьюЛога() Экспорт

	// Дано
	Событие = Событие("05:12.345678-15,CALL,1,Usr=Admin,p:processName=erp");

	// Когда
	Экспортер().ОбработатьСобытияТехнологическогоЖурнала(МассивИз(Событие), ОписаниеФайла());

	// Тогда
	Записи = ЗаписиЛога();
	Ожидаем.Что(Записи).ИмеетДлину(1);
	Запись = Записи[0];
	Ожидаем.Что(Запись["timeUnixNano"]).Равно("1792487112345678000");
	Ожидаем.Что(Запись["severityNumber"]).Равно(9);
	Ожидаем.Что(Запись["body"]["stringValue"]).Равно("05:12.345678-15,CALL,1,Usr=Admin,p:processName=erp");

	Атрибуты = Атрибуты(Запись);
	Ожидаем.Что(Атрибуты["v8.techlog.event.name"]).Равно("CALL");
	Ожидаем.Что(Атрибуты["v8.techlog.duration"]).Равно("15");
	Ожидаем.Что(Атрибуты["v8.techlog.depth"]).Равно("1");
	Ожидаем.Что(Атрибуты["user.name"]).Равно("Admin");
	Ожидаем.Что(Атрибуты["v8.techlog.p:processName"]).Равно("erp");
	Ожидаем.Что(Атрибуты["process.executable.name"]).Равно("rphost");
	Ожидаем.Что(Атрибуты["process.pid"]).Равно("1234");
	Ожидаем.Что(Атрибуты["log.file.path"]).Равно("/var/log/1c/rphost_1234/26102009.log");
	Ожидаем.Что(Атрибуты["log.file.name"]).Равно("26102009.log");

КонецПроцедуры

&Тест
Процедура ИнформационнаяБазаИзСвойстваСобытияВРесурсе() Экспорт

	// Дано
	Событие = Событие("05:12.345678-15,CALL,1,p:processName=erp");

	// Когда
	Экспортер().ОбработатьСобытияТехнологическогоЖурнала(МассивИз(Событие), ОписаниеФайла());

	// Тогда - база в ресурсе (индексируемая метка), а не в атрибутах записи
	Ресурс = РесурсыЗаписейЛога()[0];
	Ожидаем.Что(Ресурс["service.name"]).Равно("1c");
	Ожидаем.Что(Ресурс["v8.infobase.name"]).Равно("erp");
	Ожидаем.Что(Атрибуты(ЗаписиЛога()[0])["v8.infobase.name"]).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ИнформационнаяБазаИзНастроекИсточника() Экспорт

	// Дано - в файловом режиме p:processName у событий базы пустой
	События = Новый Массив;
	События.Добавить(Событие("05:12.345678-15,SDBL,1"));
	События.Добавить(Событие("05:12.345679-15,CALL,1,p:processName=RemoteDebugger"));

	// Когда
	Экспортер(, "InfoBase").ОбработатьСобытияТехнологическогоЖурнала(События, ОписаниеФайла());

	// Тогда - свойство события важнее настройки источника
	Ресурсы = РесурсыЗаписейЛога();
	Ожидаем.Что(Ресурсы[0]["v8.infobase.name"]).Равно("InfoBase");
	Ожидаем.Что(Ресурсы[1]["v8.infobase.name"]).Равно("RemoteDebugger");

КонецПроцедуры

