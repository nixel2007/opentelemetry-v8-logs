&Тест
Процедура ДлительностьВходящегоВызоваЗаписываетсяВМетрикуRPC() Экспорт

	// Когда
	Экспортер = Экспортер();
	Экспортер.ОбработатьСобытияТехнологическогоЖурнала(МассивИз(Событие(
		"05:12.000001-15,CALL,0,p:processName=erp,IName=IVResourceRemoteConnection,MName=send")), ОписаниеФайла());
	Экспортер.ПодтвердитьПроход();
	Телеметрия.СброситьБуфер();

	// Тогда
	Метрика = НайтиМетрику("rpc.server.call.duration");
	Ожидаем.Что(Метрика["unit"]).Равно("s");
	Точка = Метрика["histogram"]["dataPoints"][0];
	Ожидаем.Что(Число(Точка["count"])).Равно(1);
	Ожидаем.Что(СтрСоединить(Точка["explicitBounds"], ";"))
		.Равно("0.0001;0.0005;0.001;0.005;0.01;0.05;0.1;0.5;1;5;10;50;100");
	Атрибуты = Атрибуты(Точка);
	Ожидаем.Что(Атрибуты.Количество()).Равно(2);
	Ожидаем.Что(Атрибуты["rpc.system.name"]).Равно("1c.v8");
	Ожидаем.Что(Атрибуты["rpc.method"]).Равно("IVResourceRemoteConnection/send");
	Ожидаем.Что(ЕстьМетрика("rpc.client.call.duration")).ЭтоЛожь();

КонецПроцедуры

