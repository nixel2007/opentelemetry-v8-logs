// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
// BSLLS:DuplicateStringLiteral-off
// BSLLS:UnusedParameters-off
// Фейк клиента RAS и его фабрики: отдаёт заданные сущности со всеми полями схем v8ras и пишет журнал вызовов.

Перем Вызовы;
Перем Кластеры;
Перем Базы;
Перем Процессы;
Перем Сеансы;
Перем Соединения;
Перем ТекстОшибкиПодключения;
Перем ОписанияБаз;
Перем ОтказыИнформацииОБазе;

#Область Настройка

Функция ДобавитьКластер(Ид, Имя) Экспорт
	Кластер = Новый Структура("Ид, ПериодПринудительногоЗавершения, Хост, ИнтервалПерезапуска, Порт,
		|ДопустимыйОбъемПамяти, ИнтервалПревышенияПамяти, Имя, УровеньБезопасности, УровеньОтказоустойчивости,
		|РежимРаспределенияНагрузки, ДопустимоеОтклонениеОшибок, ЗавершатьПроблемныеПроцессы, ДампПриПревышенииПамяти",
		Ид, 0, "srv1", 0, 1541, 0, 0, Имя, 0, 0, 0, 0, Ложь, Ложь);
	Кластеры.Добавить(Кластер);
	Базы.Вставить(Ид, Новый Массив);
	Процессы.Вставить(Ид, Новый Массив);
	Сеансы.Вставить(Ид, Новый Массив);
	Соединения.Вставить(Ид, Новый Массив);
	Возврат Кластер;
КонецФункции

// Поля - поля полного описания базы (СхемыRAS.База), которое отдаёт ИнформацияОБазе
Функция ДобавитьБазу(ИдКластера, Ид, Имя, Поля = Неопределено) Экспорт
	База = Новый Структура("Ид, Описание, Имя", Ид, "", Имя);
	Базы[ИдКластера].Добавить(База);

	Описание = Новый Структура;
	Описание.Вставить("Ид", Ид);
	Описание.Вставить("СмещениеДат", 0);
	ЗаполнитьСтроками(Описание, "СУБД, ИмяБД, ПарольБД, СерверБД, ПользовательБД, СообщениеБлокировки,
		|ПараметрБлокировки, Описание, Локаль, КодРазрешения, ПараметрыВнешнегоУправленияСеансами,
		|ПрофильБезопасности, ПрофильБезопасногоРежима");
	Описание.Вставить("НачалоБлокировки", '00010101');
	Описание.Вставить("КонецБлокировки", '00010101');
	Описание.Вставить("Имя", Имя);
	Описание.Вставить("БлокировкаРегламентных", Ложь);
	Описание.Вставить("УровеньБезопасности", 0);
	Описание.Вставить("БлокировкаСеансов", Ложь);
	Описание.Вставить("ВыдачаЛицензийСервером", 0);
	Описание.Вставить("ВнешнееУправлениеСеансамиОбязательно", Ложь);
	Описание.Вставить("РезервироватьРабочиеПроцессы", Ложь);
	Дополнить(Описание, Поля);
	ОписанияБаз.Вставить(КлючБазы(ИдКластера, Ид), Описание);

	Возврат База;
КонецФункции

Функция ДобавитьПроцесс(ИдКластера, Ид, Поля = Неопределено) Экспорт
	Процесс = Новый Структура;
	Процесс.Вставить("Ид", Ид);
	ЗаполнитьЧислами(Процесс, "СредняяДлительностьОбратногоВызова, СредняяДлительностьВызова,
		|СредняяДлительностьВызоваСУБД, СредняяДлительностьБлокировок, СредняяДлительностьСерверногоВызова,
		|СреднееЧислоПотоков, Емкость, Соединений, Порт, ВремяПревышенияПамяти, ПамятьКБ, РазмерВыборки,
		|ДоступнаяПроизводительность");
	Процесс.Вставить("Хост", "");
	Процесс.Вставить("Включен", Ложь);
	Процесс.Вставить("Лицензии", Новый Массив);
	Процесс.Вставить("Pid", "");
	Процесс.Вставить("Запущен", Ложь);
	Процесс.Вставить("Начало", '00010101');
	Процесс.Вставить("Используется", Ложь);
	Процесс.Вставить("Резервный", Ложь);
	Дополнить(Процесс, Поля);
	Процессы[ИдКластера].Добавить(Процесс);
	Возврат Процесс;
КонецФункции

Функция ДобавитьСеанс(ИдКластера, Поля = Неопределено) Экспорт
	Сеанс = Новый Структура;
	Сеанс.Вставить("Ид", Строка(Новый УникальныйИдентификатор));
	Сеанс.Вставить("Приложение", "");
	ЗаполнитьЧислами(Сеанс, "БлокированоСУБД, БлокированоБлокировками, БайтВсего, БайтЗа5Минут, ВызововВсего,
		|ВызововЗа5Минут, БайтСУБДВсего, БайтСУБДЗа5Минут, ЗахваченоСУБДМс, ДлительностьВсего, ДлительностьСУБДВсего,
		|ДлительностьТекущая, ДлительностьСУБДТекущая, ДлительностьЗа5Минут, ДлительностьСУБДЗа5Минут, ЗаснутьЧерез,
		|ЗавершитьСпящийЧерез, Номер, ПамятьТекущая, ПамятьЗа5Минут, ПамятьВсего, ЧтениеТекущее, ЧтениеЗа5Минут,
		|ЧтениеВсего, ЗаписьТекущая, ЗаписьЗа5Минут, ЗаписьВсего, ДлительностьСервисаТекущая,
		|ДлительностьСервисаЗа5Минут, ДлительностьСервисаВсего, ПроцессорноеВремяТекущее, ПроцессорноеВремяЗа5Минут,
		|ПроцессорноеВремяВсего");
	Сеанс.Вставить("ИдСоединения", ПустойУИД());
	Сеанс.Вставить("ЗахваченоСУБД", "");
	Сеанс.Вставить("ЗахваченоСУБДВ", '00010101');
	Сеанс.Вставить("Хост", "client-pc");
	Сеанс.Вставить("ИдБазы", ПустойУИД());
	Сеанс.Вставить("ПоследняяАктивность", '00010101');
	Сеанс.Вставить("Спящий", Ложь);
	Сеанс.Вставить("Лицензии", Новый Массив);
	Сеанс.Вставить("Локаль", "ru_RU");
	Сеанс.Вставить("ИдПроцесса", ПустойУИД());
	Сеанс.Вставить("Начало", '00010101');
	Сеанс.Вставить("ИмяПользователя", "Иванов");
	Сеанс.Вставить("ТекущийСервис", "");
	Сеанс.Вставить("РазделениеДанных", "");
	Сеанс.Вставить("АдресКлиента", "10.0.0.1");
	Дополнить(Сеанс, Поля);
	Сеансы[ИдКластера].Добавить(Сеанс);
	Возврат Сеанс;
КонецФункции

Функция ДобавитьСоединение(ИдКластера, Поля = Неопределено) Экспорт
	Соединение = Новый Структура("Ид, Приложение, БлокированоБлокировками, Подключено, Номер, Хост, ИдБазы,
		|ИдПроцесса, НомерСеанса", Строка(Новый УникальныйИдентификатор), "", 0, '00010101', 0, "client-pc", ПустойУИД(),
		ПустойУИД(), 0);
	Дополнить(Соединение, Поля);
	Соединения[ИдКластера].Добавить(Соединение);
	Возврат Соединение;
КонецФункции

Функция Лицензия(ИмяФайла, Серия, МаксПользователейВсего, Поля = Неопределено) Экспорт
	Лицензия = Новый Структура("ИмяФайла, ПолноеПредставление, ВыданаСервером, Тип, МаксПользователейВсего,
		|МаксПользователейТекущее, Сетевая, АдресМенеджера, PidМенеджера, ПортМенеджера, Серия, КраткоеПредставление",
		ИмяФайла, "", Истина, 0, МаксПользователейВсего, 0, Ложь, "", "", 0, Серия, "");
	Дополнить(Лицензия, Поля);
	Возврат Лицензия;
КонецФункции

Процедура ОтказыватьПриПодключении(Текст) Экспорт
	ТекстОшибкиПодключения = Текст;
КонецПроцедуры

Процедура ОтказыватьВИнформацииОБазе(ИдКластера, ИдБазы, Текст) Экспорт
	ОтказыИнформацииОБазе.Вставить(КлючБазы(ИдКластера, ИдБазы), Текст);
КонецПроцедуры

Функция Вызовы() Экспорт
	Возврат Вызовы;
КонецФункции

Функция ПустойУИД() Экспорт
	Возврат "00000000-0000-0000-0000-000000000000";
КонецФункции

#КонецОбласти

#Область ФабрикаИКлиент

Функция Создать(Хост, Порт, ТаймаутМс) Экспорт
	Вызовы.Добавить(СтрШаблон("Создать:%1:%2", Хост, Формат(Порт, "ЧГ=")));
	Вызовы.Добавить(СтрШаблон("ТаймаутМс:%1", Формат(ТаймаутМс, "ЧГ=")));
	Возврат ЭтотОбъект;
КонецФункции

Функция Подключить(Сокет = Неопределено) Экспорт
	Вызовы.Добавить("Подключить");
	Если ТекстОшибкиПодключения <> Неопределено Тогда
		ВызватьИсключение ТекстОшибкиПодключения;
	КонецЕсли;
	Возврат ЭтотОбъект;
КонецФункции

Процедура АутентифицироватьАгент(Пользователь, Пароль) Экспорт
	Вызовы.Добавить(СтрШаблон("АутентифицироватьАгент:%1:%2", Пользователь, Пароль));
КонецПроцедуры

Процедура АутентифицироватьКластер(ИдКластера, Пользователь, Пароль) Экспорт
	Вызовы.Добавить(СтрШаблон("АутентифицироватьКластер:%1:%2:%3", ИдКластера, Пользователь, Пароль));
КонецПроцедуры

Процедура АутентифицироватьБазу(ИдКластера, Пользователь, Пароль) Экспорт
	Вызовы.Добавить(СтрШаблон("АутентифицироватьБазу:%1:%2:%3", ИдКластера, Пользователь, Пароль));
КонецПроцедуры

Функция Кластеры() Экспорт
	Вызовы.Добавить("Кластеры");
	Возврат Кластеры;
КонецФункции

Функция Инфобазы(ИдКластера) Экспорт
	Возврат Базы[ИдКластера];
КонецФункции

Функция ИнформацияОБазе(ИдКластера, ИдБазы) Экспорт
	Вызовы.Добавить(СтрШаблон("ИнформацияОБазе:%1:%2", ИдКластера, ИдБазы));
	Отказ = ОтказыИнформацииОБазе[КлючБазы(ИдКластера, ИдБазы)];
	Если Отказ <> Неопределено Тогда
		ВызватьИсключение Отказ;
	КонецЕсли;
	Возврат ОписанияБаз[КлючБазы(ИдКластера, ИдБазы)];
КонецФункции

Функция РабочиеПроцессы(ИдКластера) Экспорт
	Возврат Процессы[ИдКластера];
КонецФункции

Функция Сеансы(ИдКластера) Экспорт
	Возврат Сеансы[ИдКластера];
КонецФункции

Функция Соединения(ИдКластера) Экспорт
	Возврат Соединения[ИдКластера];
КонецФункции

Процедура Отключить() Экспорт
	Вызовы.Добавить("Отключить");
КонецПроцедуры

#КонецОбласти

Процедура ЗаполнитьЧислами(Сущность, Имена)
	Для Каждого Имя Из СтрРазделить(Имена, ", " + Символы.ПС, Ложь) Цикл
		Сущность.Вставить(СокрЛП(Имя), 0);
	КонецЦикла;
КонецПроцедуры

Процедура ЗаполнитьСтроками(Сущность, Имена)
	Для Каждого Имя Из СтрРазделить(Имена, ", " + Символы.ПС, Ложь) Цикл
		Сущность.Вставить(СокрЛП(Имя), "");
	КонецЦикла;
КонецПроцедуры

Функция КлючБазы(ИдКластера, ИдБазы)
	Возврат ИдКластера + "/" + ИдБазы;
КонецФункции

Процедура Дополнить(Сущность, Поля)
	Если Поля = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого КлючИЗначение Из Поля Цикл
		Сущность.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
КонецПроцедуры

Процедура ПриСозданииОбъекта()
	Вызовы = Новый Массив;
	Кластеры = Новый Массив;
	Базы = Новый Соответствие;
	Процессы = Новый Соответствие;
	Сеансы = Новый Соответствие;
	Соединения = Новый Соответствие;
	ОписанияБаз = Новый Соответствие;
	ОтказыИнформацииОБазе = Новый Соответствие;
КонецПроцедуры
