// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
// BSLLS:UnusedParameters-off
// Шпион телеметрии журналов: сам себе провайдер и метр, инструменты - такие же шпионы с именем,
// вызовы инструментов пишутся в общий журнал.

Перем ПровайдерЛогирования;
Перем ИмяИнструмента;
Перем ЖурналВызовов;

#Область Телеметрия

Функция ДляСервиса(Знач ИмяСервиса, Знач ИнформационнаяБаза = "") Экспорт
	Возврат Новый Структура("ПровайдерМетрик, ПровайдерЛогирования", ЭтотОбъект, ПровайдерЛогирования);
КонецФункции

Функция ПолучитьМетр(ИмяОбласти) Экспорт
	Возврат ЭтотОбъект;
КонецФункции

Функция СоздатьСчетчик(Имя, Описание = "", Единица = "") Экспорт
	Возврат Новый ШпионМетрик(ПровайдерЛогирования, Имя, ЖурналВызовов);
КонецФункции

Функция СоздатьГистограмму(Имя, Описание = "", Единица = "", Совет = Неопределено) Экспорт
	Возврат Новый ШпионМетрик(ПровайдерЛогирования, Имя, ЖурналВызовов);
КонецФункции

Процедура Добавить(Знач Значение, Атрибуты = Неопределено, Контекст = Неопределено) Экспорт
	ЗаписатьВызов("Добавить", Значение, Атрибуты);
КонецПроцедуры

Процедура Записать(Знач Значение, Атрибуты = Неопределено, Контекст = Неопределено) Экспорт
	ЗаписатьВызов("Записать", Значение, Атрибуты);
КонецПроцедуры

#КонецОбласти

#Область Проверка

// Вызовы инструментов в порядке записи: Структура("Инструмент, Метод, Значение, Атрибуты")
Функция Вызовы() Экспорт
	Возврат ЖурналВызовов;
КонецФункции

// Вызовы одного инструмента по его имени
Функция ВызовыИнструмента(Имя) Экспорт
	Результат = Новый Массив;
	Для Каждого Вызов Из ЖурналВызовов Цикл
		Если Вызов.Инструмент = Имя Тогда
			Результат.Добавить(Вызов);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти

Процедура ЗаписатьВызов(Метод, Значение, Атрибуты)
	ЖурналВызовов.Добавить(Новый Структура("Инструмент, Метод, Значение, Атрибуты",
		ИмяИнструмента, Метод, Значение, Атрибуты));
КонецПроцедуры

Процедура ПриСозданииОбъекта(НовыйПровайдерЛогирования, Имя = "", Журнал = Неопределено)
	ПровайдерЛогирования = НовыйПровайдерЛогирования;
	ИмяИнструмента = Имя;
	ЖурналВызовов = ?(Журнал = Неопределено, Новый Массив, Журнал);
КонецПроцедуры
