// BSLLS:MagicNumber-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
// BSLLS:DuplicateStringLiteral-off
// BSLLS:MagicDate-off
// BSLLS:NestedFunctionInParameters-off
// BSLLS:Typo-off
#Использовать "../src/ТехнологическийЖурнал"
#Использовать asserts

&Пластилин
Перем ПарсерТехнологическогоЖурналаJSON;

Перем ПС;

&Тест
Процедура РазборСобытия() Экспорт

	// Дано
	Текст = "{""ts"":""2026-06-20T03:04:58.858004"",""duration"":""15"",""name"":""DBMSSQL"",""depth"":""5"","
		+ """level"":""DEBUG"",""process"":""rphost"",""Usr"":""Андрей"",""Rows"":""1""}" + ПС;

	// Когда
	Результат = ПарсерТехнологическогоЖурналаJSON.Разобрать(Текст);

	// Тогда
	Ожидаем.Что(Результат.События).ИмеетДлину(1);
	Событие = Результат.События[0];
	Ожидаем.Что(Событие.Время).Равно(Дата(2026, 6, 20, 3, 4, 58));
	Ожидаем.Что(Событие.Микросекунды).Равно(858004);
	Ожидаем.Что(Событие.Длительность).Равно(15);
	Ожидаем.Что(Событие.Имя).Равно("DBMSSQL");
	Ожидаем.Что(Событие.Уровень).Равно(5);
	Ожидаем.Что(Событие.Свойства["level"]).Равно("DEBUG");
	Ожидаем.Что(Событие.Свойства["process"]).Равно("rphost");
	Ожидаем.Что(Событие.Свойства["Usr"]).Равно("Андрей");
	Ожидаем.Что(Событие.Свойства["Rows"]).Равно("1");
	Ожидаем.Что(Событие.Свойства["ts"]).Равно(Неопределено);
	Ожидаем.Что(Событие.Свойства["name"]).Равно(Неопределено);
	Ожидаем.Что(Событие.Текст).Равно(СокрП(Текст));
	Ожидаем.Что(Результат.Остаток).Равно("");

КонецПроцедуры

&Тест
Процедура СобытиеСНечисловымиПолямиПропускается() Экспорт

	// Дано
	Текст = "{""ts"":""2026-06-20T03:04:58.858004"",""duration"":""abc"",""name"":""CALL"",""depth"":""1""}" + ПС
		+ "{""ts"":""2026-06-20T03:04:59.000001"",""duration"":""1"",""name"":""CONN"",""depth"":""x""}" + ПС
		+ "{""ts"":""2026-06-20T03:05:00.000001"",""duration"":""2"",""name"":""SDBL"",""depth"":""0""}" + ПС;

	// Когда
	Результат = ПарсерТехнологическогоЖурналаJSON.Разобрать(Текст);

	// Тогда
	Ожидаем.Что(Результат.События).ИмеетДлину(1);
	Ожидаем.Что(Результат.События[0].Имя).Равно("SDBL");
	Ожидаем.Что(Результат.Пропущено).Равно(2);

КонецПроцедуры

&Тест
Процедура РазборЭкранированныхСимволов() Экспорт

	// Дано
	Текст = "{""ts"":""2026-06-20T03:04:58.000001"",""duration"":""1"",""name"":""EXCP"",""depth"":""1"","
		+ """Context"":""Строка1\r\nСтрока2"",""Descr"":""кавычка \"" и слеш \\ и A""}" + ПС;

	// Когда
	Результат = ПарсерТехнологическогоЖурналаJSON.Разобрать(Текст);

	// Тогда
	Свойства = Результат.События[0].Свойства;
	Ожидаем.Что(Свойства["Context"]).Равно("Строка1" + Символы.ВК + ПС + "Строка2");
	Ожидаем.Что(Свойства["Descr"]).Равно("кавычка "" и слеш \ и A");

КонецПроцедуры

&Тест
Процедура ПовторяющиесяКлючиСобираютсяВМассив() Экспорт

	// Дано
	Текст = "{""ts"":""2026-06-20T03:04:58.000001"",""duration"":""8"",""name"":""SDBL"",""depth"":""1"","
		+ """Func"":""BeginTransaction"",""Func"":""CommitTransaction""}" + ПС;

	// Когда
	Результат = ПарсерТехнологическогоЖурналаJSON.Разобрать(Текст);

	// Тогда
	Значение = Результат.События[0].Свойства["Func"];
	Ожидаем.Что(Значение).ИмеетТип("Массив");
	Ожидаем.Что(Значение[0]).Равно("BeginTransaction");
	Ожидаем.Что(Значение[1]).Равно("CommitTransaction");

КонецПроцедуры

&Тест
Процедура НесколькоСобытийИСтрокаБезПереводаВОстатке() Экспорт

	// Дано
	Первое = "{""ts"":""2026-06-20T03:04:58.000001"",""duration"":""1"",""name"":""CALL"",""depth"":""1""}";
	Второе = "{""ts"":""2026-06-20T03:04:59.000001"",""duration"":""2"",""name"":""SCALL"",""depth"":""1""}";
	Незавершенное = "{""ts"":""2026-06-20T03:05:00.000001"",""dura";
	Текст = Первое + Символы.ВК + ПС + Второе + ПС + Незавершенное;

	// Когда
	Результат = ПарсерТехнологическогоЖурналаJSON.Разобрать(Текст);

	// Тогда
	Ожидаем.Что(Результат.События).ИмеетДлину(2);
	Ожидаем.Что(Результат.События[1].Имя).Равно("SCALL");
	Ожидаем.Что(Результат.Остаток).Равно(Незавершенное);

КонецПроцедуры

&Тест
Процедура НекорректнаяСтрокаПропускается() Экспорт

	// Дано
	Текст = "мусор" + ПС
		+ "{""ts"":""2026-06-20T03:04:58.000001"",""duration"":""1"",""name"":""CALL"",""depth"":""1""}" + ПС;

	// Когда
	Результат = ПарсерТехнологическогоЖурналаJSON.Разобрать(Текст);

	// Тогда
	Ожидаем.Что(Результат.События).ИмеетДлину(1);
	Ожидаем.Что(Результат.События[0].Имя).Равно("CALL");

КонецПроцедуры

&Тест
Процедура ПоследняяСтрокаБезПереводаВЗавершенномТексте() Экспорт

	// Дано
	Текст = "{""ts"":""2026-06-20T03:04:58.000001"",""duration"":""1"",""name"":""CALL"",""depth"":""1""}";

	// Когда
	Результат = ПарсерТехнологическогоЖурналаJSON.Разобрать(Текст, Истина);

	// Тогда
	Ожидаем.Что(Результат.События).ИмеетДлину(1);
	Ожидаем.Что(Результат.Остаток).Равно("");

КонецПроцедуры

&Тест
Процедура ОпределениеФорматаПоПервомуСимволу() Экспорт

	Ожидаем.Что(ПарсерТехнологическогоЖурналаJSON.ЭтоФорматJSON("{""ts"":""2026""}")).ЭтоИстина();
	Ожидаем.Что(ПарсерТехнологическогоЖурналаJSON.ЭтоФорматJSON(Символ(65279) + "{""ts"":""2026""}")).ЭтоИстина();
	Ожидаем.Что(ПарсерТехнологическогоЖурналаJSON.ЭтоФорматJSON("05:12.345678-15,CALL,1,")).ЭтоЛожь();
	Ожидаем.Что(ПарсерТехнологическогоЖурналаJSON.ЭтоФорматJSON("")).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ЗначенияСвойствВТексте() Экспорт

	// Дано
	Текст = "{""ts"":""2026-06-20T03:04:58.000001"",""duration"":""1"",""name"":""EXCP"",""depth"":""1"","
		+ """Descr"":""a \""b\"""",""Empty"":"""",""N"":5}" + ПС;

	// Когда
	Событие = ПарсерТехнологическогоЖурналаJSON.Разобрать(Текст).События[0];
	Значения = ПарсерТехнологическогоЖурналаJSON.ЗначенияВТексте(Событие.Текст);

	// Тогда - строковые значения без кавычек; пустая строка и число не перечисляются
	Ожидаем.Что(Значения).ИмеетДлину(5);
	Ожидаем.Что(Значения[0].Ключ).Равно("ts");
	Ожидаем.Что(ЗначениеВТексте(Событие.Текст, Значения[0])).Равно("2026-06-20T03:04:58.000001");
	Ожидаем.Что(Значения[4].Ключ).Равно("Descr");
	Ожидаем.Что(ЗначениеВТексте(Событие.Текст, Значения[4])).Равно("a \""b\""");

КонецПроцедуры

&Тест
Процедура НедопустимоеОкончаниеСтроковогоЗначения() Экспорт

	// Дано
	Текст = "{""ts"":""2026-06-20T03:04:58.000001""}";

	// Когда
	Значения = ПарсерТехнологическогоЖурналаJSON.ЗначенияВТексте(Текст);

	// Тогда - нечетное число обратных косых черт в конце и неполное \u разрывают экранирование
	Окончание = Значения[0].НедопустимоеОкончание;
	Ожидаем.Что(Окончание.Заменить("ab\", "")).Равно("ab");
	Ожидаем.Что(Окончание.Заменить("ab\\\", "")).Равно("ab");
	Ожидаем.Что(Окончание.Заменить("ab\\", "")).Равно("ab\\");
	Ожидаем.Что(Окончание.Заменить("ab\u12", "")).Равно("ab");
	Ожидаем.Что(Окончание.Заменить("ab\\u12", "")).Равно("ab\\u12");
	ПолнаяПоследовательность = "ab\" + "u1234";
	Ожидаем.Что(Окончание.Заменить(ПолнаяПоследовательность, "")).Равно(ПолнаяПоследовательность);

КонецПроцедуры

Функция ЗначениеВТексте(Текст, Значение)
	Возврат Сред(Текст, Значение.Начало, Значение.Длина);
КонецФункции

&Тест
Процедура ЭкранированиеНаГраницахСтрок() Экспорт

	// Дано
	Текст = "{""ts"":""2026-06-20T03:04:58.000001"",""duration"":""1"",""name"":""EXCP"",""depth"":""1"","
		+ """a"":"""",""b"":""\\"",""c"":""\"""",""d"":""x\\\""y"",""k\""ey"":""v""}" + ПС;

	// Когда
	Результат = ПарсерТехнологическогоЖурналаJSON.Разобрать(Текст);

	// Тогда
	Ожидаем.Что(Результат.Пропущено).Равно(0);
	Свойства = Результат.События[0].Свойства;
	Ожидаем.Что(Свойства["a"]).Равно("");
	Ожидаем.Что(Свойства["b"]).Равно("\");
	Ожидаем.Что(Свойства["c"]).Равно("""");
	Ожидаем.Что(Свойства["d"]).Равно("x\""y");
	Ожидаем.Что(Свойства["k""ey"]).Равно("v");

КонецПроцедуры

ПС = Символы.ПС;
