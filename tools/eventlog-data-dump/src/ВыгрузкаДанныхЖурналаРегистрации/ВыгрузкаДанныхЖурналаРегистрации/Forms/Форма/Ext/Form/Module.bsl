////////////////////////////////////////////////////////////////////////////////
// Выгрузка Data журнала регистрации (vanessa-runner /C).
// Параметры: DumpPath=<jsonl>;SeedTestEvents;ЗавершитьРаботуСистемы;ФайлРезультата=...
////////////////////////////////////////////////////////////////////////////////

#Область ОписаниеПеременных

&НаКлиенте
Перем ПутьКОбработке; // каталог обработки (для разрешения путей вида $instrumentsRoot)

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	УбратьПодтверждениеПриЗавершенииПрограммы();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	СтрокаЗапуска = СокрЛП(ПараметрЗапуска);
	Если СтрокаЗапуска = "" Тогда
		Возврат;
	КонецЕсли;

	ПутьФайлаРезультата = "";
	Результат = НовыйРезультат();
	ЗавершитьРаботуСистемыЗапрошено = Ложь;

	Попытка
		ПутьКОбработке = ПолучитьПутьОбработки();

		ПараметрыЗапуска = ПолучитьСтруктуруПараметров(СтрокаЗапуска);
		ПреобразоватьПараметрыКоторыеНачинаютсяСТочкиКНормальнымПутям(ПараметрыЗапуска);

		Если ПараметрыЗапуска.Свойство("ФайлРезультата") Тогда
			ПутьФайлаРезультата = ПараметрыЗапуска.ФайлРезультата;
		КонецЕсли;
		ЗавершитьРаботуСистемыЗапрошено = ПараметрыЗапуска.Свойство("ЗавершитьРаботуСистемы");

		Результат = ВыполнитьОперацию(ПараметрыЗапуска);
	Исключение
		Результат.КодВозврата = 1;
		Результат.Ошибка = "Неудача при выполнении обработки: " + Символы.ПС
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	// Файл результата пишется при любом исходе и ДО завершения работы - это
	// достоверный для vanessa-runner источник успеха/ошибки.
	ЗаписатьФайлРезультата(ПутьФайлаРезультата, Результат);

	Если ЗавершитьРаботуСистемыЗапрошено Тогда
		ЗавершитьРаботуСистемы(Ложь, Ложь);
	Иначе
		ПрекратитьРаботуСистемы(Ложь);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область БизнесЛогика

// ЕДИНСТВЕННАЯ точка расширения шаблона.
// Выполняет операцию обработки и возвращает результат.
//
// Процедура выполняется в контексте клиента (можно вызывать &НаСервере-функции,
// читать файлы и т.п.). Накопленные Сообщения попадают в лог vanessa-runner,
// КодВозврата<>0 или заполненная Ошибка трактуются как неудача.
//
// Параметры:
//   ПараметрыЗапуска - Структура - разобранные параметры строки запуска
//                                  (Ключ=Значение -> строка, голый флаг -> Булево Истина)
//
// Возвращаемое значение:
//   Структура - результат (см. НовыйРезультат): КодВозврата, Сообщения, Ошибка
//
&НаКлиенте
Функция ВыполнитьОперацию(Знач ПараметрыЗапуска)

	Результат = НовыйРезультат();

	ПутьДампа = "";
	Если ПараметрыЗапуска.Свойство("DumpPath") Тогда
		ПутьДампа = ПараметрыЗапуска.DumpPath;
	КонецЕсли;
	Если ПустаяСтрока(ПутьДампа) Тогда
		Результат.КодВозврата = 1;
		Результат.Ошибка = "Не задан DumpPath=путь к .jsonl";
		Возврат Результат;
	КонецЕсли;

	СейвТест = ПараметрыЗапуска.Свойство("SeedTestEvents");
	Ответ = ВыгрузитьДанныеЖурналаНаСервере(ПутьДампа, СейвТест);
	Результат.Сообщения.Добавить("Файл: " + Ответ.Путь);
	Результат.Сообщения.Добавить("Записей: " + Формат(Ответ.Количество, "ЧГ=0"));
	Если Не ПустаяСтрока(Ответ.Ошибка) Тогда
		Результат.КодВозврата = 1;
		Результат.Ошибка = Ответ.Ошибка;
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ВыгрузкаЖурнала

&НаСервереБезКонтекста
Функция ВыгрузитьДанныеЖурналаНаСервере(Знач ПутьКФайлу, Знач СейвТест)

	Ответ = Новый Структура("Путь, Количество, Ошибка", ПутьКФайлу, 0, "");
	Попытка
		Если СейвТест Тогда
			ЗаписатьТестовыеСобытияЖурнала();
		КонецЕсли;

		Таблица = Новый ТаблицаЗначений;
		Отбор = Новый Структура;
		Колонки = "Date,Event,Level,Comment,Data,DataPresentation,"
			+ "Session,Connection,User,UserName,Computer,ApplicationName";
		ВыгрузитьЖурналРегистрации(Таблица, Отбор, Колонки);

		ЗаписьТекста = Новый ЗаписьТекста(ПутьКФайлу, КодировкаТекста.UTF8);
		Номер = 0;
		Для Каждого СтрокаЖурнала Из Таблица Цикл
			Номер = Номер + 1;
			ЗаписьТекста.ЗаписатьСтроку(СтрокаJSONЗаписиЖурнала(СтрокаЖурнала, Номер));
		КонецЦикла;
		ЗаписьТекста.Закрыть();
		Ответ.Количество = Номер;
	Исключение
		Ответ.Ошибка = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Ответ;

КонецФункции

&НаСервереБезКонтекста
Процедура ЗаписатьТестовыеСобытияЖурнала()

	Данные = Новый Структура;
	Данные.Вставить("Name", "otel-dump-user");
	Данные.Вставить("OSAuthentication", Ложь);
	Данные.Вставить("StandardAuthentication", Истина);
	Данные.Вставить("Roles", Новый Массив);
	Данные.Roles.Добавить("FullAccess");
	ЗаписьЖурналаРегистрации("otel.dump.UserLike",
		УровеньЖурналаРегистрации.Информация, , Данные, "seed User-like");

	ДанныеСеанса = Новый Структура;
	ДанныеСеанса.Вставить("OSUser", "");
	ДанныеСеанса.Вставить("Name", "Admin");
	ДанныеСеанса.Вставить("CurrentOSUser", "HOST\\user");
	ДанныеСеанса.Вставить("AuthenticationMode", 1);
	ЗаписьЖурналаРегистрации("otel.dump.AuthenticationLike",
		УровеньЖурналаРегистрации.Информация, , ДанныеСеанса, "seed Auth-like");

КонецПроцедуры

&НаСервереБезКонтекста
Функция СтрокаJSONЗаписиЖурнала(СтрокаЖурнала, Номер)

	// Колонки таблицы ВыгрузитьЖурналРегистрации - русские имена
	Данные = СтрокаЖурнала.Данные;
	Плоские = Новый Массив;
	ДобавитьПлоскиеПоляЖурнала(Плоские, Данные, "");

	ОбъектЗаписи = Новый Структура;
	ОбъектЗаписи.Вставить("n", Номер);
	ОбъектЗаписи.Вставить("date", ФорматДатыЖурналаISO(СтрокаЖурнала.Дата));
	ОбъектЗаписи.Вставить("event", Строка(СтрокаЖурнала.Событие));
	ОбъектЗаписи.Вставить("level", Строка(СтрокаЖурнала.Уровень));
	ОбъектЗаписи.Вставить("session", СтрокаЖурнала.Сеанс);
	ОбъектЗаписи.Вставить("connection", СтрокаЖурнала.Соединение);
	ОбъектЗаписи.Вставить("user", Строка(СтрокаЖурнала.ИмяПользователя));
	ОбъектЗаписи.Вставить("comment", Строка(СтрокаЖурнала.Комментарий));
	ОбъектЗаписи.Вставить("data", ЗначениеЖурналаДляJSON(Данные));
	ОбъектЗаписи.Вставить("data_flat", Плоские);
	ОбъектЗаписи.Вставить("data_presentation", Строка(СтрокаЖурнала.ПредставлениеДанных));
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, ОбъектЗаписи);
	Возврат Запись.Закрыть();

КонецФункции

&НаСервереБезКонтекста
Функция ФорматДатыЖурналаISO(ЗначениеДаты)

	Если ТипЗнч(ЗначениеДаты) <> Тип("Дата") Тогда
		Возврат Строка(ЗначениеДаты);
	КонецЕсли;
	Возврат Формат(ЗначениеДаты, "ДФ=yyyy-MM-ddTHH:mm:ss");

КонецФункции

&НаСервереБезКонтекста
Процедура ДобавитьПлоскиеПоляЖурнала(Приемник, Значение, Префикс)

	ТипЗначения = ТипЗнч(Значение);
	Если Значение = Неопределено Или ТипЗначения = Тип("Null") Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗначения = Тип("Структура") Или ТипЗначения = Тип("Соответствие") Тогда
		Для Каждого Пара Из Значение Цикл
			Ключ = Строка(Пара.Ключ);
			Путь = ?(ПустаяСтрока(Префикс), Ключ, Префикс + "." + Ключ);
			ДобавитьПлоскийЛистИлиВложенность(Приемник, Пара.Значение, Путь);
		КонецЦикла;
		Возврат;
	КонецЕсли;

	Если ТипЗначения = Тип("Массив") Тогда
		Для Индекс = 0 По Значение.ВГраница() Цикл
			Путь = Префикс + "[" + Формат(Индекс, "ЧГ=0") + "]";
			ДобавитьПлоскийЛистИлиВложенность(Приемник, Значение[Индекс], Путь);
		КонецЦикла;
		Возврат;
	КонецЕсли;

	Если ТипЗначения = Тип("ТаблицаЗначений") Тогда
		ИндексСтроки = 0;
		Для Каждого СтрокаТаблицы Из Значение Цикл
			ПутьСтроки = Префикс + "[" + Формат(ИндексСтроки, "ЧГ=0") + "]";
			Для Каждого Колонка Из Значение.Колонки Цикл
				ДобавитьПлоскийЛистИлиВложенность(Приемник, СтрокаТаблицы[Колонка.Имя],
					ПутьСтроки + "." + Колонка.Имя);
			КонецЦикла;
			ИндексСтроки = ИндексСтроки + 1;
		КонецЦикла;
		Возврат;
	КонецЕсли;

	ДобавитьПлоскийЛистИлиВложенность(Приемник, Значение, Префикс);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьПлоскийЛистИлиВложенность(Приемник, Значение, Путь)

	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Структура")
		Или ТипЗначения = Тип("Соответствие")
		Или ТипЗначения = Тип("Массив")
		Или ТипЗначения = Тип("ТаблицаЗначений") Тогда
		ДобавитьПлоскиеПоляЖурнала(Приемник, Значение, Путь);
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(Путь) Тогда
		Возврат;
	КонецЕсли;

	Приемник.Добавить(Путь + "=" + ПредставлениеСкаляраЖурнала(Значение));

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПредставлениеСкаляраЖурнала(Значение)

	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Булево") Тогда
		Возврат ?(Значение, "true", "false");
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Возврат ФорматДатыЖурналаISO(Значение);
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		Возврат XMLСтрока(Значение);
	ИначеЕсли ТипЗначения = Тип("УникальныйИдентификатор") Тогда
		Возврат Строка(Значение);
	Иначе
		Возврат Строка(Значение);
	КонецЕсли;

КонецФункции

&НаСервереБезКонтекста
Функция ЗначениеЖурналаДляJSON(Значение)

	ТипЗначения = ТипЗнч(Значение);
	Если Значение = Неопределено Или ТипЗначения = Тип("Null") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ТипЗначения = Тип("Структура") Или ТипЗначения = Тип("Соответствие") Тогда
		Результат = Новый Соответствие;
		Для Каждого Пара Из Значение Цикл
			Результат.Вставить(Строка(Пара.Ключ), ЗначениеЖурналаДляJSON(Пара.Значение));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	Если ТипЗначения = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(ЗначениеЖурналаДляJSON(Элемент));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	Если ТипЗначения = Тип("ТаблицаЗначений") Тогда
		Результат = Новый Массив;
		Для Каждого СтрокаТаблицы Из Значение Цикл
			СтрокаJSON = Новый Соответствие;
			Для Каждого Колонка Из Значение.Колонки Цикл
				СтрокаJSON.Вставить(Колонка.Имя, ЗначениеЖурналаДляJSON(СтрокаТаблицы[Колонка.Имя]));
			КонецЦикла;
			Результат.Добавить(СтрокаJSON);
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	Если ТипЗначения = Тип("Булево") Или ТипЗначения = Тип("Число") Или ТипЗначения = Тип("Строка") Тогда
		Возврат Значение;
	КонецЕсли;

	Если ТипЗначения = Тип("Дата") Тогда
		Возврат ФорматДатыЖурналаISO(Значение);
	КонецЕсли;

	Возврат Строка(Значение);

КонецФункции

#КонецОбласти

#Область Инфраструктура

// --- Результат ---

// Создаёт пустой результат операции в формате, ожидаемом vanessa-runner.
//
// Возвращаемое значение:
//   Структура - КодВозврата (Число), Сообщения (Массив из Строка), Ошибка (Строка)
//
&НаКлиентеНаСервереБезКонтекста
Функция НовыйРезультат()
	Возврат Новый Структура("КодВозврата, Сообщения, Ошибка", 0, Новый Массив, "");
КонецФункции

// Добавляет сообщения из одного массива в другой (на клиенте).
&НаКлиенте
Процедура ДобавитьСообщения(Приёмник, Знач Источник)
	Для Каждого Сообщение Из Источник Цикл
		Приёмник.Добавить(Сообщение);
	КонецЦикла;
КонецПроцедуры

// Добавляет сообщения из одного массива в другой (на сервере).
&НаСервереБезКонтекста
Процедура ДобавитьСообщенияСервер(Приёмник, Знач Источник)
	Для Каждого Сообщение Из Источник Цикл
		Приёмник.Добавить(Сообщение);
	КонецЦикла;
КонецПроцедуры

// Записывает JSON-файл результата. Сервис заранее создаёт пустой файл,
// обработка перезаписывает его готовым JSON. Запись не должна прерывать
// завершение работы обработки.
//
// Параметры:
//   ПутьФайла - Строка    - путь к файлу результата (пустой - не писать)
//   Результат - Структура - КодВозврата, Сообщения, Ошибка
//
&НаСервереБезКонтекста
Процедура ЗаписатьФайлРезультата(Знач ПутьФайла, Знач Результат)

	Если ПустаяСтрока(ПутьФайла) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Данные = Новый Структура;
		Данные.Вставить("КодВозврата", Результат.КодВозврата);
		Данные.Вставить("Сообщения", Результат.Сообщения);
		Данные.Вставить("Ошибка", Результат.Ошибка);

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.ОткрытьФайл(ПутьФайла, "UTF-8");
		ЗаписатьJSON(ЗаписьJSON, Данные);
		ЗаписьJSON.Закрыть();
	Исключение
		// Сбой записи файла результата не должен прерывать завершение работы обработки.
	КонецПопытки;

КонецПроцедуры

// --- Разбор параметров строки запуска ---

&НаКлиенте
Функция ПолучитьСтруктуруПараметров(Стр)

	Результат = Новый Структура;

	Массив = РазложитьСтрокуВМассивПодстрок(Стр, ";");
	Для каждого Элем Из Массив Цикл
		Поз = Найти(Элем, "=");
		Если Поз > 0 Тогда
			Ключ     = Лев(Элем, Поз - 1);
			Значение = Сред(Элем, Поз + 1);
			Попытка
				Результат.Вставить(СокрЛП(Ключ), СокрЛП(Значение));
			Исключение
				// некорректный ключ - пропускаем
			КонецПопытки;
		Иначе
			Если НЕ ПустаяСтрока(Элем) Тогда
				Попытка
					Результат.Вставить(СокрЛП(Элем), Истина);
				Исключение
					// некорректный флаг - пропускаем
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция РазложитьСтрокуВМассивПодстрок(Знач Строка, Знач Разделитель = ",",
		Знач ПропускатьПустыеСтроки = Неопределено)

	Результат = Новый Массив;

	Если ПропускатьПустыеСтроки = Неопределено Тогда
		ПропускатьПустыеСтроки = ?(Разделитель = " ", Истина, Ложь);
		Если ПустаяСтрока(Строка) Тогда
			Если Разделитель = " " Тогда
				Результат.Добавить("");
			КонецЕсли;
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	Позиция = Найти(Строка, Разделитель);
	Пока Позиция > 0 Цикл
		Подстрока = Лев(Строка, Позиция - 1);
		Если Не ПропускатьПустыеСтроки Или Не ПустаяСтрока(Подстрока) Тогда
			Результат.Добавить(Подстрока);
		КонецЕсли;
		Строка = Сред(Строка, Позиция + СтрДлина(Разделитель));
		Позиция = Найти(Строка, Разделитель);
	КонецЦикла;

	Если Не ПропускатьПустыеСтроки Или Не ПустаяСтрока(Строка) Тогда
		Результат.Добавить(Строка);
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура ПреобразоватьПараметрыКоторыеНачинаютсяСТочкиКНормальнымПутям(СтруктураПараметров)

	МассивКлючей = Новый Массив;
	Для каждого ПараметрБилда Из СтруктураПараметров Цикл
		Если Лев(ПараметрБилда.Значение, 1) = "." Или Найти(ПараметрБилда.Значение, "$instrumentsRoot") > 0 Тогда
			МассивКлючей.Добавить(ПараметрБилда.Ключ);
		КонецЕсли;
	КонецЦикла;

	Для каждого Ключ Из МассивКлючей Цикл
		Стало = ПреобразоватьПутьСТочкамиКНормальномуПути(СтруктураПараметров[Ключ]);
		Стало = ЗаменитьСлеши(Стало);
		СтруктураПараметров.Вставить(Ключ, Стало);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Функция ПреобразоватьПутьСТочкамиКНормальномуПути(ОригСтр)

	Если Найти(ОригСтр, "$instrumentsRoot") > 0 И НЕ ПустаяСтрока(ПутьКОбработке) Тогда
		Возврат СтрЗаменить(ОригСтр, "$instrumentsRoot", ДополнитьСлешВПуть(ПутьКОбработке));
	КонецЕсли;

	Возврат ОригСтр;

КонецФункции

&НаКлиенте
Функция ДополнитьСлешВПуть(Знач Каталог)

	Разделитель = ПолучитьРазделительПути();
	Если ПустаяСтрока(Каталог) Тогда
		Возврат Каталог;
	КонецЕсли;
	Если Прав(Каталог, 1) <> Разделитель Тогда
		Каталог = Каталог + Разделитель;
	КонецЕсли;
	Возврат Каталог;

КонецФункции

&НаКлиенте
Функция ЗаменитьСлеши(Знач Путь)
	Результат = СтрЗаменить(Путь, "\", ПолучитьРазделительПути());
	Результат = СтрЗаменить(Результат, "/", ПолучитьРазделительПути());
	Возврат Результат;
КонецФункции

// --- Путь к обработке ---

&НаКлиенте
Функция ПолучитьПутьОбработки()

	Перем ФайлПути, Результат;

	Результат = ПолучитьПутьКОбработкеСервер();
	Если НЕ ПустаяСтрока(ПутьКОбработке) Тогда
		ФайлПути = Новый Файл(ПутьКОбработке);
		Результат = ФайлПути.Путь;
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервере
Функция ПолучитьПутьКОбработкеСервер()

	ОбъектНаСервере = ОбъектНаСервере();
	ИспользуемоеИмяФайла = ОбъектНаСервере.ИспользуемоеИмяФайла;
	ПрефиксИмени = НРег(Лев(ИспользуемоеИмяФайла, 6));
	Если (ПрефиксИмени <> "e1cib/") И (ПрефиксИмени <> "e1cib\") Тогда
		Возврат ИспользуемоеИмяФайла;
	КонецЕсли;

	Возврат "";

КонецФункции

&НаСервере
Функция ОбъектНаСервере()
	Возврат РеквизитФормыВЗначение("Объект");
КонецФункции

// --- Завершение работы ---

&НаСервере
Процедура УбратьПодтверждениеПриЗавершенииПрограммы()

	Если Метаданные.Подсистемы.Найти("СтандартныеПодсистемы") <> Неопределено Тогда
		МодульОбщегоНазначения = Вычислить("ОбщегоНазначения");
		Попытка
			МодульОбщегоНазначения.ХранилищеОбщихНастроекСохранить("ОбщиеНастройкиПользователя",
				"ЗапрашиватьПодтверждениеПриЗавершенииПрограммы", Ложь);
		Исключение
			// Данного модуля и метода может не быть в конфигурации
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
