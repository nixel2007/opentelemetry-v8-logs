<?xml version="1.0" encoding="utf-8"?>
<package-def xmlns="http://oscript.io/schemas/lib-config/1.0">

    <!-- Чтение файлов -->
    <module name="ЧтениеХвостаФайла" file="src/Чтение/Модули/ЧтениеХвостаФайла.os"/>

    <!-- Технологический журнал -->
    <module name="СобытияТехЖурнала" file="src/ТехЖурнал/Модули/СобытияТехЖурнала.os"/>
    <module name="ПарсерТехЖурнала" file="src/ТехЖурнал/Модули/ПарсерТехЖурнала.os"/>
    <module name="ПарсерТехЖурналаJSON" file="src/ТехЖурнал/Модули/ПарсерТехЖурналаJSON.os"/>

    <!-- Журнал регистрации -->
    <module name="ПарсерСкобочногоФормата" file="src/ЖурналРегистрации/Модули/ПарсерСкобочногоФормата.os"/>
    <module name="ПарсерЖурналаРегистрации" file="src/ЖурналРегистрации/Модули/ПарсерЖурналаРегистрации.os"/>
    <class name="СловарьЖурналаРегистрации" file="src/ЖурналРегистрации/Классы/СловарьЖурналаРегистрации.os"/>

</package-def>
