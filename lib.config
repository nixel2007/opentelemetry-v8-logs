<?xml version="1.0" encoding="utf-8"?>
<package-def xmlns="http://oscript.io/schemas/lib-config/1.0">

    <!-- Чтение файлов -->
    <module name="ЧтениеХвостаФайла" file="src/Чтение/Модули/ЧтениеХвостаФайла.os"/>
    <module name="ЧтениеФайловЖурнала" file="src/Чтение/Модули/ЧтениеФайловЖурнала.os"/>
    <class name="ПозицииЧтения" file="src/Чтение/Классы/ПозицииЧтения.os"/>
    <class name="ХранилищеПозицийВПамяти" file="src/Чтение/Классы/ХранилищеПозицийВПамяти.os"/>

    <!-- Технологический журнал -->
    <module name="СобытияТехнологическогоЖурнала" file="src/ТехнологическийЖурнал/Модули/СобытияТехнологическогоЖурнала.os"/>
    <module name="ПарсерТехнологическогоЖурнала" file="src/ТехнологическийЖурнал/Модули/ПарсерТехнологическогоЖурнала.os"/>
    <module name="ПарсерТехнологическогоЖурналаJSON" file="src/ТехнологическийЖурнал/Модули/ПарсерТехнологическогоЖурналаJSON.os"/>
    <class name="ЧитательТехнологическогоЖурнала" file="src/ТехнологическийЖурнал/Классы/ЧитательТехнологическогоЖурнала.os"/>

    <!-- Журнал регистрации -->
    <module name="ПарсерСкобочногоФормата" file="src/ЖурналРегистрации/Модули/ПарсерСкобочногоФормата.os"/>
    <module name="ПарсерЖурналаРегистрации" file="src/ЖурналРегистрации/Модули/ПарсерЖурналаРегистрации.os"/>
    <class name="СловарьЖурналаРегистрации" file="src/ЖурналРегистрации/Классы/СловарьЖурналаРегистрации.os"/>
    <class name="ЧитательЖурналаРегистрации" file="src/ЖурналРегистрации/Классы/ЧитательЖурналаРегистрации.os"/>

    <!-- Экспорт в OpenTelemetry -->
    <module name="ВремяЖурналов" file="src/Экспорт/Модули/ВремяЖурналов.os"/>
    <class name="ТелеметрияЖурналов" file="src/Экспорт/Классы/ТелеметрияЖурналов.os"/>
    <class name="ЭкспортерТехнологическогоЖурнала" file="src/Экспорт/Классы/ЭкспортерТехнологическогоЖурнала.os"/>
    <class name="СборщикТрассТехнологическогоЖурнала" file="src/Экспорт/Классы/СборщикТрассТехнологическогоЖурнала.os"/>
    <class name="ГенераторИдТрассТехнологическогоЖурнала" file="src/Экспорт/Классы/ГенераторИдТрассТехнологическогоЖурнала.os"/>
    <class name="ЭкспортерЖурналаРегистрации" file="src/Экспорт/Классы/ЭкспортерЖурналаРегистрации.os"/>

    <!-- Конвейер -->
    <class name="КонвейерЖурналов" file="src/Конвейер/Классы/КонвейерЖурналов.os"/>

</package-def>
